  "alternatives": [
    {
      "name": "Independent survival",
      "law": "Each initial activity quantum survives each frame independently with probability m and never reproduces.",
      "distribution": "Z_n ~ Binomial(Z_0,m^n)",
      "mean": "Z_0*m^n",
      "variance": "Z_0*m^n*(1-m^n)",
      "survival": "Pr(Z_n>0)=1-(1-m^n)^Z_0",
      "range": "Never exceeds the initial count when there is no added input."
    },
    {
      "name": "Poisson offspring branching",
      "law": "Each present quantum independently produces Poisson(m) offspring next frame; no immigration for transient calculations.",
      "mean": "Z_0*m^n",
      "variance": "Z_0*m^n*(1-m^n)/(1-m), 0<m<1",
      "survival": "q_0=0; q_(n+1)=exp(m*(q_n-1)); Pr(Z_n>0)=1-q_n^Z_0",
      "range": "Unbounded count, even for Z_0=15 or255. These initial values do not make this an INT4/INT8 implementation."
    }
  ],
