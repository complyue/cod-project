using symbol "std:io" @print;

proc report_offsets(val first:UInt64, val past:UInt64) -> void {
    val total <- 0u64;
    val last <- make UInt64;
    for (offset in first .. past) {
        (total <- total + offset):void;
        (last <- offset):void;
    } else {
        (last <- 20u64):void;
    };
    behave @print(total);
    behave @print(last);
    return;
}

report_offsets(2u64, 5u64);
report_offsets(0u64, 0u64);
