using symbol "std:io" @print;

proc decode(val selected:bool) -> void {
    ptr value:u64 = make u64;
    ptr pending:u64 = value;
    defer { behave @print(value); };
    if (selected) {
        defer { (pending <- 3u64):void; };
    } else {
        defer { (pending <- 4u64):void; };
    };
    return;
}

decode(true);
decode(false);
