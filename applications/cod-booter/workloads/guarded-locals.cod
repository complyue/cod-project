using symbol "std:io" @print;
using "std:exceptions" NullPointerException;

func prepare(selected:bool) -> u64 throws NullPointerException {
    if (selected) {
        return 12u64;
    } else {};
    ptr absent:u64 = null in here;
    return absent;
}

proc report(selected:bool) -> void {
    try {
        val count <- prepare(selected);
    } catch (error:const NullPointerException) {
        return;
    };
    behave @print(count);
    return;
}

report(false);
report(true);
