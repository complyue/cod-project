using symbol "std:io" @print;
using "std:exceptions" NullPointerException;

proc release(ref releases:u64 in R) -> void where {owner R} {
    releases <- releases + 1u64;
    behave @print(releases);
    return;
}

proc reject_after_acquisition(ref releases:u64 in R) -> void
    throws NullPointerException where {owner R} {
    defer release(releases);
    ptr absent:u64 = null in here;
    behave @print(absent);
    return;
}

val release_count <- 0u64;
try {
    reject_after_acquisition(release_count);
    behave @print(99u64);
} catch (error:const NullPointerException) {
    behave @print(release_count);
};
behave @print(release_count);
