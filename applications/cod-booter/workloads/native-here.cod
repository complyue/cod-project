handle type Revision;
array SourceBytes[UInt64]:UInt8;
array LineStarts[UInt64]:UInt64;

proc "C" Revision();
proc "C" source_use(here work(ref bytes:const SourceBytes in S,
                             ref starts:const LineStarts in S) -> UInt8,
                    handle revision:Revision in S) -> UInt8 where {const owner S};
proc "C" inspect(ref bytes:const SourceBytes in S, ref starts:const LineStarts in S)
    -> UInt8 where {const owner S};
proc "C" observe(val feedback:UInt8);
proc "C" observe_return(val value:UInt64);

proc scan() -> void {
    own handle revision:Revision <- make own handle Revision();
    observe(source_use(revision) (bytes, starts) => {
        continue inspect(bytes, starts);
    });
    observe(source_use(revision) (ref bytes:const SourceBytes, starts) => {{
        return 0u8;
    }});
    observe(source_use(revision) (bytes, starts) => {
        break 127u8;
    });
    return;
}

proc early_exit() -> UInt64 {
    own handle revision:Revision <- make own handle Revision();
    source_use(revision) (bytes, starts) => {
        return 41u64;
    };
    return 99u64;
}

scan();
observe_return(early_exit());
