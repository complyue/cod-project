using "std:text-storage" utf8_size;

func prefix_size() -> UInt64 {
    return utf8_size("éλ🚀");
}

export func measured_size(extra:UInt64) -> UInt64 {
    return prefix_size() + extra;
}

export func selected_text(input:const String in O) -> ref const String in O where {const owner O} {
    return input;
}
