using symbol "std:io" @print;

proc dispatch(replace:bool) -> u64 {
    defer { behave @print(9u64); };
    return case true of {
        (true) -> {{
            defer { behave @print(1u64); };
            defer { if (replace) { return 42u64; } else {}; };
            defer { behave @print(2u64); };
            fallthrough;
        }};
        behave @print(3u64);
        () -> { 4u64 };
    };
}
behave @print(dispatch(false));
behave @print(dispatch(true));
