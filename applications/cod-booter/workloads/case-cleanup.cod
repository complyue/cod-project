using symbol "std:io" @print;

proc dispatch(resume:bool, replace:bool) -> u64 {
    defer { behave @print(9u64); };
    return case true of {
        (true) -> {{
            defer { behave @print(1u64); };
            defer { if (replace) { return 42u64; } else {}; };
            defer { behave @print(2u64); };
            try {
                if (resume) { fallthrough; };
            } finally { behave @print(8u64); };
            return 5u64;
        }};
        behave @print(3u64);
        () -> { 4u64 };
    };
}
behave @print(dispatch(true, false));
behave @print(dispatch(false, false));
behave @print(dispatch(true, true));

proc update_selection(early:bool, target:u64 in O) -> void where {owner O} {
    ref selected = case early of {
        (true) -> {
            try { break target; }
            finally { (target <- 51u64):void; };
        };
        (false) -> { target };
    };
    behave @print(selected);
    selected <- 52u64;
    return;
}

val current <- 50u64;
update_selection(true, current);
behave @print(current);
