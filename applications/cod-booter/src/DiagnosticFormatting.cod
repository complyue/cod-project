export import "../../../cod/library/string.cod" { str, repr, emitStr, emitRepr };
import "../../../cod/library/string.cod" emit;
using "SourceStorage.cod" SourcePosition;

proc emitStr(position:const SourcePosition in P) -> void
    where {const owner P} {
    if (position.line == 0u64 && position.column == 0u64) {
        emit("<unknown>");
        return;
    };
    emitStr(position.line);
    emit(":");
    emitStr(position.column);
    return;
}

proc emitRepr(position:const SourcePosition in P) -> void
    where {const owner P} {
    emit("SourcePosition(line=");
    emitStr(position.line);
    emit(", column=");
    emitStr(position.column);
    emit(")");
    return;
}
