using "./ParserStorage.cod" { no_node, ResourceNature, FormalMode { ValueFormal } };

# The name span and any builtin path span belong to the catalog's spelling
# bytes. A source export names its publishing module independently of origin.
export data ModuleExport {
    module_first:UInt64,
    module_past:UInt64,
    name_first:UInt64,
    name_past:UInt64,
    identity:UInt64,
    kind:UInt8,
    # Exception types carry checkedness. Ordinary callable exports mark a
    # declared failure contract that a selected source call must check.
    checked:UInt8,
    publishing_module:UInt64,
    origin_module:UInt64,
    owner_module:UInt64,
    owner_identity:UInt64,
    shape:UInt8,
}
export array ModuleExports[UInt64]:ModuleExport;

export data DefaultMemberRange {
    first_ordinal:UInt64,
    past_ordinal:UInt64,
    first_byte:UInt64,
    past_byte:UInt64,
}
export data DefaultExportRef {
    public_row:UInt64,
    nature:ResourceNature,
    members:DefaultMemberRange,
}
export array DefaultExportRefs[UInt64]:DefaultExportRef;

export func enum_type() -> UInt8 { return 26u8; }
export func sum_type() -> UInt8 { return 39u8; }
export func constructor_type() -> UInt8 { return 40u8; }

export enum AggregateStorage:UInt8 { UnprovedAggregate, CoDBitsAggregate, CLayoutBitsRecord, NonBitsAggregate, }
export enum InterfaceCallableKind:UInt8 { NoCallableKind, CheckedFunction, CheckedProcedure, }
export enum SourceWriter:UInt8 { NoSourceWriter, ProductWriter, AggregateWriter, ParserWriter, ArrayInspector, WorkspaceWriter, }
export enum ArrayReadCompletion:UInt8 { NoArrayRead, CheckedArrayRead, ArrayReadMayFailBounds, }

export data ByteArrayFailures {
    bounds:bool,
    out_of_memory:bool,
    region_capacity:bool,
    invalid_capacity:bool,
}

export enum ExceptionSchema:UInt8 { OrdinarySchema, CheckedExceptionSchema, UncheckedExceptionSchema, }

# Every membership header already identifies its defining source row. In
# a variadic singleton it is also the identity of the sole implementation.
export enum FamilyMembership:UInt8 { UnprovedMembership, PromiseOnly, FixedMethods, VariadicMethod, }

export data CallableObjectView =
    NoCallableObjectView {} |
    PublishedObjectView {
        public_row:UInt64,
        publisher:UInt64,
        defining_module:UInt64,
        declaration:UInt64,
        incoming_context:UInt64,
        selected_context:UInt64,
    };

export func callable_view_interface() -> UInt8 { return 41u8 }
export func array_length_family_interface() -> UInt8 { return 42u8 }
export func generic_product_interface() -> UInt8 { return 43u8 }
export func generic_callable_interface() -> UInt8 { return 44u8 }
export func recipe_entry() -> UInt8 { return 45u8 }
export func source_text_family_interface() -> UInt8 { return 46u8 }

export data CallableUseProof =
    UnselectedCallable {} |
    CheckedCallableUse {
        site:UInt64,
        revision:UInt64,
        public_row:UInt64,
        publisher:UInt64,
        defining_module:UInt64,
        declaration:UInt64,
        incoming_context:UInt64,
        selected_context:UInt64,
        ordinal:UInt64,
    };
export array CallableUseProofs[UInt64]:CallableUseProof;
export enum ReceiverImportCheck:UInt8 { NoReceiverCallables, ReceiverCallablesReady, OtherReceiverResource, }

export func checked_callable_context(proof:const CallableUseProofs in F, row:UInt64, revision:UInt64)
    -> UInt64 where {const owner F} {
    if (row >= intrinsic (len)(proof)) return no_node();
    return case proof[row] of {
        CheckedCallableUse { val origin <- revision, val context <- selected_context, } ->
            if (origin == revision) { context } else { no_node() };
        _ -> no_node()
    }
}

export func matches_object_call(proof:const CallableUseProofs in F, row:UInt64, revision:UInt64,
    site:UInt64, public_row:UInt64, publisher:UInt64, module:UInt64, declaration:UInt64, native_function:UInt64)
    -> bool where {const owner F} {
    if (row >= intrinsic (len)(proof) || native_function == no_node()) return false;
    return case proof[row] of {
        CheckedCallableUse {
            val checked_revision <- revision, val definition_module <- defining_module,
            val method <- declaration, val context <- selected_context, val ordinal <- ordinal,
            val source_site <- site, val published_row <- public_row, val upstream <- publisher,
        } -> checked_revision == revision && source_site == site && published_row == public_row &&
            upstream == publisher && definition_module == module && method == declaration &&
            (if (ordinal == no_node()) { context == module } else { ordinal == native_function });
        _ -> false
    }
}

export enum GenericMethodExit:UInt8 { UnprovedMethodBody, EmptyMethodBody, NullMethodResult, FieldOperationsBody, }

export enum RecipeResultMode:UInt8 { ValueRecipe, ReferenceRecipe, PointerRecipe, }

export data InterfacePayload =
    NoInterfacePayload {} |
    DeferredTextReceiver {
        operation:UInt64, receiver:UInt64, writer:UInt64,
        symbol_module:UInt64, symbol_identity:UInt64, target_module:UInt64, target_identity:UInt64,
    } |
    CheckedTextReceiver {
        operation:UInt64, writer:UInt64,
        symbol_module:UInt64, symbol_identity:UInt64, receiver_module:UInt64, receiver_identity:UInt64,
        out_of_memory:bool,
    } |
    SumInterface {} |
    ConstructorReference { defining_module:UInt64, declaration:UInt64, } |
    ConstructorInterface { sum_module:UInt64, sum_declaration:UInt64, } |
    ConstructorField { field_kind:UInt8, field_module:UInt64, field_identity:UInt64, mode:FormalMode, readonly:bool, } |
    GenericProduct { parameters:UInt64, constructor:UInt64, } |
    GenericCallable { parameters:UInt64, constructor_of:UInt64, function_form:bool, null_initialization:bool, method_exit:GenericMethodExit, } |
    RecipeBodyOperand { binding:UInt64, field:UInt64, owner_role:UInt64, } |
    RecipeBodyMake { binding:UInt64, owner_role:UInt64, } |
    RecipeBodyInitialize { field:UInt64, transfer:bool, } |
    RecipeBodyStore { binding:UInt64, field:UInt64, } |
    RecipeBodyReturn {} |
    RecipeBodyCase {} |
    RecipeBodyRefArm { binding:UInt64, owner_role:UInt64, readonly:bool, } |
    RecipeBodyEnd {} |
    RecipeReturnNull { owner_role:UInt64, } |
    RecipeNullInitializer { field:UInt64, owner_role:UInt64, } |
    RecipeParameter {} |
    RecipeOwner { readonly:bool, } |
    RecipeField { mode:FormalMode, readonly:bool, fixed:bool, } |
    RecipeFormal { mode:FormalMode, owner_role:UInt64, readonly:bool, fixed:bool, } |
    RecipeResult { mode:RecipeResultMode, owner_role:UInt64, readonly:bool, explicit_value:bool, } |
    RecipeBuiltin { kind:UInt8, } |
    RecipeNominal { defining_module:UInt64, declaration:UInt64, } |
    RecipeTypeParameter { binder:UInt64, } |
    RecipeApplication { defining_module:UInt64, declaration:UInt64, arguments:UInt64, };

# An interface header has value_kind zero and precedes its entries. A here
# operation lists its supplier, then receivers. A record lists its fields.
# Both declarations and nominal types retain their defining-module identity.
export data ModuleInterfaceRow {
    defining_module:UInt64,
    declaration:UInt64,
    entry_count:UInt64,
    owner_count:UInt64,
    interface_kind:UInt8,
    result_kind:UInt8,
    element_kind:UInt8,
    array_index_kind:UInt8,
    value_kind:UInt8,
    type_module:UInt64,
    type_identity:UInt64,
    owner_role:UInt64,
    target_readonly:UInt8,
    owner_readonly:UInt8,
    has_here:UInt8,
    failure_checked:UInt8,
    failure_module:UInt64,
    failure_identity:UInt64,
    name_first:UInt64,
    name_past:UInt64,
    # Member rows carry the backing code. An enum header carries the count
    # of canonical values, independently of its count of written spellings.
    enum_code:UInt64,
    native_function:UInt64,
    callable_kind:InterfaceCallableKind,
    membership:FamilyMembership,
    native_reception:UInt8,
    native_passes_owner:UInt8,
    payload:InterfacePayload,
    aggregate_storage:AggregateStorage,
    exception_schema:ExceptionSchema,
    field_mode:FormalMode,
    scalar_object_body:bool,
    scalar_source_body:bool,
    array_read_completion:ArrayReadCompletion,
    source_numeric_fault:bool,
    source_writer:SourceWriter,
    object_view:CallableObjectView,
    array_slot_checked:bool,
    slot_target_invariant:bool,
    array_slot_failures:ByteArrayFailures,
    # A source parameter may require its substituted owner to allocate.
    source_allocates:bool,
}
export array ModuleInterfaces[UInt64]:ModuleInterfaceRow;

export func write_interface_header(row:ModuleInterfaceRow in R, defining_module:UInt64, declaration:UInt64,
                                   kind:UInt8, result:UInt8, entries:UInt64) -> void where {owner R} {
    row.defining_module <- defining_module;
    row.declaration <- declaration;
    row.entry_count <- entries;
    row.owner_count <- 0u64;
    row.interface_kind <- kind;
    row.result_kind <- result;
    row.element_kind <- 0u8;
    row.array_index_kind <- 0u8;
    row.value_kind <- 0u8;
    row.type_module <- 0u64;
    row.type_identity <- 0u64;
    row.owner_role <- no_node();
    row.target_readonly <- 0u8;
    row.owner_readonly <- 0u8;
    row.has_here <- 0u8;
    row.failure_module <- 0u64;
    row.failure_identity <- 0u64;
    row.failure_checked <- 0u8;
    row.name_first <- 0u64;
    row.name_past <- 0u64;
    row.enum_code <- 0u64;
    row.native_function <- no_node();
    row.callable_kind <- (NoCallableKind:InterfaceCallableKind);
    row.membership <- (UnprovedMembership:FamilyMembership);
    row.native_reception <- 0u8;
    row.native_passes_owner <- 0u8;
    row.aggregate_storage <- (UnprovedAggregate:AggregateStorage);
    row.exception_schema <- (OrdinarySchema:ExceptionSchema);
    row.field_mode <- ValueFormal;
    row.scalar_object_body <- false;
    row.scalar_source_body <- false;
    row.array_read_completion <- (NoArrayRead:ArrayReadCompletion);
    row.source_numeric_fault <- false;
    row.source_writer <- (NoSourceWriter:SourceWriter);
    row.array_slot_checked <- false;
    row.slot_target_invariant <- false;
    row.array_slot_failures.bounds <- false;
    row.array_slot_failures.out_of_memory <- false;
    row.array_slot_failures.region_capacity <- false;
    row.array_slot_failures.invalid_capacity <- false;
    row.source_allocates <- false;
    return;
}

export func write_payload_row(interfaces:ModuleInterfaces in I, row:UInt64, module:UInt64, declaration:UInt64,
                         kind:UInt8, entries:UInt64, first:UInt64, past:UInt64, payload:const InterfacePayload in P) -> void
    where {owner I, const owner P} {
    interfaces[row] <- make ModuleInterfaceRow {
        defining_module <- module; declaration <- declaration; entry_count <- entries; owner_count <- 0u64;
        interface_kind <- kind; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8;
        value_kind <- if (kind == 0u8) { constructor_type() } else { 0u8 };
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- 0u64; name_first <- first; name_past <- past;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <-
            (NoCallableKind:InterfaceCallableKind); native_reception <- 0u8;
        native_passes_owner <- 0u8; payload <- payload;
        membership <- (UnprovedMembership:FamilyMembership);
        aggregate_storage <- (UnprovedAggregate:AggregateStorage);
        exception_schema <- (OrdinarySchema:ExceptionSchema); field_mode <- ValueFormal;
        scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- (NoArrayRead:ArrayReadCompletion); source_numeric_fault <- false; source_writer <- (NoSourceWriter:SourceWriter); object_view <- make NoCallableObjectView {};
        array_slot_checked <- false; slot_target_invariant <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    };
    return;
}

export func write_object_view(interfaces:ModuleInterfaces in I, at:UInt64, publisher:UInt64,
    view:const CallableObjectView in V) -> void where {owner I, const owner V} {
    interfaces[at] <- make ModuleInterfaceRow {
        defining_module <- publisher; declaration <- no_node(); entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- callable_view_interface(); result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- no_node(); name_first <- 0u64; name_past <- 0u64;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <- (NoCallableKind:InterfaceCallableKind);
        native_reception <- 0u8; native_passes_owner <- 0u8; membership <- (UnprovedMembership:FamilyMembership);
        payload <- make NoInterfacePayload {};
        aggregate_storage <- (UnprovedAggregate:AggregateStorage);
        exception_schema <- (OrdinarySchema:ExceptionSchema); field_mode <- ValueFormal;
        scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- (NoArrayRead:ArrayReadCompletion); source_numeric_fault <- false; source_writer <- (NoSourceWriter:SourceWriter);
        object_view <- view;
        array_slot_checked <- false; slot_target_invariant <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    };
    return
}

export func find_interface(interfaces:const ModuleInterfaces in I, published:UInt64, defining_module:UInt64, declaration:UInt64) -> UInt64
    where {const owner I} {
    if (published > intrinsic (len)(interfaces)) return no_node();
    val row <- 0u64;
    val width <- 0u64;
    for (unused in 0u64 .. published) {
        if (row >= published || interfaces[row].value_kind != 0u8 || interfaces[row].interface_kind == 0u8)
            return no_node();
        width <- interfaces[row].entry_count;
        if (width >= published - row) return no_node();
        if (interfaces[row].interface_kind != callable_view_interface() &&
            interfaces[row].defining_module == defining_module && interfaces[row].declaration == declaration)
            return row;
        row <- row + width + 1u64;
    };
    return no_node();
}

export func generic_product_arity(interfaces:const ModuleInterfaces in I, published:UInt64,
    module:UInt64, declaration:UInt64) -> UInt64 where {const owner I} {
    val header <- find_interface(interfaces, published, module, declaration);
    if (header == no_node() || interfaces[header].interface_kind != generic_product_interface()) return no_node();
    return case interfaces[header].payload of {
        GenericProduct { val parameters <-, } | parameters > 0u64 && parameters <= interfaces[header].entry_count -> parameters;
        _ -> no_node()
    }
}

func sum_field_row(row:const ModuleInterfaceRow in R) -> bool where {const owner R} {
    return case row.payload of {
        (ConstructorField { val kind <- field_kind, }) -> { row.value_kind == constructor_type() && kind != 0u8 };
        (_) -> { false };
    };
}

func constructor_parent(row:const ModuleInterfaceRow in R, module:UInt64, declaration:UInt64) -> bool where {const owner R} {
    return case row.payload of {
        (ConstructorInterface { val parent_module <- sum_module, val parent_declaration <- sum_declaration, }) -> {
            parent_module == module && parent_declaration == declaration
        };
        (_) -> { false };
    };
}

export func checked_sum_constructor(interfaces:const ModuleInterfaces in I, published:UInt64, parent:UInt64, entry:UInt64) -> UInt64
    where {const owner I} {
    if (published > intrinsic (len)(interfaces) || parent >= published ||
        interfaces[parent].interface_kind != sum_type() || interfaces[parent].value_kind != 0u8 ||
        interfaces[parent].entry_count >= published - parent || entry <= parent ||
        entry - parent > interfaces[parent].entry_count || interfaces[entry].value_kind != constructor_type())
        return no_node();
    case interfaces[parent].payload of {
        (SumInterface) -> {};
        (_) -> { return no_node(); };
    };
    val constructor <- no_node();
    case interfaces[entry].payload of {
        (ConstructorReference { val module <- defining_module, val declaration <- declaration, }) -> {
            if (module != interfaces[parent].defining_module) return no_node();
            (constructor <- find_interface(interfaces, published, module, declaration)):void;
        };
        (_) -> { return no_node(); };
    };
    if (constructor == no_node() || interfaces[constructor].interface_kind != constructor_type() ||
        !constructor_parent(interfaces[constructor], interfaces[parent].defining_module, interfaces[parent].declaration))
        return no_node();
    for (field in constructor + 1u64 .. constructor + 1u64 + interfaces[constructor].entry_count) {
        if (!sum_field_row(interfaces[field])) return no_node();
    };
    return constructor;
}

export func checked_aggregate_storage(interfaces:const ModuleInterfaces in I, published:UInt64, module:UInt64,
                                      declaration:UInt64, kind:UInt8) -> AggregateStorage where {const owner I} {
    val head <- find_interface(interfaces, published, module, declaration);
    if (head == no_node() || interfaces[head].interface_kind != kind) return (UnprovedAggregate:AggregateStorage);
    val storage <- interfaces[head].aggregate_storage;
    if (kind != sum_type()) {
        for (field in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
            if (interfaces[field].interface_kind != 0u8 || interfaces[field].value_kind == 0u8 ||
                interfaces[field].entry_count != 0u64) return (UnprovedAggregate:AggregateStorage);
        };
        return storage;
    };
    if (storage == (CLayoutBitsRecord:AggregateStorage) || interfaces[head].entry_count == 0u64)
        return (UnprovedAggregate:AggregateStorage);
    for (entry in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (checked_sum_constructor(interfaces, published, head, entry) == no_node())
            return (UnprovedAggregate:AggregateStorage);
    };
    return storage;
}
