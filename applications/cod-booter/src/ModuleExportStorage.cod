# The name span and any builtin path span belong to the catalog's spelling
# bytes. A source export names its publishing module independently of origin.
export data ModuleExport {
    module_first:u64;
    module_past:u64;
    name_first:u64;
    name_past:u64;
    identity:u64;
    kind:u8;
    checked:u8;
    publishing_module:u64;
    origin_module:u64;
    owner_module:u64;
    owner_identity:u64;
    shape:u8;
}
export array ModuleExports[u64]:ModuleExport;

# An interface header has parameter_kind zero. Its parameter records follow
# in declaration order. A here operation lists its supplier, then receivers.
# Both declarations and nominal types retain their defining-module identity.
export data NativeInterfaceRow {
    defining_module:u64;
    declaration:u64;
    parameter_count:u64;
    interface_kind:u8;
    result_kind:u8;
    parameter_kind:u8;
    type_module:u64;
    type_identity:u64;
    owner_role:u64;
    target_readonly:u8;
    owner_readonly:u8;
}
export array NativeInterfaces[u64]:NativeInterfaceRow;
