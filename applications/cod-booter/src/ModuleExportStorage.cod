# The name span and any builtin path span belong to the catalog's spelling
# bytes. A source export names its publishing module independently of origin.
data ModuleExport {
    module_first:u64;
    module_past:u64;
    name_first:u64;
    name_past:u64;
    identity:u64;
    kind:u8;
    checked:u8;
    publishing_module:u64;
    origin_module:u64;
    owner_module:u64;
    owner_identity:u64;
    shape:u8;
}
array ModuleExports[u64]:ModuleExport;

# Each constructor header has parameter_kind 0. Its parameter records follow
# in declaration order. Type identities refer to the defining module.
data NativeConstructorRow {
    defining_module:u64;
    marker:u64;
    parameter_count:u64;
    parameter_kind:u8;
    type_module:u64;
    type_identity:u64;
    owner_role:u64;
    target_readonly:u8;
    owner_readonly:u8;
}
array NativeConstructors[u64]:NativeConstructorRow;

export ModuleExport;
export ModuleExports;
export NativeConstructorRow;
export NativeConstructors;
