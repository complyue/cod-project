using "./ParserStorage.cod" { no_node, ResourceNature, FormalMode { ValueFormal } };

# The name span and any builtin path span belong to the catalog's spelling
# bytes. A source export names its publishing module independently of origin.
export data ModuleExport {
    module_first:u64;
    module_past:u64;
    name_first:u64;
    name_past:u64;
    identity:u64;
    kind:u8;
    checked:u8;
    publishing_module:u64;
    origin_module:u64;
    owner_module:u64;
    owner_identity:u64;
    shape:u8;
}
export array ModuleExports[u64]:ModuleExport;

export data DefaultExportRef { public_row:u64; nature:ResourceNature; }
export array DefaultExportRefs[u64]:DefaultExportRef;

export func enum_type() -> u8 { return 26u8; }
export func sum_type() -> u8 { return 39u8; }
export func constructor_type() -> u8 { return 40u8; }

export enum AggregateStorage:u8 { UnprovedAggregate; CoDBitsAggregate; CLayoutBitsRecord; NonBitsAggregate; }
export enum InterfaceCallableKind:u8 { NoCallableKind; CheckedFunction; CheckedProcedure; }

# Every membership header already identifies its defining source row. In
# a variadic singleton it is also the identity of the sole implementation.
export enum FamilyMembership:u8 { UnprovedMembership; PromiseOnly; FixedMethods; VariadicMethod; }

export data SumInterfacePayload =
    NoSumInterface {} |
    SumInterface {} |
    ConstructorReference { defining_module:u64; declaration:u64; } |
    ConstructorInterface { sum_module:u64; sum_declaration:u64; } |
    ConstructorField { field_kind:u8; field_module:u64; field_identity:u64; mode:FormalMode; readonly:bool; };

# An interface header has value_kind zero and precedes its entries. A here
# operation lists its supplier, then receivers. A record lists its fields.
# Both declarations and nominal types retain their defining-module identity.
export data ModuleInterfaceRow {
    defining_module:u64;
    declaration:u64;
    entry_count:u64;
    owner_count:u64;
    interface_kind:u8;
    result_kind:u8;
    element_kind:u8;
    value_kind:u8;
    type_module:u64;
    type_identity:u64;
    owner_role:u64;
    target_readonly:u8;
    owner_readonly:u8;
    has_here:u8;
    failure_checked:u8;
    failure_module:u64;
    failure_identity:u64;
    name_first:u64;
    name_past:u64;
    enum_code:u64;
    native_function:u64;
    callable_kind:InterfaceCallableKind;
    membership:FamilyMembership;
    native_reception:u8;
    native_passes_owner:u8;
    sum_payload:SumInterfacePayload;
    aggregate_storage:AggregateStorage;
    field_mode:FormalMode;
}
export array ModuleInterfaces[u64]:ModuleInterfaceRow;

export func write_interface_header(row:ModuleInterfaceRow in R, defining_module:u64, declaration:u64,
                                   kind:u8, result:u8, entries:u64) -> void where {owner R} {
    row.defining_module <- defining_module;
    row.declaration <- declaration;
    row.entry_count <- entries;
    row.owner_count <- 0u64;
    row.interface_kind <- kind;
    row.result_kind <- result;
    row.element_kind <- 0u8;
    row.value_kind <- 0u8;
    row.type_module <- 0u64;
    row.type_identity <- 0u64;
    row.owner_role <- no_node();
    row.target_readonly <- 0u8;
    row.owner_readonly <- 0u8;
    row.has_here <- 0u8;
    row.failure_module <- 0u64;
    row.failure_identity <- 0u64;
    row.failure_checked <- 0u8;
    row.name_first <- 0u64;
    row.name_past <- 0u64;
    row.enum_code <- 0u64;
    row.native_function <- no_node();
    row.callable_kind <- (NoCallableKind:InterfaceCallableKind);
    row.membership <- (UnprovedMembership:FamilyMembership);
    row.native_reception <- 0u8;
    row.native_passes_owner <- 0u8;
    row.aggregate_storage <- (UnprovedAggregate:AggregateStorage);
    row.field_mode <- ValueFormal;
    return;
}

export func write_sum_row(interfaces:ModuleInterfaces in I, row:u64, module:u64, declaration:u64,
                         kind:u8, entries:u64, first:u64, past:u64, payload:const SumInterfacePayload in P) -> void
    where {owner I, const owner P} {
    interfaces[row] <- make ModuleInterfaceRow {
        defining_module <- module; declaration <- declaration; entry_count <- entries; owner_count <- 0u64;
        interface_kind <- kind; result_kind <- 0u8; element_kind <- 0u8;
        value_kind <- if (kind == 0u8) { constructor_type() } else { 0u8 };
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- 0u64; name_first <- first; name_past <- past;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <-
            (NoCallableKind:InterfaceCallableKind); native_reception <- 0u8;
        native_passes_owner <- 0u8; sum_payload <- payload;
        membership <- (UnprovedMembership:FamilyMembership);
        aggregate_storage <- (UnprovedAggregate:AggregateStorage); field_mode <- ValueFormal;
    };
    return;
}

export func find_interface(interfaces:const ModuleInterfaces in I, published:u64, defining_module:u64, declaration:u64) -> u64
    where {const owner I} {
    if (published > intrinsic (len)(interfaces)) return no_node();
    val row <- 0u64;
    val width <- 0u64;
    for (unused in 0u64 .. published) {
        if (row >= published || interfaces[row].value_kind != 0u8 || interfaces[row].interface_kind == 0u8)
            return no_node();
        width <- interfaces[row].entry_count;
        if (width >= published - row) return no_node();
        if (interfaces[row].defining_module == defining_module && interfaces[row].declaration == declaration) return row;
        row <- row + width + 1u64;
    };
    return no_node();
}

func sum_field_row(row:const ModuleInterfaceRow in R) -> bool where {const owner R} {
    return case row.sum_payload of {
        (ConstructorField { val kind <- field_kind; }) -> { row.value_kind == constructor_type() && kind != 0u8 };
        (_) -> { false };
    };
}

func constructor_parent(row:const ModuleInterfaceRow in R, module:u64, declaration:u64) -> bool where {const owner R} {
    return case row.sum_payload of {
        (ConstructorInterface { val parent_module <- sum_module; val parent_declaration <- sum_declaration; }) -> {
            parent_module == module && parent_declaration == declaration
        };
        (_) -> { false };
    };
}

export func checked_sum_constructor(interfaces:const ModuleInterfaces in I, published:u64, parent:u64, entry:u64) -> u64
    where {const owner I} {
    if (published > intrinsic (len)(interfaces) || parent >= published ||
        interfaces[parent].interface_kind != sum_type() || interfaces[parent].value_kind != 0u8 ||
        interfaces[parent].entry_count >= published - parent || entry <= parent ||
        entry - parent > interfaces[parent].entry_count || interfaces[entry].value_kind != constructor_type())
        return no_node();
    case interfaces[parent].sum_payload of {
        (SumInterface) -> {};
        (_) -> { return no_node(); };
    };
    val constructor <- no_node();
    case interfaces[entry].sum_payload of {
        (ConstructorReference { val module <- defining_module; val declaration <- declaration; }) -> {
            if (module != interfaces[parent].defining_module) return no_node();
            (constructor <- find_interface(interfaces, published, module, declaration)):void;
        };
        (_) -> { return no_node(); };
    };
    if (constructor == no_node() || interfaces[constructor].interface_kind != constructor_type() ||
        !constructor_parent(interfaces[constructor], interfaces[parent].defining_module, interfaces[parent].declaration))
        return no_node();
    for (field in constructor + 1u64 .. constructor + 1u64 + interfaces[constructor].entry_count) {
        if (!sum_field_row(interfaces[field])) return no_node();
    };
    return constructor;
}

export func checked_aggregate_storage(interfaces:const ModuleInterfaces in I, published:u64, module:u64,
                                      declaration:u64, kind:u8) -> AggregateStorage where {const owner I} {
    val head <- find_interface(interfaces, published, module, declaration);
    if (head == no_node() || interfaces[head].interface_kind != kind) return (UnprovedAggregate:AggregateStorage);
    val storage <- interfaces[head].aggregate_storage;
    if (kind != sum_type()) {
        for (field in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
            if (interfaces[field].interface_kind != 0u8 || interfaces[field].value_kind == 0u8 ||
                interfaces[field].entry_count != 0u64) return (UnprovedAggregate:AggregateStorage);
        };
        return storage;
    };
    if (storage == (CLayoutBitsRecord:AggregateStorage) || interfaces[head].entry_count == 0u64)
        return (UnprovedAggregate:AggregateStorage);
    for (entry in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (checked_sum_constructor(interfaces, published, head, entry) == no_node())
            return (UnprovedAggregate:AggregateStorage);
    };
    return storage;
}
