using "./Lexer.cod" {
    own_word, quoted_text, multiline_text, identifier, using_word, as_word, symbol_word, symbol_name,
    from_word, proc_word, func_word, ref_word, ptr_word, where_word, const_word, in_word,
    data_word, array_word, export_word, handle_word, c_linkage, enum_word, integer_literal,
    import_word, type_word, region_word, valid_module_path, invalid_module_path_escape,
};
using "./ExpressionParser.cod" {
    callable_local_head, parse_symbol, parse_callable, parse_next_expression, integer_width, parse_integer_magnitude,
};
using "./ParserInput.cod" {
    ParseResult, punct_at, punct_pair_at, append_syntax_node, append_module_item, append_module, parse_identifier,
    parse_module_name, parse_resource_name, reset_parse_result, expected_name, expected_type, expected_c_linkage,
    closing_token, recover_syntax_until, seed_lexical_reports,
};
using "./CallableSyntax.cod" {
    expected_owner_clause, parse_constraints, parse_parameter, parse_procedure_symbol_type
};
using "./ParserStorage.cod" {
    Tokens, ExprNodes, NodeId, len as token_len, no_node, syntax_first, syntax_past, ModuleSelectionMode,
    BindingSites, FormalSites, SignatureSites, inspect_binding, inspect_formal, inspect_signature,
};
using "./ParserStorage.cod" AstSlot { Vacant, Occupied };
using "./ParserStorage.cod" SyntaxRole { ModuleItemRole };
using "./ParserStorage.cod" ExprPayload {
    CallableDefinition, CEntryDefinition, ModulePathSyntax, ModuleSelection, AllMembers, ChosenMembers, ChosenMember,
    HandleType, NominalParent, RecordDefinition, AbstractType, HandleSymbol, ReferenceSymbol, Publication,
    ArrayDefinition, EnumInteger, EnumMember, EnumDefinition, SumDefinition, SumArm, RegionDefinition,
};
using "./ParserStorage.cod" FormalSyntax { OrdinaryFormal };
using "./ParserStorage.cod" FormalMode { ValueFormal, HandleFormal, RetainedHandleFormal };
using "./ParserStorage.cod" BindingSyntax { TypedBinding };
using "./ParserStorage.cod" SignatureSyntax { OwnerSignatureClause };
using "./ParserStorage.cod" NodeLink { NoLink, LinkTo };
using "./ParserStorage.cod" ModuleSelectionMode { UseResource, ImportResource, ReexportResource };
using "./SourceStorage.cod" SourceBytes;
using "./SourceAccess.cod" { len as source_len, same_bytes };

func expected_module_path() -> u8 { return 22u8; }
func expected_module_separator() -> u8 { return 25u8; }
func expected_record_fields() -> u8 { return 30u8; }
func expected_array_shape() -> u8 { return 31u8; }
func expected_group_delimiter() -> u8 { return 44u8; }
func expected_enum_member() -> u8 { return 45u8; }

func append_selected_member(nodes:ExprNodes in A, result:ParseResult in R, preceding:u64, item:u64) -> void
    where {owner A, owner R} {
    ref previous = make NoLink {};
    if (preceding != no_node()) {
        previous = make LinkTo { node <- make NodeId { revision <- result.revision; index <- preceding; }; };
        {};
    };
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, item), syntax_past(nodes, result.used, item),
                       make ChosenMember {
                           previous <- previous;
                           member <- make NodeId { revision <- result.revision; index <- item; };
                       });
}

func append_chosen_members(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                           tail:u64, opening:u64) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, first, past, make ChosenMembers {
        items <- make NodeId { revision <- result.revision; index <- tail; };
        opening <- opening;
    });
}

func parse_member_selector(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R, past:u64, name:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_pair_at(source, tokens, result.next, past, 46u8, 46u8)) {
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 125u8) {
            result.diagnostic <- expected_group_delimiter();
            return;
        } else {};
        append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), tokens[result.next].past,
                           make AllMembers { opening <- first; });
        result.next <- result.next + 1u64;
        return;
    } else {};
    val last <- no_node();
    val item <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_module_name(source, tokens, nodes, result, past)) return;
        item <- result.root;
        append_selected_member(nodes, result, last, item);
        if (result.diagnostic != 0u8) return;
        last <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 44u8) { (result.next <- result.next + 1u64):void; } else {};
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            append_chosen_members(nodes, result, syntax_first(nodes, result.used, name), tokens[result.next].past, last, first);
            result.next <- result.next + 1u64;
            return;
        } else {};
        if (delimiter != 44u8) { result.diagnostic <- expected_group_delimiter(); return; } else {};
    };
    (result.diagnostic <- expected_group_delimiter()):void;
}

func parse_selection(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R,
                     past:u64, first:u64, path:u64, mode:ModuleSelectionMode, symbolic:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    if (symbolic) {
        if (!parse_symbol(tokens, nodes, result, past)) return;
    } else {
        if (!parse_resource_name(source, tokens, nodes, result, past)) return;
    };
    val selection <- result.root;
    ref renamed = make NoLink {};
    if (result.next < past && as_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (symbolic) {
            if (!parse_symbol(tokens, nodes, result, past)) return;
        } else {
            if (!parse_resource_name(source, tokens, nodes, result, past)) return;
        };
        renamed = make LinkTo { node <- make NodeId { revision <- result.revision; index <- result.root; }; };
        {};
    } else {};
    val end <- syntax_past(nodes, result.used, result.root);
    ref members = make NoLink {};
    if (!symbolic && mode != ReexportResource && punct_at(source, tokens, result.next, past) == 123u8) {
        parse_member_selector(source, tokens, nodes, result, past, selection);
        if (result.diagnostic != 0u8) return;
        members = make LinkTo { node <- make NodeId { revision <- result.revision; index <- result.root; }; };
        (end <- syntax_past(nodes, result.used, result.root)):void;
    } else {};
    append_syntax_node(nodes, result, first, end, make ModuleSelection {
        path <- make NodeId { revision <- result.revision; index <- path; };
        resource <- make NodeId { revision <- result.revision; index <- selection; };
        renamed <- renamed; members <- members; mode <- mode;
    });
}

func finish_selection_item(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R, past:u64, first:u64,
                           preceding:u64, form:u64, published:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_at(source, tokens, result.next, past) != 59u8) {
        result.diagnostic <- expected_module_separator();
        return false;
    };
    append_module_item(nodes, result, first, tokens[result.next].past, preceding, form, published);
    if (result.diagnostic != 0u8) return false;
    result.next <- result.next + 1u64;
    return true;
}

func parse_selection_items(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R,
                           past:u64, previous:u64, mode:ModuleSelectionMode, exported:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    val first <- tokens[start].first;
    val reexporting <- mode == ReexportResource;
    result.next <- start + if (reexporting || exported) { 2u64 } else { 1u64 };
    val symbolic <- mode == UseResource && result.next < past && symbol_word(source, tokens[result.next]);
    if (symbolic) { (result.next <- result.next + 1u64):void; } else {};
    val path <- result.next;
    if (path >= past || tokens[path].kind != quoted_text()) {
        result.diagnostic <- expected_module_path();
        return false;
    } else {};
    if (!valid_module_path(source, tokens[path])) {
        result.diagnostic <- invalid_module_path_escape();
        return false;
    } else {};
    append_syntax_node(nodes, result, tokens[path].first, tokens[path].past, make ModulePathSyntax {});
    if (result.diagnostic != 0u8) return false;
    val path_node <- result.root;
    result.next <- path + 1u64;
    if (reexporting) {
        (symbolic <- result.next < past && tokens[result.next].kind == symbol_name()):void;
    } else {};
    val grouped <- !reexporting && punct_at(source, tokens, result.next, past) == 123u8;
    if (grouped) { (result.next <- result.next + 1u64):void; } else {};
    val tail <- previous;
    val item_first <- first;
    val form <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (grouped) { (item_first <- tokens[result.next].first):void; } else {};
        parse_selection(source, tokens, nodes, result, past, item_first, path_node, mode, symbolic);
        if (result.diagnostic != 0u8) return false;
        form <- result.root;
        if (!grouped)
            return finish_selection_item(source, tokens, nodes, result, past, item_first, tail, form, exported);
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 44u8) { (result.next <- result.next + 1u64):void; };
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            result.next <- result.next + 1u64;
            return finish_selection_item(source, tokens, nodes, result, past, item_first, tail, form, exported);
        };
        if (delimiter != 44u8) {
            result.diagnostic <- expected_group_delimiter();
            return false;
        };
        append_module_item(nodes, result, item_first, syntax_past(nodes, result.used, form), tail, form, exported);
        if (result.diagnostic != 0u8) return false;
        tail <- result.root;
    };
    result.diagnostic <- expected_module_separator();
    return false;
}

func skip_member_doclet(tokens:const Tokens in T, result:ParseResult in R, past:u64) -> void
    where {const owner T, owner R} {
    if (result.next < past && tokens[result.next].kind == multiline_text()) {
        (result.next <- result.next + 1u64):void
    };
}

# A record links its fields in source order through the preceding field.
func parse_record_fields(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R,
                         past:u64, native:bool) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_at(source, tokens, result.next, past) != 123u8) {
        result.diagnostic <- expected_record_fields();
        return no_node();
    } else {};
    result.next <- result.next + 1u64;
    val last <- no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            if (native && last == no_node()) {
                result.diagnostic <- expected_record_fields();
                return no_node();
            } else {};
            result.next <- result.next + 1u64;
            return last;
        } else {};
        skip_member_doclet(tokens, result, past);
        if (!parse_parameter(source, tokens, nodes, result, past, last, true)) return no_node();
        last <- result.root;
        if (inspect_formal(nodes, result.revision, result.used, last, formal) != OrdinaryFormal ||
            inspect_binding(nodes, result.revision, result.used, formal.binding, binding) != TypedBinding ||
            formal.mode == HandleFormal || formal.mode == RetainedHandleFormal || binding.owner_name != no_node()) {
            result.diagnostic <- expected_record_fields();
            return no_node();
        } else {};
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 125u8) { result.next <- result.next + 1u64; return last; } else {};
        if (delimiter != 59u8) { result.diagnostic <- expected_record_fields(); return no_node(); } else {};
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_record_fields();
    return no_node();
}

func parse_sum_arm(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    skip_member_doclet(tokens, result, past);
    if (!parse_module_name(source, tokens, nodes, result, past)) return false;
    val name <- result.root;
    val first <- syntax_first(nodes, result.used, name);
    val fields <- parse_record_fields(source, tokens, nodes, result, past, false);
    if (result.diagnostic != 0u8) return false;
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    ref contents = make NoLink {};
    if (fields != no_node()) {
        contents = make LinkTo { node <- make NodeId { revision <- result.revision; index <- fields; }; };
        {};
    };
    append_syntax_node(nodes, result, first, tokens[result.next - 1u64].past, make SumArm {
        name <- make NodeId { revision <- result.revision; index <- name; };
        previous <- preceding;
        fields <- contents;
    });
    return result.diagnostic == 0u8;
}

func append_sum_declaration(nodes:ExprNodes in A, result:ParseResult in R, first:u64, heading:u64, last:u64) -> void
    where {owner A, owner R} {
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, last), make SumDefinition {
        heading <- make NodeId { revision <- result.revision; index <- heading; };
        last_arm <- make NodeId { revision <- result.revision; index <- last; };
    });
}

func parse_sum_declaration(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64, heading:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    val last <- no_node();
    val delimiter <- 0u8;
    for (unused in 0u64 .. past) {
        if (!parse_sum_arm(source, tokens, nodes, result, past, last)) return;
        last <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 59u8) {
            append_sum_declaration(nodes, result, first, heading, last);
            return;
        };
        if (delimiter != 124u8) {
            result.diagnostic <- expected_module_separator();
            return;
        };
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_name();
    return;
}

func handle_type_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    return at + 1u64 < past && handle_word(source, tokens[at]) && type_word(source, tokens[at + 1u64]);
}

func parse_handle_type(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 2u64;
    if (!parse_module_name(source, tokens, nodes, result, past)) return;
    val name <- result.root;
    if (result.next < past && in_word(source, tokens[result.next])) {
        val in_at <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
        val owner_type <- result.root;
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, owner_type), make HandleType {
            name <- make NodeId { revision <- result.revision; index <- name; };
            parent_type <- make LinkTo { node <- make NodeId { revision <- result.revision; index <- owner_type; }; };
            parent_at <- in_at;
        });
        return;
    } else {};
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, name), make HandleType {
        name <- make NodeId { revision <- result.revision; index <- name; };
        parent_type <- make NoLink {};
        parent_at <- first;
    });
}

func parse_region_definition(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_module_name(source, tokens, nodes, result, past)) return;
    val name <- result.root;
    val fields <- parse_record_fields(source, tokens, nodes, result, past, false);
    if (result.diagnostic != 0u8) return;
    ref entries = make NoLink {};
    if (fields != no_node()) {
        entries = make LinkTo { node <- make NodeId { revision <- result.revision; index <- fields; }; };
        {};
    };
    append_syntax_node(nodes, result, first, tokens[result.next - 1u64].past, make RegionDefinition {
        name <- make NodeId { revision <- result.revision; index <- name; };
        fields <- entries;
    });
}

func parse_nominal_type(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val abstract <- type_word(source, tokens[result.next]);
    result.next <- result.next + 1u64;
    val native <- !abstract && result.next < past && tokens[result.next].kind == quoted_text();
    if (native) {
        if (!c_linkage(source, tokens[result.next])) { result.diagnostic <- expected_c_linkage(); return; } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    if (!parse_module_name(source, tokens, nodes, result, past)) return;
    val name <- result.root;
    val descriptor <- name;
    if (punct_pair_at(source, tokens, result.next, past, 60u8, 58u8)) { # '<:'
        val parent_at <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
        val parent <- result.root;
        append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), syntax_past(nodes, result.used, parent),
                           make NominalParent {
            name <- make NodeId { revision <- result.revision; index <- name; };
            parent_type <- make NodeId { revision <- result.revision; index <- parent; };
            anchor <- parent_at;
        });
        if (result.diagnostic != 0u8) return;
        (descriptor <- result.root):void;
    } else {};
    if (abstract) {
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, descriptor), make AbstractType {
            heading <- make NodeId { revision <- result.revision; index <- descriptor; };
        });
        return;
    };
    if (!native && punct_at(source, tokens, result.next, past) == 61u8) {
        parse_sum_declaration(source, tokens, nodes, result, first, past, descriptor);
        return;
    };
    val fields <- parse_record_fields(source, tokens, nodes, result, past, native);
    if (result.diagnostic != 0u8) return;
    ref entries = make NoLink {};
    if (fields != no_node()) {
        entries = make LinkTo { node <- make NodeId { revision <- result.revision; index <- fields; }; };
        {};
    };
    append_syntax_node(nodes, result, first, tokens[result.next - 1u64].past, make RecordDefinition {
        heading <- make NodeId { revision <- result.revision; index <- descriptor; };
        fields <- entries;
        native <- native;
    });
}

func parse_symbol_declaration(source:const SourceBytes in S, tokens:const Tokens in T,
                              nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_symbol(tokens, nodes, result, past)) return;
    val name <- result.root;
    val colon <- result.next;
    if (punct_at(source, tokens, colon, past) != 58u8) { result.diagnostic <- expected_type(); return; } else {};
    val qualifier <- colon + 1u64;
    if (qualifier < past && proc_word(source, tokens[qualifier]) &&
        punct_at(source, tokens, qualifier + 1u64, past) == 40u8) {
        result.next <- qualifier;
        parse_procedure_symbol_type(source, tokens, nodes, result, past, first, name);
        return;
    };
    if (qualifier + 1u64 >= past || !own_word(source, tokens[qualifier]) || !handle_word(source, tokens[qualifier + 1u64])) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    result.next <- qualifier + 2u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val marker <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, marker), make HandleSymbol {
        name <- make NodeId { revision <- result.revision; index <- name; };
        marker <- make NodeId { revision <- result.revision; index <- marker; };
    });
}

func reference_symbol_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    return at + 1u64 < past && (ref_word(source, tokens[at]) || ptr_word(source, tokens[at])) &&
        symbol_word(source, tokens[at + 1u64]);
}

func parse_reference_symbol(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                            result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    val nullable <- ptr_word(source, tokens[at]);
    result.next <- at + 2u64;
    if (!parse_symbol(tokens, nodes, result, past)) return;
    val name <- result.root;
    if (punct_at(source, tokens, result.next, past) != 58u8) { result.diagnostic <- expected_type(); return; };
    result.next <- result.next + 1u64;
    val readonly <- result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val target <- result.root;
    if (result.next >= past || !in_word(source, tokens[result.next])) { result.diagnostic <- expected_owner_clause(); return; };
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val owner <- result.root;
    if (result.next >= past || !where_word(source, tokens[result.next])) { result.diagnostic <- expected_owner_clause(); return; };
    result.root <- no_node();
    parse_constraints(source, tokens, nodes, result, past, false);
    if (result.diagnostic != 0u8) return;
    ref constraint = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (inspect_signature(nodes, result.revision, result.used, result.root, constraint) != OwnerSignatureClause ||
        constraint.previous != no_node()) {
        result.diagnostic <- expected_owner_clause();
        return;
    };
    val parameter <- constraint.annotation;
    if (!same_bytes(source, syntax_first(nodes, result.used, owner), syntax_past(nodes, result.used, owner),
                    source, syntax_first(nodes, result.used, parameter), syntax_past(nodes, result.used, parameter))) {
        result.diagnostic <- expected_owner_clause();
        return;
    };
    append_syntax_node(nodes, result, first, tokens[result.next - 1u64].past, make ReferenceSymbol {
        name <- make NodeId { revision <- result.revision; index <- name; };
        target <- make NodeId { revision <- result.revision; index <- target; };
        owner_name <- make NodeId { revision <- result.revision; index <- owner; };
        readonly <- readonly || constraint.readonly;
        nullable <- nullable;
    });
}

func parse_publication(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (result.next < past && tokens[result.next].kind == symbol_name()) {
        if (!parse_symbol(tokens, nodes, result, past)) return;
    } else {
        if (!parse_resource_name(source, tokens, nodes, result, past)) return;
    };
    val name <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, name), make Publication {
        name <- make NodeId { revision <- result.revision; index <- name; };
    });
}

func parse_array(source:const SourceBytes in S, tokens:const Tokens in T,
                 nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_module_name(source, tokens, nodes, result, past)) return;
    val name <- result.root;
    if (punct_at(source, tokens, result.next, past) != 91u8) {
        result.diagnostic <- expected_array_shape();
        return;
    } else {};
    val shape_first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val index <- result.root;
    if (punct_at(source, tokens, result.next, past) != 93u8 ||
        punct_at(source, tokens, result.next + 1u64, past) != 58u8) {
        result.diagnostic <- expected_array_shape();
        return;
    } else {};
    result.next <- result.next + 2u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val element <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, element), make ArrayDefinition {
        name <- make NodeId { revision <- result.revision; index <- name; };
        index_type <- make NodeId { revision <- result.revision; index <- index; };
        element_type <- make NodeId { revision <- result.revision; index <- element; };
        dimension_at <- shape_first;
    });
}

func parse_enum_initializer(source:const SourceBytes in S, tokens:const Tokens in T,
                            nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val negative <- punct_at(source, tokens, first, past) == 45u8;
    val at <- first + if (negative) { 1u64 } else { 0u64 };
    if (at < past && tokens[at].kind == integer_literal()) {
        val width <- integer_width(source, tokens[at]);
        val magnitude <- parse_integer_magnitude(source, tokens[at], result, width);
        if (result.diagnostic != 0u8) return false;
        append_syntax_node(nodes, result, tokens[first].first, tokens[at].past, make EnumInteger {
            magnitude <- magnitude; negative <- negative; width <- width;
        });
        result.next <- at + 1u64;
        return result.diagnostic == 0u8;
    } else {};
    if (!negative) return parse_module_name(source, tokens, nodes, result, past);
    result.diagnostic <- expected_enum_member();
    return false;
}

func parse_enum_member(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                       result:ParseResult in R, past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    skip_member_doclet(tokens, result, past);
    if (!parse_module_name(source, tokens, nodes, result, past)) return false;
    val name <- result.root;
    val initializer <- no_node();
    if (punct_at(source, tokens, result.next, past) == 61u8) {
        result.next <- result.next + 1u64;
        if (!parse_enum_initializer(source, tokens, nodes, result, past)) return false;
        (initializer <- result.root):void;
    } else {};
    if (punct_at(source, tokens, result.next, past) != 59u8) {
        result.diagnostic <- expected_module_separator();
        return false;
    } else {};
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    ref input = make NoLink {};
    if (initializer != no_node()) {
        input = make LinkTo { node <- make NodeId { revision <- result.revision; index <- initializer; }; };
        {};
    };
    val first <- syntax_first(nodes, result.used, name);
    append_syntax_node(nodes, result, first, tokens[result.next].past, make EnumMember {
        previous <- preceding;
        name <- make NodeId { revision <- result.revision; index <- name; };
        initializer <- input;
    });
    result.next <- result.next + 1u64;
    return result.diagnostic == 0u8;
}

func append_enum(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                  name:u64, backing:u64, member:u64) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, first, past, make EnumDefinition {
        name <- make NodeId { revision <- result.revision; index <- name; };
        backing <- make NodeId { revision <- result.revision; index <- backing; };
        member_tail <- make NodeId { revision <- result.revision; index <- member; };
    });
}

func parse_enum(source:const SourceBytes in S, tokens:const Tokens in T,
                nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_module_name(source, tokens, nodes, result, past)) return;
    val name <- result.root;
    if (punct_at(source, tokens, result.next, past) != 58u8) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val backing <- result.root;
    if (punct_at(source, tokens, result.next, past) != 123u8) {
        result.diagnostic <- expected_enum_member();
        return;
    } else {};
    result.next <- result.next + 1u64;
    val member <- no_node();
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            if (member == no_node()) { result.diagnostic <- expected_enum_member(); return; } else {};
            append_enum(nodes, result, first, tokens[result.next].past, name, backing, member);
            result.next <- result.next + 1u64;
            return;
        } else {};
        if (!parse_enum_member(source, tokens, nodes, result, past, member)) return;
        member <- result.root;
    };
    (result.diagnostic <- expected_enum_member()):void;
}

func parse_module_form(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val function_form <- func_word(source, tokens[at]);
    if ((function_form || proc_word(source, tokens[at])) && !callable_local_head(source, tokens, at, past)) {
        parse_callable(source, tokens, nodes, result, past, function_form, false);
        return;
    } else {};
    val named_declaration <- at + 1u64 < past && tokens[at + 1u64].kind == identifier();
    val marked_declaration <- at + 1u64 < past && tokens[at + 1u64].kind == quoted_text();
    if (reference_symbol_head(source, tokens, at, past)) {
        parse_reference_symbol(source, tokens, nodes, result, past);
        return;
    };
    if (symbol_word(source, tokens[at])) {
        parse_symbol_declaration(source, tokens, nodes, result, past);
        return;
    } else {};
    if (handle_type_head(source, tokens, at, past)) {
        parse_handle_type(source, tokens, nodes, result, past);
        return;
    } else {};
    if (named_declaration && region_word(source, tokens[at]) && punct_at(source, tokens, at + 2u64, past) == 123u8) {
        parse_region_definition(source, tokens, nodes, result, past);
        return;
    };
    if ((data_word(source, tokens[at]) && (named_declaration || marked_declaration)) ||
        (type_word(source, tokens[at]) && named_declaration)) {
        parse_nominal_type(source, tokens, nodes, result, past);
        return;
    } else {};
    if (array_word(source, tokens[at]) && named_declaration) {
        parse_array(source, tokens, nodes, result, past);
        return;
    } else {};
    if (enum_word(source, tokens[at]) && named_declaration) {
        parse_enum(source, tokens, nodes, result, past);
        return;
    } else {};
    if (export_word(source, tokens[at])) {
        parse_publication(source, tokens, nodes, result, past);
        return;
    } else {};
    parse_next_expression(source, tokens, nodes, result, past);
}

func named_definition_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (at + 1u64 >= past) return false;
    val next_kind <- tokens[at + 1u64].kind;
    return handle_type_head(source, tokens, at, past) ||
        reference_symbol_head(source, tokens, at, past) ||
        (symbol_word(source, tokens[at]) && next_kind == symbol_name()) ||
        ((func_word(source, tokens[at]) || proc_word(source, tokens[at])) &&
            !callable_local_head(source, tokens, at, past)) ||
        (data_word(source, tokens[at]) && (next_kind == identifier() || next_kind == quoted_text())) ||
        ((type_word(source, tokens[at]) || array_word(source, tokens[at]) || enum_word(source, tokens[at])) && next_kind == identifier());
}

func module_doclet_target(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (at >= past) return false;
    if (export_word(source, tokens[at])) return named_definition_head(source, tokens, at + 1u64, past);
    return named_definition_head(source, tokens, at, past) ||
        (at + 1u64 < past && region_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
         punct_at(source, tokens, at + 2u64, past) == 123u8)
}

func braced_callable_definition(nodes:const ExprNodes in N, used:u64, at:u64) -> bool where {const owner N} {
    if (at >= used) return false;
    return case nodes[at] of {
        (Vacant) -> { false };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (CallableDefinition) -> { true };
                (CEntryDefinition) -> { true };
                (_) -> { false };
            }
        };
    };
}

func parse_module_item(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R,
                       past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (tokens[result.next].kind == multiline_text() && module_doclet_target(source, tokens, result.next + 1u64, past)) {
        (result.next <- result.next + 1u64):void
    };
    val at <- result.next;
    if (using_word(source, tokens[at]))
        return parse_selection_items(source, tokens, nodes, result, past, previous, UseResource, false);
    if (import_word(source, tokens[at]))
        return parse_selection_items(source, tokens, nodes, result, past, previous, ImportResource, false);
    val export_prefix <- export_word(source, tokens[at]);
    if (export_prefix && at + 2u64 < past && from_word(source, tokens[at + 1u64]) &&
        tokens[at + 2u64].kind == quoted_text())
        return parse_selection_items(source, tokens, nodes, result, past, previous, ReexportResource, false);
    if (export_prefix && at + 1u64 < past && import_word(source, tokens[at + 1u64]))
        return parse_selection_items(source, tokens, nodes, result, past, previous, ImportResource, true);
    val public_definition <- export_prefix && named_definition_head(source, tokens, at + 1u64, past);
    if (public_definition) { (result.next <- at + 1u64):void; } else {};
    val definition_start <- result.next;
    parse_module_form(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return false;
    val form <- result.root;
    val end <- syntax_past(nodes, result.used, form);
    if (punct_at(source, tokens, result.next, past) == 59u8) { # ';'
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void;
    } else {
        val braced_type <- definition_start + 1u64 < result.next &&
            punct_at(source, tokens, result.next - 1u64, past) == 125u8 &&
            (((enum_word(source, tokens[definition_start]) || region_word(source, tokens[definition_start])) &&
              tokens[definition_start + 1u64].kind == identifier()) ||
             (data_word(source, tokens[definition_start]) &&
              (tokens[definition_start + 1u64].kind == identifier() || tokens[definition_start + 1u64].kind == quoted_text())));
        val delimited <- braced_type || braced_callable_definition(nodes, result.used, form);
        if (!delimited) { result.diagnostic <- expected_module_separator(); return false; } else {};
    };
    val first <- tokens[at].first;
    append_module_item(nodes, result, first, end, previous, form, public_definition);
    return result.diagnostic == 0u8;
}

# Only this grammar owns module item starts. End a damaged declaration
# before a following definition or selection at the same delimiter depth.
func module_recovery_boundary(source:const SourceBytes in S, tokens:const Tokens in T,
                              first:u64, past:u64) -> u64 where {const owner S, const owner T} {
    val at <- first;
    val close <- no_node();
    val delimiter <- 0u8;
    for (unused in first .. past) {
        if (at >= past) return past;
        if (at != first &&
            (named_definition_head(source, tokens, at, past) || export_word(source, tokens[at]) ||
             import_word(source, tokens[at]) || using_word(source, tokens[at]) ||
             (tokens[at].kind == multiline_text() && module_doclet_target(source, tokens, at + 1u64, past))))
            return at;
        delimiter <- punct_at(source, tokens, at, past);
        if (delimiter == 59u8 || delimiter == 125u8) return at;
        close <- closing_token(tokens, at, past);
        at <- if (close == no_node()) { at + 1u64 } else { close + 1u64 }
    };
    return past
}

export func parse_module(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, past:u64, result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(0u64, result);
    if (past >= token_len(tokens)) { result.diagnostic <- expected_module_separator(); return; };
    if (!seed_lexical_reports(tokens, nodes, result, 0u64, past)) return;
    val last <- no_node();
    val start <- 0u64;
    val boundary <- 0u64;
    val delimiter <- 0u8;
    for (unused in 0u64 .. past + 1u64) {
        if (result.next >= past) {
            append_module(nodes, result, source_len(source), last);
            return;
        } else {};
        start <- result.next;
        if (!parse_module_item(source, tokens, nodes, result, past, last)) {
            result.supplied_here <- false;
            result.case_control <- false;
            boundary <- module_recovery_boundary(source, tokens, start, past);
            if (!recover_syntax_until(tokens, nodes, result, start, boundary, past, ModuleItemRole)) return;
            append_module_item(nodes, result, tokens[start].first, tokens[boundary].first, last, result.root, false);
            if (result.diagnostic != 0u8) return;
            delimiter <- punct_at(source, tokens, boundary, past);
            if (delimiter == 59u8 || delimiter == 125u8) { (result.next <- boundary + 1u64):void; }
        };
        last <- result.root;
    };
    (result.diagnostic <- expected_module_separator()):void;
}
