using "ParserStorage.cod" throws_clause_node;
using "ParserStorage.cod" owner_clause_node;
using "ParserStorage.cod" owned_type_node;
using "ParserStorage.cod" c_handle_type_node;
using "ParserStorage.cod" c_procedure_node;
using "ParserStorage.cod" handle_parameter_node;
using "ParserStorage.cod" here_parameter_node;
using "ParserStorage.cod" data_record_node;
using "ParserStorage.cod" c_record_node;
using "ParserStorage.cod" data_parent_node;
using "ParserStorage.cod" export_node;
using "ParserStorage.cod" export_from_node;
using "ParserStorage.cod" array_declaration_node;
using "ParserStorage.cod" array_shape_node;
using "ParserStorage.cod" readonly_declaration;
using "Lexer.cod" module_path;
using "Lexer.cod" identifier;
using "Lexer.cod" using_word;
using "Lexer.cod" as_word;
using "Lexer.cod" symbol_word;
using "Lexer.cod" symbol_name;
using "Lexer.cod" from_word;
using "Lexer.cod" proc_word;
using "Lexer.cod" func_word;
using "Lexer.cod" ref_word;
using "Lexer.cod" ptr_word;
using "Lexer.cod" val_word;
using "Lexer.cod" throws_word;
using "Lexer.cod" where_word;
using "Lexer.cod" owner_word;
using "Lexer.cod" const_word;
using "Lexer.cod" in_word;
using "Lexer.cod" data_word;
using "Lexer.cod" reserved_module_name;
using "Lexer.cod" array_word;
using "Lexer.cod" export_word;
using "Lexer.cod" handle_word;
using "Lexer.cod" here_word;
using "Lexer.cod" c_linkage;
using "ExpressionParser.cod" ParseResult;
using "ExpressionParser.cod" punct_at;
using "ExpressionParser.cod" punct_pair_at;
using "ExpressionParser.cod" append_node;
using "ExpressionParser.cod" parse_identifier;
using "ExpressionParser.cod" callable_local_head;
using "ExpressionParser.cod" parse_symbol;
using "ExpressionParser.cod" parse_binding_name;
using "ExpressionParser.cod" parse_block;
using "ExpressionParser.cod" parse_next_expression;
using "ExpressionParser.cod" reset_parse_result;
using "ExpressionParser.cod" expected_name;
using "ExpressionParser.cod" expected_type;

func expected_module_path() -> u8 { return 22u8; }
func expected_parameter_list() -> u8 { return 23u8; }
func expected_owner_clause() -> u8 { return 24u8; }
func expected_module_separator() -> u8 { return 25u8; }
func expected_c_linkage() -> u8 { return 29u8; }
func expected_record_fields() -> u8 { return 30u8; }
func expected_array_shape() -> u8 { return 31u8; }
func invalid_exception_owner() -> u8 { return 35u8; }
func invalid_value_parameter_owner() -> u8 { return 41u8; }
func expected_group_delimiter() -> u8 { return 44u8; }

func parse_module_name(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (result.next < past && reserved_module_name(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return false;
    } else {};
    return parse_identifier(source, tokens, nodes, result, past, expected_name());
}

func parse_selection(source:const SourceBytes in S, tokens:const Tokens in T,
                     ref nodes:ExprNodes in A, ref result:ParseResult in R,
                     past:u64, first:u64, path:u64, kind:u8, symbolic:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    if (symbolic) {
        if (!parse_symbol(tokens, nodes, result, past)) { return; } else {};
    } else {
        if (!parse_module_name(source, tokens, nodes, result, past)) { return; } else {};
    };
    val selection <- result.root;
    val local_name <- 0u64;
    if (result.next < past && as_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (symbolic) {
            if (!parse_symbol(tokens, nodes, result, past)) { return; } else {};
        } else {
            if (!parse_module_name(source, tokens, nodes, result, past)) { return; } else {};
        };
        (local_name <- result.root + 1u64):void;
    } else {};
    val last_name <- result.root;
    append_node(nodes, result, kind, first, nodes[last_name].past, local_name, path, selection, first);
}

func finish_selection_items(source:const SourceBytes in S, tokens:const Tokens in T,
                            ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64, tail:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_at(source, tokens, result.next, past) != 59u8) {
        result.diagnostic <- expected_module_separator();
        return false;
    } else {};
    nodes[tail].past <- tokens[result.next].past;
    result.next <- result.next + 1u64;
    return true;
}

func parse_selection_items(source:const SourceBytes in S, tokens:const Tokens in T,
                           ref nodes:ExprNodes in A, ref result:ParseResult in R,
                           past:u64, previous:u64, reexporting:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    val first <- tokens[start].first;
    val kind <- if (reexporting) { export_from_node() } else { using_node() };
    result.next <- start + if (reexporting) { 2u64 } else { 1u64 };
    val symbolic <- !reexporting && result.next < past && symbol_word(source, tokens[result.next]);
    if (symbolic) { (result.next <- result.next + 1u64):void; } else {};
    val path <- result.next;
    if (path >= past || tokens[path].kind != module_path()) {
        result.diagnostic <- expected_module_path();
        return false;
    } else {};
    append_node(nodes, result, module_path_node(), tokens[path].first, tokens[path].past,
                0u64, 0u64, 0u64, tokens[path].first);
    if (result.diagnostic != 0u8) { return false; } else {};
    val path_node <- result.root;
    result.next <- path + 1u64;
    if (reexporting) {
        (symbolic <- result.next < past && tokens[result.next].kind == symbol_name()):void;
    } else {};
    val grouped <- !reexporting && punct_at(source, tokens, result.next, past) == 123u8;
    if (grouped) { (result.next <- result.next + 1u64):void; } else {};
    val tail <- previous;
    val item_first <- first;
    val form <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (grouped) { (item_first <- tokens[result.next].first):void; } else {};
        parse_selection(source, tokens, nodes, result, past, item_first, path_node, kind, symbolic);
        if (result.diagnostic != 0u8) { return false; } else {};
        form <- result.root;
        append_node(nodes, result, module_item_node(), item_first, nodes[form].past, 0u64, tail, form, item_first);
        if (result.diagnostic != 0u8) { return false; } else {};
        tail <- result.root;
        if (!grouped) { return finish_selection_items(source, tokens, nodes, result, past, tail); } else {};
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 44u8) { (result.next <- result.next + 1u64):void; } else {};
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            result.next <- result.next + 1u64;
            return finish_selection_items(source, tokens, nodes, result, past, tail);
        } else {};
        if (delimiter != 44u8) {
            result.diagnostic <- expected_group_delimiter();
            return false;
        } else {};
    };
    result.diagnostic <- expected_module_separator();
    return false;
}

# Formal parameters link to their preceding parameter and retain the typed name.
func parse_parameter(source:const SourceBytes in S, tokens:const Tokens in T,
                     ref nodes:ExprNodes in A, ref result:ParseResult in R,
                     past:u64, previous:u64, field:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_name(); return false; } else {};
    val kind <- parameter_node();
    val width <- exception_binder_width(source, tokens, at, past);
    if (width != 0u64) {
        kind <- exception_parameter_node();
        (result.next <- at + width):void;
    } else {
        if (ref_word(source, tokens[at])) { (kind <- ref_parameter_node()):void; } else {};
        if (ptr_word(source, tokens[at])) { (kind <- ptr_parameter_node()):void; } else {};
        if (val_word(source, tokens[at])) { (kind <- val_parameter_node()):void; } else {};
        if (handle_word(source, tokens[at]) && punct_at(source, tokens, at + 1u64, past) != 58u8) {
            (kind <- handle_parameter_node()):void;
        } else {};
        if (kind != parameter_node()) { (result.next <- at + 1u64):void; } else {};
    };
    if (!parse_binding_name(source, tokens, nodes, result, past, true, true, field)) {
        return false;
    } else {};
    val binding <- result.root;
    if (kind == exception_parameter_node() && nodes[nodes[binding].right].kind == owned_type_node()) {
        result.diagnostic <- invalid_exception_owner();
        return false;
    } else {};
    if (kind == val_parameter_node() && nodes[nodes[binding].right].kind == owned_type_node()) {
        result.diagnostic <- invalid_value_parameter_owner();
        return false;
    } else {};
    val first <- tokens[at].first;
    append_node(nodes, result, kind, first, nodes[binding].past, 0u64, previous, binding, first);
    return result.diagnostic == 0u8;
}

func parse_parameters(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, ref result:ParseResult in R,
                      past:u64, previous:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- previous;
    if (punct_at(source, tokens, result.next, past) == 41u8) { return last; } else {}; # ')'
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_parameter(source, tokens, nodes, result, past, last, false)) { return no_node(); } else {};
        last <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 41u8) { return last; } else {}; # ')'
        if (delimiter != 44u8) { result.diagnostic <- expected_parameter_list(); return no_node(); } else {}; # ','
        (result.next <- result.next + 1u64):void;
    };
    result.diagnostic <- expected_parameter_list();
    return no_node();
}

func start_parameter_list(source:const SourceBytes in S, tokens:const Tokens in T,
                          ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    if (!parse_module_name(source, tokens, nodes, result, past)) { return no_node(); } else {};
    val name <- result.root;
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) { # '('
        result.diagnostic <- expected_parameter_list();
        return no_node();
    } else {};
    result.next <- open + 1u64;
    return name;
}

func finish_callable_head(tokens:const Tokens in T, ref nodes:ExprNodes in A, ref result:ParseResult in R,
                          name:u64, parameters:u64, open:u64) -> void
    where {const owner T, owner A, owner R} {
    val close <- result.next;
    append_node(nodes, result, callable_head_node(), nodes[name].first, tokens[close].past,
                0u64, name, parameters, open);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

# Each header clause links to the preceding header node and its own operand.
func parse_type_clause(source:const SourceBytes in S, tokens:const Tokens in T, ref nodes:ExprNodes in A,
                       ref result:ParseResult in R, past:u64, kind:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val previous <- result.root;
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val clause_kind <- kind;
    if (kind == result_clause_node() && result.next < past) {
        val at <- result.next;
        val width <- 0u64;
        if (exception_word(source, tokens[at]) && punct_at(source, tokens, at + 1u64, past) == 58u8) {
            (width <- 1u64):void;
        } else {
            if (own_word(source, tokens[at]) && at + 1u64 < past && exception_word(source, tokens[at + 1u64])) {
                (width <- 2u64):void;
            } else {};
        };
        if (width != 0u64) {
            result.next <- at + width;
            if (punct_at(source, tokens, result.next, past) != 58u8) { result.diagnostic <- expected_type(); return false; } else {};
            result.next <- result.next + 1u64;
            (clause_kind <- exception_result_node()):void;
        } else {
            if (ref_word(source, tokens[at])) {
                result.next <- at + 1u64;
                (clause_kind <- ref_result_node()):void;
            } else {};
        };
    } else {};
    val readonly <- kind == result_clause_node() && result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return false; } else {};
    val annotation <- result.root;
    if (clause_kind == ref_result_node()) {
        if (result.next >= past || !in_word(source, tokens[result.next])) {
            result.diagnostic <- expected_owner_clause();
            return false;
        } else {};
        val site <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) { return false; } else {};
        val owner_name <- result.root;
        append_node(nodes, result, owned_type_node(), nodes[annotation].first, nodes[owner_name].past,
                    0u64, annotation, owner_name, site);
        if (result.diagnostic != 0u8) { return false; } else {};
        (annotation <- result.root):void;
    } else {};
    append_node(nodes, result, clause_kind, first, nodes[annotation].past,
                if (readonly) { readonly_declaration() } else { 0u64 }, previous, annotation, first);
    return result.diagnostic == 0u8;
}

func parse_here_parameter(source:const SourceBytes in S, tokens:const Tokens in T,
                          ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val name <- start_parameter_list(source, tokens, nodes, result, past);
    if (name == no_node()) { return; } else {};
    val open <- tokens[result.next - 1u64].first;
    val parameters <- parse_parameters(source, tokens, nodes, result, past, no_node());
    if (result.diagnostic != 0u8) { return; } else {};
    finish_callable_head(tokens, nodes, result, name, parameters, open);
    if (result.diagnostic != 0u8) { return; } else {};
    if (!punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    if (!parse_type_clause(source, tokens, nodes, result, past, result_clause_node())) { return; } else {};
    if (result.next < past && throws_word(source, tokens[result.next])) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) { return; } else {};
    } else {};
    val signature <- result.root;
    append_node(nodes, result, here_parameter_node(), first, nodes[signature].past,
                0u64, no_node(), signature, first);
}

func parse_callable_head(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64, native:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val name <- start_parameter_list(source, tokens, nodes, result, past);
    if (name == no_node()) { return; } else {};
    val open <- tokens[result.next - 1u64].first;
    val first_parameter <- no_node();
    if (native && result.next < past && here_word(source, tokens[result.next]) &&
        punct_at(source, tokens, result.next + 1u64, past) != 58u8) {
        parse_here_parameter(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return; } else {};
        first_parameter <- result.root;
        val delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 44u8) {
            result.next <- result.next + 1u64;
            if (punct_at(source, tokens, result.next, past) == 41u8) {
                result.diagnostic <- expected_name();
                return;
            } else {};
        } else {
            if (delimiter != 41u8) { result.diagnostic <- expected_parameter_list(); return; } else {};
        };
    } else {};
    val parameters <- parse_parameters(source, tokens, nodes, result, past, first_parameter);
    if (result.diagnostic != 0u8) { return; } else {};
    finish_callable_head(tokens, nodes, result, name, parameters, open);
}

func parse_owner_clause(source:const SourceBytes in S, tokens:const Tokens in T,
                        ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val readonly <- at < past && const_word(source, tokens[at]);
    val owner_at <- if (readonly) { at + 1u64 } else { at };
    if (owner_at >= past || !owner_word(source, tokens[owner_at])) {
        result.diagnostic <- expected_owner_clause();
        return false;
    } else {};
    val previous <- result.root;
    result.next <- owner_at + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) { return false; } else {};
    val owner_name <- result.root;
    val first <- tokens[at].first;
    append_node(nodes, result, owner_clause_node(), first, nodes[owner_name].past,
                if (readonly) { readonly_declaration() } else { 0u64 }, previous, owner_name, first);
    return result.diagnostic == 0u8;
}

func parse_owner_clauses(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 123u8) { # '{'
        result.diagnostic <- expected_owner_clause();
        return;
    } else {};
    result.next <- result.next + 1u64;
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_owner_clause(source, tokens, nodes, result, past)) { return; } else {};
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 125u8) { result.next <- result.next + 1u64; return; } else {}; # '}'
        if (delimiter != 44u8) { result.diagnostic <- expected_owner_clause(); return; } else {}; # ','
        (result.next <- result.next + 1u64):void;
    };
    (result.diagnostic <- expected_owner_clause()):void;
}

func parse_callable(source:const SourceBytes in S, tokens:const Tokens in T,
                    ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64, kind:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val native <- result.next < past && tokens[result.next].kind == module_path();
    if (native) {
        if (kind == function_definition() || !c_linkage(source, tokens[result.next])) {
            result.diagnostic <- expected_c_linkage();
            return;
        } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    parse_callable_head(source, tokens, nodes, result, past, native);
    if (result.diagnostic != 0u8) { return; } else {};
    if (punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) { # '->'
        if (!parse_type_clause(source, tokens, nodes, result, past, result_clause_node())) { return; } else {};
    } else {};
    val leading_throws <- result.next < past && throws_word(source, tokens[result.next]);
    if (leading_throws) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) { return; } else {};
    } else {};
    if (result.next < past && where_word(source, tokens[result.next])) {
        parse_owner_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return; } else {};
    } else {};
    if (!leading_throws && result.next < past && throws_word(source, tokens[result.next])) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) { return; } else {};
    } else {};
    val header <- result.root;
    if (native && punct_at(source, tokens, result.next, past) == 59u8) {
        append_node(nodes, result, c_procedure_node(), first, nodes[header].past, 0u64, header, no_node(), first);
        return;
    } else {};
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    val body <- result.root;
    val form <- if (native) { c_procedure_node() } else { callable_node() };
    append_node(nodes, result, form, first, nodes[body].past, kind, header, body, first);
}

# A record links its fields in source order through the preceding field.
func parse_record_fields(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R,
                         past:u64, native:bool) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_at(source, tokens, result.next, past) != 123u8) {
        result.diagnostic <- expected_record_fields();
        return no_node();
    } else {};
    result.next <- result.next + 1u64;
    val last <- no_node();
    val binding <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8) {
            if (native && last == no_node()) {
                result.diagnostic <- expected_record_fields();
                return no_node();
            } else {};
            result.next <- result.next + 1u64;
            return last;
        } else {};
        if (!parse_parameter(source, tokens, nodes, result, past, last, true)) { return no_node(); } else {};
        last <- result.root;
        binding <- nodes[last].right;
        if (nodes[last].kind == handle_parameter_node() || nodes[nodes[binding].right].kind == owned_type_node()) {
            result.diagnostic <- expected_record_fields();
            return no_node();
        } else {};
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 125u8) { result.next <- result.next + 1u64; return last; } else {};
        if (delimiter != 59u8) { result.diagnostic <- expected_record_fields(); return no_node(); } else {};
        (result.next <- result.next + 1u64):void;
    };
    result.diagnostic <- expected_record_fields();
    return no_node();
}

func parse_data(source:const SourceBytes in S, tokens:const Tokens in T,
                ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val native <- result.next < past && tokens[result.next].kind == module_path();
    if (native) {
        if (!c_linkage(source, tokens[result.next])) { result.diagnostic <- expected_c_linkage(); return; } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    if (!parse_module_name(source, tokens, nodes, result, past)) { return; } else {};
    val name <- result.root;
    if (native && result.next < past && in_word(source, tokens[result.next])) {
        val in_at <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return; } else {};
        val owner_type <- result.root;
        append_node(nodes, result, c_handle_type_node(), first, nodes[owner_type].past, 0u64, name, owner_type, in_at);
        return;
    } else {};
    if (native && punct_at(source, tokens, result.next, past) == 59u8) {
        append_node(nodes, result, c_handle_type_node(), first, nodes[name].past, 0u64, name, no_node(), first);
        return;
    } else {};
    val descriptor <- name;
    if (punct_pair_at(source, tokens, result.next, past, 60u8, 58u8)) { # '<:'
        val parent_at <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return; } else {};
        val parent <- result.root;
        append_node(nodes, result, data_parent_node(), nodes[name].first, nodes[parent].past, 0u64, name, parent, parent_at);
        if (result.diagnostic != 0u8) { return; } else {};
        (descriptor <- result.root):void;
    } else {};
    val fields <- parse_record_fields(source, tokens, nodes, result, past, native);
    if (result.diagnostic != 0u8) { return; } else {};
    val kind <- if (native) { c_record_node() } else { data_record_node() };
    append_node(nodes, result, kind, first, tokens[result.next - 1u64].past, 0u64, descriptor, fields, first);
}

func parse_publication(source:const SourceBytes in S, tokens:const Tokens in T,
                       ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (result.next < past && tokens[result.next].kind == symbol_name()) {
        if (!parse_symbol(tokens, nodes, result, past)) { return; } else {};
    } else {
        if (!parse_module_name(source, tokens, nodes, result, past)) { return; } else {};
    };
    val name <- result.root;
    append_node(nodes, result, export_node(), first, nodes[name].past, 0u64, name, no_node(), first);
}

func parse_array(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_module_name(source, tokens, nodes, result, past)) { return; } else {};
    val name <- result.root;
    if (punct_at(source, tokens, result.next, past) != 91u8) {
        result.diagnostic <- expected_array_shape();
        return;
    } else {};
    val shape_first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return; } else {};
    val index <- result.root;
    if (punct_at(source, tokens, result.next, past) != 93u8 ||
        punct_at(source, tokens, result.next + 1u64, past) != 58u8) {
        result.diagnostic <- expected_array_shape();
        return;
    } else {};
    result.next <- result.next + 2u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return; } else {};
    val element <- result.root;
    append_node(nodes, result, array_shape_node(), shape_first, nodes[element].past, 0u64, index, element, shape_first);
    val shape <- result.root;
    if (result.diagnostic != 0u8) { return; } else {};
    append_node(nodes, result, array_declaration_node(), first, nodes[element].past, 0u64, name, shape, first);
}

func parse_module_form(source:const SourceBytes in S, tokens:const Tokens in T,
                       ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val function_form <- func_word(source, tokens[at]);
    if ((function_form || proc_word(source, tokens[at])) && !callable_local_head(source, tokens, at, past)) {
        val kind <- if (function_form) { function_definition() } else { procedure_definition() };
        parse_callable(source, tokens, nodes, result, past, kind);
        return;
    } else {};
    val named_declaration <- at + 1u64 < past && tokens[at + 1u64].kind == identifier();
    val marked_declaration <- at + 1u64 < past && tokens[at + 1u64].kind == module_path();
    if (data_word(source, tokens[at]) && (named_declaration || marked_declaration)) {
        parse_data(source, tokens, nodes, result, past);
        return;
    } else {};
    if (array_word(source, tokens[at]) && named_declaration) {
        parse_array(source, tokens, nodes, result, past);
        return;
    } else {};
    if (export_word(source, tokens[at])) {
        parse_publication(source, tokens, nodes, result, past);
        return;
    } else {};
    parse_next_expression(source, tokens, nodes, result, past);
}

func named_definition_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (at + 1u64 >= past) { return false; } else {};
    val next_kind <- tokens[at + 1u64].kind;
    return ((func_word(source, tokens[at]) || proc_word(source, tokens[at])) &&
            !callable_local_head(source, tokens, at, past)) ||
        (data_word(source, tokens[at]) && (next_kind == identifier() || next_kind == module_path())) ||
        (array_word(source, tokens[at]) && next_kind == identifier());
}

func parse_module_item(source:const SourceBytes in S, tokens:const Tokens in T,
                       ref nodes:ExprNodes in A, ref result:ParseResult in R,
                       past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (using_word(source, tokens[at])) {
        return parse_selection_items(source, tokens, nodes, result, past, previous, false);
    } else {};
    val export_prefix <- export_word(source, tokens[at]);
    if (export_prefix && at + 2u64 < past && from_word(source, tokens[at + 1u64]) &&
        tokens[at + 2u64].kind == module_path()) {
        return parse_selection_items(source, tokens, nodes, result, past, previous, true);
    } else {};
    val public_definition <- export_prefix && named_definition_head(source, tokens, at + 1u64, past);
    if (public_definition) { (result.next <- at + 1u64):void; } else {};
    parse_module_form(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return false; } else {};
    val form <- result.root;
    val end <- nodes[form].past;
    val kind <- nodes[form].kind;
    if (punct_at(source, tokens, result.next, past) == 59u8) { # ';'
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void;
    } else {
        val definition <- (kind == callable_node() || kind == c_procedure_node()) && nodes[form].right != no_node();
        val delimited <- definition || kind == c_record_node() || kind == data_record_node();
        if (!delimited) { result.diagnostic <- expected_module_separator(); return false; } else {};
    };
    val first <- tokens[at].first;
    append_node(nodes, result, module_item_node(), first, end, if (public_definition) { 1u64 } else { 0u64 },
                previous, form, first);
    return result.diagnostic == 0u8;
}

func parse_module(source:const SourceBytes in S, tokens:const Tokens in T,
                  ref nodes:ExprNodes in A, past:u64, ref result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(0u64, result);
    if (past > token_len(tokens)) { result.diagnostic <- expected_module_separator(); return; } else {};
    val last <- no_node();
    for (unused in 0u64 .. past + 1u64) {
        if (result.next >= past) {
            append_node(nodes, result, module_node(), 0u64, source_len(source), 0u64, last, no_node(), 0u64);
            return;
        } else {};
        if (!parse_module_item(source, tokens, nodes, result, past, last)) { return; } else {};
        (last <- result.root):void;
    };
    (result.diagnostic <- expected_module_separator()):void;
}

export parse_module;
