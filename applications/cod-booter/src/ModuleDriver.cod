using "SourceStorage.cod" { SourceBytes, SourceLines, SourcePosition };
using "SourceAccess.cod" locate_source_position;
using "ParserStorage.cod" { Tokens, ExprNodes, no_node };
using "ModuleExports.cod" { ModuleExports, SelectedExports };
using "NameResolution.cod" { NameBindings, NameWork };
using "OperandChecking.cod" { OperandFacts, CallOwners };
using "CompletionChecking.cod" CompletionSites;
using "ModuleFrontend.cod" { ModuleBindingResult, rejected_unsupported_declaration };
using "NativeCommands.cod" { NativeCommands, NativePlan };
using "ModuleCompiler.cod" compile_module_commands;
using "ModuleLowering.cod" native_unsupported;
using "Compiler.cod" { ExpressionScratchPlan, plan_expression_scratch };
using "CompilerStatus.cod" CompilerStatus { Complete, Rejected, FormUnsupported, OpenFailed, LoweringFailed, FinishFailed, ScratchFailed, SourceOpenFailed };

export data ModuleWorkspacePlan {
    source:ExpressionScratchPlan;
    commands:u64;
}

export data NativeModuleResult {
    analysis:ModuleBindingResult;
    plan:NativePlan;
    backend_status:u8;
    rejected_first:u64;
    rejected_past:u64;
    first_position:SourcePosition;
    past_position:SourcePosition;
    related_position:SourcePosition;
}

# Opening and lending the source revision are separate operations. The
# provider keeps the mapping and line index live throughout work.
export proc compile_with_module_source(here open() -> u8, here work() -> CompilerStatus, here release() -> void,
                                       source_status:u8 in R) -> CompilerStatus where {owner R} {
    source_status <- 0u8;
    defer { release(); };
    source_status <- open();
    if (source_status != 0u8) return SourceOpenFailed;
    return work();
}

# A normalized grouped selection may need one extra node per item. Each
# such item accounts for a name and a delimiter, so half the token count
# bounds the additional nodes, including a group with no trailing comma.
export func plan_module_source(source:const SourceBytes in S, plan:ExpressionScratchPlan in P) -> bool
    where {const owner S, owner P} {
    if (!plan_expression_scratch(source, plan)) return false;
    val extra <- plan.token_count / 2u64;
    if (plan.token_count > no_node() - extra) return false;
    plan.node_capacity <- plan.token_count + extra;
    return true;
}

# Lowering emits each guard dispatch and callable prologue once and each
# deferred call's preparation and invocation once.
export func plan_module_workspace(source:const SourceBytes in S, workspace:ModuleWorkspacePlan in W) -> CompilerStatus
    where {const owner S, owner W} {
    workspace.commands <- 0u64;
    if (!plan_module_source(source, workspace.source)) return Rejected;
    val commands_per_node <- 32u64;
    if (workspace.source.node_capacity > 18446744073709551615u64 / commands_per_node)
        return ScratchFailed;
    workspace.commands <- workspace.source.node_capacity * commands_per_node;
    return Complete;
}

func clear_rejection(result:NativeModuleResult in R) -> void where {owner R} {
    result.rejected_first <- no_node();
    result.rejected_past <- no_node();
    result.first_position.line <- 0u64;
    result.first_position.column <- 0u64;
    result.past_position.line <- 0u64;
    result.past_position.column <- 0u64;
    result.related_position.line <- 0u64;
    result.related_position.column <- 0u64;
    return;
}

# The source revision and its index outlive scratch. Retain only numeric
# positions after the revision is released by the outer driver.
export proc compile_with_module_workspace(here work(tokens:u64, nodes:u64, commands:u64) -> CompilerStatus,
                                          here release() -> void, source:const SourceBytes in S, lines:const SourceLines in S,
                                          workspace:ModuleWorkspacePlan in W, result:NativeModuleResult in R) -> CompilerStatus
    where {const owner S, owner W, owner R} {
    clear_rejection(result);
    result.analysis.stage <- 0u8;
    result.analysis.diagnostic <- 0u8;
    result.analysis.related_first <- no_node();
    result.backend_status <- 0u8;
    result.plan.used <- 0u64;
    result.plan.diagnostic <- 0u8;
    val status <- plan_module_workspace(source, workspace);
    case status of {
        (Complete) -> {
            defer { release(); };
            (status <- work(workspace.source.token_count, workspace.source.node_capacity, workspace.commands)):void;
        };
        (Rejected) -> {
            result.rejected_first <- workspace.source.diagnostic_first;
            (result.rejected_past <- workspace.source.diagnostic_past):void;
        };
    };
    locate_source_position(source, lines, result.rejected_first, result.first_position);
    locate_source_position(source, lines, result.rejected_past, result.past_position);
    locate_source_position(source, lines, result.analysis.related_first, result.related_position);
    return status;
}

func retain_rejection(nodes:const ExprNodes in N, result:NativeModuleResult in R) -> CompilerStatus
    where {const owner N, owner R} {
    if (result.analysis.stage != 0u8) {
        result.rejected_first <- result.analysis.frontend.diagnostic_first;
        result.rejected_past <- result.analysis.frontend.diagnostic_past;
        if (rejected_unsupported_declaration(result.analysis)) return FormUnsupported;
        return Rejected;
    } else {};
    if (result.plan.node != no_node()) {
        result.rejected_first <- nodes[result.plan.node].first;
        (result.rejected_past <- nodes[result.plan.node].past):void;
    } else {};
    if (result.plan.diagnostic == native_unsupported()) return FormUnsupported;
    return LoweringFailed;
}

# Construct borrows the initialized command prefix under the scratch
# owner's lifetime. The session can own a partially acquired resource.
export proc compile_native_module(here begin() -> bool,
                                  here construct(rows:const NativeCommands in C, used:u64, labels:u64, slots:u64) -> u8,
                                  here finish() -> u8, here release() -> void,
                                  source:const SourceBytes in S, tokens:Tokens in T, nodes:ExprNodes in N,
                                  spellings:const SourceBytes in B, exports:const ModuleExports in E,
                                  selected:SelectedExports in X, bindings:NameBindings in Y,
                                  names:NameWork in W, facts:OperandFacts in F, owners:CallOwners in O,
                                  sites:CompletionSites in K, commands:NativeCommands in C,
                                  result:NativeModuleResult in R) -> CompilerStatus
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y,
           owner W, owner F, owner O, owner K, owner C, owner R} {
    result.backend_status <- 0u8;
    clear_rejection(result);
    if (!compile_module_commands(source, tokens, nodes, spellings, exports, selected, bindings, names,
                                 facts, owners, sites, commands, result.plan, result.analysis))
        return retain_rejection(nodes, result);
    defer { release(); };
    if (!begin()) return OpenFailed;
    result.backend_status <- construct(commands, result.plan.used, result.plan.labels, result.plan.slots);
    if (result.backend_status != 0u8) return LoweringFailed;
    result.backend_status <- finish();
    if (result.backend_status != 0u8) return FinishFailed;
    return Complete;
}
