using "SourceStorage.cod" { SourceBytes, SourceLines, SourcePosition };

export func len(source:const SourceBytes in S) -> u64 where {const owner S} {
    return intrinsic (len)(source);
}

export func same_bytes(left:const SourceBytes in L, first:u64, past:u64,
                       right:const SourceBytes in R, other_first:u64, other_past:u64) -> bool
    where {const owner L, const owner R} {
    val length <- past - first;
    if (length != other_past - other_first) return false;
    for (offset in 0u64 .. length) {
        if (left[first + offset] != right[other_first + offset]) return false;
    };
    return true;
}

# The indexed revision supplies one row per line, including an empty
# final line after LF. The preceding row covers the byte position of LF.
func line_at(lines:const SourceLines in S, offset:u64, lower:u64, upper:u64) -> u64
    where {const owner S} {
    if (upper - lower == 1u64) return lower;
    val middle <- lower + (upper - lower) / 2u64;
    if (lines[middle].first <= offset) return line_at(lines, offset, middle, upper);
    return line_at(lines, offset, lower, middle);
}

export func locate_source_position(source:const SourceBytes in S, lines:const SourceLines in S,
                                   offset:u64, position:SourcePosition in P) -> void
    where {const owner S, owner P} {
    position.line <- 0u64;
    position.column <- 0u64;
    val count <- intrinsic (len)(lines);
    if (offset > len(source) || count == 0u64) return;
    val line <- line_at(lines, offset, 0u64, count);
    val first <- lines[line].first;
    if (offset < first || offset > lines[line].past) return;
    position.line <- line + 1u64;
    position.column <- offset - first + 1u64;
    return;
}
