array SourceBytes[u64]:u8;

data SourceLine {
    first:u64;
    past:u64;
}
array SourceLines[u64]:SourceLine;

data SourcePosition {
    line:u64;
    column:u64;
}

# A token refers to a half-open byte span in the caller's source.
data Token {
    kind:u8;
    first:u64;
    past:u64;
}

export SourceBytes;
export SourceLines;
export SourcePosition;
export Token;
