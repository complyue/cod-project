array SourceBytes[u64]:u8;

# A token refers to a half-open byte span in the caller's source.
data Token {
    kind:u8;
    first:u64;
    past:u64;
}

func len(source:const SourceBytes in S) -> u64 where {const owner S} {
    return intrinsic (len)(source);
}

export SourceBytes;
export Token;
export len;
