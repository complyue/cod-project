export array SourceBytes[u64]:u8;

data SourceLine {
    first:u64;
    past:u64;
}
export array SourceLines[u64]:SourceLine;

export data SourcePosition {
    line:u64;
    column:u64;
}

export data DelimiterLink =
    OrdinaryToken {} |
    UnmatchedDelimiter { previous:u64; } |
    MatchedDelimiter { closing:u64; };

# A token refers to a half-open byte span in the caller's source.
export data Token {
    kind:u8;
    first:u64;
    past:u64;
    delimiter:DelimiterLink;
}
