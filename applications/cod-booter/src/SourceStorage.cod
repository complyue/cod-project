array SourceBytes[u64]:u8;

data SourceLine {
    first:u64;
    past:u64;
}
array SourceLines[u64]:SourceLine;

data SourcePosition {
    line:u64;
    column:u64;
}

# A token refers to a half-open byte span in the caller's source.
data Token {
    kind:u8;
    first:u64;
    past:u64;
}

func len(source:const SourceBytes in S) -> u64 where {const owner S} {
    return intrinsic (len)(source);
}

# The indexed revision supplies one row per line, including an empty
# final line after LF. The preceding row covers the byte position of LF.
func line_at(lines:const SourceLines in S, offset:u64, lower:u64, upper:u64) -> u64
    where {const owner S} {
    if (upper - lower == 1u64) { return lower; } else {};
    val middle <- lower + (upper - lower) / 2u64;
    if (lines[middle].first <= offset) { return line_at(lines, offset, middle, upper); } else {};
    return line_at(lines, offset, lower, middle);
}

func locate_source_position(source:const SourceBytes in S, lines:const SourceLines in S,
                            offset:u64, ref position:SourcePosition in P) -> void
    where {const owner S, owner P} {
    position.line <- 0u64;
    position.column <- 0u64;
    val count <- intrinsic (len)(lines);
    if (offset > len(source) || count == 0u64) { return; } else {};
    val line <- line_at(lines, offset, 0u64, count);
    val first <- lines[line].first;
    if (offset < first || offset > lines[line].past) { return; } else {};
    position.line <- line + 1u64;
    position.column <- offset - first + 1u64;
    return;
}

export SourceBytes;
export SourceLines;
export SourcePosition;
export Token;
export len;
export locate_source_position;
