export array SourceBytes[UInt64]:UInt8;

data SourceLine {
    first:UInt64,
    past:UInt64,
}
export array SourceLines[UInt64]:SourceLine;

export data SourcePosition {
    line:UInt64,
    column:UInt64,
}

export data DelimiterLink =
    OrdinaryToken {} |
    UnmatchedDelimiter { previous:UInt64, } |
    MatchedDelimiter { closing:UInt64, };

# A token refers to a half-open byte span in the caller's source.
export data Token {
    kind:UInt8,
    first:UInt64,
    past:UInt64,
    delimiter:DelimiterLink,
}
