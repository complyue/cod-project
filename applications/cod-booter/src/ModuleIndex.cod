using "./SourceStorage.cod" { SourceBytes, SourcePosition };
using "./ParserStorage.cod" no_node;
using "./NativeSource.cod" { PathOwner, PathNotReadyException, path_key };
using "./CompilerStatus.cod" CompilerStatus { Complete, ScratchFailed };

export data VariadicProfileStop {
    first_byte:UInt64,
    past_byte:UInt64,
    first:SourcePosition,
    past:SourcePosition,
}

export data ModuleSelectionRanges {
    exports_first:UInt64,
    exports_past:UInt64,
    defaults_first:UInt64,
    defaults_past:UInt64,
}

export data VisitObject =
    NoVisitObject {} |
    CompletedVisitObject {
        unit_index:UInt64,
        functions_first:UInt64,
        functions_past:UInt64,
    };

export data VisitFailure { rejection:UInt8, finding:UInt64, }

export data VisitSlot =
    Vacant {} |
    Visiting { key_first:UInt64, key_past:UInt64, revision:UInt64, } |
    FailedVisit { key_first:UInt64, key_past:UInt64, revision:UInt64, failure:VisitFailure, } |
    Checked {
        key_first:UInt64,
        key_past:UInt64,
        revision:UInt64,
        exports_first:UInt64,
        exports_past:UInt64,
        defaults_first:UInt64,
        defaults_past:UInt64,
        interfaces_first:UInt64,
        interfaces_past:UInt64,
        primitive_namespace:bool,
        object:VisitObject,
        inherited_structural:bool,
    } |
    StructuralOnly {
        key_first:UInt64, key_past:UInt64, revision:UInt64, exports_first:UInt64, exports_past:UInt64,
        defaults_first:UInt64, defaults_past:UInt64,
        interfaces_first:UInt64, interfaces_past:UInt64, stop:VariadicProfileStop,
    };

export array Visits [UInt64]:VisitSlot;
export data KeyLookup { id:UInt64, length:UInt64, }

export data SourceBytePool {
    ref spare:SourceBytes,
}

func same_key(bytes:const SourceBytes in G, first:UInt64, past:UInt64, canonical:const SourceBytes in P)
    -> bool where {const owner G, const owner P} {
    if (first > past || past > intrinsic (len)(bytes)) return false;
    if (past - first != intrinsic (len)(canonical)) return false;
    for (i in 0u64 .. past - first) {
        if (bytes[first + i] != canonical[i]) return false;
    };
    return true;
}

export func find_visit(visits:const Visits in G, bytes:const SourceBytes in G, used:UInt64,
                       canonical:const SourceBytes in P) -> UInt64 where {const owner G, const owner P} {
    for (id in 0u64 .. used) {
        case visits[id] of {
            (Vacant) -> {};
            (Visiting { val first <- key_first, val past <- key_past, }) -> {
                if (same_key(bytes, first, past, canonical)) return id;
            };
            (FailedVisit { val first <- key_first, val past <- key_past, }) -> {
                if (same_key(bytes, first, past, canonical)) return id
            };
            (Checked { val first <- key_first, val past <- key_past, }) -> {
                if (same_key(bytes, first, past, canonical)) return id;
            };
            (StructuralOnly { val first <- key_first, val past <- key_past, }) -> {
                if (same_key(bytes, first, past, canonical)) return id
            };
        };
    };
    return used;
}

export func growth_capacity(current:UInt64, required:UInt64) -> UInt64 {
    if (current <= 9223372036854775807u64 && current * 2u64 >= required) return current * 2u64;
    return required;
}

export proc reserve_visits(ref var visits:Visits in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val current <- intrinsic (len)(visits);
    if (required <= current) return;
    ref replacement = make Visits(growth_capacity(current, required), make Vacant {}) in G;
    for (id in 0u64 .. used) { replacement[id] <- visits[id]; };
    visits = replacement;
    return;
}

export proc reserve_keys(pool:SourceBytePool in G, ref var keys:SourceBytes in G,
                         used:UInt64, required:UInt64) -> void where {owner G} {
    val current <- intrinsic (len)(keys);
    if (required <= current) return;
    ref previous = keys;
    val capacity <- growth_capacity(current, required);
    ref replacement = pool.spare;
    # A zero-length spare is never selected for growth.
    const val reused <- intrinsic (len)(replacement) == capacity;
    if (!reused) {
        (replacement = make SourceBytes(capacity, 0u8) in G):void;
    };
    for (i in 0u64 .. used) { replacement[i] <- previous[i]; };
    if (reused) {
        for (i in used .. capacity) { replacement[i] <- 0u8; };
    };
    keys = replacement;
    (pool.spare = previous):void;
}

export proc fill_key(bytes:SourceBytes in G, first:UInt64, canonical:const SourceBytes in P)
    -> bool where {owner G, const owner P} {
    val limit <- intrinsic (len)(bytes);
    val count <- intrinsic (len)(canonical);
    if (first > limit || count > limit - first) return false;
    for (i in 0u64 .. count) { bytes[first + i] <- canonical[i]; };
    return true;
}

export proc lookup_path(handle path:PathOwner in P, visits:const Visits in G, keys:const SourceBytes in G,
                        const val used:UInt64, result:KeyLookup in R)
    -> void throws PathNotReadyException where {const owner P, const owner G, owner R} {
    val id <- used;
    val length <- 0u64;
    path_key(path) (key) => {
        id <- find_visit(visits, keys, used, key);
        length <- intrinsic (len)(key);
        continue Complete;
    };
    result.id <- id;
    result.length <- length;
    return;
}

export proc fill_path(handle path:PathOwner in P, keys:SourceBytes in G, const val first:UInt64, const val length:UInt64)
    -> CompilerStatus throws PathNotReadyException where {const owner P, owner G} {
    return path_key(path) (key) => {
        if (intrinsic (len)(key) != length || !fill_key(keys, first, key)) { continue ScratchFailed; };
        continue Complete;
    };
}

export proc insert_visit(handle path:PathOwner in P, length:UInt64,
                         pool:SourceBytePool in G, ref var visits:Visits in G, ref var keys:SourceBytes in G, used:UInt64 in G,
                         key_used:UInt64 in G, next_revision:UInt64 in G)
    -> CompilerStatus throws PathNotReadyException where {const owner P, owner G} {
    val limit <- 18446744073709551615u64;
    if (used >= limit - 1u64 || next_revision == limit || length == 0u64 || length >= limit - key_used)
        return ScratchFailed;
    val id <- used;
    val first <- key_used;
    val past <- first + length;
    reserve_visits(visits, id, id + 1u64);
    reserve_keys(pool, keys, first, past);
    val filled <- fill_path(path, keys, first, length);
    if (filled != Complete) return filled;
    mark_visiting(visits, id, first, past, next_revision);
    key_used <- past;
    next_revision <- next_revision + 1u64;
    used <- id + 1u64;
    return Complete;
}

export func visit_has_membership(visits:const Visits in G, id:UInt64) -> bool where {const owner G} {
    return case visits[id] of {
        Checked -> true;
        StructuralOnly -> true;
        _ -> false
    }
}

export func visit_rejection(visits:const Visits in G, id:UInt64, result:VisitFailure in F)
    -> bool where {const owner G, owner F} {
    if (id >= intrinsic (len)(visits)) return false;
    return case visits[id] of {
        FailedVisit { val failure <-, } -> {
            result.rejection <- failure.rejection;
            result.finding <- failure.finding;
            true
        };
        _ -> false
    }
}

export proc mark_failed_visit(visits:Visits in G, id:UInt64, failure:const VisitFailure in F)
    -> bool where {owner G, const owner F} {
    if (id >= intrinsic (len)(visits) || failure.rejection == 0u8) return false;
    case visits[id] of {
        Visiting { val first <- key_first, val past <- key_past, val opening <- revision, } -> {
            visits[id] <- make FailedVisit {
                key_first <- first; key_past <- past; revision <- opening; failure <- failure
            };
            return true
        };
        _ -> {}
    };
    return false
}
export func structural_visit_dependency(visits:const Visits in G,
    id:UInt64) -> bool where {const owner G} {
    return case visits[id] of {
        StructuralOnly -> true;
        (Checked { val inherited <- inherited_structural, }) -> { inherited };
        _ -> false
    }
}

export data CanonicalKeyRange { first:UInt64, past:UInt64, }

export func earliest_profile_stop(visits:const Visits in G, used:UInt64, key_used:UInt64,
    interface_used:UInt64,
                                 selected:UInt64 in R) -> bool where {const owner G, owner R} {
    if (used > intrinsic (len)(visits)) return false;
    val order <- no_node();
    selected <- no_node();
    for (id in 0u64 .. used) {
        case visits[id] of {
            (StructuralOnly {
                val first <- key_first, val past <- key_past, val interfaces <- interfaces_first,
                val end <- interfaces_past, val pending <- stop,
            }) -> {
                if (first >= past || past > key_used || interfaces >= end || end > interface_used ||
                    pending.first_byte >= pending.past_byte || pending.first.line == 0u64)
                        return false;
                # The absolute nonempty interface range advances in completion order.
                if (interfaces < order) {
                    order <- interfaces;
                    (selected <- id):void
                }
            };
            _ -> {}
        }
    };
    return true
}

export func checked_module_key(visits:const Visits in G, used:UInt64, key_used:UInt64, module:UInt64,
                               key:CanonicalKeyRange in K) -> bool where {const owner G, owner K} {
    if (module == 0u64 || module > used || used > intrinsic (len)(visits)) return false;
    return case visits[module - 1u64] of {
        (Checked { val first <- key_first, val past <- key_past, }) -> {
            if (first >= past || past > key_used) return false;
            key.first <- first;
            key.past <- past;
            true
        };
        (_) -> { false };
    };
}

export func published_module_key(visits:const Visits in G, used:UInt64, key_used:UInt64, module:UInt64,
    key:CanonicalKeyRange in K) -> bool where {const owner G, owner K} {
    if (module == 0u64 || module > used || used > intrinsic (len)(visits)) return false;
    return case visits[module - 1u64] of {
        StructuralOnly { val first <- key_first, val past <- key_past, } -> {
            if (first >= past || past > key_used) return false;
            key.first <- first;
            key.past <- past;
            true
        };
        _ -> checked_module_key(visits, used, key_used, module, key)
    }
}

func record_selection_ranges(ranges:ModuleSelectionRanges in R, export_used:UInt64, default_used:UInt64,
    first_export:UInt64, past_export:UInt64, first_default:UInt64, past_default:UInt64)
    -> bool where {owner R} {
    if (first_export > past_export || past_export > export_used ||
        first_default > past_default || past_default > default_used) return false;
    ranges.exports_first <- first_export;
    ranges.exports_past <- past_export;
    ranges.defaults_first <- first_default;
    ranges.defaults_past <- past_default;
    return true
}

export func checked_module_selections(
    visits:const Visits in G, used:UInt64, module:UInt64, export_used:UInt64, default_used:UInt64,
    ranges:ModuleSelectionRanges in R) -> bool where {const owner G, owner R} {
    if (module == 0u64 || module > used || used > intrinsic (len)(visits)) return false;
    return case visits[module - 1u64] of {
        (Checked {
            val first_export <- exports_first,
            val past_export <- exports_past,
            val first_default <- defaults_first,
            val past_default <- defaults_past,
        }) -> { record_selection_ranges(ranges, export_used, default_used,
                                        first_export, past_export, first_default, past_default) };
        StructuralOnly {
            val first_export <- exports_first, val past_export <- exports_past,
            val first_default <- defaults_first, val past_default <- defaults_past,
        } -> {
            record_selection_ranges(ranges, export_used, default_used,
                                    first_export, past_export, first_default, past_default)
        };
        _ -> false
    }
}

export func contains_checked_interface(visits:const Visits in G, used:UInt64,
    module:UInt64, row:UInt64, published:UInt64) -> bool where {const owner G} {
    if (module == 0u64 || module > used || used > intrinsic (len)(visits)) return false;
    return case visits[module - 1u64] of {
        Checked { val first <- interfaces_first, val past <- interfaces_past, } ->
            first <= row && row < past && past <= published;
        _ -> false
    }
}

export proc mark_visiting(visits:Visits in G, id:UInt64, first:UInt64, past:UInt64, revision:UInt64)
    -> void where {owner G} {
    visits[id] <- make Visiting { key_first <- first; key_past <- past; revision <- revision; };
    return;
}

export proc mark_checked(visits:Visits in G, id:UInt64, ranges:const ModuleSelectionRanges in R,
    interfaces_first:UInt64, interfaces_past:UInt64, inherited:bool,
    primitive_namespace:bool, object:const VisitObject in O) -> bool
    where {owner G, const owner R, const owner O} {
    if (id >= intrinsic (len)(visits) || ranges.exports_first > ranges.exports_past ||
        ranges.defaults_first > ranges.defaults_past || interfaces_first > interfaces_past) return false;
    case visits[id] of {
        (Visiting { val first <- key_first, val past <- key_past, val opening <- revision, }) -> {
            visits[id] <- make Checked {
                key_first <- first;
                key_past <- past;
                revision <- opening;
                exports_first <- ranges.exports_first;
                exports_past <- ranges.exports_past;
                defaults_first <- ranges.defaults_first;
                defaults_past <- ranges.defaults_past;
                interfaces_first <- interfaces_first;
                interfaces_past <- interfaces_past;
                primitive_namespace <- primitive_namespace;
                object <- object;
                inherited_structural <- inherited
            };
            return true;
        };
        _ -> {}
    };
    return false;
}

export proc mark_structural_only(visits:Visits in G, id:UInt64, ranges:const ModuleSelectionRanges in R,
                                 interfaces_first:UInt64, interfaces_past:UInt64,
                                     stop:const VariadicProfileStop in F)
    -> bool where {owner G, const owner F, const owner R} {
    if (id >= intrinsic (len)(visits) || ranges.exports_first > ranges.exports_past ||
        ranges.defaults_first > ranges.defaults_past ||
        interfaces_first >= interfaces_past ||
        stop.first_byte >= stop.past_byte || stop.first.line == 0u64) return false;
    case visits[id] of {
        (Visiting { val first <- key_first, val past <- key_past, val opening <- revision, }) -> {
            visits[id] <- make StructuralOnly {
                key_first <- first; key_past <- past; revision <- opening;
                exports_first <- ranges.exports_first; exports_past <- ranges.exports_past;
                defaults_first <- ranges.defaults_first; defaults_past <- ranges.defaults_past;
                interfaces_first <- interfaces_first; interfaces_past <- interfaces_past;
                stop <- stop
            };
            return true
        };
        _ -> {}
    };
    return false
}

export proc retire_visit(visits:Visits in G, id:UInt64) -> void where {owner G} {
    case visits[id] of {
        (Visiting) -> { visits[id] <- make Vacant {}; return; };
        _ -> {}
    };
    return;
}
