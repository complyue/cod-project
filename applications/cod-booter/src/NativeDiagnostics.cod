using "SourceStorage.cod" SourceBytes;
using "SourceStorage.cod" SourceLines;
using "SourceStorage.cod" SourcePosition;
using "SourceStorage.cod" locate_source_position;

data "C" DiagnosticDestination;
proc "C" write_diagnostic(handle destination:DiagnosticDestination in D, stage:u8, code:u8,
                          first_line:u64, first_column:u64, past_line:u64, past_column:u64,
                          related_line:u64, related_column:u64, os_error:u64) -> u8 where {owner D};

proc report_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
                      handle diagnostic:DiagnosticDestination in D,
                      stage:u8, code:u8, first:u64, past:u64, related:u64) -> void
    where {const owner S, owner D} {
    ref start = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref end = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref previous = make SourcePosition { line <- 0u64; column <- 0u64; };
    locate_source_position(source, lines, first, start);
    locate_source_position(source, lines, past, end);
    locate_source_position(source, lines, related, previous);
    (write_diagnostic(diagnostic, stage, code, start.line, start.column, end.line, end.column,
                       previous.line, previous.column, 0u64)):void;
    return;
}

proc report_source_open_error(handle diagnostic:DiagnosticDestination in D, os_error:u64) -> void where {owner D} {
    (write_diagnostic(diagnostic, 0u8, 0u8, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, os_error)):void;
    return;
}

proc report_backend_error(handle diagnostic:DiagnosticDestination in D, code:u8) -> void where {owner D} {
    (write_diagnostic(diagnostic, 6u8, code, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64)):void;
    return;
}

export DiagnosticDestination;
export report_rejection;
export report_source_open_error;
export report_backend_error;
