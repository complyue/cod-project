using "./SourceStorage.cod" { SourceBytes, SourceLines, SourcePosition };
using "./SourceAccess.cod" locate_source_position;
using "./ParserStorage.cod" { ExprNodes, parse_report_code, syntax_first, syntax_past, no_node };
using "./Frontend.cod" FrontendResult;
using "std:exceptions" OutOfMemoryError;
using "./CompilerStatus.cod" CompilerStatus { Complete, ScratchFailed, DiagnosticsIncomplete };

handle type LauncherDiagnostics;
export handle type DiagnosticDestination in LauncherDiagnostics;
export func "C" diagnostic_limit(handle destination:const DiagnosticDestination in D)
    -> u64 where {const owner D};

export data DiagnosticRun {
    limit:u64;
    retained:u64;
    package_input_failure:u64;
}
export array DiagnosticRuns[u64]:DiagnosticRun;

export func diagnostic_budget_full(run:const DiagnosticRuns in G) -> bool where {const owner G} {
    return run[0u64].limit != 0u64 and run[0u64].retained >= run[0u64].limit
}

proc "C" write_diagnostic(handle destination:DiagnosticDestination in D, stage:u8, code:u32,
                          first_line:u64, first_column:u64, past_line:u64, past_column:u64,
                          related_line:u64, related_column:u64, os_error:u64) -> u8 where {owner D};

data "C" SourceDiagnosticRow {
    code:u8;
    first_line:u64;
    first_column:u64;
    past_line:u64;
    past_column:u64;
    related_line:u64;
    related_column:u64;
}
array SourceDiagnosticRows[u64]:SourceDiagnosticRow;
array ReportIndices[u64]:u64;

proc "C" write_source_reports(handle diagnostic:DiagnosticDestination in D, rows:const SourceDiagnosticRows in R, used:u64,
                             keys:const SourceBytes in K, first:u64, past:u64, stage:u8,
                             first_finding:u64) -> u8
    where {owner D, const owner R, const owner K};

proc "C" append_symbol_diagnostic(handle diagnostic:DiagnosticDestination in D, stage:u8, code:u8,
    first_line:u64, first_column:u64, past_line:u64, past_column:u64,
    keys:const SourceBytes in K, key_first:u64, key_past:u64,
    spelling:const SourceBytes in S, name_first:u64, name_past:u64,
    module_key:const SourceBytes in M, module_first:u64, module_past:u64,
    definition:const SourceBytes in N, definition_first:u64, definition_past:u64, finding:u64)
    -> u8 where {owner D, const owner K, const owner S, const owner M, const owner N};

export proc report_symbol_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, stage:u8, code:u8, first:u64, past:u64,
    keys:const SourceBytes in K, key_first:u64, key_past:u64,
    module_key:const SourceBytes in M, module_first:u64, module_past:u64,
    definition:const SourceBytes in N, definition_first:u64, definition_past:u64,
    run:DiagnosticRuns in Q) -> CompilerStatus
    where {const owner S, owner D, const owner K, const owner M, const owner N, owner Q} {
    if (diagnostic_budget_full(run)) return DiagnosticsIncomplete;
    const val finding <- run[0u64].retained;
    if (finding == no_node() || first >= past || past > intrinsic (len)(source) ||
        key_first >= key_past || key_past > intrinsic (len)(keys) ||
        module_first >= module_past || module_past > intrinsic (len)(module_key) ||
        definition_first >= definition_past || definition_past > intrinsic (len)(definition))
        return ScratchFailed;
    ref start = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref end = make SourcePosition { line <- 0u64; column <- 0u64; };
    locate_source_position(source, lines, first, start);
    locate_source_position(source, lines, past, end);
    if (finding == 0u64 && write_diagnostic(diagnostic, stage, code, start.line, start.column,
        end.line, end.column, 0u64, 0u64, 0u64) != 0u8) return ScratchFailed;
    if (append_symbol_diagnostic(diagnostic, stage, code, start.line, start.column,
        end.line, end.column, keys, key_first, key_past, source, first, past,
        module_key, module_first, module_past, definition, definition_first, definition_past, finding) != 0u8)
        return ScratchFailed;
    run[0u64].retained <- finding + 1u64;
    return Complete
}

proc "C" append_dependency_note(handle diagnostic:DiagnosticDestination in D, finding:u64,
    keys:const SourceBytes in K, first:u64, past:u64, first_line:u64, first_column:u64,
    past_line:u64, past_column:u64) -> u8 where {owner D, const owner K};

export proc report_dependency_note(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, finding:u64, first:u64, past:u64,
    keys:const SourceBytes in K, key_first:u64, key_past:u64) -> bool
    where {const owner S, owner D, const owner K} {
    ref start = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref end = make SourcePosition { line <- 0u64; column <- 0u64; };
    locate_source_position(source, lines, first, start);
    locate_source_position(source, lines, past, end);
    return append_dependency_note(diagnostic, finding, keys, key_first, key_past,
        start.line, start.column, end.line, end.column) == 0u8
}

export enum PackageDiagnosticKind:u8 {
    PackageShadow = 1u8;
    PackageAmbiguity = 2u8;
    PackageMissing = 3u8;
    PackageLookupFailure = 4u8;
    PackageInputFailure = 5u8;
    InvalidModulePath = 6u8;
    PackageProcessFailure = 7u8;
}

export proc "C" append_package_diagnostic(
    handle diagnostic:DiagnosticDestination in D, kind:PackageDiagnosticKind, os_error:u64,
    first_line:u64, first_column:u64, past_line:u64, past_column:u64,
    importer:const SourceBytes in I, import_first:u64, import_past:u64,
    spelling:const SourceBytes in M, first:u64, past:u64,
    candidate:const SourceBytes in A, other:const SourceBytes in B, finding:u64)
    -> u8 where {owner D, const owner I, const owner M, const owner A, const owner B};

func report_after(nodes:const ExprNodes in N, used:u64, left:u64, right:u64) -> bool where {const owner N} {
    val left_at <- syntax_first(nodes, used, left);
    val right_at <- syntax_first(nodes, used, right);
    return left_at > right_at || (left_at == right_at && left > right)
}

func restore_report_heap(nodes:const ExprNodes in N, used:u64, order:ReportIndices in O, start:u64, size:u64) -> void
    where {const owner N, owner O} {
    val parent <- start;
    val selected <- 0u64;
    val previous <- 0u64;
    for (step in 0u64 .. size) {
        if (parent >= size / 2u64) return;
        selected <- 2u64 * parent + 1u64;
        if (selected + 1u64 < size && report_after(nodes, used, order[selected + 1u64], order[selected])) {
            (selected <- selected + 1u64):void
        };
        if (!report_after(nodes, used, order[selected], order[parent])) return;
        previous <- order[parent];
        order[parent] <- order[selected];
        order[selected] <- previous;
        parent <- selected
    }
}

func sort_report_indices(nodes:const ExprNodes in N, used:u64, order:ReportIndices in O, count:u64) -> void
    where {const owner N, owner O} {
    val root <- count / 2u64;
    for (step in 0u64 .. root) {
        root <- root - 1u64;
        restore_report_heap(nodes, used, order, root, count)
    };
    val end <- count;
    val previous <- 0u64;
    for (step in 1u64 .. count) {
        end <- end - 1u64;
        previous <- order[0u64];
        order[0u64] <- order[end];
        order[end] <- previous;
        restore_report_heap(nodes, used, order, 0u64, end)
    }
}

proc write_ordered_reports(source:const SourceBytes in S, lines:const SourceLines in S,
                           handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in N,
                           keys:const SourceBytes in K, key_first:u64, key_past:u64, stage:u8,
                           used:u64, count:u64, retained:u64, first_finding:u64) -> bool
    where {const owner S, owner D, const owner N, const owner K} {
    try {
        ref order = make ReportIndices(count, 0u64);
        val written <- 0u64;
        for (at in 0u64 .. used) {
            if (parse_report_code(nodes, used, at) != 0u8) {
                if (written >= count) return false;
                order[written] <- at;
                (written <- written + 1u64):void
            }
        };
        if (written != count) return false;
        sort_report_indices(nodes, used, order, count);
        ref rows = make SourceDiagnosticRows(retained, make SourceDiagnosticRow {
            code <- 0u8; first_line <- 0u64; first_column <- 0u64; past_line <- 0u64; past_column <- 0u64;
            related_line <- 0u64; related_column <- 0u64;
        });
        ref position = make SourcePosition { line <- 0u64; column <- 0u64; };
        val at <- no_node();
        for (index in 0u64 .. retained) {
            at <- order[index];
            locate_source_position(source, lines, syntax_first(nodes, used, at), position);
            rows[index].first_line <- position.line;
            rows[index].first_column <- position.column;
            locate_source_position(source, lines, syntax_past(nodes, used, at), position);
            rows[index].past_line <- position.line;
            rows[index].past_column <- position.column;
            rows[index].code <- parse_report_code(nodes, used, at)
        };
        return write_source_reports(diagnostic, rows, retained, keys, key_first, key_past, stage, first_finding) == 0u8
    } catch (error:const OutOfMemoryError) {
        return false
    }
}

export proc report_parse_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
                                   handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in N,
                                   result:const FrontendResult in F, keys:const SourceBytes in K,
                                   key_first:u64, key_past:u64, stage:u8, run:DiagnosticRuns in Q)
    -> CompilerStatus where {const owner S, owner D, const owner N, const owner F, const owner K, owner Q} {
    if (diagnostic_budget_full(run)) return DiagnosticsIncomplete;
    val count <- result.tree.reports;
    if (run[0u64].retained == 0u64 &&
        !write_located_diagnostic(source, lines, diagnostic, stage, result.tree.diagnostic,
                                  result.diagnostic_first, result.diagnostic_past, no_node())) return ScratchFailed;
    if (count == 0u64) return ScratchFailed;
    val retained <- count;
    if (run[0u64].limit != 0u64 && count > run[0u64].limit - run[0u64].retained) {
        (retained <- run[0u64].limit - run[0u64].retained):void
    };
    if (retained > no_node() - run[0u64].retained ||
        !write_ordered_reports(source, lines, diagnostic, nodes, keys, key_first, key_past,
            stage, result.tree.used, count, retained, run[0u64].retained)) return ScratchFailed;
    run[0u64].retained <- run[0u64].retained + retained;
    return if (retained == count) { Complete } else { DiagnosticsIncomplete }
}

proc write_located_diagnostic(source:const SourceBytes in S, lines:const SourceLines in S,
                               handle diagnostic:DiagnosticDestination in D,
                               stage:u8, code:u8, first:u64, past:u64, related:u64) -> bool
    where {const owner S, owner D} {
    ref start = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref end = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref previous = make SourcePosition { line <- 0u64; column <- 0u64; };
    locate_source_position(source, lines, first, start);
    locate_source_position(source, lines, past, end);
    locate_source_position(source, lines, related, previous);
    return write_diagnostic(diagnostic, stage, code, start.line, start.column, end.line, end.column,
                            previous.line, previous.column, 0u64) == 0u8
}

export proc report_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
                             handle diagnostic:DiagnosticDestination in D,
                             stage:u8, code:u8, first:u64, past:u64, related:u64) -> void
    where {const owner S, owner D} {
    (write_located_diagnostic(source, lines, diagnostic, stage, code, first, past, related)):void;
    return
}

proc write_single_report(handle diagnostic:DiagnosticDestination in D, stage:u8, code:u8,
    first:const SourcePosition in F, past:const SourcePosition in P, related:const SourcePosition in A,
    keys:const SourceBytes in K, key_first:u64, key_past:u64, first_finding:u64) -> bool
    where {owner D, const owner F, const owner P, const owner A, const owner K} {
    try {
        ref rows = make SourceDiagnosticRows(1u64, make SourceDiagnosticRow {
            code <- code; first_line <- first.line; first_column <- first.column;
            past_line <- past.line; past_column <- past.column;
            related_line <- related.line; related_column <- related.column
        });
        return write_source_reports(diagnostic, rows, 1u64, keys, key_first, key_past, stage, first_finding) == 0u8
    } catch (error:const OutOfMemoryError) {
        return false
    }
}

export proc report_stored_rejection(handle diagnostic:DiagnosticDestination in D, stage:u8, code:u8,
    first:const SourcePosition in F, past:const SourcePosition in P, related:const SourcePosition in A,
    keys:const SourceBytes in K, key_first:u64, key_past:u64, run:DiagnosticRuns in Q)
    -> CompilerStatus where {owner D, const owner F, const owner P, const owner A, const owner K, owner Q} {
    if (diagnostic_budget_full(run)) return DiagnosticsIncomplete;
    const val finding <- run[0u64].retained;
    if (finding == no_node()) return ScratchFailed;
    if (finding == 0u64 &&
        write_diagnostic(diagnostic, stage, code, first.line, first.column, past.line, past.column,
            related.line, related.column, 0u64) != 0u8) return ScratchFailed;
    if (!write_single_report(diagnostic, stage, code, first, past, related, keys, key_first, key_past, finding))
        return ScratchFailed;
    run[0u64].retained <- finding + 1u64;
    return Complete
}

export proc report_graph_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, stage:u8, code:u8, first:u64, past:u64, related:u64,
    keys:const SourceBytes in K, key_first:u64, key_past:u64, run:DiagnosticRuns in Q)
    -> CompilerStatus where {const owner S, owner D, const owner K, owner Q} {
    ref start = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref end = make SourcePosition { line <- 0u64; column <- 0u64; };
    ref previous = make SourcePosition { line <- 0u64; column <- 0u64; };
    locate_source_position(source, lines, first, start);
    locate_source_position(source, lines, past, end);
    locate_source_position(source, lines, related, previous);
    return report_stored_rejection(diagnostic, stage, code, start, end, previous, keys, key_first, key_past, run)
}

export proc report_source_open_error(handle diagnostic:DiagnosticDestination in D, os_error:u64) -> void where {owner D} {
    (write_diagnostic(diagnostic, 0u8, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, os_error)):void;
    return;
}

proc report_native_error(handle diagnostic:DiagnosticDestination in D, stage:u8, code:u32) -> void where {owner D} {
    (write_diagnostic(diagnostic, stage, code, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64)):void;
    return;
}

export proc report_backend_error(handle diagnostic:DiagnosticDestination in D, code:u8) -> void where {owner D} {
    report_native_error(diagnostic, 6u8, code);
    return;
}

export proc report_scratch_error(handle diagnostic:DiagnosticDestination in D, code:u32) -> void where {owner D} {
    report_native_error(diagnostic, 7u8, code);
    return;
}

export proc report_provider_error(handle diagnostic:DiagnosticDestination in D, code:u32) -> void where {owner D} {
    report_native_error(diagnostic, 8u8, code);
    return;
}
