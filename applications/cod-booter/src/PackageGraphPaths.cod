using "./CompilerStatus.cod" CompilerStatus { Complete, OpenFailed, Rejected, ScratchFailed, DiagnosticsIncomplete };
using "std:exceptions" OutOfMemoryError;
using "./NativeSource.cod" {
    PathOwner, SourceRevision,
};
using "./NativeModuleInputs.cod" {
    DirectoryStorageException, BundledDirectory, BundledDirectoryException, bundled_directory_use,
    probe_package_module, prepare_package_module,
};
using "./NativeDiagnostics.cod" {
    DiagnosticDestination, DiagnosticRuns, diagnostic_budget_full, PackageDiagnosticKind,
    PackageDiagnosticKind {
        PackageShadow, PackageAmbiguity, PackageMissing, PackageLookupFailure,
        PackageInputFailure, InvalidModulePath,
    },
};
using "./PackageDiagnostics.cod" {
    report_package_path, package_issue, package_delivery_failure, dependency_diagnostics_incomplete,
};
using "./SourceStorage.cod" SourceBytes;
using "./ParserStorage.cod" no_node;
using "./PackageInputs.cod" PackageSourceRoots;
using "./LoadPackageInputs.cod" load_package_inputs;
using "./PackageModuleResolution.cod" {
    probe_package_roots, absent_module,
    PackageResolution { MissingModule, SearchFailed, AmbiguousModule, PackageModule },
};

export data PackageEdge {
    first:UInt64;
    past:UInt64;
    spelling_first:UInt64;
    spelling_past:UInt64;
    importer_first:UInt64;
    importer_past:UInt64;
}

func package_rejection_code(status:CompilerStatus) -> UInt8 {
    if (status == Complete) return package_issue();
    return if (status == DiagnosticsIncomplete) {
        dependency_diagnostics_incomplete()
    } else { package_delivery_failure() }
}

export proc report_package_issue(
    handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    kind:PackageDiagnosticKind, os_error:UInt64, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E, run:DiagnosticRuns in G)
    -> UInt8 where {const owner S, owner D, owner G, const owner F, const owner E} {
    ref empty = make SourceBytes(0u64, 0u8);
    val result <- report_package_path(opened, diagnostic, kind, os_error, edge.first, edge.past,
        keys, edge.importer_first, edge.importer_past,
        spelling, edge.spelling_first, edge.spelling_past, empty, empty, run);
    return package_rejection_code(result)
}

proc remember_package_input_failure(
    handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    kind:PackageDiagnosticKind, os_error:UInt64, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E, run:DiagnosticRuns in G)
    -> UInt8 where {const owner S, owner D, owner G, const owner F, const owner E} {
    const val finding <- run[0u64].retained;
    val reported <- report_package_issue(opened, diagnostic, kind, os_error, keys, spelling, edge, run);
    if (reported == package_issue()) {
        if (run[0u64].retained != finding + 1u64) return package_delivery_failure();
        (run[0u64].package_input_failure <- finding):void
    };
    return reported
}

proc load_for_edge(
    handle entry:PathOwner in A, handle opened:SourceRevision in S,
    handle diagnostic:DiagnosticDestination in D, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E,
    ready:bool in G, ref var rows:PackageSourceRoots in G, ref var paths:SourceBytes in G,
    row_count:UInt64 in G, path_used:UInt64 in G, run:DiagnosticRuns in G)
    -> UInt8 where {const owner A, const owner S, owner D, owner G, const owner F, const owner E} {
    if (ready) return 0u8;
    if (run[0u64].package_input_failure != no_node()) return package_issue();
    ref os_error = make UInt64 { 0u64 };
    try {
        val result <- load_package_inputs(entry, rows, paths, row_count, path_used, os_error);
        if (result == OpenFailed) return remember_package_input_failure(
            opened, diagnostic, PackageInputFailure, os_error, keys, spelling, edge, run);
        if (result != Complete) return remember_package_input_failure(
            opened, diagnostic, PackageInputFailure, 0u64, keys, spelling, edge, run);
        ready <- true;
        return 0u8
    } catch (error:const DirectoryStorageException) {
        return remember_package_input_failure(
            opened, diagnostic, PackageInputFailure, error.os_error, keys, spelling, edge, run)
    }
}

func claim_length(
    root:const SourceBytes in R, first:UInt64, past:UInt64,
    spelling:const SourceBytes in F, start:UInt64, end:UInt64)
    -> UInt64 where {const owner R, const owner F} {
    if (first >= past || past > intrinsic (len)(root) || root[first] != 47u8 ||
        start >= end || end > intrinsic (len)(spelling) || spelling[start] == 47u8)
        return 0u64;
    for (at in first .. past) { if (root[at] == 0u8) return 0u64 };
    for (at in start .. end) { if (spelling[at] == 0u8) return 0u64 };
    val separator <- if (root[past - 1u64] == 47u8) { 0u64 } else { 1u64 };
    val prefix <- past - first;
    val name <- end - start;
    val limit <- 18446744073709551615u64 - separator;
    if (name > limit || prefix > limit - name) return 0u64;
    return prefix + separator + name
}

func write_claim(
    target:SourceBytes in T, root:const SourceBytes in R, first:UInt64, past:UInt64,
    spelling:const SourceBytes in F, start:UInt64, end:UInt64)
    -> void where {owner T, const owner R, const owner F} {
    for (at in first .. past) { (target[at - first] <- root[at]):void };
    val next <- past - first;
    if (root[past - 1u64] != 47u8) {
        target[next] <- 47u8;
        (next <- next + 1u64):void
    };
    for (at in start .. end) { (target[next + (at - start)] <- spelling[at]):void };
    return
}

proc report_claims(
    handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    kind:PackageDiagnosticKind, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E,
    left:const SourceBytes in L, left_first:UInt64, left_past:UInt64,
    right:const SourceBytes in R, right_first:UInt64, right_past:UInt64, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, owner G, const owner F,
                              const owner E, const owner L, const owner R} {
    val start <- edge.spelling_first;
    val end <- edge.spelling_past;
    val left_length <- claim_length(left, left_first, left_past, spelling, start, end);
    val right_length <- claim_length(right, right_first, right_past, spelling, start, end);
    if (left_length == 0u64 || right_length == 0u64) return ScratchFailed;
    try {
        ref candidate = make SourceBytes(left_length, 0u8);
        ref other = make SourceBytes(right_length, 0u8);
        write_claim(candidate, left, left_first, left_past, spelling, start, end);
        write_claim(other, right, right_first, right_past, spelling, start, end);
        return report_package_path(opened, diagnostic, kind, 0u64, edge.first, edge.past,
            keys, edge.importer_first, edge.importer_past, spelling, start, end, candidate, other, run)
    } catch (error:const OutOfMemoryError) {
        return ScratchFailed
    }
}

func lookup_failure(code:UInt8) -> CompilerStatus {
    if (code == package_delivery_failure()) return ScratchFailed;
    if (code == dependency_diagnostics_incomplete()) return DiagnosticsIncomplete;
    return Rejected
}

proc finish_package_lookup(
    handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    handle destination:PathOwner in P, rows:const PackageSourceRoots in G,
    paths:const SourceBytes in G, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E, root:UInt64, row_count:UInt64,
    bundle:const SourceBytes in B, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, owner P, owner G, const owner F,
                              const owner E, const owner B} {
    val start <- edge.spelling_first;
    val end <- edge.spelling_past;
    val length <- intrinsic (len)(bundle);
    val probe <- probe_package_module(bundle, 0u64, length, spelling, start, end);
    if (probe != 0u64 && probe != absent_module())
        return lookup_failure(report_package_issue(
            opened, diagnostic, PackageLookupFailure, probe, keys, spelling, edge, run));
    val error <- 0u64;
    if (root < row_count) {
        val first <- rows[root].path_first;
        val past <- rows[root].path_past;
        if (probe == 0u64) {
            val shadow <- report_claims(opened, diagnostic, PackageShadow, keys, spelling, edge,
                paths, first, past, bundle, 0u64, length, run);
            if (shadow != Complete) return shadow;
            if (diagnostic_budget_full(run)) return DiagnosticsIncomplete
        };
        error <- prepare_package_module(destination, paths, first, past, spelling, start, end)
    } else {
        if (probe == absent_module())
            return lookup_failure(report_package_issue(
                opened, diagnostic, PackageMissing, 0u64, keys, spelling, edge, run));
        error <- prepare_package_module(destination, bundle, 0u64, length, spelling, start, end)
    };
    if (error != 0u64) return lookup_failure(report_package_issue(
        opened, diagnostic, PackageLookupFailure, error, keys, spelling, edge, run));
    return Complete
}

proc prepare_resolved_module(
    handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    handle destination:PathOwner in P, rows:const PackageSourceRoots in G,
    paths:const SourceBytes in G, keys:const SourceBytes in G,
    spelling:const SourceBytes in F, edge:const PackageEdge in E, val row_count:UInt64, path_used:UInt64,
    run:DiagnosticRuns in G) -> UInt8 where {const owner S, owner D, owner P, owner G, const owner F, const owner E} {
    val selected <- row_count;
    case probe_package_roots(rows, paths, row_count, path_used, spelling,
        edge.spelling_first, edge.spelling_past) of {
        (MissingModule) -> {};
        (SearchFailed { val os_error <-; }) -> {
            return report_package_issue(
                opened, diagnostic, PackageLookupFailure, os_error, keys, spelling, edge, run)
        };
        (AmbiguousModule { val first_root <-; val second_root <-; }) -> {
            return package_rejection_code(report_claims(opened, diagnostic, PackageAmbiguity, keys, spelling, edge,
                paths, rows[first_root].path_first, rows[first_root].path_past,
                paths, rows[second_root].path_first, rows[second_root].path_past, run))
        };
        (PackageModule { val root <-; }) -> { (selected <- root):void };
    };
    try {
        own handle directory:BundledDirectory <- make own handle BundledDirectory();
        val status <- bundled_directory_use(directory) (bundle) => {
            continue finish_package_lookup(opened, diagnostic, destination, rows, paths, keys,
                spelling, edge, selected, row_count, bundle, run)
        };
        if (status == Complete) return 0u8;
        if (status == ScratchFailed) return package_delivery_failure();
        if (status == DiagnosticsIncomplete) return dependency_diagnostics_incomplete();
        return package_issue()
    } catch (error:const BundledDirectoryException) {
        return report_package_issue(
            opened, diagnostic, PackageLookupFailure, error.os_error, keys, spelling, edge, run)
    }
}

export proc prepare_logical_dependency(
    handle entry:PathOwner in A, handle opened:SourceRevision in S,
    handle diagnostic:DiagnosticDestination in D, handle destination:PathOwner in P,
    keys:const SourceBytes in G, spelling:const SourceBytes in F, edge:const PackageEdge in E,
    ready:bool in G, ref var rows:PackageSourceRoots in G, ref var paths:SourceBytes in G,
    row_count:UInt64 in G, path_used:UInt64 in G, run:DiagnosticRuns in G)
    -> UInt8
    where {const owner A, const owner S, owner D, owner P, owner G, const owner F, const owner E} {
    val loaded <- load_for_edge(entry, opened, diagnostic, keys, spelling, edge, ready,
        rows, paths, row_count, path_used, run);
    if (loaded != 0u8) return loaded;
    return prepare_resolved_module(opened, diagnostic, destination, rows, paths, keys, spelling,
        edge, row_count, path_used, run)
}
