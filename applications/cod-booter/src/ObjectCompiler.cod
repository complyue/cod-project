using "NativeSource.cod" Path;
using "NativeScratch.cod" ScratchOpenException;
using symbol "NativeLLVM.cod" @llvmSession;
using "NativeLLVM.cod" { LLVMSession, LLVMOpenException, llvm_verify, llvm_emit_object };
using "NativeDiagnostics.cod" { DiagnosticDestination, report_backend_error, report_scratch_error };
using "SourceStorage.cod" SourceBytes;
using "ModuleExports.cod" ModuleExports;
using "ModuleGraph.cod" { NativeGraph, collect_native_graph, construct_native_graph };
using "CompilerStatus.cod" CompilerStatus { Complete, OpenFailed, LoweringFailed, FinishFailed, ScratchFailed };

proc verify_active_session() -> u8 {
    return llvm_verify(@llvmSession);
}

proc write_object(handle graph:NativeGraph in G, output:const String in A,
                  handle diagnostic:DiagnosticDestination in D) -> CompilerStatus
    where {const owner G, const owner A, owner D} {
    proc report_failure(code:u8, status:CompilerStatus) -> CompilerStatus {
        report_backend_error(diagnostic, code);
        return status;
    };

    try {
        effect @llvmSession <- make own handle LLVMSession();
        val constructed <- construct_native_graph(graph, @llvmSession);
        if (constructed != 0u8) return report_failure(constructed, LoweringFailed);
        val verified <- verify_active_session();
        if (verified != 0u8) return report_failure(verified, FinishFailed);
        val emitted <- llvm_emit_object(@llvmSession, output:CString);
        if (emitted != 0u8) return report_failure(emitted, FinishFailed);
        return Complete;
    } catch (error:LLVMOpenException) {
        return report_failure(error.status, OpenFailed);
    }
}

export proc compile_object(handle input:Path in A, output:const String in A,
                           handle diagnostic:DiagnosticDestination in D,
                           spellings:const SourceBytes in B, exports:const ModuleExports in B) -> CompilerStatus
    where {const owner A, const owner B, owner D} {
    try {
        own handle graph:NativeGraph <- make own handle NativeGraph();
        val checked <- collect_native_graph(graph, input, diagnostic, spellings, exports);
        if (checked != Complete) return checked;
        return write_object(graph, output, diagnostic);
    } catch (error:ScratchOpenException) {
        report_scratch_error(diagnostic, error.status);
        return ScratchFailed;
    }
}
