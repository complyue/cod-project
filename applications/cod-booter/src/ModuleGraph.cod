export enum GraphPurpose:UInt8 { Declarations; NativeObject; }

export data DependencyEdge {
    finding:UInt64;
    owns_finding:bool;
    site:UInt64;
    path:UInt64;
    mode:ModuleSelectionMode;
    first:UInt64;
    past:UInt64;
    decoded_first:UInt64;
    decoded_past:UInt64;
}
export array DependencyEdges [UInt64]:DependencyEdge;

export func collect_dependency_edges(source:const SourceBytes in S, nodes:const ExprNodes in F,
                                     used:UInt64, revision:UInt64, edges:DependencyEdges in E)
    -> UInt64 where {const owner S, const owner F, owner E} {
    ref item = make UInt64 { no_node() };
    if (used == 0u64 || !module_tail(nodes, revision, used, used - 1u64, item)) return no_node();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val count <- 0u64;
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    val path <- no_node();
    for (scan in 0u64 .. used) {
        if (item != no_node()) {
            if (inspect_sequence_entry(nodes, revision, used, item, entry) != ModuleSequence) return no_node();
            selection.path <- no_node();
            path <- file_dependency_path(source, nodes, used, revision, entry.item, selection, bulk);
            if (path != no_node()) {
                if (count >= intrinsic (len)(edges)) return no_node();
                edges[count].site <- entry.item;
                edges[count].path <- path;
                edges[count].mode <- if (selection.path == path) { (selection.mode) } else { (bulk.mode) };
                edges[count].first <- syntax_first(nodes, used, path);
                edges[count].past <- syntax_past(nodes, used, path);
                (count <- count + 1u64):void
            };
            item <- entry.previous
        }
    };
    if (item != no_node()) return no_node();
    # Module entries link backwards. Restore discovery order before resolving paths.
    val right <- count;
    val site <- no_node();
    val mode <- UseResource;
    val first <- 0u64;
    val past <- 0u64;
    for (left in 0u64 .. count / 2u64) {
        right <- right - 1u64;
        site <- edges[left].site;
        path <- edges[left].path;
        mode <- edges[left].mode;
        first <- edges[left].first;
        past <- edges[left].past;
        edges[left].site <- edges[right].site;
        edges[left].path <- edges[right].path;
        edges[left].mode <- edges[right].mode;
        edges[left].first <- edges[right].first;
        edges[left].past <- edges[right].past;
        edges[right].site <- site;
        edges[right].path <- path;
        edges[right].mode <- mode;
        edges[right].first <- first;
        (edges[right].past <- past):void
    };
    return count
}

func same_dependency_occurrence(edges:const DependencyEdges in E, edge:UInt64) -> bool
    where {const owner E} {
    if (edge == 0u64 || edges[edge].path == no_node()) return false;
    return edges[edge].path == edges[edge - 1u64].path &&
        edges[edge].mode == edges[edge - 1u64].mode
}

export func decode_dependency_path(source:const SourceBytes in S, first:UInt64, past:UInt64,
                                   decoded:SourceBytes in F, start:UInt64)
    -> UInt64 where {const owner S, owner F} {
    if (first >= past || past > intrinsic (len)(source) || past - first < 3u64) return no_node();
    if (source[first] != 34u8 || source[past - 1u64] != 34u8) return no_node();
    if (start > intrinsic (len)(decoded) || past - first - 2u64 > intrinsic (len)(decoded) - start)
        return no_node();
    val count <- start;
    val escaped <- false;
    for (at in first + 1u64 .. past - 1u64) {
        if (escaped) {
            if (source[at] != 34u8 && source[at] != 92u8) return no_node();
            decoded[count] <- source[at];
            count <- count + 1u64;
            escaped <- false;
        } else {
            if (source[at] == 92u8) {
                escaped <- true;
            } else {
                if (source[at] == 0u8 || source[at] == 34u8) return no_node();
                decoded[count] <- source[at];
                count <- count + 1u64;
            };
        };
    };
    if (escaped) return no_node();
    return count;
}

data PublicationSize {
    source_bytes:UInt64;
    spelling_bytes:UInt64;
    literal_bytes:UInt64;
    literals:UInt64;
}
array PublicationSizes[UInt64]:PublicationSize;

proc reserve_exports(ref var rows:ModuleExports in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val capacity <- intrinsic (len)(rows);
    if (required <= capacity) return;
    ref next = make ModuleExports(growth_capacity(capacity, required), make ModuleExport {
        module_first <- 0u64; module_past <- 0u64; name_first <- 0u64; name_past <- 0u64;
        identity <- 0u64; kind <- 0u8; checked <- 0u8; publishing_module <- 0u64; origin_module <- 0u64;
        owner_module <- 0u64; owner_identity <- 0u64; shape <- 0u8;
    }) in G;
    for (i in 0u64 .. used) { next[i] <- rows[i]; };
    rows = next;
    return;
}

proc reserve_interfaces(ref var rows:ModuleInterfaces in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val capacity <- intrinsic (len)(rows);
    if (required <= capacity) return;
    ref next = make ModuleInterfaces(growth_capacity(capacity, required), make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- 0u64; name_first <- 0u64; name_past <- 0u64;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <- NoCallableKind;
        native_reception <- 0u8;
        native_passes_owner <- 0u8;
        membership <- UnprovedMembership;
        sum_payload <- make NoSumInterface {}; aggregate_storage <- UnprovedAggregate;
        exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
        scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- NoArrayRead; source_numeric_fault <- false; source_writer <- NoSourceWriter; object_view <- make NoCallableObjectView {};
        array_slot_checked <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    }) in G;
    for (i in 0u64 .. used) { next[i] <- rows[i]; };
    rows = next;
    return;
}

proc reserve_commands(ref var rows:NativeCommands in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val capacity <- intrinsic (len)(rows);
    if (required <= capacity) return;
    ref next = make NativeCommands(growth_capacity(capacity, required),
        make NativeCommand { opcode <- 0u8; a <- 0u64; b <- 0u64; c <- 0u64; d <- 0u64; }) in G;
    for (i in 0u64 .. used) { next[i] <- rows[i]; };
    rows = next;
    return;
}

proc reserve_units(ref var rows:NativeUnitRows in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val capacity <- intrinsic (len)(rows);
    if (required <= capacity) return;
    ref next = make NativeUnitRows(growth_capacity(capacity, required), make NativeUnitRow {
        command_first <- 0u64; command_past <- 0u64; literal_first <- 0u64; literal_past <- 0u64;
        name_first <- 0u64; name_past <- 0u64; source_size <- 0u64; labels <- 0u64; slots <- 0u64;
    }) in G;
    for (i in 0u64 .. used) { next[i] <- rows[i]; };
    rows = next;
    return;
}

proc reserve_literals(ref var rows:NativeLiteralRanges in G, used:UInt64, required:UInt64) -> void where {owner G} {
    val capacity <- intrinsic (len)(rows);
    if (required <= capacity) return;
    ref next = make NativeLiteralRanges(growth_capacity(capacity, required),
        make NativeLiteralRange { first <- 0u64; past <- 0u64; }) in G;
    for (i in 0u64 .. used) { next[i] <- rows[i]; };
    rows = next;
    return;
}

func add_span(size:UInt64, first:UInt64, past:UInt64, limit:UInt64) -> UInt64 {
    if (first > past || past > limit || past - first >= no_node() - size) return no_node();
    return size + (past - first);
}

func measure_written_publications(nodes:const ExprNodes in N, revision:UInt64, used:UInt64) -> UInt64
    where {const owner N} {
    ref resource = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource; nature <- OrdinaryResource
    };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val count <- 0u64;
    for (at in 0u64 .. used) {
        if ((inspect_module_selection(nodes, revision, used, at, resource) == SelectionReady &&
                resource.mode == ReexportResource) ||
            inspect_declaration(nodes, revision, used, at, declaration) == LocalPublication) {
            (count <- count + 1u64):void
        } else {
            if (module_item_publication(nodes, used, at)) {
                if (inspect_sequence_entry(nodes, revision, used, at, entry) != ModuleSequence)
                    return no_node();
                if (inspect_bulk_selection(nodes, revision, used, entry.item, bulk) != SelectionReady)
                    { (count <- count + 1u64):void }
            }
        }
    };
    return count
}

func measure_publication(source:const SourceBytes in S, exports:const ModuleExports in F,
                         names:const StagedExportNames in F, graph_used:UInt64,
                         interfaces:const ModuleInterfaces in F, commands:const NativeCommands in F,
                         module:UInt64, export_count:UInt64, interface_count:UInt64, command_count:UInt64,
                         size:PublicationSize in M)
    -> bool where {const owner S, const owner F, owner M} {
    if (export_count > intrinsic (len)(exports) || export_count > intrinsic (len)(names) ||
        interface_count > intrinsic (len)(interfaces) ||
        command_count > intrinsic (len)(commands)) return false;
    val limit <- intrinsic (len)(source);
    val spelling_bytes <- 0u64;
    val literal_bytes <- 0u64;
    val literals <- 0u64;
    val remaining_members <- 0u64;
    for (i in 0u64 .. export_count) {
        if (exports[i].publishing_module != module) return false;
        case names[i] of {
            SourceSpelling { val range <- span; } -> {
                if (range.first != exports[i].name_first || range.past != exports[i].name_past ||
                    range.first >= range.past) return false;
                spelling_bytes <- add_span(spelling_bytes, range.first, range.past, limit);
                if (spelling_bytes == no_node()) return false
            };
            GraphSpelling { val range <- span; } -> {
                if (range.first != exports[i].name_first || range.past != exports[i].name_past ||
                    range.first >= range.past || range.past > graph_used) return false
            };
            _ -> { return false }
        }
    };
    for (i in 0u64 .. interface_count) {
        if (remaining_members == 0u64) {
            if (interfaces[i].defining_module != module || interfaces[i].interface_kind == 0u8 ||
                interfaces[i].value_kind != 0u8 || interfaces[i].entry_count >= interface_count - i) return false;
            remaining_members <- interfaces[i].entry_count;
        } else {
            remaining_members <- remaining_members - 1u64;
        };
        spelling_bytes <- add_span(spelling_bytes, interfaces[i].name_first, interfaces[i].name_past, limit);
        if (spelling_bytes == no_node()) return false;
    };
    for (i in 0u64 .. command_count) {
        if (commands[i].opcode == text_literal()) {
            literal_bytes <- add_span(literal_bytes, commands[i].b, commands[i].c, limit);
            if (literal_bytes == no_node() || commands[i].c - commands[i].b < 2u64) return false;
            literals <- literals + 1u64;
        };
    };
    size.source_bytes <- limit;
    size.spelling_bytes <- spelling_bytes;
    size.literal_bytes <- literal_bytes;
    size.literals <- literals;
    return true;
}

func copy_span(source:const SourceBytes in S, first:UInt64, past:UInt64,
               destination:SourceBytes in G, start:UInt64) -> UInt64 where {const owner S, owner G} {
    for (i in 0u64 .. past - first) { destination[start + i] <- source[first + i]; };
    return start + (past - first);
}

func copy_publication(source:const SourceBytes in S, exports:const ModuleExports in F,
                      names:const StagedExportNames in F, interfaces:const ModuleInterfaces in F,
                      published:ModuleExports in G, published_interfaces:ModuleInterfaces in G, spellings:SourceBytes in G,
                      export_count:UInt64, interface_count:UInt64, export_first:UInt64, interface_first:UInt64, spelling_first:UInt64)
    -> void where {const owner S, const owner F, owner G} {
    val start <- spelling_first;
    val past <- spelling_first;
    for (i in 0u64 .. export_count) {
        published[export_first + i] <- exports[i];
        case names[i] of {
            SourceSpelling { val range <- span; } -> {
                past <- copy_span(source, range.first, range.past, spellings, start);
                published[export_first + i].name_first <- start;
                published[export_first + i].name_past <- past;
                (start <- past):void
            };
            _ -> {}
        }
    };
    for (i in 0u64 .. interface_count) {
        past <- copy_span(source, interfaces[i].name_first, interfaces[i].name_past, spellings, start);
        published_interfaces[interface_first + i] <- interfaces[i];
        published_interfaces[interface_first + i].name_first <- start;
        published_interfaces[interface_first + i].name_past <- past;
        start <- past;
    };
}

func copy_unit_material(source:const SourceBytes in S, staged:const NativeCommands in F,
                        commands:NativeCommands in G, literals:NativeLiteralRanges in G, spellings:SourceBytes in G,
                        count:UInt64, command_first:UInt64, literal_first:UInt64, spelling_first:UInt64)
    -> void where {const owner S, const owner F, owner G} {
    val literal_index <- literal_first;
    val start <- spelling_first;
    val past <- spelling_first;
    for (i in 0u64 .. count) {
        commands[command_first + i] <- staged[i];
        if (staged[i].opcode == text_literal()) {
            past <- copy_span(source, staged[i].b, staged[i].c, spellings, start);
            literals[literal_index].first <- start;
            literals[literal_index].past <- past;
            literal_index <- literal_index + 1u64;
            commands[command_first + i].d <- literal_index - literal_first;
            start <- past;
        };
    };
}

data ModuleProgress {
    identity:UInt64;
    used:UInt64;
    root:UInt64;
    revision:UInt64;
    dependencies:UInt64;
    read_rejected:bool;
    count:UInt64;
    default_count:UInt64;
    interface_count:UInt64;
    purpose:GraphPurpose;
    entry:UInt8;
    function_base:UInt64;
    functions:UInt64;
    command_count:UInt64;
    primitive_namespace:bool;
    labels:UInt64;
    slots:UInt64;
    variadic_stop:VariadicProfileStop;
    structural_dependency:bool;
}
array ModuleProgressRows[UInt64]:ModuleProgress;

proc read_visit_frame(source:const SourceBytes in S, lines:const SourceLines in S,
                      handle diagnostic:DiagnosticDestination in D, tokens:Tokens in F, nodes:ExprNodes in F,
                      selected:SelectedExports in F, edges:DependencyEdges in F, decoded:SourceBytes in F,
                      progress:ModuleProgressRows in F, keys:const SourceBytes in K, key_first:UInt64, key_past:UInt64,
                      run:DiagnosticRuns in Q)
    -> CompilerStatus where {const owner S, owner D, owner F, const owner K, owner Q} {
    ref result = make FrontendResult {
        scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- false; invalid_source <- false; };
        tree <- make ParseResult {
            revision <- progress[0u64].revision; next <- 0u64; used <- 0u64; root <- no_node(); diagnostic <- 0u8;
            supplied_here <- false; case_control <- false;
            reports <- 0u64; lexical_reports <- 0u64; exhausted <- false;
        };
        diagnostic_first <- no_node(); diagnostic_past <- no_node();
    };
    val source_ready <- read_module(source, tokens, nodes, result);
    if (!source_ready) {
        if (result.tree.exhausted && (result.tree.diagnostic == 0u8 || result.tree.diagnostic == node_storage_exhausted())) {
            report_scratch_error(diagnostic, 1u32);
            return ScratchFailed
        };
        val reported <- report_parse_rejection(source, lines, diagnostic, nodes, result, keys, key_first, key_past,
            module_read_failed(), run);
        if (reported != Complete) return reported;
        if (result.tree.exhausted) return ScratchFailed;
        if (result.tree.root == no_node()) return Rejected
    };
    progress[0u64].read_rejected <- !source_ready;
    val count <- collect_dependency_edges(source, nodes, result.tree.used, result.tree.revision, edges);
    if (count == no_node() || !prepare_module_dependencies(selected, result.tree.used)) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    };
    val next_decoded <- 0u64;
    val first <- 0u64;
    val past <- no_node();
    for (edge in 0u64 .. count) {
        # The parser shares a path node among the consecutive items of one directive.
        if (!same_dependency_occurrence(edges, edge)) {
            first <- next_decoded;
            past <- decode_dependency_path(source, edges[edge].first, edges[edge].past, decoded, first);
            if (past != no_node()) { (next_decoded <- past):void }
        };
        edges[edge].decoded_first <- first;
        (edges[edge].decoded_past <- past):void
    };
    progress[0u64].used <- result.tree.used;
    progress[0u64].root <- result.tree.root;
    progress[0u64].dependencies <- count;
    return Complete;
}

proc read_opened_frame(handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
                       tokens:Tokens in F, nodes:ExprNodes in F, selected:SelectedExports in F,
                       edges:DependencyEdges in F, decoded:SourceBytes in F, progress:ModuleProgressRows in F,
                       keys:const SourceBytes in K, const val key_first:UInt64, const val key_past:UInt64,
                       run:DiagnosticRuns in Q) -> CompilerStatus
    where {const owner S, owner D, owner F, const owner K, owner Q} {
    return with_source(opened) (source, lines) => {
        continue read_visit_frame(source, lines, diagnostic, tokens, nodes, selected, edges, decoded,
                                  progress, keys, key_first, key_past, run)
    }
}

func bind_graph_names(source:const SourceBytes in S, nodes:const ExprNodes in W,
                      spellings:const SourceBytes in G, spelling_size:UInt64,
                      checked_selections:const CheckedSelections in C, checked_used:UInt64,
                      interfaces:const ModuleInterfaces in G, interface_count:UInt64, selected:SelectedExports in W,
                      names:NameBindings in W, work:NameWork in W, facts:AggregateFacts in F,
                      views:SuppliedViews in H,
                      result:ModuleBindingResult in R, native:bool, allow_structural:bool, recovery:ProductTypeRecovery in P) -> bool
    where {const owner S, owner W, const owner G, const owner C, owner F, owner H, owner R, owner P} {
    ref members = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!resolve_enum_selections(source, nodes, result.frontend.tree.used, result.frontend.tree.revision,
                                 spellings, spelling_size, interfaces, interface_count, checked_selections, checked_used, selected, members)) {
        binding_diagnostic(nodes, result, module_selection_failed(), members.diagnostic, members.node);
        return false;
    } else {};
    if (!resolve_sum_selections(source, nodes, result.frontend.tree.used, result.frontend.tree.revision,
                                spellings, spelling_size, interfaces, interface_count, selected, members)) {
        binding_diagnostic(nodes, result, module_selection_failed(), members.diagnostic, members.node);
        return false;
    };
    if (!verify_aggregate_selections(nodes, result.frontend.tree.used, result.frontend.tree.revision,
                                     interfaces, interface_count, selected, record_type(), members)) {
        binding_diagnostic(nodes, result, module_selection_failed(), members.diagnostic, members.node);
        return false;
    };
    val used <- result.frontend.tree.used;
    if (!bind_selected_module_recovering(source, nodes, checked_selections, checked_used, selected, names,
        work, interfaces, interface_count, facts, views, native, allow_structural, result, recovery))
        return false;
    ref expressions = make DeclaredExpressionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_enum_assertions(source, nodes, names, selected, work, spellings, interfaces, interface_count,
        used, result.frontend.tree.revision, expressions)) {
        binding_diagnostic(nodes, result, module_binding_failed(), expressions.diagnostic, expressions.node);
        return false
    };
    if (native) return true;
    ref checked = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_module_calls(nodes, names, selected, interfaces, interface_count, facts, work, views,
        used, result.frontend.tree.revision, checked)) {
        binding_diagnostic(nodes, result, module_binding_failed(), checked.diagnostic, checked.node);
        return false;
    } else {};
    return true
}

func prepare_graph_source_operands(source:const SourceBytes in S, nodes:const ExprNodes in W,
    names:NameBindings in W, selected:const SelectedExports in W, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_size:UInt64, interfaces:const ModuleInterfaces in G,
    interface_count:UInt64, facts:const AggregateFacts in F, cases:ConstructorCaseFacts in C, views:const SuppliedViews in H,
    first_case:UInt64 in R, result:ModuleBindingResult in R) -> bool
    where {const owner S, owner W, const owner G, const owner F, owner C, const owner H, owner R} {
    val used <- result.frontend.tree.used;
    ref expressions = make DeclaredExpressionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_constructor_cases(source, nodes, names, selected, work, spellings, spelling_size,
        interfaces, interface_count, facts, cases, views, used, result.frontend.tree.revision,
        first_case, expressions)) {
        binding_diagnostic(nodes, result, module_binding_failed(), expressions.diagnostic, expressions.node);
        return false
    };
    if (!check_declared_expressions(source, nodes, names, selected, work, spellings, interfaces,
                                    interface_count, used, result.frontend.tree.revision, expressions)) {
        binding_diagnostic(nodes, result, module_binding_failed(), expressions.diagnostic, expressions.node);
        return false;
    } else {};
    return true;
}

func first_library_initialization(nodes:const ExprNodes in N, work:const NameWork in W, tree:const ParseResult in T) -> UInt64
    where {const owner N, const owner W, const owner T} {
    ref item = make UInt64 { no_node() };
    if (!first_module_item(nodes, tree.revision, tree.used, tree.root, item)) return tree.root;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. tree.used) {
        if (item == no_node()) return no_node();
        if (inspect_sequence_entry(nodes, tree.revision, tree.used, item, entry) != ModuleSequence) return item;
        if (!library_declaration(nodes, tree, entry.item)) return entry.item;
        item <- work[item].next;
    };
    return no_node();
}

func library_declaration(nodes:const ExprNodes in N, tree:const ParseResult in T, at:UInt64) -> bool
    where {const owner N, const owner T} {
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    if (inspect_module_selection(nodes, tree.revision, tree.used, at, selection) == SelectionReady) return true;
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    if (inspect_bulk_selection(nodes, tree.revision, tree.used, at, bulk) == SelectionReady) return true;
    ref default_marks = make UInt64 { no_node() };
    if (inspect_default_set(nodes, tree.revision, tree.used, at, default_marks) == SelectionReady)
        return true;
    ref callable_site = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val form <- inspect_callable(nodes, tree.revision, tree.used, at, callable_site);
    if (form == ModuleCallable || form == ModuleCallablePromise) return true;
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, tree.revision, tree.used, at, declaration);
    return shape == NominalRecord || shape == EnumTypeDeclaration ||
        shape == TypeSynonymDeclaration || shape == LocalPublication;
}

proc compile_graph_unit(source:const SourceBytes in S, lines:const SourceLines in S,
                        handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W,
                        selected:const SelectedExports in W, names:const NameBindings in W, work:NameWork in W,
                        interfaces:const ModuleInterfaces in G, interface_count:UInt64,
                        progress:ModuleProgressRows in W, facts:OperandFacts in W,
                            owners:CallOwners in W,
                        sites:CompletionSites in W, commands:NativeCommands in W,
                            result:ModuleBindingResult in R, keys:const SourceBytes in G,
                            key_first:UInt64, key_past:UInt64, run:DiagnosticRuns in G) -> CompilerStatus
    where {const owner S, owner D, owner W, owner R, owner G} {
    val delivered <- Complete;
    if (progress[0u64].entry == 0u8) {
        val initializer <- first_library_initialization(nodes, work, result.frontend.tree);
        if (initializer != no_node()) {
            delivered <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(), 111u8,
                             syntax_first(nodes, result.frontend.tree.used, initializer), syntax_past(nodes, result.frontend.tree.used, initializer), no_node(), keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return FormUnsupported;
        };
    };
    ref plan = make NativePlan {
        used <- 0u64; functions <- 0u64; function_base <- 0u64; labels <- 0u64; slots <- 0u64; diagnostic <- 0u8; node <- no_node();
        initialization_notes <- false; initialization_obligations <- false;
    };
    if (!compile_bound_commands(source, nodes, selected, names, work, interfaces, interface_count, facts, owners, sites, commands,
                                 plan, result, progress[0u64].function_base, progress[0u64].entry != 0u8)) {
        if (result.stage != 0u8) {
            delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic, result.frontend.diagnostic_first,
                             result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            if (rejected_unsupported_declaration(result)) return FormUnsupported;
            return Rejected;
        };
        val first <- if (plan.node == no_node()) { no_node() } else { (syntax_first(nodes, result.frontend.tree.used, plan.node)) };
        val past <- if (plan.node == no_node()) { no_node() } else { (syntax_past(nodes, result.frontend.tree.used, plan.node)) };
        delivered <- report_graph_rejection(source, lines, diagnostic, 0u8, plan.diagnostic, first, past, no_node(), keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        if (plan.diagnostic == native_unsupported()) return FormUnsupported;
        return LoweringFailed;
    };
    progress[0u64].command_count <- plan.used;
    progress[0u64].functions <- plan.functions;
    progress[0u64].labels <- plan.labels;
    progress[0u64].slots <- plan.slots;
    return Complete;
}

func locate_variadic_profile(source:const SourceBytes in S, lines:const SourceLines in S,
                             stop:VariadicProfileStop in F, past:UInt64) -> void
    where {const owner S, owner F} {
    stop.first_byte <- past - 3u64;
    stop.past_byte <- past;
    locate_source_position(source, lines, stop.first_byte, stop.first);
    locate_source_position(source, lines, stop.past_byte, stop.past)
}

proc check_graph_exception_body(source:const SourceBytes in S, nodes:const ExprNodes in W,
                                selected:const SelectedExports in W, names:const NameBindings in W,
                                    work:const NameWork in W,
                                spellings:const SourceBytes in G, spelling_used:UInt64,
                                    interfaces:const ModuleInterfaces in G,
                                interface_count:UInt64, aggregate_facts:const AggregateFacts in A,
                                views:SuppliedViews in H, cases:const ConstructorCaseFacts in C,
                                module:UInt64, first:UInt64, caught_field:UInt64, executable:bool,
                                facts:OperandFacts in W, owners:CallOwners in W,
                                    sites:CompletionSites in W, result:ModuleBindingResult in R)
    -> bool where {const owner S, owner W, const owner G, const owner A, owner H, const owner C, owner R} {
    ref operands = make OperandCheckResult { diagnostic <- 0u8; node <- no_node(); };
    val used <- result.frontend.tree.used;
    val revision <- result.frontend.tree.revision;
    val demands <- if (executable) { 0u64 } else { used };
    ref demand = make DeclarationDemands(demands, make DeclarationDemand {
        scope <- no_node(); first_call <- no_node(); next_call <- no_node(); callee <- no_node();
        pending <- no_node(); receipt_pending <- no_node(); declared_failure <- no_node();
        receipt_body <- false; product_body_dependency <- false; slot_body <- false; signature <- false; body <- false;
    });
    val field_capacity <- if (caught_field == no_node()) { 0u64 } else { used };
    ref fields = make CaughtFieldUses(field_capacity, make NoCaughtField {});
    if (caught_field != no_node()) {
        val field_problem <- prepare_caught_fields(source, nodes, names, work, selected,
            aggregate_facts, spellings, spelling_used,
                                                  interfaces, interface_count, fields,
                                                      operands.node, module, used, revision);
        if (field_problem != 0u8) {
            binding_diagnostic(nodes, result, module_operands_failed(), field_problem,
                operands.node);
            return false
        }
    };
    if (!executable && !discover_declaration_demand(
        nodes, names, work, selected, fields, views, cases, demand, result.frontend.tree.root,
        used, revision, operands.node)) {
        binding_diagnostic(nodes, result, module_operands_failed(), 1u8, operands.node);
        return false
    };
    if (!check_module_operands(source, nodes, result.frontend.tree, names, work, selected, module,
        facts, interfaces, interface_count, owners, fields, views, cases, demand, operands)) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic,
            operands.node);
        return false
    };
    ref plans = make ExceptionConstructionFacts(used, make NoExceptionConstruction {});
    ref syntax = make NamedThrowSites { requested <- no_node(); fields <- no_node(); cause <-
        no_node(); };
    ref construction = make ExceptionConstructionResult { diagnostic <- 0u8; node <- no_node(); };
    for (at in 0u64 .. used) {
        if (first != no_node() && at >= first && inspect_named_throw(nodes, revision, used, at,
            syntax) &&
            !check_exception_construction(source, nodes, names, work, selected, aggregate_facts,
                                          spellings, spelling_used, interfaces, interface_count,
                                          facts, plans, at, module, used, revision, construction)) {
            binding_diagnostic(nodes, result, module_operands_failed(), construction.diagnostic,
                construction.node);
            return false;
        };
    };
    if (!analyze_bound_declaration_completion(nodes, names, work, facts, views, demand, sites, result))
        return false;
    if (!executable) {
        finish_text_predicates(nodes, names, work, views, facts, sites, used, revision);
        finish_closed_source_functions(nodes, names, work, views, facts, demand, sites, cases, used, revision)
    };
    val callee <- no_node();
    for (at in 0u64 .. used) {
        callee <- forwarded_array_reader(views, at);
        if (callee < used && sites[callee].array_read_completion != NoArrayRead) {
            finish_array_reader_forward(views, at, sites[callee].array_read_completion)
        };
        if (sites[at].array_read_completion != NoArrayRead) {
            if (!executable && readonly_indexed_byte_reader(views, at)) {
                (views[at] <- make CheckedReadonlyReader {
                    completion <- sites[at].array_read_completion; numeric_fault <- sites[at].numeric_fault
                }):void
            } else {
                finish_byte_function(views, at, sites[at].array_read_completion)
            }
        };
        if (!executable && demand[at].slot_body &&
            !finish_array_slot_body(views, at, sites[at].array_failures)) {
            binding_diagnostic(nodes, result, module_operands_failed(), 1u8, at);
            return false
        }
    };
    return true
}

proc report_product_type_failures(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W, work:const NameWork in W,
    recovery:const ProductTypeRecovery in R, used:UInt64,
    keys:const SourceBytes in G, key_first:UInt64, key_past:UInt64, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, const owner W, const owner R, owner G} {
    val retained <- 0u64;
    val status <- Complete;
    val site <- no_node();
    for (at in 0u64 .. used) {
        if (work[at].product_type_diagnostic != 0u8) {
            if (retained >= recovery.count) return ScratchFailed;
            site <- work[at].product_type_site;
            if (site >= at) return ScratchFailed;
            status <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(),
                work[at].product_type_diagnostic, syntax_first(nodes, used, site), syntax_past(nodes, used, site), no_node(),
                keys, key_first, key_past, run);
            if (status != Complete) return status;
            (retained <- retained + 1u64):void
        }
    };
    if (retained != recovery.count) return ScratchFailed;
    return if (recovery.incomplete) { DiagnosticsIncomplete } else { Complete }
}

proc report_symbol_binder(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W, work:const NameWork in W,
    selections:const CheckedSelections in W, selected_used:UInt64, used:UInt64, revision:UInt64, binder:UInt64,
    catalog:const SourceBytes in B, builtins:const ModuleExports in B,
    keys:const SourceBytes in G, key_used:UInt64, key_first:UInt64, key_past:UInt64,
    visits:const Visits in G, visit_count:UInt64, spellings:const SourceBytes in G, spelling_size:UInt64,
    published:const ModuleExports in G, export_count:UInt64, default_count:UInt64, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, const owner W, const owner B, owner G} {
    if (binder >= used || binder >= intrinsic (len)(work) || key_used > intrinsic (len)(keys) ||
        key_first >= key_past || key_past > key_used || spelling_size > intrinsic (len)(spellings))
        return ScratchFailed;
    const val first <- syntax_first(nodes, used, binder);
    const val past <- syntax_past(nodes, used, binder);
    const val stage <- module_binding_failed();
    const val code <- protected_symbol_name();
    const val declaration <- work[binder].local_symbol_conflict;
    if (declaration != no_node()) {
        ref declared = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
        };
        val shape <- inspect_declaration(nodes, revision, used, declaration, declared);
        if ((shape != NativeSymbolDeclaration && shape != ReferenceSymbolDeclaration) ||
            declared.name >= used || name_syntax(nodes, used, declared.name) != SymbolicName) return ScratchFailed;
        val definition_first <- syntax_first(nodes, used, declared.name);
        val definition_past <- syntax_past(nodes, used, declared.name);
        if (definition_first >= definition_past || definition_past > intrinsic (len)(source)) return ScratchFailed;
        return report_symbol_rejection(source, lines, diagnostic, stage, code, first, past,
            keys, key_first, key_past, keys, key_first, key_past,
            source, definition_first + 1u64, definition_past, run)
    };
    const val selection_row <- work[binder].module_selection;
    if (work[binder].module_kind != symbol_export() ||
        checked_lexical_selection_kind(selections, selected_used, selection_row, revision, used) != symbol_export())
        return ScratchFailed;
    return case selections[selection_row] of {
        SelectedResource { val origin <- defining_module; val identity <-; } -> {{
            if (origin == 0u64) {
                val builtin_row <- defining_symbol_row(builtins, 0u64, intrinsic (len)(builtins), origin,
                    identity, intrinsic (len)(catalog));
                if (builtin_row == no_node()) return ScratchFailed;
                return report_symbol_rejection(source, lines, diagnostic, stage, code, first, past,
                    keys, key_first, key_past, catalog, builtins[builtin_row].module_first, builtins[builtin_row].module_past,
                    catalog, builtins[builtin_row].name_first, builtins[builtin_row].name_past, run)
            };
            ref ranges = make ModuleSelectionRanges {
                exports_first <- 0u64; exports_past <- 0u64; defaults_first <- 0u64; defaults_past <- 0u64
            };
            ref key = make CanonicalKeyRange { first <- 0u64; past <- 0u64 };
            if (!checked_module_selections(visits, visit_count, origin, export_count, default_count, ranges) ||
                !published_module_key(visits, visit_count, key_used, origin, key)) return ScratchFailed;
            val defining_row <- defining_symbol_row(published, ranges.exports_first, ranges.exports_past,
                origin, identity, spelling_size);
            if (defining_row == no_node()) return ScratchFailed;
            return report_symbol_rejection(source, lines, diagnostic, stage, code, first, past,
                keys, key_first, key_past, keys, key.first, key.past,
                spellings, published[defining_row].name_first, published[defining_row].name_past, run)
        }};
        _ -> ScratchFailed
    }
}

proc bind_graph_module(source:const SourceBytes in S, lines:const SourceLines in S,
                       handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W,
                       selected:SelectedExports in W, names:NameBindings in W, work:NameWork in W,
                       staged:ModuleExports in W, export_names:StagedExportNames in W, export_uses:StagedExportUses in W,
                       defaults:StagedDefaultExports in W, checked_selections:CheckedSelections in W,
                       callable_uses:CallableUseProofs in W, object_prefixes:const ObjectPrefixes in W,
                       progress:ModuleProgressRows in W,
                       catalog_spellings:const SourceBytes in B, catalog_exports:const ModuleExports in B,
                       spellings:const SourceBytes in G, published:const ModuleExports in G, spelling_size:UInt64, export_count:UInt64,
                       visits:const Visits in G, visit_count:UInt64, units:const NativeUnitRows in G,
                       published_defaults:const DefaultExportRefs in G, published_default_count:UInt64,
                       staged_interfaces:ModuleInterfaces in W, published_interfaces:const ModuleInterfaces in G, interface_count:UInt64,
                       facts:OperandFacts in W, owners:CallOwners in W, sites:CompletionSites in W,
                       commands:NativeCommands in W, keys:const SourceBytes in G, const val key_first:UInt64,
                       const val key_past:UInt64, const val key_used:UInt64, run:DiagnosticRuns in G) -> CompilerStatus
    where {const owner S, owner D, owner W, const owner B, owner G} {
    val delivered <- Complete;
    ref result = make ModuleBindingResult {
        frontend <- make FrontendResult {
            scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- true; invalid_source <- false; };
            tree <- make ParseResult {
                revision <- progress[0u64].revision; next <- 0u64; used <- progress[0u64].used; root <- progress[0u64].root; diagnostic <- 0u8; supplied_here <- false; case_control <- false;
            reports <- 0u64; lexical_reports <- 0u64; exhausted <- false;
            };
            diagnostic_first <- no_node(); diagnostic_past <- no_node();
        };
        stage <- 0u8; diagnostic <- 0u8; related_first <- no_node(); symbol_binder <- no_node();
        requires_operand_checks <- false;
    };
    val used <- result.frontend.tree.used;
    val revision <- result.frontend.tree.revision;
    val formal <- first_module_variadic_formal(nodes, revision, used);
    val structural <- formal != no_node() || progress[0u64].structural_dependency;
    val native <- !structural && progress[0u64].purpose == (NativeObject:GraphPurpose);
    if (!check_parsed_module_profile(nodes, native, true, result)) {
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
            result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        if (native && rejected_unsupported_declaration(result)) return FormUnsupported;
        return Rejected
    };
    ref selection_report = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node() };
    val checked_used <- 0u64;
    # Callable imports are admitted here for final receiver checking after binding.
    if (!stage_module_selections(source, nodes, result.frontend.tree, selected, catalog_spellings, catalog_exports,
        visits, visit_count, published, export_count, published_defaults, published_default_count, spellings,
        spelling_size, true, checked_selections, checked_used, selection_report) ||
        !project_written_selections(nodes, result.frontend.tree, checked_selections, checked_used,
            selected, selection_report)) {
        binding_diagnostic(nodes, result, module_selection_failed(), selection_report.diagnostic,
            selection_report.node);
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
            result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    if (!project_module_selection_candidates(source, nodes, catalog_spellings, spellings, spelling_size,
        checked_selections, checked_used, result.frontend.tree, work)) {
        delivered <- report_graph_rejection(source, lines, diagnostic, module_selection_failed(), invalid_export_tree(),
            0u64, 0u64, no_node(), keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    ref aggregate_facts = make AggregateFacts(result.frontend.tree.used, UnprovedAggregate);
    ref views = make SuppliedViews(result.frontend.tree.used, make NoSuppliedView {});
    val maximum <- if (run[0u64].limit == 0u64) { no_node() } else {
        run[0u64].limit - run[0u64].retained
    };
    ref recovery = make ProductTypeRecovery {
        maximum <- maximum; count <- 0u64; incomplete <- false; first_diagnostic <- 0u8; first_site <- no_node()
    };
    if (!bind_graph_names(source, nodes, spellings, spelling_size, checked_selections, checked_used,
                          published_interfaces, interface_count, selected, names, work,
                          aggregate_facts, views, result, native, structural, recovery)) {
        if (recovery.count != 0u64) {
            val reported <- report_product_type_failures(source, lines, diagnostic, nodes, work,
                recovery, used, keys, key_first, key_past, run);
            if (reported != Complete) return reported;
            if (result.diagnostic == recovery.first_diagnostic &&
                result.frontend.diagnostic_first == syntax_first(nodes, used, recovery.first_site))
                return Rejected
        };
        if (result.symbol_binder != no_node()) {
            delivered <- report_symbol_binder(source, lines, diagnostic, nodes, work,
                checked_selections, checked_used, used, revision, result.symbol_binder,
                catalog_spellings, catalog_exports, keys, key_used, key_first, key_past,
                visits, visit_count, spellings, spelling_size, published, export_count, published_default_count, run);
            if (delivered != Complete) return delivered;
            return Rejected
        };
        val code <- if (result.stage == module_read_failed()) { result.frontend.tree.diagnostic } else { result.diagnostic };
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, code,
                         result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        if (native && rejected_unsupported_declaration(result)) return FormUnsupported;
        return Rejected;
    } else {};
    val source_call_profile <- if (native) { no_node() } else { first_source_call_profile(views, used) };
    val case_capacity <- if (!native && (source_call_profile != no_node() ||
        needs_constructor_case_plan(nodes, names, selected, used, revision))) { used } else { 0u64 };
    ref cases = make ConstructorCaseFacts(case_capacity, make NoConstructorCase {});
    ref first_case = make UInt64 { source_call_profile };
    if (!native && !prepare_graph_source_operands(source, nodes, names, selected, work,
        spellings, spelling_size, published_interfaces, interface_count, aggregate_facts, cases, views, first_case, result)) {
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
            result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first,
            keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    if (formal != no_node()) {
        locate_variadic_profile(source, lines, progress[0u64].variadic_stop, syntax_past(nodes,
            used, formal))
    };
    if (native) {
        val primitive <- primitive_receiver_namespace(source, nodes, names, work, selected,
            visits, visit_count, used, revision);
        ref problem = make UInt64 { no_node() };
        if (!prepare_object_callables(source, catalog_spellings, spellings, spelling_size,
            checked_selections, checked_used, used, revision,
            progress[0u64].identity, primitive, visits, published, published_interfaces, units,
            object_prefixes, callable_uses, work, problem)) {
            delivered <- report_graph_rejection(source, lines, diagnostic, module_selection_failed(), unproved_import_interpretation(),
                syntax_first(nodes, used, problem), syntax_past(nodes, used, problem), no_node(), keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return Rejected
        };
        (progress[0u64].primitive_namespace <- primitive):void
    };
    val constructed <- first_named_throw(nodes, revision, used);
    val caught_field <- first_caught_field(nodes, names, used, revision);
    val declared <- first_declared_failure(nodes, used, revision);
    val source_helper <- if (native) { no_node() } else {
        first_source_handle_callable(nodes, names, selected, work, used, revision)
    };
    val byte_function <- if (native) { no_node() } else { first_byte_function(views, used) };
    val array_slot_work <- if (native) { no_node() } else { first_array_slot_work(views, used) };
    ref required = make UInt64 { no_node() };
    ref operands = make OperandCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_imported_calls(nodes, names, selected, work, published_interfaces, interface_count,
        catalog_exports, callable_uses, views, aggregate_facts, cases, visits, visit_count, used, revision, !native, required, operands)) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic,
            operands.node);
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
            result.frontend.diagnostic_first,
                         result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    val native_body_evidence <- no_node();
    if (!native) {
        prepare_native_operand_types(source, nodes, names, selected, work, spellings,
                                     published_interfaces, interface_count, used, revision);
        ref checked = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
        if (!check_module_interfaces(
            nodes, names, selected, published_interfaces, interface_count, work, views,
            progress[0u64].identity, used, revision, native_body_evidence, checked)) {
            delivered <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(), checked.diagnostic,
                             syntax_first(nodes, used, checked.node),
                             syntax_past(nodes, used, checked.node), no_node(), keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return Rejected
        }
    };
    if (constructed != no_node() || caught_field != no_node() ||
        (!native && (first_case != no_node() || declared != no_node() || required != no_node() || source_helper != no_node() ||
                     native_body_evidence != no_node() || byte_function != no_node() || array_slot_work != no_node() ||
                     result.requires_operand_checks))) {
        if (!check_graph_exception_body(source, nodes, selected, names, work, spellings,
            spelling_size,
                                        published_interfaces, interface_count, aggregate_facts,
                                            views, cases, progress[0u64].identity,
                                        constructed, caught_field, native, facts, owners, sites,
                                            result)) {
            delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
                result.frontend.diagnostic_first,
                             result.frontend.diagnostic_past, result.related_first, keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return Rejected;
        };
        if (native) {
            val unsupported <- if (constructed == no_node()) { caught_field } else { constructed };
            delivered <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(), 43u8,
                             syntax_first(nodes, used, unsupported), syntax_past(nodes, used,
                                 unsupported), no_node(), keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return FormUnsupported;
        };
    };
    if (native) {
        val checked_unit <- compile_graph_unit(source, lines, diagnostic, nodes, selected, names,
            work, published_interfaces, interface_count, progress, facts, owners, sites, commands, result, keys, key_first, key_past, run);
        if (checked_unit != Complete) return checked_unit;
    };
    ref publication = make ModulePublication {
        module_identity <- progress[0u64].identity; selection_count <- checked_used;
        graph_spelling_count <- spelling_size
    };
    val count <- 0u64;
    val conflict <- no_node();
    if (!publish_module_exports(source, nodes, names, selected, checked_selections,
        catalog_spellings, spellings, aggregate_facts, publication, used, result.frontend.tree.revision,
        staged, export_names, export_uses, callable_uses, count, conflict)) {
        if (conflict != no_node()) {
            delivered <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(), 75u8,
                             syntax_first(nodes, result.frontend.tree.used, conflict), syntax_past(nodes, result.frontend.tree.used, conflict), no_node(), keys, key_first, key_past, run);
            if (delivered != Complete) return delivered;
            return Rejected;
        } else {};
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    } else {};
    ref interface_report = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
    val interfaces <- if (native) { 0u64 } else {
        publish_interfaces(nodes, names, selected, work, views, used, revision,
                           publication.module_identity, staged_interfaces, interface_report)
    };
    if (interface_report.diagnostic != 0u8) {
        delivered <- report_graph_rejection(source, lines, diagnostic, module_binding_failed(),
            interface_report.diagnostic,
                         syntax_first(nodes, used, interface_report.node),
                         syntax_past(nodes, used, interface_report.node), no_node(), keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    if (interfaces != no_node() && array_slot_work != no_node()) {
        (interfaces <- append_array_slot_interfaces(nodes, names, work, facts, views, staged, count,
            staged_interfaces, publication.module_identity, interfaces, used, revision, operands)):void
    };
    if (interfaces != no_node() && (native || declared != no_node())) {
        val base <- if (native) { (progress[0u64].function_base) } else { no_node() };
        (interfaces <- append_callable_interfaces(nodes, names, work, facts, staged, count, used,
            revision, publication.module_identity,
                                                  base, interfaces, staged_interfaces,
                                                      operands)):void;
    };
    if (operands.diagnostic != 0u8) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic, operands.node);
        delivered <- report_graph_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
            result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first,
            keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    if (!native && interfaces != no_node() && !mark_literal_source_bodies(views, staged, count,
        staged_interfaces, interfaces, publication.module_identity, used)) return ScratchFailed;
    if (native && interfaces != no_node() && primitive_definition_namespace(source, nodes, used, revision)) {
        if (!mark_scalar_bodies(nodes, names, work, facts, used, revision,
            staged_interfaces, interfaces, commands, progress[0u64].command_count)) return ScratchFailed;
    };
    if (interfaces != no_node()) {
        (interfaces <- publish_type_interfaces(nodes, names, selected, work, aggregate_facts, used,
                                               result.frontend.tree.revision, publication.module_identity, interfaces, staged_interfaces)):void;
    } else {};
    if (native && interfaces != no_node()) {
        (interfaces <- publish_callable_views(staged, export_uses, callable_uses, count, export_count,
            publication.module_identity, revision, staged_interfaces, interfaces)):void
    };
    if (interfaces == no_node()) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    } else {};
    val default_count <- 0u64;
    val default_problem <- no_node();
    val default_result <- stage_module_defaults(
        source, nodes, used, result.frontend.tree.revision, staged, export_names,
        catalog_spellings, spellings, spelling_size, staged_interfaces, interfaces,
        published_interfaces, interface_count, publication.module_identity,
        0u64, count, defaults, default_count, default_problem);
    if (default_result == DefaultStorageExhausted) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed
    };
    if (default_result != DefaultsReady) {
        val default_code <- if (default_result == UnknownDefaultName) { missing_module_export() }
            else { if (default_result == WrongDefaultKind) { wrong_export_kind() }
                   else { if (default_result == UnknownDefaultMember) { missing_enum_member() }
                          else { invalid_export_tree() } } };
        delivered <- report_graph_rejection(source, lines, diagnostic, module_selection_failed(), default_code,
                         syntax_first(nodes, used, default_problem),
                         syntax_past(nodes, used, default_problem), no_node(), keys, key_first, key_past, run);
        if (delivered != Complete) return delivered;
        return Rejected
    };
    progress[0u64].count <- count;
    progress[0u64].default_count <- default_count;
    progress[0u64].interface_count <- interfaces;
    return Complete;
}

func write_unit_row(units:NativeUnitRows in G, at:UInt64, command_first:UInt64, command_past:UInt64,
                    literal_first:UInt64, literal_past:UInt64, key_first:UInt64, key_past:UInt64,
                    source_size:UInt64, labels:UInt64, slots:UInt64) -> void where {owner G} {
    units[at].command_first <- command_first;
    units[at].command_past <- command_past;
    units[at].literal_first <- literal_first;
    units[at].literal_past <- literal_past;
    units[at].name_first <- key_first;
    units[at].name_past <- key_past;
    units[at].source_size <- source_size;
    units[at].labels <- labels;
    units[at].slots <- slots;
    return;
}

proc publish_visit(handle opened:SourceRevision in S, progress:const ModuleProgressRows in F,
                   staged:const ModuleExports in F, staged_names:const StagedExportNames in F,
                   staged_defaults:const StagedDefaultExports in F,
                   staged_interfaces:const ModuleInterfaces in F,
                   staged_commands:const NativeCommands in F, visits:Visits in G,
                   ref var exports:ModuleExports in G, ref var defaults:DefaultExportRefs in G,
                   ref var interfaces:ModuleInterfaces in G,
                   ref var spellings:SourceBytes in G, ref var commands:NativeCommands in G,
                   ref var units:NativeUnitRows in G, ref var literals:NativeLiteralRanges in G,
                   export_used:UInt64 in G, default_used:UInt64 in G,
                   interface_used:UInt64 in G, spelling_used:UInt64 in G,
                   command_used:UInt64 in G, unit_used:UInt64 in G, literal_used:UInt64 in G, function_used:UInt64 in G,
                   const val key_first:UInt64, const val key_past:UInt64)
    -> CompilerStatus where {const owner S, const owner F, owner G} {
    const val module <- progress[0u64].identity;
    const val export_count <- progress[0u64].count;
    val default_count <- progress[0u64].default_count;
    const val interface_count <- progress[0u64].interface_count;
    const val command_count <- progress[0u64].command_count;
    const val spelling_first <- spelling_used;
    ref sizes = make PublicationSizes(1u64, make PublicationSize {
        source_bytes <- 0u64; spelling_bytes <- 0u64; literal_bytes <- 0u64; literals <- 0u64;
    });
    val measured <- with_source(opened) (source, lines) => {
        if (!measure_publication(source, staged, staged_names, spelling_first, staged_interfaces, staged_commands,
                                 module, export_count, interface_count, command_count, sizes[0u64]))
            { continue ScratchFailed; };
        continue Complete;
    };
    if (measured != Complete) return measured;

    const val export_first <- export_used;
    val default_first <- default_used;
    const val interface_first <- interface_used;
    const val command_first <- command_used;
    const val literal_first <- literal_used;
    val export_past <- add_span(export_first, 0u64, export_count, no_node());
    val default_past <- add_span(default_first, 0u64, default_count, no_node());
    val interface_past <- add_span(interface_first, 0u64, interface_count, no_node());
    const val literal_start <- add_span(spelling_first, 0u64, sizes[0u64].spelling_bytes, no_node());
    val spelling_past <- add_span(literal_start, 0u64, sizes[0u64].literal_bytes, no_node());
    val command_past <- add_span(command_first, 0u64, command_count, no_node());
    val literal_past <- add_span(literal_first, 0u64, sizes[0u64].literals, no_node());
    val has_commands <- command_count != 0u64;
    val unit_past <- add_span(unit_used, 0u64, if (has_commands) { 1u64 } else { 0u64 }, no_node());
    val function_past <- add_span(progress[0u64].function_base, 0u64, progress[0u64].functions, no_node());
    if (export_past == no_node() || default_past == no_node() ||
        interface_past == no_node() || spelling_past == no_node() ||
        command_past == no_node() || literal_past == no_node() || unit_past == no_node() ||
        function_past == no_node() || module == 0u64) return ScratchFailed;
    reserve_exports(exports, export_first, export_past);
    reserve_defaults(defaults, default_first, default_past);
    reserve_interfaces(interfaces, interface_first, interface_past);
    reserve_keys(spellings, spelling_first, spelling_past);
    reserve_commands(commands, command_first, command_past);
    reserve_literals(literals, literal_first, literal_past);
    reserve_units(units, unit_used, unit_past);
    if (!copy_module_defaults(staged_defaults, staged, module, export_first, export_past,
                              default_count, defaults, default_first, default_past))
        return ScratchFailed;

    with_source(opened) (source, lines) => {
        copy_publication(source, staged, staged_names, staged_interfaces, exports, interfaces, spellings,
                         export_count, interface_count, export_first, interface_first, spelling_first);
        copy_unit_material(source, staged_commands, commands, literals, spellings, command_count,
                           command_first, literal_first, literal_start);
        continue Complete;
    };
    if (has_commands) {
        write_unit_row(units, unit_used, command_first, command_past, literal_first, literal_past, key_first, key_past,
                       sizes[0u64].source_bytes, progress[0u64].labels, progress[0u64].slots);
    };
    ref selections = make ModuleSelectionRanges {
        exports_first <- export_first; exports_past <- export_past;
        defaults_first <- default_first; defaults_past <- default_past
    };
    if (progress[0u64].variadic_stop.first.line != 0u64) {
        if (has_commands || progress[0u64].functions != 0u64 ||
            !mark_structural_only(visits, module - 1u64, selections,
                                  interface_first, interface_past,
                                      progress[0u64].variadic_stop)) return ScratchFailed
    } else {
        ref checked_object:VisitObject = make NoVisitObject {};
        if (has_commands) {
            checked_object = make CompletedVisitObject {
                unit_index <- unit_used; functions_first <- progress[0u64].function_base; functions_past <- function_past
            };
            {}
        };
        if (!mark_checked(visits, module - 1u64, selections, interface_first, interface_past,
            progress[0u64].structural_dependency, progress[0u64].primitive_namespace, checked_object))
            return ScratchFailed
    };
    export_used <- export_past;
    default_used <- default_past;
    interface_used <- interface_past;
    spelling_used <- spelling_past;
    command_used <- command_past;
    unit_used <- unit_past;
    literal_used <- literal_past;
    function_used <- function_past;
    return Complete;
}

data VisitWorkspacePlan {
    plan:ModuleWorkspacePlan;
    source_size:UInt64;
}
array VisitWorkspacePlans[UInt64]:VisitWorkspacePlan;

proc plan_opened_workspace(source:const SourceBytes in S,
                           handle diagnostic:DiagnosticDestination in D, workspaces:VisitWorkspacePlans in F, purpose:GraphPurpose)
    -> CompilerStatus where {const owner S, owner D, owner F} {
    workspaces[0u64].source_size <- intrinsic (len)(source);
    val result <- if (purpose == (NativeObject:GraphPurpose)) { (plan_module_workspace(source, workspaces[0u64].plan)) }
        else { if (plan_module_source(source, workspaces[0u64].plan.source)) { Complete } else { ScratchFailed } };
    if (result == ScratchFailed) { report_scratch_error(diagnostic, 2u32); };
    return result;
}

symbol @followDependency:proc(UInt64) -> UInt8;

proc report_dependency_rejection(source:const SourceBytes in S, lines:const SourceLines in S,
    handle diagnostic:DiagnosticDestination in D, code:UInt8, first:UInt64, past:UInt64, finding:UInt64,
    keys:const SourceBytes in G, key_first:UInt64, key_past:UInt64, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, owner G} {
    if (finding != no_node()) {
        if (!report_dependency_note(source, lines, diagnostic, finding, first, past,
            keys, key_first, key_past)) return ScratchFailed;
    } else {
        if (code == 8u8) {
            report_rejection(source, lines, diagnostic, module_selection_failed(), code, first, past, no_node());
            return ScratchFailed
        };
        if (code != dependency_diagnostics_incomplete() && code != package_issue()) {
            val reported <- report_graph_rejection(source, lines, diagnostic, module_selection_failed(), code,
                first, past, no_node(), keys, key_first, key_past, run);
            if (reported != Complete) return reported
        }
    };
    if (code == dependency_diagnostics_incomplete()) return DiagnosticsIncomplete;
    return if (code == 16u8) { FormUnsupported } else { Rejected }
}

proc reject_dependency(handle opened:SourceRevision in S, handle diagnostic:DiagnosticDestination in D,
    const val code:UInt8, const val first:UInt64, const val past:UInt64, const val finding:UInt64,
    const val owns_finding:bool, keys:const SourceBytes in G, const val key_first:UInt64,
    const val key_past:UInt64, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner S, owner D, owner G} {
    if (code == package_delivery_failure()) return ScratchFailed;
    if (owns_finding) return if (code == package_issue() && finding != no_node()) { Rejected } else { ScratchFailed };
    return with_source(opened) (source, lines) => {
        continue report_dependency_rejection(source, lines, diagnostic, code, first, past,
            finding, keys, key_first, key_past, run)
    }
}

proc visit_open_revision(handle opened:SourceRevision in S, handle path:Path in P,
                         handle entry:PathOwner in A,
                         handle diagnostic:DiagnosticDestination in D, const val purpose:GraphPurpose,
                         builtin_spellings:const SourceBytes in B,
                         builtins:const ModuleExports in B,
                         ref var visits:Visits in G, ref var keys:SourceBytes in G,
                         const used:UInt64 in G, const key_used:UInt64 in G, const next_revision:UInt64 in G,
                         ref var exports:ModuleExports in G,
                             ref var defaults:DefaultExportRefs in G,
                         ref var interfaces:ModuleInterfaces in G,
                         ref var spellings:SourceBytes in G, ref var commands:NativeCommands in G,
                         ref var units:NativeUnitRows in G, ref var literals:NativeLiteralRanges in G,
                         const export_used:UInt64 in G, const default_used:UInt64 in G,
                         const interface_used:UInt64 in G,
                         const spelling_used:UInt64 in G, const command_used:UInt64 in G, const unit_used:UInt64 in G,
                         const literal_used:UInt64 in G, const function_used:UInt64 in G,
                         const package_ready:bool in G, const package_rows:UInt64 in G,
                         const package_bytes:UInt64 in G,
                         ref var package_roots:PackageSourceRoots in G,
                         ref var package_paths:SourceBytes in G,
                         revision:UInt64, id:UInt64, const val key_first:UInt64, const val key_past:UInt64,
                         depth:UInt64, failure:VisitFailure in R, run:DiagnosticRuns in G)
    -> CompilerStatus
    where {const owner S, const owner P, const owner A, owner D, const owner B, owner G, owner R} {
    failure.rejection <- 0u8;
    failure.finding <- no_node();
    ref workspaces = make VisitWorkspacePlans(1u64, make VisitWorkspacePlan {
        plan <- make ModuleWorkspacePlan {
            source <- make ExpressionScratchPlan { token_count <- 0u64; node_capacity <- 0u64; syntax_capacity <- 0u64; };
            commands <- 0u64;
        };
        source_size <- 0u64;
    });
    val planned <- with_source(opened) (source, lines) => {
        continue plan_opened_workspace(source, diagnostic, workspaces, purpose);
    };
    if (planned != Complete) return planned;

    val allocating <- true;
    try {
        val capacity <- workspaces[0u64].plan.source.node_capacity;
        ref tokens = make Tokens(workspaces[0u64].plan.source.token_count, make Token { kind <- 0u8; first <- 0u64; past <- 0u64; delimiter <- make OrdinaryToken {}; });
        ref nodes = make ExprNodes(workspaces[0u64].plan.source.syntax_capacity, make Vacant {});
        ref selected = make SelectedExports(capacity, make SelectedExport {
            checked_resource <- no_node(); selection_site <- no_node(); selection_public_row <- no_node();
            dependency_module <- 0u64; identity <- 0u64; kind <- 0u8; checked <- 0u8;
            origin_module <- 0u64; owner_module <- 0u64; owner_identity <- 0u64; shape <- 0u8;
            enum_head <- no_node(); enum_code <- 0u64;
            sum_head <- no_node(); next_sum_selection <- no_node();
            constructor_selection <- no_node(); constructor_row <- no_node();
        });
        ref names = make NameBindings(capacity, make NameBinding {
            kind <- 0u8; imported_kind <- 0u8; guarded_local <- 0u8; declaration <- no_node();
            module_use <- LexicalName;
            scope <- no_node(); finalizer <- no_node(); guarded_local_link <- no_node(); handle_guard <- no_node();
        });
        ref work = make NameWork(capacity, make NameWorkSlot {
            receiver_import <- NoReceiverCallables;
            native_installation <- no_node();
            case_schema_prepared <- false; declaring_sum <- no_node();
            enclosing_case_arm <- no_node(); arm_case <- no_node();
            sum_loan_formals <- false; array_construction <- false; inline_sum_initializer <- false;
            selected_constructor <- false; selected_aggregate_writer <- no_node();
            product_type_diagnostic <- 0u8; product_type_site <- no_node();
            active <- no_node(); module_selection <- no_node(); module_kind <- 0u8; module_scalar <- 0u8;
            local_symbol_conflict <- no_node();
            next <- no_node(); next_method <- no_node();
            imported_interface <- no_node(); imported_type_module <- 0u64; imported_type_identity <-
                0u64;
            imported_function <- no_node(); imported_owner_argument <- no_node(); imported_failure <- 0u64;
            imported_failure_module <- 0u64;
            imported_kind <- 0u8; imported_callable_kind <- NoCallableKind;
            imported_array_read_completion <- NoArrayRead; imported_numeric_fault <- false;
            imported_reception <- 0u8;
            imported_target_readonly <- 0u8; imported_owner_readonly <- 0u8;
            imported_passes_owner <- 0u8; imported_failure_checked <- 0u8;
            enum_code <- 0u64; enum_members <- no_node(); enum_assertion <- NoEnumAssertion; enum_backing <- 0u8;
            value_module <- 0u64; value_identity <- 0u64; value_kind <- 0u8; expects_here <- 0u8;
        });
        ref facts = make OperandFacts(capacity, make OperandFact {
            kind <- 0u8; reception <- 0u8; checked_exception <- 0u8; identity_module <- 0u64;
                target_readonly <- 0u8; needs_target <- 0u8;
            reaches_constructed_throw <- false; loans_owning_handle <- false; checks_array_bounds <- false;
            array_scalar <- 0u8; array_sum <- no_node(); loans_array_slot <- false; array_slot <- no_node();
            loans_scoped_aggregate <- false; case_receipt <- no_node();
            target_presence <- 0u8; selection <- no_node(); discarded_result <- 0u8; arm_result <- 0u8;
            case_item <- 0u8; case_match <- 0u8; case_body <- 0u8; case_guard <- 0u8; case_resume <- 0u8;
            case_end <- 0u8; case_presence <- 0u8; case_selection <- no_node(); case_context <- no_node();
            case_after_subject <- no_node(); case_discriminator <- 0u8; case_may_be_absent <- 0u8;
            enum_constant <- 0u8; enum_backing <- 0u8; discriminator_code <- 0u64;
            case_excluded_at <- no_node(); case_exclusion_member <- no_node(); case_exclusion_previous <- no_node();
            case_exclusion_next <- no_node(); case_exit_link <- no_node(); case_exit_tail <- no_node();
            owner <- no_node(); identity <- 0u64; reservation <- no_node(); product_words <- 0u64; bits_product <- false;
            word_offset <- 0u64; last_initializer <- no_node(); writable_text_place <- 0u8; call_definition <- no_node();
            text_nul <- 0u8; allocation_owner <- no_node(); owner_chain <- no_node(); owner_use_next <- no_node();
            passes_owner <- 0u8; text_assertion <- 0u8; enum_assertion_check <- false; predicate_assertion_check <- false; text_intrinsic <- 0u8;
        });
        ref owners = make CallOwners(capacity, make OwnerEvidence {
            call_site <- no_node(); actual_owner <- no_node(); uses <- 0u64;
        });
        ref sites = make CompletionSites(capacity, make CompletionSite {
            event <- 0u8; presence <- 0u8; can_continue <- 0u8; local_return <- 0u8; retains_caught <- 0u8;
            array_read_completion <- NoArrayRead; numeric_fault <- false; slot_summary <- false; array_failures <- make ByteArrayFailures {
                bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
            };
            forwarded_operand <- 0u8; in_delayed_body <- 0u8; in_supplied_body <- false;
            case_break <- 0u8; case_scan <- 0u8;
            guarded_by <- no_node(); incoming_handler <- no_node(); throws_clause <- no_node(); category <- 0u64;
            category_module <- 0u64;
            destination <- no_node(); cleanup_first <- no_node(); cleanup_stop <- no_node(); registration <- no_node();
            previous_defer <- no_node(); last_defer <- no_node(); replacing_try <- no_node();
        });
        ref staged_commands = make NativeCommands(workspaces[0u64].plan.commands, make NativeCommand {
            opcode <- 0u8; a <- 0u64; b <- 0u64; c <- 0u64; d <- 0u64;
        });
        ref edges = make DependencyEdges(capacity, make DependencyEdge {
            finding <- no_node(); owns_finding <- false;
            site <- 0u64; path <- no_node(); mode <- UseResource;
            first <- 0u64; past <- 0u64; decoded_first <- 0u64; decoded_past <- 0u64;
        });
        ref decoded = make SourceBytes(workspaces[0u64].source_size, 0u8);
        ref progress = make ModuleProgressRows(1u64, make ModuleProgress {
            identity <- id + 1u64; used <- 0u64; root <- no_node(); revision <- revision; dependencies <- 0u64;
            read_rejected <- false;
            count <- 0u64; default_count <- 0u64; interface_count <- 0u64;
            purpose <- purpose; entry <- if (depth == 0u64) { 1u8 } else { 0u8 };
            function_base <- 0u64; functions <- 0u64; command_count <- 0u64; primitive_namespace <- false;
            labels <- 0u64; slots <- 0u64;
            variadic_stop <- make VariadicProfileStop {
                first_byte <- 0u64; past_byte <- 0u64;
                first <- make SourcePosition { line <- 0u64; column <- 0u64; };
                past <- make SourcePosition { line <- 0u64; column <- 0u64; };
            };
            structural_dependency <- false
        });
        allocating <- false;
        const val parse_finding <- run[0u64].retained;
        val parsed <- read_opened_frame(opened, diagnostic, tokens, nodes, selected, edges, decoded,
                                       progress, keys, key_first, key_past, run);
        if (run[0u64].retained > parse_finding) { (failure.finding <- parse_finding):void };
        if (parsed != Complete) return parsed;
        const val child_depth <- depth + 1u64;
        effect @followDependency(edge:UInt64) -> UInt8 {
            return visit_child(path, entry, opened, diagnostic, purpose, builtin_spellings,
                builtins,
                edges, decoded, selected, edge, child_depth, visits, keys, used, key_used,
                next_revision, exports, defaults, interfaces, spellings, commands, units, literals,
                export_used, default_used, interface_used, spelling_used, command_used, unit_used, literal_used,
                function_used, package_ready, package_rows, package_bytes, package_roots,
                package_paths, key_first, key_past, run)
        };
        val edge_code <- 0u8;
        val dependency <- 0u64;
        val rejected <- Complete;
        val outcome <- Complete;
        val edge_finding <- no_node();
        val report_start <- no_node();
        val blocked <- false;
        for (edge in 0u64 .. progress[0u64].dependencies) {
            # A failed path blocks the remaining items before receiver selection.
            if (!blocked || !same_dependency_occurrence(edges, edge)) {
                blocked <- false;
                if (diagnostic_budget_full(run)) return DiagnosticsIncomplete;
                edge_code <- behave @followDependency(edge);
                if (edge_code != 0u8) {
                    report_start <- run[0u64].retained;
                    edge_finding <- edges[edge].finding;
                    outcome <- reject_dependency(opened, diagnostic, edge_code, edges[edge].first, edges[edge].past,
                        edge_finding, edges[edge].owns_finding, keys, key_first, key_past, run);
                    if (failure.finding == no_node()) {
                        if (edge_finding != no_node()) { (failure.finding <- edge_finding):void }
                        else {
                            if (run[0u64].retained > report_start) { (failure.finding <- report_start):void }
                        }
                    };
                    if (outcome == ScratchFailed || outcome == DiagnosticsIncomplete) return outcome;
                    blocked <- edge_finding < run[0u64].retained || run[0u64].retained > report_start;
                    if (rejected == Complete || (rejected == FormUnsupported && outcome != FormUnsupported)) {
                        failure.rejection <- edge_code;
                        (rejected <- outcome):void
                    };
                } else {
                    dependency <- selected[edges[edge].site].dependency_module;
                    if (dependency > used) return ScratchFailed;
                    if (dependency != 0u64 && structural_visit_dependency(visits, dependency - 1u64)) {
                        (progress[0u64].structural_dependency <- true):void
                    }
                }
            };
        };
        if (progress[0u64].read_rejected) return Rejected;
        if (rejected != Complete) return rejected;
        if (diagnostic_budget_full(run)) return DiagnosticsIncomplete;
        if (purpose == (NativeObject:GraphPurpose) &&
            (progress[0u64].used == 0u64 || progress[0u64].used >= no_node() - function_used))
            return ScratchFailed;
        progress[0u64].function_base <- function_used;
        const val export_count <- export_used;
        const val default_count <- default_used;
        const val visit_count <- used;
        const val interface_count <- interface_used;
        const val spelling_size <- spelling_used;
        ref parsed_tree = make ParseResult {
            revision <- progress[0u64].revision; next <- 0u64; used <- progress[0u64].used;
            root <- progress[0u64].root; diagnostic <- 0u8; supplied_here <- false; case_control <- false;
            reports <- 0u64; lexical_reports <- 0u64; exhausted <- false
        };
        ref selection_report = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node() };
        val selection_count <- 0u64;
        if (!measure_module_selections(nodes, parsed_tree, selected, visits, visit_count, exports,
            export_count, defaults, default_count, spelling_size, selection_count, selection_report)) {
            const val problem <- selection_report.node;
            const val code <- selection_report.diagnostic;
            const val first <- syntax_first(nodes, parsed_tree.used, problem);
            const val past <- syntax_past(nodes, parsed_tree.used, problem);
            const val finding <- run[0u64].retained;
            val reported <- with_source(opened) (source, lines) => {
                continue report_graph_rejection(source, lines, diagnostic, module_selection_failed(), code,
                    first, past, no_node(), keys, key_first, key_past, run)
            };
            if (reported != Complete) return reported;
            failure.finding <- finding;
            return Rejected
        };
        const val selection_capacity <- selection_count;
        val written <- measure_written_publications(nodes, parsed_tree.revision, parsed_tree.used);
        if (written == no_node()) return ScratchFailed;
        val publication_capacity <- add_span(written, 0u64, selection_capacity, no_node());
        if (publication_capacity == no_node()) return ScratchFailed;
        val extra_defaults <- measure_default_members(nodes, parsed_tree.used, parsed_tree.revision);
        val default_capacity <- add_span(publication_capacity, 0u64, extra_defaults, no_node());
        if (default_capacity == no_node()) return ScratchFailed;
        val interface_extra <- if (purpose == (NativeObject:GraphPurpose)) { publication_capacity } else { 0u64 };
        val staged_interface_capacity <- add_span(capacity, 0u64, interface_extra, no_node());
        if (staged_interface_capacity == no_node()) return ScratchFailed;
        const val view_capacity <- if (purpose == (NativeObject:GraphPurpose)) { selection_capacity } else { 0u64 };
        ref object_prefixes = make ObjectPrefixes {
            visits <- visit_count; exports <- export_count; interfaces <- interface_count;
            units <- unit_used; commands <- command_used; functions <- function_used
        };
        allocating <- true;
        ref callable_uses = make CallableUseProofs(view_capacity, make UnselectedCallable {});
        ref export_uses = make StagedExportUses(publication_capacity, no_node());
        ref checked_selections = make CheckedSelections(selection_capacity, make UnpublishedSelection {});
        ref staged_interfaces = make ModuleInterfaces(staged_interface_capacity, make ModuleInterfaceRow {
            defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
            interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
            type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
            target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
            failure_module <- 0u64; failure_identity <- 0u64; name_first <- 0u64; name_past <- 0u64;
            enum_code <- 0u64; native_function <- no_node(); callable_kind <- NoCallableKind;
            native_reception <- 0u8;
            native_passes_owner <- 0u8; membership <- UnprovedMembership;
            sum_payload <- make NoSumInterface {}; aggregate_storage <- UnprovedAggregate;
            exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
            scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- NoArrayRead; source_numeric_fault <- false; source_writer <- NoSourceWriter; object_view <- make NoCallableObjectView {};
            array_slot_checked <- false; source_allocates <- false;
            array_slot_failures <- make ByteArrayFailures {
                bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
            }
        });
        ref staged = make ModuleExports(publication_capacity, make ModuleExport {
            module_first <- 0u64; module_past <- 0u64; name_first <- 0u64; name_past <- 0u64;
            identity <- 0u64; kind <- 0u8; checked <- 0u8; publishing_module <- 0u64; origin_module <- 0u64;
            owner_module <- 0u64; owner_identity <- 0u64; shape <- 0u8
        });
        ref export_names = make StagedExportNames(publication_capacity,
            make SourceSpelling { span <- make SourceSpan { first <- 0u64; past <- 0u64 } });
        ref staged_defaults = make StagedDefaultExports(default_capacity, make StagedDefaultExport {
            local_row <- no_node(); nature <- OrdinaryResource;
            members <- make DefaultMemberRange {
                first_ordinal <- 0u64; past_ordinal <- 0u64; first_byte <- 0u64; past_byte <- 0u64
            }
        });
        allocating <- false;
        const val binding_finding <- run[0u64].retained;
        const val diagnostic_key_used <- key_used;
        val bound <- with_source(opened) (source, lines) => {
            continue bind_graph_module(source, lines, diagnostic, nodes, selected, names, work,
                staged, export_names, export_uses, staged_defaults, checked_selections,
                callable_uses, object_prefixes, progress, builtin_spellings, builtins, spellings, exports,
                spelling_size, export_count, visits, visit_count, units, defaults, default_count,
                staged_interfaces, interfaces, interface_count,
                facts, owners, sites, staged_commands, keys, key_first, key_past, diagnostic_key_used, run)
        };
        if (bound != Complete) {
            if (run[0u64].retained > binding_finding) { (failure.finding <- binding_finding):void };
            return bound
        };
        return publish_visit(opened, progress, staged, export_names, staged_defaults, staged_interfaces,
            staged_commands,
            visits, exports, defaults, interfaces, spellings, commands, units, literals,
                export_used,
            default_used, interface_used, spelling_used, command_used, unit_used, literal_used,
            function_used, key_first, key_past)
    } catch (error:const OutOfMemoryError) {
        if (!allocating) { throw; };
        report_scratch_error(diagnostic, 3u32);
        return ScratchFailed;
    }
}

func rejected_after(delivered:CompilerStatus) -> CompilerStatus {
    return if (delivered == Complete) { Rejected } else { delivered }
}

export proc complete_graph_profile(handle diagnostic:DiagnosticDestination in D,
    visits:const Visits in G,
                                   keys:const SourceBytes in G, used:UInt64, key_used:UInt64,
                                   interface_used:UInt64, run:DiagnosticRuns in G) -> CompilerStatus where {owner D,
                                       owner G} {
    ref stopped = make UInt64 { no_node() };
    if (!earliest_profile_stop(visits, used, key_used, interface_used,
        stopped)) return ScratchFailed;
    if (stopped == no_node()) return Complete;
    ref unrelated = make SourcePosition { line <- 0u64; column <- 0u64 };
    return case visits[stopped] of {
        (StructuralOnly { val first <- key_first; val past <- key_past; val pending <- stop; }) -> {
            rejected_after(report_stored_rejection(diagnostic, module_binding_failed(), 130u8, pending.first,
                pending.past, unrelated, keys, first, past, run))
        };
        _ -> ScratchFailed
    }
}

export proc compile_graph(handle input:Path in A, handle diagnostic:DiagnosticDestination in D, purpose:GraphPurpose,
                          builtin_spellings:const SourceBytes in B, builtins:const ModuleExports in B,
                          ref var visits:Visits in G, ref var keys:SourceBytes in G,
                          used:UInt64 in G, key_used:UInt64 in G, next_revision:UInt64 in G,
                          ref var exports:ModuleExports in G,
                              ref var defaults:DefaultExportRefs in G,
                          ref var interfaces:ModuleInterfaces in G,
                          ref var spellings:SourceBytes in G, ref var commands:NativeCommands in G,
                          ref var units:NativeUnitRows in G, ref var literals:NativeLiteralRanges in G,
                          export_used:UInt64 in G, default_used:UInt64 in G, interface_used:UInt64 in G, spelling_used:UInt64 in G,
                          command_used:UInt64 in G, unit_used:UInt64 in G, literal_used:UInt64 in G,
                          function_used:UInt64 in G, package_ready:bool in G,
                          package_rows:UInt64 in G, package_bytes:UInt64 in G, run:DiagnosticRuns in G)
    -> CompilerStatus where {const owner A, owner D, const owner B, owner G} {
    try {
        own handle opened:SourceRevision <- make own handle SourceRevision(input);
        own handle canonical:PathOwner <- make own handle PathOwner();
        val prepared <- prepare_root(canonical, input);
        if (prepared != 0u64) {
            report_source_open_error(diagnostic, prepared);
            return SourceOpenFailed;
        };
        handle path:Path = make handle Path() in canonical;
        ref key = make KeyLookup { id <- 0u64; length <- 0u64; };
        lookup_path(canonical, visits, keys, used, key);
        val revision <- next_revision;
        val first <- key_used;
        val root <- used;
        if (key.id != root || insert_visit(canonical, key.length, visits, keys, used, key_used, next_revision) != Complete)
            return ScratchFailed;
        ref package_roots = make PackageSourceRoots(0u64, make PackageSourceRoot {
            path_first <- 0u64; path_past <- 0u64;
        }) in G;
        ref package_paths = make SourceBytes(0u64, 0u8) in G;
        ref failure = make VisitFailure { rejection <- 0u8; finding <- no_node() };
        return visit_open_revision(opened, path, canonical, diagnostic, purpose, builtin_spellings,
            builtins,
                                   visits, keys, used, key_used, next_revision, exports, defaults, interfaces, spellings,
                                   commands, units, literals, export_used, default_used, interface_used, spelling_used,
                                   command_used, unit_used, literal_used, function_used,
                                   package_ready, package_rows, package_bytes, package_roots,
                                   package_paths, revision, root, first, key_used, 0u64, failure, run)
    } catch (error:const SourceOpenException) {
        report_source_open_error(diagnostic, error.os_error);
        return SourceOpenFailed;
    } catch (error:const PathStorageException) {
        report_scratch_error(diagnostic, 3u32);
        return ScratchFailed;
    } catch (error:const PathNotReadyException) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    }
}

proc visit_child(handle parent_path:Path in P, handle entry:PathOwner in A,
                 handle importing:SourceRevision in S,
                 handle diagnostic:DiagnosticDestination in D, purpose:GraphPurpose,
                 builtin_spellings:const SourceBytes in B, builtins:const ModuleExports in B,
                 edges:DependencyEdges in F, decoded:const SourceBytes in F, selected:SelectedExports in F,
                 edge:UInt64, depth:UInt64,
                 ref var visits:Visits in G, ref var keys:SourceBytes in G,
                 used:UInt64 in G, key_used:UInt64 in G, next_revision:UInt64 in G,
                 ref var exports:ModuleExports in G, ref var defaults:DefaultExportRefs in G,
                 ref var interfaces:ModuleInterfaces in G,
                 ref var spellings:SourceBytes in G, ref var commands:NativeCommands in G,
                 ref var units:NativeUnitRows in G, ref var literals:NativeLiteralRanges in G,
                 export_used:UInt64 in G, default_used:UInt64 in G, interface_used:UInt64 in G, spelling_used:UInt64 in G, command_used:UInt64 in G,
                 unit_used:UInt64 in G, literal_used:UInt64 in G, function_used:UInt64 in G,
                 package_ready:bool in G, package_rows:UInt64 in G, package_bytes:UInt64 in G,
                 ref var package_roots:PackageSourceRoots in G,
                 ref var package_paths:SourceBytes in G, import_first:UInt64, import_past:UInt64,
                     run:DiagnosticRuns in G)
    -> UInt8 where {const owner P, const owner A, const owner S, owner D, const owner B, owner F,
        owner G} {
    val first <- edges[edge].decoded_first;
    val past <- edges[edge].decoded_past;
    if (past == no_node()) return 1u8;
    try {
        own handle owner_path:PathOwner <- make own handle PathOwner();
        val kind <- classify_module_path(decoded, first, past);
        if (kind == SourceRelative) {
            ref spelling = make SourceBytes(past - first, 0u8);
            copy_span(decoded, first, past, spelling, 0u64);
            if (prepare_child(owner_path, parent_path, spelling, past - first) != 0u64) return 1u8
        } else {
            ref request = make PackageEdge {
                first <- edges[edge].first; past <- edges[edge].past;
                spelling_first <- first; spelling_past <- past;
                importer_first <- import_first; importer_past <- import_past;
            };
            const val previous_input_failure <- run[0u64].package_input_failure;
            val prepared <- if (kind == InvalidPath) {
                report_package_issue(importing, diagnostic, InvalidModulePath, 0u64, keys, decoded, request, run)
            } else {
                prepare_logical_dependency(entry, importing, diagnostic, owner_path, keys, decoded, request,
                    package_ready, package_roots, package_paths, package_rows, package_bytes, run)
            };
            if (prepared != 0u8) {
                if (prepared == package_issue()) {
                    if (kind != InvalidPath && previous_input_failure != no_node()) {
                        if (previous_input_failure >= run[0u64].retained) return package_delivery_failure();
                        (edges[edge].finding <- previous_input_failure):void
                    } else {
                        if (run[0u64].retained == 0u64) return package_delivery_failure();
                        edges[edge].finding <- run[0u64].retained - 1u64;
                        (edges[edge].owns_finding <- true):void
                    }
                };
                return prepared
            }
        };
        ref match_key = make KeyLookup { id <- 0u64; length <- 0u64; };
        lookup_path(owner_path, visits, keys, used, match_key);
        val child_id <- match_key.id;
        ref child_failure = make VisitFailure { rejection <- 0u8; finding <- no_node() };
        if (child_id < used) {
            if (visit_rejection(visits, child_id, child_failure)) {
                edges[edge].finding <- child_failure.finding;
                return child_failure.rejection
            };
            if (!visit_has_membership(visits, child_id)) return 6u8;
        } else {
            if (depth >= 128u64) return 9u8;
            handle child_path:Path = make handle Path() in owner_path;
            own handle child_source:SourceRevision <- make own handle SourceRevision(child_path);
            val revision <- next_revision;
            val key_first <- key_used;
            if (insert_visit(owner_path, match_key.length, visits, keys, used, key_used, next_revision) != Complete)
                return 8u8;
            val compiled <- visit_open_revision(child_source, child_path, entry, diagnostic,
                                               purpose, builtin_spellings, builtins,
                                               visits, keys, used, key_used, next_revision, exports, defaults, interfaces, spellings,
                                               commands, units, literals, export_used, default_used, interface_used, spelling_used,
                                               command_used, unit_used, literal_used, function_used,
                                               package_ready, package_rows, package_bytes,
                                               package_roots, package_paths,
                                               revision, child_id, key_first, key_used, depth, child_failure, run);
            if (compiled != Complete) {
                if (compiled == ScratchFailed) return 8u8;
                edges[edge].finding <- child_failure.finding;
                if (compiled == DiagnosticsIncomplete) return dependency_diagnostics_incomplete();
                if (child_failure.rejection != 6u8 && child_failure.rejection != 9u8 &&
                    child_failure.rejection != package_issue()) {
                    (child_failure.rejection <- if (compiled == FormUnsupported) { 16u8 } else { 7u8 }):void
                };
                if (!mark_failed_visit(visits, child_id, child_failure)) return 8u8;
                return child_failure.rejection
            };
        };
        selected[edges[edge].site].dependency_module <- child_id + 1u64;
        return 0u8;
    } catch (error:const SourceOpenException) {
        return 7u8;
    } catch (error:const PathStorageException) {
        return 8u8;
    } catch (error:const PathNotReadyException) {
        return 1u8;
    }
}
