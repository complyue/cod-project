using "NativeSource.cod" Path;
using "NativeSource.cod" SourceRevision;
using "NativeSource.cod" SourceOpenException;
using "NativeSourceUse.cod" source_use;
using "NativeDiagnostics.cod" DiagnosticDestination;
using "NativeDiagnostics.cod" report_rejection;
using "NativeDiagnostics.cod" report_source_open_error;
using "NativeDiagnostics.cod" report_scratch_error;
using "SourceStorage.cod" SourceBytes;
using "SourceStorage.cod" SourceLines;
using "ParserStorage.cod" Tokens;
using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" no_node;
using "TokenBuffer.cod" ScanResult;
using "ExpressionParser.cod" ParseResult;
using "Frontend.cod" FrontendResult;
using "Frontend.cod" read_module;
using "ModuleExportStorage.cod" ModuleExports;
using "ModuleExports.cod" SelectedExports;
using "ModuleExports.cod" next_module_dependency;
using "ModuleExports.cod" prepare_module_dependencies;
using "ModuleFrontend.cod" ModuleBindingResult;
using "ModuleFrontend.cod" bind_parsed_module;
using "ModuleFrontend.cod" module_read_failed;
using "ModuleFrontend.cod" module_selection_failed;
using "NameResolution.cod" NameBindings;
using "NameResolution.cod" NameWork;
using "NativeDeclarations.cod" ModulePublication;
using "NativeDeclarations.cod" publish_module_exports;
using "Compiler.cod" ExpressionScratchPlan;
using "Compiler.cod" native_complete;
using "Compiler.cod" native_source_rejected;
using "Compiler.cod" native_scratch_failed;
using "ModuleDriver.cod" native_source_open_failed;
using "ModuleDriver.cod" plan_module_source;

data "C" ModuleFrame;

data ModuleProgress {
    identity:u64;
    used:u64;
    root:u64;
    count:u64;
    failed_first:u64;
    failed_past:u64;
}
array ModuleProgressRows[u64]:ModuleProgress;

proc "C" prepare_graph_frame(handle frame:ModuleFrame in W, val tokens:u64, val nodes:u64) -> u8 where {owner W};
proc "C" graph_frame_use(
    here work(ref tokens:Tokens in W, ref nodes:ExprNodes in W, ref selected:SelectedExports in W,
              ref names:NameBindings in W, ref work:NameWork in W, ref staged:ModuleExports in W,
              ref progress:ModuleProgressRows in W, ref spellings:const SourceBytes in W,
              ref published:const ModuleExports in W) -> u8,
    handle frame:ModuleFrame in W) -> u8 where {owner W};
proc "C" remember_graph_dependency(handle frame:ModuleFrame in W, ref source:const SourceBytes in S,
                                    val site:u64, val first:u64, val past:u64) -> u8
    where {owner W, const owner S};
proc "C" follow_graph_dependencies(handle frame:ModuleFrame in W) -> u8 where {owner W};
proc "C" commit_graph_exports(handle frame:ModuleFrame in W, ref source:const SourceBytes in S) -> u8
    where {owner W, const owner S};

proc discover_graph_dependencies(source:const SourceBytes in S, lines:const SourceLines in S,
                                 handle frame:ModuleFrame in W, handle diagnostic:DiagnosticDestination in D,
                                 ref tokens:Tokens in T, ref nodes:ExprNodes in T, ref selected:SelectedExports in T,
                                 ref progress:ModuleProgressRows in T) -> u8
    where {const owner S, owner W, owner D, owner T} {
    ref result = make FrontendResult {
        scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- false; invalid_source <- false; };
        tree <- make ParseResult { next <- 0u64; used <- 0u64; root <- no_node(); diagnostic <- 0u8; };
        diagnostic_first <- no_node(); diagnostic_past <- no_node();
    };
    if (!read_module(source, tokens, nodes, result)) {
        report_rejection(source, lines, diagnostic, module_read_failed(), result.tree.diagnostic,
                         result.diagnostic_first, result.diagnostic_past, no_node());
        return native_source_rejected();
    } else {};
    if (!prepare_module_dependencies(selected, result.tree.used)) {
        report_scratch_error(diagnostic, 1u32);
        return native_scratch_failed();
    } else {};
    progress[0u64].used <- result.tree.used;
    progress[0u64].root <- result.tree.root;
    val site <- next_module_dependency(source, nodes, result.tree.used, 0u64);
    val path <- no_node();
    val status <- 0u8;
    for (unused in 0u64 .. result.tree.used) {
        if (site == no_node()) { return native_complete(); } else {};
        path <- nodes[site].left;
        status <- remember_graph_dependency(frame, source, site, nodes[path].first, nodes[path].past);
        if (status != 0u8) {
            report_rejection(source, lines, diagnostic, module_selection_failed(), status,
                             nodes[path].first, nodes[path].past, no_node());
            return native_source_rejected();
        } else {};
        (site <- next_module_dependency(source, nodes, result.tree.used, site + 1u64)):void;
    };
    return native_complete();
}

proc bind_graph_module(source:const SourceBytes in S, lines:const SourceLines in S,
                       handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W,
                       ref selected:SelectedExports in W, ref names:NameBindings in W, ref work:NameWork in W,
                       ref staged:ModuleExports in W, ref progress:ModuleProgressRows in W,
                       spellings:const SourceBytes in W, published:const ModuleExports in W) -> u8
    where {const owner S, owner D, owner W} {
    ref result = make ModuleBindingResult {
        frontend <- make FrontendResult {
            scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- true; invalid_source <- false; };
            tree <- make ParseResult {
                next <- 0u64; used <- progress[0u64].used; root <- progress[0u64].root; diagnostic <- 0u8;
            };
            diagnostic_first <- no_node(); diagnostic_past <- no_node();
        };
        stage <- 0u8; diagnostic <- 0u8; related_first <- no_node();
    };
    if (!bind_parsed_module(source, nodes, spellings, published, selected, names, work, result)) {
        report_rejection(source, lines, diagnostic, result.stage, result.diagnostic,
                         result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first);
        return native_source_rejected();
    } else {};
    ref publication = make ModulePublication { module_identity <- progress[0u64].identity; source_first <- 0u64; };
    val count <- 0u64;
    if (!publish_module_exports(nodes, names, selected, publication, result.frontend.tree.used, staged, count)) {
        report_scratch_error(diagnostic, 1u32);
        return native_scratch_failed();
    } else {};
    progress[0u64].count <- count;
    return native_complete();
}

proc check_graph_revision(source:const SourceBytes in S, lines:const SourceLines in S,
                          handle frame:ModuleFrame in W, handle diagnostic:DiagnosticDestination in D) -> u8
    where {const owner S, owner W, owner D} {
    ref plan = make ExpressionScratchPlan {
        token_count <- 0u64; node_capacity <- 0u64; diagnostic <- 0u8;
        diagnostic_first <- no_node(); diagnostic_past <- no_node();
    };
    if (!plan_module_source(source, plan)) {
        report_rejection(source, lines, diagnostic, module_read_failed(), plan.diagnostic,
                         plan.diagnostic_first, plan.diagnostic_past, no_node());
        return native_source_rejected();
    } else {};
    val prepared <- prepare_graph_frame(frame, plan.token_count, plan.node_capacity);
    if (prepared != 0u8) {
        report_scratch_error(diagnostic, prepared);
        return native_scratch_failed();
    } else {};
    val parsed <- graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published) => {
        continue discover_graph_dependencies(source, lines, frame, diagnostic, tokens, nodes, selected, progress);
    };
    if (parsed != native_complete()) { return parsed; } else {};
    val followed:const u8 <- follow_graph_dependencies(frame);
    if (followed != 0u8) {
        return graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published) => {
            report_rejection(source, lines, diagnostic, module_selection_failed(), followed,
                             progress[0u64].failed_first, progress[0u64].failed_past, no_node());
            continue native_source_rejected();
        };
    } else {};
    val checked <- graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published) => {
        continue bind_graph_module(source, lines, diagnostic, nodes, selected, names, work,
                                   staged, progress, spellings, published);
    };
    if (checked != native_complete()) { return checked; } else {};
    val committed <- commit_graph_exports(frame, source);
    if (committed != 0u8) {
        report_scratch_error(diagnostic, committed);
        return native_scratch_failed();
    } else {};
    return native_complete();
}

proc "C" check_graph_module(handle input:Path in A, handle frame:ModuleFrame in W,
                             handle diagnostic:DiagnosticDestination in D) -> u8
    where {const owner A, owner W, owner D} {
    try {
        own handle revision:SourceRevision <- make own handle SourceRevision(input);
        return source_use(revision) (source, lines) => {
            continue check_graph_revision(source, lines, frame, diagnostic);
        };
    } catch (error:SourceOpenException) {
        report_source_open_error(diagnostic, error.os_error);
        return native_source_open_failed();
    }
}

export check_graph_module;
