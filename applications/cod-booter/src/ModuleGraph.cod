using "NativeSource.cod" { Path, SourceRevision, SourceOpenException };
using "NativeSourceUse.cod" source_use;
using "NativeDiagnostics.cod" {
    DiagnosticDestination, report_rejection, report_source_open_error, report_scratch_error,
};
using "SourceStorage.cod" { SourceBytes, SourceLines };
using "ParserStorage.cod" {
    Tokens, ExprNodes, no_node, callable_node, data_record_node, enum_declaration_node,
    export_node, export_from_node, local_module_selection,
};
using "TokenBuffer.cod" ScanResult;
using "ExpressionParser.cod" ParseResult;
using "Frontend.cod" { FrontendResult, read_module };
using "ModuleExportStorage.cod" { ModuleExports, ModuleInterfaces };
using "ModuleExports.cod" {
    SelectedExports, next_module_dependency, prepare_module_dependencies, ExportResolutionResult, resolve_enum_selections,
};
using "ModuleFrontend.cod" {
    ModuleBindingResult, select_parsed_module, bind_selected_module, module_read_failed, module_binding_failed,
    module_selection_failed, module_operands_failed, binding_diagnostic, rejected_unsupported_declaration,
};
using "NameResolution.cod" { NameBindings, NameWork, first_item };
using "NativeDeclarations.cod" {
    ModulePublication, NativeDeclarationResult, prepare_module_calls, check_module_interfaces, publish_interfaces,
    publish_module_exports,
};
using "DeclarationTypes.cod" { prepare_native_operand_types, publish_type_interfaces, DeclaredExpressionResult, check_declared_expressions };
using "Compiler.cod" ExpressionScratchPlan;
using "ModuleDriver.cod" { plan_module_workspace, ModuleWorkspacePlan };
using "OperandChecking.cod" { OperandFacts, CallOwners, OperandCheckResult, prepare_imported_calls, publish_native_interfaces };
using "CompletionChecking.cod" CompletionSites;
using "ModuleCompiler.cod" compile_bound_commands;
using "NativeCommands.cod" { NativeCommands, NativePlan };
using "ModuleLowering.cod" native_unsupported;
using "NativeScratch.cod" ScratchOpenException;
using "NativeLLVM.cod" LLVMSession;
using "CompilerStatus.cod" CompilerStatus { Complete, Rejected, FormUnsupported, LoweringFailed, ScratchFailed, SourceOpenFailed };

handle type ModuleFrame;
export handle type NativeGraph;

proc "C" NativeGraph() throws ScratchOpenException;
export proc "C" collect_native_graph(handle graph:NativeGraph in G, handle input:Path in A,
                                     handle diagnostic:DiagnosticDestination in D, spellings:const SourceBytes in B,
                                     exports:const ModuleExports in B) -> CompilerStatus
    where {owner G, const owner A, owner D, const owner B};
export proc "C" construct_native_graph(handle graph:NativeGraph in G, handle session:LLVMSession in L) -> u8
    where {const owner G, owner L};

data ModuleProgress {
    identity:u64;
    used:u64;
    root:u64;
    count:u64;
    interface_count:u64;
    failed_first:u64;
    failed_past:u64;
    native:u8;
    entry:u8;
    function_base:u64;
    command_count:u64;
    labels:u64;
    slots:u64;
}
array ModuleProgressRows[u64]:ModuleProgress;

proc "C" prepare_graph_frame(handle frame:ModuleFrame in W, val tokens:u64, val nodes:u64, val commands:u64) -> u8 where {owner W};
proc "C" graph_frame_use(
    here work(ref tokens:Tokens in W, ref nodes:ExprNodes in W, ref selected:SelectedExports in W,
              ref names:NameBindings in W, ref work:NameWork in W, ref staged:ModuleExports in W,
              ref progress:ModuleProgressRows in W, ref spellings:const SourceBytes in W,
              ref published:const ModuleExports in W, ref staged_interfaces:ModuleInterfaces in W,
              ref published_interfaces:const ModuleInterfaces in W, ref facts:OperandFacts in W,
              ref owners:CallOwners in W, ref sites:CompletionSites in W, ref commands:NativeCommands in W) -> CompilerStatus,
    handle frame:ModuleFrame in W) -> CompilerStatus where {owner W};
proc "C" remember_graph_dependency(handle frame:ModuleFrame in W, ref source:const SourceBytes in S,
                                    val site:u64, val first:u64, val past:u64) -> u8
    where {owner W, const owner S};
proc "C" follow_graph_dependencies(handle frame:ModuleFrame in W) -> u8 where {owner W};
proc "C" commit_graph_exports(handle frame:ModuleFrame in W, ref source:const SourceBytes in S) -> u8
    where {owner W, const owner S};

proc discover_graph_dependencies(source:const SourceBytes in S, lines:const SourceLines in S,
                                 handle frame:ModuleFrame in W, handle diagnostic:DiagnosticDestination in D,
                                 tokens:Tokens in T, nodes:ExprNodes in T, selected:SelectedExports in T,
                                 progress:ModuleProgressRows in T) -> CompilerStatus
    where {const owner S, owner W, owner D, owner T} {
    ref result = make FrontendResult {
        scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- false; invalid_source <- false; };
        tree <- make ParseResult { next <- 0u64; used <- 0u64; root <- no_node(); diagnostic <- 0u8; supplied_here <- false; case_control <- false; };
        diagnostic_first <- no_node(); diagnostic_past <- no_node();
    };
    if (!read_module(source, tokens, nodes, result)) {
        report_rejection(source, lines, diagnostic, module_read_failed(), result.tree.diagnostic,
                         result.diagnostic_first, result.diagnostic_past, no_node());
        return Rejected;
    } else {};
    if (!prepare_module_dependencies(selected, result.tree.used)) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    } else {};
    progress[0u64].used <- result.tree.used;
    progress[0u64].root <- result.tree.root;
    val site <- next_module_dependency(source, nodes, result.tree.used, 0u64);
    val path <- no_node();
    val status <- 0u8;
    for (unused in 0u64 .. result.tree.used) {
        if (site == no_node()) return Complete;
        path <- nodes[site].left;
        status <- remember_graph_dependency(frame, source, site, nodes[path].first, nodes[path].past);
        if (status != 0u8) {
            report_rejection(source, lines, diagnostic, module_selection_failed(), status,
                             nodes[path].first, nodes[path].past, no_node());
            return Rejected;
        } else {};
        site <- next_module_dependency(source, nodes, result.tree.used, site + 1u64);
    };
    return Complete;
}

func bind_graph_names(source:const SourceBytes in S, nodes:const ExprNodes in W,
                      spellings:const SourceBytes in W, published:const ModuleExports in W,
                      interfaces:const ModuleInterfaces in W, selected:SelectedExports in W,
                      names:NameBindings in W, work:NameWork in W, result:ModuleBindingResult in R, native:bool) -> bool
    where {const owner S, owner W, owner R} {
    if (!select_parsed_module(source, nodes, spellings, published, selected, native, result)) return false;
    ref members = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!resolve_enum_selections(source, nodes, result.frontend.tree.used, spellings, interfaces, selected, members)) {
        binding_diagnostic(nodes, result, module_selection_failed(), members.diagnostic, members.node);
        return false;
    } else {};
    if (!bind_selected_module(source, nodes, selected, names, work, native, result)) return false;
    if (native) return true;
    val used <- result.frontend.tree.used;
    ref checked = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_module_calls(nodes, names, selected, interfaces, work, used, checked)) {
        binding_diagnostic(nodes, result, module_binding_failed(), checked.diagnostic, checked.node);
        return false;
    } else {};
    ref expressions = make DeclaredExpressionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_declared_expressions(source, nodes, names, selected, work, spellings, interfaces, used, expressions)) {
        binding_diagnostic(nodes, result, module_binding_failed(), expressions.diagnostic, expressions.node);
        return false;
    } else {};
    return true;
}

func first_library_initialization(nodes:const ExprNodes in N, work:const NameWork in W, root:u64) -> u64
    where {const owner N, const owner W} {
    val item <- first_item(nodes, nodes[root].left);
    val kind <- 0u8;
    for (unused in 0u64 .. root) {
        if (item == no_node()) return no_node();
        kind <- nodes[nodes[item].right].kind;
        if (!local_module_selection(kind) && kind != callable_node() && kind != data_record_node() &&
            kind != enum_declaration_node() && kind != export_node() && kind != export_from_node())
            return nodes[item].right;
        item <- work[item].next;
    };
    return no_node();
}

proc compile_graph_unit(source:const SourceBytes in S, lines:const SourceLines in S,
                        handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W,
                        selected:const SelectedExports in W, names:const NameBindings in W, work:NameWork in W,
                        progress:ModuleProgressRows in W, contracts:const ModuleInterfaces in W,
                        facts:OperandFacts in W, owners:CallOwners in W, sites:CompletionSites in W,
                        commands:NativeCommands in W, result:ModuleBindingResult in R) -> CompilerStatus
    where {const owner S, owner D, owner W, owner R} {
    if (progress[0u64].entry == 0u8) {
        val initializer <- first_library_initialization(nodes, work, progress[0u64].root);
        if (initializer != no_node()) {
            report_rejection(source, lines, diagnostic, module_binding_failed(), 111u8,
                             nodes[initializer].first, nodes[initializer].past, no_node());
            return FormUnsupported;
        };
    };
    ref operands = make OperandCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!prepare_imported_calls(nodes, names, selected, work, contracts, progress[0u64].used, operands)) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic, operands.node);
        report_rejection(source, lines, diagnostic, result.stage, result.diagnostic, result.frontend.diagnostic_first,
                         result.frontend.diagnostic_past, result.related_first);
        return Rejected;
    };
    ref plan = make NativePlan {
        used <- 0u64; functions <- 0u64; function_base <- 0u64; labels <- 0u64; slots <- 0u64; diagnostic <- 0u8; node <- no_node();
    };
    if (!compile_bound_commands(source, nodes, selected, names, work, facts, owners, sites, commands,
                                 plan, result, progress[0u64].function_base, progress[0u64].entry != 0u8)) {
        if (result.stage != 0u8) {
            report_rejection(source, lines, diagnostic, result.stage, result.diagnostic, result.frontend.diagnostic_first,
                             result.frontend.diagnostic_past, result.related_first);
            if (rejected_unsupported_declaration(result)) return FormUnsupported;
            return Rejected;
        };
        val first <- if (plan.node == no_node()) { no_node() } else { (nodes[plan.node].first) };
        val past <- if (plan.node == no_node()) { no_node() } else { (nodes[plan.node].past) };
        report_rejection(source, lines, diagnostic, 0u8, plan.diagnostic, first, past, no_node());
        if (plan.diagnostic == native_unsupported()) return FormUnsupported;
        return LoweringFailed;
    };
    progress[0u64].command_count <- plan.used;
    progress[0u64].labels <- plan.labels;
    progress[0u64].slots <- plan.slots;
    return Complete;
}

proc bind_graph_module(source:const SourceBytes in S, lines:const SourceLines in S,
                       handle diagnostic:DiagnosticDestination in D, nodes:const ExprNodes in W,
                       selected:SelectedExports in W, names:NameBindings in W, work:NameWork in W,
                       staged:ModuleExports in W, progress:ModuleProgressRows in W,
                       spellings:const SourceBytes in W, published:const ModuleExports in W,
                       staged_interfaces:ModuleInterfaces in W, published_interfaces:const ModuleInterfaces in W,
                       facts:OperandFacts in W, owners:CallOwners in W, sites:CompletionSites in W,
                       commands:NativeCommands in W) -> CompilerStatus
    where {const owner S, owner D, owner W} {
    ref result = make ModuleBindingResult {
        frontend <- make FrontendResult {
            scan <- make ScanResult { used <- 0u64; next <- 0u64; complete <- true; invalid_source <- false; };
            tree <- make ParseResult {
                next <- 0u64; used <- progress[0u64].used; root <- progress[0u64].root; diagnostic <- 0u8; supplied_here <- false; case_control <- false;
            };
            diagnostic_first <- no_node(); diagnostic_past <- no_node();
        };
        stage <- 0u8; diagnostic <- 0u8; related_first <- no_node();
    };
    val native <- progress[0u64].native != 0u8;
    if (!bind_graph_names(source, nodes, spellings, published, published_interfaces, selected, names, work, result, native)) {
        val code <- if (result.stage == module_read_failed()) { result.frontend.tree.diagnostic } else { result.diagnostic };
        report_rejection(source, lines, diagnostic, result.stage, code,
                         result.frontend.diagnostic_first, result.frontend.diagnostic_past, result.related_first);
        if (native && rejected_unsupported_declaration(result)) return FormUnsupported;
        return Rejected;
    } else {};
    val used <- result.frontend.tree.used;
    if (native) {
        val checked_unit <- compile_graph_unit(source, lines, diagnostic, nodes, selected, names, work, progress,
                                               published_interfaces, facts, owners, sites, commands, result);
        if (checked_unit != Complete) return checked_unit;
    } else {
        prepare_native_operand_types(source, nodes, names, selected, work, spellings, published_interfaces, used);
        ref checked = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
        if (!check_module_interfaces(nodes, names, selected, published_interfaces, work, used, checked)) {
            report_rejection(source, lines, diagnostic, module_binding_failed(), checked.diagnostic,
                             nodes[checked.node].first, nodes[checked.node].past, no_node());
            return Rejected;
        };
    };
    ref publication = make ModulePublication { module_identity <- progress[0u64].identity; source_first <- 0u64; };
    val count <- 0u64;
    val conflict <- no_node();
    if (!publish_module_exports(source, nodes, names, selected, publication, used, staged, count, conflict)) {
        if (conflict != no_node()) {
            report_rejection(source, lines, diagnostic, module_binding_failed(), 75u8,
                             nodes[conflict].first, nodes[conflict].past, no_node());
            return Rejected;
        } else {};
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    } else {};
    val interfaces <- if (native) {
        publish_native_interfaces(nodes, names, work, facts, used, publication.module_identity,
                                  progress[0u64].function_base, staged_interfaces)
    } else { publish_interfaces(nodes, names, selected, work, used, publication.module_identity, staged_interfaces) };
    if (!native && interfaces != no_node()) {
        (interfaces <- publish_type_interfaces(nodes, names, selected, work, used, publication.module_identity,
                                               interfaces, staged_interfaces)):void;
    } else {};
    if (interfaces == no_node()) {
        report_scratch_error(diagnostic, 1u32);
        return ScratchFailed;
    } else {};
    progress[0u64].count <- count;
    progress[0u64].interface_count <- interfaces;
    return Complete;
}

proc check_graph_revision(source:const SourceBytes in S, lines:const SourceLines in S,
                          handle frame:ModuleFrame in W, handle diagnostic:DiagnosticDestination in D) -> CompilerStatus
    where {const owner S, owner W, owner D} {
    ref plan = make ModuleWorkspacePlan {
        source <- make ExpressionScratchPlan {
            token_count <- 0u64; node_capacity <- 0u64; diagnostic <- 0u8;
            diagnostic_first <- no_node(); diagnostic_past <- no_node();
        };
        commands <- 0u64;
    };
    val planned <- plan_module_workspace(source, plan);
    if (planned != Complete) {
        if (plan.source.diagnostic != 0u8) {
            report_rejection(source, lines, diagnostic, module_read_failed(), plan.source.diagnostic,
                             plan.source.diagnostic_first, plan.source.diagnostic_past, no_node());
        };
        return planned;
    } else {};
    val prepared <- prepare_graph_frame(frame, plan.source.token_count, plan.source.node_capacity, plan.commands);
    if (prepared != 0u8) {
        report_scratch_error(diagnostic, prepared);
        return ScratchFailed;
    } else {};
    val parsed <- graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published, interfaces, contracts,
                                         facts, owners, sites, commands) => {
        continue discover_graph_dependencies(source, lines, frame, diagnostic, tokens, nodes, selected, progress);
    };
    if (parsed != Complete) return parsed;
    val followed:const u8 <- follow_graph_dependencies(frame);
    if (followed != 0u8)
        return graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published, interfaces, contracts,
                                       facts, owners, sites, commands) => {
            report_rejection(source, lines, diagnostic, module_selection_failed(), followed,
                             progress[0u64].failed_first, progress[0u64].failed_past, no_node());
            continue if (followed == 16u8) { FormUnsupported } else { Rejected };
        };
    val checked <- graph_frame_use(frame) (tokens, nodes, selected, names, work, staged, progress, spellings, published, interfaces, contracts,
                                          facts, owners, sites, commands) => {
        continue bind_graph_module(source, lines, diagnostic, nodes, selected, names, work,
                                   staged, progress, spellings, published, interfaces, contracts, facts, owners, sites, commands);
    };
    if (checked != Complete) return checked;
    val committed <- commit_graph_exports(frame, source);
    if (committed != 0u8) {
        report_scratch_error(diagnostic, committed);
        return ScratchFailed;
    } else {};
    return Complete;
}

export proc "C" check_graph_module(handle input:Path in A, handle frame:ModuleFrame in W,
                                    handle diagnostic:DiagnosticDestination in D) -> CompilerStatus
    where {const owner A, owner W, owner D} {
    try {
        own handle revision:SourceRevision <- make own handle SourceRevision(input);
        return source_use(revision) (source, lines) => {
            continue check_graph_revision(source, lines, frame, diagnostic);
        };
    } catch (error:SourceOpenException) {
        report_source_open_error(diagnostic, error.os_error);
        return SourceOpenFailed;
    }
}
