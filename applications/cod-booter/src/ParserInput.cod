using "Lexer.cod" {
    const_word, exception_word, identifier, in_word, lexical_error, not_word, own_word, punctuation,
    reserved_lexical_binder, reserved_module_name,
};
using "ParserStorage.cod" {
    ExprNodes, ExprNode, ExprPayload, SourceSpan, NodeId, Tokens, len, no_node, syntax_first, syntax_past, parse_report_code,
};
using "ParserStorage.cod" NodeLink { NoLink, LinkTo };
using "ParserStorage.cod" ExprPayload { NameReference, ModuleSyntax, ModuleItem, BlockSyntax, ScopeSyntax, BlockItem, AnnotatedBinding, OwnerQualifiedType };
using "ParserStorage.cod" AstSlot { Occupied };
using "ParserStorage.cod" { SyntaxRole { InitializerRole, ExpressionRole, BlockItemRole }, ExprPayload { ParseReport, ErrorReport } };
using "SourceStorage.cod" { SourceBytes, DelimiterLink { MatchedDelimiter } };

export data ParseResult {
    revision:u64;
    next:u64;
    used:u64;
    root:u64;
    diagnostic:u8;
    supplied_here:bool;
    case_control:bool;
    reports:u64;
    lexical_reports:u64;
    exhausted:bool;
}

export func node_storage_exhausted() -> u8 { return 5u8; }

export func expected_name() -> u8 { return 19u8; }

export func expected_type() -> u8 { return 20u8; }

export func expected_c_linkage() -> u8 { return 29u8; }

export func punct_at(source:const SourceBytes in S, tokens:const Tokens in T,
                     at:u64, past:u64) -> u8 where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) return 0u8;
    val first <- tokens[at].first;
    if (tokens[at].past - first != 1u64) return 0u8;
    return source[first];
}

export func punct_pair_at(source:const SourceBytes in S, tokens:const Tokens in T,
                          at:u64, past:u64, left:u8, right:u8) -> bool
    where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) return false;
    val first <- tokens[at].first;
    return tokens[at].past - first == 2u64 && source[first] == left && source[first + 1u64] == right;
}

export func closing_token(tokens:const Tokens in T, opening:u64, past:u64) -> u64 where {const owner T} {
    if (opening >= past || past >= len(tokens)) return no_node();
    return case tokens[opening].delimiter of {
        (MatchedDelimiter { val close <- closing; }) -> {
            if (close <= opening || close >= past) return no_node();
            close
        };
        _ -> no_node()
    }
}

export func append_syntax_node(nodes:ExprNodes in A, result:ParseResult in R,
                               first:u64, past:u64, payload:const ExprPayload in P) -> void
    where {owner A, owner R, const owner P} {
    val id <- result.used;
    if (id >= len(nodes)) {
        result.exhausted <- true;
        result.diagnostic <- node_storage_exhausted();
        return
    };
    nodes[id] <- make Occupied {
        node <- make ExprNode {
            span <- make SourceSpan { first <- first; past <- past; };
            payload <- payload;
        };
    };
    result.root <- id;
    result.used <- id + 1u64;
    return;
}

export func append_qualified_type(nodes:ExprNodes in A, result:ParseResult in R,
                                  target:u64, owner_name:u64, anchor:u64) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, target), syntax_past(nodes, result.used, owner_name),
                       make OwnerQualifiedType {
        target <- make NodeId { revision <- result.revision; index <- target; };
        declared_owner <- make NodeId { revision <- result.revision; index <- owner_name; };
        anchor <- anchor;
    });
}

export func append_block_item(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                              preceding:u64, expression:u64) -> void where {owner A, owner R} {
    ref previous = make NoLink {};
    if (preceding != no_node()) {
        previous = make LinkTo { node <- make NodeId { revision <- result.revision; index <- preceding; }; };
        {};
    };
    append_syntax_node(nodes, result, first, past, make BlockItem {
        previous <- previous;
        expression <- make NodeId { revision <- result.revision; index <- expression; };
    });
}

export func append_block(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                         tail:u64, scoped:bool) -> void where {owner A, owner R} {
    ref items = make NoLink {};
    if (tail != no_node()) {
        items = make LinkTo { node <- make NodeId { revision <- result.revision; index <- tail; }; };
        {};
    };
    if (scoped) {
        append_syntax_node(nodes, result, first, past, make ScopeSyntax { items <- items; });
    } else {
        append_syntax_node(nodes, result, first, past, make BlockSyntax { items <- items; });
    };
}

export func append_module_item(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                               preceding:u64, form:u64, published:bool) -> void where {owner A, owner R} {
    ref previous = make NoLink {};
    if (preceding != no_node()) {
        previous = make LinkTo { node <- make NodeId { revision <- result.revision; index <- preceding; }; };
        {};
    };
    append_syntax_node(nodes, result, first, past, make ModuleItem {
        previous <- previous;
        form <- make NodeId { revision <- result.revision; index <- form; };
        published <- published;
    });
}

export func append_module(nodes:ExprNodes in A, result:ParseResult in R, past:u64, tail:u64) -> void
    where {owner A, owner R} {
    ref items = make NoLink {};
    if (tail != no_node()) {
        items = make LinkTo { node <- make NodeId { revision <- result.revision; index <- tail; }; };
        {};
    };
    append_syntax_node(nodes, result, 0u64, past, make ModuleSyntax { items <- items; });
}

export func parse_identifier(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                             result:ParseResult in R, past:u64, missing:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != identifier() || not_word(source, tokens[at])) {
        result.diagnostic <- missing;
        return false;
    } else {};
    val first <- tokens[at].first;
    append_syntax_node(nodes, result, first, tokens[at].past, make NameReference {});
    if (result.diagnostic != 0u8) return false;
    result.next <- at + 1u64;
    return true;
}

export func exception_binder_width(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (at + 1u64 >= past) return 0u64;
    if (own_word(source, tokens[at]) && exception_word(source, tokens[at + 1u64])) return 2u64;
    if (exception_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        punct_at(source, tokens, at + 2u64, past) == 58u8) return 1u64;
    return 0u64;
}

export func parse_binding_name(source:const SourceBytes in S, tokens:const Tokens in T,
                               nodes:ExprNodes in A, result:ParseResult in R,
                               past:u64, require_type:bool, qualified:bool, field:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (!field && result.next < past && reserved_lexical_binder(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return false;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    if (punct_at(source, tokens, result.next, past) != 58u8) { # ':'
        if (require_type) { result.diagnostic <- expected_type(); return false; } else {};
        return true;
    } else {};
    val name <- result.root;
    val colon <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val readonly <- qualified && result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
    val annotation <- result.root;
    if (result.next < past && in_word(source, tokens[result.next])) {
        val anchor <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        val owner_name <- result.root;
        append_qualified_type(nodes, result, annotation, owner_name, anchor);
        if (result.diagnostic != 0u8) return false;
        (annotation <- result.root):void;
    } else {};
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), syntax_past(nodes, result.used, annotation),
                       make AnnotatedBinding {
        name <- make NodeId { revision <- result.revision; index <- name; };
        annotation <- make NodeId { revision <- result.revision; index <- annotation; };
        readonly <- readonly;
        colon <- colon;
    });
    return result.diagnostic == 0u8;
}

export func reset_parse_result(first:u64, result:ParseResult in R) -> void where {owner R} {
    result.next <- first;
    result.used <- 0u64;
    result.root <- no_node();
    result.diagnostic <- 0u8;
    result.supplied_here <- false;
    result.case_control <- false;
    result.reports <- 0u64;
    result.lexical_reports <- 0u64;
    result.exhausted <- false;
    return;
}

export func parse_module_name(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (result.next < past && reserved_module_name(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return false;
    } else {};
    return parse_identifier(source, tokens, nodes, result, past, expected_name());
}

export func parse_resource_name(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (punct_at(source, tokens, at, past) != 40u8)
        return parse_module_name(source, tokens, nodes, result, past);
    val operator <- at + 1u64;
    val accepted <- punct_pair_at(source, tokens, operator, past, 43u8, 43u8) ||
        punct_pair_at(source, tokens, operator, past, 60u8, 45u8);
    if (!accepted || punct_at(source, tokens, at + 2u64, past) != 41u8) {
        result.diagnostic <- expected_name();
        return false;
    } else {};
    val first <- tokens[at + 1u64].first;
    append_syntax_node(nodes, result, first, tokens[at + 1u64].past, make NameReference {});
    result.next <- at + 3u64;
    return result.diagnostic == 0u8;
}

func append_parse_report(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64, code:u8) -> u64
    where {owner A, owner R} {
    result.diagnostic <- 0u8;
    append_syntax_node(nodes, result, first, past, make ParseReport { diagnostic <- code });
    if (result.exhausted) return no_node();
    result.reports <- result.reports + 1u64;
    return result.root
}

export func seed_lexical_reports(tokens:const Tokens in T, nodes:ExprNodes in A,
                                 result:ParseResult in R, first:u64, past:u64) -> bool
    where {const owner T, owner A, owner R} {
    if (first > past || past >= len(tokens)) return false;
    for (at in first .. past) {
        if (lexical_error(tokens[at].kind) &&
            append_parse_report(nodes, result, tokens[at].first, tokens[at].past, tokens[at].kind) == no_node())
            return false
    };
    result.lexical_reports <- result.reports;
    return true
}

func lexical_report_at(nodes:const ExprNodes in A, result:const ParseResult in R, first:u64) -> u64
    where {const owner A, const owner R} {
    val lower <- 0u64;
    val upper <- result.lexical_reports;
    val middle <- 0u64;
    val byte <- 0u64;
    for (step in 0u64 .. 64u64) {
        if (lower >= upper) return no_node();
        middle <- lower + (upper - lower) / 2u64;
        byte <- syntax_first(nodes, result.used, middle);
        if (byte == first) return middle;
        if (byte < first) { (lower <- middle + 1u64):void; } else { (upper <- middle):void; };
    };
    return no_node()
}

func is_recovery_separator(mark:u8, role:SyntaxRole) -> bool {
    if (mark == 59u8 || mark == 125u8) return true;
    return (role == InitializerRole || role == ExpressionRole) &&
           (mark == 44u8 || mark == 41u8 || mark == 93u8)
}

# Skip only groups the source delimiter map proved complete.
func recovery_boundary(source:const SourceBytes in S, tokens:const Tokens in T,
                       first:u64, past:u64, role:SyntaxRole) -> u64 where {const owner S, const owner T} {
    val at <- first;
    val closing <- no_node();
    for (step in first .. past) {
        if (at >= past) return past;
        if (is_recovery_separator(punct_at(source, tokens, at, past), role)) return at;
        closing <- closing_token(tokens, at, past);
        at <- if (closing == no_node()) { at + 1u64 } else { closing + 1u64 }
    };
    return past
}

# A missing separator is a fault of the enclosing list. Preserve its
# completed item and reuse a report already anchored at the offending token.
export func recover_block_separator(source:const SourceBytes in S, tokens:const Tokens in T,
                                    nodes:ExprNodes in A, result:ParseResult in R,
                                    first_new:u64, past:u64, code:u8, keep_current:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (result.exhausted || result.next > past || past >= len(tokens)) return false;
    val first <- tokens[result.next].first;
    val present <- lexical_report_at(nodes, result, first) != no_node();
    for (at in first_new .. result.used) {
        if (parse_report_code(nodes, result.used, at) != 0u8 && syntax_first(nodes, result.used, at) == first) {
            (present <- true):void
        }
    };
    if (!present && append_parse_report(nodes, result, first, tokens[result.next].past, code) == no_node())
        return false;
    if (!keep_current) {
        (result.next <- recovery_boundary(source, tokens, result.next, past, BlockItemRole)):void
    };
    return true
}

export func recover_syntax_until(tokens:const Tokens in T, nodes:ExprNodes in A, result:ParseResult in R,
                                 start:u64, boundary:u64, past:u64, role:SyntaxRole) -> bool
    where {const owner T, owner A, owner R} {
    if (result.exhausted || result.diagnostic == 0u8 || start > boundary || boundary > past || past >= len(tokens))
        return false;
    val failure <- past;
    if (result.next < past) { (failure <- result.next):void; };
    val first <- tokens[failure].first;
    val report <- lexical_report_at(nodes, result, first);
    if (report == no_node()) {
        report <- append_parse_report(nodes, result, first, tokens[failure].past, result.diagnostic);
        if (report == no_node()) return false
    };
    result.next <- boundary;
    result.diagnostic <- 0u8;
    append_syntax_node(nodes, result, tokens[start].first, tokens[result.next].first,
                       make ErrorReport { role <- role; report <- make NodeId { revision <- result.revision; index <- report } });
    return !result.exhausted
}


export func recover_syntax(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R,
                           start:u64, past:u64, role:SyntaxRole) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (result.exhausted || result.diagnostic == 0u8 || start > past || past >= len(tokens)) return false;
    return recover_syntax_until(tokens, nodes, result, start, recovery_boundary(source, tokens, start, past, role), past, role)
}
