# An owner is a lexical scope or an owner parameter's declaration. Exception
# type identity alone does not establish the incoming object's owner.
export data OperandFact {
    kind:UInt8,
    reception:UInt8,
    checked_exception:UInt8,
    identity_module:UInt64,
    loans_owning_handle:bool,
    loans_scoped_aggregate:bool,
    case_receipt:UInt64,
    checks_array_bounds:bool,
    array_scalar:UInt8,
    array_element_module:UInt64,
    array_element_identity:UInt64,
    loans_array_slot:bool,
    array_slot:UInt64,
    target_readonly:UInt8,
    needs_target:UInt8,
    target_presence:UInt8,
    # Only admitted stable pointer holders and their copied selections get an identity.
    selection:UInt64,
    discarded_result:UInt8,
    arm_result:UInt8,
    case_item:UInt8,
    case_match:UInt8,
    case_body:UInt8,
    case_guard:UInt8,
    case_resume:UInt8,
    case_end:UInt8,
    case_presence:UInt8,
    case_selection:UInt64,
    case_context:UInt64,
    case_after_subject:UInt64,
    case_discriminator:UInt8,
    case_may_be_absent:UInt8,
    enum_constant:UInt8,
    enum_backing:UInt8,
    discriminator_code:UInt64,
    case_excluded_at:UInt64,
    case_exclusion_member:UInt64,
    case_exclusion_previous:UInt64,
    case_exclusion_next:UInt64,
    case_exit_link:UInt64,
    case_exit_tail:UInt64,
    owner:UInt64,
    identity:UInt64,
    reservation:UInt64,
    product_words:UInt64,
    bits_product:bool,
    word_offset:UInt64,
    last_initializer:UInt64,
    writable_text_place:UInt8,
    call_definition:UInt64,
    text_nul:UInt8,
    allocation_owner:UInt64,
    owner_chain:UInt64,
    owner_use_next:UInt64,
    passes_owner:UInt8,
    text_assertion:UInt8,
    enum_assertion_check:bool,
    predicate_assertion_check:bool,
    text_intrinsic:UInt8,
    omitted_result:bool,
    statement_operand:bool,
    text_method:UInt64,
    text_call:bool,
}
export array OperandFacts[UInt64]:OperandFact;
export data ScopedTextOutcome { out_of_memory:bool, invalid_slice:bool, numeric_fault:bool, bounds:bool, }
export array ScopedTextOutcomes[UInt64]:ScopedTextOutcome;

export data OwnerEvidence {
    call_site:UInt64,
    actual_owner:UInt64,
    uses:UInt64,
}
export array CallOwners[UInt64]:OwnerEvidence;

export data OperandCheckResult {
    diagnostic:UInt8,
    node:UInt64,
}

export func void_result() -> UInt8 { return 1u8; }
export func scalar_u64() -> UInt8 { return 2u8; }
export func exception_type() -> UInt8 { return 3u8; }
export func null_literal() -> UInt8 { return 4u8; }
export func never_result() -> UInt8 { return 5u8; }
export func scalar_bool() -> UInt8 { return 6u8; }
func scalar_enum() -> UInt8 { return 7u8; }
export func product_kind() -> UInt8 { return 8u8; }
func string_kind() -> UInt8 { return 9u8; }
func c_string_kind() -> UInt8 { return 10u8; }
export func scalar_u8() -> UInt8 { return 11u8; }
func source_array_loan() -> UInt8 { return 12u8 }
func source_handle_loan() -> UInt8 { return 13u8 }
func source_u32() -> UInt8 { return 14u8 }
func source_sum_target() -> UInt8 { return 15u8 }
func received_product() -> UInt8 { return 16u8 }
func received_sum() -> UInt8 { return 17u8 }
func source_product_loan() -> UInt8 { return 18u8 }
export func source_builder_loan() -> UInt8 { return 19u8 }
export func independent_sum_bits() -> UInt8 { return 20u8 }
func independent_product_bits() -> UInt8 { return 21u8 }
func generic_member_loan() -> UInt8 { return 22u8 }
func unproved_generic_body() -> UInt8 { return 167u8 }

func nominal_source_loan(kind:UInt8) -> bool {
    return kind == source_handle_loan() || kind == source_array_loan() || kind == source_product_loan()
}

export func immutable_text_kind(kind:UInt8) -> bool {
    return kind == string_kind() || kind == c_string_kind();
}
func nul_absent() -> UInt8 { return 1u8; }
func nul_present() -> UInt8 { return 2u8; }
func static_text_owner() -> UInt64 { return no_node() - 1u64; }
export func scalar_kind(kind:UInt8) -> bool {
    return kind == scalar_u64() || kind == scalar_bool() || kind == scalar_enum() || kind == scalar_u8();
}

export func independent_value() -> UInt8 { return 1u8; }
export func local_place() -> UInt8 { return 2u8; }
export func borrowed_ref() -> UInt8 { return 3u8; }
export func nullable_ptr() -> UInt8 { return 4u8; }
export func readonly_exception() -> UInt8 { return 6u8; }

export func present_target() -> UInt8 { return 1u8; }
export func absent_target() -> UInt8 { return 2u8; }
export func unknown_target() -> UInt8 { return 3u8; }

export func unproved_operand() -> UInt8 { return 1u8; }
export func wrong_operand_type() -> UInt8 { return 2u8; }
export func expected_exception_type() -> UInt8 { return 3u8; }
export func unproved_result_contract() -> UInt8 { return 4u8; }
export func unproved_owner() -> UInt8 { return 5u8; }
export func incompatible_owner() -> UInt8 { return 6u8; }
export func expected_writable_place() -> UInt8 { return 7u8; }
export func unproved_nonnull_borrow() -> UInt8 { return 8u8; }
export func wrong_argument_count() -> UInt8 { return 9u8; }
export func wrong_return_type() -> UInt8 { return 10u8; }
export func unproved_call_target() -> UInt8 { return 11u8; }
export func operand_storage_exhausted() -> UInt8 { return 12u8; }
export func invalid_operand_tree() -> UInt8 { return 13u8; }
func wrong_finally_result() -> UInt8 { return 14u8; }
func duplicate_catch_category() -> UInt8 { return 15u8; }
func procedure_call_in_function() -> UInt8 { return 16u8; }
func value_tail_in_void_function() -> UInt8 { return 17u8; }
func expected_boolean_condition() -> UInt8 { return 18u8; }
func false_predicate_assertion() -> UInt8 { return 147u8 }
func unproved_reservation_selection() -> UInt8 { return 19u8; }
func unsupported_narrow_execution() -> UInt8 { return 20u8; }
func readonly_owner_argument() -> UInt8 { return 21u8; }
func checked_selection_requires_ref() -> UInt8 { return 22u8; }
export func unsupported_case_subject() -> UInt8 { return 23u8; }
export func unsupported_case_pattern() -> UInt8 { return 24u8; }
func incomplete_value_case() -> UInt8 { return 25u8; }
func unsupported_scalar_assertion() -> UInt8 { return 27u8; }
func missing_enum_member() -> UInt8 { return 28u8; }
func incompatible_enum_type() -> UInt8 { return 29u8; }
export func unsupported_product_layout() -> UInt8 { return 30u8; }
func unknown_product_field() -> UInt8 { return 31u8; }
func repeated_readonly_initializer() -> UInt8 { return 32u8; }
func missing_product_initializer() -> UInt8 { return 33u8; }
func string_operand_required() -> UInt8 { return 34u8; }
func c_string_operand_required() -> UInt8 { return 35u8; }
func interior_literal_nul() -> UInt8 { return 36u8; }
export func unsupported_text_operation() -> UInt8 { return 37u8; }
func wrong_text_result_owner() -> UInt8 { return 38u8; }
