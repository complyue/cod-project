# An owner is a lexical scope or an owner parameter's declaration. Exception
# type identity alone does not establish the incoming object's owner.
export data OperandFact {
    kind:u8;
    reception:u8;
    checked_exception:u8;
    identity_module:u64;
    reaches_constructed_throw:bool;
    loans_owning_handle:bool;
    checks_array_bounds:bool;
    target_readonly:u8;
    needs_target:u8;
    target_presence:u8;
    # Only admitted stable pointer holders and their copied selections get an identity.
    selection:u64;
    discarded_result:u8;
    arm_result:u8;
    case_item:u8;
    case_match:u8;
    case_body:u8;
    case_guard:u8;
    case_resume:u8;
    case_end:u8;
    case_presence:u8;
    case_selection:u64;
    case_context:u64;
    case_after_subject:u64;
    case_discriminator:u8;
    case_may_be_absent:u8;
    enum_constant:u8;
    discriminator_code:u64;
    case_excluded_at:u64;
    case_exclusion_member:u64;
    case_exclusion_previous:u64;
    case_exclusion_next:u64;
    case_exit_link:u64;
    case_exit_tail:u64;
    owner:u64;
    identity:u64;
    reservation:u64;
    product_words:u64;
    word_offset:u64;
    last_initializer:u64;
    writable_text_place:u8;
    call_definition:u64;
    text_nul:u8;
    allocation_owner:u64;
    owner_chain:u64;
    owner_use_next:u64;
    passes_owner:u8;
    text_assertion:u8;
    text_intrinsic:u8;
}
export array OperandFacts[u64]:OperandFact;

export data OwnerEvidence {
    call_site:u64;
    actual_owner:u64;
    uses:u64;
}
export array CallOwners[u64]:OwnerEvidence;

export data OperandCheckResult {
    diagnostic:u8;
    node:u64;
}

export func void_result() -> u8 { return 1u8; }
export func scalar_u64() -> u8 { return 2u8; }
export func exception_type() -> u8 { return 3u8; }
export func null_literal() -> u8 { return 4u8; }
export func never_result() -> u8 { return 5u8; }
func scalar_bool() -> u8 { return 6u8; }
func scalar_enum() -> u8 { return 7u8; }
export func product_kind() -> u8 { return 8u8; }
func string_kind() -> u8 { return 9u8; }
func c_string_kind() -> u8 { return 10u8; }
func scalar_u8() -> u8 { return 11u8; }
func source_array_loan() -> u8 { return 12u8 }
func source_handle_loan() -> u8 { return 13u8 }
func source_u32() -> u8 { return 14u8 }
func source_sum_target() -> u8 { return 15u8 }
func received_product() -> u8 { return 16u8 }

export func immutable_text_kind(kind:u8) -> bool {
    return kind == string_kind() || kind == c_string_kind();
}
func nul_absent() -> u8 { return 1u8; }
func nul_present() -> u8 { return 2u8; }
func static_text_owner() -> u64 { return no_node() - 1u64; }
export func scalar_kind(kind:u8) -> bool {
    return kind == scalar_u64() || kind == scalar_bool() || kind == scalar_enum() || kind == scalar_u8();
}

export func independent_value() -> u8 { return 1u8; }
export func local_place() -> u8 { return 2u8; }
export func borrowed_ref() -> u8 { return 3u8; }
export func nullable_ptr() -> u8 { return 4u8; }
export func readonly_exception() -> u8 { return 6u8; }

export func present_target() -> u8 { return 1u8; }
export func absent_target() -> u8 { return 2u8; }
export func unknown_target() -> u8 { return 3u8; }

export func unproved_operand() -> u8 { return 1u8; }
export func wrong_operand_type() -> u8 { return 2u8; }
export func expected_exception_type() -> u8 { return 3u8; }
export func unproved_result_contract() -> u8 { return 4u8; }
export func unproved_owner() -> u8 { return 5u8; }
export func incompatible_owner() -> u8 { return 6u8; }
export func expected_writable_place() -> u8 { return 7u8; }
export func unproved_nonnull_borrow() -> u8 { return 8u8; }
export func wrong_argument_count() -> u8 { return 9u8; }
export func wrong_return_type() -> u8 { return 10u8; }
export func unproved_call_target() -> u8 { return 11u8; }
export func operand_storage_exhausted() -> u8 { return 12u8; }
export func invalid_operand_tree() -> u8 { return 13u8; }
func wrong_finally_result() -> u8 { return 14u8; }
func duplicate_catch_category() -> u8 { return 15u8; }
func procedure_call_in_function() -> u8 { return 16u8; }
func value_tail_in_void_function() -> u8 { return 17u8; }
func expected_boolean_condition() -> u8 { return 18u8; }
func unproved_reservation_selection() -> u8 { return 19u8; }
func unsupported_narrow_execution() -> u8 { return 20u8; }
func readonly_owner_argument() -> u8 { return 21u8; }
func checked_selection_requires_ref() -> u8 { return 22u8; }
export func unsupported_case_subject() -> u8 { return 23u8; }
export func unsupported_case_pattern() -> u8 { return 24u8; }
func incomplete_value_case() -> u8 { return 25u8; }
func unsupported_scalar_assertion() -> u8 { return 27u8; }
func missing_enum_member() -> u8 { return 28u8; }
func incompatible_enum_type() -> u8 { return 29u8; }
export func unsupported_product_layout() -> u8 { return 30u8; }
func unknown_product_field() -> u8 { return 31u8; }
func repeated_readonly_initializer() -> u8 { return 32u8; }
func missing_product_initializer() -> u8 { return 33u8; }
func string_operand_required() -> u8 { return 34u8; }
func c_string_operand_required() -> u8 { return 35u8; }
func interior_literal_nul() -> u8 { return 36u8; }
export func unsupported_text_operation() -> u8 { return 37u8; }
func wrong_text_result_owner() -> u8 { return 38u8; }
func unproved_text_policy() -> u8 { return 39u8; }
func text_place_needs_initializer() -> u8 { return 40u8; }
func ambiguous_transfer() -> u8 { return 41u8; }
func duplicate_transfer_signature() -> u8 { return 42u8; }
export func unsupported_transfer_signature() -> u8 { return 43u8; }
export func unproved_transfer_owner() -> u8 { return 44u8; }
export func unsupported_imported_call() -> u8 { return 45u8; }

export func unreachable_case_item() -> u8 { return 1u8; }
export func misses_case_arm() -> u8 { return 0u8; }
export func tests_case_arm() -> u8 { return 1u8; }
export func matches_case_arm() -> u8 { return 2u8; }

export func case_guard_passes() -> u8 { return 1u8; }
export func case_guard_declines() -> u8 { return 2u8; }
export func case_guard_tests() -> u8 { return 3u8; }
func case_guard_exits() -> u8 { return 4u8; }

func set_fact(facts:OperandFacts in F, at:u64, kind:u8, reception:u8,
              owner_site:u64, identity:u64, checked_exception:u8) -> void where {owner F} {
    facts[at].kind <- kind;
    facts[at].reception <- reception;
    facts[at].owner <- owner_site;
    facts[at].identity <- identity;
    facts[at].reservation <- no_node();
    facts[at].checked_exception <- checked_exception;
    facts[at].identity_module <- 0u64;
    facts[at].reaches_constructed_throw <- false;
    facts[at].loans_owning_handle <- false;
    facts[at].checks_array_bounds <- false;
    facts[at].target_readonly <- 0u8;
    facts[at].writable_text_place <- 0u8;
    facts[at].selection <- no_node();
    facts[at].text_nul <- 0u8;
    facts[at].target_presence <- if (kind == null_literal()) { absent_target() } else {
        if (reception == nullable_ptr()) { unknown_target() } else { present_target() }
    };
    return;
}

export func remember_constructed_throw(facts:OperandFacts in F, at:u64,
    type:const ExceptionType in T, reaches_throw:bool)
    -> void where {owner F, const owner T} {
    set_fact(facts, at, never_result(), 0u8, no_node(), type.declaration,
        if (type.checked) { 1u8 } else { 0u8 });
    facts[at].identity_module <- type.defining_module;
    facts[at].reaches_constructed_throw <- reaches_throw;
    return;
}

func scalar_fact(facts:OperandFacts in F, at:u64, reception:u8, owner_site:u64) -> void where {owner F} {
    set_fact(facts, at, scalar_u64(), reception, owner_site, 0u64, 0u8);
}

func copy_fact(facts:OperandFacts in F, destination:u64, source:u64) -> void where {owner F} {
    set_fact(facts, destination, facts[source].kind, facts[source].reception, facts[source].owner,
             facts[source].identity, facts[source].checked_exception);
    facts[destination].identity_module <- facts[source].identity_module;
    facts[destination].reservation <- facts[source].reservation;
    facts[destination].target_readonly <- facts[source].target_readonly;
    facts[destination].target_presence <- facts[source].target_presence;
    facts[destination].selection <- facts[source].selection;
    facts[destination].text_nul <- facts[source].text_nul;
    return;
}

func only_void(facts:OperandFacts in F, at:u64) -> void where {owner F} {
    set_fact(facts, at, void_result(), 0u8, no_node(), 0u64, 0u8);
}

export func require_typed_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64,
    kind:u8) -> u8
    where {const owner N, owner F} {
    if (binds_local_storage(nodes, operand))
        return unproved_operand();
    if (facts[operand].kind == 0u8) return unproved_operand();
    if (!scalar_kind(kind) || facts[operand].kind != kind) return wrong_operand_type();
    if (facts[operand].reception == nullable_ptr()) {
        facts[operand].needs_target <- 1u8;
        return 0u8;
    } else {};
    return 0u8;
}

func compatible_operand_nominal(facts:const OperandFacts in F, operand:u64, kind:u8, identity:u64,
    module:u64) -> bool
    where {const owner F} {
    return facts[operand].kind != kind || (kind != scalar_enum() && kind != product_kind()) ||
        (facts[operand].identity == identity && facts[operand].identity_module == module);
}

func same_operand_type(facts:const OperandFacts in F, left:u64, right:u64) -> bool where {const owner F} {
    return facts[left].kind == facts[right].kind &&
        compatible_operand_nominal(facts, left, facts[right].kind, facts[right].identity,
            facts[right].identity_module);
}

func require_matching_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64, expected:u64) -> u8
    where {const owner N, owner F} {
    if (facts[expected].kind == scalar_enum() && facts[operand].kind == scalar_enum() &&
        !same_operand_type(facts, operand, expected)) return wrong_operand_type();
    return require_typed_bits(nodes, facts, operand, facts[expected].kind);
}

func require_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64) -> u8
    where {const owner N, owner F} {
    return require_typed_bits(nodes, facts, operand, scalar_u64());
}

export func declared_scalar(binding:u8) -> u8 {
    if (binding == builtin_u64()) return scalar_u64();
    if (binding == builtin_u8()) return scalar_u8();
    if (binding == builtin_bool()) return scalar_bool();
    if (binding == enum_type()) return scalar_enum();
    return 0u8;
}

func source_scalar_kind(binding:u8) -> u8 {
    if (binding == builtin_u32()) return source_u32();
    return declared_scalar(binding)
}

func require_source_u32(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64,
    widen:bool) -> u8
    where {const owner N, owner F} {
    if (binds_local_storage(nodes, operand) || facts[operand].kind == 0u8)
        return unproved_operand();
    if (widen && facts[operand].kind == scalar_u8()) return require_typed_bits(nodes, facts,
        operand, scalar_u8());
    if (facts[operand].kind != source_u32()) return wrong_operand_type();
    if (facts[operand].reception != local_place() &&
        facts[operand].reception != independent_value())
        return unproved_operand();
    return 0u8
}

func nominal_identity(names:const NameBindings in B, annotation:u64) -> u64 where {const owner B} {
    val kind <- names[annotation].kind;
    if (kind == enum_type() || kind == record_type()) return names[annotation].declaration;
    return 0u64;
}

func declared_borrow(names:const NameBindings in B, facts:const OperandFacts in F, annotation:u64) -> u8
    where {const owner B, const owner F} {
    if (names[annotation].kind == record_type() && facts[names[annotation].declaration].product_words != 0u64)
        return product_kind();
    val kind <- names[annotation].kind;
    if (kind == builtin_string()) return string_kind();
    if (kind == builtin_c_string()) return c_string_kind();
    return declared_scalar(kind);
}

func prepare_product_layout(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                            facts:OperandFacts in F, record:u64, revision:u64, used:u64, tail:u64) -> void
    where {const owner N, const owner B, const owner L, owner F} {
    if (has_exception_parent(nodes, names, record, revision, used)) return;
    ref field = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, field)) return;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val words <- 0u64;
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (field == no_node()) {
            facts[record].product_words <- words;
            return;
        };
        if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
            (formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding) return;
        kind <- names[binding.annotation].kind;
        if (declared_scalar(kind) == 0u8 && kind != builtin_string()) return;
        facts[field].word_offset <- words;
        words <- words + 1u64;
        field <- links[field].next;
    };
}

func owner_conflict(nodes:const ExprNodes in N, first:u64, second:u64) -> u8 where {const owner N} {
    if (owner_parameter(nodes, first) || owner_parameter(nodes, second)) return unproved_owner();
    return incompatible_owner();
}

func exception_annotation(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E,
                          facts:OperandFacts in F, annotation:u64, at:u64, module:u64, used:u64,
                              revision:u64) -> u8
    where {const owner N, const owner B, const owner E, owner F} {
    if (annotation == no_node()) {
        set_fact(facts, at, exception_type(), readonly_exception(), no_node(), no_node(), 0u8);
        return 0u8;
    };
    ref type = make ExceptionType { defining_module <- 0u64; declaration <- no_node(); checked <-
        false; };
    if (!resolve_exception_type(nodes, names, selected, annotation, module, used, revision, type))
        return expected_exception_type();
    set_fact(facts, at, exception_type(), readonly_exception(), no_node(), type.declaration,
             if (type.checked) { 1u8 } else { 0u8 });
    facts[at].identity_module <- type.defining_module;
    return 0u8;
}

func check_formal(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                  views:const SuppliedViews in H, selected:const SelectedExports in E,
                  cases:const ConstructorCaseFacts in C, source_only:bool,
                  formal:u64, definition:u64, revision:u64, used:u64) -> u8
    where {const owner N, const owner B, owner F, const owner H, const owner E, const owner C} {
    ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val syntax <- inspect_formal(nodes, revision, used, formal, parameter);
    if (syntax == HereFormalSyntax) {
        ref contract = make HereContract {
            first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity
                <- 0u64
        };
        return if (inspect_here_contract(views, formal,
            contract)) { 0u8 } else { unproved_operand() }
    };
    if (syntax != OrdinaryFormal ||
        inspect_binding(nodes, revision, used, parameter.binding, binding) != TypedBinding) return unproved_operand();
    val form <- parameter.mode;
    if (source_only && formal < intrinsic (len)(cases)) {
        case cases[formal] of {
            CaseSumFormal { val bound <- definition; val owner_site <- owner_site; val readonly <- readonly;
                            val type <- value_type; } -> {
                if (bound != definition || form != ReferenceFormal || binding.readonly != readonly ||
                    binding.owner_name >= used || names[binding.owner_name].declaration != owner_site ||
                    !owner_parameter(nodes, owner_site)) return unproved_owner();
                set_fact(facts, formal, source_sum_target(), borrowed_ref(), owner_site, type.identity, 0u8);
                facts[formal].identity_module <- type.defining_module;
                facts[formal].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
                return 0u8
            };
            _ -> {}
        }
    };
    if (form == HandleFormal) {
        ref handle = make HandleContract { marker <- no_node(); owner_site <- no_node(); readonly <-
            false };
        if (!inspect_handle_contract(views, formal, handle)) return unproved_operand();
        if (source_only) {
            set_fact(facts, formal, source_handle_loan(), borrowed_ref(), handle.owner_site,
                     type_identity(names, selected, handle.marker), 0u8);
            facts[formal].identity_module <- type_module(names, selected, handle.marker, 0u64);
            (facts[formal].target_readonly <- if (handle.readonly) { 1u8 } else { 0u8 }):void
        };
        return 0u8
    };
    val annotation <- binding.annotation;
    val readonly <- if (binding.readonly) { 1u8 } else { 0u8 };
    val place <- form == PlaceFormal || form == InitializingPlaceFormal;
    if (binding.owner_name != no_node()) {
        if (form != ReferenceFormal && form != PointerFormal && !place)
            return unproved_operand();
        val target <- binding.target_type;
        val borrowed_kind <- if (source_only && (names[target].kind == array_type() ||
            (names[target].kind == ordinary_selection() &&
                selected[names[target].declaration].kind == array_export()))) {
                source_array_loan()
            } else { declared_borrow(names, facts, target) };
        if (names[target].kind == record_type() && (borrowed_kind == 0u8 || form == PointerFormal))
            return unsupported_product_layout();
        if (place && (borrowed_kind != string_kind() || readonly != 0u8)) return unsupported_text_operation();
        if (!place && immutable_text_kind(borrowed_kind) && (form != ReferenceFormal || readonly == 0u8))
            return unsupported_text_operation();
        if (borrowed_kind == 0u8) return unproved_operand();
        val owner_site <- names[binding.owner_name].declaration;
        if (!owner_parameter(nodes, owner_site)) return unproved_owner();
        val reception <- if (form == PointerFormal) { nullable_ptr() } else { borrowed_ref() };
        if (borrowed_kind == source_array_loan()) {
            if (form != ReferenceFormal) return unproved_operand();
            set_fact(facts, formal, borrowed_kind, reception, owner_site, type_identity(names,
                selected, target), 0u8);
            (facts[formal].identity_module <- type_module(names, selected, target, 0u64)):void
        } else {
            set_fact(facts, formal, borrowed_kind, reception, owner_site, nominal_identity(names,
                target), 0u8)
        };
        if (reception == nullable_ptr()) { (facts[formal].selection <- formal):void; } else {};
        facts[formal].target_readonly <- if (place) { 1u8 } else { readonly };
        if (place) { (facts[formal].writable_text_place <- 1u8):void; };
        if (borrowed_kind == c_string_kind()) { (facts[formal].text_nul <- nul_absent()):void; };
        if (owner_constraint_syntax(nodes, owner_site) == WritableOwnerConstraint && facts[owner_site].passes_owner == 0u8) {
            facts[owner_site].passes_owner <- 1u8;
            (facts[formal].passes_owner <- 1u8):void;
        };
        return 0u8;
    } else {};
    if (place) return unsupported_text_operation();
    if (form != ValueFormal && form != ExplicitValueFormal && form != ReferenceFormal &&
        form != PointerFormal) return unproved_operand();
    val declared <- names[annotation].kind;
    if (source_only && declared == ordinary_selection()) {
        val choice <- names[annotation].declaration;
        if (choice < intrinsic (len)(selected) && selected[choice].kind == enum_export() &&
            selected[choice].origin_module != 0u64 && selected[choice].identity != no_node()) {
            set_fact(facts, formal, scalar_enum(), local_place(), definition,
                     selected[choice].identity, 0u8);
            facts[formal].identity_module <- selected[choice].origin_module;
            facts[formal].target_readonly <- readonly;
            return 0u8
        }
    };
    val kind <- if (source_only) { source_scalar_kind(declared) }
        else { declared_scalar(declared) };
    if (kind == 0u8) return unproved_operand();
    set_fact(facts, formal, kind, local_place(), definition, nominal_identity(names, annotation), 0u8);
    facts[formal].target_readonly <- readonly;
    return 0u8;
}

func check_formals(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:OperandFacts in F, views:const SuppliedViews in H,
                   selected:const SelectedExports in E, cases:const ConstructorCaseFacts in C,
                   source_only:bool, report:OperandCheckResult in R,
                   definition:u64, tail:u64, used:u64, revision:u64) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner H, const owner E,
        const owner C, owner R} {
    ref formal = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, formal)) {
        report.node <- definition;
        (report.diagnostic <- invalid_operand_tree()):void;
        return;
    };
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return;
        report.diagnostic <- check_formal(nodes, names, facts, views, selected, cases, source_only, formal,
            definition, revision, used);
        if (report.diagnostic != 0u8) { report.node <- formal; return; } else {};
        formal <- links[formal].next;
    };
}

func check_borrowed_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, definition:u64, clause:u64, signature:const SignatureSites in S,
                           revision:u64, used:u64) -> u8
    where {const owner N, const owner B, owner F, const owner S} {
    val annotation <- signature.annotation;
    ref type = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (names[clause].declaration != no_node() ||
        !inspect_type_annotation(nodes, revision, used, annotation, type) || type.owner_name == no_node())
        return unsupported_text_operation();
    val target <- type.target_type;
    val kind <- declared_borrow(names, facts, target);
    val owner_site <- names[type.owner_name].declaration;
    val readonly <- signature.readonly;
    if (kind != product_kind() && (!immutable_text_kind(kind) || !readonly))
        return unproved_result_contract();
    if (!owner_parameter(nodes, owner_site)) return unproved_owner();
    set_fact(facts, definition, kind, borrowed_ref(), owner_site, nominal_identity(names, target), 0u8);
    facts[definition].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
    if (kind == c_string_kind()) { (facts[definition].text_nul <- nul_absent()):void; };
    return 0u8;
}

func check_signature_clauses(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                             facts:OperandFacts in F, selected:const SelectedExports in E,
                             report:OperandCheckResult in R, source_only:bool, definition:u64,
                                 first:u64, used:u64, revision:u64) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner E, owner R} {
    val clause <- first;
    val annotation <- no_node();
    val kind <- 0u8;
    val choice <- no_node();
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val shape <- SignatureHead;
    val failure_seen <- false;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) return;
        shape <- inspect_signature(nodes, revision, used, clause, signature);
        annotation <- signature.annotation;
        if (shape == ValueResultClause) {
            if (names[annotation].kind == builtin_void()) {
                only_void(facts, definition);
            } else {
                if (names[annotation].kind == ordinary_selection() &&
                    selected[names[annotation].declaration].kind == enum_export()) {
                    kind <- scalar_enum();
                    choice <- names[annotation].declaration;
                    set_fact(facts, definition, kind, independent_value(), no_node(),
                        selected[choice].identity, 0u8);
                    (facts[definition].identity_module <- selected[choice].origin_module):void
                } else {
                    kind <- if (source_only) { source_scalar_kind(names[annotation].kind) }
                        else { declared_scalar(names[annotation].kind) };
                    if (kind == 0u8) {
                        report.node <- annotation;
                        report.diagnostic <- unproved_result_contract();
                        return
                    };
                    set_fact(facts, definition, kind, independent_value(), no_node(),
                        nominal_identity(names, annotation), 0u8)
                }
            };
        };
        if (shape == BorrowedResultClause) {
            (report.diagnostic <- check_borrowed_result(nodes, names, facts, definition, clause, signature, revision, used)):void;
        };
        if (shape == ThrowsSignatureClause) {
            if (failure_seen) {
                report.node <- clause;
                report.diagnostic <- unsupported_imported_call();
                return
            };
            failure_seen <- true;
            if (facts[clause].kind != exception_type()) { (report.diagnostic <-
                expected_exception_type()):void; };
            if (report.diagnostic != 0u8) { report.node <- annotation; return; };
        };
        if (report.diagnostic != 0u8) { report.node <- clause; return; };
        clause <- links[clause].next;
    };
}

func check_signature(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     facts:OperandFacts in F, views:const SuppliedViews in H,
                     selected:const SelectedExports in E, cases:const ConstructorCaseFacts in P,
                     source_only:bool, report:OperandCheckResult in R, definition:u64, used:u64,
                         revision:u64, callable:const CallableSites in C) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner H, const owner E,
        const owner P, owner R, const owner C} {
    ref head = make u64 { no_node() };
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, head) ||
        inspect_signature(nodes, revision, used, head, sites) != SignatureHead) {
        report.node <- definition;
        (report.diagnostic <- invalid_operand_tree()):void;
        return;
    };
    check_formals(nodes, names, links, facts, views, selected, cases, source_only, report, definition,
        sites.parameter_tail, used, revision);
    if (report.diagnostic != 0u8) return;
    check_signature_clauses(nodes, names, links, facts, selected, report, source_only, definition,
        links[head].next, used, revision);
    if (report.diagnostic != 0u8 || facts[definition].kind != 0u8) return;
    ref value = make u64 { no_node() };
    ref borrowed = make u64 { no_node() };
    if (source_only && !callable.function_form &&
        find_signature_clause(nodes, revision, used, callable.signature, ValueResultClause,
            value) &&
        find_signature_clause(nodes, revision, used, callable.signature, BorrowedResultClause,
            borrowed) &&
        value == no_node() && borrowed == no_node()) {
        only_void(facts, definition);
        return
    };
    report.node <- head;
    (report.diagnostic <- unproved_result_contract()):void
}

func check_local(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                  at:u64, used:u64, revision:u64, local:const LocalBindingSites in L) -> u8
    where {const owner N, const owner B, owner F, const owner L} {
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, local.binding, binding) == InvalidBindingSyntax) return invalid_operand_tree();
    val initializer <- local.initializer;
    val type_name <- binding.target_type;
    val readonly <- if (binding.readonly) { 1u8 } else { 0u8 };
    val value_binding <- local.mode == ValueLocal;
    val pointer <- local.mode == PointerLocal;
    if (value_binding && binding.owner_name != no_node()) return unproved_operand();
    val required_owner <- if (binding.owner_name == no_node()) { no_node() } else { (names[binding.owner_name].declaration) };
    val declared_kind <- if (type_name == no_node()) { 0u8 } else { declared_borrow(names, facts, type_name) };
    if (declared_kind == product_kind() || facts[initializer].kind == product_kind()) {
        if (value_binding || pointer) return unsupported_product_layout();
    };
    if (immutable_text_kind(declared_kind) || immutable_text_kind(facts[initializer].kind)) {
        if (value_binding || pointer) return unsupported_text_operation();
    };
    if (declared_kind == 0u8 && type_name != no_node()) return unproved_operand();
    val identity <- if (type_name == no_node()) { (facts[initializer].identity) } else { nominal_identity(names, type_name) };
    if (declared_kind == scalar_enum() && facts[initializer].kind == scalar_enum() &&
        !compatible_operand_nominal(facts, initializer, declared_kind, identity, 0u64))
        return incompatible_enum_type();
    if (facts[initializer].kind == never_result()) {
        ref construction = make ConstructionSites {
            requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
            initializer <- no_node(); contents <- no_node();
        };
        val shape <- inspect_construction(nodes, revision, used, initializer, construction);
        if (required_owner != no_node() && (shape == BracedConstruction || shape == PositionalConstruction)) {
            val placement <- facts[initializer].allocation_owner;
            val actual <- if (placement == no_node()) { (names[initializer].scope) } else { placement };
            if (required_owner != actual) return owner_conflict(nodes, actual, required_owner);
        };
        set_result(facts, at, never_result());
        return 0u8;
    } else {};
    if (value_binding) {
        val value_kind <- if (declared_kind == 0u8) { (facts[initializer].kind) } else { declared_kind };
        if (reserves_storage(nodes, revision, used, initializer)) {
            if (facts[initializer].kind != value_kind) return wrong_operand_type();
            set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
            facts[at].target_readonly <- readonly;
            facts[at].reservation <- initializer;
            return 0u8;
        } else {};
        val diagnostic <- require_typed_bits(nodes, facts, initializer, value_kind);
        if (diagnostic != 0u8) return diagnostic;
        set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
        facts[at].identity_module <- facts[initializer].identity_module;
        facts[at].target_readonly <- readonly;
        return 0u8;
    } else {};
    if (binds_local_storage(nodes, initializer)) return unproved_operand();
    val reception <- if (pointer) { nullable_ptr() } else { borrowed_ref() };
    val fresh <- facts[initializer].reception == independent_value();
    val kind <- if (type_name == no_node()) { (facts[initializer].kind) } else { declared_kind };
    val owner_site <- if (fresh) { (names[at].scope) } else { (facts[initializer].owner) };
    if (required_owner != no_node()) {
        if (owner_site != no_node() && owner_site != required_owner)
            return owner_conflict(nodes, owner_site, required_owner);
        (owner_site <- required_owner):void;
    } else {};
    if (facts[initializer].kind == null_literal()) {
        if (!pointer) return unproved_nonnull_borrow();
    } else {
        if (immutable_text_kind(kind)) {
            if (!immutable_text_kind(facts[initializer].kind)) return string_operand_required();
            if (kind == c_string_kind() && facts[initializer].kind != c_string_kind() &&
                !(text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, initializer)) == NulFreeLiteral && facts[initializer].text_nul == nul_absent()))
                return c_string_operand_required();
        } else {
            if ((!scalar_kind(kind) && kind != product_kind()) || facts[initializer].kind != kind)
                return unproved_operand();
        };
        if (kind == product_kind() && facts[initializer].identity != identity) return wrong_operand_type();
        if (type_name != no_node() && facts[initializer].target_readonly != 0u8 && readonly == 0u8)
            return expected_writable_place();
    };
    if (owner_site == no_node()) return unproved_owner();
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].target_readonly <- if (type_name == no_node()) { (facts[initializer].target_readonly) } else { readonly };
    facts[at].reservation <- facts[initializer].reservation;
    facts[at].text_nul <- facts[initializer].text_nul;
    if (pointer) {
        facts[at].target_presence <- facts[initializer].target_presence;
        val selected <- facts[initializer].selection;
        (facts[at].selection <- if (selected == no_node()) { at } else { selected }):void;
    } else {};
    return 0u8;
}

func check_text_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                             facts:OperandFacts in F, at:u64, used:u64, revision:u64,
                             construction:const ConstructionSites in L) -> u8
    where {const owner N, const owner B, owner F, const owner L} {
    val tail <- construction.contents;
    ref argument = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, tail, argument) != ArgumentSequence ||
        argument.previous != no_node()) return unsupported_text_operation();
    val source <- argument.item;
    val placement <- construction.placement;
    val owner_site <- facts[at].allocation_owner;
    if (placement != no_node()) { (owner_site <- names[placement].declaration):void; };
    if (owner_site == no_node()) { (owner_site <- names[at].scope):void; };
    if (owner_constraint_syntax(nodes, owner_site) == ReadonlyOwnerConstraint)
        return readonly_owner_argument();
    facts[at].allocation_owner <- owner_site;
    (facts[owner_site].owner_chain <- 0u64):void;
    if (facts[source].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (!immutable_text_kind(facts[source].kind)) return string_operand_required();
    set_fact(facts, at, string_kind(), borrowed_ref(), owner_site, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- facts[source].text_nul;
    return 0u8;
}

func check_text_assertion(facts:OperandFacts in F, at:u64, operand:u64) -> u8
    where {owner F} {
    if (facts[operand].kind == never_result()) { copy_fact(facts, at, operand); return 0u8; };
    if (!immutable_text_kind(facts[operand].kind)) return string_operand_required();
    if (facts[operand].text_nul == nul_present()) return interior_literal_nul();
    set_fact(facts, at, c_string_kind(), borrowed_ref(), facts[operand].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- nul_absent();
    (facts[at].text_assertion <- if (facts[operand].text_nul == nul_absent()) { 0u8 } else { 1u8 }):void;
    return 0u8;
}

func check_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                        facts:OperandFacts in F, at:u64, construction:const ConstructionSites in L) -> u8
    where {const owner N, const owner B, owner F, const owner L} {
    val requested <- construction.requested;
    val queried <- construction.queried_operand;
    val kind <- if (queried == no_node()) { declared_scalar(names[requested].kind) } else { (facts[queried].kind) };
    if (!scalar_kind(kind)) return unproved_operand();
    val identity <- if (queried == no_node()) { nominal_identity(names, requested) } else { (facts[queried].identity) };
    val owner_site <- names[at].scope;
    val explicit_owner <- construction.placement;
    if (explicit_owner != no_node() && names[explicit_owner].declaration != owner_site) return unproved_owner();
    val body <- construction.contents;
    if (body == no_node()) {
        set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
        facts[at].reservation <- at;
        return 0u8;
    } else {};
    if (facts[body].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (kind == scalar_enum() && facts[body].kind == scalar_enum() && facts[body].identity != identity)
        return incompatible_enum_type();
    val diagnostic <- require_typed_bits(nodes, facts, body, kind);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
    return 0u8;
}

data ProductInitialization {
    count:u64;
    abrupt:bool;
}

func check_owner_access(nodes:const ExprNodes in N, actual_owner:u64, requires_allocation:bool) -> u8
    where {const owner N} {
    if (actual_owner == no_node()) return unproved_owner();
    val readonly_owner <- actual_owner == static_text_owner() ||
        owner_constraint_syntax(nodes, actual_owner) == ReadonlyOwnerConstraint;
    if (readonly_owner && requires_allocation) return readonly_owner_argument();
    return 0u8;
}

func record_owner_argument(nodes:const ExprNodes in N, facts:OperandFacts in F, owners:CallOwners in O,
                           formal:u64, actual_owner:u64, argument:u64, invocation:u64) -> u8
    where {const owner N, owner F, owner O} {
    val formal_owner <- facts[formal].owner;
    val diagnostic <- check_owner_access(nodes, actual_owner, owner_constraint_syntax(nodes, formal_owner) != ReadonlyOwnerConstraint);
    if (diagnostic != 0u8) return diagnostic;
    if (owners[formal_owner].call_site == invocation && owners[formal_owner].actual_owner != actual_owner)
        return owner_conflict(nodes, owners[formal_owner].actual_owner, actual_owner);
    owners[formal_owner].call_site <- invocation;
    owners[formal_owner].actual_owner <- actual_owner;
    if (facts[formal].passes_owner != 0u8) {
        facts[argument].owner_use_next <- owners[formal_owner].uses;
        (owners[formal_owner].uses <- argument):void;
    };
    return 0u8;
}

func binary_formals(nodes:const ExprNodes in N, links:const NameWork in L,
                     definition:u64, revision:u64, used:u64) -> u64 where {const owner N, const owner L} {
    ref first = make u64 { no_node() };
    if (!callable_formals(nodes, revision, used, definition, false, first) || first == no_node()) return no_node();
    val second <- links[first].next;
    if (second == no_node() || links[second].next != no_node()) return no_node();
    return first;
}

func owner_parameter(nodes:const ExprNodes in N, owner_site:u64) -> bool where {const owner N} {
    return owner_constraint_syntax(nodes, owner_site) != NotOwnerConstraint;
}

func shares_owner(nodes:const ExprNodes in N, facts:const OperandFacts in F, first:u64, second:u64) -> bool
    where {const owner N, const owner F} {
    return facts[first].owner == facts[second].owner && owner_parameter(nodes, facts[first].owner);
}

func text_conforms(actual:u8, formal:u8) -> bool {
    return actual == formal || (actual == c_string_kind() && formal == string_kind());
}

func matching_transfer() -> u8 { return 1u8; }
func possible_transfer() -> u8 { return 2u8; }

func transfer_match(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                    left:u64, right:u64, method:u64, used:u64, revision:u64) -> u8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, method, revision, used);
    val second <- links[first].next;
    if (!same_operand_type(facts, left, first) || !text_conforms(facts[right].kind, facts[second].kind))
        return 0u8;
    if (!shares_owner(nodes, facts, first, second) || facts[left].owner == facts[right].owner)
        return matching_transfer();
    if (owner_parameter(nodes, facts[left].owner) && owner_parameter(nodes, facts[right].owner))
        return possible_transfer();
    return 0u8;
}

# All admitted policies have a writable destination and readonly text input.
# Text conformance and owner equality constrain independent parts of the domain.
func transfer_dominates(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        narrow:u64, wide:u64, match_kind:u8, used:u64, revision:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, narrow, revision, used);
    val other <- binary_formals(nodes, links, wide, revision, used);
    val second <- links[first].next;
    val other_second <- links[other].next;
    if (!text_conforms(facts[second].kind, facts[other_second].kind)) return false;
    val narrow_owner <- shares_owner(nodes, facts, first, second);
    val wide_owner <- shares_owner(nodes, facts, other, other_second);
    if (wide_owner && !narrow_owner) return false;
    if (narrow_owner && !wide_owner && match_kind != matching_transfer()) return false;
    return narrow_owner != wide_owner || facts[second].kind != facts[other_second].kind;
}

func dominated_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        left:u64, right:u64, family:u64, method:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val other <- family;
    val relation <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (other == no_node()) return false;
        if (other != method) {
            relation <- transfer_match(nodes, links, facts, left, right, other, used, revision);
            if (relation != 0u8 && transfer_dominates(nodes, links, facts, other, method, relation, used, revision))
                return true;
        };
        other <- links[other].next_method;
    };
    return false;
}

func select_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                     left:u64, right:u64, family:u64, selected:u64 in D, used:u64, revision:u64) -> u8
    where {const owner N, const owner L, const owner F, owner D} {
    val method <- family;
    val relation <- 0u8;
    val ambiguous <- false;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (method == no_node()) {
            if (ambiguous) return ambiguous_transfer();
            return if (selected == no_node()) { unproved_text_policy() } else { 0u8 };
        };
        relation <- transfer_match(nodes, links, facts, left, right, method, used, revision);
        if (relation != 0u8 && !dominated_transfer(nodes, links, facts, left, right, family, method, used, revision)) {
            if (relation == possible_transfer()) return unproved_transfer_owner();
            if (selected != no_node()) { (ambiguous <- true):void; };
            (selected <- method):void;
        };
        method <- links[method].next_method;
    };
    return invalid_operand_tree();
}

func supported_transfer_signature(nodes:const ExprNodes in N, links:const NameWork in L,
                                  facts:const OperandFacts in F, definition:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition, revision, used);
    if (first == no_node() || facts[definition].kind != void_result()) return false;
    val second <- links[first].next;
    val place <- facts[first].writable_text_place != 0u8 ||
        (facts[first].kind == product_kind() && facts[first].target_readonly == 0u8);
    return place && facts[first].reception == borrowed_ref() &&
        facts[second].reception == borrowed_ref() && facts[second].writable_text_place == 0u8 &&
        immutable_text_kind(facts[second].kind);
}

func check_transfer_signatures(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                               definition:u64, used:u64, revision:u64) -> u8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition, revision, used);
    val second <- links[first].next;
    val member <- links[definition].next_method;
    val other <- no_node();
    val other_second <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (member == no_node()) return 0u8;
        other <- binary_formals(nodes, links, member, revision, used);
        if (is_function(nodes, definition) != is_function(nodes, member))
            return unsupported_transfer_signature();
        other_second <- links[other].next;
        if (same_operand_type(facts, first, other) && same_operand_type(facts, second, other_second) &&
            shares_owner(nodes, facts, first, second) == shares_owner(nodes, facts, other, other_second))
            return duplicate_transfer_signature();
        member <- links[member].next_method;
    };
    return invalid_operand_tree();
}

func check_transfer_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:OperandFacts in F, owners:CallOwners in O, at:u64, destination:u64, input:u64, initializing:bool, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F, owner O} {
    if (names[at].kind != callable_binding()) return unproved_text_policy();
    if (facts[destination].kind == product_kind() &&
        (facts[destination].target_readonly != 0u8 || facts[destination].reception != borrowed_ref()))
        return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    val family <- names[at].declaration;
    val definition <- no_node();
    val diagnostic <- select_transfer(nodes, links, facts, destination, input, family, definition, used, revision);
    if (diagnostic != 0u8) return diagnostic;
    val place <- binary_formals(nodes, links, definition, revision, used);
    val text <- links[place].next;
    ref place_contract = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (initializing && (inspect_formal(nodes, revision, used, place, place_contract) != OrdinaryFormal ||
        place_contract.mode != InitializingPlaceFormal)) return text_place_needs_initializer();
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val place_owner <- facts[destination].owner;
    diagnostic <- record_owner_argument(nodes, facts, owners, place, place_owner, at, at);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- record_owner_argument(nodes, facts, owners, text, facts[input].owner, input, at);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, void_result(), 0u8, place_owner, 0u64, 0u8);
    facts[at].call_definition <- definition;
    return 0u8;
}

func record_field_binding(nodes:const ExprNodes in N, revision:u64, used:u64,
                          field:u64, binding:BindingSites in R) -> bool where {const owner N, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    return inspect_formal(nodes, revision, used, field, formal) == OrdinaryFormal &&
        inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding;
}

func check_product_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N,
                               names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                               owners:CallOwners in O, state:ProductInitialization in P, at:u64, record:u64, assignment:u64,
                               used:u64, revision:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O, owner P} {
    ref sites = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    if (inspect_assignment(nodes, revision, used, assignment, sites) != FieldTransfer ||
        names[sites.destination].kind != record_initializer_label()) return unsupported_product_layout();
    val name <- ungrouped(nodes, revision, used, sites.destination);
    if (name_syntax(nodes, used, name) != OrdinaryName) return unsupported_product_layout();
    val field <- find_record_field(source, nodes, links, record, name, revision, used);
    if (field == no_node()) return unknown_product_field();
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!record_field_binding(nodes, revision, used, field, binding)) return invalid_operand_tree();
    val first <- facts[field].last_initializer != at;
    if (!first && binding.readonly) return repeated_readonly_initializer();
    val value <- sites.input;
    val annotation <- binding.annotation;
    if (names[annotation].kind == builtin_string()) {
        val destination <- sites.destination;
        set_fact(facts, destination, string_kind(), borrowed_ref(), names[at].scope, 0u64, 0u8);
        facts[destination].writable_text_place <- 1u8;
        val diagnostic <- check_transfer_call(nodes, names, links, facts, owners, assignment, destination, value, true, used, revision);
        if (diagnostic != 0u8) return diagnostic;
    } else {
        if (facts[value].kind == never_result()) {
            (state.abrupt <- true):void;
        } else {
            val kind <- declared_scalar(names[annotation].kind);
            val bits_problem <- require_typed_bits(nodes, facts, value, kind);
            if (bits_problem != 0u8) return bits_problem;
            if (kind == scalar_enum() && facts[value].identity != nominal_identity(names, annotation))
                return incompatible_enum_type();
        };
    };
    facts[field].last_initializer <- at;
    facts[assignment].word_offset <- facts[field].word_offset;
    if (first) { (state.count <- state.count + 1u64):void; };
    return 0u8;
}

func check_product_construction(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                                owners:CallOwners in O, at:u64, record:u64, used:u64, revision:u64,
                                construction:const ConstructionSites in K) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O, const owner K} {
    val words <- facts[record].product_words;
    val body <- construction.contents;
    if (words == 0u64 || body == no_node()) return unsupported_product_layout();
    val owner_site <- names[at].scope;
    val placement <- construction.placement;
    if (placement != no_node() && names[placement].declaration != owner_site) return unproved_owner();
    ref state = make ProductInitialization { count <- 0u64; abrupt <- false; };
    ref tail = make u64 { no_node() };
    ref item = make u64 { no_node() };
    if (!block_tail(nodes, revision, used, body, tail) ||
        !first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return invalid_operand_tree();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val diagnostic <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) {
            if (state.count != words) return missing_product_initializer();
            facts[at].product_words <- words;
            if (state.abrupt) { set_result(facts, at, never_result()); }
            else { set_fact(facts, at, product_kind(), borrowed_ref(), owner_site, record, 0u8); };
            return 0u8;
        };
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return invalid_operand_tree();
        diagnostic <- check_product_initializer(source, nodes, names, links, facts, owners, state,
                                                at, record, entry.item, used, revision);
        if (diagnostic != 0u8) return diagnostic;
        (item <- links[item].next):void;
    };
    return invalid_operand_tree();
}

func check_caught_field(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F,
                         fields:const CaughtFieldUses in X, at:u64, receiver:u64, used:u64,
                             revision:u64, source_only:bool) -> u8
    where {const owner N, const owner B, owner F, const owner X} {
    if (at >= intrinsic (len)(fields)) return unknown_exception_field();
    val name <- ungrouped(nodes, revision, used, receiver);
    if (name_syntax(nodes, used, name) != OrdinaryName || names[name].kind != exception_binding())
        return unknown_exception_field();
    return case fields[at] of {
        (CaughtField { val binding <- binding; val nominal <- nominal; val kind <- kind; val
            readonly <- readonly; }) -> {
            if (names[name].declaration != binding ||
                facts[receiver].identity_module != nominal.defining_module ||
                facts[receiver].identity != nominal.declaration) return unknown_exception_field();
            if (kind == builtin_u32() && !source_only) return unsupported_narrow_execution();
            set_result(facts, at, source_scalar_kind(kind));
            facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
            return 0u8
        };
        _ -> unknown_exception_field()
    }
}

func check_field_access(source:const SourceBytes in S, nodes:const ExprNodes in N,
                        names:const NameBindings in B, links:const NameWork in L,
                            facts:OperandFacts in F,
                        fields:const CaughtFieldUses in X, at:u64, used:u64, revision:u64,
                        selection:const FieldSelectionSites in Q, source_only:bool) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, const owner X,
        const owner Q} {
    val receiver <- selection.receiver;
    if (facts[receiver].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (facts[receiver].kind == exception_type())
        return check_caught_field(nodes, names, facts, fields, at, receiver, used, revision, source_only);
    if (facts[receiver].kind != product_kind() || facts[receiver].reception != borrowed_ref())
        return unsupported_product_layout();
    val field <- find_record_field(source, nodes, links, facts[receiver].identity, selection.field, revision, used);
    if (field == no_node()) return unknown_product_field();
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!record_field_binding(nodes, revision, used, field, binding)) return invalid_operand_tree();
    val annotation <- binding.annotation;
    val kind <- if (names[annotation].kind == builtin_string()) { string_kind() } else { declared_scalar(names[annotation].kind) };
    set_fact(facts, at, kind, borrowed_ref(), facts[receiver].owner,
             nominal_identity(names, annotation), 0u8);
    facts[at].word_offset <- facts[field].word_offset;
    facts[at].target_readonly <- if (facts[receiver].target_readonly != 0u8 ||
        binding.readonly) { 1u8 } else { 0u8 };
    if (kind == string_kind()) {
        facts[at].writable_text_place <- if (facts[at].target_readonly == 0u8) { 1u8 } else { 0u8 };
        (facts[at].target_readonly <- 1u8):void;
    };
    return 0u8;
}

func check_text_installation(nodes:const ExprNodes in N, facts:OperandFacts in F,
                             at:u64, destination:u64, input:u64) -> u8 where {const owner N, owner F} {
    if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    if (facts[destination].owner != facts[input].owner)
        return owner_conflict(nodes, facts[destination].owner, facts[input].owner);
    set_fact(facts, at, string_kind(), borrowed_ref(), facts[destination].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    return 0u8;
}

func check_transfer_destination(
    nodes:const ExprNodes in N, facts:OperandFacts in F, destination:u64)
    -> u8 where {const owner N, owner F} {
    val reception <- facts[destination].reception;
    val kind <- facts[destination].kind;
    if (!scalar_kind(kind)) return unproved_operand();
    if (facts[destination].target_readonly != 0u8 ||
        (reception != local_place() && reception != borrowed_ref() && reception != nullable_ptr()))
        return expected_writable_place();
    return require_typed_bits(nodes, facts, destination, kind)
}

func remember_transfer(facts:OperandFacts in F, at:u64, destination:u64) -> void where {owner F} {
    set_fact(facts, at, facts[destination].kind, borrowed_ref(),
             facts[destination].owner, facts[destination].identity, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].reservation <- facts[destination].reservation;
    return
}

func check_transfer(nodes:const ExprNodes in N, facts:OperandFacts in F,
                    at:u64, destination:u64, supplied:u64) -> u8 where {const owner N, owner F} {
    val diagnostic <- check_transfer_destination(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_matching_bits(nodes, facts, supplied, destination);
    if (diagnostic != 0u8) return diagnostic;
    remember_transfer(facts, at, destination);
    return 0u8;
}

func check_augmented_transfer(nodes:const ExprNodes in N, facts:OperandFacts in F,
                              at:u64, destination:u64, input:u64, used:u64, revision:u64)
    -> u8 where {const owner N, owner F} {
    val selected <- ungrouped(nodes, revision, used, destination);
    if (name_syntax(nodes, used, selected) != OrdinaryName) return unsupported_transfer_signature();
    val diagnostic <- check_transfer_destination(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_bits(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    diagnostic <- require_bits(nodes, facts, input);
    if (diagnostic != 0u8) return diagnostic;
    remember_transfer(facts, at, destination);
    return 0u8
}

func ordinary_argument_value(nodes:const ExprNodes in N, used:u64, revision:u64, argument:u64) -> u64
    where {const owner N} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    return if (inspect_sequence_entry(nodes, revision, used, argument, entry) == ArgumentSequence) {
        (entry.item)
    } else { no_node() };
}

func callable_formals(nodes:const ExprNodes in N, revision:u64, used:u64,
                      definition:u64, source_only:bool, first:u64 in R) -> bool where {const owner N, owner R} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref head = make u64 { no_node() };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    return (form == ModuleCallable || (source_only && form == LexicalCallable)) &&
        find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, head) &&
        inspect_signature(nodes, revision, used, head, signature) == SignatureHead &&
        first_sequence_entry(nodes, revision, used, signature.parameter_tail, FormalSequence, first);
}

func check_argument_operand(nodes:const ExprNodes in N, facts:OperandFacts in F, argument:u64,
                            kind:u8, wanted:u8, identity:u64, module:u64, readonly:u8, used:u64, revision:u64) -> u8
    where {const owner N, owner F} {
    val actual <- ordinary_argument_value(nodes, used, revision, argument);
    if (actual == no_node()) return invalid_operand_tree();
    if (checked_ref_argument(nodes, argument) && wanted != borrowed_ref())
        return checked_selection_requires_ref();
    if (wanted == local_place()) {
        if (!compatible_operand_nominal(facts, actual, kind, identity, module)) return wrong_operand_type();
        val bits_problem <- if (kind == source_u32()) { require_source_u32(nodes, facts, actual,
            true) }
            else { require_typed_bits(nodes, facts, actual, kind) };
        if (bits_problem != 0u8) return bits_problem;
        set_fact(facts, argument, kind, independent_value(), no_node(), identity, 0u8);
        facts[argument].identity_module <- module;
        return 0u8;
    } else {};
    if (binds_local_storage(nodes, actual) ||
        facts[actual].kind == 0u8 || facts[actual].kind == null_literal()) return unproved_operand();
    if (immutable_text_kind(kind)) {
        if (!immutable_text_kind(facts[actual].kind)) return string_operand_required();
        if (kind == c_string_kind() && facts[actual].kind != c_string_kind() &&
            !(text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, actual)) == NulFreeLiteral && facts[actual].text_nul == nul_absent()))
            return c_string_operand_required();
    } else {
        if (facts[actual].kind != kind || !compatible_operand_nominal(facts, actual, kind, identity, module))
            return wrong_operand_type();
    };
    if (facts[actual].reception == independent_value()) return unproved_owner();
    if (facts[actual].target_readonly != 0u8 && readonly == 0u8) return expected_writable_place();
    set_fact(facts, argument, kind, wanted, facts[actual].owner, identity, 0u8);
    facts[argument].identity_module <- module;
    return 0u8;
}

func check_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in L,
    facts:OperandFacts in F, owners:CallOwners in O, argument:u64, formal:u64,
    invocation:u64, used:u64, revision:u64, allow_owned_loan:bool) -> u8
    where {const owner N, const owner B, const owner E, const owner L, owner F, owner O} {
    if (facts[formal].writable_text_place != 0u8) return unsupported_text_operation();
    val kind <- facts[formal].kind;
    if (kind == source_array_loan() || kind == source_handle_loan() || kind == source_sum_target()) {
        val actual <- ordinary_argument_value(nodes, used, revision, argument);
        if (actual >= used || checked_ref_argument(nodes, argument)) return wrong_operand_type();
        if (allow_owned_loan && kind == source_handle_loan() && facts[actual].kind == 0u8) {
            ref handle = make HandleContract { marker <- no_node(); owner_site <- no_node(); readonly <- false };
            if (!inspect_acquired_handle_loan(nodes, names, selected, links, actual, invocation,
                used, revision, handle)) return unproved_owner();
            set_fact(facts, argument, source_handle_loan(), borrowed_ref(), handle.owner_site,
                type_identity(names, selected, handle.marker), 0u8);
            facts[argument].identity_module <- type_module(names, selected, handle.marker, 0u64);
            facts[argument].target_readonly <- if (handle.readonly) { 1u8 } else { 0u8 };
            facts[argument].loans_owning_handle <- true;
            (actual <- argument):void
        };
        if (facts[actual].kind != kind || facts[actual].identity != facts[formal].identity ||
            facts[actual].identity_module != facts[formal].identity_module)
                return wrong_operand_type();
        if (facts[actual].reception != borrowed_ref()) return unproved_owner();
        if (facts[actual].target_readonly != 0u8 && facts[formal].target_readonly == 0u8)
            return expected_writable_place();
        if (actual != argument) { copy_fact(facts, argument, actual) };
        return record_owner_argument(nodes, facts, owners, formal, facts[actual].owner, argument,
            invocation)
    };
    val wanted <- facts[formal].reception;
    val diagnostic <- check_argument_operand(nodes, facts, argument, facts[formal].kind, wanted,
                                             facts[formal].identity, facts[formal].identity_module,
                                             facts[formal].target_readonly, used, revision);
    if (diagnostic != 0u8 || wanted == local_place()) return diagnostic;
    return record_owner_argument(nodes, facts, owners, formal, facts[argument].owner, argument, invocation);
}

func check_text_intrinsic(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                          at:u64, arguments:u64, intrinsic_kind:u8, used:u64, revision:u64) -> u8
    where {const owner N, const owner L, owner F} {
    if (intrinsic_kind != text_size_export() && intrinsic_kind != text_byte_export()) return unproved_call_target();
    ref first = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, first)) return invalid_operand_tree();
    if (first == no_node()) return wrong_argument_count();
    val next <- links[first].next;
    val byte <- intrinsic_kind == text_byte_export();
    if ((!byte && next != no_node()) || (byte && (next == no_node() || links[next].next != no_node())))
        return wrong_argument_count();
    val text <- ordinary_argument_value(nodes, used, revision, first);
    if (text == no_node()) return invalid_operand_tree();
    if (!immutable_text_kind(facts[text].kind)) return string_operand_required();
    copy_fact(facts, first, text);
    if (byte) {
        val index <- ordinary_argument_value(nodes, used, revision, next);
        if (index == no_node()) return invalid_operand_tree();
        val diagnostic <- require_bits(nodes, facts, index);
        if (diagnostic != 0u8) return diagnostic;
        scalar_fact(facts, next, independent_value(), no_node());
    };
    if (byte) { set_result(facts, at, scalar_u8()); } else { set_result(facts, at, scalar_u64()); };
    (facts[at].text_intrinsic <- intrinsic_kind):void;
    return 0u8;
}

func remember_native_result(facts:OperandFacts in F, at:u64, native_kind:u8, module:u64,
    identity:u64) -> u8
    where {owner F} {
    val kind <- declared_scalar(native_kind);
    if (kind == 0u8) return unproved_result_contract();
    set_fact(facts, at, kind, independent_value(), no_node(), identity, 0u8);
    facts[at].identity_module <- module;
    return 0u8
}

func check_prepared_here_call(nodes:const ExprNodes in N, links:const NameWork in L,
                              facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner L, owner F} {
    ref supplied = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, links[at].active, supplied) != HereReady ||
        supplied.call != at) return unproved_call_target();
    return remember_native_result(facts, at, links[at].value_kind, links[at].value_module,
                                  links[at].value_identity)
}

func check_prepared_native_text(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    input:u64, used:u64, revision:u64) -> u8 where {const owner N, const owner F} {
    val literal <- text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, input));
    if (literal == InteriorNulLiteral) return interior_literal_nul();
    if (facts[input].kind != c_string_kind() && literal != NulFreeLiteral)
        return c_string_operand_required();
    if (facts[input].reception != borrowed_ref() || facts[input].owner == no_node() ||
        facts[input].target_readonly == 0u8) return unproved_owner();
    return 0u8
}

func check_prepared_native_view(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const OperandFacts in F, views:const SuppliedViews in H, call:u64,
    input:u64, module:u64, identity:u64, readonly:bool, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner F, const owner H} {
    val value <- ungrouped(nodes, revision, used, input);
    if (value >= used || facts[value].kind != source_array_loan() ||
        facts[value].identity_module != module || facts[value].identity != identity)
        return wrong_operand_type();
    if (facts[value].reception != borrowed_ref() || facts[value].owner >= used)
        return unproved_owner();
    if (!readonly && facts[value].target_readonly != 0u8) return expected_writable_place();
    if (names[value].kind == formal_binding()) return 0u8;
    val binding <- names[value].declaration;
    if (names[value].kind != here_receiver_binding() || binding >= used) return unproved_owner();
    return case views[binding] of {
        SuppliedArrayView { val body <- body; } -> {
            if (body < used && syntax_first(nodes, used, body) <= syntax_first(nodes, used, call) &&
                syntax_past(nodes, used, call) <= syntax_past(nodes, used, body) &&
                enclosing_callable(nodes, names, names[body].scope) ==
                    enclosing_callable(nodes, names, names[call].scope)) { 0u8 }
            else { unproved_owner() }
        };
        _ -> unproved_owner()
    }
}

func first_native_role(links:const NameWork in L, views:const SuppliedViews in H,
    first:u64, argument:u64, position:u64, role:u64) -> u64
    where {const owner L, const owner H} {
    val previous <- first;
    for (unused in 0u64 .. position) {
        if (previous >= argument) return no_node();
        if (case views[previous] of {
            ImportedNativeOperand { val earlier <- owner_role; } -> earlier == role;
            _ -> false
        }) return previous;
        previous <- links[previous].next
    };
    return argument
}

func check_prepared_native_operand(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    at:u64, argument:u64, first:u64, position:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    val input <- ordinary_argument_value(nodes, used, revision, argument);
    if (input >= argument) return invalid_operand_tree();
    val owner_site <- no_node();
    val view <- no_node();
    val diagnostic <- 0u8;
    return case views[argument] of {
        ImportedNativeOperand {
            val expected_call <- call_site; val origin <- revision; val ordinal <- position;
            val expected_input <- input; val kind <- kind; val role <- owner_role;
            val owner <- owner_site; val module <- type_module; val identity <- type_identity;
            val readonly <- target_readonly; val const_owner <- owner_readonly;
        } -> {
            if (expected_call != at || origin != revision || ordinal != position ||
                expected_input != input) return unproved_call_target();
            if (facts[input].kind == never_result()) {
                set_result(facts, argument, never_result());
                return 0u8
            };
            if (kind == c_handle_type()) {
                if (owner >= used) return unproved_owner();
                set_fact(facts, argument, source_handle_loan(), borrowed_ref(), owner, identity, 0u8);
                facts[argument].identity_module <- module;
                (facts[argument].target_readonly <- if (readonly) { 1u8 } else { 0u8 }):void
            } else {
                if (kind == array_type()) {
                    diagnostic <- check_prepared_native_view(nodes, names, facts, views, at,
                        input, module, identity, readonly, used, revision);
                    if (diagnostic != 0u8) return diagnostic;
                    view <- ungrouped(nodes, revision, used, input);
                    copy_fact(facts, argument, view)
                } else {
                    if (kind != builtin_c_string()) return wrong_operand_type();
                    diagnostic <- check_prepared_native_text(nodes, facts, input, used, revision);
                    if (diagnostic != 0u8) return diagnostic;
                    copy_fact(facts, argument, input)
                }
            };
            owner_site <- facts[argument].owner;
            diagnostic <- check_owner_access(nodes, owner_site, !const_owner);
            if (diagnostic != 0u8) return diagnostic;
            view <- first_native_role(links, views, first, argument, position, role);
            if (view == no_node()) return invalid_operand_tree();
            if (facts[view].owner != owner_site) return owner_conflict(nodes, facts[view].owner, owner_site);
            0u8
        };
        _ -> unsupported_imported_call()
    }
}

func check_prepared_native_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    at:u64, arguments:u64, arity:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    ref first = make u64 { no_node() };
    if (arity > at || !first_sequence_entry(nodes, revision, at, arguments, ArgumentSequence,
        first)) return invalid_operand_tree();
    val argument <- first;
    val diagnostic <- 0u8;
    for (position in 0u64 .. arity) {
        if (argument >= at) return invalid_operand_tree();
        diagnostic <- check_prepared_native_operand(nodes, names, links, facts, views, at,
            argument, first, position, used, revision);
        if (diagnostic != 0u8) return diagnostic;
        if (facts[argument].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        argument <- links[argument].next
    };
    if (argument != no_node()) return invalid_operand_tree();
    return remember_native_result(facts, at, links[at].value_kind,
                                  links[at].value_module, links[at].value_identity)
}

func check_prepared_native_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    selected_module:u64, selected_definition:u64, at:u64, arguments:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    return case views[at] of {
        PreparedImportedNativeOperation {
            val module <- module; val definition <- definition;
            val origin <- revision; val activation <- activation; val arity <- arity;
        } -> {
            if (module != selected_module || definition != selected_definition || origin != revision ||
                activation != enclosing_callable(nodes, names, names[at].scope))
                return unproved_call_target();
            check_prepared_native_arguments(nodes, names, links, facts, views, at, arguments,
                                            arity, used, revision)
        };
        _ -> { return unsupported_imported_call(); }
    }
}

func check_direct_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       selected:const SelectedExports in E, facts:OperandFacts in F,
                       owners:CallOwners in O, views:const SuppliedViews in H, at:u64, callee:u64,
                           arguments:u64, used:u64, revision:u64, source_only:bool) -> u8
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner O,
        const owner H} {
    if (names[callee].kind == ordinary_selection()) {
        val site <- names[callee].declaration;
        if (selected[site].kind == callable_export()) {
            if (links[at].expects_here != 0u8)
                return check_prepared_here_call(nodes, links, facts, at, used, revision);
            if (source_only && selected[site].shape != ordinary_callable_shape())
                return check_prepared_native_loans(nodes, names, links, facts, views,
                    selected[site].origin_module, selected[site].identity, at, arguments, used,
                    revision);
            return check_imported_call(nodes, names, links, facts, at, arguments, used, revision)
        };
        return check_text_intrinsic(nodes, links, facts, at, arguments, selected[site].kind, used, revision);
    };
    if (names[callee].kind == formal_binding()) {
        val callback <- names[callee].declaration;
        ref contract = make HereContract {
            first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity
                <- 0u64
        };
        if (callback >= used || prepared_here_formal(views, at) != callback ||
            !inspect_here_contract(views, callback, contract)) return unproved_call_target();
        return remember_native_result(facts, at, contract.result_kind, contract.result_module,
            contract.result_identity)
    };
    if (names[callee].kind == c_operation()) {
        if (links[at].expects_here != 0u8)
            return check_prepared_here_call(nodes, links, facts, at, used, revision);
        val provider <- names[callee].declaration;
        if (provider >= used || !prepared_native_operation(views, at,
            provider)) return unproved_call_target();
        return remember_native_result(facts, at, links[at].value_kind, links[at].value_module,
            links[at].value_identity)
    };
    if (names[callee].kind != callable_binding()) return unproved_call_target();
    val definition <- names[callee].declaration;
    if (links[definition].next_method != no_node()) return unsupported_transfer_signature();
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    ref formal = make u64 { no_node() };
    ref argument = make u64 { no_node() };
    if (!callable_formals(nodes, revision, used, definition, source_only, formal) ||
        !first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, argument)) return invalid_operand_tree();
    val result_owner <- facts[definition].owner;
    val allow_owned_loan <- source_only &&
        (scalar_kind(facts[definition].kind) || facts[definition].kind == source_u32() ||
            facts[definition].kind == void_result()) &&
        facts[definition].reception != borrowed_ref();
    val loans_owning_handle <- false;
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (formal == no_node() || argument == no_node()) {
            if (formal != argument) return wrong_argument_count();
            copy_fact(facts, at, definition);
            if (facts[definition].reception == borrowed_ref()) {
                if (owners[result_owner].call_site != at) return unproved_owner();
                (facts[at].owner <- owners[result_owner].actual_owner):void;
            };
            facts[at].call_definition <- definition;
            facts[at].loans_owning_handle <- loans_owning_handle;
            return 0u8;
        } else {};
        diagnostic <- check_argument(nodes, names, selected, links, facts, owners, argument,
            formal, at, used, revision, allow_owned_loan);
        if (diagnostic != 0u8) return diagnostic;
        loans_owning_handle <- loans_owning_handle || facts[argument].loans_owning_handle;
        formal <- links[formal].next;
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func check_imported_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:OperandFacts in F, at:u64, arguments:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F} {
    if (links[at].imported_interface == no_node() || links[at].imported_callable_kind ==
        NoCallableKind)
        return unsupported_imported_call();
    if (links[at].imported_callable_kind == CheckedProcedure && is_function(nodes,
        enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val result_owner <- links[at].imported_owner_argument;
    val returned_kind <- links[at].imported_kind;
    ref argument = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, argument)) return invalid_operand_tree();
    val diagnostic <- 0u8;
    val witness <- no_node();
    val actual <- no_node();
    val value <- no_node();
    for (unused in 0u64 .. used) {
        if (argument == no_node()) {
            if (result_owner != no_node()) {
                set_fact(facts, at, returned_kind, borrowed_ref(), facts[result_owner].owner, 0u64, 0u8);
                facts[at].target_readonly <- links[at].imported_target_readonly;
                if (returned_kind == c_string_kind()) { (facts[at].text_nul <- nul_absent()):void; };
            } else {
                set_result(facts, at, returned_kind);
            };
            return 0u8;
        };
        if (links[argument].imported_kind == source_handle_loan()) {
            value <- ordinary_argument_value(nodes, used, revision, argument);
            if (value >= used || checked_ref_argument(nodes, argument) ||
                facts[value].kind != source_handle_loan() ||
                    facts[value].reception != borrowed_ref() ||
                facts[value].identity_module != links[argument].imported_type_module ||
                facts[value].identity != links[argument].imported_type_identity)
                return wrong_operand_type();
            if (facts[value].target_readonly != 0u8 &&
                links[argument].imported_target_readonly == 0u8)
                return expected_writable_place();
            copy_fact(facts, argument, value)
        } else {
            diagnostic <- check_argument_operand(nodes, facts, argument,
                links[argument].imported_kind,
                links[argument].imported_reception, 0u64, 0u64, links[argument].imported_target_readonly,
                used, revision);
            if (diagnostic != 0u8) return diagnostic
        };
        witness <- links[argument].imported_owner_argument;
        if (witness != no_node()) {
            actual <- facts[argument].owner;
            diagnostic <- check_owner_access(nodes, actual, links[argument].imported_owner_readonly == 0u8);
            if (diagnostic != 0u8) return diagnostic;
            if (argument != witness && facts[witness].owner != actual)
                return owner_conflict(nodes, facts[witness].owner, actual);
            if (links[argument].imported_passes_owner != 0u8) {
                facts[argument].owner_chain <- 0u64;
                (facts[actual].owner_chain <- 0u64):void;
            } else {};
        };
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func argument_at_position(links:const NameWork in L, first:u64, position:u64) -> u64 where {const owner L} {
    if (position == no_node()) return no_node();
    val argument <- first;
    for (index in 0u64 .. position) {
        if (argument == no_node()) return no_node();
        argument <- links[argument].next;
    };
    return argument;
}

func first_handle_formal(contracts:const ModuleInterfaces in I, header:u64, role:u64)
    -> u64 where {const owner I} {
    val row <- 0u64;
    for (position in 0u64 .. contracts[header].entry_count) {
        row <- header + 1u64 + position;
        if (contracts[row].value_kind == c_handle_type() && contracts[row].owner_role == role)
            return position
    };
    return no_node()
}

func bind_imported_call(nodes:const ExprNodes in N, links:NameWork in L, contracts:const ModuleInterfaces in I,
                        at:u64, header:u64, arguments:u64, used:u64, revision:u64,
                            source_handles:bool)
    -> bool where {const owner N, owner L, const owner I} {
    ref first = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, first)) return false;
    val argument <- first;
    val row <- header + 1u64;
    val handles <- false;
    val role <- no_node();
    val kind <- 0u8;
    for (index in 0u64 .. contracts[header].entry_count) {
        if (argument == no_node()) return false;
        kind <- contracts[row].value_kind;
        handles <- source_handles && kind == c_handle_type();
        links[argument].imported_kind <- if (source_handles) {
            if (handles) { source_handle_loan() } else { source_scalar_kind(kind) }
        } else { kind };
        links[argument].imported_reception <- if (source_handles) {
            if (handles) { borrowed_ref() } else { local_place() }
        } else { (contracts[row].native_reception) };
        links[argument].imported_target_readonly <- contracts[row].target_readonly;
        links[argument].imported_owner_readonly <- contracts[row].owner_readonly;
        links[argument].imported_passes_owner <- contracts[row].native_passes_owner;
        role <- contracts[row].owner_role;
        if (handles) {
            links[argument].imported_type_module <- contracts[row].type_module;
            (links[argument].imported_type_identity <- contracts[row].type_identity):void
        };
        links[argument].imported_owner_argument <- argument_at_position(links, first,
            if (handles) { first_handle_formal(contracts, header, role) } else { role });
        argument <- links[argument].next;
        (row <- row + 1u64):void;
    };
    if (argument != no_node()) return false;
    links[at].imported_owner_argument <- argument_at_position(links, first,
        contracts[header].owner_role);
    return true;
}

func remember_imported_call(links:NameWork in L, contracts:const ModuleInterfaces in I,
                            at:u64, header:u64, source_handles:bool) -> void where {owner L,
                                const owner I} {
    links[at].imported_interface <- header;
    links[at].imported_function <- contracts[header].native_function;
    val result <- contracts[header].result_kind;
    links[at].imported_kind <- if (source_handles) {
        if (result == builtin_void()) { void_result() } else { source_scalar_kind(result) }
    } else { result };
    links[at].imported_callable_kind <- contracts[header].callable_kind;
    links[at].imported_target_readonly <- contracts[header].target_readonly;
    links[at].imported_failure <- contracts[header].failure_identity;
    links[at].imported_failure_module <- contracts[header].failure_module;
    links[at].imported_failure_checked <- contracts[header].failure_checked;
    return
}

func valid_imported_failure(contracts:const ModuleInterfaces in I, published:u64,
                            catalog:const ModuleExports in B, module:u64, declaration:u64,
                                checked:u8) -> bool
    where {const owner I, const owner B} {
    if (declaration == no_node() || checked > 1u8) return false;
    if (module == 0u64) {
        for (row in 0u64 .. intrinsic (len)(catalog)) {
            if (catalog[row].origin_module == 0u64 && catalog[row].kind == exception_type_export()
                &&
                catalog[row].identity == declaration && catalog[row].checked == checked) return true
        };
        return false
    };
    val header <- find_interface(contracts, published, module, declaration);
    if (header == no_node() || contracts[header].interface_kind != record_type()) return false;
    val schema <- contracts[header].exception_schema;
    return if (checked == 1u8) { schema == CheckedExceptionSchema }
        else { schema == UncheckedExceptionSchema }
}

func scalar_source_call(contracts:const ModuleInterfaces in I,
    header:u64) -> bool where {const owner I} {
    val result <- contracts[header].result_kind;
    if ((!native_scalar(result) && result != void_result()) ||
        contracts[header].owner_role != no_node() ||
        contracts[header].owner_count != 0u64 || contracts[header].has_here != 0u8 ||
        contracts[header].callable_kind == NoCallableKind) return false;
    for (row in header + 1u64 .. header + 1u64 + contracts[header].entry_count) {
        if (contracts[row].interface_kind != 0u8 || !native_scalar(contracts[row].value_kind) ||
            contracts[row].native_reception != local_place() ||
                contracts[row].owner_role != no_node()) return false
    };
    return true
}

func source_handle_call(contracts:const ModuleInterfaces in I, published:u64, header:u64)
    -> bool where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return false;
    val arity <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    if (contracts[header].interface_kind != callable_binding() ||
        contracts[header].native_function != no_node() ||
        contracts[header].owner_role != no_node() ||
        contracts[header].has_here != 0u8 || contracts[header].callable_kind == NoCallableKind ||
        owners == 0u64 || arity >= published - header ||
        (!source_call_scalar(result) && result != builtin_void())) return false;
    val has_handle <- false;
    val kind <- 0u8;
    for (row in header + 1u64 .. header + 1u64 + arity) {
        if (contracts[row].interface_kind != 0u8 || contracts[row].native_reception != 0u8 ||
            contracts[row].native_passes_owner != 0u8 || contracts[row].target_readonly > 1u8 ||
            contracts[row].owner_readonly > 1u8) return false;
        kind <- contracts[row].value_kind;
        if (kind == c_handle_type()) {
            if (contracts[row].owner_role >= owners || contracts[row].type_module == 0u64 ||
                contracts[row].type_identity == no_node()) return false;
            (has_handle <- true):void
        } else {
            if (!source_call_scalar(kind) || contracts[row].owner_role != no_node()) return false
        }
    };
    return has_handle
}

func prepare_imported_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, links:NameWork in L,
                            contracts:const ModuleInterfaces in I, interface_count:u64,
                            catalog:const ModuleExports in C, views:const CallableUseProofs in U,
                            used:u64, revision:u64, source_only:bool, required:u64 in D,
                            at:u64, call:const DirectCallSites in V,
                                report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner L, const owner I, const owner C,
           const owner U, owner D, const owner V, owner R} {
    val callee <- call.callee;
    if (names[callee].kind != ordinary_selection()) return true;
    val site <- names[callee].declaration;
    if (selected[site].kind != callable_export() ||
        selected[site].shape != ordinary_callable_shape()) return true;
    val obligation <- selected[site].checked != 0u8;
    val header <- find_interface(contracts, interface_count, selected[site].origin_module,
        selected[site].identity);
    val handles <- source_only && source_handle_call(contracts, interface_count, header);
    if (source_only && !obligation && !handles) return true;
    if (header == no_node() || contracts[header].interface_kind != callable_binding()) {
        if (obligation || !source_only) return operand_problem(report, at, unsupported_imported_call());
        return true
    };
    if (obligation && !valid_imported_failure(contracts, interface_count, catalog,
            contracts[header].failure_module, contracts[header].failure_identity,
                contracts[header].failure_checked))
        return operand_problem(report, at, unsupported_imported_call());
    if (handles && !obligation &&
        (contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64
            ||
         contracts[header].failure_checked != 0u8))
        return operand_problem(report, at, unsupported_imported_call());
    if (!source_only && !matches_object_call(views, selected[site].checked_resource,
        revision, selected[site].selection_site, selected[site].selection_public_row,
        selected[site].dependency_module, selected[site].origin_module, selected[site].identity,
        contracts[header].native_function)) return operand_problem(report, at, unproved_call_target());
    if (source_only && contracts[header].has_here == 1u8) {
        if (links[at].expects_here != 1u8 || links[at].active == no_node())
            return operand_problem(report, at, unsupported_imported_call())
    } else {
        if (source_only && !handles && !scalar_source_call(contracts, header))
            return operand_problem(report, at, unsupported_imported_call());
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used,
            revision, handles))
            return operand_problem(report, at, wrong_argument_count())
    };
    remember_imported_call(links, contracts, at, header, handles);
    if (obligation && required == no_node()) { (required <- at):void };
    return true
}

export func prepare_imported_calls(nodes:const ExprNodes in N, names:const NameBindings in B,
                                  selected:const SelectedExports in E, links:NameWork in L,
                                  contracts:const ModuleInterfaces in I, interface_count:u64,
                                  catalog:const ModuleExports in C, views:const CallableUseProofs in V,
                                  used:u64, revision:u64, source_only:bool, required:u64 in D,
                                  report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner L, const owner I, const owner C, const owner V,
        owner D, owner R} {
    required <- no_node();
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    for (at in 0u64 .. used) {
        if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady &&
            !prepare_imported_call(nodes, names, selected, links, contracts, interface_count,
                catalog, views, used, revision, source_only, required, at, call, report)) return false
    };
    return true
}

func native_scalar(kind:u8) -> bool { return scalar_kind(kind) && kind != scalar_enum(); }

func first_owner_parameter(links:const NameWork in L, facts:const OperandFacts in F,
                           first:u64, owner_site:u64, limit:u64) -> u64
    where {const owner L, const owner F} {
    val formal <- first;
    for (position in 0u64 .. limit) {
        if (formal == no_node()) return no_node();
        if (facts[formal].owner == owner_site) return position;
        formal <- links[formal].next;
    };
    return no_node();
}

func native_callable_arity(nodes:const ExprNodes in N, links:const NameWork in L,
                           facts:const OperandFacts in F, definition:u64, first:u64, used:u64, revision:u64) -> u64
    where {const owner N, const owner L, const owner F} {
    val kind <- facts[definition].kind;
    if (immutable_text_kind(kind)) {
        if (first_owner_parameter(links, facts, first,
                                  facts[definition].owner, used) == no_node()) return no_node();
    } else {
        if (!native_scalar(kind) && kind != void_result()) return no_node();
    };
    return native_parameter_count(nodes, links, facts, first, used, revision);
}

func native_parameter_count(nodes:const ExprNodes in N, links:const NameWork in L,
                            facts:const OperandFacts in F, first:u64, used:u64, revision:u64) -> u64
    where {const owner N, const owner L, const owner F} {
    val formal <- first;
    val count <- 0u64;
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return count;
        if (!native_parameter(nodes, facts, formal, used, revision)) return no_node();
        count <- count + 1u64;
        formal <- links[formal].next;
    };
    return no_node();
}

func native_parameter(nodes:const ExprNodes in N, facts:const OperandFacts in F, formal:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner F} {
    val kind <- facts[formal].kind;
    val mode <- facts[formal].reception;
    ref syntax = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (inspect_formal(nodes, revision, used, formal, syntax) != OrdinaryFormal) return false;
    if (mode == local_place())
        return native_scalar(kind) && (syntax.mode == ValueFormal || syntax.mode == ExplicitValueFormal);
    if (facts[formal].writable_text_place != 0u8) return false;
    if (mode == borrowed_ref()) return native_scalar(kind) || immutable_text_kind(kind);
    return mode == nullable_ptr() && native_scalar(kind);
}

export func first_declared_failure(nodes:const ExprNodes in N, used:u64,
    revision:u64) -> u64 where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <-
        false; };
    ref failure = make u64 { no_node() };
    for (at in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, at, callable) == ModuleCallable) {
            if (!find_signature_clause(nodes, revision, used, callable.signature,
                ThrowsSignatureClause, failure)) return at;
            if (failure != no_node()) return at
        }
    };
    return no_node()
}

export func append_callable_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                                   links:const NameWork in L, facts:const OperandFacts in F,
                                       used:u64, revision:u64,
                                   module_id:u64, base:u64, start:u64,
                                       contracts:ModuleInterfaces in I,
                                   report:OperandCheckResult in R) -> u64
    where {const owner N, const owner B, const owner L, const owner F, owner I, owner R} {
    if (start > intrinsic (len)(contracts)) return no_node();
    val source_only <- base == no_node();
    val count <- start;
    val arity <- no_node();
    val formal <- no_node();
    val header <- no_node();
    val staged_source_call <- false;
    ref first = make u64 { no_node() };
    ref failure = make u64 { no_node() };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    for (at in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, at,
            callable) == ModuleCallable && names[at].declaration == at) {
            if (!find_signature_clause(nodes, revision, used, callable.signature,
                ThrowsSignatureClause, failure)) {
                operand_problem(report, at, invalid_operand_tree());
                return no_node()
            };
            header <- if (source_only && failure != no_node()) {
                find_interface(contracts, count, module_id, at)
            } else { no_node() };
            staged_source_call <- header != no_node() &&
                contracts[header].interface_kind == callable_binding() &&
                (contracts[header].has_here == 1u8 || source_handle_call(contracts, count, header));
            if (!staged_source_call && (!source_only || failure != no_node()) &&
                links[at].next_method == no_node()) {
                if (!callable_formals(nodes, revision, used, at, false, first)) return no_node();
                arity <- native_callable_arity(nodes, links, facts, at, first, used, revision)
            } else { arity <- no_node() };
            if (source_only && failure != no_node() && !staged_source_call && arity == no_node()) {
                operand_problem(report, at, unsupported_imported_call());
                return no_node()
            };
            if (arity != no_node()) {
                if (arity + 1u64 > intrinsic (len)(contracts) - count) return no_node();
                write_interface_header(contracts[count], module_id, at, callable_binding(), facts[at].kind, arity);
                contracts[count].membership <- (FixedMethods:FamilyMembership);
                if (!source_only) { (contracts[count].native_function <- base + at):void };
                contracts[count].callable_kind <- if (callable.function_form) {
                    CheckedFunction:InterfaceCallableKind
                } else { CheckedProcedure:InterfaceCallableKind };
                if (!find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause, failure)) return no_node();
                # The root Exception has an identity of its own. Use an absent
                # node for an ordinary callable with no declared failure.
                contracts[count].failure_identity <- if (failure == no_node()) { no_node() } else { (facts[failure].identity) };
                if (failure != no_node()) {
                    contracts[count].failure_module <- facts[failure].identity_module;
                    (contracts[count].failure_checked <- facts[failure].checked_exception):void;
                };
                if (facts[at].reception == borrowed_ref()) {
                    contracts[count].target_readonly <- facts[at].target_readonly;
                    (contracts[count].owner_role <- first_owner_parameter(links, facts, first, facts[at].owner, arity)):void;
                };
                formal <- first;
                for (row in count + 1u64 .. count + 1u64 + arity) {
                    publish_native_parameter(nodes, links, facts, first, formal, arity,
                        contracts[row]);
                    (formal <- links[formal].next):void;
                };
                if (source_only && !scalar_source_call(contracts, count)) {
                    operand_problem(report, at, unsupported_imported_call());
                    return no_node()
                };
                count <- count + 1u64 + arity
            };
        };
    };
    return count;
}

func publish_native_parameter(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                              first:u64, formal:u64, arity:u64, row:ModuleInterfaceRow in I) -> void
    where {const owner N, const owner L, const owner F, owner I} {
    write_interface_header(row, 0u64, 0u64, 0u8, 0u8, 0u64);
    row.value_kind <- facts[formal].kind;
    row.native_reception <- facts[formal].reception;
    row.target_readonly <- facts[formal].target_readonly;
    if (row.native_reception == local_place()) return;
    val binder <- facts[formal].owner;
    # A role is the position of the first parameter that establishes this owner.
    row.owner_role <- first_owner_parameter(links, facts, first, binder, arity);
    row.owner_readonly <- if (owner_constraint_syntax(nodes, binder) == ReadonlyOwnerConstraint) { 1u8 } else { 0u8 };
    row.native_passes_owner <- if (facts[formal].passes_owner != 0u8 && facts[binder].owner_chain != no_node()) {
        1u8
    } else { 0u8 };
    return;
}

func check_symbolic_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                         selected:const SelectedExports in E, facts:OperandFacts in F,
                         at:u64, callee:u64, argument:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner E, owner F} {
    if (names[callee].kind != symbolic_selection()) return unproved_call_target();
    val site <- names[callee].declaration;
    if (selected[site].kind != symbol_export() || selected[site].identity != print_export_identity())
        return unproved_call_target();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
        entry.previous != no_node()) return wrong_argument_count();
    val diagnostic <- require_bits(nodes, facts, entry.item);
    if (diagnostic != 0u8) return diagnostic;
    scalar_fact(facts, argument, independent_value(), no_node());
    only_void(facts, at);
    return 0u8;
}

func result_kind(nodes:const ExprNodes in N, facts:OperandFacts in F, value:u64, read:bool) -> u8
    where {const owner N, owner F} {
    if (value == no_node()) return void_result();
    val kind <- facts[value].kind;
    if (kind == source_u32()) {
        if (read && require_source_u32(nodes, facts, value, false) != 0u8) return 0u8;
        return kind
    };
    if (read && scalar_kind(kind) && require_typed_bits(nodes, facts, value, kind) != 0u8) return 0u8;
    if (scalar_kind(kind) || kind == void_result() || kind == never_result()) return kind;
    if (!read && immutable_text_kind(kind)) return kind;
    return 0u8;
}

func set_result(facts:OperandFacts in F, at:u64, kind:u8) -> void where {owner F} {
    if (scalar_kind(kind) || kind == source_u32()) {
        set_fact(facts, at, kind, independent_value(), no_node(), 0u64, 0u8)
    } else {
        set_fact(facts, at, kind, 0u8, no_node(), 0u64, 0u8);
    };
}

func set_bits_result(facts:OperandFacts in F, at:u64, value:u64) -> void where {owner F} {
    set_fact(facts, at, facts[value].kind, independent_value(), no_node(), facts[value].identity, 0u8);
    facts[at].identity_module <- facts[value].identity_module;
    return
}

func explicit_discard() -> u8 { return 1u8; }
func loop_discard() -> u8 { return 2u8; }

# List entries carry the reached normal tail type. Explicit discard still
# checks that type, without imposing a read of the tail's target.
func check_sequence_item(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, entry:const SequenceEntry in E) -> void
    where {const owner N, owner F, const owner E} {
    val previous <- entry.previous;
    if (previous != no_node() && facts[previous].kind == never_result()) {
        set_result(facts, at, never_result());
        return;
    } else {};
    val expression <- entry.item;
    if (facts[expression].kind == never_result()) { set_result(facts, at, never_result()); return; } else {};
    val kind <- void_result();
    if (!binds_local_storage(nodes, expression)) {
        if (facts[at].arm_result != 0u8 && scalar_kind(facts[expression].kind)) {
            copy_fact(facts, at, expression);
            return;
        } else {};
        (kind <- result_kind(nodes, facts, expression, facts[at].discarded_result == 0u8)):void;
    } else {};
    if (scalar_kind(kind)) { set_bits_result(facts, at, expression); }
    else { set_result(facts, at, kind); };
}

func sequence_result(facts:const OperandFacts in F, tail:u64) -> u8 where {const owner F} {
    if (tail == no_node()) return void_result();
    return facts[tail].kind;
}

# Abrupt paths add no normal result to a full scope or try expression.
func merge_result(facts:OperandFacts in F, at:u64, kind:u8, identity:u64) -> u8 where {owner F} {
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind != 0u8 &&
        (facts[at].kind != kind || (kind == scalar_enum() && facts[at].identity != identity)))
        return unproved_result_contract();
    if (kind == scalar_enum()) { set_fact(facts, at, kind, independent_value(), no_node(), identity, 0u8); }
    else { set_result(facts, at, kind); };
    return 0u8;
}

func merge_arm_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, arm:u64, discard:bool) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (discard && facts[at].discarded_result == loop_discard())
        return merge_result(facts, at, void_result(), 0u64);
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind == 0u8) {
        copy_fact(facts, at, arm);
        return 0u8;
    } else {};
    if (!same_operand_type(facts, at, arm)) return unproved_result_contract();
    val left <- facts[at].reception;
    val right <- facts[arm].reception;
    val nullable <- left == nullable_ptr() || right == nullable_ptr();
    if (kind == void_result() || left == independent_value() || right == independent_value()) {
        if (nullable) return unproved_nonnull_borrow();
        if (scalar_kind(kind)) { set_bits_result(facts, at, arm); } else { set_result(facts, at, kind); };
        return 0u8;
    } else {};
    val identity <- facts[at].identity;
    val owner_site <- facts[at].owner;
    if (owner_site == no_node() || facts[arm].owner == no_node()) return unproved_owner();
    if (owner_site != facts[arm].owner) return owner_conflict(nodes, owner_site, facts[arm].owner);
    val readonly <- if (facts[at].target_readonly != 0u8 || facts[arm].target_readonly != 0u8) { 1u8 } else { 0u8 };
    val reservation <- facts[at].reservation;
    if (reservation != facts[arm].reservation) return unproved_reservation_selection();
    val reception <- if (nullable) { nullable_ptr() } else { borrowed_ref() };
    val present <- facts[at].target_presence;
    val selected <- facts[at].selection;
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].target_readonly <- readonly;
    facts[at].reservation <- reservation;
    if (present == facts[arm].target_presence) { (facts[at].target_presence <- present):void; } else {};
    if (selected == facts[arm].selection) { (facts[at].selection <- selected):void; } else {};
    return 0u8;
}

func check_conditional(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, branch:const ConditionalSites in C) -> u8
    where {const owner N, owner F, const owner C} {
    val condition <- branch.test;
    if (facts[condition].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (require_typed_bits(nodes, facts, condition, scalar_bool()) != 0u8) return expected_boolean_condition();
    val diagnostic <- merge_arm_result(nodes, facts, at, branch.consequent, true);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- merge_arm_result(nodes, facts, at, branch.alternative, true);
    if (diagnostic == 0u8 && facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
    return diagnostic;
}

# Remaining canonical members are tracked by count and exclusion markers.
# A possible write through another view starts a fresh scan generation.
data CaseCoverage {
    total:u64;
    remaining:u64;
    absent:bool;
    only:u64;
    generation:u64;
    exclusions:u64;
}

# A case proof belongs to a saved address. An enclosing proof for another
# pointer, including one with the same declared owner, cannot supply it.
export func selected_target_presence(facts:const OperandFacts in F, at:u64) -> u8 where {const owner F} {
    val presence <- facts[at].target_presence;
    val selection <- facts[at].selection;
    if (presence != unknown_target() || selection == no_node()) return presence;
    val header <- facts[at].case_context;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (header == no_node()) return presence;
        if (facts[header].case_selection == selection &&
            facts[header].case_presence != unknown_target()) return facts[header].case_presence;
        header <- facts[header].case_context;
    };
    return presence;
}

func enter_case_context(facts:OperandFacts in F, outer:u64, header:u64) -> u64 where {owner F} {
    facts[header].case_context <- outer;
    return header;
}

func case_has_paths(coverage:const CaseCoverage in V) -> bool where {const owner V} {
    return coverage.absent || coverage.remaining != 0u64;
}

func case_presence(present:bool, absent:bool) -> u8 {
    if (present && !absent) return present_target();
    if (absent && !present) return absent_target();
    return unknown_target();
}

func initialize_case_coverage(nodes:const ExprNodes in N, names:const NameBindings in B,
                              links:const NameWork in L, facts:OperandFacts in F, at:u64, subject:u64,
                              coverage:CaseCoverage in V, used:u64, revision:u64) -> bool
    where {const owner N, const owner B, const owner L, owner F, owner V} {
    val kind <- facts[subject].kind;
    if (kind == never_result()) return true;
    val present <- selected_target_presence(facts, subject);
    coverage.absent <- present != present_target();
    if (present == absent_target()) return true;
    if (kind == scalar_bool()) {
        coverage.total <- 2u64;
        coverage.remaining <- 2u64;
        if (facts[subject].reception == independent_value()) {
            val behavior <- case_condition(nodes, facts, subject, used, revision);
            if (behavior == case_guard_passes() || behavior == case_guard_declines()) {
                coverage.only <- if (behavior == case_guard_passes()) { at } else { subject };
                (coverage.remaining <- 1u64):void;
            } else {};
        } else {};
        return true;
    } else {};
    val domain <- facts[subject].identity;
    ref enumeration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref member = make u64 { no_node() };
    if (inspect_declaration(nodes, revision, used, domain, enumeration) != EnumTypeDeclaration ||
        !first_sequence_entry(nodes, revision, used, enumeration.entries, EnumSequence, member)) return false;
    for (unused in 0u64 .. used) {
        if (member == no_node()) { (coverage.remaining <- coverage.total):void; return true; } else {};
        if (names[member].declaration == member) { (coverage.total <- coverage.total + 1u64):void; } else {};
        member <- links[member].next;
    };
    return false;
}

func reopen_case_domain(coverage:CaseCoverage in V, generation:u64) -> void where {owner V} {
    coverage.only <- no_node();
    coverage.generation <- generation;
    (coverage.remaining <- coverage.total):void;
}

func case_may_write(nodes:const ExprNodes in N, links:const NameWork in L,
                    at:u64, used:u64, revision:u64) -> bool where {const owner N, const owner L} {
    if (at == no_node()) return false;
    if (at >= used || at >= syntax_len(nodes)) return true;
    case nodes[at] of {
        (Vacant) -> { return true; };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (BooleanLiteral) -> { return false; };
                (IntegerLiteral) -> { return false; };
                (NameReference) -> { return false; };
                (NullLiteral) -> { return false; };
                (CaseFallthrough) -> { return false; };
                (DiscardedExpression { val operand <- operand; }) -> {
                    return !published_syntax_id(nodes, revision, at, operand) ||
                        case_may_write(nodes, links, operand.index, used, revision);
                };
                (_) -> {};
            };
        };
    };
    ref inner = make u64 { no_node() };
    if (inspect_group(nodes, revision, used, at, inner) == ParenthesizedExpression)
        return case_may_write(nodes, links, inner, used, revision);
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr)
        return case_may_write(nodes, links, logical.left_operand, used, revision) ||
            case_may_write(nodes, links, logical.right_operand, used, revision);
    ref tail = make u64 { no_node() };
    if (block_tail(nodes, revision, used, at, tail) && !is_scope_block(nodes, at))
        return case_block_may_write(nodes, links, tail, used, revision);
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    if (inspect_type_assertion(nodes, revision, used, at, assertion))
        return case_may_write(nodes, links, assertion.operand, used, revision);
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch))
        return case_may_write(nodes, links, branch.test, used, revision) ||
            case_may_write(nodes, links, branch.consequent, used, revision) ||
            case_may_write(nodes, links, branch.alternative, used, revision);
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val operation_kind <- inspect_binary(nodes, revision, used, at, binary);
    if (operation_kind == ArithmeticBinary || operation_kind == ComparisonBinary)
        return case_may_write(nodes, links, binary.left_operand, used, revision) ||
            case_may_write(nodes, links, binary.right_operand, used, revision);
    return true;
}

func case_block_may_write(nodes:const ExprNodes in N, links:const NameWork in L,
                          tail:u64, used:u64, revision:u64) -> bool where {const owner N, const owner L} {
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return true;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. used) {
        if (item == no_node()) return false;
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence ||
            case_may_write(nodes, links, entry.item, used, revision)) return true;
        item <- links[item].next;
    };
    return true;
}

func case_condition(nodes:const ExprNodes in N, facts:OperandFacts in F,
                    at:u64, used:u64, revision:u64) -> u8 where {const owner N, owner F} {
    if (at == no_node()) return case_guard_passes();
    if (facts[at].kind == never_result()) return case_guard_exits();
    if (require_typed_bits(nodes, facts, at, scalar_bool()) != 0u8) return 0u8;
    val operand <- ungrouped(nodes, revision, used, at);
    val truth <- boolean_literal(nodes, used, operand);
    if (truth == LiteralTrue) return case_guard_passes();
    if (truth == LiteralFalse) return case_guard_declines();
    return case_guard_tests();
}

# A direct registration before every transfer runs unless an earlier
# abrupt completion prevents the transfer itself. If the action cannot
# finish normally, its completion replaces the pending scan request.
export func has_terminal_defer_before(nodes:const ExprNodes in N, links:const NameWork in L,
                                      facts:const OperandFacts in F, tail:u64, before:u64, revision:u64, used:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    for (unused in 0u64 .. used) {
        if (item == no_node() || inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return false;
        if (syntax_past(nodes, used, entry.item) > before) return false;
        if (inspect_defer(nodes, revision, used, entry.item, deferred) == DeferBody &&
            facts[deferred.operand].kind == never_result()) return true;
        item <- links[item].next;
    };
    return false;
}

export func case_resumes_after_cleanup() -> u8 { return 1u8; }
func replaced_case_resume() -> u8 { return 2u8; }

# The destination identifies where this particular transfer stops. A
# finalizer that always exits discards the suspended transfer.
func case_transfer_survives(nodes:const ExprNodes in N, names:const NameBindings in B,
                            facts:const OperandFacts in F, at:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner B, const owner F} {
    val stop <- names[names[at].declaration].finalizer;
    val cleanup <- names[at].finalizer;
    ref group = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref finalizer = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    for (unused in 0u64 .. used) {
        if (cleanup == stop) return true;
        if (!inspect_protected(nodes, revision, used, cleanup, group) ||
            inspect_guard_clause(nodes, revision, used, group.clauses, finalizer) != CleanupClause ||
            facts[finalizer.target].kind == never_result()) return false;
        cleanup <- names[cleanup].finalizer;
    };
    return false;
}

func case_resume_kind(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, arm:u64, body:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner F} {
    val scan <- facts[arm].case_exit_link;
    if (scan == no_node()) return 0u8;
    ref tail = make u64 { no_node() };
    val full <- is_scope_block(nodes, body) && block_tail(nodes, revision, used, body, tail);
    for (unused in 0u64 .. used) {
        if (scan == no_node()) return replaced_case_resume();
        if (case_transfer_survives(nodes, names, facts, scan, used, revision) &&
            (!full || !has_terminal_defer_before(nodes, links, facts, tail, syntax_first(nodes, used, scan), revision, used)))
            return case_resumes_after_cleanup();
        scan <- facts[scan].case_exit_link;
    };
    return replaced_case_resume();
}

func prepare_case_arm(nodes:const ExprNodes in N, names:const NameBindings in B,
                      links:const NameWork in L, facts:OperandFacts in F, arm:u64, used:u64, revision:u64,
                      sites:const CaseArmSites in A) -> u8
    where {const owner N, const owner B, const owner L, owner F, const owner A} {
    facts[arm].case_resume <- case_resume_kind(nodes, names, links, facts, arm, sites.body, used, revision);
    val behavior <- case_condition(nodes, facts, sites.guard, used, revision);
    if (behavior == 0u8) return expected_boolean_condition();
    facts[arm].case_guard <- behavior;
    return 0u8;
}

func prepare_case_pattern(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          cases:const ConstructorCaseFacts in C,
                          at:u64, subject:u64, pattern:u64, mode:CasePatternSyntax, member:u64 in M,
                          used:u64, revision:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, const owner C, owner M} {
    member <- no_node();
    if (mode == AnyCaseTarget || mode == NullCaseTarget) return 0u8;
    val kind <- facts[subject].kind;
    if (kind == never_result()) return 0u8;
    if (kind == source_sum_target()) {
        if ((mode != NamedCaseMember && mode != ConstructorCaseTarget) ||
            pattern >= intrinsic (len)(cases)) return unsupported_case_pattern();
        return case cases[pattern] of {
            CaseConstructor { val choice <- case_site; val representative <- representative; } -> {
                if (choice != at || representative <= subject || representative > pattern)
                    return invalid_operand_tree();
                member <- representative;
                0u8
            };
            _ -> unsupported_case_pattern()
        }
    };
    if (kind == scalar_bool()) {
        if (mode != FalseCaseTarget && mode != TrueCaseTarget) return unsupported_case_pattern();
        member <- if (mode == TrueCaseTarget) { at } else { subject };
        facts[pattern].discriminator_code <- if (mode == TrueCaseTarget) { 1u64 } else { 0u64 };
        return 0u8;
    };
    if (mode != NamedCaseMember) return unsupported_case_pattern();
    ref enumeration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, facts[subject].identity, enumeration) != EnumTypeDeclaration)
        return invalid_operand_tree();
    val spelling <- find_enum_member(source, nodes, pattern, enumeration.entries, revision, used);
    if (spelling == no_node()) return missing_enum_member();
    member <- names[spelling].declaration;
    facts[pattern].discriminator_code <- links[spelling].enum_code;
    return 0u8;
}

func match_case_arm(facts:OperandFacts in F, coverage:const CaseCoverage in V,
                    subject:u64, arm:u64, member:u64, pattern:CasePatternSyntax) -> void
    where {owner F, const owner V} {
    val null_pattern <- pattern == NullCaseTarget;
    val all_pattern <- pattern == AnyCaseTarget;
    val had_present <- coverage.remaining != 0u64;
    val had_absence <- coverage.absent;
    facts[arm].case_discriminator <- if (member != no_node() && had_present) { 1u8 } else { 0u8 };
    facts[arm].case_may_be_absent <- if (had_absence) { 1u8 } else { 0u8 };
    if (member != no_node() && (!had_present || (coverage.only != no_node() && coverage.only != member) ||
        facts[member].case_excluded_at == coverage.generation)) return;
    if (null_pattern && !had_absence) return;
    val matches_present <- !null_pattern && had_present;
    val matches_absence <- (null_pattern || all_pattern) && had_absence;
    val matches_all <- all_pattern || (null_pattern && !had_present) ||
        (member != no_node() && coverage.remaining == 1u64 && !had_absence);
    facts[arm].case_match <- if (matches_all) { matches_case_arm() } else { tests_case_arm() };
    facts[arm].case_presence <- case_presence(matches_present, matches_absence);
    facts[arm].case_selection <- facts[subject].selection;
    return;
}

# Share the indexed member table across cases. A nested case restores the
# enclosing scan's marks after consuming its own arms.
func exclude_case_member(facts:OperandFacts in F, coverage:CaseCoverage in V, member:u64, arm:u64) -> void
    where {owner F, owner V} {
    facts[arm].case_exclusion_member <- member;
    facts[arm].case_exclusion_previous <- facts[member].case_excluded_at;
    facts[arm].case_exclusion_next <- coverage.exclusions;
    facts[member].case_excluded_at <- coverage.generation;
    coverage.exclusions <- arm;
    return;
}

func restore_case_exclusions(facts:OperandFacts in F, coverage:const CaseCoverage in V) -> void
    where {owner F, const owner V} {
    val mark <- coverage.exclusions;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (mark == no_node()) return;
        facts[facts[mark].case_exclusion_member].case_excluded_at <- facts[mark].case_exclusion_previous;
        mark <- facts[mark].case_exclusion_next;
    };
}

func finish_case_arm(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                     coverage:CaseCoverage in V, at:u64, arm:u64, member:u64, borrowed:bool, used:u64, revision:u64,
                     sites:const CaseArmSites in A, pattern:CasePatternSyntax) -> u8
    where {const owner N, const owner L, owner F, owner V, const owner A} {
    if (facts[arm].case_match == misses_case_arm()) return 0u8;
    val matches_present <- coverage.remaining != 0u64 && pattern != NullCaseTarget;
    val matches_absence <- coverage.absent && (pattern == AnyCaseTarget || pattern == NullCaseTarget);
    val guard <- sites.guard;
    val behavior <- facts[arm].case_guard;
    val body <- sites.body;
    val enters_body <- behavior != case_guard_exits() && behavior != case_guard_declines();
    val declines <- behavior == case_guard_declines() || behavior == case_guard_tests();
    val falls_through <- enters_body && facts[arm].case_resume == case_resumes_after_cleanup();
    if (declines || falls_through) {
        if (borrowed && matches_present && (case_may_write(nodes, links, guard, used, revision) ||
                                             (falls_through && case_may_write(nodes, links, body, used, revision)))) {
            reopen_case_domain(coverage, arm);
        } else {};
    } else {
        if (matches_absence) { (coverage.absent <- false):void; } else {};
        if (pattern == AnyCaseTarget) { (coverage.remaining <- 0u64):void; } else {
            if (member != no_node()) {
                exclude_case_member(facts, coverage, member, arm);
                (coverage.remaining <- coverage.remaining - 1u64):void;
            } else {};
        };
    };
    if (!enters_body) return 0u8;
    facts[arm].case_body <- 1u8;
    return merge_arm_result(nodes, facts, at, body, false);
}

# Each case owns its exits in syntax postorder. Consume them at the direct
# guard, body or intervening statement they leave, after its reach is known.
func merge_case_breaks(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                       last:u64 in P, at:u64, through:u64, reached:bool, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, owner F, owner P} {
    if (through == no_node()) return 0u8;
    ref value = make u64 { no_node() };
    val diagnostic <- 0u8;
    val pending <- if (last == no_node()) { facts[at].case_exit_link } else { facts[last].case_exit_link };
    for (unused in 0u64 .. used) {
        if (pending == no_node() || pending > through) return 0u8;
        if (reached && case_transfer_survives(nodes, names, facts, pending, used, revision)) {
            if (!completion_operand(nodes, revision, used, pending, value)) return invalid_operand_tree();
            diagnostic <- if (value == no_node()) { merge_result(facts, at, void_result(), 0u64) }
                          else { merge_arm_result(nodes, facts, at, value, false) };
            if (diagnostic != 0u8) return diagnostic;
        } else {};
        last <- pending;
        pending <- facts[pending].case_exit_link;
    };
    return invalid_operand_tree();
}

func operand_problem(report:OperandCheckResult in R, at:u64, diagnostic:u8) -> bool where {owner R} {
    report.node <- at;
    report.diagnostic <- diagnostic;
    return false;
}

func check_case(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                owners:CallOwners in O, fields:const CaughtFieldUses in X,
                    views:const SuppliedViews in H,
                cases:const ConstructorCaseFacts in C,
                demand:const DeclarationDemands in D,
                report:OperandCheckResult in R, at:u64, used:u64, revision:u64, outer:u64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F,
           owner O, const owner X, const owner H, const owner C, const owner D, owner R} {
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, revision, used, at, selection)) return operand_problem(report, at, invalid_operand_tree());
    val subject <- selection.subject;
    val kind <- facts[subject].kind;
    val completed <- kind != never_result();
    if (completed && kind != scalar_bool() && kind != scalar_enum() &&
        kind != null_literal() && kind != source_sum_target())
        return operand_problem(report, at, unsupported_case_subject());
    if (kind == scalar_enum() && facts[subject].identity_module != 0u64)
        return operand_problem(report, at, unsupported_case_subject());
    val borrowed <- facts[subject].reception != independent_value();
    ref coverage = make CaseCoverage {
        total <- 0u64; remaining <- 0u64; absent <- false; only <- no_node(); generation <- at; exclusions <- no_node();
    };
    if (kind == source_sum_target()) {
        if (at >= intrinsic (len)(cases)) return operand_problem(report, at, invalid_operand_tree());
        case cases[at] of {
            IndexedCaseSubject { val expression <- expression; val count <- count; } -> {
                if (expression != subject || count == 0u64)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            DirectCaseSubject { val expression <- expression; val formal <- formal; val count <- count; } -> {
                if (expression != subject || formal >= subject || count == 0u64 ||
                    names[subject].kind != formal_binding() || names[subject].declaration != formal ||
                    facts[subject].reception != borrowed_ref() || facts[subject].target_readonly == 0u8 ||
                    facts[subject].owner != facts[formal].owner ||
                    facts[subject].identity_module != facts[formal].identity_module ||
                    facts[subject].identity != facts[formal].identity)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            _ -> { return operand_problem(report, at, invalid_operand_tree()) }
        }
    } else {
        if (!initialize_case_coverage(nodes, names, links, facts, at, subject, coverage, used, revision))
            return operand_problem(report, at, invalid_operand_tree())
    };
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, selection.items, BlockSequence, item))
        return operand_problem(report, at, invalid_operand_tree());
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    val cursor <- subject + 1u64;
    val last_exit <- no_node();
    val expression <- no_node();
    val reached <- false;
    val context <- no_node();
    val member <- no_node();
    val diagnostic <- 0u8;
    val mode <- AnyCaseTarget;
    for (unused in 0u64 .. used) {
        if (item == no_node()) {
            restore_case_exclusions(facts, coverage);
            if (!completed) { set_result(facts, at, never_result()); return true; } else {};
            if (case_has_paths(coverage)) {
                if (scalar_kind(facts[at].kind)) return operand_problem(report, at, incomplete_value_case());
                facts[at].case_end <- 1u8;
                only_void(facts, at);
                return true;
            } else {};
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return true;
        } else {};
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence)
            return operand_problem(report, at, invalid_operand_tree());
        expression <- entry.item;
        reached <- case_has_paths(coverage);
        if (!reached) { (facts[item].case_item <- unreachable_case_item()):void; } else {};
        if (inspect_case_arm(nodes, revision, used, expression, arm)) {
            mode <- case_pattern(nodes, used, arm.pattern);
            diagnostic <- prepare_case_pattern(source, nodes, names, links, facts, cases,
                at, subject, arm.pattern, mode, member, used, revision);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            if (reached) { match_case_arm(facts, coverage, subject, expression, member, mode); } else {};
            context <- enter_case_context(facts, outer, expression);
            if (!check_operand_range(source, nodes, names, links, selected, facts, owners, fields,
                views, cases, demand, report,
                                     cursor, item, used, revision, context)) return false;
            diagnostic <- finish_case_arm(nodes, links, facts, coverage, at, expression, member, borrowed, used, revision, arm, mode);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, arm.guard,
                                            facts[expression].case_match != misses_case_arm(), used, revision);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            (diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, arm.body,
                                             facts[expression].case_body != 0u8, used, revision)):void;
        } else {
            if (reached) {
                facts[item].case_presence <- case_presence(coverage.remaining != 0u64, coverage.absent);
                (facts[item].case_selection <- facts[subject].selection):void;
            } else {};
            context <- enter_case_context(facts, outer, item);
            if (!check_operand_range(source, nodes, names, links, selected, facts, owners, fields,
                views, cases, demand, report,
                                     cursor, item, used, revision, context)) return false;
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, expression, reached, used, revision);
            if (reached) {
                if (facts[expression].kind == never_result()) {
                    coverage.remaining <- 0u64;
                    (coverage.absent <- false):void;
                } else {
                    if (borrowed && coverage.remaining != 0u64 && case_may_write(nodes, links, expression, used, revision)) {
                        reopen_case_domain(coverage, item);
                    } else {};
                };
            } else {};
        };
        if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
        check_sequence_item(nodes, facts, item, entry);
        cursor <- item + 1u64;
        item <- links[item].next;
    };
    return operand_problem(report, at, invalid_operand_tree());
}

func record_case_exit(facts:OperandFacts in F, at:u64, destination:u64) -> void where {owner F} {
    val prior <- facts[destination].case_exit_tail;
    if (prior == no_node()) { (facts[destination].case_exit_link <- at):void; }
    else { (facts[prior].case_exit_link <- at):void; };
    facts[destination].case_exit_tail <- at;
    set_result(facts, at, never_result());
    return;
}

func check_logical(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, logical:const LogicalSites in L) -> u8
    where {const owner N, owner F, const owner L} {
    val left <- logical.left_operand;
    val abrupt <- facts[left].kind == never_result();
    val diagnostic <- 0u8;
    if (!abrupt) {
        diagnostic <- require_typed_bits(nodes, facts, left, scalar_bool());
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    val right <- logical.right_operand;
    if (right != no_node()) {
        if (facts[right].kind == never_result()) {
            (abrupt <- abrupt || logical.right_evaluation == TakesRhs):void;
        } else {
            diagnostic <- require_typed_bits(nodes, facts, right, scalar_bool());
            if (diagnostic != 0u8) return diagnostic;
        };
    } else {};
    set_result(facts, at, if (abrupt) { never_result() } else { scalar_bool() });
    return 0u8;
}

func merge_guard_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, arm:u64, discard:bool) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (discard && (scalar_kind(kind) || immutable_text_kind(kind)))
        return merge_result(facts, at, void_result(), 0u64);
    if (facts[at].arm_result == 0u8 || !scalar_kind(kind)) return merge_result(facts, at, kind, facts[arm].identity);
    if (facts[arm].reception == nullable_ptr() && facts[at].discarded_result == 0u8)
        return unproved_nonnull_borrow();
    # A native result slot can hold either bits or a target. A guard with
    # both would need to retain that distinction until its finalizer exits.
    if (scalar_kind(facts[at].kind) &&
        ((facts[at].reception == independent_value()) != (facts[arm].reception == independent_value())))
        return unproved_result_contract();
    return merge_arm_result(nodes, facts, at, arm, true);
}

func check_try_result(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F, at:u64,
                      used:u64, revision:u64, protected:const ProtectedSites in P) -> u8
    where {const owner N, const owner L, owner F, const owner P} {
    val discard <- protected.discarded || facts[at].discarded_result == loop_discard();
    val diagnostic <- merge_guard_result(nodes, facts, at, protected.body, discard);
    if (diagnostic != 0u8) return diagnostic;
    ref clause = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, protected.clauses, ClauseSequence, clause)) return invalid_operand_tree();
    ref sites = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    val shape <- InvalidGuardClause;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) {
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return 0u8;
        };
        shape <- inspect_guard_clause(nodes, revision, used, clause, sites);
        if (shape == HandlerClause) {
            if (!inspect_handler(nodes, revision, used, sites.target, handler)) return invalid_operand_tree();
            diagnostic <- merge_guard_result(nodes, facts, at, handler.body, discard);
            if (diagnostic != 0u8) return diagnostic;
        } else {
            if (shape != CleanupClause) return invalid_operand_tree();
            if (facts[sites.target].kind == never_result()) {
                set_result(facts, at, never_result());
                return 0u8;
            };
            if (facts[sites.target].kind != void_result()) return wrong_finally_result();
        };
        clause <- links[clause].next;
    };
    return unproved_result_contract();
}

func check_catch_clause(nodes:const ExprNodes in N, facts:const OperandFacts in F, at:u64,
                        used:u64, revision:u64, clause:GuardClauseSites in C) -> u8
    where {const owner N, const owner F, owner C} {
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (!inspect_handler(nodes, revision, used, clause.target, handler)) return invalid_operand_tree();
    val identity <- facts[handler.binding].identity;
    val module <- facts[handler.binding].identity_module;
    val category <- if (identity == no_node()) { exception_root_identity() } else { identity };
    val previous <- clause.previous;
    for (unused in 0u64 .. at) {
        if (previous == no_node()) return 0u8;
        if (inspect_guard_clause(nodes, revision, used, previous, clause) != HandlerClause ||
            !inspect_handler(nodes, revision, used, clause.target, handler)) return invalid_operand_tree();
        identity <- facts[handler.binding].identity;
        if (module == facts[handler.binding].identity_module &&
            category == (if (identity == no_node()) { exception_root_identity() }
                else { identity }))
            return duplicate_catch_category();
        previous <- clause.previous;
    };
    return 0u8;
}

func check_scope_tail(facts:OperandFacts in F, scope:u64, tail:u64) -> u8 where {owner F} {
    val identity <- if (tail == no_node()) { 0u64 } else { (facts[tail].identity) };
    val diagnostic <- merge_result(facts, scope, sequence_result(facts, tail), identity);
    if (diagnostic == 0u8 && facts[scope].kind == 0u8) {
        if (facts[scope].case_resume != 0u8) { set_result(facts, scope, never_result()); }
        else { only_void(facts, scope); };
    } else {};
    return diagnostic;
}

export func has_value_tail(facts:const OperandFacts in F, body:u64, function_form:bool) -> bool where {const owner F} {
    return function_form && body != no_node() && scalar_kind(facts[body].kind);
}

func check_callable_tail(facts:const OperandFacts in F, definition:u64, callable:const CallableSites in C) -> u8
    where {const owner F, const owner C} {
    if (!callable.function_form) return 0u8;
    val kind <- facts[callable.body].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (scalar_kind(kind) && facts[definition].kind == void_result()) return value_tail_in_void_function();
    if (scalar_kind(kind) && !same_operand_type(facts, callable.body, definition)) return wrong_return_type();
    return 0u8;
}

func validate_return(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                   at:u64, value:u64, used:u64, revision:u64) -> u8 where {const owner N, const owner B, owner F} {
    val scope <- names[at].scope;
    ref tail = make u64 { no_node() };
    if (module_tail(nodes, revision, used, scope, tail)) return wrong_return_type();
    if (is_scope_block(nodes, scope) && block_tail(nodes, revision, used, scope, tail)) {
        val identity <- if (value == no_node()) { 0u64 } else { (facts[value].identity) };
        return merge_result(facts, scope, result_kind(nodes, facts, value, true), identity);
    } else {};
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val form <- inspect_callable(nodes, revision, used, scope, callable);
    if ((form != ModuleCallable && form != LexicalCallable && form != CEntry) || facts[scope].kind == 0u8)
        return unproved_result_contract();
    if (value != no_node() && facts[value].kind == never_result()) return 0u8;
    if (facts[scope].kind == void_result()) {
        if (value != no_node() && facts[value].kind != void_result()) return wrong_return_type();
        return 0u8;
    } else {};
    if (value == no_node()) return wrong_return_type();
    if (facts[scope].kind == product_kind()) {
        if (!same_operand_type(facts, value, scope) || facts[value].reception != borrowed_ref())
            return wrong_return_type();
        if (facts[value].owner != facts[scope].owner)
            return owner_conflict(nodes, facts[value].owner, facts[scope].owner);
        if (facts[value].target_readonly != 0u8 && facts[scope].target_readonly == 0u8)
            return expected_writable_place();
        return 0u8;
    };
    if (immutable_text_kind(facts[scope].kind)) {
        if (!immutable_text_kind(facts[value].kind) ||
            (facts[scope].kind == c_string_kind() && facts[value].kind != c_string_kind()))
            return wrong_return_type();
        if (facts[value].owner != facts[scope].owner) return wrong_text_result_owner();
        return 0u8;
    };
    val diagnostic <- if (facts[scope].kind == source_u32()) { require_source_u32(nodes, facts,
        value, true) }
        else { require_matching_bits(nodes, facts, value, scope) };
    if (diagnostic == wrong_operand_type()) return wrong_return_type();
    return diagnostic;
}

func check_return(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                   at:u64, value:u64, used:u64, revision:u64) -> u8 where {const owner N, const owner B, owner F} {
    val diagnostic <- validate_return(nodes, names, facts, at, value, used, revision);
    if (diagnostic == 0u8) { set_result(facts, at, never_result()); };
    return diagnostic;
}

func check_group(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, inner:u64) -> u8
    where {const owner N, owner F} {
    val kind <- facts[inner].kind;
    if (kind == product_kind()) return unsupported_product_layout();
    if (kind == void_result() || kind == never_result() || kind == exception_type() || immutable_text_kind(kind) ||
        facts[inner].reception == nullable_ptr()) {
        copy_fact(facts, at, inner);
        return 0u8;
    };
    if (scalar_kind(kind) && facts[at].discarded_result != 0u8) {
        set_bits_result(facts, at, inner);
        return 0u8;
    };
    val diagnostic <- if (kind == source_u32()) { require_source_u32(nodes, facts, inner, false) }
        else { require_typed_bits(nodes, facts, inner, kind) };
    if (diagnostic != 0u8) return diagnostic;
    set_bits_result(facts, at, inner);
    return 0u8;
}

func check_numeric_expression(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, binary:const BinarySites in B) -> u8
    where {const owner N, owner F, const owner B} {
    val left <- binary.left_operand;
    val right <- binary.right_operand;
    val left_completes <- facts[left].kind != never_result();
    val right_completes <- facts[right].kind != never_result();
    val left_diagnostic <- if (left_completes) { require_bits(nodes, facts, left) } else { 0u8 };
    if (left_diagnostic != 0u8) return left_diagnostic;
    val right_diagnostic <- if (right_completes) { require_bits(nodes, facts, right) } else { 0u8 };
    if (right_diagnostic != 0u8) return right_diagnostic;
    if (!left_completes || !right_completes) { set_result(facts, at, never_result()); }
    else { scalar_fact(facts, at, independent_value(), no_node()); };
    return 0u8;
}

func check_comparison(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, binary:const BinarySites in B) -> u8
    where {const owner N, owner F, const owner B} {
    val left <- binary.left_operand;
    val kind <- if (binary.relation == Equal || binary.relation == Unequal) { (facts[left].kind) } else { scalar_u64() };
    val diagnostic <- require_typed_bits(nodes, facts, left, kind);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_matching_bits(nodes, facts, binary.right_operand, left);
    if (diagnostic != 0u8) return diagnostic;
    set_result(facts, at, scalar_bool());
    return 0u8;
}

func check_range_header(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, owner F} {
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_header(nodes, revision, used, at, bounds)) return invalid_operand_tree();
    val lower <- bounds.lower;
    val upper <- bounds.upper;
    val diagnostic <- if (facts[lower].kind != never_result()) { require_bits(nodes, facts, lower) } else { 0u8 };
    if (diagnostic != 0u8) return diagnostic;
    if (facts[upper].kind != never_result()) {
        diagnostic <- require_bits(nodes, facts, upper);
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    # Reads use the current index word. It exposes no writable binding slot.
    set_result(facts, at, scalar_u64());
    return 0u8;
}

func check_range_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, owner F} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_loop(nodes, revision, used, at, loop) ||
        !inspect_range_header(nodes, revision, used, loop.header, bounds)) return invalid_operand_tree();
    val shape <- classify_literal_range(nodes, revision, used, loop.header);
    if (shape == InvalidRange) return invalid_operand_tree();
    val body_continues <- facts[loop.body].kind != never_result();
    val empty_continues <- loop.empty == no_node() || facts[loop.empty].kind != never_result();
    val continues <- case shape of {
        (NonemptyLiteralRange) -> { body_continues };
        (EmptyLiteralRange) -> { empty_continues };
        (_) -> { body_continues || empty_continues };
    };
    if (facts[bounds.lower].kind == never_result() || facts[bounds.upper].kind == never_result() || !continues) {
        set_result(facts, at, never_result());
    } else { only_void(facts, at); };
    return 0u8;
}

func check_explicit_discard(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, operand:u64) -> u8
    where {const owner N, owner F} {
    val kind <- result_kind(nodes, facts, operand, false);
    if (kind == 0u8) return unproved_operand();
    set_result(facts, at, if (kind == never_result()) { kind } else { void_result() });
    return 0u8;
}

func check_enum_assertion(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          at:u64, used:u64, revision:u64, assertion:const AssertionSites in A) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, const owner A} {
    val annotation <- assertion.annotation;
    if (names[annotation].kind != enum_type()) return unsupported_scalar_assertion();
    val domain <- names[annotation].declaration;
    val operand <- assertion.operand;
    if (name_syntax(nodes, used, operand) == OrdinaryName && names[operand].kind == 0u8) {
        ref enumeration = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        if (inspect_declaration(nodes, revision, used, domain, enumeration) != EnumTypeDeclaration) return invalid_operand_tree();
        val member <- find_enum_member(source, nodes, operand, enumeration.entries, revision, used);
        if (member == no_node()) return missing_enum_member();
        set_fact(facts, at, scalar_enum(), independent_value(), no_node(), domain, 0u8);
        facts[at].enum_constant <- 1u8;
        facts[at].discriminator_code <- links[member].enum_code;
        return 0u8;
    } else {};
    if (facts[operand].kind != never_result() &&
        (facts[operand].kind != scalar_enum() || facts[operand].identity != domain)) return incompatible_enum_type();
    copy_fact(facts, at, operand);
    return 0u8;
}

func check_bound_name(names:const NameBindings in B, links:const NameWork in L,
                     facts:OperandFacts in F, views:const SuppliedViews in H, at:u64, source_only:bool)
    -> u8 where {const owner B, const owner L, owner F, const owner H} {
    val binding <- names[at].kind;
    if (source_only && binding == enum_value() && links[at].value_kind == enum_type() &&
        links[at].value_module != 0u64 && links[at].value_identity != no_node()) {
        set_fact(facts, at, scalar_enum(), independent_value(), no_node(), links[at].value_identity,
            0u8);
        facts[at].identity_module <- links[at].value_module;
        return 0u8
    };
    if (binding == formal_binding() || binding == local_binding() || binding == exception_binding() ||
        binding == loop_index()) {
        copy_fact(facts, at, names[at].declaration);
        if (binding == formal_binding()) {
            (facts[at].writable_text_place <- facts[names[at].declaration].writable_text_place):void;
        };
    } else {
        if (binding == here_receiver_binding() && names[at].declaration < intrinsic (len)(views)) {
            case views[names[at].declaration] of {
                (SuppliedArrayView { val module <- type_module; val identity <- type_identity;
                                     val role <- owner_role; val readonly <- readonly; }) -> {
                    set_fact(facts, at, source_array_loan(), borrowed_ref(), role, identity, 0u8);
                    facts[at].identity_module <- module;
                    (facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 }):void
                };
                _ -> {}
            }
        }
    };
    return 0u8;
}

func record_case_fallthrough(nodes:const ExprNodes in N, names:const NameBindings in B,
                             facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, owner F} {
    val arm <- names[at].declaration;
    val scope <- names[at].scope;
    ref sites = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (!inspect_case_arm(nodes, revision, used, arm, sites)) return invalid_operand_tree();
    record_case_exit(facts, at, arm);
    if (sites.body == scope && is_scope_block(nodes, scope)) {
        (facts[scope].case_resume <- case_resumes_after_cleanup()):void;
    } else {};
    return 0u8;
}

func record_case_break(nodes:const ExprNodes in N, names:const NameBindings in B,
                       facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, owner F} {
    val target <- names[at].declaration;
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, revision, used, target, selection)) return unproved_operand();
    record_case_exit(facts, at, target);
    return 0u8;
}

func check_native_here_value(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:OperandFacts in F,
                             at:u64, call:const NodeId in C, used:u64, revision:u64) -> u8
    where {const owner N, const owner L, owner F, const owner C} {
    if (!published_syntax_id(nodes, revision, used, call) ||
        links[call.index].expects_here == 0u8 || facts[call.index].kind == 0u8)
        return unproved_call_target();
    ref here = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, at,
        here) != HereReady) return invalid_operand_tree();
    copy_fact(facts, at, call.index);
    return 0u8
}

func check_here_continue(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L,
                         facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F} {
    val target <- names[at].declaration;
    if (target >= used) return unproved_call_target();
    ref invocation = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, target, invocation) != HereReady ||
        links[invocation.call].expects_here == 0u8) return unproved_call_target();
    val value <- no_node();
    if (!completion_operand(nodes, revision, used, at, value) || value == no_node())
        return wrong_return_type();
    val kind <- declared_scalar(links[target].value_kind);
    if (facts[value].kind != never_result()) {
        val error <- require_typed_bits(nodes, facts, value, kind);
        if (error != 0u8) return error;
        if (kind == scalar_enum() &&
            (facts[value].identity_module != links[target].value_module ||
             facts[value].identity != links[target].value_identity)) return incompatible_enum_type()
    };
    set_result(facts, at, never_result());
    return 0u8
}

func receive_case_bits(facts:OperandFacts in F, at:u64, type:const DeclaredType in T,
    reception:u8, owner_site:u64) -> u8 where {owner F, const owner T} {
    val kind <- if (type.kind == record_type()) { received_product() }
                else { source_scalar_kind(type.kind) };
    if (kind == 0u8) return unsupported_case_pattern();
    set_fact(facts, at, kind, reception, owner_site, type.identity, 0u8);
    facts[at].identity_module <- type.defining_module;
    return 0u8
}

func check_indexed_case_subject(nodes:const ExprNodes in N, facts:OperandFacts in F,
    at:u64, expression:u64, array_site:u64, index:u64, owner_site:u64, declared_array:u64,
    schema:const DeclaredType in T) -> u8 where {const owner N, owner F, const owner T} {
    if (expression != at || array_site >= at || index >= at) return invalid_operand_tree();
    if (facts[array_site].kind == never_result() || facts[index].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (facts[array_site].kind != source_array_loan() || facts[array_site].reception != borrowed_ref() ||
        facts[array_site].owner != owner_site || facts[array_site].identity_module != 0u64 ||
        facts[array_site].identity != declared_array || facts[array_site].target_readonly == 0u8)
        return unsupported_case_subject();
    val diagnostic <- require_typed_bits(nodes, facts, index, scalar_u64());
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, source_sum_target(), borrowed_ref(), owner_site, schema.identity, 0u8);
    facts[at].identity_module <- schema.defining_module;
    facts[at].target_readonly <- 1u8;
    facts[at].checks_array_bounds <- true;
    return 0u8
}

func check_case_receipt(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
    at:u64, used:u64, revision:u64, pattern:u64, schema:const DeclaredType in T) -> u8
    where {const owner N, const owner B, owner F, const owner T} {
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    if (!inspect_case_arm(nodes, revision, used, facts[at].case_context, arm) ||
        arm.pattern != pattern || names[at].scope == no_node()) return invalid_operand_tree();
    return receive_case_bits(facts, at, schema, local_place(), names[at].scope)
}

func check_operand(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   selected:const SelectedExports in E, facts:OperandFacts in F, owners:CallOwners in O,
                   fields:const CaughtFieldUses in X, views:const SuppliedViews in H,
                   cases:const ConstructorCaseFacts in C,
                       source_only:bool,
                   at:u64, used:u64, revision:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F,
        owner O, const owner X, const owner H, const owner C} {
    if (at >= used) return invalid_operand_tree();
    if (at < intrinsic (len)(cases)) {
        case cases[at] of {
            IndexedCaseSubject {
                val expression <- expression; val array_site <- array_site; val index <- index;
                val owner_site <- owner_site; val declared_array <- array_type; val schema <- value_type;
            } -> { return check_indexed_case_subject(nodes, facts, at, expression, array_site,
                index, owner_site, declared_array, schema) };
            CaseFieldReceipt { val pattern <- pattern; val schema <- value_type; } ->
                { return check_case_receipt(nodes, names, facts, at, used, revision, pattern, schema) };
            CaseProductField { val receiver <- receiver; val record <- record; val schema <- value_type; } -> {
                if (receiver >= at || facts[receiver].kind != received_product() ||
                    facts[receiver].identity != record.identity ||
                    facts[receiver].identity_module != record.defining_module) return unsupported_product_layout();
                return receive_case_bits(facts, at, schema, independent_value(), no_node())
            };
            _ -> {}
        }
    };
    ref installed_expression = make u64 { no_node() };
    if (source_only && native_installation_input(nodes, revision, used, at, installed_expression)) {
        val selected_acquisition <- ungrouped(nodes, revision, used, installed_expression);
        if (selected_acquisition >= used || links[selected_acquisition].active != at)
            return unproved_operand();
        only_void(facts, at);
        return 0u8
    };
    val null_owner <- no_node();
    case nodes[at] of {
        (Vacant) -> { return invalid_operand_tree(); };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (Parenthesized { val expression <- expression; }) -> {
                    if (!published_syntax_id(nodes, revision, at, expression)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_group(nodes, facts, at, expression.index);
                };
                (NameReference) -> { return check_bound_name(names, links, facts, views, at, source_only); };
                (ArrayLength { val target <- target; }) -> {
                    if (!published_syntax_id(nodes, revision, at, target)) return invalid_operand_tree();
                    if (facts[target.index].kind == never_result()) {
                        set_result(facts, at, never_result());
                        return 0u8
                    };
                    if (!source_only || facts[target.index].kind != source_array_loan())
                        return unproved_operand();
                    scalar_fact(facts, at, independent_value(), no_node());
                    return 0u8
                };
                (RangeHeader) -> { return check_range_header(nodes, facts, at, used, revision); };
                (RangeLoop) -> { return check_range_result(nodes, facts, at, used, revision); };
                (BooleanLiteral) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    set_result(facts, at, scalar_bool());
                    return 0u8;
                };
                (IntegerLiteral { val width <- width; }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    if (width == 64u64) {
                        scalar_fact(facts, at, independent_value(), no_node());
                        return 0u8;
                    };
                    if (source_only && width == 32u64) {
                        set_result(facts, at, source_u32());
                        return 0u8
                    };
                    if (width != 8u64) return unsupported_narrow_execution();
                    set_result(facts, at, scalar_u8());
                    return 0u8;
                };
                (Call { val callee <- callee; val arguments <- argument_tail; }) -> {
                    if (!published_syntax_id(nodes, revision, used, callee) ||
                        !published_syntax_id(nodes, revision, used, arguments)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_direct_call(nodes, names, links, selected, facts, owners, views,
                        at, callee.index, arguments.index, used, revision, source_only);
                };
                (EmptyCall { val callee <- callee; }) -> {
                    if (!published_syntax_id(nodes, revision, used, callee)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_direct_call(nodes, names, links, selected, facts, owners, views,
                        at, callee.index, no_node(), used, revision, source_only);
                };
                (HereInvocation { val call <- call; }) -> {
                    return check_native_here_value(nodes, links, facts, at, call, used, revision)
                };
                (ReturnValue { val value <- value; }) -> {
                    if (!published_syntax_id(nodes, revision, used, value)) return invalid_operand_tree();
                    return check_return(nodes, names, facts, at, value.index, used, revision);
                };
                (ReturnVoid) -> { return check_return(nodes, names, facts, at, no_node(), used, revision); };
                (ContinueValue) -> { return check_here_continue(nodes, names, links, facts, at,
                    used, revision); };
                (ContinueVoid) -> { return check_here_continue(nodes, names, links, facts, at, used,
                    revision); };
                (DiscardedExpression { val operand <- operand; }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_explicit_discard(nodes, facts, at, operand.index);
                };
                (TextLiteral { val interior <- interior_zero; }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    set_fact(facts, at, string_kind(), borrowed_ref(), static_text_owner(), 0u64, 0u8);
                    facts[at].target_readonly <- 1u8;
                    facts[at].text_nul <- if (interior) { nul_present() } else { nul_absent() };
                    return 0u8;
                };
                (NullLiteral { val owner <- owner_name; }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    case owner of {
                        (NoLink) -> {};
                        (LinkTo { val name <- node; }) -> {
                            if (!published_syntax_id(nodes, revision, at, name)) return invalid_operand_tree();
                            (null_owner <- names[name.index].declaration):void;
                        };
                    };
                    set_fact(facts, at, null_literal(), 0u8, null_owner, 0u64, 0u8);
                    return 0u8;
                };
                (RaiseValue { val operand <- exception_value; }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    if (facts[operand.index].kind != exception_type()) return expected_exception_type();
                    set_result(facts, at, never_result());
                    return 0u8;
                };
                (RaisePending) -> {
                    if (names[at].scope != no_node()) { set_result(facts, at, never_result()); } else {};
                    return 0u8;
                };
                (NamedThrow) -> { set_result(facts, at, never_result()); return 0u8; };
                (BreakValue) -> { return record_case_break(nodes, names, facts, at, used, revision); };
                (BreakVoid) -> { return record_case_break(nodes, names, facts, at, used, revision); };
                (CaseFallthrough) -> { return record_case_fallthrough(nodes, names, facts, at, used, revision); };
                (CaseFailure) -> { set_result(facts, at, never_result()); return 0u8; };
                (_) -> {};
            };
        };
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, revision, used, at, assignment);
    if (mode == InvalidAssignment) return invalid_operand_tree();
    if (mode == FieldRebind ||
        (mode == FieldTransfer && names[assignment.destination].kind == record_initializer_label())) return 0u8;
    if (mode == AugmentedPlaceTransfer)
        return check_augmented_transfer(nodes, facts, at, assignment.destination, assignment.input,
                                       used, revision);
    if ((mode == PlaceRebind || mode == PlaceTransfer || mode == FieldTransfer) && names[at].scope == no_node()) return 0u8;
    if (mode == PlaceRebind)
        return check_text_installation(nodes, facts, at, assignment.destination, assignment.input);
    if (mode == PlaceTransfer || mode == FieldTransfer) {
        val destination <- assignment.destination;
        val input <- assignment.input;
        if (facts[destination].kind == product_kind())
            return check_transfer_call(nodes, names, links, facts, owners, at, destination, input, false, used, revision);
        if (!immutable_text_kind(facts[destination].kind)) return check_transfer(nodes, facts, at, destination, input);
        if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
        # Reborrowing an init formal as an initialized place would expose its
        # current value before the caller's first-write proof.
        if (name_syntax(nodes, used, destination) == OrdinaryName) return unsupported_text_operation();
        return check_transfer_call(nodes, names, links, facts, owners, at, destination, input, false, used, revision);
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, revision, used, at, construction);
    if (shape == InvalidConstruction) return invalid_operand_tree();
    if (shape == PositionalConstruction || shape == BracedConstruction || shape == StorageReservation) {
        if (names[at].scope == no_node()) return 0u8;
        val kind <- names[construction.requested].kind;
        if (kind == builtin_string()) {
            if (shape != PositionalConstruction) return unsupported_text_operation();
            return check_text_construction(nodes, names, facts, at, used, revision, construction);
        };
        if (kind == record_type()) {
            if (shape != BracedConstruction) return unsupported_product_layout();
            return check_product_construction(source, nodes, names, links, facts, owners,
                                              at, names[construction.requested].declaration, used, revision, construction);
        };
        if (shape == PositionalConstruction) return unproved_operand();
        return check_construction(nodes, names, facts, at, construction);
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == InvalidLogical) return invalid_operand_tree();
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr) {
        if (names[at].scope == no_node()) return 0u8;
        return check_logical(nodes, facts, at, logical);
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val sequence <- inspect_sequence_entry(nodes, revision, used, at, entry);
    if (sequence == InvalidSequence) return invalid_operand_tree();
    if (sequence == BlockSequence || sequence == ModuleSequence) {
        check_sequence_item(nodes, facts, at, entry);
        return 0u8;
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    if (inspect_catch_binding(nodes, revision, used, at, caught))
        return if (facts[at].kind == exception_type()) { 0u8 } else { expected_exception_type() };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    if (inspect_guard_clause(nodes, revision, used, at, clause) == HandlerClause)
        return check_catch_clause(nodes, facts, at, used, revision, clause);
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val callable_form <- inspect_callable(nodes, revision, used, at, callable);
    if (callable_form == InvalidCallable) return invalid_operand_tree();
    if (callable_form == ModuleCallable || (source_only && callable_form == LexicalCallable))
        return check_callable_tail(facts, at, callable);
    if (names[at].scope == no_node()) return 0u8;
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    if (inspect_type_assertion(nodes, revision, used, at, assertion)) {
        if (names[assertion.annotation].kind == builtin_c_string()) return check_text_assertion(facts, at, assertion.operand);
        return check_enum_assertion(source, nodes, names, links, facts, at, used, revision, assertion);
    };
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, revision, used, at, local) && local.mode != ExceptionLocal)
        return check_local(nodes, names, facts, at, used, revision, local);
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, revision, used, at, field))
        return check_field_access(source, nodes, names, links, facts, fields, at, used, revision,
            field, source_only);
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val operator <- inspect_binary(nodes, revision, used, at, binary);
    if (operator == InvalidBinary) return invalid_operand_tree();
    if (operator == ArithmeticBinary) return check_numeric_expression(nodes, facts, at, binary);
    if (operator == ComparisonBinary) return check_comparison(nodes, facts, at, binary);
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    val invocation <- inspect_invocation(nodes, revision, used, at, call);
    if (invocation == InvalidCallSyntax) return invalid_operand_tree();
    if (invocation == EffectfulInvocation)
        return check_symbolic_call(nodes, names, selected, facts, at, call.callee, call.arguments, used, revision);
    ref tail = make u64 { no_node() };
    if (block_tail(nodes, revision, used, at, tail)) {
        if (is_scope_block(nodes, at)) return check_scope_tail(facts, at, tail);
        if (tail != no_node() && facts[at].arm_result != 0u8) { copy_fact(facts, at, tail); } else {
            val result <- sequence_result(facts, tail);
            if (scalar_kind(result)) { set_bits_result(facts, at, tail); } else { set_result(facts, at, result); };
        };
        return 0u8;
    };
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    if (inspect_protected(nodes, revision, used, at, protected))
        return check_try_result(nodes, links, facts, at, used, revision, protected);
    ref branches = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branches)) return check_conditional(nodes, facts, at, branches);
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (inspect_case_arm(nodes, revision, used, at, arm))
        return prepare_case_arm(nodes, names, links, facts, at, used, revision, arm);
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    val registration <- inspect_defer(nodes, revision, used, at, deferred);
    if (registration == InvalidDefer) return invalid_operand_tree();
    if (registration == DeferCall && facts[deferred.invocation].text_intrinsic != 0u8) return unsupported_text_operation();
    if (registration == DeferCall || registration == DeferBody) { only_void(facts, at); return 0u8; };
    return 0u8;
}

# Ordinary nodes are checked in postorder. Once a case subject is ready,
# its ordered scan checks each direct item in the context that reaches it.
func check_operand_range(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                         links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                         owners:CallOwners in O, fields:const CaughtFieldUses in X,
                             views:const SuppliedViews in H,
                         cases:const ConstructorCaseFacts in C,
                demand:const DeclarationDemands in D,
                         report:OperandCheckResult in R, first:u64, past:u64, used:u64,
                             revision:u64, context:u64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F,
        owner O, const owner X, const owner H, const owner C, const owner D, owner R} {
    val at <- first;
    val diagnostic <- 0u8;
    val enclosing_case <- no_node();
    for (unused in first .. past) {
        if (at == past) return true;
        if (needs_body_check(demand, at)) {
            if (at != context) { (facts[at].case_context <- context):void; };
            if (at == enclosing_case) {
                if (!check_case(source, nodes, names, links, selected, facts, owners, fields, views,
                    cases, demand, report,
                                at, used, revision, context)) return false;
            } else {
                diagnostic <- check_operand(source, nodes, names, links, selected, facts, owners,
                    fields, views, cases, intrinsic (len)(demand) != 0u64, at, used, revision);
                if (diagnostic != 0u8) return operand_problem(report, at, diagnostic)
            }
        };
        enclosing_case <- facts[at].case_after_subject;
        at <- if (enclosing_case != no_node() && enclosing_case < past) { enclosing_case } else { at + 1u64 };
    };
    return at == past;
}

func discard_result(facts:OperandFacts in F, at:u64, mode:u8) -> void where {owner F} {
    if (at == no_node()) return;
    facts[at].discarded_result <- mode;
    return;
}

func inherit_result_use(facts:OperandFacts in F, parent:u64, child:u64) -> void where {owner F} {
    if (child == no_node()) return;
    facts[child].arm_result <- facts[parent].arm_result;
    facts[child].discarded_result <- facts[parent].discarded_result;
    return;
}

# Carry discard through parentheses, a grouping block's tail and the
# normal arms of a guard. Argument and arithmetic operands and independent
# invocations still establish results required by their own operations.
func prepare_result_use(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> void
    where {const owner N, owner F} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    if (inspect_range_loop(nodes, revision, used, at, loop)) {
        discard_result(facts, loop.body, loop_discard());
        discard_result(facts, loop.empty, loop_discard());
        return;
    };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (inspect_case_arm(nodes, revision, used, at, arm)) {
        facts[arm.body].arm_result <- 1u8;
        return;
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch)) {
        facts[branch.consequent].arm_result <- 1u8;
        facts[branch.alternative].arm_result <- 1u8;
        facts[branch.consequent].discarded_result <- facts[at].discarded_result;
        facts[branch.alternative].discarded_result <- facts[at].discarded_result;
        return;
    };
    # An explicit discard still requires its operand to establish its type.
    case nodes[at] of {
        (Vacant) -> { return; };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (DiscardedExpression { val operand <- operand; }) -> {
                    if (published_syntax_id(nodes, revision, at, operand))
                        { discard_result(facts, operand.index, explicit_discard()); } else {};
                    return;
                };
                (_) -> {};
            };
        };
    };
    if (facts[at].discarded_result == 0u8 && facts[at].arm_result == 0u8) return;
    ref child = make u64 { no_node() };
    if (inspect_group(nodes, revision, used, at, child) == ParenthesizedExpression ||
        (!is_scope_block(nodes, at) && block_tail(nodes, revision, used, at, child))) {
        inherit_result_use(facts, at, child);
        return;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, at, entry) == BlockSequence) {
        inherit_result_use(facts, at, entry.item);
        return;
    };
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    if (inspect_protected(nodes, revision, used, at, protected)) {
        inherit_result_use(facts, at, protected.body);
        inherit_result_use(facts, at, protected.clauses);
        return;
    };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    val mode <- inspect_guard_clause(nodes, revision, used, at, clause);
    if (mode == HandlerClause || mode == CleanupClause) {
        inherit_result_use(facts, at, clause.previous);
        if (mode == HandlerClause) { inherit_result_use(facts, at, clause.target); } else {};
        return;
    };
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (inspect_handler(nodes, revision, used, at, handler)) { inherit_result_use(facts, at, handler.body); } else {};
    return;
}

# A declared receiving reference supplies placement for a directly
# contained text construction. Explicit placement is checked separately.
func prepare_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, at:u64, used:u64, revision:u64) -> void
    where {const owner N, const owner B, owner F} {
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (!inspect_local_binding(nodes, revision, used, at, local) || local.mode != ReferenceLocal) return;
    ref destination = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, local.binding, destination) != TypedBinding ||
        destination.owner_name == no_node() || names[destination.target_type].kind != builtin_string()) return;
    val construction <- ungrouped(nodes, revision, used, local.initializer);
    ref sites = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    if (inspect_construction(nodes, revision, used, construction, sites) == PositionalConstruction &&
        names[sites.requested].kind == builtin_string()) {
        (facts[construction].allocation_owner <- names[destination.owner_name].declaration):void;
    };
}

# Revisit a writable formal only when it reaches an allocation. Its
# incoming argument edges retain the actual owner from each checked call.
func demand_owner_inputs(facts:OperandFacts in F, owners:CallOwners in O, owner_site:u64, pending:u64 in P)
    -> void where {owner F, owner O, owner P} {
    val argument <- owners[owner_site].uses;
    val actual <- no_node();
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (argument == no_node()) return;
        facts[argument].owner_chain <- 0u64;
        actual <- facts[argument].owner;
        if (facts[actual].owner_chain == no_node()) {
            facts[actual].owner_chain <- 0u64;
            owners[actual].call_site <- pending;
            (pending <- actual):void;
        };
        argument <- facts[argument].owner_use_next;
    };
}

func close_allocation_owners(facts:OperandFacts in F, owners:CallOwners in O, used:u64) -> void
    where {owner F, owner O} {
    # Invocation substitutions are complete. Reuse their call-site words as work links.
    val pending <- no_node();
    for (site in 0u64 .. used) {
        if (facts[site].owner_chain != no_node()) {
            owners[site].call_site <- pending;
            (pending <- site):void;
        };
    };
    val site <- no_node();
    for (unused in 0u64 .. used) {
        if (pending == no_node()) return;
        site <- pending;
        pending <- owners[site].call_site;
        demand_owner_inputs(facts, owners, site, pending);
    };
}

# Operands and declarations refer to the bound syntax and its owner sites.
# Target-access demands are recorded for the completion pass, where flow can
# prove a target present or propagate a possible checked failure.
export func check_module_operands(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                  names:const NameBindings in B, links:const NameWork in L,
                                  selected:const SelectedExports in E, module:u64,
                                      facts:OperandFacts in F,
                                  owners:CallOwners in O, fields:const CaughtFieldUses in X,
                                      views:const SuppliedViews in H,
                                  cases:const ConstructorCaseFacts in C,
                                  demand:const DeclarationDemands in D,
                                      report:OperandCheckResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner B, const owner L, const owner E,
        owner F,
           owner O, const owner X, const owner H, const owner C, const owner D, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_operand_tree();
    ref tail = make u64 { no_node() };
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || !module_tail(nodes, tree.revision, tree.used, tree.root, tail)) return false;
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(selected) < tree.used || intrinsic (len)(facts) < tree.used ||
        intrinsic (len)(owners) < tree.used ||
        (intrinsic (len)(cases) != 0u64 && intrinsic (len)(cases) < tree.used)) {
        report.diagnostic <- operand_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        set_fact(facts, at, 0u8, 0u8, no_node(), 0u64, 0u8);
        facts[at].needs_target <- 0u8;
        facts[at].discarded_result <- 0u8;
        facts[at].arm_result <- 0u8;
        facts[at].case_item <- 0u8;
        facts[at].case_match <- misses_case_arm();
        facts[at].case_body <- 0u8;
        facts[at].case_guard <- 0u8;
        facts[at].case_resume <- 0u8;
        facts[at].case_end <- 0u8;
        facts[at].case_presence <- unknown_target();
        facts[at].case_selection <- no_node();
        facts[at].case_context <- no_node();
        facts[at].case_after_subject <- no_node();
        facts[at].case_discriminator <- 0u8;
        facts[at].case_may_be_absent <- 0u8;
        facts[at].enum_constant <- 0u8;
        facts[at].discriminator_code <- 0u64;
        facts[at].case_excluded_at <- no_node();
        facts[at].case_exit_link <- no_node();
        facts[at].case_exit_tail <- no_node();
        facts[at].product_words <- 0u64;
        facts[at].word_offset <- 0u64;
        facts[at].last_initializer <- no_node();
        facts[at].call_definition <- no_node();
        facts[at].allocation_owner <- no_node();
        facts[at].owner_chain <- no_node();
        facts[at].owner_use_next <- no_node();
        facts[at].passes_owner <- 0u8;
        facts[at].text_assertion <- 0u8;
        facts[at].text_intrinsic <- 0u8;
        owners[at].call_site <- no_node();
        owners[at].actual_owner <- no_node();
        owners[at].uses <- no_node();
    };
    report.diagnostic <- 0u8;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <-
            no_node(); readonly <- false;
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    val annotation <- no_node();
    val diagnostic <- 0u8;
    val throws_annotation <- false;
    for (at in 0u64 .. tree.used) {
        throws_annotation <- inspect_signature(nodes, tree.revision, tree.used, at,
            signature) == ThrowsSignatureClause;
        if (throws_annotation ||
            inspect_catch_binding(nodes, tree.revision, tree.used, at, caught)) {
            annotation <- if (throws_annotation) {
                (signature.annotation)
            } else { (caught.annotation) };
            diagnostic <- exception_annotation(nodes, names, selected, facts, annotation, at,
                module, tree.used, tree.revision);
            if (diagnostic != 0u8) {
                if (annotation == no_node()) return operand_problem(report, at, diagnostic);
                return operand_problem(report, annotation, diagnostic);
            };
        };
    };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    for (at in 0u64 .. tree.used) {
        if (inspect_declaration(nodes, tree.revision, tree.used, at, declaration) == NominalRecord) {
            prepare_product_layout(nodes, names, links, facts, at, tree.revision, tree.used, declaration.entries);
        };
    };
    val source_only <- intrinsic (len)(demand) != 0u64;
    val form <- InvalidCallable;
    for (at in 0u64 .. tree.used) {
        form <- inspect_callable(nodes, tree.revision, tree.used, at, callable);
        if (needs_signature_check(demand, at) && (form == ModuleCallable || (source_only &&
            (form == CEntry || form == LexicalCallable)))) {
            check_signature(nodes, names, links, facts, views, selected, cases, source_only,
                            report, at, tree.used, tree.revision, callable);
            if (report.diagnostic != 0u8) return false;
            if (form == ModuleCallable &&
                transfer_name(source, nodes, definition_name(nodes, tree.revision, tree.used,
                    at)) &&
                !supported_transfer_signature(nodes, links, facts, at, tree.used, tree.revision))
                return operand_problem(report, at, unsupported_transfer_signature());
        } else {};
    };
    for (at in 0u64 .. tree.used) {
        if (needs_signature_check(demand, at) && inspect_callable(nodes, tree.revision, tree.used,
            at, callable) == ModuleCallable && links[at].next_method != no_node()) {
            report.diagnostic <- check_transfer_signatures(nodes, links, facts, at, tree.used, tree.revision);
            if (report.diagnostic != 0u8) { report.node <- at; return false; };
        };
    };
    val at <- no_node();
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    for (offset in 0u64 .. tree.used) {
        at <- tree.used - 1u64 - offset;
        prepare_result_use(nodes, facts, at, tree.used, tree.revision);
        prepare_text_receiver(nodes, names, facts, at, tree.used, tree.revision);
        if (needs_body_check(demand, at) && inspect_case(nodes, tree.revision, tree.used, at,
            selection) && names[at].scope != no_node()) {
            (facts[selection.subject].case_after_subject <- at):void;
        } else {};
    };
    if (!check_operand_range(source, nodes, names, links, selected, facts, owners, fields, views,
        cases, demand, report,
                             0u64, tree.used, tree.used, tree.revision, no_node())) return false;
    close_allocation_owners(facts, owners, tree.used);
    # Number reserved allocation-chain words after the syntax-indexed words.
    val next <- tree.used;
    for (site in 0u64 .. tree.used) {
        if (facts[site].owner_chain != no_node()) {
            facts[site].owner_chain <- next;
            next <- next + 1u64;
        };
    };
    return true;
}
