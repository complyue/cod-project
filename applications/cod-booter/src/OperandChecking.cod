export func unproved_transfer_owner() -> UInt8 { return 44u8; }
export func unsupported_imported_call() -> UInt8 { return 45u8; }
func unsupported_imported_slot_call() -> UInt8 { return 49u8; }
export func unproved_text_receiver() -> UInt8 { return 50u8; }

func ambiguous_value_call() -> UInt8 { return 46u8; }
func duplicate_value_signature() -> UInt8 { return 47u8; }
func unsupported_value_family() -> UInt8 { return 48u8; }

export func unreachable_case_item() -> UInt8 { return 1u8; }
export func misses_case_arm() -> UInt8 { return 0u8; }
export func tests_case_arm() -> UInt8 { return 1u8; }
export func matches_case_arm() -> UInt8 { return 2u8; }

export func case_guard_passes() -> UInt8 { return 1u8; }
export func case_guard_declines() -> UInt8 { return 2u8; }
export func case_guard_tests() -> UInt8 { return 3u8; }
func case_guard_exits() -> UInt8 { return 4u8; }

func set_fact(facts:OperandFacts in F, at:UInt64, kind:UInt8, reception:UInt8,
              owner_site:UInt64, identity:UInt64, checked_exception:UInt8) -> void where {owner F} {
    facts[at].kind <- kind;
    facts[at].reception <- reception;
    facts[at].owner <- owner_site;
    facts[at].identity <- identity;
    facts[at].reservation <- no_node();
    facts[at].checked_exception <- checked_exception;
    facts[at].identity_module <- 0u64;
    facts[at].enum_backing <- 0u8;
    facts[at].loans_owning_handle <- false;
    facts[at].loans_scoped_aggregate <- false;
    facts[at].case_receipt <- no_node();
    facts[at].checks_array_bounds <- false;
    facts[at].array_scalar <- 0u8;
    facts[at].array_element_module <- 0u64;
    facts[at].array_element_identity <- no_node();
    facts[at].loans_array_slot <- false;
    facts[at].array_slot <- no_node();
    facts[at].target_readonly <- 0u8;
    facts[at].writable_text_place <- 0u8;
    facts[at].selection <- no_node();
    facts[at].text_nul <- 0u8;
    facts[at].target_presence <- if (kind == null_literal()) { absent_target() } else {
        if (reception == nullable_ptr()) { unknown_target() } else { present_target() }
    };
    return;
}

func scalar_fact(facts:OperandFacts in F, at:UInt64, reception:UInt8, owner_site:UInt64) -> void where {owner F} {
    set_fact(facts, at, scalar_u64(), reception, owner_site, 0u64, 0u8);
}

func copy_fact(facts:OperandFacts in F, destination:UInt64, source:UInt64) -> void where {owner F} {
    set_fact(facts, destination, facts[source].kind, facts[source].reception, facts[source].owner,
             facts[source].identity, facts[source].checked_exception);
    facts[destination].identity_module <- facts[source].identity_module;
    facts[destination].array_scalar <- facts[source].array_scalar;
    facts[destination].array_element_module <- facts[source].array_element_module;
    facts[destination].array_element_identity <- facts[source].array_element_identity;
    facts[destination].case_receipt <- facts[source].case_receipt;
    facts[destination].reservation <- facts[source].reservation;
    facts[destination].target_readonly <- facts[source].target_readonly;
    facts[destination].target_presence <- facts[source].target_presence;
    facts[destination].selection <- facts[source].selection;
    facts[destination].text_nul <- facts[source].text_nul;
    return;
}

func only_void(facts:OperandFacts in F, at:UInt64) -> void where {owner F} {
    set_fact(facts, at, void_result(), 0u8, no_node(), 0u64, 0u8);
}

func require_typed_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64,
    kind:UInt8) -> UInt8
    where {const owner N, owner F} {
    if (binds_local_storage(nodes, operand))
        return unproved_operand();
    return require_prepared_typed_bits(facts, operand, kind)
}

export func bits_operand_diagnostic(actual:UInt8, expected:UInt8) -> UInt8 {
    if (actual == 0u8) return unproved_operand();
    if (!scalar_kind(expected) || actual != expected) return wrong_operand_type();
    return 0u8
}

func require_prepared_typed_bits(facts:OperandFacts in F, operand:UInt64, kind:UInt8) -> UInt8 where {owner F} {
    val diagnostic <- bits_operand_diagnostic(facts[operand].kind, kind);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[operand].reception == nullable_ptr()) {
        facts[operand].needs_target <- 1u8;
        return 0u8;
    } else {};
    return 0u8;
}

func compatible_operand_nominal(facts:const OperandFacts in F, operand:UInt64, kind:UInt8, identity:UInt64,
    module:UInt64) -> bool
    where {const owner F} {
    return facts[operand].kind != kind || (kind != scalar_enum() && kind != product_kind() && kind != source_builder_loan()) ||
        (facts[operand].identity == identity && facts[operand].identity_module == module);
}

func same_operand_type(facts:const OperandFacts in F, left:UInt64, right:UInt64) -> bool where {const owner F} {
    return facts[left].kind == facts[right].kind &&
        compatible_operand_nominal(facts, left, facts[right].kind, facts[right].identity,
            facts[right].identity_module);
}

func supplies_enum_backing(facts:const OperandFacts in F, operand:UInt64, expected:UInt8) -> bool
    where {const owner F} {
    return expected != 0u8 && facts[operand].kind == scalar_enum() &&
        source_scalar_kind(facts[operand].enum_backing) == expected
}

# Consume an independent copy of the code. The original nominal type and
# the access contract of its storage remain attached to the source operand.
func require_value_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64, expected:UInt8) -> UInt8
    where {const owner N, owner F} {
    val read_kind <- if (supplies_enum_backing(facts, operand, expected)) { scalar_enum() } else { expected };
    return require_typed_bits(nodes, facts, operand, read_kind)
}

func require_matching_value_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64, expected:UInt64) -> UInt8
    where {const owner N, owner F} {
    if (!compatible_operand_nominal(facts, operand, facts[expected].kind, facts[expected].identity,
        facts[expected].identity_module)) return wrong_operand_type();
    return require_value_bits(nodes, facts, operand, facts[expected].kind)
}

func require_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64) -> UInt8
    where {const owner N, owner F} {
    return require_typed_bits(nodes, facts, operand, scalar_u64());
}

export func declared_scalar(binding:UInt8) -> UInt8 {
    if (binding == builtin_u64()) return scalar_u64();
    if (binding == builtin_u8()) return scalar_u8();
    if (binding == builtin_bool()) return scalar_bool();
    if (binding == enum_type()) return scalar_enum();
    return 0u8;
}

func source_scalar_kind(binding:UInt8) -> UInt8 {
    if (binding == builtin_u32()) return source_u32();
    return declared_scalar(binding)
}

func require_source_u32(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64,
    widen:bool) -> UInt8
    where {const owner N, owner F} {
    if (binds_local_storage(nodes, operand)) return unproved_operand();
    return require_prepared_source_u32(facts, operand, widen)
}

func require_prepared_source_u32(facts:OperandFacts in F, operand:UInt64, widen:bool)
    -> UInt8 where {owner F} {
    if (facts[operand].kind == 0u8) return unproved_operand();
    if (widen && facts[operand].kind == scalar_u8())
        return require_prepared_typed_bits(facts, operand, scalar_u8());
    if (facts[operand].kind != source_u32()) return wrong_operand_type();
    if (facts[operand].reception != local_place() &&
        facts[operand].reception != independent_value())
        return unproved_operand();
    return 0u8
}

func nominal_identity(names:const NameBindings in B, annotation:UInt64) -> UInt64 where {const owner B} {
    val kind <- names[annotation].kind;
    if (kind == enum_type() || kind == record_type()) return names[annotation].declaration;
    return 0u64;
}

func imported_enum_selection(names:const NameBindings in B, selected:const SelectedExports in E,
    marker:UInt64) -> UInt64 where {const owner B, const owner E} {
    if (names[marker].kind != ordinary_selection()) return no_node();
    val choice <- names[marker].declaration;
    if (choice >= intrinsic (len)(selected) || selected[choice].kind != enum_export() ||
        selected[choice].origin_module == 0u64 || selected[choice].origin_module == no_node() ||
        selected[choice].identity == no_node()) return no_node();
    return choice
}

func declared_borrow(names:const NameBindings in B, facts:const OperandFacts in F, annotation:UInt64) -> UInt8
    where {const owner B, const owner F} {
    if (names[annotation].kind == record_type() && facts[names[annotation].declaration].product_words != 0u64)
        return product_kind();
    val kind <- names[annotation].kind;
    if (kind == builtin_string()) return string_kind();
    if (kind == builtin_c_string()) return c_string_kind();
    return declared_scalar(kind);
}

func prepare_product_layout(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                            facts:OperandFacts in F, record:UInt64, revision:UInt64, used:UInt64, tail:UInt64) -> void
    where {const owner N, const owner B, const owner L, owner F} {
    if (has_exception_parent(nodes, names, record, revision, used)) return;
    ref field = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, field)) return;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val words <- 0u64;
    val kind <- 0u8;
    val bits <- true;
    for (unused in 0u64 .. used) {
        if (field == no_node()) {
            facts[record].product_words <- words;
            facts[record].bits_product <- bits;
            return;
        };
        if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
            (formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding) return;
        kind <- names[binding.annotation].kind;
        if (declared_scalar(kind) == 0u8 && kind != builtin_string()) return;
        bits <- bits && kind != builtin_string();
        facts[field].word_offset <- words;
        words <- words + 1u64;
        field <- links[field].next;
    };
}

export func completed_lexical_bits_target(facts:const OperandFacts in F, at:UInt64, owner_site:UInt64)
    -> bool where {const owner F} {
    if (facts[at].reception != borrowed_ref() || owner_site == no_node() ||
        facts[at].owner != owner_site || facts[at].reservation != no_node() ||
        facts[at].allocation_owner != no_node()) return false;
    if (scalar_kind(facts[at].kind)) return true;
    val type <- facts[at].identity;
    return facts[at].kind == product_kind() && facts[at].identity_module == 0u64 &&
        type < intrinsic (len)(facts) && facts[type].bits_product && facts[type].product_words != 0u64
}

func owner_conflict(nodes:const ExprNodes in N, first:UInt64, second:UInt64) -> UInt8 where {const owner N} {
    if (owner_parameter(nodes, first) || owner_parameter(nodes, second)) return unproved_owner();
    return incompatible_owner();
}

func exception_annotation(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E,
                          facts:OperandFacts in F, annotation:UInt64, at:UInt64, module:UInt64, used:UInt64,
                              revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner E, owner F} {
    if (annotation == no_node()) {
        set_fact(facts, at, exception_type(), readonly_exception(), no_node(), no_node(), 0u8);
        return 0u8;
    };
    ref type = make ExceptionType { defining_module <- 0u64; declaration <- no_node(); checked <-
        false; };
    if (!resolve_exception_type(nodes, names, selected, annotation, module, used, revision, type))
        return expected_exception_type();
    set_fact(facts, at, exception_type(), readonly_exception(), no_node(), type.declaration,
             if (type.checked) { 1u8 } else { 0u8 });
    facts[at].identity_module <- type.defining_module;
    return 0u8;
}

func check_formal(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                  views:const SuppliedViews in H, selected:const SelectedExports in E,
                  cases:const ConstructorCaseFacts in C, source_only:bool,
                  formal:UInt64, definition:UInt64, revision:UInt64, used:UInt64) -> UInt8
    where {const owner N, const owner B, owner F, const owner H, const owner E, const owner C} {
    ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val syntax <- inspect_formal(nodes, revision, used, formal, parameter);
    if (syntax == HereFormalSyntax) {
        ref contract = make HereContract {
            first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity
                <- 0u64
        };
        return if (inspect_here_contract(views, formal,
            contract)) { 0u8 } else { unproved_operand() }
    };
    if (syntax != OrdinaryFormal ||
        inspect_binding(nodes, revision, used, parameter.binding, binding) != TypedBinding) return unproved_operand();
    val form <- parameter.mode;
    val fixed <- formal_binding_is_fixed(nodes, revision, used, formal);
    val fixed_value <- fixed && form == ExplicitValueFormal && binding.owner_name == no_node();
    if (fixed && !fixed_value && (form != ReferenceFormal || binding.owner_name >= used ||
        !source_place_scalar(names[binding.target_type].kind))) return unproved_operand();
    if (source_only && formal < intrinsic (len)(cases)) {
        case cases[formal] of {
            CaseSumFormal { val bound <- definition, val owner_site <- owner_site, val readonly <- readonly,
                            val type <- value_type, } -> {
                if (bound != definition || form != ReferenceFormal || binding.readonly != readonly ||
                    binding.owner_name >= used || names[binding.owner_name].declaration != owner_site ||
                    !owner_parameter(nodes, owner_site)) return unproved_owner();
                set_fact(facts, formal, source_sum_target(), borrowed_ref(), owner_site, type.identity, 0u8);
                facts[formal].identity_module <- type.defining_module;
                facts[formal].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
                return 0u8
            };
            ArrayFieldRecordFormal { val bound <- definition, val owner_site <-, val type <- value_type, val readonly <-, } -> {
                if (bound != definition || form != ReferenceFormal || binding.readonly != readonly ||
                    binding.owner_name >= used || names[binding.owner_name].declaration != owner_site ||
                    !owner_parameter(nodes, owner_site)) return unproved_owner();
                set_fact(facts, formal, source_product_loan(), borrowed_ref(), owner_site, type.identity, 0u8);
                facts[formal].identity_module <- type.defining_module;
                facts[formal].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
                return 0u8
            };
            InlineProductFormal { val bound <- definition, val owner_site <- owner_site, val type <- value_type, val readonly <-, } -> {
                if (bound != definition || form != ReferenceFormal || binding.readonly != readonly ||
                    binding.owner_name >= used || names[binding.owner_name].declaration != owner_site ||
                    owner_constraint_syntax(nodes, owner_site) !=
                        (if (readonly) { ReadonlyOwnerConstraint } else { WritableOwnerConstraint })) return unproved_owner();
                if (!readonly || type.defining_module != 0u64 || type.identity >= used ||
                    !facts[type.identity].bits_product || facts[type.identity].product_words == 0u64) {
                    set_fact(facts, formal, source_product_loan(), borrowed_ref(), owner_site, type.identity, 0u8);
                    facts[formal].identity_module <- type.defining_module;
                    facts[formal].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
                    return 0u8
                }
            };
            WritableLocalProductFormal { val bound <- definition, val owner_site <-, val type <- value_type, } -> {
                if (bound != definition || form != ReferenceFormal || binding.readonly ||
                    binding.owner_name >= used || names[binding.owner_name].declaration != owner_site ||
                    owner_constraint_syntax(nodes, owner_site) != WritableOwnerConstraint) return unproved_owner();
                if (type.defining_module != 0u64 || type.identity >= used) return invalid_operand_tree();
                # Preserve the flat word layout when available. A nested
                # product carries its completed schema as a source loan.
                if (!facts[type.identity].bits_product || facts[type.identity].product_words == 0u64) {
                    set_fact(facts, formal, source_product_loan(), borrowed_ref(), owner_site, type.identity, 0u8);
                    return 0u8
                }
            };
            _ -> {}
        }
    };
    if (form == HandleFormal) {
        ref handle = make HandleContract { marker <- no_node(); owner_site <- no_node(); readonly <-
            false };
        if (!inspect_handle_contract(views, formal, handle)) return unproved_operand();
        if (source_only) {
            set_fact(facts, formal, source_handle_loan(), borrowed_ref(), handle.owner_site,
                     type_identity(names, selected, handle.marker), 0u8);
            facts[formal].identity_module <- type_module(names, selected, handle.marker, 0u64);
            (facts[formal].target_readonly <- if (handle.readonly) { 1u8 } else { 0u8 }):void
        };
        return 0u8
    };
    val annotation <- binding.annotation;
    val readonly <- if (binding.readonly || fixed_value) { 1u8 } else { 0u8 };
    val place <- form == PlaceFormal || form == InitializingPlaceFormal;
    if (binding.owner_name != no_node()) {
        val slot <- source_only && form == ReferenceSlotFormal;
        if (form != ReferenceFormal && form != PointerFormal && !place && !slot)
            return unproved_operand();
        val target <- binding.target_type;
        val builder <- source_only && is_lexical_builder(nodes, names, target, revision, used);
        if (builder && form != ReferenceFormal) return unproved_operand();
        val imported_enum <- if (source_only && form == ReferenceFormal) {
            imported_enum_selection(names, selected, target)
        } else { no_node() };
        val array <- source_only && (names[target].kind == array_type() ||
            (names[target].kind == ordinary_selection() &&
                selected[names[target].declaration].kind == array_export()));
        val borrowed_kind <- if (imported_enum != no_node()) { scalar_enum() } else {
            if (builder) { source_builder_loan() } else {
                if (array) { source_array_loan() } else { declared_borrow(names, facts, target) }
            }
        };
        if (names[target].kind == record_type() && (borrowed_kind == 0u8 || form == PointerFormal))
            return unsupported_product_layout();
        if (place && (borrowed_kind != string_kind() || readonly != 0u8)) return unsupported_text_operation();
        if (!place && immutable_text_kind(borrowed_kind) && (form != ReferenceFormal || readonly == 0u8))
            return unsupported_text_operation();
        if (borrowed_kind == 0u8) return unproved_operand();
        val owner_site <- names[binding.owner_name].declaration;
        if (!owner_parameter(nodes, owner_site)) return unproved_owner();
        val reception <- if (form == PointerFormal) { nullable_ptr() } else { borrowed_ref() };
        if (borrowed_kind == source_array_loan()) {
            if (form != ReferenceFormal && !slot) return unproved_operand();
            set_fact(facts, formal, borrowed_kind, reception, owner_site, type_identity(names,
                selected, target), 0u8);
            facts[formal].identity_module <- type_module(names, selected, target, 0u64);
            if (formal < intrinsic (len)(views)) {
                case views[formal] of {
                    ArraySlotFormal {
                        val owner <- owner_site, val module <- type_module, val type <- type_identity,
                        val aliases_slot <- slot, val element <-, val element_module <-, val element_identity <-,
                    } -> {
                        if (owner != owner_site || module != facts[formal].identity_module ||
                            type != facts[formal].identity || slot != aliases_slot ||
                            !valid_array_slot_element(element, element_identity, element_module, used)) return unproved_operand();
                        facts[formal].array_scalar <- slot_scalar_kind(element);
                        facts[formal].array_element_module <- element_module;
                        (facts[formal].array_element_identity <- element_identity):void;
                        # An ordinary ref formal owns a local reference binding.
                        # Ref var instead aliases the slot selected by the caller.
                        (facts[formal].array_slot <- formal):void
                    };
                    _ -> {}
                }
            };
            if (slot && facts[formal].array_slot != formal) return unproved_operand()
        } else {
            if (slot) return unproved_operand();
            val identity <- if (imported_enum != no_node()) { (selected[imported_enum].identity) }
                else { if (builder) { type_identity(names, selected, target) } else { nominal_identity(names, target) } };
            set_fact(facts, formal, borrowed_kind, reception, owner_site, identity, 0u8);
            if (imported_enum != no_node()) {
                (facts[formal].identity_module <- selected[imported_enum].origin_module):void
            } else {
                if (builder) { (facts[formal].identity_module <- type_module(names, selected, target, 0u64)):void }
            }
        };
        if (reception == nullable_ptr()) { (facts[formal].selection <- formal):void; } else {};
        facts[formal].target_readonly <- if (place) { 1u8 } else { readonly };
        if (place) { (facts[formal].writable_text_place <- 1u8):void; };
        if (borrowed_kind == c_string_kind()) { (facts[formal].text_nul <- nul_absent()):void; };
        if (owner_constraint_syntax(nodes, owner_site) == WritableOwnerConstraint && facts[owner_site].passes_owner == 0u8) {
            facts[owner_site].passes_owner <- 1u8;
            (facts[formal].passes_owner <- 1u8):void;
        };
        return 0u8;
    } else {};
    if (place) return unsupported_text_operation();
    if (form != ValueFormal && form != ExplicitValueFormal && form != ReferenceFormal &&
        form != PointerFormal) return unproved_operand();
    val declared <- names[annotation].kind;
    if (source_only || form == ValueFormal || form == ExplicitValueFormal) {
        val choice <- imported_enum_selection(names, selected, annotation);
        if (choice != no_node()) {
            set_fact(facts, formal, scalar_enum(), local_place(), definition,
                     selected[choice].identity, 0u8);
            facts[formal].identity_module <- selected[choice].origin_module;
            facts[formal].target_readonly <- readonly;
            return 0u8
        }
    };
    val kind <- if (source_only) { source_scalar_kind(declared) }
        else { declared_scalar(declared) };
    if (kind == 0u8) return unproved_operand();
    set_fact(facts, formal, kind, local_place(), definition, nominal_identity(names, annotation), 0u8);
    facts[formal].target_readonly <- readonly;
    return 0u8;
}

func check_formals(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:OperandFacts in F, views:const SuppliedViews in H,
                   selected:const SelectedExports in E, cases:const ConstructorCaseFacts in C,
                   source_only:bool, report:OperandCheckResult in R,
                   definition:UInt64, tail:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner H, const owner E,
        const owner C, owner R} {
    ref formal = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, formal)) {
        report.node <- definition;
        (report.diagnostic <- invalid_operand_tree()):void;
        return;
    };
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return;
        report.diagnostic <- check_formal(nodes, names, facts, views, selected, cases, source_only, formal,
            definition, revision, used);
        if (report.diagnostic != 0u8) { report.node <- formal; return; } else {};
        formal <- links[formal].next;
    };
}

func check_borrowed_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, definition:UInt64, clause:UInt64, signature:const SignatureSites in S,
                           revision:UInt64, used:UInt64) -> UInt8
    where {const owner N, const owner B, owner F, const owner S} {
    val annotation <- signature.annotation;
    ref type = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (names[clause].declaration != no_node() ||
        !inspect_type_annotation(nodes, revision, used, annotation, type) || type.owner_name == no_node())
        return unsupported_text_operation();
    val target <- type.target_type;
    val kind <- declared_borrow(names, facts, target);
    val owner_site <- names[type.owner_name].declaration;
    val readonly <- signature.readonly;
    if (kind != product_kind() && (!immutable_text_kind(kind) || !readonly))
        return unproved_result_contract();
    if (!owner_parameter(nodes, owner_site)) return unproved_owner();
    set_fact(facts, definition, kind, borrowed_ref(), owner_site, nominal_identity(names, target), 0u8);
    facts[definition].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
    if (kind == c_string_kind()) { (facts[definition].text_nul <- nul_absent()):void; };
    return 0u8;
}

func check_signature_clauses(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                             facts:OperandFacts in F, selected:const SelectedExports in E,
                             cases:const ConstructorCaseFacts in C,
                             report:OperandCheckResult in R, source_only:bool, definition:UInt64,
                                 first:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner E, const owner C, owner R} {
    val clause <- first;
    val annotation <- no_node();
    val kind <- 0u8;
    val choice <- no_node();
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val shape <- SignatureHead;
    val failure_seen <- false;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) return;
        shape <- inspect_signature(nodes, revision, used, clause, signature);
        annotation <- signature.annotation;
        if (shape == ValueResultClause) {
            if (names[annotation].kind == builtin_void()) {
                only_void(facts, definition);
            } else {
                if (names[annotation].kind == ordinary_selection() &&
                    selected[names[annotation].declaration].kind == enum_export()) {
                    kind <- scalar_enum();
                    choice <- names[annotation].declaration;
                    set_fact(facts, definition, kind, independent_value(), no_node(),
                        selected[choice].identity, 0u8);
                    (facts[definition].identity_module <- selected[choice].origin_module):void
                } else {
                    kind <- if (source_only) { source_scalar_kind(names[annotation].kind) }
                        else { declared_scalar(names[annotation].kind) };
                    if (kind != 0u8) {
                        set_fact(facts, definition, kind, independent_value(), no_node(),
                            nominal_identity(names, annotation), 0u8)
                    } else {
                        if (source_only && definition < intrinsic (len)(cases)) {
                            case cases[definition] of {
                                SumValueResult { val type <- value_type, } -> {
                                    kind <- independent_sum_bits();
                                    set_fact(facts, definition, kind, independent_value(),
                                        no_node(), type.identity, 0u8);
                                    (facts[definition].identity_module <- type.defining_module):void
                                };
                                _ -> {}
                            }
                        };
                    };
                    if (kind == 0u8) {
                        report.node <- annotation;
                        report.diagnostic <- unproved_result_contract();
                        return
                    }
                }
            };
        };
        if (shape == BorrowedResultClause) {
            (report.diagnostic <- check_borrowed_result(nodes, names, facts, definition, clause, signature, revision, used)):void;
        };
        if (shape == ThrowsSignatureClause) {
            if (failure_seen) {
                report.node <- clause;
                report.diagnostic <- unsupported_imported_call();
                return
            };
            failure_seen <- true;
            if (facts[clause].kind != exception_type()) { (report.diagnostic <-
                expected_exception_type()):void; };
            if (report.diagnostic != 0u8) { report.node <- annotation; return; };
        };
        if (report.diagnostic != 0u8) { report.node <- clause; return; };
        clause <- links[clause].next;
    };
}

func check_signature(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     facts:OperandFacts in F, views:const SuppliedViews in H,
                     selected:const SelectedExports in E, cases:const ConstructorCaseFacts in P,
                     source_only:bool, module_callable:bool, report:OperandCheckResult in R, definition:UInt64, used:UInt64,
                         revision:UInt64, callable:const CallableSites in C) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner H, const owner E,
        const owner P, owner R, const owner C} {
    ref head = make UInt64 { no_node() };
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, head) ||
        inspect_signature(nodes, revision, used, head, sites) != SignatureHead) {
        report.node <- definition;
        (report.diagnostic <- invalid_operand_tree()):void;
        return;
    };
    check_formals(nodes, names, links, facts, views, selected, cases, source_only, report, definition,
        sites.parameter_tail, used, revision);
    if (report.diagnostic != 0u8) return;
    check_signature_clauses(nodes, names, links, facts, selected, cases, report, source_only, definition,
        links[head].next, used, revision);
    if (report.diagnostic != 0u8 || facts[definition].kind != 0u8) return;
    if (source_only && omits_callable_result(nodes, revision, used, callable.signature)) {
        if (!callable.function_form) {
            only_void(facts, definition);
            return
        };
        if (module_callable &&
            names[definition].declaration == definition && links[definition].next_method == no_node() &&
            links[definition].active == no_node()) {
            (facts[definition].omitted_result <- true):void;
            return
        }
    };
    report.node <- head;
    (report.diagnostic <- unproved_result_contract()):void
}

func procedure_operand_kind(nodes:const ExprNodes in N, names:const NameBindings in B,
    annotation:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B} {
    ref type = make ProcedureTypeSites { name <- no_node(); mode <- ValueFormal; readonly <- false };
    if (!inspect_procedure_type(nodes, revision, used, annotation, type) ||
        (type.mode != ValueFormal && type.mode != ExplicitValueFormal)) return 0u8;
    val binding <- names[type.name].kind;
    return if (binding == builtin_void()) { void_result() } else { source_scalar_kind(binding) }
}

func check_scoped_operand_signature(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, views:const SuppliedViews in H, selected:const SelectedExports in E,
    cases:const ConstructorCaseFacts in P, report:OperandCheckResult in R, definition:UInt64, used:UInt64,
    revision:UInt64, handler:const ScopedProcedureSites in C) -> void
    where {const owner N, const owner B, const owner L, owner F, const owner H, const owner E,
        const owner P, owner R, const owner C} {
    ref head = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    ref contract = make ProcedureSymbolSites {
        symbol <- no_node(); input_tail <- no_node(); result_type <- no_node(); arrow <- no_node()
    };
    if (inspect_signature(nodes, revision, used, handler.head, head) != ScopedProcedureHead ||
        names[head.name].kind != procedure_symbol_binding() ||
        !inspect_procedure_symbol(nodes, revision, used, names[head.name].declaration, contract)) {
        report.node <- definition;
        report.diagnostic <- invalid_operand_tree();
        return
    };
    check_formals(nodes, names, links, facts, views, selected, cases, true, report,
        definition, head.parameter_tail, used, revision);
    if (report.diagnostic != 0u8) return;
    val kind <- procedure_operand_kind(nodes, names, contract.result_type, used, revision);
    if (kind == 0u8) {
        report.node <- handler.signature;
        report.diagnostic <- unproved_result_contract();
        return
    };
    # The head carries the already matched return type. The definition node
    # denotes the installation expression, which has no value.
    set_result(facts, handler.head, kind)
}

export func allocated_source_array(facts:const OperandFacts in F, at:UInt64) -> bool
    where {const owner F} {
    return facts[at].kind == source_array_loan() && facts[at].allocation_owner != no_node()
}

export func has_slot_array(facts:const OperandFacts in F, at:UInt64) -> bool
    where {const owner F} {
    return facts[at].kind == source_array_loan() &&
        (facts[at].array_scalar != 0u8 || facts[at].array_element_identity != no_node())
}

func slot_scalar_kind(element:ArraySlotElement) -> UInt8 {
    if (element == (ByteArrayElement:ArraySlotElement)) return scalar_u8();
    if (element == (UInt64ArrayElement:ArraySlotElement)) return scalar_u64();
    if (element == (BoolArrayElement:ArraySlotElement)) return scalar_bool();
    if (element == (EnumArrayElement:ArraySlotElement)) return scalar_enum();
    return 0u8
}

func valid_array_slot_element(element:ArraySlotElement, identity:UInt64, module:UInt64, used:UInt64) -> bool {
    if (element == EnumArrayElement || element == SumArrayElement)
        return identity != no_node() && module != no_node() && (module != 0u64 || identity < used);
    return (slot_scalar_kind(element) != 0u8 || element == (ProductArrayElement:ArraySlotElement)) &&
        identity == no_node() && module == 0u64
}

func check_local(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64, source_only:bool, local:const LocalBindingSites in L) -> UInt8
    where {const owner N, const owner B, const owner E, owner F, const owner L} {
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, local.binding, binding) == InvalidBindingSyntax) return invalid_operand_tree();
    val initializer <- local.initializer;
    val type_name <- binding.target_type;
    val value_binding <- local.mode == ValueLocal;
    val readonly <- if (binding.readonly || (value_binding && local.declaration_const)) { 1u8 } else { 0u8 };
    val pointer <- local.mode == PointerLocal;
    if (value_binding && binding.owner_name != no_node()) return unproved_operand();
    val required_owner <- if (binding.owner_name == no_node()) { no_node() } else { (names[binding.owner_name].declaration) };
    if (source_only && facts[initializer].kind == source_builder_loan()) {
        if (local.mode != ReferenceLocal) return unsupported_text_operation();
        val actual <- facts[initializer].owner;
        if (required_owner != no_node() && actual != required_owner)
            return owner_conflict(nodes, actual, required_owner);
        if (type_name != no_node()) {
            if (!is_lexical_builder(nodes, names, type_name, revision, used) ||
                facts[initializer].identity != type_identity(names, selected, type_name) ||
                facts[initializer].identity_module != type_module(names, selected, type_name, 0u64))
                return wrong_operand_type();
            if (readonly == 0u8 && facts[initializer].target_readonly != 0u8)
                return expected_writable_place()
        };
        copy_fact(facts, at, initializer);
        if (readonly != 0u8) { (facts[at].target_readonly <- readonly):void };
        return 0u8
    };
    if (facts[initializer].kind == generic_member_loan()) {
        if (local.mode != ReferenceLocal || type_name != no_node() ||
            facts[initializer].reception != borrowed_ref() || facts[initializer].target_presence != present_target())
            return unproved_operand();
        if (facts[initializer].owner != names[at].scope)
            return unproved_owner();
        if (required_owner != no_node() && facts[initializer].owner != required_owner)
            return owner_conflict(nodes, facts[initializer].owner, required_owner);
        copy_fact(facts, at, initializer);
        if (readonly != 0u8) { (facts[at].target_readonly <- readonly):void };
        return 0u8
    };
    if (source_only && facts[initializer].kind == source_array_loan()) {
        if (local.mode != ReferenceLocal || facts[initializer].reception != borrowed_ref() ||
            facts[initializer].target_presence != present_target()) return unproved_nonnull_borrow();
        val array_owner <- facts[initializer].owner;
        if (array_owner >= used) return unproved_owner();
        if (required_owner != no_node() && array_owner != required_owner)
            return owner_conflict(nodes, array_owner, required_owner);
        if (type_name != no_node()) {
            val marker <- names[type_name].kind;
            val declaration <- names[type_name].declaration;
            if (marker != array_type() &&
                (marker != ordinary_selection() || declaration >= used ||
                 selected[declaration].kind != array_export())) return wrong_operand_type();
            if (type_module(names, selected, type_name, 0u64) != facts[initializer].identity_module ||
                type_identity(names, selected, type_name) != facts[initializer].identity) return wrong_operand_type();
            if (readonly == 0u8 && facts[initializer].target_readonly != 0u8)
                return expected_writable_place()
        };
        copy_fact(facts, at, initializer);
        facts[at].array_slot <- if (local.declaration_const) { no_node() } else { at };
        if (readonly != 0u8) { (facts[at].target_readonly <- readonly):void };
        return 0u8
    };
    val declared_kind <- if (type_name == no_node()) { 0u8 } else { declared_borrow(names, facts, type_name) };
    val identity <- if (type_name == no_node()) { (facts[initializer].identity) } else { nominal_identity(names, type_name) };
    val module <- if (type_name == no_node()) { (facts[initializer].identity_module) } else { 0u64 };
    if (type_name != no_node() && (value_binding || (source_only && local.mode == ReferenceLocal))) {
        val choice <- imported_enum_selection(names, selected, type_name);
        if (choice != no_node()) {
            declared_kind <- scalar_enum();
            identity <- selected[choice].identity;
            (module <- selected[choice].origin_module):void
        }
    };
    if (declared_kind == product_kind() || facts[initializer].kind == product_kind()) {
        if (value_binding || pointer) return unsupported_product_layout();
    };
    if (immutable_text_kind(declared_kind) || immutable_text_kind(facts[initializer].kind)) {
        if (value_binding || pointer) return unsupported_text_operation();
    };
    if (declared_kind == 0u8 && type_name != no_node()) return unproved_operand();
    if (declared_kind == scalar_enum() && facts[initializer].kind == scalar_enum() &&
        !compatible_operand_nominal(facts, initializer, declared_kind, identity, module))
        return incompatible_enum_type();
    if (facts[initializer].kind == never_result()) {
        ref construction = make ConstructionSites {
            requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
            initializer <- no_node(); contents <- no_node();
        };
        val shape <- inspect_construction(nodes, revision, used, initializer, construction);
        if (required_owner != no_node() && (shape == BracedConstruction || shape == PositionalConstruction)) {
            val placement <- facts[initializer].allocation_owner;
            val placement_owner <- if (placement == no_node()) { (names[initializer].scope) } else { placement };
            if (required_owner != placement_owner) return owner_conflict(nodes, placement_owner, required_owner);
        };
        set_result(facts, at, never_result());
        return 0u8;
    } else {};
    if (value_binding) {
        val value_kind <- if (declared_kind == 0u8) { (facts[initializer].kind) } else { declared_kind };
        if (reserves_storage(nodes, revision, used, initializer)) {
            if (facts[initializer].kind != value_kind) return wrong_operand_type();
            set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
            if (value_kind == scalar_enum()) { (facts[at].identity_module <- module):void };
            facts[at].target_readonly <- readonly;
            facts[at].reservation <- initializer;
            return 0u8;
        } else {};
        val initializer_kind <- facts[initializer].kind;
        val widen <- source_only && value_kind == scalar_u64() &&
            (initializer_kind == scalar_u8() || initializer_kind == source_u32());
        val diagnostic <- if (widen) { require_widening_u64(nodes, facts, initializer) }
            else { require_value_bits(nodes, facts, initializer, value_kind) };
        if (diagnostic != 0u8) return diagnostic;
        set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
        if (value_kind == scalar_enum()) { (facts[at].identity_module <- module):void };
        facts[at].target_readonly <- readonly;
        return 0u8;
    } else {};
    if (binds_local_storage(nodes, initializer)) return unproved_operand();
    val reception <- if (pointer) { nullable_ptr() } else { borrowed_ref() };
    val fresh <- facts[initializer].reception == independent_value();
    val kind <- if (type_name == no_node()) { (facts[initializer].kind) } else { declared_kind };
    val owner_site <- if (fresh) { (names[at].scope) } else { (facts[initializer].owner) };
    if (required_owner != no_node()) {
        if (owner_site != no_node() && owner_site != required_owner)
            return owner_conflict(nodes, owner_site, required_owner);
        (owner_site <- required_owner):void;
    } else {};
    if (facts[initializer].kind == null_literal()) {
        if (!pointer) return unproved_nonnull_borrow();
    } else {
        if (immutable_text_kind(kind)) {
            if (!immutable_text_kind(facts[initializer].kind)) return string_operand_required();
            if (kind == c_string_kind() && facts[initializer].kind != c_string_kind() &&
                !(text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, initializer)) == NulFreeLiteral && facts[initializer].text_nul == nul_absent()))
                return c_string_operand_required();
        } else {
            if ((!scalar_kind(kind) && kind != product_kind()) || facts[initializer].kind != kind)
                return unproved_operand();
        };
        if (kind == product_kind() && facts[initializer].identity != identity) return wrong_operand_type();
        if (type_name != no_node() && facts[initializer].target_readonly != 0u8 && readonly == 0u8)
            return expected_writable_place();
    };
    if (owner_site == no_node()) return unproved_owner();
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].identity_module <- facts[initializer].identity_module;
    facts[at].target_readonly <- if (type_name == no_node()) { (facts[initializer].target_readonly) } else { readonly };
    facts[at].reservation <- facts[initializer].reservation;
    facts[at].text_nul <- facts[initializer].text_nul;
    if (pointer) {
        facts[at].target_presence <- facts[initializer].target_presence;
        val selection <- facts[initializer].selection;
        (facts[at].selection <- if (selection == no_node()) { at } else { selection }):void;
    } else {};
    return 0u8;
}

func require_widening_u64(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:UInt64) -> UInt8
    where {const owner N, owner F} {
    if (binds_local_storage(nodes, operand)) return unproved_operand();
    return require_prepared_widening_u64(facts, operand)
}

func require_prepared_widening_u64(facts:OperandFacts in F, operand:UInt64) -> UInt8 where {owner F} {
    val kind <- facts[operand].kind;
    if (kind == source_u32()) return require_prepared_source_u32(facts, operand, false);
    return require_prepared_typed_bits(facts, operand, if (kind == scalar_u8()) { scalar_u8() } else { scalar_u64() })
}

func check_prepared_array_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64,
    requested:UInt64, placement:UInt64, length:UInt64, fill:UInt64, owner_site:UInt64,
    type_module_id:UInt64, type_identity_id:UInt64, element:ArraySlotElement, element_module:UInt64,
    element_identity:UInt64) -> UInt8
    where {const owner N, const owner B, const owner E, owner F} {
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    if (requested >= at || length >= fill || fill >= at || owner_site >= used ||
        inspect_construction(nodes, revision, used, at, syntax) != PositionalConstruction ||
        syntax.requested != requested || syntax.placement != placement || syntax.queried_operand != no_node())
        return invalid_operand_tree();
    ref count_entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref fill_entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (inspect_sequence_entry(nodes, revision, used, syntax.contents, fill_entry) != ArgumentSequence ||
        inspect_sequence_entry(nodes, revision, used, fill_entry.previous, count_entry) != ArgumentSequence ||
        count_entry.previous != no_node() || count_entry.item != length || fill_entry.item != fill)
        return invalid_operand_tree();
    val element_kind <- slot_scalar_kind(element);
    val product <- element == (ProductArrayElement:ArraySlotElement);
    val sum <- element == (SumArrayElement:ArraySlotElement);
    if (placement == no_node()) {
        if (names[at].scope != owner_site) return unproved_owner()
    } else {
        if (placement >= at || owner_site >= at || names[placement].declaration != owner_site ||
            owner_constraint_syntax(nodes, owner_site) != WritableOwnerConstraint)
            return unproved_owner()
    };
    if (names[requested].kind == ordinary_selection()) {
        val bound <- names[requested].declaration;
        if (bound >= used || bound >= intrinsic (len)(selected) || selected[bound].kind != array_export())
            return unproved_operand()
    } else {
        if (names[requested].kind != array_type()) return unproved_operand()
    };
    if (type_identity_id == no_node() || type_identity(names, selected, requested) != type_identity_id ||
        type_module(names, selected, requested, 0u64) != type_module_id) return unproved_operand();
    if (facts[length].kind == never_result()) { set_result(facts, at, never_result()); return 0u8 };
    val diagnostic <- require_widening_u64(nodes, facts, length);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[fill].kind == never_result()) { set_result(facts, at, never_result()); return 0u8 };
    if (element_kind != 0u8) {
        if (!compatible_operand_nominal(facts, fill, element_kind, element_identity, element_module))
            return wrong_operand_type();
        diagnostic <- require_typed_bits(nodes, facts, fill, element_kind);
        if (diagnostic != 0u8) return diagnostic
    } else {
        val expected <- if (product) { independent_product_bits() } else { independent_sum_bits() };
        if (facts[fill].kind != expected ||
            facts[fill].reception != independent_value() || facts[fill].identity != element_identity ||
            facts[fill].identity_module != element_module) return wrong_operand_type()
    };
    set_fact(facts, at, source_array_loan(), borrowed_ref(), owner_site, type_identity_id, 0u8);
    facts[at].identity_module <- type_module_id;
    facts[at].array_scalar <- element_kind;
    if (element_kind == scalar_enum() || sum) {
        facts[at].array_element_module <- element_module;
        (facts[at].array_element_identity <- element_identity):void
    };
    facts[at].allocation_owner <- owner_site;
    # An explicit owner role carries an allocator requirement to its caller.
    if (placement != no_node()) { (facts[owner_site].owner_chain <- 0u64):void };
    return 0u8
}

func check_text_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                             facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64,
                             construction:const ConstructionSites in L) -> UInt8
    where {const owner N, const owner B, owner F, const owner L} {
    val tail <- construction.contents;
    ref argument = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, tail, argument) != ArgumentSequence ||
        argument.previous != no_node()) return unsupported_text_operation();
    val source <- argument.item;
    val placement <- construction.placement;
    val owner_site <- facts[at].allocation_owner;
    if (placement != no_node()) { (owner_site <- names[placement].declaration):void; };
    if (owner_site == no_node()) { (owner_site <- names[at].scope):void; };
    if (owner_constraint_syntax(nodes, owner_site) == ReadonlyOwnerConstraint)
        return readonly_owner_argument();
    facts[at].allocation_owner <- owner_site;
    (facts[owner_site].owner_chain <- 0u64):void;
    if (facts[source].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (!immutable_text_kind(facts[source].kind) && facts[source].kind != source_builder_loan())
        return string_operand_required();
    set_fact(facts, at, string_kind(), borrowed_ref(), owner_site, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- facts[source].text_nul;
    return 0u8;
}

func check_text_assertion(facts:OperandFacts in F, at:UInt64, operand:UInt64) -> UInt8
    where {owner F} {
    if (facts[operand].kind == never_result()) { copy_fact(facts, at, operand); return 0u8; };
    if (!immutable_text_kind(facts[operand].kind)) return string_operand_required();
    if (facts[operand].text_nul == nul_present()) return interior_literal_nul();
    set_fact(facts, at, c_string_kind(), borrowed_ref(), facts[operand].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- nul_absent();
    (facts[at].text_assertion <- if (facts[operand].text_nul == nul_absent()) { 0u8 } else { 1u8 }):void;
    return 0u8;
}

# An empty builder still acquires its descriptor and registers lexical cleanup.
func check_empty_builder(names:const NameBindings in B,
    selected:const SelectedExports in E, facts:OperandFacts in F, at:UInt64,
    construction:const ConstructionSites in C) -> UInt8
    where {const owner B, const owner E, owner F, const owner C} {
    if (construction.contents != no_node()) return unsupported_text_operation();
    val placement <- construction.placement;
    val owner_site <- names[at].scope;
    if (placement != no_node() && names[placement].declaration != owner_site)
        return unproved_owner();
    val type <- construction.requested;
    set_fact(facts, at, source_builder_loan(), borrowed_ref(), owner_site,
        type_identity(names, selected, type), 0u8);
    facts[at].identity_module <- type_module(names, selected, type, 0u64);
    facts[at].allocation_owner <- owner_site;
    (facts[owner_site].owner_chain <- 0u64):void;
    return 0u8
}

func check_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                        selected:const SelectedExports in E,
                        facts:OperandFacts in F, at:UInt64, construction:const ConstructionSites in L) -> UInt8
    where {const owner N, const owner B, const owner E, owner F, const owner L} {
    val requested <- construction.requested;
    val queried <- construction.queried_operand;
    val imported <- if (queried == no_node()) {
        imported_enum_selection(names, selected, requested)
    } else { no_node() };
    val kind <- if (queried == no_node()) { declared_scalar(names[requested].kind) } else { (facts[queried].kind) };
    val identity <- if (queried == no_node()) { nominal_identity(names, requested) } else { (facts[queried].identity) };
    val module <- if (queried == no_node()) { 0u64 } else { (facts[queried].identity_module) };
    if (imported != no_node()) {
        kind <- scalar_enum();
        identity <- selected[imported].identity;
        (module <- selected[imported].origin_module):void
    };
    if (!scalar_kind(kind)) return unproved_operand();
    val owner_site <- names[at].scope;
    val explicit_owner <- construction.placement;
    if (explicit_owner != no_node() && names[explicit_owner].declaration != owner_site) return unproved_owner();
    val body <- construction.contents;
    if (body == no_node()) {
        set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
        facts[at].identity_module <- module;
        facts[at].reservation <- at;
        return 0u8;
    } else {};
    if (facts[body].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (kind == scalar_enum() && !compatible_operand_nominal(facts, body, kind, identity, module))
        return incompatible_enum_type();
    val diagnostic <- require_value_bits(nodes, facts, body, kind);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
    facts[at].identity_module <- module;
    return 0u8;
}

data ProductInitialization {
    count:UInt64,
    abrupt:bool,
}

export func check_owner_access(nodes:const ExprNodes in N, actual_owner:UInt64, requires_allocation:bool) -> UInt8
    where {const owner N} {
    if (actual_owner == no_node()) return unproved_owner();
    val readonly_owner <- actual_owner == static_text_owner() ||
        owner_constraint_syntax(nodes, actual_owner) == ReadonlyOwnerConstraint;
    if (readonly_owner && requires_allocation) return readonly_owner_argument();
    return 0u8;
}

func record_owner_argument(nodes:const ExprNodes in N, facts:OperandFacts in F, owners:CallOwners in O,
                           formal:UInt64, actual_owner:UInt64, argument:UInt64, invocation:UInt64) -> UInt8
    where {const owner N, owner F, owner O} {
    val formal_owner <- facts[formal].owner;
    val diagnostic <- check_owner_access(nodes, actual_owner, owner_constraint_syntax(nodes, formal_owner) != ReadonlyOwnerConstraint);
    if (diagnostic != 0u8) return diagnostic;
    if (owners[formal_owner].call_site == invocation && owners[formal_owner].actual_owner != actual_owner)
        return owner_conflict(nodes, owners[formal_owner].actual_owner, actual_owner);
    owners[formal_owner].call_site <- invocation;
    owners[formal_owner].actual_owner <- actual_owner;
    if (facts[formal].passes_owner != 0u8) {
        facts[argument].owner_use_next <- owners[formal_owner].uses;
        (owners[formal_owner].uses <- argument):void;
    };
    return 0u8;
}

func binary_formals(nodes:const ExprNodes in N, links:const NameWork in L,
                     definition:UInt64, revision:UInt64, used:UInt64) -> UInt64 where {const owner N, const owner L} {
    ref first = make UInt64 { no_node() };
    if (!callable_formals(nodes, revision, used, definition, false, first) || first == no_node()) return no_node();
    val second <- links[first].next;
    if (second == no_node() || links[second].next != no_node()) return no_node();
    return first;
}

func owner_parameter(nodes:const ExprNodes in N, owner_site:UInt64) -> bool where {const owner N} {
    return owner_constraint_syntax(nodes, owner_site) != NotOwnerConstraint;
}

func shares_owner(nodes:const ExprNodes in N, facts:const OperandFacts in F, first:UInt64, second:UInt64) -> bool
    where {const owner N, const owner F} {
    return facts[first].owner == facts[second].owner && owner_parameter(nodes, facts[first].owner);
}

func text_conforms(actual:UInt8, formal:UInt8) -> bool {
    return actual == formal || (actual == c_string_kind() && formal == string_kind());
}

func matching_transfer() -> UInt8 { return 1u8; }
func possible_transfer() -> UInt8 { return 2u8; }

func transfer_match(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                    left:UInt64, right:UInt64, method:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, method, revision, used);
    val second <- links[first].next;
    if (!same_operand_type(facts, left, first) || !text_conforms(facts[right].kind, facts[second].kind))
        return 0u8;
    if (!shares_owner(nodes, facts, first, second) || facts[left].owner == facts[right].owner)
        return matching_transfer();
    if (owner_parameter(nodes, facts[left].owner) && owner_parameter(nodes, facts[right].owner))
        return possible_transfer();
    return 0u8;
}

# All admitted policies have a writable destination and readonly text input.
# Text conformance and owner equality constrain independent parts of the domain.
func transfer_dominates(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        narrow:UInt64, wide:UInt64, match_kind:UInt8, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, narrow, revision, used);
    val other <- binary_formals(nodes, links, wide, revision, used);
    val second <- links[first].next;
    val other_second <- links[other].next;
    if (!text_conforms(facts[second].kind, facts[other_second].kind)) return false;
    val narrow_owner <- shares_owner(nodes, facts, first, second);
    val wide_owner <- shares_owner(nodes, facts, other, other_second);
    if (wide_owner && !narrow_owner) return false;
    if (narrow_owner && !wide_owner && match_kind != matching_transfer()) return false;
    return narrow_owner != wide_owner || facts[second].kind != facts[other_second].kind;
}

func dominated_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        left:UInt64, right:UInt64, family:UInt64, method:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    val other <- family;
    val relation <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (other == no_node()) return false;
        if (other != method) {
            relation <- transfer_match(nodes, links, facts, left, right, other, used, revision);
            if (relation != 0u8 && transfer_dominates(nodes, links, facts, other, method, relation, used, revision))
                return true;
        };
        other <- links[other].next_method;
    };
    return false;
}

func select_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                     left:UInt64, right:UInt64, family:UInt64, selected:UInt64 in D, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner L, const owner F, owner D} {
    val method <- family;
    val relation <- 0u8;
    val ambiguous <- false;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (method == no_node()) {
            if (ambiguous) return ambiguous_transfer();
            return if (selected == no_node()) { unproved_text_policy() } else { 0u8 };
        };
        relation <- transfer_match(nodes, links, facts, left, right, method, used, revision);
        if (relation != 0u8 && !dominated_transfer(nodes, links, facts, left, right, family, method, used, revision)) {
            if (relation == possible_transfer()) return unproved_transfer_owner();
            if (selected != no_node()) { (ambiguous <- true):void; };
            (selected <- method):void;
        };
        method <- links[method].next_method;
    };
    return invalid_operand_tree();
}

func supported_transfer_signature(nodes:const ExprNodes in N, links:const NameWork in L,
                                  facts:const OperandFacts in F, definition:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition, revision, used);
    if (first == no_node() || facts[definition].kind != void_result()) return false;
    val second <- links[first].next;
    val place <- facts[first].writable_text_place != 0u8 ||
        (facts[first].kind == product_kind() && facts[first].target_readonly == 0u8);
    return place && facts[first].reception == borrowed_ref() &&
        facts[second].reception == borrowed_ref() && facts[second].writable_text_place == 0u8 &&
        immutable_text_kind(facts[second].kind);
}

func check_transfer_signatures(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                               definition:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition, revision, used);
    val second <- links[first].next;
    val member <- links[definition].next_method;
    val other <- no_node();
    val other_second <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (member == no_node()) return 0u8;
        other <- binary_formals(nodes, links, member, revision, used);
        if (is_function(nodes, definition) != is_function(nodes, member))
            return unsupported_transfer_signature();
        other_second <- links[other].next;
        if (same_operand_type(facts, first, other) && same_operand_type(facts, second, other_second) &&
            shares_owner(nodes, facts, first, second) == shares_owner(nodes, facts, other, other_second))
            return duplicate_transfer_signature();
        member <- links[member].next_method;
    };
    return invalid_operand_tree();
}

func check_transfer_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:OperandFacts in F, owners:CallOwners in O, at:UInt64, destination:UInt64, input:UInt64, initializing:bool, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, owner O} {
    if (names[at].kind != callable_binding()) return unproved_text_policy();
    if (facts[destination].kind == product_kind() &&
        (facts[destination].target_readonly != 0u8 || facts[destination].reception != borrowed_ref()))
        return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    val family <- names[at].declaration;
    val definition <- no_node();
    val diagnostic <- select_transfer(nodes, links, facts, destination, input, family, definition, used, revision);
    if (diagnostic != 0u8) return diagnostic;
    val place <- binary_formals(nodes, links, definition, revision, used);
    val text <- links[place].next;
    ref place_contract = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (initializing && (inspect_formal(nodes, revision, used, place, place_contract) != OrdinaryFormal ||
        place_contract.mode != InitializingPlaceFormal)) return text_place_needs_initializer();
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val place_owner <- facts[destination].owner;
    diagnostic <- record_owner_argument(nodes, facts, owners, place, place_owner, at, at);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- record_owner_argument(nodes, facts, owners, text, facts[input].owner, input, at);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, void_result(), 0u8, place_owner, 0u64, 0u8);
    facts[at].call_definition <- definition;
    return 0u8;
}

func record_field_binding(nodes:const ExprNodes in N, revision:UInt64, used:UInt64,
                          field:UInt64, binding:BindingSites in R) -> bool where {const owner N, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    return inspect_formal(nodes, revision, used, field, formal) == OrdinaryFormal &&
        inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding;
}

func check_product_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N,
                               names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                               owners:CallOwners in O, state:ProductInitialization in P, at:UInt64, record:UInt64, assignment:UInt64,
                               used:UInt64, revision:UInt64) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O, owner P} {
    ref sites = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    if (inspect_assignment(nodes, revision, used, assignment, sites) != FieldTransfer ||
        names[sites.destination].kind != record_initializer_label()) return unsupported_product_layout();
    val name <- ungrouped(nodes, revision, used, sites.destination);
    if (name_syntax(nodes, used, name) != OrdinaryName) return unsupported_product_layout();
    val field <- find_record_field(source, nodes, links, record, name, revision, used);
    if (field == no_node()) return unknown_product_field();
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!record_field_binding(nodes, revision, used, field, binding)) return invalid_operand_tree();
    val first <- facts[field].last_initializer != at;
    if (!first && binding.readonly) return repeated_readonly_initializer();
    val value <- sites.input;
    val annotation <- binding.annotation;
    if (names[annotation].kind == builtin_string()) {
        val destination <- sites.destination;
        set_fact(facts, destination, string_kind(), borrowed_ref(), names[at].scope, 0u64, 0u8);
        facts[destination].writable_text_place <- 1u8;
        val diagnostic <- check_transfer_call(nodes, names, links, facts, owners, assignment, destination, value, true, used, revision);
        if (diagnostic != 0u8) return diagnostic;
    } else {
        if (facts[value].kind == never_result()) {
            (state.abrupt <- true):void;
        } else {
            val kind <- declared_scalar(names[annotation].kind);
            val bits_problem <- require_value_bits(nodes, facts, value, kind);
            if (bits_problem != 0u8) return bits_problem;
            if (kind == scalar_enum() && facts[value].identity != nominal_identity(names, annotation))
                return incompatible_enum_type();
        };
    };
    facts[field].last_initializer <- at;
    facts[assignment].word_offset <- facts[field].word_offset;
    if (first) { (state.count <- state.count + 1u64):void; };
    return 0u8;
}

func check_product_construction(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                                owners:CallOwners in O, at:UInt64, record:UInt64, used:UInt64, revision:UInt64,
                                construction:const ConstructionSites in K) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O, const owner K} {
    val words <- facts[record].product_words;
    val body <- construction.contents;
    if (words == 0u64 || body == no_node()) return unsupported_product_layout();
    val owner_site <- names[at].scope;
    val placement <- construction.placement;
    if (placement != no_node() && names[placement].declaration != owner_site) return unproved_owner();
    ref state = make ProductInitialization { count <- 0u64; abrupt <- false; };
    ref tail = make UInt64 { no_node() };
    ref item = make UInt64 { no_node() };
    if (!block_tail(nodes, revision, used, body, tail) ||
        !first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return invalid_operand_tree();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val diagnostic <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) {
            if (state.count != words) return missing_product_initializer();
            facts[at].product_words <- words;
            if (state.abrupt) { set_result(facts, at, never_result()); }
            else { set_fact(facts, at, product_kind(), borrowed_ref(), owner_site, record, 0u8); };
            return 0u8;
        };
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return invalid_operand_tree();
        diagnostic <- check_product_initializer(source, nodes, names, links, facts, owners, state,
                                                at, record, entry.item, used, revision);
        if (diagnostic != 0u8) return diagnostic;
        (item <- links[item].next):void;
    };
    return invalid_operand_tree();
}

func check_caught_field(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F,
                         fields:const CaughtFieldUses in X, at:UInt64, receiver:UInt64, used:UInt64,
                             revision:UInt64, source_only:bool) -> UInt8
    where {const owner N, const owner B, owner F, const owner X} {
    if (at >= intrinsic (len)(fields)) return unknown_exception_field();
    val name <- ungrouped(nodes, revision, used, receiver);
    if (name_syntax(nodes, used, name) != OrdinaryName || names[name].kind != exception_binding())
        return unknown_exception_field();
    return case fields[at] of {
        (CaughtField { val binding <- binding, val nominal <- nominal, val kind <- kind, val
            readonly <- readonly, }) -> {
            if (names[name].declaration != binding ||
                facts[receiver].identity_module != nominal.defining_module ||
                facts[receiver].identity != nominal.declaration) return unknown_exception_field();
            if (kind == builtin_u32() && !source_only) return unsupported_narrow_execution();
            set_result(facts, at, source_scalar_kind(kind));
            facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
            return 0u8
        };
        _ -> unknown_exception_field()
    }
}

func check_field_access(source:const SourceBytes in S, nodes:const ExprNodes in N,
                        names:const NameBindings in B, links:const NameWork in L,
                            facts:OperandFacts in F,
                        fields:const CaughtFieldUses in X, at:UInt64, used:UInt64, revision:UInt64,
                        selection:const FieldSelectionSites in Q, source_only:bool) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, owner F, const owner X,
        const owner Q} {
    val receiver <- selection.receiver;
    if (facts[receiver].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (facts[receiver].kind == exception_type())
        return check_caught_field(nodes, names, facts, fields, at, receiver, used, revision, source_only);
    if (facts[receiver].kind != product_kind() || facts[receiver].reception != borrowed_ref())
        return unsupported_product_layout();
    val field <- find_record_field(source, nodes, links, facts[receiver].identity, selection.field, revision, used);
    if (field == no_node()) return unknown_product_field();
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!record_field_binding(nodes, revision, used, field, binding)) return invalid_operand_tree();
    val annotation <- binding.annotation;
    val kind <- if (names[annotation].kind == builtin_string()) { string_kind() } else { declared_scalar(names[annotation].kind) };
    set_fact(facts, at, kind, borrowed_ref(), facts[receiver].owner,
             nominal_identity(names, annotation), 0u8);
    facts[at].word_offset <- facts[field].word_offset;
    facts[at].target_readonly <- if (facts[receiver].target_readonly != 0u8 ||
        binding.readonly) { 1u8 } else { 0u8 };
    if (kind == string_kind()) {
        facts[at].writable_text_place <- if (facts[at].target_readonly == 0u8) { 1u8 } else { 0u8 };
        (facts[at].target_readonly <- 1u8):void;
    };
    return 0u8;
}

func check_text_installation(nodes:const ExprNodes in N, facts:OperandFacts in F,
                             at:UInt64, destination:UInt64, input:UInt64) -> UInt8 where {const owner N, owner F} {
    if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    if (facts[destination].owner != facts[input].owner)
        return owner_conflict(nodes, facts[destination].owner, facts[input].owner);
    set_fact(facts, at, string_kind(), borrowed_ref(), facts[destination].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    return 0u8;
}

func check_local_rebind(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
    at:UInt64, destination:UInt64, input:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, owner F} {
    if (name_syntax(nodes, used, destination) != OrdinaryName || names[destination].kind != local_binding())
        return expected_writable_place();
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false;
    };
    if (!inspect_local_binding(nodes, revision, used, names[destination].declaration, local) ||
        local.mode != ReferenceLocal || local.declaration_const ||
        facts[destination].reception != borrowed_ref() || facts[destination].reservation != no_node())
        return expected_writable_place();
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (binds_local_storage(nodes, input) || facts[input].reservation != no_node() ||
        (facts[input].reception != borrowed_ref() && facts[input].reception != local_place()) ||
        !same_operand_type(facts, destination, input)) return wrong_operand_type();
    val owner_site <- facts[destination].owner;
    if (owner_site == no_node() || owner_site != facts[input].owner)
        return owner_conflict(nodes, owner_site, facts[input].owner);
    if (facts[destination].target_readonly == 0u8 && facts[input].target_readonly != 0u8)
        return expected_writable_place();
    set_fact(facts, at, facts[destination].kind, borrowed_ref(), owner_site, facts[destination].identity, 0u8);
    facts[at].identity_module <- facts[destination].identity_module;
    (facts[at].target_readonly <- facts[destination].target_readonly):void;
    return 0u8
}

func bound_array_slot(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:const OperandFacts in F, operand:UInt64, use:UInt64,
    used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner B, const owner L, const owner F} {
    val slot <- facts[operand].array_slot;
    if (slot >= operand || names[operand].declaration != slot || facts[slot].array_slot != slot)
        return no_node();
    val activation <- enclosing_callable(nodes, names, names[use].scope);
    if (activation >= used || enclosing_callable(nodes, names, names[operand].scope) != activation)
        return no_node();
    val next <- no_node();
    if (names[operand].kind == local_binding()) {
        val declared_scope <- names[slot].scope;
        val scope <- names[use].scope;
        for (unused in 0u64 .. used) {
            if (scope >= used) return no_node();
            if (scope == declared_scope) return slot;
            if (scope == activation) return no_node();
            next <- names[scope].scope;
            if (next <= scope) return no_node();
            (scope <- next):void
        };
        return no_node()
    };
    if (names[operand].kind != formal_binding()) return no_node();
    ref formal = make UInt64 { no_node() };
    if (!callable_formals(nodes, revision, used, activation, true, formal)) return no_node();
    for (unused in 0u64 .. used) {
        if (formal > slot) return no_node();
        if (formal == slot) return slot;
        next <- links[formal].next;
        if (next <= formal) return no_node();
        (formal <- next):void
    };
    return no_node()
}

func check_array_rebind(nodes:const ExprNodes in N, facts:OperandFacts in F,
    at:UInt64, destination:UInt64, input:UInt64, target_readonly:bool)
    -> UInt8 where {const owner N, owner F} {
    if (facts[input].kind == never_result()) { set_result(facts, at, never_result()); return 0u8 };
    if (facts[input].kind != source_array_loan() || facts[input].reception != borrowed_ref() ||
        facts[input].array_element_identity != facts[destination].array_element_identity ||
        facts[input].array_element_module != facts[destination].array_element_module ||
        facts[input].target_presence != present_target() || facts[input].identity != facts[destination].identity ||
        facts[input].identity_module != facts[destination].identity_module) return wrong_operand_type();
    if (facts[input].owner != facts[destination].owner)
        return owner_conflict(nodes, facts[input].owner, facts[destination].owner);
    if (facts[input].target_readonly != 0u8 && !target_readonly) return expected_writable_place();
    # The checked slot invariant survives a rebind. This result describes
    # the selected array, with no reusable slot or exact-target refinement.
    copy_fact(facts, at, destination);
    return 0u8
}

func check_transfer_destination(
    nodes:const ExprNodes in N, facts:OperandFacts in F, destination:UInt64)
    -> UInt8 where {const owner N, owner F} {
    val reception <- facts[destination].reception;
    val kind <- facts[destination].kind;
    if (!scalar_kind(kind)) return unproved_operand();
    if (facts[destination].target_readonly != 0u8 ||
        (reception != local_place() && reception != borrowed_ref() && reception != nullable_ptr()))
        return expected_writable_place();
    return require_typed_bits(nodes, facts, destination, kind)
}

func remember_transfer(facts:OperandFacts in F, at:UInt64, destination:UInt64) -> void where {owner F} {
    set_fact(facts, at, facts[destination].kind, borrowed_ref(),
             facts[destination].owner, facts[destination].identity, 0u8);
    facts[at].identity_module <- facts[destination].identity_module;
    facts[at].target_readonly <- 1u8;
    facts[at].reservation <- facts[destination].reservation;
    return
}

func check_transfer(nodes:const ExprNodes in N, facts:OperandFacts in F,
                    at:UInt64, destination:UInt64, supplied:UInt64, source_only:bool)
    -> UInt8 where {const owner N, owner F} {
    val diagnostic <- check_transfer_destination(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[supplied].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val input <- facts[supplied].kind;
    val widen <- facts[destination].kind == scalar_u64() &&
        (input == scalar_u8() || (source_only && input == source_u32()));
    diagnostic <- if (widen) { require_widening_u64(nodes, facts, supplied) }
        else { require_matching_value_bits(nodes, facts, supplied, destination) };
    if (diagnostic != 0u8) return diagnostic;
    remember_transfer(facts, at, destination);
    return 0u8;
}

func check_augmented_transfer(nodes:const ExprNodes in N, facts:OperandFacts in F,
                              at:UInt64, destination:UInt64, input:UInt64, used:UInt64, revision:UInt64)
    -> UInt8 where {const owner N, owner F} {
    val selected <- ungrouped(nodes, revision, used, destination);
    if (name_syntax(nodes, used, selected) != OrdinaryName) return unsupported_transfer_signature();
    val diagnostic <- check_transfer_destination(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_bits(nodes, facts, destination);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    diagnostic <- require_bits(nodes, facts, input);
    if (diagnostic != 0u8) return diagnostic;
    remember_transfer(facts, at, destination);
    return 0u8
}

func ordinary_argument_value(nodes:const ExprNodes in N, used:UInt64, revision:UInt64, argument:UInt64) -> UInt64
    where {const owner N} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence) return no_node();
    ref named = make NamedArgumentSites { operand <- no_node(); label <- no_node() };
    return if (inspect_named_argument(nodes, revision, argument, entry.item, named)) { (named.operand) } else { (entry.item) };
}

func callable_formals(nodes:const ExprNodes in N, revision:UInt64, used:UInt64,
                      definition:UInt64, source_only:bool, first:UInt64 in R) -> bool where {const owner N, owner R} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref head = make UInt64 { no_node() };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    return (form == ModuleCallable || (source_only && form == LexicalCallable)) &&
        find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, head) &&
        inspect_signature(nodes, revision, used, head, signature) == SignatureHead &&
        first_sequence_entry(nodes, revision, used, signature.parameter_tail, FormalSequence, first);
}

func check_argument_operand(nodes:const ExprNodes in N, facts:OperandFacts in F, argument:UInt64,
                            kind:UInt8, wanted:UInt8, identity:UInt64, module:UInt64, readonly:UInt8, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, owner F} {
    val actual <- ordinary_argument_value(nodes, used, revision, argument);
    if (actual == no_node()) return invalid_operand_tree();
    if (checked_ref_argument(nodes, argument) && wanted != borrowed_ref())
        return checked_selection_requires_ref();
    if (wanted == local_place()) {
        if (!compatible_operand_nominal(facts, actual, kind, identity, module)) return wrong_operand_type();
        val bits_problem <- if (kind == source_u32() && !supplies_enum_backing(facts, actual, kind)) {
            require_source_u32(nodes, facts, actual, true)
        } else { require_value_bits(nodes, facts, actual, kind) };
        if (bits_problem != 0u8) return bits_problem;
        set_fact(facts, argument, kind, independent_value(), no_node(), identity, 0u8);
        facts[argument].identity_module <- module;
        return 0u8;
    } else {};
    if (kind == source_builder_loan() && facts[actual].reception != borrowed_ref())
        return unproved_nonnull_borrow();
    if (binds_local_storage(nodes, actual) ||
        facts[actual].kind == 0u8 || facts[actual].kind == null_literal()) return unproved_operand();
    if (immutable_text_kind(kind)) {
        if (!immutable_text_kind(facts[actual].kind)) return string_operand_required();
        if (kind == c_string_kind() && facts[actual].kind != c_string_kind() &&
            !(text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, actual)) == NulFreeLiteral && facts[actual].text_nul == nul_absent()))
            return c_string_operand_required();
    } else {
        if (facts[actual].kind != kind || !compatible_operand_nominal(facts, actual, kind, identity, module))
            return wrong_operand_type();
    };
    if (facts[actual].reception == independent_value()) return unproved_owner();
    if (facts[actual].target_readonly != 0u8 && readonly == 0u8) return expected_writable_place();
    set_fact(facts, argument, kind, wanted, facts[actual].owner, identity, 0u8);
    facts[argument].identity_module <- module;
    return 0u8;
}

func receipt_loan_signature(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:const OperandFacts in F, definition:UInt64, first:UInt64, used:UInt64, revision:UInt64,
    allow_writable_array:bool, scoped_procedure:bool, mixed_aggregate_loan:bool) -> bool
    where {const owner N, const owner L, const owner F} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        (!callable.function_form && !scoped_procedure && !mixed_aggregate_loan) || callable.body == no_node()) return false;
    val procedure_call <- !callable.function_form;
    val result <- facts[definition].kind;
    # The direct-call checker already requires a statement use for a pending
    # result. Preparing loans of existing places needs only the bound formals.
    if (result != void_result() && !scalar_kind(result) && result != source_u32() &&
        !(result == 0u8 && facts[definition].omitted_result)) return false;
    if (facts[definition].reception == borrowed_ref()) return false;
    val parameter <- first;
    val kind <- 0u8;
    val reception <- 0u8;
    val product <- no_node();
    val scalar_input <- false;
    val scoped_reference <- false;
    ref syntax = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return true;
        if (parameter >= used) return false;
        kind <- facts[parameter].kind;
        reception <- facts[parameter].reception;
        scalar_input <- scalar_kind(kind) || kind == source_u32();
        scoped_reference <- scoped_procedure && (kind == source_builder_loan() || (scalar_input && reception == borrowed_ref()));
        if ((procedure_call && kind == source_handle_loan()) || scoped_reference) {
            if (reception != borrowed_ref() || !owner_parameter(nodes, facts[parameter].owner))
                return false;
            if (scoped_reference && (inspect_formal(nodes, revision, used, parameter, syntax) != OrdinaryFormal ||
                syntax.mode != ReferenceFormal)) return false
        } else {
            if (kind == product_kind()) {
                product <- facts[parameter].identity;
                if (reception != borrowed_ref() || facts[parameter].identity_module != 0u64 ||
                    product >= used || !facts[product].bits_product) return false;
                if (procedure_call) {
                    if (facts[parameter].target_readonly != 0u8) {
                        if (owner_constraint_syntax(nodes, facts[parameter].owner) != ReadonlyOwnerConstraint)
                            return false
                    } else {
                        if (!mixed_aggregate_loan || owner_constraint_syntax(nodes, facts[parameter].owner) != WritableOwnerConstraint)
                            return false
                    }
                }
            } else {
                if (scalar_input) {
                    if (reception != local_place() && (procedure_call || reception != borrowed_ref())) return false
                } else {
                    if ((kind != source_array_loan() && kind != source_sum_target() &&
                         kind != source_product_loan() && kind != string_kind()) || reception != borrowed_ref())
                        return false;
                    if (procedure_call && kind != source_array_loan() && kind != source_product_loan() &&
                        !((kind == string_kind() || (mixed_aggregate_loan && kind == source_sum_target())) &&
                          facts[parameter].target_readonly != 0u8)) return false;
                    if (facts[parameter].target_readonly == 0u8) {
                        if (procedure_call && !mixed_aggregate_loan &&
                            !(scoped_procedure && allow_writable_array && kind == source_array_loan())) return false;
                        if (kind == source_array_loan()) {
                            # A writable target can be borrowed without authority to allocate in its owner.
                            if ((!allow_writable_array && !mixed_aggregate_loan) ||
                                inspect_formal(nodes, revision, used, parameter, syntax) != OrdinaryFormal ||
                                syntax.mode != ReferenceFormal ||
                                !owner_parameter(nodes, facts[parameter].owner)) return false
                        } else {
                            if (kind != source_product_loan() ||
                                owner_constraint_syntax(nodes, facts[parameter].owner) != WritableOwnerConstraint)
                                return false
                        }
                    } else {
                        if (owner_constraint_syntax(nodes, facts[parameter].owner) != ReadonlyOwnerConstraint)
                            return false
                    }
                }
            }
        };
        (parameter <- links[parameter].next):void
    };
    return false
}

func check_receipt_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F, owners:CallOwners in O, argument:UInt64, actual:UInt64, formal:UInt64,
    invocation:UInt64) -> UInt8 where {const owner N, const owner B, owner F, owner O} {
    val receipt <- facts[actual].case_receipt;
    val kind <- facts[formal].kind;
    if (receipt >= actual || names[actual].kind != local_binding() ||
        names[actual].declaration != receipt || !receipt_in_context(facts, actual, receipt) ||
        facts[actual].reception != local_place() || facts[formal].reception != borrowed_ref() ||
        facts[formal].target_readonly == 0u8 ||
        owner_constraint_syntax(nodes, facts[formal].owner) != ReadonlyOwnerConstraint ||
        (kind != product_kind() && kind != source_sum_target() && kind != source_product_loan()) ||
        ((kind != source_sum_target()) != (facts[actual].kind == received_product())) ||
        facts[actual].identity != facts[formal].identity ||
        facts[actual].identity_module != facts[formal].identity_module)
        return wrong_operand_type();
    set_fact(facts, argument, kind, borrowed_ref(), facts[actual].owner, facts[actual].identity, 0u8);
    facts[argument].identity_module <- facts[actual].identity_module;
    facts[argument].case_receipt <- receipt;
    facts[argument].target_readonly <- 1u8;
    facts[argument].loans_scoped_aggregate <- true;
    return record_owner_argument(nodes, facts, owners, formal, facts[actual].owner, argument, invocation)
}

func check_fresh_sum_argument(nodes:const ExprNodes in N, facts:OperandFacts in F, owners:CallOwners in O,
    argument:UInt64, operand:UInt64, formal:UInt64, invocation:UInt64, lexical_owner:UInt64,
    independent_result:bool) -> UInt8 where {const owner N, owner F, owner O} {
    if (!independent_result || facts[formal].kind != source_sum_target() ||
        facts[formal].reception != borrowed_ref() || facts[formal].target_readonly == 0u8 ||
        owner_constraint_syntax(nodes, facts[formal].owner) != ReadonlyOwnerConstraint)
        return unproved_owner();
    if (facts[operand].kind != independent_sum_bits() || facts[operand].reception != independent_value() ||
        facts[operand].identity != facts[formal].identity ||
        facts[operand].identity_module != facts[formal].identity_module)
        return wrong_operand_type();
    set_fact(facts, argument, source_sum_target(), borrowed_ref(), lexical_owner, facts[operand].identity, 0u8);
    facts[argument].identity_module <- facts[operand].identity_module;
    facts[argument].selection <- operand;
    facts[argument].target_readonly <- 1u8;
    facts[argument].loans_scoped_aggregate <- true;
    return record_owner_argument(nodes, facts, owners, formal, lexical_owner, argument, invocation)
}

func prepare_acquired_handle_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in L, facts:OperandFacts in F,
    input:UInt64, argument:UInt64, invocation:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner L, owner F} {
    ref handle = make HandleContract { marker <- no_node(); owner_site <- no_node(); readonly <- false };
    if (!inspect_acquired_handle_loan(nodes, names, selected, links, input, invocation,
        used, revision, handle)) return false;
    set_fact(facts, argument, source_handle_loan(), borrowed_ref(), handle.owner_site,
        type_identity(names, selected, handle.marker), 0u8);
    facts[argument].identity_module <- type_module(names, selected, handle.marker, 0u64);
    facts[argument].target_readonly <- if (handle.readonly) { 1u8 } else { 0u8 };
    facts[argument].loans_owning_handle <- true;
    return true
}

# Read a completed chain of inline field selections for a synchronous
# writable loan. The receiving formal supplies the write demand, while
# each field and the prepared base retain their own access.
func writable_inline_product_actual(facts:const OperandFacts in F, cases:const ConstructorCaseFacts in C,
    value:UInt64) -> bool where {const owner F, const owner C} {
    if (value >= intrinsic (len)(cases) || value >= intrinsic (len)(facts)) return false;
    val site <- value;
    for (unused in 0u64 .. value + 1u64) {
        case cases[site] of {
            InlineProductField { val receiver <-, val readonly <-, } -> {
                if (readonly || receiver >= site || facts[site].selection != site) return false;
                (site <- receiver):void
            };
            _ -> {
                return site != value && facts[site].target_readonly == 0u8 &&
                    facts[site].reception == borrowed_ref() && facts[site].target_presence == present_target()
            }
        }
    };
    return false
}

func check_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in L,
    facts:OperandFacts in F, owners:CallOwners in O, cases:const ConstructorCaseFacts in C, argument:UInt64, formal:UInt64,
    invocation:UInt64, used:UInt64, revision:UInt64, independent_loan_result:bool,
    definition:UInt64, first:UInt64, source_only:bool, scoped_aggregate_call:bool, slot_call:bool, mixed_aggregate_loan:bool) -> UInt8
    where {const owner N, const owner B, const owner E, const owner L, owner F, owner O, const owner C} {
    if (facts[formal].writable_text_place != 0u8) return unsupported_text_operation();
    val kind <- facts[formal].kind;
    val operand <- ordinary_argument_value(nodes, used, revision, argument);
    if (source_only && argument < intrinsic (len)(cases)) {
        case cases[argument] of {
            FreshSumArgument {
                val consumer <- invocation, val parameter <- formal, val input <- construction, val lexical_owner <-,
            } -> {
                if (consumer != invocation || parameter != formal || operand != input || input >= argument ||
                    lexical_owner != names[invocation].scope) return invalid_operand_tree();
                return check_fresh_sum_argument(nodes, facts, owners, argument, operand, formal, invocation,
                    lexical_owner, independent_loan_result)
            };
            _ -> {}
        }
    };
    if (operand < used &&
        (facts[operand].kind == received_sum() || facts[operand].kind == received_product())) {
        if (!source_only || checked_ref_argument(nodes, argument) ||
            !receipt_loan_signature(nodes, links, facts, definition, first, used, revision,
                false, false, mixed_aggregate_loan))
            return unproved_owner();
        return check_receipt_argument(nodes, names, facts, owners, argument, operand, formal, invocation)
    };
    if (source_only && (slot_call || mixed_aggregate_loan) && formal < intrinsic (len)(cases) &&
        (case cases[formal] of { ArrayFieldRecordFormal -> true; _ -> false })) {
        if (operand >= used || checked_ref_argument(nodes, argument) ||
            facts[operand].kind != source_product_loan() || facts[operand].reception != borrowed_ref() ||
            facts[operand].target_presence != present_target() || facts[operand].identity != facts[formal].identity ||
            facts[operand].identity_module != facts[formal].identity_module) return wrong_operand_type();
        if (facts[operand].target_readonly != 0u8 && facts[formal].target_readonly == 0u8)
            return expected_writable_place();
        copy_fact(facts, argument, operand);
        facts[argument].target_readonly <- facts[formal].target_readonly;
        return record_owner_argument(nodes, facts, owners, formal, facts[operand].owner, argument, invocation)
    };
    if (operand < used && (facts[operand].kind == source_product_loan() ||
        (mixed_aggregate_loan && kind == source_product_loan() && facts[operand].kind == product_kind()))) {
        val forwarded <- names[operand].kind == formal_binding() && facts[operand].identity_module != 0u64;
        val indexed <- operand < intrinsic (len)(cases) && facts[operand].selection == operand &&
            (case cases[operand] of {
                IndexedAggregateLoan { val consumer <-, val writable <-, } -> consumer == argument && !writable;
                _ -> false
            });
        # Each writable array formal is still an ordinary target loan, checked
        # against its own actual when that argument is prepared.
        val allow_writable_array <- scoped_aggregate_call && (forwarded || indexed);
        if (!source_only || checked_ref_argument(nodes, argument) ||
            !receipt_loan_signature(nodes, links, facts, definition, first, used, revision,
                allow_writable_array, scoped_aggregate_call, mixed_aggregate_loan))
            return unproved_owner();
        if ((kind != source_product_loan() && kind != product_kind()) ||
            facts[formal].reception != borrowed_ref() ||
            facts[operand].identity != facts[formal].identity ||
            facts[operand].identity_module != facts[formal].identity_module ||
            facts[operand].reception != borrowed_ref() || facts[operand].owner == no_node() ||
            facts[operand].target_presence != present_target()) return wrong_operand_type();
        if (facts[formal].target_readonly == 0u8) {
            val local <- names[operand].declaration;
            val lexical <- names[operand].kind == local_binding() && local < operand &&
                ((mixed_aggregate_loan && completed_lexical_bits_target(facts, operand, names[invocation].scope)) ||
                 (local < intrinsic (len)(cases) && (case cases[local] of {
                    LexicalProductReference { val owner_site <-, val readonly <-, } ->
                        !readonly && owner_site == facts[operand].owner;
                    _ -> false
                 })));
            val inline_output <- mixed_aggregate_loan && writable_inline_product_actual(facts, cases, operand);
            val projected_output <- inline_output || (operand < intrinsic (len)(cases) && facts[operand].selection == operand &&
                (case cases[operand] of {
                    IndexedAggregateLoan { val consumer <-, val writable <-, } ->
                        consumer == argument && writable;
                    _ -> false
                }));
            # The signature has checked either the inline schema or the
            # exact flat bits layout. Both describe the same borrowed place.
            if ((facts[operand].target_readonly != 0u8 && !inline_output) ||
                (names[operand].kind != formal_binding() && !lexical && !projected_output) ||
                owner_constraint_syntax(nodes, facts[formal].owner) != WritableOwnerConstraint)
                return expected_writable_place()
        } else {
            if (owner_constraint_syntax(nodes, facts[formal].owner) != ReadonlyOwnerConstraint)
                return unproved_owner()
        };
        val receipt <- facts[operand].case_receipt;
        if (receipt != no_node() && (facts[operand].selection != operand ||
            !receipt_in_context(facts, invocation, receipt) || facts[operand].owner != facts[receipt].owner))
            return unproved_owner();
        copy_fact(facts, argument, operand);
        facts[argument].target_readonly <- facts[formal].target_readonly;
        facts[argument].loans_scoped_aggregate <- true;
        return record_owner_argument(nodes, facts, owners, formal, facts[operand].owner, argument, invocation)
    };
    if (kind == source_array_loan() || kind == source_handle_loan() || kind == source_sum_target()) {
        val actual <- ordinary_argument_value(nodes, used, revision, argument);
        if (actual >= used || checked_ref_argument(nodes, argument)) return wrong_operand_type();
        if (independent_loan_result && kind == source_handle_loan() && facts[actual].kind == 0u8) {
            if (!prepare_acquired_handle_argument(nodes, names, selected, links, facts, actual,
                argument, invocation, used, revision)) return unproved_owner();
            (actual <- argument):void
        };
        if (facts[actual].kind != kind || facts[actual].identity != facts[formal].identity ||
            facts[actual].identity_module != facts[formal].identity_module)
                return wrong_operand_type();
        if (facts[actual].reception != borrowed_ref() ||
            ((mixed_aggregate_loan || scoped_aggregate_call) &&
                (facts[actual].target_presence != present_target() || facts[actual].reservation != no_node())))
            return unproved_owner();
        if (facts[actual].target_readonly != 0u8 && facts[formal].target_readonly == 0u8)
            return expected_writable_place();
        val inline_sum <- source_only && kind == source_sum_target() && actual < intrinsic (len)(cases) &&
            (case cases[actual] of {
                InlineProductField { val type <- value_type, } -> type.kind == sum_type();
                _ -> false
            });
        if (inline_sum && (!scoped_aggregate_call || !independent_loan_result || facts[actual].selection != actual))
            return unproved_owner();
        val receives_slot <- false;
        if (kind == source_array_loan() && facts[formal].array_slot != no_node()) {
            ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
            if (inspect_formal(nodes, revision, used, formal, parameter) != OrdinaryFormal) return invalid_operand_tree();
            (receives_slot <- parameter.mode == ReferenceSlotFormal):void
        };
        if (receives_slot) {
            val slot <- bound_array_slot(nodes, names, links, facts, actual, invocation, used, revision);
            if (slot == no_node() ||
                facts[actual].array_element_identity != facts[formal].array_element_identity ||
                facts[actual].array_element_module != facts[formal].array_element_module ||
                facts[actual].target_presence != present_target())
                return expected_writable_place();
            # The receipt names the slot. Earlier ordinary array arguments
            # stay prepared as target loans even if this slot changes.
            copy_fact(facts, argument, actual);
            (facts[argument].array_slot <- slot):void
        } else {
            if (actual != argument) { copy_fact(facts, argument, actual) }
        };
        if (inline_sum) { (facts[argument].loans_scoped_aggregate <- true):void };
        return record_owner_argument(nodes, facts, owners, formal, facts[actual].owner, argument,
            invocation)
    };
    val wanted <- facts[formal].reception;
    if (scoped_aggregate_call && wanted == borrowed_ref() && operand < used &&
        (kind == source_builder_loan() || scalar_kind(kind) || kind == source_u32()) &&
        (facts[operand].target_presence != present_target() || facts[operand].reservation != no_node()))
        return unproved_nonnull_borrow();
    val diagnostic <- check_argument_operand(nodes, facts, argument, kind, wanted,
                                             facts[formal].identity, facts[formal].identity_module,
                                             facts[formal].target_readonly, used, revision);
    if (diagnostic != 0u8 || wanted == local_place()) return diagnostic;
    return record_owner_argument(nodes, facts, owners, formal, facts[argument].owner, argument, invocation);
}

# The source slice makes a readonly snapshot in the current full lexical
# scope. Its UTF-8 range and allocation checks run after all three operands.
func check_text_slice(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, at:UInt64, first:UInt64, used:UInt64, revision:UInt64)
    -> UInt8 where {const owner N, const owner B, const owner L, owner F} {
    val lower <- links[first].next;
    if (lower >= at) return wrong_argument_count();
    val upper <- links[lower].next;
    if (upper >= at || links[upper].next != no_node()) return wrong_argument_count();
    val argument <- first;
    val input <- no_node();
    val diagnostic <- 0u8;
    for (position in 0u64 .. 3u64) {
        input <- ordinary_argument_value(nodes, used, revision, argument);
        if (input >= argument) return invalid_operand_tree();
        if (checked_ref_argument(nodes, argument)) return unsupported_text_operation();
        if (facts[input].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        if (position == 0u64) {
            if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
            if (facts[input].reception != borrowed_ref() || facts[input].target_presence != present_target())
                return unproved_nonnull_borrow();
            diagnostic <- check_owner_access(nodes, facts[input].owner, false);
            if (diagnostic != 0u8) return diagnostic;
            copy_fact(facts, argument, input);
        } else {
            diagnostic <- require_value_bits(nodes, facts, input, scalar_u64());
            if (diagnostic != 0u8) return diagnostic;
            scalar_fact(facts, argument, independent_value(), no_node());
        };
        (argument <- links[argument].next):void
    };
    val owner_site <- names[at].scope;
    diagnostic <- check_owner_access(nodes, owner_site, true);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, string_kind(), borrowed_ref(), owner_site, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_intrinsic <- text_slice_export();
    return 0u8
}

func check_builder_output(nodes:const ExprNodes in N, facts:const OperandFacts in F, site:UInt64)
    -> UInt8 where {const owner N, const owner F} {
    if (facts[site].kind != source_builder_loan()) return wrong_operand_type();
    if (facts[site].reception != borrowed_ref() || facts[site].target_presence != present_target())
        return unproved_nonnull_borrow();
    if (facts[site].target_readonly != 0u8) return expected_writable_place();
    return check_owner_access(nodes, facts[site].owner, true)
}

func check_text_intrinsic(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          at:UInt64, arguments:UInt64, intrinsic_kind:UInt8, used:UInt64, revision:UInt64, source_only:bool) -> UInt8
    where {const owner N, const owner B, const owner L, owner F} {
    val append <- source_only && intrinsic_kind == builder_append_export();
    val slice <- source_only && intrinsic_kind == text_slice_export();
    if (!append && !slice && intrinsic_kind != text_size_export() && intrinsic_kind != text_byte_export())
        return unproved_call_target();
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, first)) return invalid_operand_tree();
    if (first == no_node()) return wrong_argument_count();
    if (slice) return check_text_slice(nodes, names, links, facts, at, first, used, revision);
    val next <- links[first].next;
    val byte <- intrinsic_kind == text_byte_export();
    val pair <- byte || append;
    if ((!pair && next != no_node()) || (pair && (next == no_node() || links[next].next != no_node())))
        return wrong_argument_count();
    val text <- ordinary_argument_value(nodes, used, revision, first);
    if (text == no_node()) return invalid_operand_tree();
    if (append) {
        val piece <- ordinary_argument_value(nodes, used, revision, next);
        if (piece == no_node()) return invalid_operand_tree();
        if (facts[text].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        val access <- check_builder_output(nodes, facts, text);
        if (access != 0u8) return access;
        if (facts[piece].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        if (!immutable_text_kind(facts[piece].kind) && facts[piece].kind != source_builder_loan())
            return string_operand_required();
        if (facts[piece].reception != borrowed_ref() || facts[piece].owner == no_node())
            return unproved_nonnull_borrow();
        copy_fact(facts, first, text);
        copy_fact(facts, next, piece);
        only_void(facts, at);
        (facts[at].text_intrinsic <- intrinsic_kind):void;
        return 0u8
    };
    if (!immutable_text_kind(facts[text].kind)) return string_operand_required();
    copy_fact(facts, first, text);
    if (byte) {
        val index <- ordinary_argument_value(nodes, used, revision, next);
        if (index == no_node()) return invalid_operand_tree();
        val diagnostic <- require_bits(nodes, facts, index);
        if (diagnostic != 0u8) return diagnostic;
        scalar_fact(facts, next, independent_value(), no_node());
    };
    if (byte) { set_result(facts, at, scalar_u8()); } else { set_result(facts, at, scalar_u64()); };
    (facts[at].text_intrinsic <- intrinsic_kind):void;
    return 0u8;
}

func remember_native_result(facts:OperandFacts in F, at:UInt64, native_kind:UInt8, module:UInt64,
    identity:UInt64) -> UInt8
    where {owner F} {
    val kind <- declared_scalar(native_kind);
    if (kind == 0u8) return unproved_result_contract();
    set_fact(facts, at, kind, independent_value(), no_node(), identity, 0u8);
    facts[at].identity_module <- module;
    return 0u8
}

func check_prepared_here_call(nodes:const ExprNodes in N, links:const NameWork in L,
                              facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner L, owner F} {
    ref supplied = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, links[at].active, supplied) != HereReady ||
        supplied.call != at) return unproved_call_target();
    return remember_native_result(facts, at, links[at].value_kind, links[at].value_module,
                                  links[at].value_identity)
}

func check_prepared_native_text(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    input:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner F} {
    val literal <- text_literal_syntax(nodes, used, ungrouped(nodes, revision, used, input));
    if (literal == InteriorNulLiteral) return interior_literal_nul();
    if (facts[input].kind != c_string_kind() && literal != NulFreeLiteral)
        return c_string_operand_required();
    if (facts[input].reception != borrowed_ref() || facts[input].owner == no_node() ||
        facts[input].target_readonly == 0u8) return unproved_owner();
    return 0u8
}

func check_prepared_native_view(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const OperandFacts in F, views:const SuppliedViews in H, call:UInt64,
    input:UInt64, module:UInt64, identity:UInt64, readonly:bool, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner F, const owner H} {
    val value <- ungrouped(nodes, revision, used, input);
    if (value >= used || facts[value].kind != source_array_loan() ||
        facts[value].identity_module != module || facts[value].identity != identity)
        return wrong_operand_type();
    if (facts[value].reception != borrowed_ref() || facts[value].owner >= used ||
        facts[value].target_presence != present_target())
        return unproved_owner();
    if (!readonly && facts[value].target_readonly != 0u8) return expected_writable_place();
    if (names[value].kind == formal_binding()) return 0u8;
    val binding <- names[value].declaration;
    if (names[value].kind == local_binding() && binding < value && readonly &&
        enclosing_callable(nodes, names, names[binding].scope) == enclosing_callable(nodes, names, names[call].scope)) {
        ref local = make LocalBindingSites {
            binding <- no_node(); initializer <- no_node(); mode <- ReferenceLocal; declaration_const <- false
        };
        if (inspect_local_binding(nodes, revision, used, binding, local) && local.mode == ReferenceLocal &&
            local.initializer < binding && allocated_source_array(facts, local.initializer) &&
            facts[local.initializer].owner == facts[value].owner) return 0u8
    };
    if (names[value].kind != here_receiver_binding() || binding >= used) return unproved_owner();
    return case views[binding] of {
        SuppliedArrayView { val body <- body, } -> {
            if (body < used && syntax_first(nodes, used, body) <= syntax_first(nodes, used, call) &&
                syntax_past(nodes, used, call) <= syntax_past(nodes, used, body) &&
                enclosing_callable(nodes, names, names[body].scope) ==
                    enclosing_callable(nodes, names, names[call].scope)) { 0u8 }
            else { unproved_owner() }
        };
        _ -> unproved_owner()
    }
}

func first_native_role(links:const NameWork in L, views:const SuppliedViews in H,
    first:UInt64, argument:UInt64, position:UInt64, role:UInt64) -> UInt64
    where {const owner L, const owner H} {
    val previous <- first;
    for (unused in 0u64 .. position) {
        if (previous >= argument) return no_node();
        if (case views[previous] of {
            PreparedNativeOperand { val earlier <- owner_role, } -> earlier == role;
            _ -> false
        }) return previous;
        previous <- links[previous].next
    };
    return argument
}

func prepare_native_scalar_operand(nodes:const ExprNodes in N, facts:OperandFacts in F,
    argument:UInt64, input:UInt64, kind:UInt8, module:UInt64, identity:UInt64) -> UInt8
    where {const owner N, owner F} {
    val expected <- source_scalar_kind(kind);
    if (expected == 0u8) return wrong_operand_type();
    if (!compatible_operand_nominal(facts, input, expected, identity, module)) return wrong_operand_type();
    val diagnostic <- if (expected == source_u32()) { require_source_u32(nodes, facts, input, true) }
        else {
            if (expected == scalar_u64() && facts[input].kind != scalar_enum()) {
                require_widening_u64(nodes, facts, input)
            } else { require_value_bits(nodes, facts, input, expected) }
        };
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, argument, expected, independent_value(), no_node(), identity, 0u8);
    facts[argument].identity_module <- module;
    return 0u8
}

func check_prepared_native_operand(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    at:UInt64, argument:UInt64, first:UInt64, position:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    val input <- ordinary_argument_value(nodes, used, revision, argument);
    if (input >= argument) return invalid_operand_tree();
    val owner_site <- no_node();
    val view <- no_node();
    val diagnostic <- 0u8;
    return case views[argument] of {
        PreparedNativeOperand {
            val expected_call <- call_site, val origin <- revision, val ordinal <- position,
            val expected_input <- input, val kind <- kind, val role <- owner_role,
            val owner <- owner_site, val module <- type_module, val identity <- type_identity,
            val readonly <- target_readonly, val const_owner <- owner_readonly,
        } -> {
            if (expected_call != at || origin != revision || ordinal != position ||
                expected_input != input) return unproved_call_target();
            if (facts[input].kind == never_result()) {
                set_result(facts, argument, never_result());
                return 0u8
            };
            if (role == no_node())
                return prepare_native_scalar_operand(nodes, facts, argument, input, kind, module, identity);
            if (kind == c_handle_type()) {
                if (owner >= used) return unproved_owner();
                set_fact(facts, argument, source_handle_loan(), borrowed_ref(), owner, identity, 0u8);
                facts[argument].identity_module <- module;
                (facts[argument].target_readonly <- if (readonly) { 1u8 } else { 0u8 }):void
            } else {
                if (kind == array_type()) {
                    diagnostic <- check_prepared_native_view(nodes, names, facts, views, at,
                        input, module, identity, readonly, used, revision);
                    if (diagnostic != 0u8) return diagnostic;
                    view <- ungrouped(nodes, revision, used, input);
                    copy_fact(facts, argument, view)
                } else {
                    if (kind != builtin_c_string()) return wrong_operand_type();
                    diagnostic <- check_prepared_native_text(nodes, facts, input, used, revision);
                    if (diagnostic != 0u8) return diagnostic;
                    copy_fact(facts, argument, input)
                }
            };
            owner_site <- facts[argument].owner;
            diagnostic <- check_owner_access(nodes, owner_site, !const_owner);
            if (diagnostic != 0u8) return diagnostic;
            view <- first_native_role(links, views, first, argument, position, role);
            if (view == no_node()) return invalid_operand_tree();
            if (facts[view].owner != owner_site) return owner_conflict(nodes, facts[view].owner, owner_site);
            0u8
        };
        _ -> unsupported_imported_call()
    }
}

func check_prepared_native_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    at:UInt64, arguments:UInt64, arity:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    ref first = make UInt64 { no_node() };
    if (arity > at || !first_sequence_entry(nodes, revision, at, arguments, ArgumentSequence,
        first)) return invalid_operand_tree();
    val argument <- first;
    val diagnostic <- 0u8;
    val borrows_array <- false;
    for (position in 0u64 .. arity) {
        if (argument >= at) return invalid_operand_tree();
        diagnostic <- check_prepared_native_operand(nodes, names, links, facts, views, at,
            argument, first, position, used, revision);
        if (diagnostic != 0u8) return diagnostic;
        if (facts[argument].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        borrows_array <- borrows_array || facts[argument].kind == source_array_loan();
        argument <- links[argument].next
    };
    if (argument != no_node()) return invalid_operand_tree();
    diagnostic <- remember_native_result(facts, at, links[at].value_kind,
        links[at].value_module, links[at].value_identity);
    facts[at].loans_scoped_aggregate <- borrows_array;
    return diagnostic
}

func check_prepared_native_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, views:const SuppliedViews in H,
    selected_module:UInt64, selected_definition:UInt64, at:UInt64, arguments:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    return case views[at] of {
        PreparedNativeLoanCall {
            val module <- module, val definition <- definition,
            val origin <- revision, val activation <- activation, val arity <- arity,
        } -> {
            if (module != selected_module || definition != selected_definition || origin != revision ||
                activation != enclosing_callable(nodes, names, names[at].scope))
                return unproved_call_target();
            check_prepared_native_arguments(nodes, names, links, facts, views, at, arguments,
                                            arity, used, revision)
        };
        _ -> { return unsupported_imported_call(); }
    }
}

# The family signature check uses the already completed parameter rows.
# An unsupported method leaves the entire family outside this profile.
func fixed_value_clauses(nodes:const ExprNodes in N, signature:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val item <- signature;
    val form <- SignatureHead;
    for (unused in 0u64 .. used) {
        if (item == no_node()) return true;
        form <- inspect_signature(nodes, revision, used, item, clause);
        if (form != SignatureHead && form != ValueResultClause && form != ThrowsSignatureClause) return false;
        (item <- clause.previous):void
    };
    return false
}

func supported_value_method(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                            definition:UInt64, first:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    if (facts[definition].kind != void_result() &&
        (!scalar_kind(facts[definition].kind) || facts[definition].reception != independent_value())) return false;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        callable.body == no_node()) return false;
    if (!fixed_value_clauses(nodes, callable.signature, used, revision)) return false;
    val formal <- first;
    ref sites = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return true;
        if (inspect_formal(nodes, revision, used, formal, sites) != OrdinaryFormal ||
            (sites.mode != ValueFormal && sites.mode != ExplicitValueFormal) ||
            !scalar_kind(facts[formal].kind) || facts[formal].reception != local_place())
            return false;
        (formal <- links[formal].next):void
    };
    return false
}

func same_value_signature(links:const NameWork in L, facts:const OperandFacts in F,
                          left:UInt64, right:UInt64, used:UInt64) -> bool
    where {const owner L, const owner F} {
    val a <- left;
    val b <- right;
    for (unused in 0u64 .. used) {
        if (a == no_node() || b == no_node()) return a == b;
        if (!same_operand_type(facts, a, b)) return false;
        a <- links[a].next;
        (b <- links[b].next):void
    };
    return false
}

func prior_value_signature(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                           family:UInt64, current:UInt64, formals:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner L, const owner F} {
    val earlier <- family;
    ref parameters = make UInt64 { no_node() };
    for (unused in 0u64 .. used) {
        if (earlier == current) return 0u8;
        if (earlier == no_node() || !callable_formals(nodes, revision, used, earlier, false, parameters))
            return invalid_operand_tree();
        if (same_value_signature(links, facts, formals, parameters, used)) return duplicate_value_signature();
        (earlier <- links[earlier].next_method):void
    };
    return invalid_operand_tree()
}

func check_value_family(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        family:UInt64, used:UInt64, revision:UInt64, text_writer:bool, report:OperandCheckResult in R) -> bool
    where {const owner N, const owner L, const owner F, owner R} {
    val function_form <- is_function(nodes, family);
    val method <- family;
    ref formals = make UInt64 { no_node() };
    val issue <- 0u8;
    for (unused in 0u64 .. used) {
        if (method == no_node()) return true;
        if (is_function(nodes, method) != function_form ||
            !callable_formals(nodes, revision, used, method, false, formals) ||
            (!text_writer && !supported_value_method(nodes, links, facts, method, formals, used, revision)))
            return operand_problem(report, method, unsupported_value_family());
        issue <- prior_value_signature(nodes, links, facts, family, method, formals, used, revision);
        if (issue != 0u8) return operand_problem(report, method, issue);
        (method <- links[method].next_method):void
    };
    return operand_problem(report, family, invalid_operand_tree())
}

enum ValueApplicability:UInt8 { InapplicableValue, ApplicableValue, UnrepresentedValue, }

func value_applicability(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                         first:UInt64, arguments:UInt64, used:UInt64, revision:UInt64) -> ValueApplicability
    where {const owner N, const owner L, const owner F} {
    val formal <- first;
    val argument <- arguments;
    val actual <- no_node();
    val unrepresented <- false;
    for (unused in 0u64 .. used) {
        if (formal == no_node() || argument == no_node()) {
            if (formal != argument) return (InapplicableValue:ValueApplicability);
            return if (unrepresented) { (UnrepresentedValue:ValueApplicability) } else { (ApplicableValue:ValueApplicability) }
        };
        actual <- ordinary_argument_value(nodes, used, revision, argument);
        if (actual == no_node() || binds_local_storage(nodes, actual) || checked_ref_argument(nodes, argument))
            return (InapplicableValue:ValueApplicability);
        if (!same_operand_type(facts, actual, formal) && !supplies_enum_backing(facts, actual, facts[formal].kind) &&
            !(facts[actual].kind == c_string_kind() && facts[formal].kind == string_kind())) {
            # Do not drop a candidate whose whole-type numeric adaptation
            # could matter to selection but is outside this executable slice.
            if ((facts[actual].kind != scalar_u8() || facts[formal].kind != scalar_u64()) &&
                facts[actual].kind != never_result() &&
                !(facts[actual].kind == scalar_enum() && facts[actual].enum_backing == 0u8 &&
                  (facts[formal].kind == scalar_u8() || facts[formal].kind == scalar_u64())))
                return (InapplicableValue:ValueApplicability);
            (unrepresented <- true):void
        };
        formal <- links[formal].next;
        (argument <- links[argument].next):void
    };
    return (UnrepresentedValue:ValueApplicability)
}

func better_value_method(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                         left:UInt64, right:UInt64, arguments:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    val a <- left;
    val b <- right;
    val arg <- arguments;
    val actual <- no_node();
    val a_exact <- false;
    val b_exact <- false;
    val strictly_better <- false;
    for (unused in 0u64 .. used) {
        if (arg == no_node()) return strictly_better;
        actual <- ordinary_argument_value(nodes, used, revision, arg);
        a_exact <- same_operand_type(facts, actual, a);
        b_exact <- same_operand_type(facts, actual, b);
        if (b_exact && !a_exact) return false;
        if (a_exact && !b_exact) { (strictly_better <- true):void };
        a <- links[a].next;
        b <- links[b].next;
        (arg <- links[arg].next):void
    };
    return false
}

data ValueMethodChoice { method:UInt64, formals:UInt64, }

func find_value_candidate(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                           family:UInt64, arguments:UInt64, used:UInt64, revision:UInt64, result:ValueMethodChoice in R) -> UInt8
    where {const owner N, const owner L, const owner F, owner R} {
    val method <- family;
    ref formals = make UInt64 { no_node() };
    val match <- (InapplicableValue:ValueApplicability);
    val unrepresented <- false;
    for (unused in 0u64 .. used) {
        if (method == no_node()) {
            if (result.method != no_node()) return 0u8;
            return if (unrepresented) { unsupported_value_family() } else { wrong_operand_type() }
        };
        if (!callable_formals(nodes, revision, used, method, false, formals)) return invalid_operand_tree();
        match <- value_applicability(nodes, links, facts, formals, arguments, used, revision);
        if (match == (UnrepresentedValue:ValueApplicability)) { (unrepresented <- true):void };
        if (match == (ApplicableValue:ValueApplicability) &&
            (result.method == no_node() || better_value_method(nodes, links, facts, formals, result.formals,
                arguments, used, revision))) {
            result.method <- method;
            (result.formals <- formals):void
        };
        (method <- links[method].next_method):void
    };
    return invalid_operand_tree()
}

# Keep one candidate during the first pass. A strictly better one replaces
# it. A second pass requires the remaining candidate to dominate every other
# applicable method, including any incomparable candidate seen earlier.
func select_value_method(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                         family:UInt64, arguments:UInt64, used:UInt64, revision:UInt64, selected:UInt64 in R) -> UInt8
    where {const owner N, const owner L, const owner F, owner R} {
    ref best = make ValueMethodChoice { method <- no_node(); formals <- no_node(); };
    val issue <- find_value_candidate(nodes, links, facts, family, arguments, used, revision, best);
    if (issue != 0u8) return issue;
    ref formals = make UInt64 { no_node() };
    val method <- family;
    val applicability <- (InapplicableValue:ValueApplicability);
    val ambiguous <- false;
    val unrepresented <- false;
    for (unused in 0u64 .. used) {
        if (method == no_node()) {
            # An unrepresented conversion is non-exact at a position where
            # every represented applicant must match exactly. It cannot
            # resolve ambiguity between represented methods.
            if (ambiguous) return ambiguous_value_call();
            if (unrepresented) return unsupported_value_family();
            selected <- best.method;
            return 0u8
        };
        if (method != best.method) {
            if (!callable_formals(nodes, revision, used, method, false, formals)) return invalid_operand_tree();
            applicability <- value_applicability(nodes, links, facts, formals, arguments, used, revision);
            if (applicability != (InapplicableValue:ValueApplicability) &&
                !better_value_method(nodes, links, facts, best.formals, formals, arguments, used, revision)) {
                if (applicability == (UnrepresentedValue:ValueApplicability)) {
                    (unrepresented <- true):void
                } else { (ambiguous <- true):void }
            };
        };
        (method <- links[method].next_method):void
    };
    return invalid_operand_tree()
}

func check_here_result(nodes:const ExprNodes in N, facts:OperandFacts in F, value:UInt64, expected:UInt8)
    -> UInt8 where {const owner N, owner F} {
    if (expected == 0u8) return unproved_result_contract();
    val actual <- if (value == no_node()) { void_result() } else { (facts[value].kind) };
    if (actual == never_result()) return 0u8;
    if (expected == builtin_void() || value == no_node())
        return if (actual == void_result() && expected == builtin_void()) { 0u8 } else { wrong_return_type() };
    val kind <- source_scalar_kind(expected);
    if (kind == source_u32()) return require_source_u32(nodes, facts, value, false);
    return require_typed_bits(nodes, facts, value, kind)
}

func check_ordinary_here_invocation(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:OperandFacts in F, contract:const HereContract in C,
    at:UInt64, arguments:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner C} {
    val argument <- no_node();
    if (!first_sequence_entry(nodes, revision, at, arguments, ArgumentSequence, argument)) return invalid_operand_tree();
    val parameter <- contract.first_parameter;
    val input <- no_node();
    val diagnostic <- 0u8;
    val can_enter <- true;
    for (unused in 0u64 .. used) {
        if (parameter == no_node() || argument == no_node()) {
            if (parameter != argument) return wrong_argument_count();
            if (!can_enter) { set_result(facts, at, never_result()); return 0u8 };
            set_result(facts, at, if (contract.result_kind == builtin_void()) { void_result() }
                else { source_scalar_kind(contract.result_kind) });
            return 0u8
        };
        input <- ordinary_argument_value(nodes, used, revision, argument);
        if (input >= argument || argument >= at || checked_ref_argument(nodes, argument)) return invalid_operand_tree();
        can_enter <- can_enter && facts[input].kind != never_result();
        if (can_enter) {
            diagnostic <- check_here_result(nodes, facts, input,
                independent_formal_kind(nodes, names, parameter, used, revision));
            if (diagnostic != 0u8) return diagnostic
        };
        parameter <- links[parameter].next;
        (argument <- links[argument].next):void
    };
    return invalid_operand_tree()
}

func check_direct_call(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       selected:const SelectedExports in E, facts:OperandFacts in F,
                       owners:CallOwners in O, views:const SuppliedViews in H, cases:const ConstructorCaseFacts in C, at:UInt64, callee:UInt64,
                           arguments:UInt64, used:UInt64, revision:UInt64, source_only:bool, mixed_aggregate_loan:bool) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, owner O,
        const owner H, const owner C} {
    if (names[callee].kind == ordinary_selection()) {
        val site <- names[callee].declaration;
        if (selected[site].kind == callable_export()) {
            if (links[at].expects_here != 0u8)
                return check_prepared_here_call(nodes, links, facts, at, used, revision);
            if (source_only && selected[site].shape != ordinary_callable_shape() &&
                selected[site].shape != array_slot_callable_shape())
                return check_prepared_native_loans(nodes, names, links, facts, views,
                    selected[site].origin_module, selected[site].identity, at, arguments, used,
                    revision);
            return check_imported_call(nodes, names, selected, links, facts, cases, views, at, arguments, used, revision,
                source_only, selected[site].shape == array_slot_callable_shape())
        };
        return check_text_intrinsic(nodes, names, links, facts, at, arguments, selected[site].kind, used, revision, source_only);
    };
    if (names[callee].kind == formal_binding()) {
        val callback <- names[callee].declaration;
        ref contract = make HereContract {
            first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity
                <- 0u64
        };
        if (callback >= used || !inspect_here_contract(views, callback, contract)) return unproved_call_target();
        if (source_only && at < intrinsic (len)(views) && (case views[at] of {
            OrdinaryHereInvocation { val selected <- formal, } -> selected == callback;
            _ -> false
        })) return check_ordinary_here_invocation(nodes, names, links, facts, contract, at, arguments, used, revision);
        if (prepared_here_formal(views, at) != callback) return unproved_call_target();
        return remember_native_result(facts, at, contract.result_kind, contract.result_module,
            contract.result_identity)
    };
    if (names[callee].kind == c_operation()) {
        if (links[at].expects_here != 0u8)
            return check_prepared_here_call(nodes, links, facts, at, used, revision);
        val provider <- names[callee].declaration;
        if (provider >= used) return unproved_call_target();
        if (source_only && has_prepared_native_loans(views, at)) {
            val native_diagnostic <- check_prepared_native_loans(nodes, names, links, facts, views,
                0u64, provider, at, arguments, used, revision);
            if (native_diagnostic == 0u8 && facts[at].kind != never_result()) { (facts[at].loans_scoped_aggregate <- true):void };
            return native_diagnostic
        };
        if (!prepared_native_operation(views, at, provider)) return unproved_call_target();
        return remember_native_result(facts, at, links[at].value_kind, links[at].value_module,
            links[at].value_identity)
    };
    if (names[callee].kind != callable_binding()) return unproved_call_target();
    val definition <- names[callee].declaration;
    ref formal = make UInt64 { no_node() };
    ref argument = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, argument))
        return invalid_operand_tree();
    val text_writer <- source_only && prepared_text_writer(views, definition);
    val formatting <- source_only && prepared_formatting_method(views, definition);
    if (formatting) {
        if (argument >= at || links[argument].next != no_node()) return wrong_argument_count();
        val format_input <- ordinary_argument_value(nodes, used, revision, argument);
        if (format_input >= argument || checked_ref_argument(nodes, argument)) return unsupported_value_family();
        val caller <- enclosing_callable(nodes, names, names[at].scope);
        if (is_function(nodes, caller)) return procedure_call_in_function();
        if (facts[format_input].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        if (!prepared_formatting_method(views, caller)) return unproved_text_receiver()
    };
    if (text_writer) {
        if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
            return procedure_call_in_function();
        if (argument >= at) return wrong_argument_count();
        val next <- links[argument].next;
        if (next >= at || links[next].next != no_node()) return wrong_argument_count();
        val target <- ordinary_argument_value(nodes, used, revision, argument);
        val piece <- ordinary_argument_value(nodes, used, revision, next);
        if (target >= argument || piece >= next) return invalid_operand_tree();
        if (checked_ref_argument(nodes, argument) || checked_ref_argument(nodes, next))
            return unsupported_value_family();
        if (facts[target].kind == never_result() || facts[piece].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        }
    };
    if (links[definition].next_method != no_node()) {
        if ((source_only && !text_writer && !formatting) ||
            transfer_name(source, nodes, definition_name(nodes, revision, used, definition)))
            return unsupported_transfer_signature();
        val issue <- select_value_method(nodes, links, facts, definition, argument, used, revision, definition);
        if (issue != 0u8) return issue
    };
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    if (!callable_formals(nodes, revision, used, definition, source_only, formal)) return invalid_operand_tree();
    val pending <- facts[definition].omitted_result;
    if (pending && !facts[at].statement_operand) return unproved_result_contract();
    val result_owner <- facts[definition].owner;
    val first_formal <- formal;
    val ordinary_here <- source_only && at < intrinsic (len)(views) && (case views[at] of {
        OrdinaryHereCall { val selected <- definition, } -> selected == definition;
        _ -> false
    });
    val independent_loan_result <- source_only &&
        (scalar_kind(facts[definition].kind) || facts[definition].kind == source_u32() ||
            facts[definition].kind == void_result()) &&
        facts[definition].reception != borrowed_ref();
    val loans_owning_handle <- false;
    val loans_scoped_aggregate <- false;
    val loans_array_slot <- false;
    val checks_slot_call <- false;
    if (source_only) {
        ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
        inspect_callable(nodes, revision, used, definition, callable);
        (checks_slot_call <- prepared_array_signature(nodes, links, views,
            callable.signature, used, revision) == (ArrayReferenceSlotFormal:SourceArrayFormals)):void
    };
    val checked_mixed_loan <- mixed_aggregate_loan || (source_only && prepared_workspace_loans(views, definition));
    val checks_scoped_call <- checked_mixed_loan || (source_only && at < intrinsic (len)(cases) &&
        (case cases[at] of {
            FreshSumInvocation { val target <- definition, } -> target == definition;
            AggregateLoanInvocation { val target <- definition, } -> target == definition;
            _ -> false
        }));
    val can_enter <- true;
    val diagnostic <- 0u8;
    val input <- no_node();
    val here_operand <- false;
    ref receipt = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    for (unused in 0u64 .. used) {
        if (argument == no_node() || (!ordinary_here && formal == no_node())) {
            if (!ordinary_here && formal != argument) return wrong_argument_count();
            if (!can_enter) { set_result(facts, at, never_result()); return 0u8 };
            if (!pending) { copy_fact(facts, at, definition) };
            if (facts[definition].reception == borrowed_ref()) {
                if (owners[result_owner].call_site != at) return unproved_owner();
                (facts[at].owner <- owners[result_owner].actual_owner):void;
            };
            facts[at].call_definition <- definition;
            facts[at].loans_owning_handle <- loans_owning_handle;
            facts[at].loans_scoped_aggregate <- loans_scoped_aggregate;
            facts[at].loans_array_slot <- loans_array_slot;
            return 0u8;
        } else {};
        if (ordinary_here) {
            case views[argument] of {
                OrdinaryHereArgument { val slot <- formal, val prepared <- operand, } -> {
                    formal <- slot;
                    (input <- prepared):void
                };
                _ -> { return invalid_operand_tree() }
            };
            if (formal >= used) return invalid_operand_tree();
            (here_operand <- inspect_here_contract(views, formal, receipt)):void
        } else { (here_operand <- false):void };
        if (!here_operand && (ordinary_here || checks_slot_call || checks_scoped_call || pending || facts[at].text_call)) {
            if (!ordinary_here) { (input <- ordinary_argument_value(nodes, used, revision, argument)):void };
            if (input >= argument || argument >= at || formal >= used) return invalid_operand_tree();
            (can_enter <- can_enter && facts[input].kind != never_result()):void
        };
        if (can_enter && !here_operand) {
            diagnostic <- check_argument(nodes, names, selected, links, facts, owners, cases, argument,
                formal, at, used, revision, independent_loan_result, definition, first_formal, source_only,
                checks_scoped_call, checks_slot_call, checked_mixed_loan);
            if (diagnostic != 0u8) return diagnostic;
            loans_owning_handle <- loans_owning_handle || facts[argument].loans_owning_handle;
            loans_scoped_aggregate <- loans_scoped_aggregate || facts[argument].loans_scoped_aggregate;
            (loans_array_slot <- loans_array_slot || facts[argument].array_slot != no_node()):void
        };
        if (!ordinary_here) { (formal <- links[formal].next):void };
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func lend_imported_fresh_sum(names:const NameBindings in B, facts:OperandFacts in F,
    cases:const ConstructorCaseFacts in C, invocation:UInt64, argument:UInt64, input:UInt64) -> UInt8
    where {const owner B, owner F, const owner C} {
    val lexical_owner <- names[invocation].scope;
    if (lexical_owner == no_node() || names[input].scope != lexical_owner ||
        facts[input].reception != independent_value() || input >= intrinsic (len)(cases) ||
        !(case cases[input] of {
            BitsConstruction { val consumer <- transfer, } -> consumer == argument;
            _ -> false
        })) return unproved_owner();
    set_fact(facts, argument, source_sum_target(), borrowed_ref(), lexical_owner, facts[input].identity, 0u8);
    facts[argument].identity_module <- facts[input].identity_module;
    facts[argument].selection <- input;
    facts[argument].target_readonly <- 1u8;
    return 0u8
}

func scoped_imported_product_actual(names:const NameBindings in B, facts:const OperandFacts in F,
    cases:const ConstructorCaseFacts in C, at:UInt64, value:UInt64, argument:UInt64, writable:bool,
    readonly_call:bool, inline_product_loan:bool, inline_output:bool)
    -> bool where {const owner B, const owner F, const owner C} {
    if (names[value].kind == local_binding()) {
        val declaration <- names[value].declaration;
        return declaration < value && declaration < intrinsic (len)(cases) &&
            (case cases[declaration] of {
                LexicalProductReference { val owner_site <-, } ->
                    owner_site == facts[value].owner && owner_site == names[at].scope;
                _ -> false
            })
    };
    return value < intrinsic (len)(cases) && facts[value].selection == value &&
        (case cases[value] of {
            IndexedAggregateLoan { val consumer <-, val write_access <- writable, } ->
                consumer == argument && write_access == writable;
            InlineProductField -> inline_output || (inline_product_loan && !writable);
            CaseProductField -> readonly_call && !writable && facts[value].target_readonly != 0u8 &&
                receipt_in_context(facts, at, facts[value].case_receipt);
            _ -> false
        })
}

func lend_imported_product_receipt(names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, at:UInt64, argument:UInt64, value:UInt64) -> bool
    where {const owner B, const owner L, owner F} {
    val receipt <- facts[value].case_receipt;
    val owner_site <- facts[value].owner;
    if (receipt >= value || names[value].kind != local_binding() || names[value].declaration != receipt ||
        owner_site != names[receipt].scope || !receipt_in_context(facts, at, receipt) ||
        facts[value].reception != local_place() || links[argument].imported_reception != borrowed_ref() ||
        links[argument].imported_target_readonly == 0u8 || links[argument].imported_owner_readonly == 0u8 ||
        facts[value].identity_module != links[argument].imported_type_module ||
        facts[value].identity != links[argument].imported_type_identity) return false;
    set_fact(facts, argument, source_product_loan(), borrowed_ref(), owner_site, facts[value].identity, 0u8);
    facts[argument].identity_module <- facts[value].identity_module;
    facts[argument].case_receipt <- receipt;
    facts[argument].target_readonly <- 1u8;
    return true
}

func check_imported_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                         selected:const SelectedExports in E, links:const NameWork in L, facts:OperandFacts in F, cases:const ConstructorCaseFacts in C, views:const SuppliedViews in H,
    at:UInt64, arguments:UInt64, used:UInt64, revision:UInt64, source_only:bool, slot_call:bool) -> UInt8
    where {const owner N, const owner B, const owner E, const owner L, owner F, const owner C, const owner H} {
    if (links[at].imported_interface == no_node() || links[at].imported_callable_kind ==
        NoCallableKind)
        return unsupported_imported_call();
    if (links[at].imported_callable_kind == CheckedProcedure && is_function(nodes,
        enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val result_owner <- links[at].imported_owner_argument;
    val returned_kind <- links[at].imported_kind;
    val readonly_call <- source_only && (case views[at] of { CheckedReadonlyCall -> true; _ -> false });
    val inline_product_loan <- source_only && (case views[at] of {
        CheckedParserWriterCall { val inline_input <-, } -> inline_input;
        CheckedWorkspaceWriterCall -> true;
        _ -> false
    });
    val writes_inline_product <- source_only && (case views[at] of {
        ImportedProductWriter -> true;
        CheckedParserWriterCall -> true;
        CheckedWorkspaceWriterCall -> true;
        _ -> false
    });
    val widens_index_operand <- source_only && (returned_kind == scalar_u8() || returned_kind == void_result() ||
        checked_source_array_call(views, at)) &&
        links[at].imported_array_read_completion != NoArrayRead;
    ref argument = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, argument)) return invalid_operand_tree();
    val diagnostic <- 0u8;
    val witness <- no_node();
    val actual <- no_node();
    val value <- no_node();
    val expected <- 0u8;
    val source_aggregate_loan <- false;
    val scoped_call <- false;
    val owns_handle <- false;
    val inline_output <- false;
    val slot <- no_node();
    for (unused in 0u64 .. used) {
        if (argument == no_node()) {
            diagnostic <- 0u8;
            if (result_owner != no_node()) {
                set_fact(facts, at, returned_kind, borrowed_ref(), facts[result_owner].owner, 0u64, 0u8);
                facts[at].target_readonly <- links[at].imported_target_readonly;
                if (returned_kind == c_string_kind()) { (facts[at].text_nul <- nul_absent()):void; };
            } else {
                if (returned_kind == scalar_enum() ||
                    (returned_kind == enum_type() && links[at].imported_array_read_completion != NoArrayRead)) {
                    (diagnostic <- remember_native_result(facts, at, enum_type(), links[at].imported_type_module,
                        links[at].imported_type_identity)):void
                } else {
                    if (returned_kind == independent_sum_bits()) {
                        set_fact(facts, at, returned_kind, independent_value(), no_node(),
                            links[at].imported_type_identity, 0u8);
                        (facts[at].identity_module <- links[at].imported_type_module):void
                    } else { set_result(facts, at, returned_kind) }
                };
            };
            facts[at].loans_scoped_aggregate <- scoped_call;
            facts[at].loans_array_slot <- slot_call;
            facts[at].loans_owning_handle <- owns_handle;
            return diagnostic;
        };
        value <- ordinary_argument_value(nodes, used, revision, argument);
        if (value >= used) return invalid_operand_tree();
        if (source_only && facts[value].kind == never_result()) {
            set_result(facts, at, never_result());
            return 0u8
        };
        expected <- links[argument].imported_kind;
        source_aggregate_loan <- source_only &&
            (expected == source_array_loan() || expected == source_product_loan() || expected == source_builder_loan() ||
                (expected == source_sum_target() && links[at].imported_array_read_completion != NoArrayRead));
        if (expected == source_handle_loan() || source_aggregate_loan) {
            if (checked_ref_argument(nodes, argument)) return wrong_operand_type();
            if (slot_call && expected == source_handle_loan() && facts[value].kind == 0u8) {
                if (!prepare_acquired_handle_argument(nodes, names, selected, links, facts, value,
                    argument, at, used, revision)) return unproved_owner();
                owns_handle <- true;
                (value <- argument):void
            };
            if (source_aggregate_loan && expected == source_sum_target() &&
                facts[value].kind == independent_sum_bits()) {
                diagnostic <- lend_imported_fresh_sum(names, facts, cases, at, argument, value);
                if (diagnostic != 0u8) return diagnostic;
                (value <- argument):void
            };
            if (source_aggregate_loan && expected == source_product_loan() && facts[value].kind == received_product()) {
                if (!readonly_call ||
                    !lend_imported_product_receipt(names, links, facts, at, argument, value))
                    return wrong_operand_type();
                (value <- argument):void
            };
            if ((facts[value].kind != expected &&
                    !(expected == source_product_loan() && facts[value].kind == product_kind())) ||
                    facts[value].reception != borrowed_ref() ||
                (source_aggregate_loan && facts[value].target_presence != present_target()) ||
                facts[value].identity_module != links[argument].imported_type_module ||
                facts[value].identity != links[argument].imported_type_identity)
                return wrong_operand_type();
            inline_output <- writes_inline_product && expected == source_product_loan() &&
                links[argument].imported_target_readonly == 0u8 && writable_inline_product_actual(facts, cases, value);
            if (facts[value].target_readonly != 0u8 &&
                links[argument].imported_target_readonly == 0u8 && !inline_output)
                return expected_writable_place();
            if (expected == source_sum_target() && links[argument].imported_target_readonly == 0u8) {
                if (facts[value].reservation != no_node()) return unproved_nonnull_borrow();
                (scoped_call <- true):void
            };
            if (expected == source_product_loan() && value != argument && names[value].kind != formal_binding() &&
                !scoped_imported_product_actual(names, facts, cases, at, value, argument,
                    links[argument].imported_target_readonly == 0u8, readonly_call, inline_product_loan, inline_output))
                return unproved_owner();
            if (value != argument) { copy_fact(facts, argument, value) };
            if (links[argument].imported_ref_slot) {
                slot <- bound_array_slot(nodes, names, links, facts, value, at, used, revision);
                if (slot == no_node() ||
                    facts[value].selection != no_node() || facts[value].case_receipt != no_node())
                    return expected_writable_place();
                # The declaration carries only invariant array and owner facts.
                # The actual receipt is a slot; other loans keep their earlier backing.
                (facts[argument].array_slot <- slot):void
            };
            if (source_aggregate_loan) {
                facts[argument].target_readonly <- links[argument].imported_target_readonly;
                (scoped_call <- scoped_call || links[at].imported_array_read_completion == NoArrayRead):void
            }
        } else {
            if (source_only && !slot_call && (expected == scalar_u64() || expected == scalar_bool()) &&
                links[argument].imported_reception == borrowed_ref() &&
                (facts[value].target_presence != present_target() || facts[value].reservation != no_node()))
                return unproved_nonnull_borrow();
            if (widens_index_operand && links[argument].imported_reception == local_place() &&
                expected == scalar_u64() &&
                (facts[value].kind == scalar_u8() || facts[value].kind == source_u32())) {
                if (checked_ref_argument(nodes, argument)) return checked_selection_requires_ref();
                diagnostic <- require_widening_u64(nodes, facts, value);
                if (diagnostic != 0u8) return diagnostic;
                set_fact(facts, argument, expected, independent_value(), no_node(), 0u64, 0u8)
            } else {
                diagnostic <- check_argument_operand(nodes, facts, argument, expected,
                    links[argument].imported_reception,
                    if (expected == scalar_enum()) { (links[argument].imported_type_identity) } else { 0u64 },
                    if (expected == scalar_enum()) { (links[argument].imported_type_module) } else { 0u64 },
                    links[argument].imported_target_readonly, used, revision);
                if (diagnostic != 0u8) return diagnostic
            }
        };
        witness <- links[argument].imported_owner_argument;
        if (witness != no_node()) {
            actual <- facts[argument].owner;
            if (slot_call && (actual >= used || facts[argument].reservation != no_node())) return unproved_owner();
            diagnostic <- check_owner_access(nodes, actual, links[argument].imported_owner_readonly == 0u8);
            if (diagnostic != 0u8) return diagnostic;
            if (argument != witness && facts[witness].owner != actual)
                return owner_conflict(nodes, facts[witness].owner, actual);
            if (links[argument].imported_passes_owner != 0u8) {
                facts[argument].owner_chain <- 0u64;
                (facts[actual].owner_chain <- 0u64):void;
            } else {};
        };
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func argument_at_position(links:const NameWork in L, first:UInt64, position:UInt64) -> UInt64 where {const owner L} {
    if (position == no_node()) return no_node();
    val argument <- first;
    for (index in 0u64 .. position) {
        if (argument == no_node()) return no_node();
        argument <- links[argument].next;
    };
    return argument;
}

func first_handle_formal(contracts:const ModuleInterfaces in I, header:UInt64, role:UInt64)
    -> UInt64 where {const owner I} {
    val row <- 0u64;
    for (position in 0u64 .. contracts[header].entry_count) {
        row <- header + 1u64 + position;
        if (contracts[row].value_kind == c_handle_type() && contracts[row].owner_role == role)
            return position
    };
    return no_node()
}

# Published ordinary source owner roles are ordinals of the owner clauses.
# Find the written borrowed operand for the role, past any value operands.
func first_source_loan_formal(contracts:const ModuleInterfaces in I, header:UInt64, role:UInt64)
    -> UInt64 where {const owner I} {
    if (role == no_node()) return no_node();
    val row <- 0u64;
    for (position in 0u64 .. contracts[header].entry_count) {
        row <- header + 1u64 + position;
        if ((contracts[row].field_mode == ReferenceFormal || contracts[row].field_mode == HandleFormal) &&
            contracts[row].owner_role == role)
            return position
    };
    return no_node()
}

func bind_imported_call(nodes:const ExprNodes in N, links:NameWork in L, contracts:const ModuleInterfaces in I,
                        at:UInt64, header:UInt64, arguments:UInt64, used:UInt64, revision:UInt64,
                            source_handles:bool, source_declared_signature:bool)
    -> bool where {const owner N, owner L, const owner I} {
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, first)) return false;
    val argument <- first;
    val row <- header + 1u64;
    val handles <- false;
    val array_loan <- false;
    val product_loan <- false;
    val sum_loan <- false;
    val string_loan <- false;
    val builder_loan <- false;
    val slot_signature <- contracts[header].array_slot_checked;
    val role <- no_node();
    val kind <- 0u8;
    for (index in 0u64 .. contracts[header].entry_count) {
        if (argument == no_node()) return false;
        kind <- contracts[row].value_kind;
        handles <- source_handles && kind == c_handle_type();
        array_loan <- source_declared_signature && kind == array_type();
        product_loan <- source_declared_signature && kind == record_type();
        sum_loan <- source_declared_signature && kind == sum_type();
        builder_loan <- source_declared_signature && kind == lexical_builder_type() &&
            contracts[row].field_mode == ReferenceFormal;
        string_loan <- source_declared_signature && kind == builtin_string() &&
            contracts[row].field_mode == ReferenceFormal && contracts[row].target_readonly == 1u8 &&
            contracts[row].owner_readonly == 1u8;
        links[argument].imported_kind <- if (array_loan) { source_array_loan() } else {
            if (product_loan) { source_product_loan() } else {
                if (sum_loan) { source_sum_target() } else {
                    if (builder_loan) { source_builder_loan() } else {
                    if (source_handles || source_declared_signature) {
                        if (handles) { source_handle_loan() } else {
                            if (string_loan) { string_kind() } else { source_scalar_kind(kind) }
                        }
                    } else { kind }
                    }
                }
            }
        };
        links[argument].imported_ref_slot <- slot_signature && contracts[row].slot_target_invariant;
        links[argument].imported_reception <- if (array_loan || product_loan || sum_loan || handles || string_loan || builder_loan ||
            (contracts[row].field_mode == ReferenceFormal &&
                (slot_signature || (source_declared_signature && source_place_scalar(kind))))) {
            borrowed_ref()
        } else {
            if (source_handles || source_declared_signature) { local_place() } else { (contracts[row].native_reception) }
        };
        links[argument].imported_target_readonly <- contracts[row].target_readonly;
        links[argument].imported_owner_readonly <- contracts[row].owner_readonly;
        links[argument].imported_passes_owner <- if (slot_signature && contracts[row].source_allocates) {
            1u8
        } else { (contracts[row].native_passes_owner) };
        role <- contracts[row].owner_role;
        if (handles || array_loan || product_loan || sum_loan || builder_loan ||
            (source_declared_signature && kind == enum_type()) ||
            (!source_handles && !source_declared_signature &&
                (kind == scalar_enum() || nominal_source_loan(kind)))) {
            links[argument].imported_type_module <- contracts[row].type_module;
            (links[argument].imported_type_identity <- contracts[row].type_identity):void
        };
        links[argument].imported_owner_argument <- argument_at_position(links, first,
            if (slot_signature) { role } else {
                if (source_declared_signature) { first_source_loan_formal(contracts, header, role) } else {
                    if (handles) { first_handle_formal(contracts, header, role) } else { role }
                }
            });
        argument <- links[argument].next;
        (row <- row + 1u64):void;
    };
    if (argument != no_node()) return false;
    links[at].imported_owner_argument <- argument_at_position(links, first,
        contracts[header].owner_role);
    return true;
}

func remember_imported_call(links:NameWork in L, contracts:const ModuleInterfaces in I,
                            at:UInt64, header:UInt64, declared_result:bool) -> void where {owner L,
                                const owner I} {
    links[at].imported_interface <- header;
    links[at].imported_function <- contracts[header].native_function;
    val result <- contracts[header].result_kind;
    links[at].imported_kind <- if (declared_result) {
        if (result == builtin_void()) { void_result() } else {
            if (result == sum_type()) { independent_sum_bits() } else { source_scalar_kind(result) }
        }
    } else { result };
    if (!declared_result && result == scalar_enum()) {
        links[at].imported_type_module <- contracts[header].type_module;
        (links[at].imported_type_identity <- contracts[header].type_identity):void
    };
    links[at].imported_callable_kind <- contracts[header].callable_kind;
    links[at].imported_target_readonly <- contracts[header].target_readonly;
    links[at].imported_failure <- contracts[header].failure_identity;
    links[at].imported_failure_module <- contracts[header].failure_module;
    links[at].imported_failure_checked <- contracts[header].failure_checked;
    return
}

func valid_imported_failure(contracts:const ModuleInterfaces in I, published:UInt64,
                            catalog:const ModuleExports in B, module:UInt64, declaration:UInt64,
                                checked:UInt8) -> bool
    where {const owner I, const owner B} {
    if (declaration == no_node() || checked > 1u8) return false;
    if (module == 0u64) {
        for (row in 0u64 .. intrinsic (len)(catalog)) {
            if (catalog[row].origin_module == 0u64 && catalog[row].kind == exception_type_export()
                &&
                catalog[row].identity == declaration && catalog[row].checked == checked) return true
        };
        return false
    };
    val header <- find_interface(contracts, published, module, declaration);
    if (header == no_node() || contracts[header].interface_kind != record_type()) return false;
    val schema <- contracts[header].exception_schema;
    return if (checked == 1u8) { schema == CheckedExceptionSchema }
        else { schema == UncheckedExceptionSchema }
}

func has_nominal_identity(row:const ModuleInterfaceRow in R) -> bool where {const owner R} {
    return row.type_module != 0u64 && row.type_module != no_node() && row.type_identity != no_node()
}

func published_bits_record(contracts:const ModuleInterfaces in I, published:UInt64, row:UInt64)
    -> bool where {const owner I} {
    val storage <- checked_aggregate_storage(contracts, published, contracts[row].type_module,
        contracts[row].type_identity, record_type());
    return storage == CoDBitsAggregate || storage == CLayoutBitsRecord
}

func published_enum_domain(contracts:const ModuleInterfaces in I, published:UInt64,
                           row:UInt64) -> bool where {const owner I} {
    if (!has_nominal_identity(contracts[row])) return false;
    val header <- find_interface(contracts, published, contracts[row].type_module, contracts[row].type_identity);
    return header != no_node() && contracts[header].interface_kind == enum_type()
}

# The ordinary call ABI copies one scalar word. A published enum word also
# carries a canonical domain. A ref/ptr word has a different contract.
func valid_ordinary_enum_rows(contracts:const ModuleInterfaces in I, published:UInt64,
                              header:UInt64) -> bool where {const owner I} {
    if (contracts[header].result_kind == scalar_enum() &&
        (contracts[header].owner_role != no_node() || !published_enum_domain(contracts, published, header)))
        return false;
    for (row in header + 1u64 .. header + 1u64 + contracts[header].entry_count) {
        if (contracts[row].value_kind == scalar_enum() &&
            (contracts[row].interface_kind != 0u8 || contracts[row].native_reception != local_place() ||
             contracts[row].owner_role != no_node() || contracts[row].owner_readonly != 0u8 ||
             contracts[row].native_passes_owner != 0u8 || !published_enum_domain(contracts, published, row)))
            return false;
    };
    return true
}

func checked_source_parameter(contracts:const ModuleInterfaces in I, first:UInt64,
    position:UInt64) -> bool where {const owner I} {
    val row <- first + position;
    val role <- contracts[row].owner_role;
    val reception <- contracts[row].native_reception;
    val constraint <- contracts[row].owner_readonly;
    val kind <- contracts[row].value_kind;
    if (contracts[row].interface_kind != 0u8 || contracts[row].target_readonly > 1u8 ||
        constraint > 1u8 || contracts[row].native_passes_owner != 0u8 || contracts[row].source_allocates) return false;
    if (nominal_source_loan(kind)) {
        if (reception != borrowed_ref() || contracts[row].entry_count != 0u64 ||
            !has_nominal_identity(contracts[row]) ||
            contracts[row].field_mode != (if (kind == source_handle_loan()) { HandleFormal } else { ReferenceFormal }))
            return false
    } else {
        if (!native_scalar(kind) &&
            (kind != scalar_enum() || reception != local_place() || !has_nominal_identity(contracts[row]))) return false
    };
    if (reception == local_place()) return role == no_node() && constraint == 0u8;
    # Ordinary call roles name formal positions. Each role starts at its first loan.
    if ((reception != borrowed_ref() && reception != nullable_ptr()) || role > position)
        return false;
    val anchor <- first + role;
    return contracts[anchor].owner_role == role && contracts[anchor].owner_readonly == constraint
}

func checked_source_call(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64) -> bool where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return false;
    val arity <- contracts[header].entry_count;
    val result <- if (contracts[header].scalar_source_body) {
        declared_scalar(contracts[header].result_kind)
    } else { (contracts[header].result_kind) };
    if (contracts[header].interface_kind != callable_binding() || contracts[header].value_kind != 0u8 ||
        contracts[header].defining_module == 0u64 || contracts[header].declaration == no_node() ||
        contracts[header].native_function != no_node() || arity >= published - header ||
        (!native_scalar(result) && result != void_result() &&
         (result != scalar_enum() || !has_nominal_identity(contracts[header]))) ||
        contracts[header].owner_role != no_node() ||
        contracts[header].owner_count != 0u64 || contracts[header].has_here != 0u8 ||
        contracts[header].target_readonly != 0u8 ||
        contracts[header].callable_kind == NoCallableKind) return false;
    val first <- header + 1u64;
    for (position in 0u64 .. arity) {
        if (!checked_source_parameter(contracts, first, position)) return false
    };
    return true
}

func source_handle_call(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> bool where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return false;
    val arity <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    if (contracts[header].interface_kind != callable_binding() ||
        contracts[header].native_function != no_node() ||
        contracts[header].owner_role != no_node() ||
        contracts[header].has_here != 0u8 || contracts[header].callable_kind == NoCallableKind ||
        owners == 0u64 || arity >= published - header ||
        (!source_call_scalar(result) && result != builtin_void())) return false;
    val has_handle <- false;
    val kind <- 0u8;
    for (row in header + 1u64 .. header + 1u64 + arity) {
        if (contracts[row].interface_kind != 0u8 || contracts[row].native_reception != 0u8 ||
            contracts[row].native_passes_owner != 0u8 || contracts[row].target_readonly > 1u8 ||
            contracts[row].owner_readonly > 1u8) return false;
        kind <- contracts[row].value_kind;
        if (kind == c_handle_type()) {
            if (contracts[row].owner_role >= owners || contracts[row].type_module == 0u64 ||
                contracts[row].type_identity == no_node()) return false;
            (has_handle <- true):void
        } else {
            if (!source_call_scalar(kind) || contracts[row].owner_role != no_node()) return false
        }
    };
    return has_handle
}

func checked_readonly_loan_row(row:const ModuleInterfaceRow in R, kind:UInt8, role:UInt64)
    -> bool where {const owner R} {
    return row.interface_kind == 0u8 && row.entry_count == 0u64 &&
        row.value_kind == kind && row.field_mode == ReferenceFormal &&
        row.type_module != 0u64 && row.type_identity != no_node() &&
        row.owner_role == role && row.owner_readonly == 1u8 &&
        row.target_readonly == 1u8 && row.native_reception == 0u8 &&
        row.native_passes_owner == 0u8 && !row.source_allocates
}

func source_scalar_value_row(row:const ModuleInterfaceRow in R, kind:UInt8) -> bool where {const owner R} {
    return row.interface_kind == 0u8 && row.entry_count == 0u64 &&
        row.value_kind == kind && row.owner_role == no_node() &&
        (row.field_mode == ValueFormal || row.field_mode == ExplicitValueFormal) &&
        row.owner_readonly == 0u8 && row.target_readonly == 0u8 &&
        row.native_reception == 0u8 && row.native_passes_owner == 0u8
}

func checked_source_scalar_parameter(contracts:const ModuleInterfaces in I, published:UInt64, row:UInt64)
    -> bool where {const owner I} {
    val kind <- contracts[row].value_kind;
    if (kind == enum_type())
        return source_scalar_value_row(contracts[row], kind) && !contracts[row].source_allocates &&
            published_enum_domain(contracts, published, row);
    return source_call_scalar(kind) && source_aggregate_formal(contracts, row, kind, no_node(), 0u8)
}

func checked_array_procedure_past(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> UInt64 where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val arity <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    if (arity >= published - header || owners == 0u64 ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedProcedure ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].source_writer != NoSourceWriter || contracts[header].has_here != 0u8 ||
        contracts[header].owner_role != no_node() || contracts[header].target_readonly != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 ||
        (contracts[header].array_read_completion != CheckedArrayRead &&
         contracts[header].array_read_completion != ArrayReadMayFailBounds) ||
        (!source_call_scalar(result) && result != builtin_void() && result != enum_type() && result != sum_type())) return no_node();
    if (result == enum_type()) {
        if (!published_enum_domain(contracts, published, header)) return no_node()
    } else {
        if (result == sum_type()) {
            if (!has_nominal_identity(contracts[header]) ||
                checked_aggregate_storage(contracts, published, contracts[header].type_module,
                    contracts[header].type_identity, sum_type()) != CoDBitsAggregate) return no_node()
        } else {
            if (contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64) return no_node()
        }
    };
    val past <- header + 1u64 + arity;
    val handle <- false;
    val array <- false;
    val output <- false;
    val readonly_array <- false;
    val record <- false;
    val kind <- 0u8;
    val role <- no_node();
    for (row in header + 1u64 .. past) {
        kind <- contracts[row].value_kind;
        role <- contracts[row].owner_role;
        if (kind == c_handle_type()) {
            if (contracts[row].interface_kind != 0u8 || contracts[row].entry_count != 0u64 ||
                contracts[row].field_mode != HandleFormal || role >= owners ||
                !has_nominal_identity(contracts[row]) || contracts[row].target_readonly > 1u8 ||
                contracts[row].owner_readonly > 1u8 || contracts[row].native_reception != 0u8 ||
                contracts[row].native_passes_owner != 0u8 || contracts[row].source_allocates) return no_node();
            (handle <- true):void
        } else {
            if (kind == record_type()) {
                if ((result != builtin_u8() && result != enum_type()) || role >= owners ||
                    !checked_readonly_loan_row(contracts[row], kind, role) ||
                    !published_bits_record(contracts, published, row)) return no_node();
                (record <- true):void
            } else { if (kind == array_type()) {
                if (role >= owners || contracts[row].interface_kind != 0u8 ||
                    contracts[row].entry_count != 0u64 || contracts[row].field_mode != ReferenceFormal ||
                    !has_nominal_identity(contracts[row]) || contracts[row].target_readonly > 1u8 ||
                    contracts[row].owner_readonly > 1u8 ||
                    (contracts[row].target_readonly == 0u8 && contracts[row].owner_readonly != 0u8) ||
                    contracts[row].native_reception != 0u8 || contracts[row].native_passes_owner != 0u8 ||
                    contracts[row].source_allocates) return no_node();
                if (result == sum_type() &&
                    (contracts[row].target_readonly != 1u8 || contracts[row].owner_readonly != 1u8)) return no_node();
                array <- true;
                readonly_array <- readonly_array || contracts[row].target_readonly != 0u8;
                (output <- output || contracts[row].target_readonly == 0u8):void
            } else {
                if (!source_scalar_value_row(contracts[row], kind) || contracts[row].source_allocates)
                    return no_node();
                if (kind == enum_type()) {
                    if (result == sum_type() || !published_enum_domain(contracts, published, row)) return no_node()
                } else {
                    if (!source_call_scalar(kind) || contracts[row].type_module != 0u64 ||
                        contracts[row].type_identity != 0u64) return no_node()
                }
            } }
        }
    };
    if (result == sum_type()) return if (array && !handle && !record && !output) { past } else { no_node() };
    if (record && (!handle || !output || !readonly_array)) return no_node();
    return if (array && (handle || (output && result == builtin_void()))) { past } else { no_node() }
}

func checked_parameterized_scalar_past(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> UInt64 where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val arity <- contracts[header].entry_count;
    val result <- contracts[header].result_kind;
    if (arity == 0u64 || arity >= published - header || !contracts[header].scalar_source_body ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        (result != builtin_u64() && result != builtin_u8() && result != builtin_bool()) ||
        contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
        contracts[header].target_readonly != 0u8 || contracts[header].owner_count != 0u64 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion != NoArrayRead ||
        contracts[header].source_writer != NoSourceWriter) return no_node();
    val first <- header + 1u64;
    val past <- first + arity;
    for (row in first .. past) {
        if (!checked_source_scalar_parameter(contracts, published, row)) return no_node();
    };
    return past
}

func product_writer_output(contracts:const ModuleInterfaces in I, header:UInt64) -> UInt64 where {const owner I} {
    val first <- header + 1u64;
    if (contracts[header].owner_count != 1u64) return header + contracts[header].entry_count;
    return if (contracts[first].value_kind == builtin_u64() && contracts[header].entry_count == 2u64) {
        first + 1u64
    } else { first }
}

func checked_product_writer_header(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> bool where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return false;
    val arity <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    if (arity < 2u64 || arity >= published - header ||
        (owners != 1u64 && (owners != 2u64 || (arity != 3u64 && arity != 4u64))) ||
        contracts[header].source_writer != ProductWriter ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        (result != builtin_void() && (result != builtin_u64() || owners != 1u64)) ||
        contracts[header].type_module != 0u64 ||
        contracts[header].type_identity != 0u64 || contracts[header].target_readonly != 0u8 ||
        contracts[header].owner_role != no_node() ||
        contracts[header].has_here != 0u8 || contracts[header].failure_identity != no_node() ||
        contracts[header].failure_module != 0u64 || contracts[header].failure_checked != 0u8 ||
        (contracts[header].array_read_completion != CheckedArrayRead &&
         contracts[header].array_read_completion != ArrayReadMayFailBounds)) return false;
    val first <- header + 1u64;
    val product <- product_writer_output(contracts, header);
    if (!source_aggregate_formal(contracts, product, record_type(), owners - 1u64, 0u8)) return false;
    val target_storage <- checked_aggregate_storage(contracts, published, contracts[product].type_module,
        contracts[product].type_identity, record_type());
    if (owners == 1u64) {
        if (target_storage != CoDBitsAggregate && target_storage != CLayoutBitsRecord) return false;
        if (product != first)
            return result == builtin_void() && source_aggregate_formal(contracts, first, builtin_u64(), no_node(), 0u8);
        val kind <- 0u8;
        for (row in product + 1u64 .. first + arity) {
            kind <- contracts[row].value_kind;
            if (!source_call_scalar(kind) || !source_aggregate_formal(contracts, row, kind, no_node(), 0u8))
                return false
        };
        return true
    };
    val bytes <- first;
    val input <- product - 1u64;
    if (arity == 4u64) {
        val records <- bytes + 1u64;
        if (!checked_readonly_loan_row(contracts[records], array_type(), 0u64)) return false;
        val storage <- published_record_array_storage(contracts, published, contracts[records].type_module,
            contracts[records].type_identity);
        if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) return false
    };
    if (!checked_readonly_loan_row(contracts[bytes], array_type(), 0u64) ||
        !source_scalar_value_row(contracts[input], builtin_u64()) || contracts[input].source_allocates ||
        contracts[input].type_module != 0u64 || contracts[input].type_identity != 0u64) return false;
    val array <- find_interface(contracts, published, contracts[bytes].type_module, contracts[bytes].type_identity);
    return array < published && contracts[array].interface_kind == array_type() &&
        contracts[array].entry_count == 0u64 && contracts[array].array_index_kind == builtin_u64() &&
        contracts[array].element_kind == builtin_u8() &&
        (target_storage == CoDBitsAggregate || (arity == 4u64 && target_storage == CLayoutBitsRecord))
}

func checked_array_inspector_inputs(contracts:const ModuleInterfaces in I, published:UInt64,
    first:UInt64, output:UInt64, owners:UInt64, sum_output:bool) -> bool where {const owner I} {
    ref sum_loan = make bool { false };
    if (!sum_output && checked_readonly_query_inputs(contracts, published, first, output, owners, sum_loan, false))
        return !sum_loan;
    if (owners < 2u64) return false;

    val array_role <- owners - 1u64;
    val past <- output;
    for (unused in first + 1u64 .. output) {
        past <- past - 1u64;
        if (!checked_source_scalar_parameter(contracts, published, past)) {
            return source_aggregate_formal(contracts, past, array_type(), array_role, 0u8) &&
                (if (sum_output) {
                    published_sum_array(contracts, published, contracts[past].type_module, contracts[past].type_identity)
                } else {
                    published_enum_array_header(contracts, published, contracts[past].type_module,
                        contracts[past].type_identity) != no_node()
                }) &&
                checked_readonly_query_inputs(contracts, published, first, past, array_role, sum_loan, false) &&
                !sum_loan
        }
    };
    return false
}

func checked_inspector_scalar_place(row:const ModuleInterfaceRow in R, role:UInt64) -> bool
    where {const owner R} {
    return source_place_scalar(row.value_kind) && row.interface_kind == 0u8 && row.entry_count == 0u64 &&
        row.field_mode == ReferenceFormal && row.owner_role == role &&
        row.type_module == 0u64 && row.type_identity == 0u64 && row.owner_readonly == 0u8 &&
        row.target_readonly == 0u8 && row.native_reception == 0u8 && row.native_passes_owner == 0u8 &&
        !row.source_allocates
}

func inspector_product_before_scalars(contracts:const ModuleInterfaces in I,
    first:UInt64, last:UInt64, role:UInt64) -> UInt64 where {const owner I} {
    val row <- last;
    for (unused in first .. last) {
        row <- row - 1u64;
        if (!checked_inspector_scalar_place(contracts[row], role)) return row
    };
    return no_node()
}

func checked_array_inspector_past(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64, product_output:UInt64 in O) -> UInt64 where {const owner I, owner O} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val arity <- contracts[header].entry_count;
    val result <- contracts[header].result_kind;
    val owner_count <- contracts[header].owner_count;
    if (arity < 2u64 || arity >= published - header || contracts[header].interface_kind != callable_binding() ||
        contracts[header].source_writer != ArrayInspector ||
        contracts[header].callable_kind != CheckedFunction || contracts[header].membership != FixedMethods ||
        contracts[header].native_function != no_node() || contracts[header].target_readonly != 0u8 ||
        owner_count < 2u64 || contracts[header].owner_role != no_node() ||
        contracts[header].has_here != 0u8 || contracts[header].failure_identity != no_node() ||
        contracts[header].failure_module != 0u64 || contracts[header].failure_checked != 0u8 ||
        contracts[header].array_read_completion == NoArrayRead) return no_node();
    if (result == enum_type()) {
        if (!published_enum_domain(contracts, published, header)) return no_node()
    } else {
        if ((result != builtin_bool() && result != builtin_u8() && result != builtin_u64() && result != builtin_void()) ||
            contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64) return no_node()
    };
    val first <- header + 1u64;
    if (!checked_readonly_loan_row(contracts[first], array_type(), 0u64)) return no_node();
    val past <- first + arity;
    if (result == builtin_void()) {
        return if (checked_array_inspector_inputs(contracts, published, first, past, owner_count, true)) {
            past
        } else { no_node() }
    };
    val output <- past - 1u64;
    val output_role <- owner_count - 1u64;
    if (checked_inspector_scalar_place(contracts[output], output_role)) {
        if (checked_array_inspector_inputs(contracts, published, first, output, output_role, false))
            return past;
        if (output_role < 2u64) return no_node();
        output <- inspector_product_before_scalars(contracts, first, output, output_role);
        if (output == no_node()) return no_node();
        (output_role <- output_role - 1u64):void
    };
    if (!source_aggregate_formal(contracts, output, record_type(), output_role, 0u8) ||
        !checked_array_inspector_inputs(contracts, published, first, output, output_role, false)) return no_node();
    val storage <- checked_aggregate_storage(contracts, published, contracts[output].type_module,
        contracts[output].type_identity, record_type());
    if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) return no_node();
    product_output <- output;
    return past
}

func checked_record_writer_past(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> UInt64 where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val count <- contracts[header].entry_count;
    if (count < 2u64 || count >= published - header ||
        contracts[header].source_writer != AggregateWriter || contracts[header].result_kind != builtin_void() ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
        contracts[header].target_readonly != 0u8 || contracts[header].owner_count != 2u64 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion == NoArrayRead)
        return no_node();
    val array <- header + 1u64;
    if (!source_aggregate_formal(contracts, array, array_type(), 0u64, 0u8)) return no_node();
    val past <- header + 1u64 + count;
    val payload <- past - 1u64;
    val second <- array + 1u64;
    val kind <- 0u8;
    if (count >= 3u64 && source_aggregate_formal(contracts, payload, record_type(), 1u64, 1u8)) {
        val storage <- published_record_array_storage(contracts, published,
            contracts[array].type_module, contracts[array].type_identity);
        if ((storage != CLayoutBitsRecord && storage != CoDBitsAggregate) ||
            !published_bits_record(contracts, published, payload) ||
            !source_aggregate_formal(contracts, second, builtin_u64(), no_node(), 0u8)) return no_node();
        for (row in second + 1u64 .. payload) {
            kind <- contracts[row].value_kind;
            if (!source_call_scalar(kind) || !source_aggregate_formal(contracts, row, kind, no_node(), 0u8))
                return no_node()
        };
        return past
    };
    val record <- second;
    if (!source_aggregate_formal(contracts, record, record_type(), 1u64, 0u8) ||
        !published_sum_array(contracts, published, contracts[array].type_module, contracts[array].type_identity) ||
        contracts[record].type_module != contracts[header].defining_module ||
        checked_aggregate_storage(contracts, published, contracts[record].type_module,
            contracts[record].type_identity, record_type()) != CLayoutBitsRecord) return no_node();
    for (row in record + 1u64 .. past) {
        kind <- contracts[row].value_kind;
        if (!source_call_scalar(kind) || !source_aggregate_formal(contracts, row, kind, no_node(), 0u8))
            return no_node()
    };
    return past
}

func preceding_source_loan_row(contracts:const ModuleInterfaces in I, published:UInt64,
    first:UInt64, past:UInt64) -> UInt64 where {const owner I} {
    val row <- no_node();
    for (distance in 0u64 .. past - first) {
        row <- past - 1u64 - distance;
        if (!checked_source_scalar_parameter(contracts, published, row)) return row
    };
    return no_node()
}

func published_workspace_array(contracts:const ModuleInterfaces in I, published:UInt64,
    row:UInt64) -> bool where {const owner I} {
    val module <- contracts[row].type_module;
    val identity <- contracts[row].type_identity;
    val head <- find_interface(contracts, published, module, identity);
    if (head >= published || contracts[head].interface_kind != array_type() ||
        contracts[head].entry_count != 0u64 || contracts[head].array_index_kind != builtin_u64()) return false;
    val element <- contracts[head].element_kind;
    if (element == builtin_u8() || element == builtin_u64() || element == builtin_bool()) return true;
    val storage <- published_record_array_storage(contracts, published, module, identity);
    return storage == CLayoutBitsRecord || storage == CoDBitsAggregate ||
        published_sum_array(contracts, published, module, identity) ||
        published_enum_array_header(contracts, published, module, identity) == head
}

func checked_workspace_writer_past(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64, requires_body:bool in R) -> UInt64 where {const owner I, owner R} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val count <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    val diagnostic_writer <- result == builtin_u8();
    if (count < 2u64 || count >= published - header || owners == 0u64 ||
        contracts[header].source_writer != WorkspaceWriter ||
        (result != builtin_bool() && result != builtin_void() && result != builtin_u64() && !diagnostic_writer) ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
        contracts[header].target_readonly != 0u8 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion == NoArrayRead)
        return no_node();
    val past <- header + 1u64 + count;
    val sum_output <- workspace_sum_output(contracts, published, header);
    val input_past <- if (sum_output == no_node()) { past } else { sum_output };
    val role <- no_node();
    val kind <- 0u8;
    val access <- 0u8;
    val readonly_array <- false;
    val writable_record <- false;
    val scalar_loan <- false;
    val writable_sum_array <- false;
    val report_writer <- result == builtin_void() && count > 2u64 && owners == 2u64 &&
        !contracts[header].array_slot_failures.out_of_memory;
    for (row in header + 1u64 .. input_past) {
        if (!checked_source_scalar_parameter(contracts, published, row)) {
            role <- contracts[row].owner_role;
            kind <- contracts[row].value_kind;
            access <- contracts[row].target_readonly;
            if (role >= owners || access > 1u8) return no_node();
            if (sum_output != no_node() && (kind != array_type() || access != 1u8)) return no_node();
            if (kind == builtin_u64() && checked_inspector_scalar_place(contracts[row], role)) {
                if ((result != builtin_bool() && !diagnostic_writer) || scalar_loan) return no_node();
                (scalar_loan <- true):void
            } else {
                if (!source_aggregate_formal(contracts, row, kind, role, access)) return no_node();
                if (kind == array_type()) {
                    if (!published_workspace_array(contracts, published, row)) return no_node();
                    if (diagnostic_writer && access == 0u8) {
                        if (writable_sum_array || !published_sum_array(contracts, published,
                            contracts[row].type_module, contracts[row].type_identity)) return no_node();
                        (writable_sum_array <- true):void
                    };
                    report_writer <- report_writer && access == 1u8 && !readonly_array;
                    (readonly_array <- readonly_array || access == 1u8):void
                } else {
                    if (diagnostic_writer || kind != record_type() ||
                        !published_bits_record(contracts, published, row)) return no_node();
                    report_writer <- report_writer && access == 0u8 && !writable_record;
                    (writable_record <- true):void
                }
            }
        }
    };
    if (diagnostic_writer && !(writable_sum_array && readonly_array)) return no_node();
    if (sum_output != no_node()) {
        requires_body <- true;
        return if (readonly_array) { past } else { no_node() }
    };
    # A supported report update is available to an already-required body.
    # Its operands do not by themselves require checking an enclosing body.
    requires_body <- !(report_writer && readonly_array && writable_record);
    return past
}

func checked_parser_writer_past(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64, aggregate_loan:bool in S) -> UInt64 where {const owner I, owner S} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val count <- contracts[header].entry_count;
    val owners <- contracts[header].owner_count;
    val result <- contracts[header].result_kind;
    if (owners < 3u64 || count < owners || count >= published - header ||
        contracts[header].source_writer != ParserWriter || (result != builtin_bool() && result != builtin_void()) ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
        contracts[header].target_readonly != 0u8 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion == NoArrayRead)
        return no_node();
    val first <- header + 1u64;
    val past <- first + count;
    val record <- preceding_source_loan_row(contracts, published, first, past);
    if (record == no_node() || !source_aggregate_formal(contracts, record, record_type(), owners - 1u64, 0u8) ||
        checked_aggregate_storage(contracts, published, contracts[record].type_module,
            contracts[record].type_identity, record_type()) != CLayoutBitsRecord) return no_node();
    val output <- preceding_source_loan_row(contracts, published, first, record);
    if (output == no_node() || !source_aggregate_formal(contracts, output, array_type(), owners - 2u64, 0u8))
        return no_node();
    val output_array <- find_interface(contracts, published, contracts[output].type_module, contracts[output].type_identity);
    if (output_array >= published || contracts[output_array].interface_kind != array_type() ||
        contracts[output_array].array_index_kind != builtin_u64()) return no_node();
    if (!checked_readonly_query_inputs(contracts, published, first, output, owners - 2u64, aggregate_loan, true))
        return no_node();
    return past
}

func readonly_array_element(contracts:const ModuleInterfaces in I, published:UInt64, row:UInt64, role:UInt64)
    -> UInt8 where {const owner I} {
    if (!checked_readonly_loan_row(contracts[row], array_type(), role)) return 0u8;
    val array <- find_interface(contracts, published, contracts[row].type_module, contracts[row].type_identity);
    if (array >= published || contracts[array].interface_kind != array_type() ||
        contracts[array].entry_count != 0u64 || contracts[array].array_index_kind != builtin_u64()) return 0u8;
    return contracts[array].element_kind
}

func checked_readonly_query_inputs(contracts:const ModuleInterfaces in I, published:UInt64,
    first:UInt64, past:UInt64, owners:UInt64, aggregate_loan:bool in S, records:bool)
    -> bool where {const owner I, owner S} {
    val role <- 0u64;
    val kind <- 0u8;
    val storage <- UnprovedAggregate;
    val element <- 0u8;
    for (row in first .. past) {
        if (!checked_source_scalar_parameter(contracts, published, row)) {
            kind <- contracts[row].value_kind;
            if (role >= owners || !checked_readonly_loan_row(contracts[row], kind, role)) return false;
            if (kind == sum_type()) {
                if (checked_aggregate_storage(contracts, published, contracts[row].type_module,
                    contracts[row].type_identity, kind) != CoDBitsAggregate) return false;
                (aggregate_loan <- true):void
            } else {
                if (records && kind == record_type()) {
                    if (!published_bits_record(contracts, published, row)) return false;
                    (aggregate_loan <- true):void
                } else {
                    if (kind != array_type()) return false;
                    storage <- published_record_array_storage(contracts, published, contracts[row].type_module, contracts[row].type_identity);
                    if (storage != CoDBitsAggregate && storage != CLayoutBitsRecord &&
                        !published_sum_array(contracts, published, contracts[row].type_module, contracts[row].type_identity) &&
                        published_enum_array_header(contracts, published, contracts[row].type_module, contracts[row].type_identity) == no_node()) {
                        element <- readonly_array_element(contracts, published, row, role);
                        if (element != builtin_u8() && element != builtin_bool()) return false
                    }
                }
            };
            (role <- role + 1u64):void
        }
    };
    return role == owners
}

func checked_readonly_query_past(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64, aggregate_loan:bool in S) -> UInt64 where {const owner I, owner S} {
    aggregate_loan <- false;
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val parameters <- contracts[header].entry_count;
    val result <- contracts[header].result_kind;
    val owner_count <- contracts[header].owner_count;
    val syntax_site_query <- result == builtin_u64() && parameters == 3u64;
    val range_predicate <- result == builtin_bool() && parameters == 4u64;
    val record_key <- (syntax_site_query || range_predicate) && owner_count == 2u64;
    if (parameters >= published - header || owner_count == 0u64 ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].target_readonly != 0u8 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion == NoArrayRead ||
        contracts[header].source_writer != NoSourceWriter) return no_node();
    if (result == enum_type()) {
        if (!published_enum_domain(contracts, published, header)) return no_node()
    } else {
        if ((result != builtin_bool() && result != builtin_u64() && result != builtin_u8()) ||
            contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64) return no_node()
    };
    val first <- header + 1u64;
    val past <- first + parameters;
    if (parameters == 1u64 && owner_count == 1u64 &&
        checked_readonly_loan_row(contracts[first], record_type(), 0u64) &&
        published_bits_record(contracts, published, first)) {
        aggregate_loan <- true;
        return past
    };
    if (checked_readonly_query_inputs(contracts, published, first, past, owner_count, aggregate_loan, false))
        return past;
    aggregate_loan <- false;
    if (!record_key) return no_node();
    if (!source_aggregate_formal(contracts, first, array_type(), 0u64, 1u8)) return no_node();
    val module <- contracts[first].type_module;
    val identity <- contracts[first].type_identity;
    if (!published_sum_array(contracts, published, module, identity)) return no_node();
    val scalar_past <- past - 1u64;
    for (row in first + 1u64 .. scalar_past) {
        if (!source_aggregate_formal(contracts, row, builtin_u64(), no_node(), 0u8)) return no_node()
    };
    if (!checked_readonly_loan_row(contracts[scalar_past], record_type(), 1u64)) return no_node();
    val storage <- checked_aggregate_storage(contracts, published, contracts[scalar_past].type_module,
        contracts[scalar_past].type_identity, record_type());
    if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) return no_node();
    aggregate_loan <- syntax_site_query;
    return past
}

func prepare_imported_query_aggregate_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in W, contracts:const ModuleInterfaces in I,
    published:UInt64, aggregate:const AggregateFacts in A, cases:ConstructorCaseFacts in C,
    arguments:UInt64, first:UInt64, past:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner I, const owner A, owner C} {
    ref argument = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, arguments, ArgumentSequence, argument)) return false;
    val kind <- 0u8;
    for (row in first .. past) {
        if (argument >= used) return false;
        kind <- contracts[row].value_kind;
        if (kind == sum_type() || kind == record_type()) {
            prepare_imported_indexed_loan(nodes, names, selected, contracts, published,
                aggregate, cases, argument, used, revision, kind, false)
        };
        (argument <- links[argument].next):void
    };
    return argument == no_node()
}

func checked_readonly_reader_past(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64)
    -> UInt64 where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val output <- contracts[header].result_kind;
    if (output != builtin_bool() && output != builtin_u8() && output != builtin_u64()) return no_node();
    val parameters <- contracts[header].entry_count;
    val text_predicate <- output == builtin_bool() && parameters == 2u64;
    if (published - header <= parameters ||
        (!text_predicate && (parameters < 4u64 || (output != builtin_bool() && parameters != 4u64))) ||
        contracts[header].interface_kind != callable_binding() || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods || contracts[header].native_function != no_node() ||
        contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
        contracts[header].target_readonly != 0u8 || contracts[header].owner_count != 2u64 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64 ||
        contracts[header].failure_checked != 0u8 ||
        (contracts[header].array_read_completion != CheckedArrayRead &&
         contracts[header].array_read_completion != ArrayReadMayFailBounds)) return no_node();
    val bytes <- header + 1u64;
    val second <- header + 2u64;
    if (readonly_array_element(contracts, published, bytes, 0u64) != builtin_u8()) return no_node();
    val past <- header + 1u64 + parameters;
    if (text_predicate) {
        if (!checked_readonly_loan_row(contracts[second], record_type(), 1u64) ||
            checked_aggregate_storage(contracts, published, contracts[second].type_module,
                contracts[second].type_identity, record_type()) != CoDBitsAggregate) return no_node()
    } else {
        if (!checked_readonly_loan_row(contracts[second], array_type(), 1u64) ||
            !published_record_array(contracts, published, contracts[second].type_module,
                contracts[second].type_identity)) return no_node();
        if (!source_aggregate_formal(contracts, second + 1u64, builtin_u64(), no_node(), 0u8) ||
            !source_aggregate_formal(contracts, second + 2u64, builtin_u64(), no_node(), 0u8)) return no_node();
        val kind <- 0u8;
        for (row in second + 3u64 .. past) {
            kind <- contracts[row].value_kind;
            if (!source_call_scalar(kind) || !source_aggregate_formal(contracts, row, kind, no_node(), 0u8))
                return no_node()
        }
    };
    return past
}

func checked_array_reader_header(contracts:const ModuleInterfaces in I, published:UInt64, header:UInt64) -> bool
    where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts) ||
        published - header <= 3u64 || contracts[header].entry_count != 3u64 ||
        contracts[header].interface_kind != callable_binding() ||
        contracts[header].callable_kind != CheckedFunction ||
        contracts[header].membership != FixedMethods ||
        contracts[header].native_function != no_node() ||
        contracts[header].owner_count != 1u64 || contracts[header].owner_role != no_node() ||
        contracts[header].has_here != 0u8 || contracts[header].target_readonly != 0u8 ||
        contracts[header].failure_identity != no_node() ||
        contracts[header].failure_module != 0u64 || contracts[header].failure_checked != 0u8 ||
        (contracts[header].array_read_completion != CheckedArrayRead &&
         contracts[header].array_read_completion != ArrayReadMayFailBounds)) return false;
    val enum_result <- contracts[header].result_kind == enum_type();
    if (enum_result) {
        val result <- find_interface(contracts, published, contracts[header].type_module,
            contracts[header].type_identity);
        if (result == no_node() || contracts[result].interface_kind != enum_type()) return false
    } else {
        if (contracts[header].result_kind != builtin_u64() || contracts[header].type_module != 0u64 ||
            contracts[header].type_identity != 0u64) return false
    };
    val first <- header + 1u64;
    if (contracts[header].source_numeric_fault ||
        !checked_readonly_loan_row(contracts[first], array_type(), 0u64)) return false;
    val array <- find_interface(contracts, published, contracts[first].type_module,
        contracts[first].type_identity);
    if (array == no_node() || contracts[array].interface_kind != array_type() ||
        contracts[array].entry_count != 0u64 ||
        contracts[array].element_kind != (if (enum_result) { builtin_u8() } else { sum_type() })) return false;
    if (!enum_result && (contracts[array].array_index_kind != builtin_u64() ||
        contracts[first].type_module != contracts[header].defining_module)) return false;
    for (row in first + 1u64 .. first + 3u64) {
        if (!source_scalar_value_row(contracts[row], builtin_u64())) return false
    };
    return true
}

export func mark_literal_source_bodies(views:const SuppliedViews in V, exports:const ModuleExports in E, export_count:UInt64,
    contracts:ModuleInterfaces in I, count:UInt64, module:UInt64, used:UInt64)
    -> bool where {const owner V, const owner E, owner I} {
    if (count > intrinsic (len)(contracts) || export_count > intrinsic (len)(exports) ||
        used > intrinsic (len)(views)) return false;
    val definition <- no_node();
    val kind <- 0u8;
    val header <- no_node();
    for (row in 0u64 .. export_count) {
        if (exports[row].publishing_module == module && exports[row].origin_module == module &&
            exports[row].kind == callable_export() && exports[row].shape == ordinary_callable_shape() &&
            exports[row].checked == 0u8) {
            definition <- exports[row].identity;
            if (definition >= used) return false;
            kind <- completed_niladic_source_kind(views, definition);
            if (kind != 0u8) {
                header <- find_interface(contracts, count, module, definition);
                if (header >= count || contracts[header].interface_kind != callable_binding() ||
                    contracts[header].value_kind != 0u8 ||
                    contracts[header].membership != FixedMethods ||
                    contracts[header].callable_kind != CheckedFunction ||
                    contracts[header].entry_count != 0u64 || contracts[header].owner_count != 0u64 ||
                    contracts[header].has_here != 0u8 || contracts[header].native_function != no_node() ||
                    contracts[header].owner_role != no_node() || contracts[header].target_readonly != 0u8 ||
                    contracts[header].type_module != 0u64 || contracts[header].type_identity != 0u64 ||
                    (contracts[header].failure_identity != 0u64 && contracts[header].failure_identity != no_node()) ||
                    contracts[header].failure_module != 0u64 ||
                    contracts[header].failure_checked != 0u8 || contracts[header].array_read_completion != NoArrayRead ||
                    contracts[header].result_kind != kind)
                    return false;
                # The structural header starts with zero in this slot. The
                # checked source-call header encodes absence with no_node().
                contracts[header].failure_identity <- no_node();
                (contracts[header].scalar_source_body <- true):void
            }
        }
    };
    return true
}

# This is a complete published family view. Its rows are signatures, not
# prepared operands. The demanded caller will select against its one actual.
func array_length_family_past(contracts:const ModuleInterfaces in I, published:UInt64,
    visits:const Visits in G, visit_count:UInt64, header:UInt64, module:UInt64) -> UInt64
    where {const owner I, const owner G} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val entries <- contracts[header].entry_count;
    if (entries == 0u64 || entries >= published - header ||
        contracts[header].interface_kind != array_length_family_interface() ||
        contracts[header].membership != FixedMethods || contracts[header].callable_kind != CheckedFunction ||
        contracts[header].result_kind != builtin_u64() || contracts[header].owner_count != 1u64 ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].native_function != no_node() || contracts[header].failure_identity != no_node() ||
        contracts[header].failure_module != 0u64 || contracts[header].failure_checked != 0u8)
        return no_node();
    val last <- header + entries;
    if (!contains_checked_interface(visits, visit_count, module, header, published) ||
        !contains_checked_interface(visits, visit_count, module, last, published)) return no_node();
    val past <- last + 1u64;
    for (row in header + 1u64 .. past) {
        if (contracts[row].defining_module != module || contracts[row].declaration == no_node() ||
            contracts[row].interface_kind != 0u8 || contracts[row].entry_count != 0u64 ||
            contracts[row].value_kind != array_type() || contracts[row].field_mode != ReferenceFormal ||
            contracts[row].type_module == 0u64 || contracts[row].type_module == no_node() ||
            contracts[row].type_identity == no_node() || contracts[row].owner_role != 0u64 ||
            contracts[row].target_readonly != 1u8 || contracts[row].owner_readonly != 1u8 ||
            contracts[row].native_reception != 0u8 || contracts[row].native_passes_owner != 0u8 ||
            contracts[row].source_allocates)
            return no_node()
    };
    return past
}

# Slot-interface roles name the first borrowed formal of each owner. A ref var
# row promises the same non-null nominal target contract on every exit, allowing
# any prepared slot to rebind. There is no promise of an unchanged backing.
func checked_array_slot_call_past(contracts:const ModuleInterfaces in I, published:UInt64,
    header:UInt64, module:UInt64, definition:UInt64) -> UInt64 where {const owner I} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val arity <- contracts[header].entry_count;
    val result <- contracts[header].result_kind;
    if (!contracts[header].array_slot_checked || contracts[header].defining_module != module ||
        contracts[header].declaration != definition || contracts[header].interface_kind != callable_binding() ||
        contracts[header].native_function != no_node() || contracts[header].membership != FixedMethods ||
        contracts[header].callable_kind == NoCallableKind || arity == 0u64 || arity >= published - header ||
        contracts[header].owner_role != no_node() || contracts[header].has_here != 0u8 ||
        contracts[header].target_readonly != 0u8) return no_node();
    if (result == enum_type()) {
        if (!published_enum_domain(contracts, published, header)) return no_node()
    } else {
        if (result != builtin_void() && !source_call_scalar(result)) return no_node()
    };
    val count <- 0u64;
    val has_slot <- false;
    val first <- header + 1u64;
    val row <- first;
    val mode <- ValueFormal;
    val role <- no_node();
    val kind <- 0u8;
    for (position in 0u64 .. arity) {
        row <- first + position;
        mode <- contracts[row].field_mode;
        role <- contracts[row].owner_role;
        kind <- contracts[row].value_kind;
        if (contracts[row].defining_module != module || contracts[row].declaration != definition ||
            contracts[row].interface_kind != 0u8 || contracts[row].entry_count != 0u64 ||
            contracts[row].native_passes_owner != 0u8 || contracts[row].native_reception != 0u8 ||
            contracts[row].target_readonly > 1u8 || contracts[row].owner_readonly > 1u8 ||
            contracts[row].slot_target_invariant != (mode == ReferenceSlotFormal)) return no_node();
        if (mode == ValueFormal || mode == ExplicitValueFormal) {
            if (!source_call_scalar(kind) || !source_scalar_value_row(contracts[row], kind) ||
                contracts[row].source_allocates) return no_node()
        } else {
            if (role > position || contracts[first + role].owner_role != role ||
                contracts[first + role].owner_readonly != contracts[row].owner_readonly ||
                contracts[first + role].source_allocates != contracts[row].source_allocates ||
                (contracts[row].source_allocates && contracts[row].owner_readonly != 0u8)) return no_node();
            if (position == role) { (count <- count + 1u64):void };
            if (mode == ReferenceSlotFormal) {
                if (kind != array_type() || contracts[row].target_readonly != 0u8 ||
                    !has_nominal_identity(contracts[row])) return no_node();
                (has_slot <- true):void
            } else {
                if (mode == HandleFormal) {
                    if (kind != c_handle_type() || !has_nominal_identity(contracts[row])) return no_node()
                } else {
                    if (mode != ReferenceFormal) return no_node();
                    if (kind == array_type()) {
                        if (!has_nominal_identity(contracts[row])) return no_node()
                    } else {
                        if (kind == record_type()) {
                            if (!published_array_field_record(contracts, published,
                                    contracts[row].type_module, contracts[row].type_identity) &&
                                (!checked_readonly_loan_row(contracts[row], kind, role) ||
                                 !published_bits_record(contracts, published, row))) return no_node()
                        } else {
                            if (kind != builtin_u64() && kind != builtin_u8() && kind != builtin_bool())
                                return no_node()
                        }
                    }
                }
            }
        }
    };
    return if (has_slot && count == contracts[header].owner_count) { first + arity } else { no_node() }
}

func source_text_family_past(contracts:const ModuleInterfaces in I, published:UInt64,
    visits:const Visits in G, visit_count:UInt64, header:UInt64, module:UInt64) -> UInt64
    where {const owner I, const owner G} {
    val count <- contracts[header].entry_count;
    if (count == 0u64 || count >= published - header || contracts[header].membership != FixedMethods ||
        contracts[header].callable_kind != CheckedProcedure ||
        !contains_checked_interface(visits, visit_count, module, header, published) ||
        !contains_checked_interface(visits, visit_count, module, header + count, published)) return no_node();
    return header + 1u64 + count
}

func prepare_imported_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, links:NameWork in L,
                            contracts:const ModuleInterfaces in I, interface_count:UInt64,
                            catalog:const ModuleExports in C, views:const CallableUseProofs in U,
                            supplied:SuppliedViews in H, aggregate:const AggregateFacts in A, cases:ConstructorCaseFacts in F,
                            visits:const Visits in G, visit_count:UInt64,
                            used:UInt64, revision:UInt64, source_only:bool, required:UInt64 in D,
                            at:UInt64, call:const DirectCallSites in V,
                                report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner L, const owner I, const owner C,
           const owner U, const owner G, owner H, const owner A, owner F, owner D, const owner V, owner R} {
    val callee <- call.callee;
    val target <- names[callee].declaration;
    val generic <- if (names[callee].kind == callable_binding()) {
        target < used && names[target].kind == generic_method_binding()
    } else {
        names[callee].kind == ordinary_selection() && target < used && selected[target].kind == generic_callable_export()
    };
    if (generic) {
        val scope <- enclosing_callable(nodes, names, names[at].scope);
        if (scope < used && uninstantiated_method(names[scope].kind)) return true;
        if (!source_only || names[callee].kind != ordinary_selection() ||
            !direct_source_using(nodes, selected[target].selection_site, used, revision))
            return operand_problem(report, at, unsupported_generic_type());
        val origin <- selected[target].origin_module;
        val head <- find_interface(contracts, interface_count, origin, selected[target].identity);
        if (head == no_node() || contracts[head].interface_kind != generic_callable_interface())
            return operand_problem(report, at, unsupported_generic_type());
        val past <- head + 1u64 + contracts[head].entry_count;
        if (!contains_checked_interface(visits, visit_count, origin, head, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin, past - 1u64, interface_count))
            return operand_problem(report, at, unsupported_generic_type());
        supplied[at] <- make BoundGenericCall { header <- head; past <- past; arguments <- call.arguments };
        if (required == no_node()) { (required <- at):void };
        return true
    };
    if (names[callee].kind != ordinary_selection()) return true;
    val site <- names[callee].declaration;
    if (selected[site].kind != callable_export()) return true;
    val slot_call <- selected[site].shape == array_slot_callable_shape();
    if (!slot_call && selected[site].shape != ordinary_callable_shape()) return true;
    val obligation <- selected[site].checked != 0u8;
    val origin_module <- selected[site].origin_module;
    val header <- find_interface(contracts, interface_count, origin_module, selected[site].identity);
    if (slot_call) {
        if (!source_only || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision))
            return operand_problem(report, at, unsupported_imported_slot_call());
        val slot_past <- checked_array_slot_call_past(contracts, interface_count, header,
            origin_module, selected[site].identity);
        if (slot_past == no_node() || !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, slot_past - 1u64, interface_count) ||
            obligation != (contracts[header].failure_identity != no_node()))
            return operand_problem(report, at, unsupported_imported_slot_call());
        if (obligation && !valid_imported_failure(contracts, interface_count, catalog,
            contracts[header].failure_module, contracts[header].failure_identity,
            contracts[header].failure_checked))
            return operand_problem(report, at, unsupported_imported_slot_call());
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, true, true))
            return operand_problem(report, at, wrong_argument_count());
        remember_imported_call(links, contracts, at, header, true);
        if (contracts[header].result_kind == enum_type()) {
            links[at].imported_type_module <- contracts[header].type_module;
            (links[at].imported_type_identity <- contracts[header].type_identity):void
        };
        supplied[at] <- make CheckedImportedArraySlotCall { failures <- contracts[header].array_slot_failures };
        if (required == no_node()) { (required <- at):void };
        return true
    };
    if (source_only && header != no_node() &&
        contracts[header].interface_kind == array_length_family_interface()) {
        if (obligation || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision)) return true;
        val length_past <- array_length_family_past(contracts, interface_count, visits, visit_count, header, origin_module);
        ref length_entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
        val length_argument <- call.arguments;
        if (length_past != no_node() && length_argument < at &&
            inspect_sequence_entry(nodes, revision, used, length_argument, length_entry) == ArgumentSequence &&
            length_entry.previous == no_node() && length_entry.item < length_argument &&
            !checked_ref_argument(nodes, length_argument)) {
            (supplied[at] <- make ImportedArrayLengthCall {
                first <- header + 1u64; past <- length_past; argument <- length_argument; input <- length_entry.item
            }):void
        };
        return true
    };
    if (source_only && header != no_node() && contracts[header].interface_kind == text_writer_family_interface()) {
        val count <- contracts[header].entry_count;
        if (obligation || count == 0u64 || count >= interface_count - header ||
            selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            contracts[header].membership != FixedMethods || contracts[header].result_kind != builtin_void() ||
            contracts[header].callable_kind == NoCallableKind ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, header + count, interface_count))
            return operand_problem(report, at, unsupported_imported_call());
        supplied[at] <- make ImportedTextWriterCall { family <- header; past <- header + count + 1u64 };
        if (required == no_node()) { (required <- at):void };
        return true
    };
    if (source_only && header != no_node() && contracts[header].interface_kind == source_text_family_interface()) {
        if (obligation || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision)) return true;
        val text_family_past <- source_text_family_past(contracts, interface_count, visits, visit_count, header, origin_module);
        if (text_family_past != no_node()) {
            supplied[at] <- make ImportedSourceTextCall { family <- header; first <- header + 1u64; past <- text_family_past };
            if (required == no_node()) { (required <- at):void }
        };
        return true
    };
    if (source_only && header != no_node() && contracts[header].interface_kind == callable_binding() &&
        (case contracts[header].payload of { CheckedTextReceiver -> true; CheckedLocalTextRoutine -> true; _ -> false })) {
        val signature_count <- contracts[header].entry_count;
        if (obligation || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            signature_count >= interface_count - header || contracts[header].membership != FixedMethods ||
            contracts[header].callable_kind != CheckedProcedure || contracts[header].has_here != 0u8 ||
            contracts[header].failure_identity != no_node() || contracts[header].owner_count > signature_count ||
            (contracts[header].result_kind != builtin_bool() && contracts[header].result_kind != builtin_void()) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, header + signature_count, interface_count))
            return operand_problem(report, at, unsupported_imported_call());
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        remember_imported_call(links, contracts, at, header, true);
        supplied[at] <- make ImportedSourceTextCall { family <- header; first <- header; past <- header + 1u64 };
        if (required == no_node()) { (required <- at):void };
        return true
    };
    val handles <- source_only && source_handle_call(contracts, interface_count, header);
    val array_read <- source_only && header != no_node() && contracts[header].array_read_completion != NoArrayRead;
    if (source_only && header != no_node() && contracts[header].scalar_source_body &&
        (contracts[header].entry_count != 0u64 || contracts[header].result_kind == builtin_bool())) {
        val scalar_past <- checked_parameterized_scalar_past(contracts, interface_count, header);
        if (obligation || scalar_past == no_node() || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, scalar_past - 1u64, interface_count))
            return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        remember_imported_call(links, contracts, at, header, true);
        val unary_byte_predicate <- contracts[header].result_kind == builtin_bool() &&
            contracts[header].entry_count == 1u64 && contracts[header + 1u64].value_kind == builtin_u8() &&
            !contracts[header].source_numeric_fault;
        if (!unary_byte_predicate) {
            links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
            supplied[at] <- make CheckedScalarFunctionCall {};
            if (required == no_node()) { (required <- at):void }
        } else {
            # An already-demanded body can use this predicate's completed effects.
            (supplied[at] <- make CheckedScalarPredicateCall {}):void
        };
        return true
    };
    if (source_only && header != no_node() && contracts[header].scalar_source_body) {
        if (obligation || handles || array_read) return operand_problem(report, at, unsupported_imported_call());
        # Preparation precedes body demand. An unmatched header leaves no call evidence.
        if (!checked_source_call(contracts, interface_count, header) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            contracts[header].membership != FixedMethods || contracts[header].callable_kind != CheckedFunction ||
            contracts[header].entry_count != 0u64 || contracts[header].failure_identity != no_node() ||
            contracts[header].failure_module != 0u64 || contracts[header].failure_checked != 0u8 ||
            (contracts[header].result_kind != builtin_u8() && contracts[header].result_kind != builtin_u64()) ||
            !bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, false))
            return true;
        remember_imported_call(links, contracts, at, header, true);
        (supplied[at] <- make CheckedLiteralCall {}):void;
        return true
    };
    if (source_only && header != no_node() && contracts[header].source_writer == ProductWriter) {
        if (obligation || !checked_product_writer_header(contracts, interface_count, header) ||
            selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, header + contracts[header].entry_count, interface_count))
            return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        val output_only <- contracts[header].owner_count == 1u64;
        val output <- if (output_only) {
            ref first_output_actual = make UInt64 { no_node() };
            if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, first_output_actual))
                return operand_problem(report, at, invalid_operand_tree());
            argument_at_position(links, first_output_actual, product_writer_output(contracts, header) - header - 1u64)
        } else { call.arguments };
        prepare_imported_indexed_loan(nodes, names, selected, contracts, interface_count,
            aggregate, cases, output, used, revision, record_type(), true);
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        val output_place <- ordinary_argument_value(nodes, used, revision, output);
        val inline_output <- output_place < intrinsic (len)(cases) &&
            (case cases[output_place] of { InlineProductField -> true; _ -> false });
        if (output_only || contracts[header].entry_count == 3u64 || inline_output) {
            supplied[at] <- make ImportedProductWriter {};
            if (required == no_node()) { (required <- at):void }
        } else {
            (supplied[at] <- make CheckedWriterCall {}):void
        };
        return true
    };
    if (source_only && header != no_node() && contracts[header].source_writer == AggregateWriter) {
        val has_payload <- links[site].selected_aggregate_writer == header;
        val only_array_output <- has_payload && contracts[header].owner_count == 2u64;
        val writer_past <- if (has_payload) { header + 1u64 + contracts[header].entry_count } else {
            checked_record_writer_past(contracts, interface_count, header)
        };
        if (obligation || writer_past == no_node() || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, writer_past - 1u64, interface_count))
            return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        val readonly_record <- !has_payload && contracts[writer_past - 1u64].value_kind == record_type() &&
            contracts[writer_past - 1u64].target_readonly == 1u8;
        if (!only_array_output) {
            if (readonly_record) {
                prepare_imported_indexed_loan(nodes, names, selected, contracts, interface_count,
                    aggregate, cases, call.arguments, used, revision, record_type(), false)
            } else {
                ref first_writer_actual = make UInt64 { no_node() };
                if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, first_writer_actual) ||
                    first_writer_actual >= at)
                    return operand_problem(report, at, invalid_operand_tree());
                prepare_imported_indexed_loan(nodes, names, selected, contracts, interface_count,
                    aggregate, cases, links[first_writer_actual].next, used, revision, record_type(), true)
            }
        };
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        if (only_array_output) {
            (supplied[at] <- make CheckedSumWriterCall {}):void
        } else {
            if (readonly_record) {
                (supplied[at] <- make CheckedArrayCall { allocates <- false }):void
            } else {
                (supplied[at] <- make CheckedWriterCall {}):void
            }
        };
        if ((only_array_output || readonly_record) && required == no_node()) { (required <- at):void };
        return true
    };
    if (source_only && header != no_node() && contracts[header].source_writer == ArrayInspector) {
        ref product = make UInt64 { no_node() };
        val inspector_past <- checked_array_inspector_past(contracts, interface_count, header, product);
        if (obligation || inspector_past == no_node() ||
            selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, inspector_past - 1u64, interface_count)) return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        val indexed_output <- false;
        if (product != no_node()) {
            ref product_entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
            ref index = make IndexSites { target <- no_node(); index <- no_node() };
            ref first_inspector_actual = make UInt64 { no_node() };
            if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, first_inspector_actual))
                return operand_problem(report, at, invalid_operand_tree());
            val product_actual <- argument_at_position(links, first_inspector_actual, product - header - 1u64);
            if (inspect_sequence_entry(nodes, revision, used, product_actual, product_entry) != ArgumentSequence)
                return operand_problem(report, at, invalid_operand_tree());
            if (inspect_index_selection(nodes, revision, used, product_entry.item, index)) {
                prepare_imported_indexed_loan(nodes, names, selected, contracts, interface_count,
                    aggregate, cases, product_actual, used, revision, record_type(), true);
                (indexed_output <- true):void
            }
        };
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_type_module <- contracts[header].type_module;
        links[at].imported_type_identity <- contracts[header].type_identity;
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        val allocates <- contracts[header].array_slot_failures.out_of_memory;
        val sum_output <- contracts[header].result_kind == builtin_void();
        if (allocates || sum_output) {
            (supplied[at] <- make CheckedArrayCall { allocates <- allocates }):void
        } else {
            if (indexed_output) {
                (supplied[at] <- make ImportedProductWriter {}):void
            } else {
                (supplied[at] <- make CheckedWriterCall {}):void
            }
        };
        if ((allocates || sum_output || indexed_output) && required == no_node()) { (required <- at):void };
        return true
    };
    if (source_only && header != no_node() && contracts[header].source_writer == WorkspaceWriter) {
        ref requires_body = make bool { true };
        val workspace_past <- checked_workspace_writer_past(contracts, interface_count, header, requires_body);
        if (obligation || workspace_past == no_node() || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, workspace_past - 1u64, interface_count)) return true;
        if (!requires_body) {
            ref first_report_argument = make UInt64 { no_node() };
            if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, first_report_argument)) return true;
            val workspace_count <- contracts[header].entry_count;
            val last_report_argument <- argument_at_position(links, first_report_argument, workspace_count - 1u64);
            if (last_report_argument == no_node() || links[last_report_argument].next != no_node()) return true;
        };
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        val workspace_allocates <- contracts[header].array_slot_failures.out_of_memory;
        supplied[at] <- make CheckedWorkspaceWriterCall { allocates <- workspace_allocates; requires_body <- requires_body };
        if (requires_body && required == no_node()) { (required <- at):void };
        return true
    };
    if (source_only && header != no_node() && contracts[header].source_writer == ParserWriter) {
        ref parser_aggregate_loan = make bool { false };
        val parser_past <- checked_parser_writer_past(contracts, interface_count, header, parser_aggregate_loan);
        if (obligation || parser_past == no_node() || selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, parser_past - 1u64, interface_count)) return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        (supplied[at] <- make CheckedParserWriterCall { inline_input <- parser_aggregate_loan }):void;
        return true
    };
    if (array_read && contracts[header].callable_kind == CheckedProcedure) {
        val procedure_past <- checked_array_procedure_past(contracts, interface_count, header);
        if (procedure_past != no_node()) {
            if (obligation || selected[site].dependency_module != origin_module ||
                !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
                !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
                !contains_checked_interface(visits, visit_count, origin_module, procedure_past - 1u64, interface_count)) return true;
            if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, true, true))
                return operand_problem(report, at, wrong_argument_count());
            remember_imported_call(links, contracts, at, header, true);
            links[at].imported_type_module <- contracts[header].type_module;
            links[at].imported_type_identity <- contracts[header].type_identity;
            links[at].imported_array_read_completion <- contracts[header].array_read_completion;
            links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
            (supplied[at] <- make CheckedArrayCall {
                allocates <- contracts[header].array_slot_failures.out_of_memory
            }):void;
            if (required == no_node()) { (required <- at):void };
            return true
        }
    };
    if (array_read) {
        ref aggregate_loan = make bool { false };
        val query_past <- checked_readonly_query_past(contracts, interface_count, header, aggregate_loan);
        if (query_past != no_node()) {
            if (obligation || selected[site].dependency_module != origin_module ||
                !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
                !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
                !contains_checked_interface(visits, visit_count, origin_module, query_past - 1u64, interface_count)) return true;
            if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
                return operand_problem(report, at, wrong_argument_count());
            if (aggregate_loan && !prepare_imported_query_aggregate_loans(nodes, names, selected, links, contracts, interface_count,
                aggregate, cases, call.arguments, header + 1u64, query_past, used, revision))
                return operand_problem(report, at, invalid_operand_tree());
            remember_imported_call(links, contracts, at, header, true);
            links[at].imported_type_module <- contracts[header].type_module;
            links[at].imported_type_identity <- contracts[header].type_identity;
            links[at].imported_array_read_completion <- contracts[header].array_read_completion;
            links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
            supplied[at] <- make CheckedReadonlyCall { aggregate_loan <- aggregate_loan };
            if (aggregate_loan && required == no_node()) { (required <- at):void };
            return true
        }
    };
    val scalar_reader <- array_read && contracts[header].result_kind == builtin_u64();
    val boolean_reader <- array_read && contracts[header].result_kind == builtin_bool();
    val text_predicate <- boolean_reader && contracts[header].entry_count == 2u64;
    val indexed_reader <- array_read &&
        (contracts[header].result_kind == builtin_u8() ||
         (scalar_reader && contracts[header].entry_count == 4u64) ||
         (boolean_reader && contracts[header].entry_count >= 4u64));
    if (text_predicate || indexed_reader) {
        val reader_past <- checked_readonly_reader_past(contracts, interface_count, header);
        if (obligation || reader_past == no_node() ||
            selected[site].dependency_module != origin_module ||
            !direct_source_using(nodes, selected[site].selection_site, used, revision) ||
            !contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
            !contains_checked_interface(visits, visit_count, origin_module, reader_past - 1u64, interface_count))
            return true;
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used, revision, false, true))
            return operand_problem(report, at, wrong_argument_count());
        if (text_predicate) {
            ref first_predicate_actual = make UInt64 { no_node() };
            if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, first_predicate_actual) ||
                first_predicate_actual >= at)
                return operand_problem(report, at, invalid_operand_tree());
            prepare_imported_indexed_loan(nodes, names, selected, contracts, interface_count,
                aggregate, cases, links[first_predicate_actual].next, used, revision, record_type(), false)
        };
        remember_imported_call(links, contracts, at, header, true);
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_numeric_fault <- contracts[header].source_numeric_fault;
        (supplied[at] <- make CheckedReadonlyCall { aggregate_loan <- false }):void;
        return true
    };
    if (array_read && (obligation || !checked_array_reader_header(contracts, interface_count, header) ||
        (scalar_reader &&
            (!contains_checked_interface(visits, visit_count, origin_module, header, interface_count) ||
             !contains_checked_interface(visits, visit_count, origin_module, header + 3u64, interface_count))) ||
        selected[site].dependency_module != origin_module ||
        !direct_source_using(nodes, selected[site].selection_site, used, revision))) {
        if (scalar_reader) return true;
        return operand_problem(report, at, unsupported_imported_call())
    };
    val source_here <- source_only && links[at].expects_here == 1u8 && links[at].active != no_node();
    if (source_only && !obligation && !handles && !array_read && !source_here) return true;
    if (header == no_node() || contracts[header].interface_kind != callable_binding()) {
        if (obligation || !source_only) return operand_problem(report, at, unsupported_imported_call());
        return true
    };
    if (obligation && !valid_imported_failure(contracts, interface_count, catalog,
            contracts[header].failure_module, contracts[header].failure_identity,
                contracts[header].failure_checked))
        return operand_problem(report, at, unsupported_imported_call());
    if (handles && !obligation &&
        (contracts[header].failure_identity != no_node() || contracts[header].failure_module != 0u64
            ||
         contracts[header].failure_checked != 0u8))
        return operand_problem(report, at, unsupported_imported_call());
    if (!source_only && !matches_object_call(views, selected[site].checked_resource,
        revision, selected[site].selection_site, selected[site].selection_public_row,
        selected[site].dependency_module, origin_module, selected[site].identity,
        contracts[header].native_function)) return operand_problem(report, at, unproved_call_target());
    if (source_only && contracts[header].has_here == 1u8) {
        if (links[at].expects_here != 1u8 || links[at].active == no_node())
            return operand_problem(report, at, unsupported_imported_call())
    } else {
        if (source_only && !handles && !array_read && !checked_source_call(contracts, interface_count, header))
            return operand_problem(report, at, unsupported_imported_call());
        if (!handles && !array_read && !valid_ordinary_enum_rows(contracts, interface_count, header))
            return operand_problem(report, at, unsupported_imported_call());
        if (!bind_imported_call(nodes, links, contracts, at, header, call.arguments, used,
            revision, handles, array_read))
            return operand_problem(report, at, wrong_argument_count())
    };
    remember_imported_call(links, contracts, at, header, handles || scalar_reader);
    if (array_read) {
        links[at].imported_array_read_completion <- contracts[header].array_read_completion;
        links[at].imported_type_module <- contracts[header].type_module;
        links[at].imported_type_identity <- contracts[header].type_identity;
        if (scalar_reader) { (supplied[at] <- make CheckedArrayReaderCall {}):void }
    };
    if ((obligation || source_here || (array_read && !scalar_reader)) && required == no_node()) { (required <- at):void };
    return true
}

# Calls use this receipt only after ordinary operand preparation has
# established the types and access at the written argument sites.
export func preserves_text_installations(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    used:UInt64, revision:UInt64, at:UInt64) -> bool where {const owner N, const owner F} {
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, at, call) != DirectInvocationReady) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    val argument <- call.arguments;
    val input <- no_node();
    for (unused in 0u64 .. used) {
        if (argument == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence) return false;
        input <- entry.item;
        if (!plain_text_operand(nodes, input)) {
            if (!inspect_field_selection(nodes, revision, used, input, field) ||
                (facts[field.receiver].kind != product_kind() && facts[field.receiver].kind != source_product_loan()) ||
                facts[field.receiver].reception != borrowed_ref() || !scalar_kind(facts[input].kind)) return false;
            if (name_syntax(nodes, used, field.receiver) != OrdinaryName &&
                (!facts[field.receiver].checks_array_bounds ||
                 !inspect_index_selection(nodes, revision, used, field.receiver, indexed) ||
                 name_syntax(nodes, used, indexed.target) != OrdinaryName ||
                 !plain_text_operand(nodes, indexed.index))) return false
        };
        (argument <- entry.previous):void
    };
    return false
}

# Bind installation candidates to their original block entries. The checked
# completion and operand rows determine their reached uses.
func prepare_text_installation(nodes:const ExprNodes in N, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void where {const owner N, owner V} {
    if (!(case nodes[at] of {
        Occupied { val syntax <- node, } -> case syntax.payload of { BlockItem -> true; _ -> false };
        _ -> false
    })) return;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (inspect_sequence_entry(nodes, revision, used, at, entry) != BlockSequence) return;
    val operation <- entry.item;
    case nodes[operation] of {
        Occupied { val syntax <- node, } -> {
            case syntax.payload of {
                BindSymbolEffect { val name <-, val input <-, } -> {
                    if (published_syntax_id(nodes, revision, operation, name) &&
                        published_syntax_id(nodes, revision, operation, input) && plain_text_operand(nodes, input.index)) {
                        (views[at] <- make PreparedTextInstallation {
                            operation <- operation; name <- name.index; input <- input.index; previous <- entry.previous
                        }):void
                    }
                };
                _ -> {}
            }
        };
        _ -> {}
    };
    return
}

export func prepare_imported_calls(nodes:const ExprNodes in N, names:const NameBindings in B,
                                  selected:const SelectedExports in E, links:NameWork in L,
                                  contracts:const ModuleInterfaces in I, interface_count:UInt64,
                                  catalog:const ModuleExports in C, views:const CallableUseProofs in V,
                                  supplied:SuppliedViews in H, aggregate:const AggregateFacts in A, cases:ConstructorCaseFacts in F,
                                  visits:const Visits in G, visit_count:UInt64,
                                  used:UInt64, revision:UInt64, source_only:bool, required:UInt64 in D,
                                  report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner L, const owner I, const owner C, const owner V,
        const owner G, owner H, const owner A, owner F, owner D, owner R} {
    required <- no_node();
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    for (at in 0u64 .. used) {
        if (source_only) { prepare_text_installation(nodes, supplied, at, used, revision) };
        if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady &&
            !prepare_imported_call(nodes, names, selected, links, contracts, interface_count,
                catalog, views, supplied, aggregate, cases, visits, visit_count, used, revision, source_only, required, at, call, report)) return false
    };
    return true
}

func native_scalar(kind:UInt8) -> bool { return scalar_kind(kind) && kind != scalar_enum(); }

func first_owner_parameter(links:const NameWork in L, facts:const OperandFacts in F,
                           first:UInt64, owner_site:UInt64, limit:UInt64) -> UInt64
    where {const owner L, const owner F} {
    val formal <- first;
    for (position in 0u64 .. limit) {
        if (formal == no_node()) return no_node();
        if (facts[formal].owner == owner_site) return position;
        formal <- links[formal].next;
    };
    return no_node();
}

func callable_interface_arity(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:const OperandFacts in F, definition:UInt64, first:UInt64, used:UInt64, revision:UInt64, source_only:bool) -> UInt64
    where {const owner N, const owner L, const owner F} {
    val kind <- facts[definition].kind;
    if (immutable_text_kind(kind)) {
        if (first_owner_parameter(links, facts, first,
                                  facts[definition].owner, used) == no_node()) return no_node();
    } else {
        if (!native_scalar(kind) && kind != void_result() &&
            (kind != scalar_enum() || facts[definition].reception != independent_value())) return no_node();
    };
    return interface_parameter_count(nodes, links, facts, first, used, revision, source_only);
}

func interface_parameter_count(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:const OperandFacts in F, first:UInt64, used:UInt64, revision:UInt64, source_only:bool) -> UInt64
    where {const owner N, const owner L, const owner F} {
    val formal <- first;
    val count <- 0u64;
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return count;
        if (!interface_parameter(nodes, facts, formal, used, revision, source_only)) return no_node();
        count <- count + 1u64;
        formal <- links[formal].next;
    };
    return no_node();
}

func interface_parameter(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    formal:UInt64, used:UInt64, revision:UInt64, source_only:bool) -> bool
    where {const owner N, const owner F} {
    val kind <- facts[formal].kind;
    val mode <- facts[formal].reception;
    ref syntax = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (inspect_formal(nodes, revision, used, formal, syntax) != OrdinaryFormal) return false;
    if (mode == local_place())
        return scalar_kind(kind) && (syntax.mode == ValueFormal || syntax.mode == ExplicitValueFormal);
    if (facts[formal].writable_text_place != 0u8) return false;
    if (source_only && mode == borrowed_ref()) {
        if (kind == source_handle_loan()) return syntax.mode == HandleFormal;
        if (syntax.mode == ReferenceFormal) {
            if (kind == source_product_loan() || has_slot_array(facts, formal)) return true;
            if (kind == product_kind()) {
                val type <- facts[formal].identity;
                return facts[formal].identity_module == 0u64 && type < used &&
                    facts[type].bits_product && facts[type].product_words != 0u64
            }
        }
    };
    if (mode == borrowed_ref()) return native_scalar(kind) || immutable_text_kind(kind);
    return mode == nullable_ptr() && native_scalar(kind);
}

export func first_declared_failure(nodes:const ExprNodes in N, used:UInt64,
    revision:UInt64) -> UInt64 where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <-
        false; };
    ref failure = make UInt64 { no_node() };
    for (at in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, at, callable) == ModuleCallable) {
            if (!find_signature_clause(nodes, revision, used, callable.signature,
                ThrowsSignatureClause, failure)) return at;
            if (failure != no_node()) return at
        }
    };
    return no_node()
}

func ordinary_callable_export(exports:const ModuleExports in E, row:UInt64, module_id:UInt64,
    definition:UInt64) -> bool where {const owner E} {
    return exports[row].origin_module == module_id && exports[row].identity == definition &&
        exports[row].kind == callable_export() && exports[row].shape == ordinary_callable_shape()
}

func publishes_ordinary_call(exports:const ModuleExports in E, count:UInt64, module_id:UInt64,
    definition:UInt64, needs_declared_failure:bool) -> bool where {const owner E} {
    for (row in 0u64 .. count) {
        if (ordinary_callable_export(exports, row, module_id, definition) &&
            (!needs_declared_failure || exports[row].checked != 0u8)) return true
    };
    return false
}

func publish_nominal_identity(facts:const OperandFacts in F, value:UInt64, module_id:UInt64, row:ModuleInterfaceRow in I)
    -> void where {const owner F, owner I} {
    row.type_module <- if (facts[value].identity_module == 0u64) { module_id } else { (facts[value].identity_module) };
    row.type_identity <- facts[value].identity;
    return
}

func interface_scalar(kind:UInt8) -> UInt8 {
    if (kind == scalar_u8()) return builtin_u8();
    if (kind == source_u32()) return builtin_u32();
    if (kind == scalar_u64()) return builtin_u64();
    if (kind == scalar_bool()) return builtin_bool();
    return 0u8
}

func stage_array_slot_parameters(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:const OperandFacts in F, cases:const ConstructorCaseFacts in C,
    contracts:ModuleInterfaces in I, header:UInt64, module:UInt64,
    definition:UInt64, first:UInt64, used:UInt64, revision:UInt64, owner_count:UInt64 in R) -> UInt64
    where {const owner N, const owner L, const owner F, const owner C, owner I, owner R} {
    owner_count <- 0u64;
    ref syntax = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    val formal <- first;
    val row <- header + 1u64;
    val has_slot <- false;
    val kind <- 0u8;
    val loan <- 0u8;
    val owner_site <- no_node();
    val role <- no_node();
    val next <- no_node();
    for (position in 0u64 .. used) {
        if (formal == no_node()) return if (has_slot) { row } else { no_node() };
        if (formal >= used || row >= intrinsic (len)(contracts) ||
            inspect_formal(nodes, revision, used, formal, syntax) != OrdinaryFormal) return no_node();
        write_interface_header(contracts[row], module, definition, 0u8, 0u8, 0u64);
        contracts[row].field_mode <- syntax.mode;
        kind <- interface_scalar(facts[formal].kind);
        if (facts[formal].reception == local_place()) {
            if (kind == 0u8 || (syntax.mode != ValueFormal && syntax.mode != ExplicitValueFormal)) return no_node();
            (contracts[row].value_kind <- kind):void
        } else {
            if (facts[formal].reception != borrowed_ref()) return no_node();
            loan <- facts[formal].kind;
            if (syntax.mode == HandleFormal) {
                if (loan != source_handle_loan() || facts[formal].identity == no_node()) return no_node();
                (kind <- c_handle_type()):void
            } else {
                if (syntax.mode == ReferenceSlotFormal) {
                    if (loan != source_array_loan() || facts[formal].array_slot != formal ||
                        facts[formal].target_readonly != 0u8) return no_node();
                    contracts[row].slot_target_invariant <- true;
                    has_slot <- true;
                    (kind <- array_type()):void
                } else {
                    if (syntax.mode != ReferenceFormal) return no_node();
                    if (loan == source_array_loan()) {
                        (kind <- array_type()):void
                    } else {
                        if (loan == source_product_loan() || loan == product_kind()) {
                            if (!(formal < intrinsic (len)(cases) &&
                                  (case cases[formal] of { ArrayFieldRecordFormal -> true; _ -> false })) &&
                                (facts[formal].target_readonly == 0u8 ||
                                 owner_constraint_syntax(nodes, facts[formal].owner) != ReadonlyOwnerConstraint))
                                return no_node();
                            (kind <- record_type()):void
                        } else {
                            if (kind == 0u8 || kind == builtin_u32()) return no_node();
                        }
                    }
                }
            };
            contracts[row].value_kind <- kind;
            if (kind == c_handle_type() || kind == array_type() || kind == record_type()) {
                if (facts[formal].identity == no_node()) return no_node();
                publish_nominal_identity(facts, formal, module, contracts[row])
            };
            owner_site <- facts[formal].owner;
            if (owner_site >= used || !owner_parameter(nodes, owner_site)) return no_node();
            role <- first_owner_parameter(links, facts, first, owner_site, position + 1u64);
            if (role > position) return no_node();
            if (role == position) { (owner_count <- owner_count + 1u64):void };
            contracts[row].owner_role <- role;
            contracts[row].target_readonly <- facts[formal].target_readonly;
            contracts[row].owner_readonly <- if (owner_constraint_syntax(nodes, owner_site) == ReadonlyOwnerConstraint) {
                1u8
            } else { 0u8 };
            contracts[row].source_allocates <- facts[owner_site].owner_chain != no_node();
            if (contracts[row].source_allocates && contracts[row].owner_readonly != 0u8) return no_node()
        };
        next <- links[formal].next;
        if (next <= formal) return no_node();
        formal <- next;
        (row <- row + 1u64):void
    };
    return no_node()
}

export func append_array_slot_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:const OperandFacts in F, views:const SuppliedViews in V,
    cases:const ConstructorCaseFacts in C, exports:ModuleExports in E, export_count:UInt64,
    contracts:ModuleInterfaces in I,
    module:UInt64, start:UInt64, used:UInt64, revision:UInt64, report:OperandCheckResult in R) -> UInt64
    where {const owner N, const owner B, const owner L, const owner F, const owner V, const owner C, owner E, owner I, owner R} {
    if (used > intrinsic (len)(views) || export_count > intrinsic (len)(exports) ||
        start > intrinsic (len)(contracts) || module == 0u64 || module == no_node()) return no_node();
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    ref first = make UInt64 { no_node() };
    ref failure = make UInt64 { no_node() };
    ref owner_count = make UInt64 { 0u64 };
    val count <- start;
    val kind <- 0u8;
    val result <- 0u8;
    val past <- no_node();
    for (definition in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, definition, callable) == ModuleCallable) {
            case views[definition] of {
                CheckedArraySlotBody { val failures <-, } -> {
                    if (publishes_ordinary_call(exports, export_count, module, definition, false)) {
                        kind <- facts[definition].kind;
                        result <- if (kind == void_result()) { builtin_void() }
                            else { if (kind == scalar_enum()) { enum_type() } else { interface_scalar(kind) } };
                        if (result == 0u8 || (kind == scalar_enum() && facts[definition].identity == no_node()) ||
                            facts[definition].reception == borrowed_ref() ||
                            names[definition].declaration != definition || links[definition].next_method != no_node() ||
                            count >= intrinsic (len)(contracts) ||
                            !callable_formals(nodes, revision, used, definition, true, first) ||
                            !find_signature_clause(nodes, revision, used, callable.signature,
                                ThrowsSignatureClause, failure)) {
                            operand_problem(report, definition, unsupported_imported_call());
                            return no_node()
                        };
                        past <- stage_array_slot_parameters(nodes, links, facts, cases, contracts, count,
                            module, definition, first, used, revision, owner_count);
                        if (past == no_node()) {
                            operand_problem(report, definition, unsupported_imported_call());
                            return no_node()
                        };
                        write_interface_header(contracts[count], module, definition, callable_binding(),
                            result, past - count - 1u64);
                        if (kind == scalar_enum()) {
                            publish_nominal_identity(facts, definition, module, contracts[count])
                        };
                        contracts[count].owner_count <- owner_count;
                        contracts[count].membership <- FixedMethods;
                        contracts[count].callable_kind <- if (callable.function_form) {
                            CheckedFunction:InterfaceCallableKind
                        } else { CheckedProcedure:InterfaceCallableKind };
                        contracts[count].failure_identity <- no_node();
                        if (failure != no_node()) {
                            if (failure >= used || facts[failure].kind != exception_type() ||
                                facts[failure].identity == no_node()) {
                                operand_problem(report, definition, unsupported_imported_call());
                                return no_node()
                            };
                            contracts[count].failure_identity <- facts[failure].identity;
                            contracts[count].failure_module <- facts[failure].identity_module;
                            (contracts[count].failure_checked <- facts[failure].checked_exception):void
                        };
                        contracts[count].array_slot_failures.bounds <- failures.bounds;
                        contracts[count].array_slot_failures.out_of_memory <- failures.out_of_memory;
                        contracts[count].array_slot_failures.region_capacity <- failures.region_capacity;
                        contracts[count].array_slot_failures.invalid_capacity <- failures.invalid_capacity;
                        contracts[count].array_slot_checked <- true;
                        for (row in 0u64 .. export_count) {
                            if (ordinary_callable_export(exports, row, module, definition)) {
                                (exports[row].shape <- array_slot_callable_shape()):void
                            }
                        };
                        (count <- past):void
                    }
                };
                _ -> {}
            }
        }
    };
    return count
}

export func append_callable_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                                   links:const NameWork in L, facts:const OperandFacts in F,
                                       exports:const ModuleExports in E, export_count:UInt64,
                                       used:UInt64, revision:UInt64,
                                   module_id:UInt64, base:UInt64, start:UInt64,
                                       contracts:ModuleInterfaces in I,
                                   report:OperandCheckResult in R) -> UInt64
    where {const owner N, const owner B, const owner L, const owner F, const owner E,
           owner I, owner R} {
    if (start > intrinsic (len)(contracts) || export_count > intrinsic (len)(exports)) return no_node();
    val source_only <- base == no_node();
    val count <- start;
    val arity <- no_node();
    val formal <- no_node();
    val header <- no_node();
    val past <- no_node();
    val staged_source_call <- false;
    ref first = make UInt64 { no_node() };
    ref failure = make UInt64 { no_node() };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    for (at in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, at,
            callable) == ModuleCallable && names[at].declaration == at &&
            (!source_only || publishes_ordinary_call(exports, export_count, module_id, at, true))) {
            if (!find_signature_clause(nodes, revision, used, callable.signature,
                ThrowsSignatureClause, failure)) {
                operand_problem(report, at, invalid_operand_tree());
                return no_node()
            };
            if (source_only && failure == no_node()) {
                operand_problem(report, at, unsupported_imported_call());
                return no_node()
            };
            header <- if (source_only) {
                find_interface(contracts, count, module_id, at)
            } else { no_node() };
            staged_source_call <- header != no_node() &&
                contracts[header].interface_kind == callable_binding() &&
                (contracts[header].has_here == 1u8 || source_handle_call(contracts, count, header));
            if (!staged_source_call && links[at].next_method == no_node()) {
                if (!callable_formals(nodes, revision, used, at, false, first)) return no_node();
                arity <- callable_interface_arity(nodes, links, facts, at, first, used, revision, source_only)
            } else { arity <- no_node() };
            if (source_only && !staged_source_call && arity == no_node()) {
                operand_problem(report, at, unsupported_imported_call());
                return no_node()
            };
            if (arity != no_node()) {
                if (arity >= intrinsic (len)(contracts) - count) return no_node();
                write_interface_header(contracts[count], module_id, at, callable_binding(), facts[at].kind, arity);
                contracts[count].membership <- (FixedMethods:FamilyMembership);
                if (facts[at].kind == scalar_enum()) {
                    publish_nominal_identity(facts, at, module_id, contracts[count])
                };
                if (!source_only) { (contracts[count].native_function <- base + at):void };
                contracts[count].callable_kind <- if (callable.function_form) {
                    CheckedFunction:InterfaceCallableKind
                } else { CheckedProcedure:InterfaceCallableKind };
                # The root Exception has an identity of its own. Use an absent
                # node for an ordinary callable with no declared failure.
                contracts[count].failure_identity <- if (failure == no_node()) { no_node() } else { (facts[failure].identity) };
                if (failure != no_node()) {
                    contracts[count].failure_module <- facts[failure].identity_module;
                    (contracts[count].failure_checked <- facts[failure].checked_exception):void;
                };
                if (facts[at].reception == borrowed_ref()) {
                    contracts[count].target_readonly <- facts[at].target_readonly;
                    (contracts[count].owner_role <- first_owner_parameter(links, facts, first, facts[at].owner, arity)):void;
                };
                formal <- first;
                for (row in count + 1u64 .. count + 1u64 + arity) {
                    publish_callable_parameter(nodes, links, facts, first, formal, arity, module_id,
                        contracts[row]);
                    (formal <- links[formal].next):void;
                };
                past <- count + 1u64 + arity;
                if (source_only && !checked_source_call(contracts, past, count)) {
                    operand_problem(report, at, unsupported_imported_call());
                    return no_node()
                };
                count <- past
            };
        };
    };
    return count;
}

func publish_callable_parameter(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                              first:UInt64, formal:UInt64, arity:UInt64, module_id:UInt64, row:ModuleInterfaceRow in I) -> void
    where {const owner N, const owner L, const owner F, owner I} {
    write_interface_header(row, 0u64, 0u64, 0u8, 0u8, 0u64);
    row.value_kind <- facts[formal].kind;
    row.native_reception <- facts[formal].reception;
    row.target_readonly <- facts[formal].target_readonly;
    if (row.native_reception == local_place()) {
        if (row.value_kind == scalar_enum()) { publish_nominal_identity(facts, formal, module_id, row) };
        return
    };
    val binder <- facts[formal].owner;
    if (row.value_kind == product_kind()) { (row.value_kind <- source_product_loan()):void };
    if (nominal_source_loan(row.value_kind)) {
        publish_nominal_identity(facts, formal, module_id, row);
        row.field_mode <- if (row.value_kind == source_handle_loan()) { HandleFormal } else { ReferenceFormal };
        (row.source_allocates <- facts[binder].owner_chain != no_node()):void
    };
    # A role is the position of the first parameter that establishes this owner.
    row.owner_role <- first_owner_parameter(links, facts, first, binder, arity);
    row.owner_readonly <- if (owner_constraint_syntax(nodes, binder) == ReadonlyOwnerConstraint) { 1u8 } else { 0u8 };
    row.native_passes_owner <- if (facts[formal].passes_owner != 0u8 && facts[binder].owner_chain != no_node()) {
        1u8
    } else { 0u8 };
    return;
}

func check_procedure_actuals(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, at:UInt64, definition:UInt64, tail:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F} {
    ref contract = make ProcedureSymbolSites {
        symbol <- no_node(); input_tail <- no_node(); result_type <- no_node(); arrow <- no_node()
    };
    ref formal = make UInt64 { no_node() };
    ref argument = make UInt64 { no_node() };
    if (!inspect_procedure_symbol(nodes, revision, used, definition, contract) ||
        !first_sequence_entry(nodes, revision, used, contract.input_tail, ProcedureTypeSequence, formal) ||
        !first_sequence_entry(nodes, revision, used, tail, ArgumentSequence, argument)) return invalid_operand_tree();
    ref parameter = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val entered <- true;
    val operand <- no_node();
    val kind <- 0u8;
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (formal == no_node() && argument == no_node()) {
            kind <- procedure_operand_kind(nodes, names, contract.result_type, used, revision);
            if (kind == 0u8) return unproved_result_contract();
            set_result(facts, at, if (entered) { kind } else { never_result() });
            return 0u8
        };
        if (formal == no_node() || argument == no_node()) return wrong_argument_count();
        if (inspect_sequence_entry(nodes, revision, used, formal, parameter) != ProcedureTypeSequence)
            return invalid_operand_tree();
        operand <- ordinary_argument_value(nodes, used, revision, argument);
        if (operand == no_node()) return invalid_operand_tree();
        if (facts[operand].kind == never_result()) { (entered <- false):void };
        if (entered) {
            kind <- procedure_operand_kind(nodes, names, parameter.item, used, revision);
            if (kind == 0u8 || kind == void_result()) return unsupported_imported_call();
            diagnostic <- check_argument_operand(nodes, facts, argument,
                kind, local_place(), 0u64, 0u64, 0u8, used, revision);
            if (diagnostic != 0u8) return diagnostic
        };
        formal <- links[formal].next;
        (argument <- links[argument].next):void
    };
    return invalid_operand_tree()
}

func check_symbolic_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         selected:const SelectedExports in E, facts:OperandFacts in F,
                         at:UInt64, callee:UInt64, argument:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, const owner E, owner F} {
    if (names[callee].kind == procedure_symbol_binding())
        return check_procedure_actuals(nodes, names, links, facts, at, names[callee].declaration, argument, used, revision);
    if (names[callee].kind != symbolic_selection()) return unproved_call_target();
    val site <- names[callee].declaration;
    if (selected[site].kind != symbol_export() || selected[site].identity != print_export_identity())
        return unproved_call_target();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
        entry.previous != no_node()) return wrong_argument_count();
    val diagnostic <- require_bits(nodes, facts, entry.item);
    if (diagnostic != 0u8) return diagnostic;
    scalar_fact(facts, argument, independent_value(), no_node());
    only_void(facts, at);
    return 0u8;
}

func result_kind(nodes:const ExprNodes in N, facts:OperandFacts in F, value:UInt64, read:bool) -> UInt8
    where {const owner N, owner F} {
    if (value == no_node()) return void_result();
    val kind <- facts[value].kind;
    if (kind == source_u32()) {
        if (read && require_source_u32(nodes, facts, value, false) != 0u8) return 0u8;
        return kind
    };
    if (read && scalar_kind(kind) && require_typed_bits(nodes, facts, value, kind) != 0u8) return 0u8;
    if (scalar_kind(kind) || kind == void_result() || kind == never_result()) return kind;
    if (!read && immutable_text_kind(kind)) return kind;
    return 0u8;
}

func set_result(facts:OperandFacts in F, at:UInt64, kind:UInt8) -> void where {owner F} {
    if (scalar_kind(kind) || kind == source_u32()) {
        set_fact(facts, at, kind, independent_value(), no_node(), 0u64, 0u8)
    } else {
        set_fact(facts, at, kind, 0u8, no_node(), 0u64, 0u8);
    };
}

func set_bits_result(facts:OperandFacts in F, at:UInt64, value:UInt64) -> void where {owner F} {
    set_fact(facts, at, facts[value].kind, independent_value(), no_node(), facts[value].identity, 0u8);
    facts[at].identity_module <- facts[value].identity_module;
    return
}

func explicit_discard() -> UInt8 { return 1u8; }
func loop_discard() -> UInt8 { return 2u8; }
func statement_guard_discard() -> UInt8 { return 3u8; }

func static_string(facts:const OperandFacts in F, at:UInt64) -> bool where {const owner F} {
    return facts[at].kind == string_kind() && facts[at].owner == static_text_owner() &&
        facts[at].reception == borrowed_ref() && facts[at].target_presence == present_target() &&
        facts[at].target_readonly != 0u8
}

# List entries carry the reached normal tail type. Explicit discard still
# checks that type, without imposing a read of the tail's target.
func check_sequence_item(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64,
    entry:const SequenceEntry in E, source_only:bool) -> void
    where {const owner N, owner F, const owner E} {
    val previous <- entry.previous;
    if (previous != no_node() && facts[previous].kind == never_result()) {
        set_result(facts, at, never_result());
        return;
    } else {};
    val expression <- entry.item;
    if (facts[expression].kind == never_result()) { set_result(facts, at, never_result()); return; } else {};
    val kind <- void_result();
    val callee <- facts[expression].call_definition;
    # The sequence discards the call's payload. The invocation row still
    # lacks a result until the selected definition is complete.
    if (facts[expression].statement_operand && callee != no_node() && facts[callee].omitted_result) {
        only_void(facts, at);
        return
    };
    if (!binds_local_storage(nodes, expression)) {
        if (facts[at].arm_result != 0u8 &&
            (scalar_kind(facts[expression].kind) || (source_only && static_string(facts, expression)))) {
            copy_fact(facts, at, expression);
            return;
        } else {};
        (kind <- result_kind(nodes, facts, expression, facts[at].discarded_result == 0u8)):void;
    } else {};
    if (scalar_kind(kind)) { set_bits_result(facts, at, expression); }
    else { set_result(facts, at, kind); };
}

func sequence_result(facts:const OperandFacts in F, tail:UInt64) -> UInt8 where {const owner F} {
    if (tail == no_node()) return void_result();
    return facts[tail].kind;
}

# Abrupt paths add no normal result to a full scope or try expression.
func merge_result(facts:OperandFacts in F, at:UInt64, kind:UInt8, identity:UInt64, module:UInt64) -> UInt8 where {owner F} {
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind != 0u8 &&
        (facts[at].kind != kind || !compatible_operand_nominal(facts, at, kind, identity, module)))
        return unproved_result_contract();
    if (kind == scalar_enum()) {
        set_fact(facts, at, kind, independent_value(), no_node(), identity, 0u8);
        (facts[at].identity_module <- module):void
    } else { set_result(facts, at, kind); };
    return 0u8;
}

func merge_arm_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, arm:UInt64, discard:bool) -> UInt8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (discard && (facts[at].discarded_result == loop_discard() ||
        facts[at].discarded_result == statement_guard_discard()))
        return merge_result(facts, at, void_result(), 0u64, 0u64);
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind == 0u8) {
        copy_fact(facts, at, arm);
        return 0u8;
    } else {};
    if (!same_operand_type(facts, at, arm)) return unproved_result_contract();
    val left <- facts[at].reception;
    val right <- facts[arm].reception;
    val nullable <- left == nullable_ptr() || right == nullable_ptr();
    if (kind == void_result() || left == independent_value() || right == independent_value()) {
        if (nullable) return unproved_nonnull_borrow();
        if (scalar_kind(kind)) { set_bits_result(facts, at, arm); } else { set_result(facts, at, kind); };
        return 0u8;
    } else {};
    val identity <- facts[at].identity;
    val owner_site <- facts[at].owner;
    if (owner_site == no_node() || facts[arm].owner == no_node()) return unproved_owner();
    if (owner_site != facts[arm].owner) return owner_conflict(nodes, owner_site, facts[arm].owner);
    val readonly <- if (facts[at].target_readonly != 0u8 || facts[arm].target_readonly != 0u8) { 1u8 } else { 0u8 };
    val reservation <- facts[at].reservation;
    if (reservation != facts[arm].reservation) return unproved_reservation_selection();
    val reception <- if (nullable) { nullable_ptr() } else { borrowed_ref() };
    val present <- facts[at].target_presence;
    val selected <- facts[at].selection;
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].identity_module <- facts[arm].identity_module;
    facts[at].target_readonly <- readonly;
    facts[at].reservation <- reservation;
    if (present == facts[arm].target_presence) { (facts[at].target_presence <- present):void; } else {};
    if (selected == facts[arm].selection) { (facts[at].selection <- selected):void; } else {};
    return 0u8;
}

func check_conditional(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64,
    branch:const ConditionalSites in C, source_only:bool) -> UInt8
    where {const owner N, owner F, const owner C} {
    val condition <- branch.test;
    if (facts[condition].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (require_typed_bits(nodes, facts, condition, scalar_bool()) != 0u8) return expected_boolean_condition();
    if (source_only) {
        val yes <- branch.consequent;
        val other <- branch.alternative;
        val yes_text <- static_string(facts, yes);
        val other_text <- static_string(facts, other);
        if ((yes_text && (other_text || facts[other].kind == never_result())) ||
            (other_text && facts[yes].kind == never_result())) {
            if (facts[at].discarded_result == loop_discard() || facts[at].discarded_result == statement_guard_discard()) {
                only_void(facts, at)
            } else {
                set_fact(facts, at, string_kind(), borrowed_ref(), static_text_owner(), 0u64, 0u8);
                facts[at].target_readonly <- 1u8;
                if (!yes_text || !other_text || facts[yes].text_nul == facts[other].text_nul) {
                    (facts[at].text_nul <- if (yes_text) { (facts[yes].text_nul) } else { (facts[other].text_nul) }):void
                }
            };
            return 0u8
        }
    };
    val diagnostic <- merge_arm_result(nodes, facts, at, branch.consequent, true);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- merge_arm_result(nodes, facts, at, branch.alternative, true);
    if (diagnostic == 0u8 && facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
    return diagnostic;
}

func check_predicate_assertion(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64,
    predicate:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, owner F} {
    if (facts[predicate].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (require_typed_bits(nodes, facts, predicate, scalar_bool()) != 0u8)
        return expected_boolean_condition();
    val truth <- boolean_literal(nodes, used, ungrouped(nodes, revision, used, predicate));
    if (truth == LiteralFalse) return false_predicate_assertion();
    only_void(facts, at);
    (facts[at].predicate_assertion_check <- truth != LiteralTrue):void;
    return 0u8
}

# Remaining canonical members are tracked by count and exclusion markers.
# A possible write through another view starts a fresh scan generation.
data CaseCoverage {
    total:UInt64,
    remaining:UInt64,
    absent:bool,
    only:UInt64,
    generation:UInt64,
    exclusions:UInt64,
    imported_enum:bool,
}

# A case proof belongs to a saved address. An enclosing proof for another
# pointer, including one with the same declared owner, cannot supply it.
export func selected_target_presence(facts:const OperandFacts in F, at:UInt64) -> UInt8 where {const owner F} {
    val presence <- facts[at].target_presence;
    val selection <- facts[at].selection;
    if (presence != unknown_target() || selection == no_node()) return presence;
    val header <- facts[at].case_context;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (header == no_node()) return presence;
        if (facts[header].case_selection == selection &&
            facts[header].case_presence != unknown_target()) return facts[header].case_presence;
        header <- facts[header].case_context;
    };
    return presence;
}

func receipt_in_context(facts:const OperandFacts in F, use:UInt64, receipt:UInt64) -> bool
    where {const owner F} {
    val extent <- intrinsic (len)(facts);
    if (receipt >= use || use >= extent) return false;
    val owning_arm <- facts[receipt].case_context;
    if (owning_arm >= extent) return false;
    val context <- facts[use].case_context;
    val parent <- no_node();
    for (unused in 0u64 .. extent) {
        if (context >= extent) return false;
        if (context == owning_arm) return true;
        parent <- facts[context].case_context;
        if (parent <= context) return false;
        (context <- parent):void
    };
    return false
}

func enter_case_context(facts:OperandFacts in F, outer:UInt64, header:UInt64) -> UInt64 where {owner F} {
    facts[header].case_context <- outer;
    return header;
}

func case_has_paths(coverage:const CaseCoverage in V) -> bool where {const owner V} {
    return coverage.absent || coverage.remaining != 0u64;
}

func case_presence(present:bool, absent:bool) -> UInt8 {
    if (present && !absent) return present_target();
    if (absent && !present) return absent_target();
    return unknown_target();
}

func initialize_case_coverage(nodes:const ExprNodes in N, names:const NameBindings in B,
                              links:const NameWork in L, facts:OperandFacts in F,
                              interfaces:const ModuleInterfaces in I, published:UInt64, at:UInt64, subject:UInt64,
                              coverage:CaseCoverage in V, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner L, owner F, const owner I, owner V} {
    val kind <- facts[subject].kind;
    if (kind == never_result()) return true;
    val present <- selected_target_presence(facts, subject);
    coverage.absent <- present != present_target();
    if (present == absent_target()) return true;
    if (kind == scalar_u64() || kind == scalar_u8()) {
        coverage.total <- 1u64;
        coverage.remaining <- 1u64;
        return true
    };
    if (kind == scalar_bool()) {
        coverage.total <- 2u64;
        coverage.remaining <- 2u64;
        if (facts[subject].reception == independent_value()) {
            val behavior <- case_condition(nodes, facts, subject, used, revision);
            if (behavior == case_guard_passes() || behavior == case_guard_declines()) {
                coverage.only <- if (behavior == case_guard_passes()) { at } else { subject };
                (coverage.remaining <- 1u64):void;
            } else {};
        } else {};
        return true;
    } else {};
    val domain <- facts[subject].identity;
    if (coverage.imported_enum) {
        val head <- find_interface(interfaces, published, facts[subject].identity_module, domain);
        if (head == no_node() || interfaces[head].interface_kind != enum_type() ||
            interfaces[head].entry_count >= published - head) return false;
        val distinct <- interfaces[head].enum_code;
        if (distinct == 0u64 || distinct > interfaces[head].entry_count) return false;
        coverage.total <- distinct;
        coverage.remaining <- distinct;
        return true
    };
    ref enumeration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref member = make UInt64 { no_node() };
    if (inspect_declaration(nodes, revision, used, domain, enumeration) != EnumTypeDeclaration ||
        !first_sequence_entry(nodes, revision, used, enumeration.entries, EnumSequence, member)) return false;
    for (unused in 0u64 .. used) {
        if (member == no_node()) { (coverage.remaining <- coverage.total):void; return true; } else {};
        if (names[member].declaration == member) { (coverage.total <- coverage.total + 1u64):void; } else {};
        member <- links[member].next;
    };
    return false;
}

func reopen_case_domain(coverage:CaseCoverage in V, generation:UInt64) -> void where {owner V} {
    coverage.only <- no_node();
    coverage.generation <- generation;
    (coverage.remaining <- coverage.total):void;
}

func case_may_write(nodes:const ExprNodes in N, links:const NameWork in L,
                    at:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner L} {
    if (at == no_node()) return false;
    if (at >= used || at >= syntax_len(nodes)) return true;
    case nodes[at] of {
        (Vacant) -> { return true; };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (BooleanLiteral) -> { return false; };
                (IntegerLiteral) -> { return false; };
                (NameReference) -> { return false; };
                (NullLiteral) -> { return false; };
                (CaseFallthrough) -> { return false; };
                (DiscardedExpression { val operand <- operand, }) -> {
                    return !published_syntax_id(nodes, revision, at, operand) ||
                        case_may_write(nodes, links, operand.index, used, revision);
                };
                (_) -> {};
            };
        };
    };
    ref inner = make UInt64 { no_node() };
    if (inspect_group(nodes, revision, used, at, inner) == ParenthesizedExpression)
        return case_may_write(nodes, links, inner, used, revision);
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr)
        return case_may_write(nodes, links, logical.left_operand, used, revision) ||
            case_may_write(nodes, links, logical.right_operand, used, revision);
    ref tail = make UInt64 { no_node() };
    if (block_tail(nodes, revision, used, at, tail) && !is_scope_block(nodes, at))
        return case_block_may_write(nodes, links, tail, used, revision);
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    if (inspect_type_assertion(nodes, revision, used, at, assertion))
        return case_may_write(nodes, links, assertion.operand, used, revision);
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch))
        return case_may_write(nodes, links, branch.test, used, revision) ||
            case_may_write(nodes, links, branch.consequent, used, revision) ||
            case_may_write(nodes, links, branch.alternative, used, revision);
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val operation_kind <- inspect_binary(nodes, revision, used, at, binary);
    if (operation_kind == ArithmeticBinary || operation_kind == ComparisonBinary)
        return case_may_write(nodes, links, binary.left_operand, used, revision) ||
            case_may_write(nodes, links, binary.right_operand, used, revision);
    return true;
}

func case_block_may_write(nodes:const ExprNodes in N, links:const NameWork in L,
                          tail:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner L} {
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return true;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. used) {
        if (item == no_node()) return false;
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence ||
            case_may_write(nodes, links, entry.item, used, revision)) return true;
        item <- links[item].next;
    };
    return true;
}

func case_condition(nodes:const ExprNodes in N, facts:OperandFacts in F,
                    at:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, owner F} {
    if (at == no_node()) return case_guard_passes();
    if (facts[at].kind == never_result()) return case_guard_exits();
    if (require_typed_bits(nodes, facts, at, scalar_bool()) != 0u8) return 0u8;
    val operand <- ungrouped(nodes, revision, used, at);
    val truth <- boolean_literal(nodes, used, operand);
    if (truth == LiteralTrue) return case_guard_passes();
    if (truth == LiteralFalse) return case_guard_declines();
    return case_guard_tests();
}

# A direct registration before every transfer runs unless an earlier
# abrupt completion prevents the transfer itself. If the action cannot
# finish normally, its completion replaces the pending scan request.
export func has_terminal_defer_before(nodes:const ExprNodes in N, links:const NameWork in L,
                                      facts:const OperandFacts in F, tail:UInt64, before:UInt64, revision:UInt64, used:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    for (unused in 0u64 .. used) {
        if (item == no_node() || inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return false;
        if (syntax_past(nodes, used, entry.item) > before) return false;
        if (inspect_defer(nodes, revision, used, entry.item, deferred) == DeferBody &&
            facts[deferred.operand].kind == never_result()) return true;
        item <- links[item].next;
    };
    return false;
}

export func case_resumes_after_cleanup() -> UInt8 { return 1u8; }
func replaced_case_resume() -> UInt8 { return 2u8; }

# The destination identifies where this particular transfer stops. A
# finalizer that always exits discards the suspended transfer.
func case_transfer_survives(nodes:const ExprNodes in N, names:const NameBindings in B,
                            facts:const OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner F} {
    val stop <- names[names[at].declaration].finalizer;
    val cleanup <- names[at].finalizer;
    ref group = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref finalizer = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    for (unused in 0u64 .. used) {
        if (cleanup == stop) return true;
        if (!inspect_protected(nodes, revision, used, cleanup, group) ||
            inspect_guard_clause(nodes, revision, used, group.clauses, finalizer) != CleanupClause ||
            facts[finalizer.target].kind == never_result()) return false;
        cleanup <- names[cleanup].finalizer;
    };
    return false;
}

func case_resume_kind(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, arm:UInt64, body:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F} {
    val scan <- facts[arm].case_exit_link;
    if (scan == no_node()) return 0u8;
    ref tail = make UInt64 { no_node() };
    val full <- is_scope_block(nodes, body) && block_tail(nodes, revision, used, body, tail);
    for (unused in 0u64 .. used) {
        if (scan == no_node()) return replaced_case_resume();
        if (case_transfer_survives(nodes, names, facts, scan, used, revision) &&
            (!full || !has_terminal_defer_before(nodes, links, facts, tail, syntax_first(nodes, used, scan), revision, used)))
            return case_resumes_after_cleanup();
        scan <- facts[scan].case_exit_link;
    };
    return replaced_case_resume();
}

func prepare_case_arm(nodes:const ExprNodes in N, names:const NameBindings in B,
                      links:const NameWork in L, facts:OperandFacts in F, arm:UInt64, used:UInt64, revision:UInt64,
                      sites:const CaseArmSites in A) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner A} {
    facts[arm].case_resume <- case_resume_kind(nodes, names, links, facts, arm, sites.body, used, revision);
    val behavior <- case_condition(nodes, facts, sites.guard, used, revision);
    if (behavior == 0u8) return expected_boolean_condition();
    facts[arm].case_guard <- behavior;
    return 0u8;
}

func prepare_reference_case(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                            subject:UInt64, pattern:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, owner F} {
    ref binding = make UInt64 { no_node() };
    ref receiver = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!inspect_reference_case(nodes, revision, used, pattern, binding) ||
        inspect_binding(nodes, revision, used, binding, receiver) != TypedBinding) return invalid_operand_tree();
    val kind <- declared_scalar(names[receiver.target_type].kind);
    val mode <- facts[subject].reception;
    if (!native_scalar(kind) || kind != facts[subject].kind ||
        (mode != nullable_ptr() && mode != borrowed_ref() && mode != local_place()) ||
        facts[subject].reservation != no_node()) return unsupported_case_pattern();
    val owner_site <- facts[subject].owner;
    if (owner_site == no_node()) return unproved_owner();
    if (receiver.owner_name != no_node() && names[receiver.owner_name].declaration != owner_site)
        return owner_conflict(nodes, owner_site, names[receiver.owner_name].declaration);
    if (facts[subject].target_readonly != 0u8 && !receiver.readonly) return expected_writable_place();
    set_fact(facts, pattern, kind, borrowed_ref(), owner_site, 0u64, 0u8);
    facts[pattern].target_readonly <- if (receiver.readonly) { 1u8 } else { 0u8 };
    return 0u8
}

func prepare_case_pattern(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          cases:const ConstructorCaseFacts in C,
                          at:UInt64, subject:UInt64, pattern:UInt64, mode:CasePatternSyntax, member:UInt64 in M,
                          used:UInt64, revision:UInt64) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, owner F, const owner C, owner M} {
    member <- no_node();
    if (mode == AnyCaseTarget || mode == NullCaseTarget) return 0u8;
    if (mode == ReferenceCaseTarget) return prepare_reference_case(nodes, names, facts, subject, pattern, used, revision);
    val kind <- facts[subject].kind;
    if (kind == never_result()) return 0u8;
    if (kind == source_sum_target() || kind == independent_sum_bits()) {
        if ((mode != NamedCaseMember && mode != ConstructorCaseTarget) ||
            pattern >= intrinsic (len)(cases)) return unsupported_case_pattern();
        return case cases[pattern] of {
            CaseConstructor { val choice <- case_site, val representative <- representative, } -> {
                if (choice != at || representative <= subject || representative > pattern)
                    return invalid_operand_tree();
                member <- representative;
                0u8
            };
            _ -> unsupported_case_pattern()
        }
    };
    if (kind == scalar_bool()) {
        if (mode != FalseCaseTarget && mode != TrueCaseTarget) return unsupported_case_pattern();
        member <- if (mode == TrueCaseTarget) { at } else { subject };
        facts[pattern].discriminator_code <- if (mode == TrueCaseTarget) { 1u64 } else { 0u64 };
        return 0u8;
    };
    if (mode != NamedCaseMember) return unsupported_case_pattern();
    if (facts[subject].identity_module != 0u64) {
        # The declaration pass already looked up the name in the complete
        # enum. Keep the exclusion at a local syntax site, never a foreign ID.
        if (links[pattern].value_kind != enum_type() ||
            links[pattern].value_module != facts[subject].identity_module ||
            links[pattern].value_identity != facts[subject].identity) return unsupported_case_pattern();
        member <- pattern;
        facts[pattern].discriminator_code <- links[pattern].enum_code;
        return 0u8
    };
    ref enumeration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, facts[subject].identity, enumeration) != EnumTypeDeclaration)
        return invalid_operand_tree();
    val spelling <- find_enum_member(source, nodes, pattern, enumeration.entries, revision, used);
    if (spelling == no_node()) return missing_enum_member();
    member <- names[spelling].declaration;
    facts[pattern].discriminator_code <- links[spelling].enum_code;
    return 0u8;
}

func case_member_excluded(facts:const OperandFacts in F, coverage:const CaseCoverage in V,
    member:UInt64) -> bool where {const owner F, const owner V} {
    if (!coverage.imported_enum) return facts[member].case_excluded_at == coverage.generation;
    # Spellings in this domain exclude the same value when their codes agree.
    # A possible write invalidates exclusions from earlier scan generations.
    val code <- facts[member].discriminator_code;
    val prior <- coverage.exclusions;
    val excluded <- no_node();
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (prior == no_node()) return false;
        excluded <- facts[prior].case_exclusion_member;
        if (facts[excluded].case_excluded_at == coverage.generation &&
            facts[excluded].discriminator_code == code) return true;
        prior <- facts[prior].case_exclusion_next;
    };
    return false
}

func match_case_arm(facts:OperandFacts in F, coverage:const CaseCoverage in V,
                    subject:UInt64, arm:UInt64, member:UInt64, pattern:CasePatternSyntax) -> void
    where {owner F, const owner V} {
    val null_pattern <- pattern == NullCaseTarget;
    val all_pattern <- pattern == AnyCaseTarget;
    val ref_pattern <- pattern == ReferenceCaseTarget;
    val had_present <- coverage.remaining != 0u64;
    val had_absence <- coverage.absent;
    facts[arm].case_discriminator <- if (member != no_node() && had_present) { 1u8 } else { 0u8 };
    facts[arm].case_may_be_absent <- if (had_absence) { 1u8 } else { 0u8 };
    if (member != no_node() && (!had_present || (coverage.only != no_node() && coverage.only != member) ||
        case_member_excluded(facts, coverage, member))) return;
    if (null_pattern && !had_absence) return;
    if (ref_pattern && !had_present) return;
    val matches_present <- !null_pattern && had_present;
    val matches_absence <- (null_pattern || all_pattern) && had_absence;
    val matches_all <- all_pattern || (null_pattern && !had_present) ||
        (ref_pattern && !had_absence) ||
        (member != no_node() && coverage.remaining == 1u64 && !had_absence);
    facts[arm].case_match <- if (matches_all) { matches_case_arm() } else { tests_case_arm() };
    facts[arm].case_presence <- case_presence(matches_present, matches_absence);
    facts[arm].case_selection <- facts[subject].selection;
    return;
}

# Share the indexed member table across cases. A nested case restores the
# enclosing scan's marks after consuming its own arms.
func exclude_case_member(facts:OperandFacts in F, coverage:CaseCoverage in V, member:UInt64, arm:UInt64) -> void
    where {owner F, owner V} {
    facts[arm].case_exclusion_member <- member;
    facts[arm].case_exclusion_previous <- facts[member].case_excluded_at;
    facts[arm].case_exclusion_next <- coverage.exclusions;
    facts[member].case_excluded_at <- coverage.generation;
    coverage.exclusions <- arm;
    return;
}

func restore_case_exclusions(facts:OperandFacts in F, coverage:const CaseCoverage in V) -> void
    where {owner F, const owner V} {
    val mark <- coverage.exclusions;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (mark == no_node()) return;
        facts[facts[mark].case_exclusion_member].case_excluded_at <- facts[mark].case_exclusion_previous;
        mark <- facts[mark].case_exclusion_next;
    };
}

func finish_case_arm(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                     coverage:CaseCoverage in V, at:UInt64, arm:UInt64, member:UInt64, borrowed:bool, used:UInt64, revision:UInt64,
                     sites:const CaseArmSites in A, pattern:CasePatternSyntax) -> UInt8
    where {const owner N, const owner L, owner F, owner V, const owner A} {
    if (facts[arm].case_match == misses_case_arm()) return 0u8;
    val matches_present <- coverage.remaining != 0u64 && pattern != NullCaseTarget;
    val matches_absence <- coverage.absent && (pattern == AnyCaseTarget || pattern == NullCaseTarget);
    val guard <- sites.guard;
    val behavior <- facts[arm].case_guard;
    val body <- sites.body;
    val enters_body <- behavior != case_guard_exits() && behavior != case_guard_declines();
    val declines <- behavior == case_guard_declines() || behavior == case_guard_tests();
    val falls_through <- enters_body && facts[arm].case_resume == case_resumes_after_cleanup();
    if (declines || falls_through) {
        if (borrowed && matches_present && (case_may_write(nodes, links, guard, used, revision) ||
                                             (falls_through && case_may_write(nodes, links, body, used, revision)))) {
            reopen_case_domain(coverage, arm);
        } else {};
    } else {
        if (matches_absence) { (coverage.absent <- false):void; } else {};
        if (pattern == AnyCaseTarget || pattern == ReferenceCaseTarget) { (coverage.remaining <- 0u64):void; } else {
            if (member != no_node()) {
                exclude_case_member(facts, coverage, member, arm);
                (coverage.remaining <- coverage.remaining - 1u64):void;
            } else {};
        };
    };
    if (!enters_body) return 0u8;
    facts[arm].case_body <- 1u8;
    return merge_arm_result(nodes, facts, at, body, false);
}

# Each case owns its exits in syntax postorder. Consume them at the direct
# guard, body or intervening statement they leave, after its reach is known.
func merge_case_breaks(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                       last:UInt64 in P, at:UInt64, through:UInt64, reached:bool, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, owner F, owner P} {
    if (through == no_node()) return 0u8;
    ref value = make UInt64 { no_node() };
    val diagnostic <- 0u8;
    val pending <- if (last == no_node()) { facts[at].case_exit_link } else { facts[last].case_exit_link };
    for (unused in 0u64 .. used) {
        if (pending == no_node() || pending > through) return 0u8;
        if (reached && case_transfer_survives(nodes, names, facts, pending, used, revision)) {
            if (!completion_operand(nodes, revision, used, pending, value)) return invalid_operand_tree();
            diagnostic <- if (value == no_node()) { merge_result(facts, at, void_result(), 0u64, 0u64) }
                          else { merge_arm_result(nodes, facts, at, value, false) };
            if (diagnostic != 0u8) return diagnostic;
        } else {};
        last <- pending;
        pending <- facts[pending].case_exit_link;
    };
    return invalid_operand_tree();
}

func operand_problem(report:OperandCheckResult in R, at:UInt64, diagnostic:UInt8) -> bool where {owner R} {
    report.node <- at;
    report.diagnostic <- diagnostic;
    return false;
}

func check_case(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                interfaces:const ModuleInterfaces in I, published:UInt64, owners:CallOwners in O, fields:const CaughtFieldUses in X,
                    views:const SuppliedViews in H, products:const Products in M, arguments:const TypeKeys in M,
                cases:const ConstructorCaseFacts in C,
                demand:const DeclarationDemands in D,
                report:OperandCheckResult in R, at:UInt64, used:UInt64, revision:UInt64, outer:UInt64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, const owner I,
           owner O, const owner X, const owner H, const owner M, const owner C, const owner D, owner R} {
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, revision, used, at, selection)) return operand_problem(report, at, invalid_operand_tree());
    val subject <- selection.subject;
    val kind <- facts[subject].kind;
    val completed <- kind != never_result();
    val borrowed <- facts[subject].reception != independent_value();
    if (completed && kind != scalar_bool() && kind != scalar_enum() &&
        kind != null_literal() && kind != source_sum_target() && kind != independent_sum_bits() &&
        !(borrowed && (kind == scalar_u64() || kind == scalar_u8())))
        return operand_problem(report, at, unsupported_case_subject());
    val imported_enum <- kind == scalar_enum() && facts[subject].identity_module != 0u64;
    if (imported_enum &&
        ((borrowed && (facts[subject].reception != local_place() ||
                      facts[subject].target_presence != present_target())) ||
         intrinsic (len)(demand) == 0u64))
        return operand_problem(report, at, unsupported_case_subject());
    ref coverage = make CaseCoverage {
        total <- 0u64; remaining <- 0u64; absent <- false; only <- no_node(); generation <- at; exclusions <- no_node();
        imported_enum <- imported_enum
    };
    if (kind == source_sum_target() || kind == independent_sum_bits()) {
        if (at >= intrinsic (len)(cases)) return operand_problem(report, at, invalid_operand_tree());
        case cases[at] of {
            ValueCaseSubject { val expression <-, val type <- value_type, val count <-, } -> {
                if (expression != subject || count == 0u64 || kind != independent_sum_bits() || borrowed ||
                    facts[subject].identity != type.identity || facts[subject].identity_module != type.defining_module)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            IndexedCaseSubject { val expression <- expression, val count <- count, } -> {
                if (expression != subject || count == 0u64)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            DirectCaseSubject { val expression <- expression, val formal <- formal, val count <- count, } -> {
                if (expression != subject || formal >= subject || count == 0u64 ||
                    names[subject].kind != formal_binding() || names[subject].declaration != formal ||
                    facts[subject].reception != borrowed_ref() || facts[subject].target_readonly == 0u8 ||
                    facts[subject].owner != facts[formal].owner ||
                    facts[subject].identity_module != facts[formal].identity_module ||
                    facts[subject].identity != facts[formal].identity)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            FieldLoanCaseSubject { val expression <-, val receiver <-, val count <-, } -> {
                if (expression != subject || receiver >= subject || count == 0u64 ||
                    facts[subject].selection != subject || facts[subject].reception != borrowed_ref() ||
                    facts[subject].target_readonly == 0u8 || facts[subject].target_presence != present_target() ||
                    facts[subject].owner == no_node() || facts[subject].owner != facts[receiver].owner)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            ReceiptCaseSubject {
                val expression <- expression, val receipt <- receipt, val arm <- arm, val count <- count,
            } -> {
                if (expression != subject || count == 0u64 || receipt >= subject ||
                    facts[subject].case_receipt != receipt || facts[receipt].case_context != arm ||
                    !receipt_in_context(facts, subject, receipt) ||
                    facts[subject].owner != facts[receipt].owner ||
                    facts[subject].reception != borrowed_ref() || facts[subject].target_readonly == 0u8)
                    return operand_problem(report, at, invalid_operand_tree());
                coverage.total <- count;
                (coverage.remaining <- count):void
            };
            _ -> { return operand_problem(report, at, invalid_operand_tree()) }
        }
    } else {
        if (!initialize_case_coverage(nodes, names, links, facts, interfaces, published, at, subject, coverage, used, revision))
            return operand_problem(report, at, invalid_operand_tree())
    };
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, selection.items, BlockSequence, item))
        return operand_problem(report, at, invalid_operand_tree());
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    val cursor <- subject + 1u64;
    val last_exit <- no_node();
    val expression <- no_node();
    val reached <- false;
    val context <- no_node();
    val member <- no_node();
    val diagnostic <- 0u8;
    val mode <- AnyCaseTarget;
    for (unused in 0u64 .. used) {
        if (item == no_node()) {
            restore_case_exclusions(facts, coverage);
            if (!completed) { set_result(facts, at, never_result()); return true; } else {};
            if (case_has_paths(coverage)) {
                if (scalar_kind(facts[at].kind)) return operand_problem(report, at, incomplete_value_case());
                facts[at].case_end <- 1u8;
                only_void(facts, at);
                return true;
            } else {};
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return true;
        } else {};
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence)
            return operand_problem(report, at, invalid_operand_tree());
        expression <- entry.item;
        reached <- case_has_paths(coverage);
        if (!reached) { (facts[item].case_item <- unreachable_case_item()):void; } else {};
        if (inspect_case_arm(nodes, revision, used, expression, arm)) {
            mode <- case_pattern(nodes, used, arm.pattern);
            diagnostic <- prepare_case_pattern(source, nodes, names, links, facts, cases,
                at, subject, arm.pattern, mode, member, used, revision);
            if (diagnostic != 0u8)
                return operand_problem(report, if (mode == ReferenceCaseTarget) { (arm.pattern) } else { at }, diagnostic);
            if (reached) { match_case_arm(facts, coverage, subject, expression, member, mode); } else {};
            context <- enter_case_context(facts, outer, expression);
            if (!check_operand_range(source, nodes, names, links, selected, facts, interfaces, published, owners, fields,
                views, products, arguments, cases, demand, report,
                                     cursor, item, used, revision, context)) return false;
            diagnostic <- finish_case_arm(nodes, links, facts, coverage, at, expression, member, borrowed, used, revision, arm, mode);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, arm.guard,
                                            facts[expression].case_match != misses_case_arm(), used, revision);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            (diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, arm.body,
                                             facts[expression].case_body != 0u8, used, revision)):void;
        } else {
            if (reached) {
                facts[item].case_presence <- case_presence(coverage.remaining != 0u64, coverage.absent);
                (facts[item].case_selection <- facts[subject].selection):void;
            } else {};
            context <- enter_case_context(facts, outer, item);
            if (!check_operand_range(source, nodes, names, links, selected, facts, interfaces, published, owners, fields,
                views, products, arguments, cases, demand, report,
                                     cursor, item, used, revision, context)) return false;
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, expression, reached, used, revision);
            if (reached) {
                if (facts[expression].kind == never_result()) {
                    coverage.remaining <- 0u64;
                    (coverage.absent <- false):void;
                } else {
                    if (borrowed && coverage.remaining != 0u64 && case_may_write(nodes, links, expression, used, revision)) {
                        reopen_case_domain(coverage, item);
                    } else {};
                };
            } else {};
        };
        if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
        check_sequence_item(nodes, facts, item, entry, false);
        cursor <- item + 1u64;
        item <- links[item].next;
    };
    return operand_problem(report, at, invalid_operand_tree());
}

func record_case_exit(facts:OperandFacts in F, at:UInt64, destination:UInt64) -> void where {owner F} {
    val prior <- facts[destination].case_exit_tail;
    if (prior == no_node()) { (facts[destination].case_exit_link <- at):void; }
    else { (facts[prior].case_exit_link <- at):void; };
    facts[destination].case_exit_tail <- at;
    set_result(facts, at, never_result());
    return;
}

func check_logical(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, logical:const LogicalSites in L) -> UInt8
    where {const owner N, owner F, const owner L} {
    val left <- logical.left_operand;
    val abrupt <- facts[left].kind == never_result();
    val diagnostic <- 0u8;
    if (!abrupt) {
        diagnostic <- require_typed_bits(nodes, facts, left, scalar_bool());
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    val right <- logical.right_operand;
    if (right != no_node()) {
        if (facts[right].kind == never_result()) {
            (abrupt <- abrupt || logical.right_evaluation == TakesRhs):void;
        } else {
            diagnostic <- require_typed_bits(nodes, facts, right, scalar_bool());
            if (diagnostic != 0u8) return diagnostic;
        };
    } else {};
    set_result(facts, at, if (abrupt) { never_result() } else { scalar_bool() });
    return 0u8;
}

func merge_guard_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, arm:UInt64, discard:bool) -> UInt8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (discard && (scalar_kind(kind) || immutable_text_kind(kind)))
        return merge_result(facts, at, void_result(), 0u64, 0u64);
    if (facts[at].arm_result == 0u8 || !scalar_kind(kind)) return merge_result(facts, at, kind, facts[arm].identity, facts[arm].identity_module);
    if (facts[arm].reception == nullable_ptr() && facts[at].discarded_result == 0u8)
        return unproved_nonnull_borrow();
    # A native result slot can hold either bits or a target. A guard with
    # both would need to retain that distinction until its finalizer exits.
    if (scalar_kind(facts[at].kind) &&
        ((facts[at].reception == independent_value()) != (facts[arm].reception == independent_value())))
        return unproved_result_contract();
    return merge_arm_result(nodes, facts, at, arm, true);
}

func check_try_result(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F, at:UInt64,
                      used:UInt64, revision:UInt64, protected:const ProtectedSites in P) -> UInt8
    where {const owner N, const owner L, owner F, const owner P} {
    val discard <- protected.discarded || facts[at].discarded_result == loop_discard();
    val diagnostic <- merge_guard_result(nodes, facts, at, protected.body, discard);
    if (diagnostic != 0u8) return diagnostic;
    ref clause = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, protected.clauses, ClauseSequence, clause)) return invalid_operand_tree();
    ref sites = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    val shape <- InvalidGuardClause;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) {
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return 0u8;
        };
        shape <- inspect_guard_clause(nodes, revision, used, clause, sites);
        if (shape == HandlerClause) {
            if (!inspect_handler(nodes, revision, used, sites.target, handler)) return invalid_operand_tree();
            diagnostic <- merge_guard_result(nodes, facts, at, handler.body, discard);
            if (diagnostic != 0u8) return diagnostic;
        } else {
            if (shape != CleanupClause) return invalid_operand_tree();
            if (facts[sites.target].kind == never_result()) {
                set_result(facts, at, never_result());
                return 0u8;
            };
            if (facts[sites.target].kind != void_result()) return wrong_finally_result();
        };
        clause <- links[clause].next;
    };
    return unproved_result_contract();
}

func check_catch_clause(nodes:const ExprNodes in N, facts:const OperandFacts in F, at:UInt64,
                        used:UInt64, revision:UInt64, clause:GuardClauseSites in C) -> UInt8
    where {const owner N, const owner F, owner C} {
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (!inspect_handler(nodes, revision, used, clause.target, handler)) return invalid_operand_tree();
    val identity <- facts[handler.binding].identity;
    val module <- facts[handler.binding].identity_module;
    val category <- if (identity == no_node()) { exception_root_identity() } else { identity };
    val previous <- clause.previous;
    for (unused in 0u64 .. at) {
        if (previous == no_node()) return 0u8;
        if (inspect_guard_clause(nodes, revision, used, previous, clause) != HandlerClause ||
            !inspect_handler(nodes, revision, used, clause.target, handler)) return invalid_operand_tree();
        identity <- facts[handler.binding].identity;
        if (module == facts[handler.binding].identity_module &&
            category == (if (identity == no_node()) { exception_root_identity() }
                else { identity }))
            return duplicate_catch_category();
        previous <- clause.previous;
    };
    return 0u8;
}

func check_scope_tail(facts:OperandFacts in F, scope:UInt64, tail:UInt64) -> UInt8 where {owner F} {
    val identity <- if (tail == no_node()) { 0u64 } else { (facts[tail].identity) };
    val module <- if (tail == no_node()) { 0u64 } else { (facts[tail].identity_module) };
    val diagnostic <- merge_result(facts, scope, sequence_result(facts, tail), identity, module);
    if (diagnostic == 0u8 && facts[scope].kind == 0u8) {
        if (facts[scope].case_resume != 0u8) { set_result(facts, scope, never_result()); }
        else { only_void(facts, scope); };
    } else {};
    return diagnostic;
}

export func has_value_tail(facts:const OperandFacts in F, body:UInt64, function_form:bool) -> bool where {const owner F} {
    return function_form && body != no_node() && scalar_kind(facts[body].kind);
}

func check_callable_tail(facts:const OperandFacts in F, definition:UInt64, callable:const CallableSites in C) -> UInt8
    where {const owner F, const owner C} {
    if (!callable.function_form || facts[definition].omitted_result) return 0u8;
    val kind <- facts[callable.body].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (scalar_kind(kind) && facts[definition].kind == void_result()) return value_tail_in_void_function();
    if (scalar_kind(kind) && !same_operand_type(facts, callable.body, definition) &&
        (facts[definition].reception != independent_value() ||
         !supplies_enum_backing(facts, callable.body, facts[definition].kind))) return wrong_return_type();
    return 0u8;
}

func validate_return(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                   at:UInt64, value:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B, owner F} {
    val scope <- names[at].scope;
    ref tail = make UInt64 { no_node() };
    if (module_tail(nodes, revision, used, scope, tail)) return wrong_return_type();
    if (is_scope_block(nodes, scope) && block_tail(nodes, revision, used, scope, tail)) {
        val identity <- if (value == no_node()) { 0u64 } else { (facts[value].identity) };
        val module <- if (value == no_node()) { 0u64 } else { (facts[value].identity_module) };
        return merge_result(facts, scope, result_kind(nodes, facts, value, true), identity, module);
    } else {};
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val form <- inspect_callable(nodes, revision, used, scope, callable);
    val result_site <- scope;
    if (form != ModuleCallable && form != LexicalCallable && form != CEntry) {
        ref handler = make ScopedProcedureSites { head <- no_node(); signature <- no_node(); body <- no_node() };
        if (!inspect_scoped_procedure(nodes, revision, used, scope, handler)) return unproved_result_contract();
        (result_site <- handler.head):void
    };
    if (facts[result_site].omitted_result) {
        if (value == no_node() || facts[value].kind == never_result() || facts[value].kind == void_result()) return 0u8;
        return wrong_return_type()
    };
    if (facts[result_site].kind == 0u8)
        return unproved_result_contract();
    if (value != no_node() && facts[value].kind == never_result()) return 0u8;
    if (facts[result_site].kind == void_result()) {
        if (value != no_node() && facts[value].kind != void_result()) return wrong_return_type();
        return 0u8;
    } else {};
    if (value == no_node()) return wrong_return_type();
    if (facts[result_site].kind == independent_sum_bits()) {
        return if (facts[value].kind == independent_sum_bits() && facts[value].reception == independent_value() &&
            facts[value].identity == facts[result_site].identity && facts[value].identity_module == facts[result_site].identity_module) {
            0u8
        } else { wrong_return_type() }
    };
    if (facts[result_site].kind == product_kind()) {
        if (!same_operand_type(facts, value, result_site) || facts[value].reception != borrowed_ref())
            return wrong_return_type();
        if (facts[value].owner != facts[result_site].owner)
            return owner_conflict(nodes, facts[value].owner, facts[result_site].owner);
        if (facts[value].target_readonly != 0u8 && facts[result_site].target_readonly == 0u8)
            return expected_writable_place();
        return 0u8;
    };
    if (immutable_text_kind(facts[result_site].kind)) {
        if (!immutable_text_kind(facts[value].kind) ||
            (facts[result_site].kind == c_string_kind() && facts[value].kind != c_string_kind()))
            return wrong_return_type();
        if (facts[value].owner != facts[result_site].owner) return wrong_text_result_owner();
        return 0u8;
    };
    val kind <- facts[result_site].kind;
    val diagnostic <- if (kind == source_u32() && !supplies_enum_backing(facts, value, kind)) {
        require_source_u32(nodes, facts, value, true)
    } else {
        if (facts[result_site].reception == independent_value()) {
            require_matching_value_bits(nodes, facts, value, result_site)
        } else {
            if (!compatible_operand_nominal(facts, value, kind, facts[result_site].identity, facts[result_site].identity_module))
                { wrong_operand_type() }
            else { require_typed_bits(nodes, facts, value, kind) }
        }
    };
    if (diagnostic == wrong_operand_type()) return wrong_return_type();
    return diagnostic;
}

func check_return(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                   at:UInt64, value:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B, owner F} {
    val diagnostic <- validate_return(nodes, names, facts, at, value, used, revision);
    if (diagnostic == 0u8) { set_result(facts, at, never_result()); };
    return diagnostic;
}

func check_group(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, inner:UInt64) -> UInt8
    where {const owner N, owner F} {
    val kind <- facts[inner].kind;
    if (kind == product_kind()) return unsupported_product_layout();
    if (kind == void_result() || kind == never_result() || kind == exception_type() || immutable_text_kind(kind) ||
        has_slot_array(facts, inner) || facts[inner].reception == nullable_ptr()) {
        copy_fact(facts, at, inner);
        return 0u8;
    };
    if (scalar_kind(kind) && facts[at].discarded_result != 0u8) {
        set_bits_result(facts, at, inner);
        return 0u8;
    };
    val diagnostic <- if (kind == source_u32()) { require_source_u32(nodes, facts, inner, false) }
        else { require_typed_bits(nodes, facts, inner, kind) };
    if (diagnostic != 0u8) return diagnostic;
    set_bits_result(facts, at, inner);
    return 0u8;
}

func check_numeric_expression(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64,
    binary:const BinarySites in B, source_only:bool) -> UInt8
    where {const owner N, owner F, const owner B} {
    val left <- binary.left_operand;
    val right <- binary.right_operand;
    val left_completes <- facts[left].kind != never_result();
    val right_completes <- facts[right].kind != never_result();
    val left_kind <- if (source_only && facts[left].kind == scalar_u8()) { scalar_u8() } else { scalar_u64() };
    val right_kind <- if (source_only && facts[right].kind == scalar_u8()) { scalar_u8() } else { scalar_u64() };
    val left_diagnostic <- if (left_completes) { require_typed_bits(nodes, facts, left, left_kind) } else { 0u8 };
    if (left_diagnostic != 0u8) return left_diagnostic;
    val right_diagnostic <- if (right_completes) { require_typed_bits(nodes, facts, right, right_kind) } else { 0u8 };
    if (right_diagnostic != 0u8) return right_diagnostic;
    if (!left_completes || !right_completes) { set_result(facts, at, never_result()); }
    else {
        # The operands select the arithmetic width. A destination may widen
        # the completed result without changing where overflow is checked.
        val kind <- if (left_kind == right_kind) { left_kind } else { scalar_u64() };
        set_result(facts, at, kind)
    };
    return 0u8;
}

func check_comparison(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, binary:const BinarySites in B,
    source_only:bool) -> UInt8
    where {const owner N, owner F, const owner B} {
    val left <- binary.left_operand;
    val right <- binary.right_operand;
    val equality <- binary.relation == Equal || binary.relation == Unequal;
    val left_kind <- facts[left].kind;
    val right_kind <- facts[right].kind;
    val byte_order <- source_only &&
        ((left_kind == scalar_u8() && (right_kind == scalar_u8() || supplies_enum_backing(facts, right, scalar_u8()))) ||
         (right_kind == scalar_u8() && supplies_enum_backing(facts, left, scalar_u8())));
    val kind <- if (equality || byte_order) {
        if (supplies_enum_backing(facts, left, right_kind)) { right_kind } else { left_kind }
    } else { scalar_u64() };
    if (!compatible_operand_nominal(facts, right, left_kind, facts[left].identity, facts[left].identity_module))
        return wrong_operand_type();
    val diagnostic <- if (equality || byte_order) { require_value_bits(nodes, facts, left, kind) }
        else { require_typed_bits(nodes, facts, left, kind) };
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- if (equality || byte_order) { require_value_bits(nodes, facts, right, kind) }
        else { require_typed_bits(nodes, facts, right, left_kind) };
    if (diagnostic != 0u8) return diagnostic;
    set_result(facts, at, scalar_bool());
    return 0u8;
}

func check_range_header(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, owner F} {
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_header(nodes, revision, used, at, bounds)) return invalid_operand_tree();
    val lower <- bounds.lower;
    val upper <- bounds.upper;
    val diagnostic <- if (facts[lower].kind != never_result()) { require_bits(nodes, facts, lower) } else { 0u8 };
    if (diagnostic != 0u8) return diagnostic;
    if (facts[upper].kind != never_result()) {
        diagnostic <- require_bits(nodes, facts, upper);
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    # Reads use the current index word. It exposes no writable binding slot.
    set_result(facts, at, scalar_u64());
    return 0u8;
}

func check_range_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, owner F} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_loop(nodes, revision, used, at, loop) ||
        !inspect_range_header(nodes, revision, used, loop.header, bounds)) return invalid_operand_tree();
    val shape <- classify_literal_range(nodes, revision, used, loop.header);
    if (shape == InvalidRange) return invalid_operand_tree();
    val body_continues <- facts[loop.body].kind != never_result();
    val empty_continues <- loop.empty == no_node() || facts[loop.empty].kind != never_result();
    val continues <- case shape of {
        (NonemptyLiteralRange) -> { body_continues };
        (EmptyLiteralRange) -> { empty_continues };
        (_) -> { body_continues || empty_continues };
    };
    if (facts[bounds.lower].kind == never_result() || facts[bounds.upper].kind == never_result() || !continues) {
        set_result(facts, at, never_result());
    } else { only_void(facts, at); };
    return 0u8;
}

func check_explicit_discard(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, operand:UInt64) -> UInt8
    where {const owner N, owner F} {
    if (has_slot_array(facts, operand)) { only_void(facts, at); return 0u8 };
    if (facts[operand].reception == nullable_ptr() &&
        (facts[operand].kind == source_product_loan() || facts[operand].kind == source_sum_target())) {
        only_void(facts, at);
        return 0u8
    };
    val kind <- result_kind(nodes, facts, operand, false);
    if (kind == 0u8) return unproved_operand();
    set_result(facts, at, if (kind == never_result()) { kind } else { void_result() });
    return 0u8;
}

func check_enum_assertion(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                          at:UInt64, operand:UInt64, source_only:bool) -> UInt8
    where {const owner N, const owner L, owner F} {
    val mode <- links[at].enum_assertion;
    if (mode == ConstantEnumAssertion) {
        set_fact(facts, at, scalar_enum(), independent_value(), no_node(), links[at].value_identity, 0u8);
        facts[at].identity_module <- links[at].value_module;
        facts[at].enum_constant <- 1u8;
        facts[at].discriminator_code <- links[at].enum_code;
        return 0u8
    };
    if (mode != ValueEnumAssertion) return unsupported_scalar_assertion();
    if (facts[operand].kind == scalar_enum() &&
        (facts[operand].identity_module != links[at].value_module || facts[operand].identity != links[at].value_identity))
        return incompatible_enum_type();
    if (facts[operand].kind == never_result() || facts[operand].kind == scalar_enum()) {
        copy_fact(facts, at, operand);
        return 0u8
    };
    val backing <- source_scalar_kind(links[at].enum_backing);
    if (!source_only && backing == source_u32()) return unsupported_narrow_execution();
    val issue <- if (backing == source_u32()) { require_source_u32(nodes, facts, operand, false) }
        else { require_typed_bits(nodes, facts, operand, backing) };
    if (issue != 0u8) return issue;
    set_fact(facts, at, scalar_enum(), independent_value(), no_node(), links[at].value_identity, 0u8);
    facts[at].identity_module <- links[at].value_module;
    facts[at].enum_assertion_check <- true;
    return 0u8
}

func check_bound_name(names:const NameBindings in B, links:const NameWork in L,
                     facts:OperandFacts in F, views:const SuppliedViews in H, at:UInt64)
    -> UInt8 where {const owner B, const owner L, owner F, const owner H} {
    val binding <- names[at].kind;
    if (binding == enum_value() && links[at].value_kind == enum_type() &&
        links[at].value_module != 0u64 && links[at].value_identity != no_node()) {
        set_fact(facts, at, scalar_enum(), independent_value(), no_node(), links[at].value_identity,
            0u8);
        facts[at].identity_module <- links[at].value_module;
        facts[at].enum_constant <- 1u8;
        facts[at].discriminator_code <- links[at].enum_code;
        return 0u8
    };
    if (binding == formal_binding() || binding == local_binding() || binding == exception_binding() ||
        binding == loop_index()) {
        val declaration <- names[at].declaration;
        copy_fact(facts, at, declaration);
        if (facts[declaration].array_slot == declaration) {
            (facts[at].array_slot <- declaration):void
        };
        if (binding == formal_binding()) {
            (facts[at].writable_text_place <- facts[names[at].declaration].writable_text_place):void;
        };
    } else {
        if (binding == here_receiver_binding() && names[at].declaration < intrinsic (len)(views)) {
            case views[names[at].declaration] of {
                (SuppliedArrayView { val module <- type_module, val identity <- type_identity,
                                     val role <- owner_role, val readonly <- readonly, }) -> {
                    set_fact(facts, at, source_array_loan(), borrowed_ref(), role, identity, 0u8);
                    facts[at].identity_module <- module;
                    (facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 }):void
                };
                (OrdinaryHereReceiver { val kind <-, }) -> {
                    set_result(facts, at, source_scalar_kind(kind))
                };
                _ -> {}
            }
        }
    };
    return 0u8;
}

func record_case_fallthrough(nodes:const ExprNodes in N, names:const NameBindings in B,
                             facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, owner F} {
    val arm <- names[at].declaration;
    val scope <- names[at].scope;
    ref sites = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (!inspect_case_arm(nodes, revision, used, arm, sites)) return invalid_operand_tree();
    record_case_exit(facts, at, arm);
    if (sites.body == scope && is_scope_block(nodes, scope)) {
        (facts[scope].case_resume <- case_resumes_after_cleanup()):void;
    } else {};
    return 0u8;
}

func record_case_break(nodes:const ExprNodes in N, names:const NameBindings in B,
                       facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, owner F} {
    val target <- names[at].declaration;
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, revision, used, target, selection)) return unproved_operand();
    record_case_exit(facts, at, target);
    return 0u8;
}

func check_native_here_value(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:OperandFacts in F,
                             at:UInt64, call:const NodeId in C, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner L, owner F, const owner C} {
    if (!published_syntax_id(nodes, revision, used, call) ||
        links[call.index].expects_here == 0u8 || facts[call.index].kind == 0u8)
        return unproved_call_target();
    ref here = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, at,
        here) != HereReady) return invalid_operand_tree();
    copy_fact(facts, at, call.index);
    return 0u8
}

func check_ordinary_here_exit(nodes:const ExprNodes in N, links:const NameWork in L,
    facts:OperandFacts in F, views:const SuppliedViews in H, target:UInt64, at:UInt64,
    used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner L, owner F, const owner H} {
    val supplied <- target;
    ref actual = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false
    };
    if (case views[target] of { OrdinaryHereWrapper -> true; _ -> false }) {
        if (inspect_here_invocation(nodes, revision, used, target, actual) != HereReady) return invalid_operand_tree();
        (supplied <- actual.supplied):void
    };
    val formal <- no_node();
    val call <- no_node();
    case views[supplied] of {
        OrdinaryHereBody { val selected <- formal, val origin <- call, } -> {
            formal <- selected;
            (call <- origin):void
        };
        _ -> { return unproved_call_target() }
    };
    ref contract = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    val value <- no_node();
    if (!completion_operand(nodes, revision, used, at, value) ||
        !inspect_here_contract(views, formal, contract)) return invalid_operand_tree();
    val kind <- if (completion_syntax(nodes, at) == ContinueCompletion) {
        (contract.result_kind)
    } else { (links[call].value_kind) };
    val diagnostic <- check_here_result(nodes, facts, value, kind);
    if (diagnostic == 0u8) { set_result(facts, at, never_result()) };
    return diagnostic
}

func check_ordinary_here_body(nodes:const ExprNodes in N, facts:OperandFacts in F,
    views:const SuppliedViews in H, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, owner F, const owner H} {
    val formal <- case views[at] of {
        OrdinaryHereBody { val expected <- formal, } -> expected;
        _ -> no_node()
    };
    if (formal == no_node()) return 0u8;
    ref actual = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false
    };
    ref contract = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    if (!inspect_here_actual(nodes, revision, used, at, actual) ||
        !inspect_here_contract(views, formal, contract)) return invalid_operand_tree();
    if (actual.full_scope || contract.result_kind != builtin_void()) {
        val diagnostic <- check_here_result(nodes, facts, actual.body, contract.result_kind);
        if (diagnostic != 0u8) return diagnostic
    };
    only_void(facts, at);
    return 0u8
}

func ordinary_here_site(views:const SuppliedViews in V, at:UInt64) -> bool where {const owner V} {
    return at < intrinsic (len)(views) && (case views[at] of {
        OrdinaryHereBody -> true;
        OrdinaryHereWrapper -> true;
        _ -> false
    })
}

func check_break(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, views:const SuppliedViews in H, at:UInt64, used:UInt64, revision:UInt64)
    -> UInt8 where {const owner N, const owner B, const owner L, owner F, const owner H} {
    val target <- names[at].declaration;
    if (ordinary_here_site(views, target)) return check_ordinary_here_exit(nodes, links, facts, views, target, at, used, revision);
    return record_case_break(nodes, names, facts, at, used, revision)
}

func check_here_continue(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L,
                         facts:OperandFacts in F, views:const SuppliedViews in H,
                         at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner H} {
    val target <- names[at].declaration;
    if (target >= used) return unproved_call_target();
    if (ordinary_here_site(views, target))
        return check_ordinary_here_exit(nodes, links, facts, views, target, at, used, revision);
    ref invocation = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node();
            full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, target, invocation) != HereReady ||
        links[invocation.call].expects_here == 0u8) return unproved_call_target();
    val value <- no_node();
    if (!completion_operand(nodes, revision, used, at, value) || value == no_node())
        return wrong_return_type();
    val kind <- declared_scalar(links[target].value_kind);
    if (facts[value].kind != never_result()) {
        val error <- require_typed_bits(nodes, facts, value, kind);
        if (error != 0u8) return error;
        if (kind == scalar_enum() &&
            (facts[value].identity_module != links[target].value_module ||
             facts[value].identity != links[target].value_identity)) return incompatible_enum_type()
    };
    set_result(facts, at, never_result());
    return 0u8
}

func receive_case_bits(facts:OperandFacts in F, at:UInt64, type:const DeclaredType in T,
    reception:UInt8, owner_site:UInt64) -> UInt8 where {owner F, const owner T} {
    val kind <- if (type.kind == record_type()) { received_product() }
                else { source_scalar_kind(type.kind) };
    if (kind == 0u8) return unsupported_case_pattern();
    set_fact(facts, at, kind, reception, owner_site, type.identity, 0u8);
    facts[at].identity_module <- type.defining_module;
    return 0u8
}

func check_indexed_case_subject(nodes:const ExprNodes in N, facts:OperandFacts in F,
    at:UInt64, expression:UInt64, array_site:UInt64, index:UInt64, owner_site:UInt64, array_module:UInt64,
    declared_array:UInt64,
    schema:const DeclaredType in T) -> UInt8 where {const owner N, owner F, const owner T} {
    if (expression != at || array_site >= at || index >= at) return invalid_operand_tree();
    if (facts[array_site].kind == never_result() || facts[index].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (facts[array_site].kind != source_array_loan() || facts[array_site].reception != borrowed_ref() ||
        facts[array_site].owner != owner_site || facts[array_site].identity_module != array_module ||
        facts[array_site].identity != declared_array || facts[array_site].target_presence != present_target())
        return unsupported_case_subject();
    val diagnostic <- require_typed_bits(nodes, facts, index, scalar_u64());
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, source_sum_target(), borrowed_ref(), owner_site, schema.identity, 0u8);
    facts[at].identity_module <- schema.defining_module;
    facts[at].target_readonly <- 1u8;
    facts[at].checks_array_bounds <- true;
    return 0u8
}

func check_slot_array_index(nodes:const ExprNodes in N, facts:OperandFacts in F,
    at:UInt64, target:UInt64, index:UInt64, destination:bool) -> UInt8 where {const owner N, owner F} {
    if (facts[target].kind == never_result() || facts[index].kind == never_result()) {
        set_result(facts, at, never_result());
        facts[at].checks_array_bounds <- true;
        return 0u8
    };
    if (!has_slot_array(facts, target) || facts[target].reception != borrowed_ref() ||
        facts[target].target_presence != present_target() || facts[target].owner == no_node())
        return unproved_nonnull_borrow();
    val element_identity <- facts[target].array_element_identity;
    val element_kind <- facts[target].array_scalar;
    val diagnostic <- if (element_kind == scalar_u8()) { require_bits(nodes, facts, index) } else {
        if (element_kind != 0u8) { require_typed_bits(nodes, facts, index, scalar_u64()) }
        else { require_widening_u64(nodes, facts, index) }
    };
    if (diagnostic != 0u8) return diagnostic;
    if (destination) {
        if (facts[target].target_readonly != 0u8) return expected_writable_place();
        if (element_kind != 0u8) {
            set_fact(facts, at, element_kind, borrowed_ref(), facts[target].owner,
                if (element_kind == scalar_enum()) { element_identity } else { 0u64 }, 0u8)
        } else {
            set_fact(facts, at, source_sum_target(), borrowed_ref(), facts[target].owner, element_identity, 0u8);
            (facts[at].selection <- at):void
        }
    } else {
        if (element_kind != 0u8) {
            set_fact(facts, at, element_kind, independent_value(), no_node(),
                if (element_kind == scalar_enum()) { element_identity } else { 0u64 }, 0u8)
        } else { set_fact(facts, at, independent_sum_bits(), independent_value(), no_node(), element_identity, 0u8) }
    };
    facts[at].identity_module <- facts[target].array_element_module;
    facts[at].checks_array_bounds <- true;
    return 0u8
}

func check_slot_sum_transfer(cases:const ConstructorCaseFacts in C, facts:OperandFacts in F,
    at:UInt64, destination:UInt64, input:UInt64) -> UInt8 where {const owner C, owner F} {
    if (facts[destination].kind != source_sum_target() || facts[destination].selection != destination ||
        facts[destination].target_readonly != 0u8 || facts[input].kind != independent_sum_bits() ||
        facts[input].reception != independent_value() ||
        facts[input].identity != facts[destination].identity ||
        facts[input].identity_module != facts[destination].identity_module) return wrong_operand_type();
    if (!facts[input].checks_array_bounds && (input >= intrinsic (len)(cases) ||
        (case cases[input] of {
            BitsConstruction { val transfer <-, } -> transfer != at;
            _ -> true
        }))) return unsupported_transfer_signature();
    if (facts[at].discarded_result == 0u8) return unsupported_transfer_signature();
    only_void(facts, at);
    return 0u8
}

func check_byte_read(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64, array_site:UInt64, index:UInt64,
    formal:UInt64, owner_site:UInt64, expected_module:UInt64, expected_identity:UInt64) -> UInt8
    where {const owner N, const owner B, owner F} {
    ref syntax = make IndexSites { target <- no_node(); index <- no_node() };
    if (!inspect_index_selection(nodes, revision, used, at, syntax) ||
        syntax.target != array_site || syntax.index != index || formal >= used ||
        names[array_site].kind != formal_binding() || names[array_site].declaration != formal)
        return invalid_operand_tree();
    if (facts[array_site].kind == never_result() || facts[index].kind == never_result()) {
        set_result(facts, at, never_result());
        facts[at].checks_array_bounds <- true;
        return 0u8
    };
    if (facts[array_site].kind != source_array_loan() || facts[array_site].reception != borrowed_ref() ||
        facts[array_site].owner != owner_site || facts[array_site].identity_module != expected_module ||
        facts[array_site].identity != expected_identity || facts[array_site].target_readonly == 0u8)
        return unproved_operand();
    val diagnostic <- require_typed_bits(nodes, facts, index, scalar_u64());
    if (diagnostic != 0u8) return diagnostic;
    set_result(facts, at, scalar_u8());
    facts[at].checks_array_bounds <- true;
    return 0u8
}

func check_case_receipt(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
    at:UInt64, used:UInt64, revision:UInt64, header:UInt64, pattern:UInt64, schema:const DeclaredType in T) -> UInt8
    where {const owner N, const owner B, owner F, const owner T} {
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    if (facts[at].case_context != header || !inspect_case_arm(nodes, revision, used, header, arm) ||
        arm.pattern != pattern || names[at].scope == no_node()) return invalid_operand_tree();
    if (schema.kind == sum_type()) {
        set_fact(facts, at, received_sum(), local_place(), names[at].scope, schema.identity, 0u8);
        facts[at].identity_module <- schema.defining_module;
        facts[at].case_receipt <- at;
        return 0u8
    };
    val diagnostic <- receive_case_bits(facts, at, schema, local_place(), names[at].scope);
    if (diagnostic == 0u8 && schema.kind == record_type()) { (facts[at].case_receipt <- at):void };
    return diagnostic
}

func select_received_case_subject(names:const NameBindings in B, facts:OperandFacts in F,
    at:UInt64, receipt:UInt64, arm:UInt64, schema:const DeclaredType in T) -> UInt8
    where {const owner B, owner F, const owner T} {
    if (receipt >= at || names[at].kind != local_binding() || names[at].declaration != receipt ||
        facts[receipt].case_context != arm || !receipt_in_context(facts, at, receipt) ||
        facts[receipt].kind != received_sum() || facts[receipt].reception != local_place() ||
        facts[receipt].case_receipt != receipt || facts[receipt].owner == no_node() ||
        facts[receipt].owner != names[receipt].scope || schema.kind != sum_type() ||
        facts[receipt].identity_module != schema.defining_module || facts[receipt].identity != schema.identity)
        return unsupported_case_subject();

    set_fact(facts, at, source_sum_target(), borrowed_ref(), facts[receipt].owner, schema.identity, 0u8);
    facts[at].identity_module <- schema.defining_module;
    facts[at].case_receipt <- receipt;
    facts[at].target_readonly <- 1u8;
    return 0u8
}

func check_case_projection(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64, receiver:UInt64, field:UInt64,
    receipt:UInt64, arm:UInt64, record:const DeclaredType in R, sum:const DeclaredType in S) -> UInt8
    where {const owner N, const owner B, owner F, const owner R, const owner S} {
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    if (!inspect_field_selection(nodes, revision, used, at, projection) ||
        projection.receiver != receiver || projection.field != field ||
        receiver >= at || receipt >= receiver || names[receiver].kind != local_binding() ||
        names[receiver].declaration != receipt || facts[receiver].case_receipt != receipt ||
        facts[receiver].kind != received_product() || facts[receiver].reception != local_place() ||
        facts[receiver].identity != record.identity ||
        facts[receiver].identity_module != record.defining_module ||
        facts[receipt].case_context != arm || !receipt_in_context(facts, at, receipt))
        return unsupported_case_subject();
    set_fact(facts, at, source_sum_target(), borrowed_ref(), facts[receiver].owner, sum.identity, 0u8);
    facts[at].identity_module <- sum.defining_module;
    facts[at].case_receipt <- receipt;
    facts[at].target_readonly <- 1u8;
    return 0u8
}

func check_inline_product_field(nodes:const ExprNodes in N, facts:OperandFacts in F,
    at:UInt64, used:UInt64, revision:UInt64, receiver:UInt64, field:UInt64, ordinal:UInt64, readonly:bool,
    writable:bool, record:const DeclaredType in R, result:const DeclaredType in T) -> UInt8
    where {const owner N, owner F, const owner R, const owner T} {
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    if (!inspect_field_selection(nodes, revision, used, at, projection) ||
        projection.receiver != receiver || projection.field != field || receiver >= at ||
        ordinal == no_node() || record.kind != record_type()) return invalid_operand_tree();
    val kind <- facts[receiver].kind;
    if (kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if ((kind != source_product_loan() && kind != product_kind()) ||
        facts[receiver].reception != borrowed_ref() || facts[receiver].owner == no_node() ||
        facts[receiver].target_presence != present_target() ||
        facts[receiver].identity != record.identity ||
        facts[receiver].identity_module != record.defining_module) return unsupported_product_layout();
    if (result.kind == record_type() || result.kind == sum_type()) {
        val loan_kind <- if (result.kind == record_type()) { source_product_loan() } else { source_sum_target() };
        set_fact(facts, at, loan_kind, borrowed_ref(), facts[receiver].owner, result.identity, 0u8);
        facts[at].selection <- at;
        facts[at].identity_module <- result.defining_module;
        facts[at].target_readonly <- if (writable && !readonly) { (facts[receiver].target_readonly) } else { 1u8 };
        return 0u8
    };
    val field_kind <- source_scalar_kind(result.kind);
    if (field_kind == 0u8) return unsupported_product_layout();
    # Only a scalar field of a writable product needs a place receipt.
    if (facts[receiver].target_readonly == 0u8) {
        set_fact(facts, at, field_kind, borrowed_ref(), facts[receiver].owner, result.identity, 0u8);
        (facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 }):void
    } else {
        set_fact(facts, at, field_kind, independent_value(), no_node(), result.identity, 0u8)
    };
    facts[at].identity_module <- result.defining_module;
    return 0u8
}

func check_case_product_field(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64, receiver:UInt64, field:UInt64, ordinal:UInt64,
    record:const DeclaredType in R, result:const DeclaredType in T, source_only:bool) -> UInt8
    where {const owner N, const owner B, owner F, const owner R, const owner T} {
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    if (!inspect_field_selection(nodes, revision, used, at, projection) ||
        projection.receiver != receiver || projection.field != field || receiver >= at ||
        ordinal == no_node() || record.kind != record_type()) return invalid_operand_tree();
    val receipt <- facts[receiver].case_receipt;
    val actual_owner <- facts[receiver].owner;
    if (receipt >= receiver || actual_owner == no_node() || actual_owner != facts[receipt].owner ||
        actual_owner != names[receipt].scope || facts[receipt].kind != received_product() ||
        facts[receipt].reception != local_place() || facts[receipt].case_receipt != receipt ||
        !receipt_in_context(facts, at, receipt) || facts[receiver].identity != record.identity ||
        facts[receiver].identity_module != record.defining_module) return unsupported_product_layout();
    if (facts[receiver].kind == received_product()) {
        if (facts[receiver].reception != local_place() || names[receiver].kind != local_binding() ||
            names[receiver].declaration != receipt) return unsupported_product_layout()
    } else {
        if (facts[receiver].kind != source_product_loan() || facts[receiver].reception != borrowed_ref() ||
            facts[receiver].selection != receiver || facts[receiver].target_readonly == 0u8)
            return unsupported_product_layout()
    };
    if (result.kind != record_type() || !source_only)
        return receive_case_bits(facts, at, result, independent_value(), no_node());
    set_fact(facts, at, source_product_loan(), borrowed_ref(), actual_owner, result.identity, 0u8);
    facts[at].identity_module <- result.defining_module;
    facts[at].case_receipt <- receipt;
    facts[at].selection <- at;
    facts[at].target_readonly <- 1u8;
    return 0u8
}

func check_empty_sum_array_fill(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:OperandFacts in F, views:const SuppliedViews in H,
    at:UInt64, used:UInt64, revision:UInt64, parent:UInt64, sum:UInt64, arm:UInt64) -> UInt8
    where {const owner N, const owner B, owner F, const owner H} {
    if (parent <= at || parent >= used || parent >= intrinsic (len)(views) ||
        arm >= used) return invalid_operand_tree();
    val prepared <- case views[parent] of {
        PreparedArrayConstruction { val fill <-, val element <-, val expected_sum <- element_identity, } ->
            fill == at && element == (SumArrayElement:ArraySlotElement) && expected_sum == sum;
        _ -> false
    };
    if (!prepared) return invalid_operand_tree();
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    ref alternative = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node() };
    ref tail = make UInt64 { no_node() };
    val shape <- inspect_construction(nodes, revision, used, at, syntax);
    if ((shape != BracedConstruction && shape != StorageReservation) ||
        syntax.requested >= at || syntax.placement != no_node() || syntax.queried_operand != no_node() ||
        names[syntax.requested].kind != constructor_type() || names[syntax.requested].declaration != arm ||
        !inspect_sum_arm(nodes, revision, used, arm, alternative) || alternative.fields != no_node() ||
        (shape == BracedConstruction &&
         (!block_tail(nodes, revision, at, syntax.contents, tail) || tail != no_node()))) return invalid_operand_tree();
    set_fact(facts, at, independent_sum_bits(), independent_value(), no_node(), sum, 0u8);
    return 0u8
}

func check_bits_field_value(facts:OperandFacts in F, input:UInt64, type:const DeclaredType in T, binds_storage:bool)
    -> UInt8 where {owner F, const owner T} {
    val kind <- facts[input].kind;
    if (type.kind == record_type() || type.kind == sum_type()) {
        val matches <- if (type.kind == record_type()) {
            kind == product_kind() || kind == received_product() || kind == source_product_loan()
        } else { kind == source_sum_target() || kind == received_sum() };
        val independent <- if (type.kind == record_type()) {
            kind == independent_product_bits()
        } else { kind == independent_sum_bits() };
        if ((!matches && !independent) || facts[input].identity != type.identity ||
            facts[input].identity_module != type.defining_module) return wrong_operand_type();
        if (independent)
            return if (facts[input].reception == independent_value()) { 0u8 } else { wrong_operand_type() };
        if (facts[input].target_presence != present_target() || facts[input].owner == no_node() ||
            (facts[input].reception != borrowed_ref() && facts[input].reception != local_place()))
            return unproved_nonnull_borrow();
        return 0u8
    };
    if (binds_storage) return unproved_operand();
    if (type.kind == builtin_u32()) return require_prepared_source_u32(facts, input, true);
    val result_kind <- declared_scalar(type.kind);
    if (!compatible_operand_nominal(facts, input, result_kind, type.identity, type.defining_module))
        return incompatible_enum_type();
    val read_kind <- if (supplies_enum_backing(facts, input, result_kind)) { scalar_enum() } else { result_kind };
    return require_prepared_typed_bits(facts, input, read_kind)
}

func check_indexed_aggregate_element(facts:OperandFacts in F, at:UInt64, array:UInt64, index:UInt64,
    owner_site:UInt64, array_module:UInt64, array_type:UInt64, element:const DeclaredType in T,
    index_binds_storage:bool, writable:bool)
    -> UInt8 where {owner F, const owner T} {
    if (array >= at || index >= at) return invalid_operand_tree();
    if (facts[array].kind == never_result() || facts[index].kind == never_result()) {
        set_result(facts, at, never_result());
        facts[at].checks_array_bounds <- true;
        return 0u8
    };
    if (facts[array].kind != source_array_loan() || facts[array].reception != borrowed_ref() ||
        facts[array].identity_module != array_module || facts[array].identity != array_type ||
        facts[array].owner != owner_site || facts[array].target_presence != present_target())
        return unproved_nonnull_borrow();
    if (writable && facts[array].target_readonly != 0u8) return expected_writable_place();
    if (index_binds_storage) return unproved_operand();
    val diagnostic <- require_prepared_widening_u64(facts, index);
    if (diagnostic != 0u8) return diagnostic;
    val kind <- if (element.kind == sum_type()) { source_sum_target() } else { source_product_loan() };
    set_fact(facts, at, kind, borrowed_ref(), owner_site, element.identity, 0u8);
    facts[at].identity_module <- element.defining_module;
    facts[at].selection <- at;
    facts[at].target_readonly <- if (writable) { 0u8 } else { 1u8 };
    facts[at].checks_array_bounds <- true;
    return 0u8
}

func check_lexical_bits_reference(facts:OperandFacts in F, at:UInt64, input:UInt64,
    owner_site:UInt64, readonly:bool, value_kind:UInt8, loan_kind:UInt8) -> UInt8 where {owner F} {
    if (input >= at || owner_site == no_node()) return invalid_operand_tree();
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (facts[input].kind != value_kind || facts[input].reception != independent_value())
        return wrong_operand_type();
    set_fact(facts, at, loan_kind, borrowed_ref(), owner_site, facts[input].identity, 0u8);
    facts[at].identity_module <- facts[input].identity_module;
    facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
    return 0u8
}

func check_lexical_sum_rebind(facts:OperandFacts in F, at:UInt64, destination:UInt64,
    input:UInt64, owner_site:UInt64) -> UInt8 where {owner F} {
    if (destination >= at || input >= at) return invalid_operand_tree();
    if (facts[destination].kind == never_result() || facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (facts[destination].kind != source_sum_target() || facts[destination].reception != borrowed_ref() ||
        facts[destination].owner != owner_site || facts[destination].target_presence != present_target())
        return unproved_nonnull_borrow();
    if (facts[input].kind != independent_sum_bits() || facts[input].reception != independent_value() ||
        facts[input].identity != facts[destination].identity ||
        facts[input].identity_module != facts[destination].identity_module) return wrong_operand_type();
    # The slot contract is unchanged on either completion. Its selected
    # backing can differ on paths that complete the rebind.
    set_fact(facts, at, source_sum_target(), borrowed_ref(), owner_site, facts[input].identity, 0u8);
    facts[at].identity_module <- facts[input].identity_module;
    facts[at].target_readonly <- facts[destination].target_readonly;
    return 0u8
}

func check_fixed_reference_record(nodes:const ExprNodes in N, facts:OperandFacts in F, links:const NameWork in L,
    cases:const ConstructorCaseFacts in C, at:UInt64, record:UInt64, owner_site:UInt64,
    count:UInt64, begin:UInt64, last:UInt64, used:UInt64) -> UInt8
    where {const owner N, owner F, const owner L, const owner C} {
    if (record >= used || owner_site >= used) return invalid_operand_tree();
    val item <- begin;
    val ready <- 0u64;
    for (unused in 0u64 .. used) {
        if (item == no_node()) {
            if (ready != count) return missing_product_initializer();
            set_fact(facts, at, source_product_loan(), borrowed_ref(), owner_site, record, 0u8);
            return 0u8
        };
        if (item >= at) return invalid_operand_tree();
        case cases[item] of {
            ReferenceFieldInitializer {
                val parent <- construction, val field <-, val operand <-,
                val target <-, val readonly <-,
            } -> {
                if (parent != at || operand >= item || field >= used) return invalid_operand_tree();
                if (facts[field].last_initializer == at) return repeated_readonly_initializer();
                if (facts[operand].kind == never_result()) {
                    set_result(facts, at, never_result());
                    return 0u8
                };
                if ((if (target.kind == array_type()) { facts[operand].kind != source_array_loan() }
                     else { facts[operand].kind != source_product_loan() && facts[operand].kind != product_kind() }) ||
                    facts[operand].reception != borrowed_ref() ||
                    facts[operand].identity_module != target.defining_module || facts[operand].identity != target.identity)
                    return wrong_operand_type();
                if (facts[operand].target_presence != present_target()) return unproved_nonnull_borrow();
                if (facts[operand].owner != owner_site)
                    return owner_conflict(nodes, owner_site, facts[operand].owner);
                if (!readonly && facts[operand].target_readonly != 0u8) return expected_writable_place();
                facts[field].last_initializer <- at;
                (ready <- ready + 1u64):void
            };
            _ -> { return invalid_operand_tree() }
        };
        if (item == last) { (item <- no_node()):void }
        else {
            if (links[item].next <= item || links[item].next > last) return invalid_operand_tree();
            (item <- links[item].next):void
        }
    };
    return invalid_operand_tree()
}

func check_bits_construction(facts:OperandFacts in F, links:const NameWork in L,
    cases:const ConstructorCaseFacts in C, at:UInt64, type:const DeclaredType in T, count:UInt64,
    begin:UInt64, last:UInt64, used:UInt64) -> UInt8
    where {owner F, const owner L, const owner C, const owner T} {
    val item <- begin;
    val ready <- 0u64;
    val kind <- 0u8;
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (item == no_node()) {
            if (ready != count) return missing_product_initializer();
            kind <- if (type.kind == sum_type()) { independent_sum_bits() } else { independent_product_bits() };
            set_fact(facts, at, kind, independent_value(), no_node(), type.identity, 0u8);
            facts[at].identity_module <- type.defining_module;
            return 0u8
        };
        if (item >= at) return invalid_operand_tree();
        case cases[item] of {
            BitsFieldInitializer {
                val parent <- construction, val ordinal <-, val operand <-, val field <- value_type,
                val readonly <-, val repeated <-, val binds_storage <-,
            } -> {
                if (parent != at || operand >= item || ordinal >= count) return invalid_operand_tree();
                if (readonly && repeated) return repeated_readonly_initializer();
                if (facts[operand].kind == never_result()) {
                    set_result(facts, at, never_result());
                    return 0u8
                };
                diagnostic <- check_bits_field_value(facts, operand, field, binds_storage);
                if (diagnostic != 0u8) return diagnostic;
                if (!repeated) { (ready <- ready + 1u64):void }
            };
            _ -> { return invalid_operand_tree() }
        };
        if (item == last) { (item <- no_node()):void }
        else {
            if (links[item].next <= item || links[item].next > last) return invalid_operand_tree();
            (item <- links[item].next):void
        }
    };
    return invalid_operand_tree()
}

func check_indexed_bits_transfer(names:const NameBindings in B, facts:OperandFacts in F,
    cases:const ConstructorCaseFacts in C, at:UInt64, destination:UInt64, input:UInt64, type:const DeclaredType in T)
    -> UInt8 where {const owner B, owner F, const owner C, const owner T} {
    if (facts[at].discarded_result == 0u8) return unsupported_transfer_signature();
    if (facts[destination].kind == never_result() || facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val target_kind <- if (type.kind == sum_type()) { source_sum_target() } else { source_product_loan() };
    val value_kind <- if (type.kind == sum_type()) { independent_sum_bits() } else { independent_product_bits() };
    if (facts[destination].kind != target_kind || facts[destination].selection != destination ||
        facts[destination].target_readonly != 0u8 || facts[destination].identity_module != type.defining_module ||
        facts[destination].identity != type.identity || !facts[destination].checks_array_bounds ||
        facts[input].identity_module != type.defining_module || facts[input].identity != type.identity)
        return wrong_operand_type();
    val declaration <- names[input].declaration;
    val copied_product <- type.kind == record_type() && type.defining_module == 0u64 &&
        names[input].kind == local_binding() && declaration < input &&
        facts[input].kind == product_kind() && facts[input].target_presence == present_target() &&
        completed_lexical_bits_target(facts, input, names[declaration].scope);
    val indexed_product <- type.kind == record_type() && facts[input].kind == source_product_loan() &&
        facts[input].reception == borrowed_ref() && facts[input].target_presence == present_target() &&
        facts[input].selection == input && facts[input].checks_array_bounds &&
        (case cases[input] of {
            IndexedAggregateLoan { val consumer <-, val writable <-, } -> consumer == at && !writable;
            _ -> false
        });
    if (!copied_product && !indexed_product && (facts[input].kind != value_kind || facts[input].reception != independent_value() ||
        (case cases[input] of { BitsConstruction { val transfer <-, } -> transfer != at; _ -> true })))
        return wrong_operand_type();
    only_void(facts, at);
    return 0u8
}

func check_bits_place_transfer(facts:OperandFacts in F, at:UInt64, destination:UInt64,
    input:UInt64, type:const DeclaredType in T) -> UInt8 where {owner F, const owner T} {
    if (facts[at].discarded_result == 0u8 || input >= at || destination >= at)
        return unsupported_transfer_signature();
    if (facts[destination].kind == never_result() || facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val kind <- facts[destination].kind;
    val aggregate_target <- if (type.kind == sum_type()) { kind == source_sum_target() }
        else { kind == source_product_loan() || kind == product_kind() };
    if (!aggregate_target || facts[destination].reception != borrowed_ref() || facts[destination].target_readonly != 0u8 ||
        facts[destination].target_presence != present_target() || facts[destination].owner == no_node())
        return expected_writable_place();
    if (facts[destination].identity_module != type.defining_module || facts[destination].identity != type.identity)
        return wrong_operand_type();
    val diagnostic <- check_bits_field_value(facts, input, type, false);
    if (diagnostic != 0u8) return diagnostic;
    only_void(facts, at);
    return 0u8
}

func check_imported_array_length(nodes:const ExprNodes in N, interfaces:const ModuleInterfaces in I,
    facts:OperandFacts in F, at:UInt64, first:UInt64, past:UInt64, argument:UInt64, input:UInt64)
    -> UInt8 where {const owner N, const owner I, owner F} {
    if (input >= argument || argument >= at) return invalid_operand_tree();
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    if (facts[input].kind != source_array_loan() || facts[input].reception != borrowed_ref() ||
        facts[input].target_presence != present_target()) return wrong_operand_type();
    val selected <- no_node();
    for (row in first .. past) {
        if (facts[input].identity_module == interfaces[row].type_module &&
            facts[input].identity == interfaces[row].type_identity) {
            if (selected != no_node()) return ambiguous_value_call();
            (selected <- row):void
        }
    };
    if (selected == no_node()) return wrong_operand_type();
    val diagnostic <- check_owner_access(nodes, facts[input].owner, false);
    if (diagnostic != 0u8) return diagnostic;
    copy_fact(facts, argument, input);
    facts[argument].target_readonly <- 1u8;
    scalar_fact(facts, at, independent_value(), no_node());
    return 0u8
}

data GenericCallSignature {
    count:UInt64,
    result:UInt64,
    null_return:UInt64,
    body:UInt64,
    exit:GenericMethodExit,
    function_form:bool,
}
array PreparedGenericOwners[UInt64]:UInt64;

func generic_call_signature(interfaces:const ModuleInterfaces in I, header:UInt64, past:UInt64,
    signature:GenericCallSignature in S) -> bool where {const owner I, owner S} {
    case interfaces[header].payload of {
        GenericCallable { val parameters <-, val constructor_of <-, val method_exit <-, val function_form <-, } -> {
            if (parameters == 0u64 || constructor_of != no_node()) return false;
            signature.count <- parameters;
            signature.function_form <- function_form;
            (signature.exit <- method_exit):void
        };
        _ -> { return false }
    };
    for (row in header + 1u64 .. past) {
        if (signature.body == no_node() && (case interfaces[row].payload of {
            RecipeBodyMake -> true; RecipeBodyStore -> true; RecipeBodyReturn -> true; RecipeBodyCase -> true; RecipeBodyEnd -> true; _ -> false
        })) { (signature.body <- row):void };
        case interfaces[row].payload of {
            RecipeResult -> {
                if (signature.result != no_node()) return false;
                (signature.result <- row):void
            };
            RecipeReturnNull -> {
                if (signature.null_return != no_node()) return false;
                (signature.null_return <- row):void
            };
            _ -> {}
        }
    };
    return signature.result != no_node()
}

func generic_owner_row(interfaces:const ModuleInterfaces in I, first:UInt64, past:UInt64, role:UInt64) -> UInt64
    where {const owner I} {
    if (role == no_node()) return no_node();
    for (row in first .. past) {
        if (interfaces[row].declaration == role &&
            (case interfaces[row].payload of { RecipeOwner -> true; _ -> false })) return row
    };
    return no_node()
}

func type_argument_ordinal(interfaces:const ModuleInterfaces in I, first:UInt64, past:UInt64, binder:UInt64) -> UInt64
    where {const owner I} {
    val ordinal <- 0u64;
    for (row in first .. past) {
        if (case interfaces[row].payload of { RecipeParameter -> true; _ -> false }) {
            if (interfaces[row].declaration == binder) return ordinal;
            (ordinal <- ordinal + 1u64):void
        }
    };
    return no_node()
}

func scalar_generic_term(interfaces:const ModuleInterfaces in I, first:UInt64, past:UInt64, term:UInt64,
    products:const Products in M, arguments:const TypeKeys in M, anchor:UInt64, key:TypeKey in K) -> bool
    where {const owner I, const owner M, owner K} {
    if (term >= past) return false;
    val ordinal <- no_node();
    val slot <- no_node();
    return case interfaces[term].payload of {
        RecipeBuiltin { val kind <-, } -> {
            key.category <- ScalarType;
            key.type_kind <- kind;
            key.module <- 0u64;
            (key.identity <- 0u64):void;
            true
        };
        RecipeTypeParameter { val binder <-, } -> {
            ordinal <- type_argument_ordinal(interfaces, first, past, binder);
            if (ordinal >= products[anchor].arity) return false;
            slot <- products[anchor].arguments + ordinal;
            key.category <- arguments[slot].category;
            key.type_kind <- arguments[slot].type_kind;
            key.module <- arguments[slot].module;
            (key.identity <- arguments[slot].identity):void;
            true
        };
        _ -> false
    }
}

func generic_prepared_type(facts:const OperandFacts in F, operand:UInt64, key:const TypeKey in K) -> bool
    where {const owner F, const owner K} {
    val kind <- facts[operand].kind;
    if (key.category == ScalarType)
        return source_scalar_kind(key.type_kind) != 0u8 && kind == source_scalar_kind(key.type_kind);
    if (key.category != BitsNominal) return false;
    if (facts[operand].identity_module != key.module || facts[operand].identity != key.identity) return false;
    if (key.type_kind == enum_type()) return kind == scalar_enum();
    if (key.type_kind == sum_type()) return kind == independent_sum_bits() || kind == source_sum_target();
    return key.type_kind == record_type() && (kind == source_product_loan() || kind == independent_product_bits())
}

func check_generic_actual(nodes:const ExprNodes in N, facts:const OperandFacts in F, interfaces:const ModuleInterfaces in I,
    products:const Products in M, arguments:const TypeKeys in M, owners:PreparedGenericOwners in O, invocation_owner:UInt64,
    operand:UInt64, first:UInt64, past:UInt64, formal:UInt64, anchor:UInt64) -> UInt8
    where {const owner N, const owner F, const owner I, const owner M, owner O} {
    val role <- no_node();
    val readonly <- false;
    val by_value <- false;
    case interfaces[formal].payload of {
        RecipeFormal { val mode <-, val owner <- owner_role, val access <- readonly, } -> {
            if (mode != ValueFormal && mode != ReferenceFormal && mode != ExplicitValueFormal)
                return unsupported_generic_type();
            role <- owner;
            readonly <- access;
            (by_value <- mode == ExplicitValueFormal || (mode == ValueFormal && owner == no_node())):void
        };
        _ -> { return invalid_operand_tree() }
    };
    val term <- formal + 1u64;
    if (term >= past) return invalid_operand_tree();
    if (case interfaces[term].payload of { RecipeApplication -> true; _ -> false }) {
        # This profile takes the tuple from a prepared receiver. A matching
        # further receiver must use that same canonical member.
        if (facts[operand].kind != generic_member_loan() || facts[operand].identity != anchor ||
            !matches_member_application(interfaces, first, past, term, products[anchor].module,
                products[anchor].declaration, products[anchor].arity) || by_value)
            return wrong_operand_type()
    } else {
        ref key = make TypeKey { category <- ScalarType; type_kind <- 0u8; module <- 0u64; identity <- no_node() };
        if (!scalar_generic_term(interfaces, first, past, term, products, arguments, anchor, key))
            return unsupported_generic_type();
        if (!generic_prepared_type(facts, operand, key)) return wrong_operand_type()
    };
    if (facts[operand].target_presence != present_target() || facts[operand].reservation != no_node())
        return unproved_nonnull_borrow();
    if (by_value) {
        return if (role == no_node() && facts[operand].kind != generic_member_loan()) { 0u8 } else { unsupported_generic_type() }
    };
    val owner_row <- generic_owner_row(interfaces, first, past, role);
    if (owner_row == no_node()) return unproved_owner();
    val readonly_owner <- case interfaces[owner_row].payload of { RecipeOwner { val readonly <-, } -> readonly; _ -> false };
    val temporary <- facts[operand].reception == independent_value();
    if (!readonly && (temporary || facts[operand].target_readonly != 0u8)) return expected_writable_place();
    val actual_owner <- if (temporary) { invocation_owner } else { (facts[operand].owner) };
    val diagnostic <- check_owner_access(nodes, actual_owner, !readonly_owner);
    if (diagnostic != 0u8) return diagnostic;
    val slot <- owner_row - first;
    if (owners[slot] != no_node() && owners[slot] != actual_owner)
        return owner_conflict(nodes, owners[slot], actual_owner);
    (owners[slot] <- actual_owner):void;
    return 0u8
}

func apply_generic_result(nodes:const ExprNodes in N, facts:OperandFacts in F, interfaces:const ModuleInterfaces in I,
    products:const Products in M, arguments:const TypeKeys in M, owners:const PreparedGenericOwners in O, at:UInt64, first:UInt64, past:UInt64,
    signature:const GenericCallSignature in S, anchor:UInt64, published:UInt64) -> UInt8
    where {const owner N, owner F, const owner I, const owner M, const owner O, const owner S} {
    val role <- no_node();
    val mode <- ValueRecipe;
    val readonly <- false;
    case interfaces[signature.result].payload of {
        RecipeResult { val result_mode <- mode, val owner <- owner_role, val access <- readonly, } -> {
            role <- owner;
            mode <- result_mode;
            (readonly <- access):void
        };
        _ -> { return invalid_operand_tree() }
    };
    ref key = make TypeKey { category <- ScalarType; type_kind <- 0u8; module <- 0u64; identity <- no_node() };
    if (!scalar_generic_term(interfaces, first, past, signature.result + 1u64, products, arguments, anchor, key))
        return unsupported_generic_type();
    ref allocation = make UInt64 { no_node() };
    val allocation_owner <- no_node();
    if (signature.exit == FieldOperationsBody) {
        if (signature.body == no_node() ||
            !complete_generic_field_body(interfaces, published, products, arguments, first, signature.body,
                past, anchor, allocation)) return 168u8;
        if (allocation != no_node()) {
            val row <- generic_owner_row(interfaces, first, past, allocation);
            if (row == no_node() || owners[row - first] == no_node()) return unproved_owner();
            allocation_owner <- owners[row - first];
            # Region allocation also needs the region capacity failure path.
            if (owner_constraint_syntax(nodes, allocation_owner) != NotOwnerConstraint)
                return unsupported_generic_type()
        }
    };
    if (mode == ValueRecipe && key.category == ScalarType && key.type_kind == builtin_void() && role == no_node()) {
        if (signature.exit != EmptyMethodBody && signature.exit != FieldOperationsBody) return unproved_generic_body();
        only_void(facts, at);
        (facts[at].allocation_owner <- allocation_owner):void;
        return 0u8
    };
    if (mode != PointerRecipe) return unsupported_generic_type();
    val kind <- if (key.category == ScalarType) { source_scalar_kind(key.type_kind) } else {
        if (key.category != BitsNominal) { 0u8 } else {
            if (key.type_kind == enum_type()) { scalar_enum() }
            else {
                if (key.type_kind == sum_type()) { source_sum_target() }
                else { if (key.type_kind == record_type()) { source_product_loan() } else { 0u8 } }
            }
        }
    };
    if (kind == 0u8) return unsupported_generic_type();
    val owner <- generic_owner_row(interfaces, first, past, role);
    if (owner == no_node() || owners[owner - first] == no_node()) return unproved_owner();
    val presence <- unknown_target();
    if (signature.exit != FieldOperationsBody) {
        if (signature.exit != NullMethodResult || signature.null_return == no_node()) return unproved_generic_body();
        if (!(case interfaces[signature.null_return].payload of {
            RecipeReturnNull { val written <- owner_role, } -> written == no_node() || written == role;
            _ -> false
        })) return unproved_owner();
        (presence <- absent_target()):void
    };
    set_fact(facts, at, kind, nullable_ptr(), owners[owner - first], key.identity, 0u8);
    facts[at].identity_module <- key.module;
    facts[at].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
    facts[at].target_presence <- presence;
    facts[at].allocation_owner <- allocation_owner;
    (facts[at].selection <- at):void;
    return 0u8
}

func check_generic_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:OperandFacts in F, interfaces:const ModuleInterfaces in I, products:const Products in M, arguments:const TypeKeys in M,
    at:UInt64, used:UInt64, revision:UInt64, header:UInt64, past:UInt64, tail:UInt64, published:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, owner F, const owner I, const owner M} {
    if (header >= past || past > intrinsic (len)(interfaces)) return invalid_operand_tree();
    ref signature = make GenericCallSignature {
        count <- 0u64; result <- no_node(); null_return <- no_node(); body <- no_node(); exit <- UnprovedMethodBody; function_form <- false
    };
    if (!generic_call_signature(interfaces, header, past, signature)) return unsupported_generic_type();
    if (!signature.function_form && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    ref argument = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, ArgumentSequence, argument)) return wrong_argument_count();
    if (argument == no_node()) return wrong_argument_count();
    val first_actual <- ordinary_argument_value(nodes, used, revision, argument);
    if (first_actual >= at || facts[first_actual].kind != generic_member_loan()) return wrong_operand_type();
    val anchor <- facts[first_actual].identity;
    if (anchor >= intrinsic (len)(products) || !products[anchor].complete ||
        products[anchor].arity != signature.count) return wrong_operand_type();
    val first <- header + 1u64;
    ref owners = make PreparedGenericOwners(past - first, no_node());
    val operand <- no_node();
    val diagnostic <- 0u8;
    val abrupt <- false;
    for (formal in first .. past) {
        if (case interfaces[formal].payload of { RecipeFormal -> true; _ -> false }) {
            if (argument == no_node()) return wrong_argument_count();
            operand <- ordinary_argument_value(nodes, used, revision, argument);
            if (operand >= at || checked_ref_argument(nodes, argument)) return unsupported_generic_type();
            if (!abrupt) {
                if (facts[operand].kind == never_result()) {
                    (abrupt <- true):void
                } else {
                    diagnostic <- check_generic_actual(nodes, facts, interfaces, products, arguments, owners, names[at].scope,
                        operand, first, past, formal, anchor);
                    if (diagnostic != 0u8) return diagnostic
                }
            };
            (argument <- links[argument].next):void
        }
    };
    if (argument != no_node()) return wrong_argument_count();
    if (abrupt) { set_result(facts, at, never_result()); return 0u8 };
    return apply_generic_result(nodes, facts, interfaces, products, arguments, owners, at, first, past, signature, anchor, published)
}

func checked_stored_reference(facts:const OperandFacts in F, receiver:UInt64, owner_site:UInt64,
    record:const DeclaredType in T) -> bool where {const owner F, const owner T} {
    return facts[receiver].kind == source_product_loan() && facts[receiver].reception == borrowed_ref() &&
        facts[receiver].target_presence == present_target() && facts[receiver].owner == owner_site &&
        owner_site != no_node() && facts[receiver].identity == record.identity &&
        facts[receiver].identity_module == record.defining_module
}

func plain_text_operand(nodes:const ExprNodes in N, at:UInt64) -> bool where {const owner N} {
    return case nodes[at] of {
        Occupied { val syntax <- node, } -> case syntax.payload of { NameReference -> true; TextLiteral -> true; BooleanLiteral -> true; IntegerLiteral -> true; _ -> false };
        _ -> false
    }
}

func check_imported_source_text(nodes:const ExprNodes in N, names:const NameBindings in B,
    interfaces:const ModuleInterfaces in I, facts:OperandFacts in F, at:UInt64,
    family:UInt64, past:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner I, owner F} {
    if (is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, at, call) != DirectInvocationReady) return invalid_operand_tree();
    ref argument = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (call.arguments == no_node() ||
        inspect_sequence_entry(nodes, revision, used, call.arguments, argument) != ArgumentSequence ||
        argument.previous != no_node()) return wrong_argument_count();
    if (checked_ref_argument(nodes, call.arguments)) return unsupported_imported_call();
    val input <- argument.item;
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val method <- no_node();
    val module <- interfaces[family].defining_module;
    val kind <- 0u8;
    val matches <- false;
    val row_ok <- false;
    for (row in family + 1u64 .. past) {
        kind <- interfaces[row].value_kind;
        if (interfaces[row].defining_module != module || interfaces[row].declaration == no_node() ||
            interfaces[row].entry_count != 0u64 || interfaces[row].result_kind != builtin_void() ||
            (kind != builtin_string() && kind != lexical_builder_type() && kind != builtin_u64()))
            return unsupported_imported_call();
        row_ok <- if (kind == builtin_u64()) {
            interfaces[row].field_mode == ValueFormal && interfaces[row].owner_role == no_node() &&
            interfaces[row].owner_readonly == 0u8 && interfaces[row].target_readonly == 0u8
        } else {
            interfaces[row].field_mode == ReferenceFormal && interfaces[row].owner_role == 0u64 &&
            interfaces[row].owner_readonly == 1u8 && interfaces[row].target_readonly == 1u8
        };
        if (!row_ok) return unsupported_imported_call();
        if (kind == lexical_builder_type() &&
            (interfaces[row].type_module == 0u64 || interfaces[row].type_module == no_node() ||
                interfaces[row].type_identity == no_node())) return unsupported_imported_call();
        matches <- if (kind == builtin_string()) {
            immutable_text_kind(facts[input].kind)
        } else {
            if (kind == builtin_u64()) {
                facts[input].kind == scalar_u64() || supplies_enum_backing(facts, input, scalar_u64())
            } else {
                facts[input].kind == source_builder_loan() && facts[input].identity_module == interfaces[row].type_module &&
                    facts[input].identity == interfaces[row].type_identity
            }
        };
        if (matches) {
            if (method != no_node()) return ambiguous_value_call();
            (method <- row):void
        }
    };
    if (method == no_node()) return wrong_operand_type();
    val diagnostic <- 0u8;
    if (interfaces[method].value_kind == builtin_u64()) {
        (diagnostic <- require_value_bits(nodes, facts, input, scalar_u64())):void;
    } else {
        if (facts[input].reception != borrowed_ref() || facts[input].target_presence != present_target())
            return unproved_nonnull_borrow();
        (diagnostic <- check_owner_access(nodes, facts[input].owner, false)):void
    };
    if (diagnostic != 0u8) return diagnostic;
    case interfaces[method].payload of {
        CheckedTextReceiver -> {
            only_void(facts, at);
            facts[at].text_method <- method;
            return 0u8
        };
        DeferredTextReceiver -> { return unproved_text_receiver() };
        _ -> {}
    };
    # A selected signature supplies neither ordinary completion nor the
    # outstanding scoped bindings. Both are needed before an entered call.
    return unsupported_imported_call()
}

func check_imported_text_writer(nodes:const ExprNodes in N, names:const NameBindings in B,
    interfaces:const ModuleInterfaces in I, facts:OperandFacts in F, at:UInt64, family:UInt64, past:UInt64,
    used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B, const owner I, owner F} {
    if (interfaces[family].callable_kind == CheckedProcedure &&
        is_function(nodes, enclosing_callable(nodes, names, names[at].scope))) return procedure_call_in_function();
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (direct_invocation(nodes, revision, used, at, call) != DirectInvocationReady) return invalid_operand_tree();
    val second <- call.arguments;
    if (inspect_sequence_entry(nodes, revision, used, second, entry) != ArgumentSequence ||
        entry.previous == no_node()) return wrong_argument_count();
    val first <- entry.previous;
    if (inspect_sequence_entry(nodes, revision, used, first, entry) != ArgumentSequence ||
        entry.previous != no_node()) return wrong_argument_count();
    if (checked_ref_argument(nodes, first) || checked_ref_argument(nodes, second)) return wrong_operand_type();
    val output <- ordinary_argument_value(nodes, used, revision, first);
    val input <- ordinary_argument_value(nodes, used, revision, second);
    if (output >= first || input >= second) return invalid_operand_tree();
    if (facts[output].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val diagnostic <- check_builder_output(nodes, facts, output);
    if (diagnostic != 0u8) return diagnostic;
    if (facts[input].kind == never_result()) {
        set_result(facts, at, never_result());
        return 0u8
    };
    val method <- no_node();
    val matches <- false;
    val kind <- 0u8;
    val module <- interfaces[family].defining_module;
    for (row in family + 1u64 .. past) {
        kind <- interfaces[row].value_kind;
        if (interfaces[row].defining_module != module || interfaces[row].declaration == no_node() ||
            interfaces[row].entry_count != 0u64 || interfaces[row].result_kind != builtin_void() ||
            (kind != builtin_string() && kind != lexical_builder_type()) ||
            (kind == lexical_builder_type() && !has_nominal_identity(interfaces[row]))) return unsupported_imported_call();
        case interfaces[row].payload of {
            CheckedTextWriter { val target_module <-, val target_identity <-, } -> {
                if (target_module == 0u64 || target_module == no_node() || target_identity == no_node())
                    return unsupported_imported_call();
                matches <- facts[output].identity_module == target_module && facts[output].identity == target_identity &&
                    (if (kind == builtin_string()) { immutable_text_kind(facts[input].kind) }
                     else {
                        facts[input].kind == source_builder_loan() &&
                        facts[input].identity_module == interfaces[row].type_module &&
                        facts[input].identity == interfaces[row].type_identity
                     });
                if (matches) {
                    if (method != no_node()) return ambiguous_value_call();
                    (method <- row):void
                }
            };
            _ -> { return unsupported_imported_call() }
        }
    };
    if (method == no_node()) return wrong_operand_type();
    if (facts[input].reception != borrowed_ref() || facts[input].target_presence != present_target())
        return unproved_nonnull_borrow();
    diagnostic <- check_owner_access(nodes, facts[input].owner, false);
    if (diagnostic != 0u8) return diagnostic;
    copy_fact(facts, first, output);
    copy_fact(facts, second, input);
    only_void(facts, at);
    (facts[at].text_method <- method):void;
    return 0u8
}

# Preserve the selected method's possible exits. Scoped receivers apply
# their binding requirements in the separate scoped-text check.
export func collect_text_outcomes(interfaces:const ModuleInterfaces in I, facts:const OperandFacts in F,
    outcomes:ScopedTextOutcomes in O, used:UInt64) -> void where {const owner I, const owner F, owner O} {
    for (at in 0u64 .. used) {
        if (facts[at].text_method != no_node()) {
            case interfaces[facts[at].text_method].payload of {
                CheckedTextReceiver { val out_of_memory <-, val invalid_slice <-, val numeric_fault <-, val bounds <-, } -> {
                    outcomes[at].out_of_memory <- out_of_memory;
                    outcomes[at].invalid_slice <- invalid_slice;
                    outcomes[at].bounds <- bounds;
                    (outcomes[at].numeric_fault <- numeric_fault):void
                };
                CheckedLocalTextRoutine { val out_of_memory <-, val invalid_slice <-, val numeric_fault <-, val bounds <-, } -> {
                    outcomes[at].out_of_memory <- out_of_memory;
                    outcomes[at].invalid_slice <- invalid_slice;
                    outcomes[at].numeric_fault <- numeric_fault;
                    (outcomes[at].bounds <- bounds):void
                };
                CheckedTextWriter { val out_of_memory <-, } -> {
                    (outcomes[at].out_of_memory <- out_of_memory):void
                };
                _ -> {}
            }
        }
    };
    return
}

# A checked installation supplies an existing lexical target to the
# independently bound symbol view.
func check_builder_installation(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, views:const SuppliedViews in V,
    interfaces:const ModuleInterfaces in I, published:UInt64,
    facts:OperandFacts in F, at:UInt64, name:UInt64, input:UInt64, used:UInt64, revision:UInt64)
    -> UInt8 where {const owner N, const owner B, const owner E, const owner V, const owner I, owner F} {
    val access <- 0u8;
    return case views[name] of {
        BoundReferenceSymbol { val target_module <-, val target_identity <-, val readonly <-, val nullable <-, } -> {
            if (nullable) return unproved_operand();
            if (target_identity == no_node() || target_module == no_node() ||
                !lexical_builder_conforms(nodes, names, selected, interfaces, published,
                    facts[input].identity_module, facts[input].identity, target_module, target_identity, used, revision))
                return wrong_operand_type();
            if (facts[input].reception != borrowed_ref() || facts[input].target_presence != present_target())
                return unproved_nonnull_borrow();
            if (!readonly && facts[input].target_readonly != 0u8) return expected_writable_place();
            (access <- check_owner_access(nodes, facts[input].owner, !readonly)):void;
            if (access != 0u8) return access;
            only_void(facts, at);
            return 0u8
        };
        _ -> unproved_operand()
    }
}

func check_imported_scoped_routine(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in L, facts:OperandFacts in F,
    cases:const ConstructorCaseFacts in C, views:const SuppliedViews in H,
    at:UInt64, used:UInt64, revision:UInt64, method:UInt64) -> UInt8
    where {const owner N, const owner B, const owner E, const owner L, owner F, const owner C, const owner H} {
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, at, call) != DirectInvocationReady) return invalid_operand_tree();
    val diagnostic <- check_imported_call(nodes, names, selected, links, facts, cases, views,
        at, call.arguments, used, revision, true, false);
    if (diagnostic == 0u8 && facts[at].kind != never_result()) {
        (facts[at].text_method <- method):void
    };
    return diagnostic
}

func check_operand(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   selected:const SelectedExports in E, facts:OperandFacts in F, owners:CallOwners in O,
                   fields:const CaughtFieldUses in X, views:const SuppliedViews in H, products:const Products in M, arguments:const TypeKeys in M,
                   cases:const ConstructorCaseFacts in C, interfaces:const ModuleInterfaces in I, published:UInt64,
                       source_only:bool, mixed_aggregate_loan:bool,
                   at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F,
        owner O, const owner X, const owner H, const owner M, const owner C, const owner I} {
    if (at >= used) return invalid_operand_tree();
    if (links[at].enum_assertion == FoldedEnumOperand) return 0u8;
    if (source_only && at < intrinsic (len)(views)) {
        case views[at] of {
            BoundGenericCall { val header <-, val past <-, val tail <- arguments, } -> {
                return check_generic_call(nodes, names, links, facts, interfaces, products, arguments, at, used, revision,
                    header, past, tail, published)
            };
            PreparedGenericConstruction { val owner_site <-, val member <-, } -> {
                if (owner_site >= used || names[at].scope != owner_site) return unproved_owner();
                set_fact(facts, at, generic_member_loan(), borrowed_ref(), owner_site, member, 0u8);
                return 0u8
            };
            ImportedArrayLengthCall { val first <-, val past <-, val argument <-, val input <-, } -> {
                return check_imported_array_length(nodes, interfaces, facts, at, first, past, argument, input)
            };
            ImportedTextWriterCall { val family <-, val past <-, } -> {
                return check_imported_text_writer(nodes, names, interfaces, facts, at, family, past, used, revision)
            };
            ImportedSourceTextCall { val family <-, val first <-, val past <-, } -> {
                if (family == first)
                    return check_imported_scoped_routine(nodes, names, selected, links, facts, cases, views, at, used, revision, family);
                return check_imported_source_text(nodes, names, interfaces, facts, at, family, past, used, revision)
            };
            PreparedArrayConstruction {
                val requested <-, val placement <-, val length <-, val fill <-, val owner_site <-,
                val module <- type_module, val identity <- type_identity, val element <-,
                val element_module <-, val declared_element <- element_identity,
            } -> {
                if (element == ProductArrayElement) {
                    if (declared_element == no_node() || (element_module == 0u64 && declared_element >= used))
                        return invalid_operand_tree()
                } else {
                    if (!valid_array_slot_element(element, declared_element, element_module, used))
                        return invalid_operand_tree()
                };
                return check_prepared_array_construction(nodes, names, selected, facts, at, used, revision,
                    requested, placement, length, fill, owner_site, module, identity, element, element_module, declared_element)
            };
            EmptySumArrayFill { val parent <- construction, val sum <-, val arm <-, } -> {
                return check_empty_sum_array_fill(nodes, names, facts, views, at, used, revision, parent, sum, arm)
            };
            ReadonlyByteRead {
                val array_site <-, val index <-, val formal <-, val owner_site <-,
                val module <- type_module, val identity <- type_identity,
            } -> {
                return check_byte_read(nodes, names, facts, at, used, revision, array_site, index,
                    formal, owner_site, module, identity)
            };
            _ -> {}
        }
    };
    if (at < intrinsic (len)(cases)) {
        case cases[at] of {
            IndexedAggregateLoan {
                val array <-, val index <-, val owner_site <-, val array_module <-, val declared_array <- array_type,
                val index_binds_storage <-, val writable <-, val element <-,
            } -> {
                if (!source_only) return unsupported_product_layout();
                return check_indexed_aggregate_element(facts, at, array, index, owner_site, array_module, declared_array,
                    element, index_binds_storage, writable)
            };
            IndexedAggregateDestination {
                val array <-, val index <-, val owner_site <-, val array_module <-, val declared_array <- array_type,
                val element <-, val index_binds_storage <-,
            } -> {
                if (!source_only) return unsupported_product_layout();
                return check_indexed_aggregate_element(facts, at, array, index, owner_site, array_module, declared_array,
                    element, index_binds_storage, true)
            };
            LexicalSumReference { val construction <-, val owner_site <-, val readonly <-, } -> {
                if (!source_only) return unsupported_product_layout();
                return check_lexical_bits_reference(facts, at, construction, owner_site, readonly,
                    independent_sum_bits(), source_sum_target())
            };
            LexicalProductReference { val construction <-, val owner_site <-, val readonly <-, } -> {
                if (!source_only) return unsupported_product_layout();
                if (construction < at && facts[construction].kind == source_product_loan()) {
                    if (facts[construction].owner != owner_site ||
                        facts[construction].target_presence != present_target()) return unproved_owner();
                    copy_fact(facts, at, construction);
                    if (readonly) { (facts[at].target_readonly <- 1u8):void };
                    return 0u8
                };
                return check_lexical_bits_reference(facts, at, construction, owner_site, readonly,
                    independent_product_bits(), source_product_loan())
            };
            FixedReferenceRecordConstruction {
                val record <-, val owner_site <-, val count <- field_count,
                val begin <- first_initializer, val last <- last_initializer,
            } -> {
                if (!source_only || owner_site != names[at].scope) return unproved_owner();
                return check_fixed_reference_record(nodes, facts, links, cases, at, record, owner_site, count, begin, last, used)
            };
            LexicalSumRebind { val destination <-, val construction <-, val owner_site <-, } -> {
                if (!source_only) return unsupported_product_layout();
                return check_lexical_sum_rebind(facts, at, destination, construction, owner_site)
            };
            BitsConstruction {
                val type <- value_type, val count <- field_count,
                val begin <- first_initializer, val last <- last_initializer,
            } -> {
                if (!source_only) return unsupported_product_layout();
                return check_bits_construction(facts, links, cases, at, type, count, begin, last, used)
            };
            IndexedCaseSubject {
                val expression <- expression, val array_site <- array_site, val index <- index,
                val owner_site <- owner_site, val array_module <-, val declared_array <- array_type, val schema <- value_type,
            } -> { return check_indexed_case_subject(nodes, facts, at, expression, array_site,
                index, owner_site, array_module, declared_array, schema) };
            CaseFieldReceipt { val header <- arm, val pattern <- pattern, val schema <- value_type, } ->
                { return check_case_receipt(nodes, names, facts, at, used, revision, header, pattern, schema) };
            CaseSumReceipt { val receipt <- receipt, val arm <- arm, val schema <- value_type, } -> {
                return select_received_case_subject(names, facts, at, receipt, arm, schema)
            };
            CaseSumProjection {
                val receiver <- receiver, val field <- field, val receipt <- receipt, val arm <- arm,
                val record <- record, val sum <- value_type,
            } -> {
                return check_case_projection(nodes, names, facts, at, used, revision,
                    receiver, field, receipt, arm, record, sum)
            };
            StoredArrayElementReference { val input <-, val readonly <-, } -> {
                if (!source_only || input >= at) return unsupported_product_layout();
                if (facts[input].kind == never_result()) { copy_fact(facts, at, input); return 0u8 };
                if (facts[input].kind != source_product_loan() || !facts[input].checks_array_bounds ||
                    facts[input].selection != input || facts[input].target_presence != present_target() ||
                    (!readonly && facts[input].target_readonly != 0u8)) return unproved_nonnull_borrow();
                copy_fact(facts, at, input);
                facts[at].selection <- input;
                (facts[at].checks_array_bounds <- false):void;
                return 0u8
            };
            BitsPlaceTransfer { val destination <-, val input <-, val type <- value_type, } -> {
                if (!source_only) return unsupported_product_layout();
                return check_bits_place_transfer(facts, at, destination, input, type)
            };
            StoredProductAlias { val input <-, } -> {
                if (!source_only || input >= at) return unsupported_product_layout();
                if (facts[input].kind == never_result()) { copy_fact(facts, at, input); return 0u8 };
                if (facts[input].kind != source_product_loan() || facts[input].reception != borrowed_ref() ||
                    facts[input].target_presence != present_target() || facts[input].owner >= used)
                    return unproved_nonnull_borrow();
                copy_fact(facts, at, input);
                return 0u8
            };
            StoredProductReference { val receiver <-, val owner_site <-, val record <-, val target <-, } -> {
                if (!source_only || receiver >= at) return unsupported_product_layout();
                if (facts[receiver].kind == never_result()) { copy_fact(facts, at, receiver); return 0u8 };
                if (!checked_stored_reference(facts, receiver, owner_site, record)) return unproved_owner();
                set_fact(facts, at, source_product_loan(), borrowed_ref(), owner_site, target.identity, 0u8);
                facts[at].identity_module <- target.defining_module;
                facts[at].target_readonly <- 1u8;
                return 0u8
            };
            StoredArrayField {
                val receiver <-, val owner_site <-, val record <-, val array_module <-, val array_identity <-,
                val element <-, val target_readonly <-,
            } -> {
                if (!source_only || receiver >= at) return unsupported_product_layout();
                if (facts[receiver].kind == never_result()) { copy_fact(facts, at, receiver); return 0u8 };
                if (!checked_stored_reference(facts, receiver, owner_site, record)) return unproved_owner();
                set_fact(facts, at, source_array_loan(), borrowed_ref(), facts[receiver].owner, array_identity, 0u8);
                facts[at].identity_module <- array_module;
                if (element.kind == builtin_u8() || element.kind == builtin_u64() || element.kind == builtin_bool()) {
                    (facts[at].array_scalar <- source_scalar_kind(element.kind)):void
                };
                facts[at].target_readonly <- if (target_readonly) { 1u8 } else { (facts[receiver].target_readonly) };
                return 0u8
            };
            InlineProductField {
                val receiver <- receiver, val field <- field, val ordinal <- ordinal,
                val record <- record, val readonly <-, val writable <-, val schema <- value_type,
            } -> {
                if (!source_only) return unsupported_product_layout();
                if (receiver >= at) return invalid_operand_tree();
                if (facts[receiver].kind == source_product_loan() ||
                    facts[receiver].kind == never_result())
                    return check_inline_product_field(nodes, facts, at, used, revision, receiver, field,
                        ordinal, readonly, writable, record, schema)
            };
            CaseProductField {
                val receiver <- receiver, val field <- field, val ordinal <- ordinal,
                val record <- record, val schema <- value_type,
            } -> {
                return check_case_product_field(nodes, names, facts, at, used, revision, receiver, field,
                    ordinal, record, schema, source_only)
            };
            _ -> {}
        }
    };
    if (source_only) {
        ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
        if (at < intrinsic (len)(views) && inspect_index_selection(nodes, revision, used, at, indexed) &&
            has_slot_array(facts, indexed.target)) {
            ref transfer = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64 };
            case views[at] of {
                IndexedArrayDestination { val assignment <-, val target <-, val index <-, } -> {
                    if (assignment <= at || inspect_assignment(nodes, revision, used, assignment, transfer) != PlaceTransfer ||
                        transfer.destination != at || target != indexed.target || index != indexed.index ||
                        names[assignment].kind != 0u8) return invalid_operand_tree();
                    return check_slot_array_index(nodes, facts, at, target, index, true)
                };
                IndexedArraySource { val assignment <-, val target <-, val index <-, } -> {
                    if (assignment <= at || inspect_assignment(nodes, revision, used, assignment, transfer) != PlaceTransfer ||
                        transfer.input != at || target != indexed.target || index != indexed.index ||
                        names[assignment].kind != 0u8) return invalid_operand_tree();
                    return check_slot_array_index(nodes, facts, at, target, index, false)
                };
                _ -> {}
            };
            if (facts[indexed.target].array_scalar != 0u8)
                return check_slot_array_index(nodes, facts, at, indexed.target, indexed.index, false);
            return unsupported_transfer_signature()
        }
    };
    ref installed_expression = make UInt64 { no_node() };
    if (source_only && native_installation_input(nodes, revision, used, at, installed_expression)) {
        val selected_acquisition <- ungrouped(nodes, revision, used, installed_expression);
        if (selected_acquisition >= used || links[selected_acquisition].active != at)
            return unproved_operand();
        only_void(facts, at);
        return 0u8
    };
    val null_owner <- no_node();
    case nodes[at] of {
        (Vacant) -> { return invalid_operand_tree(); };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (Parenthesized { val expression <- expression, }) -> {
                    if (!published_syntax_id(nodes, revision, at, expression)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_group(nodes, facts, at, expression.index);
                };
                (NameReference) -> { return check_bound_name(names, links, facts, views, at); };
                (ScopedProcedureDefinition) -> { only_void(facts, at); return 0u8 };
                (BindSymbolEffect { val name <-, val input <-, }) -> {
                    if (!source_only) return 0u8;
                    if (!published_syntax_id(nodes, revision, at, name) ||
                        !published_syntax_id(nodes, revision, at, input)) return invalid_operand_tree();
                    if (facts[input.index].kind == never_result()) {
                        set_result(facts, at, never_result());
                        return 0u8
                    };
                    if (facts[input.index].kind == source_builder_loan())
                        return check_builder_installation(nodes, names, selected, views, interfaces, published,
                            facts, at, name.index, input.index, used, revision);
                    return 0u8
                };
                (ArrayLength { val target <- target, }) -> {
                    if (!published_syntax_id(nodes, revision, at, target)) return invalid_operand_tree();
                    if (facts[target.index].kind == never_result()) {
                        set_result(facts, at, never_result());
                        return 0u8
                    };
                    if (!source_only || facts[target.index].kind != source_array_loan())
                        return unproved_operand();
                    scalar_fact(facts, at, independent_value(), no_node());
                    return 0u8
                };
                (RangeHeader) -> { return check_range_header(nodes, facts, at, used, revision); };
                (RangeLoop) -> { return check_range_result(nodes, facts, at, used, revision); };
                (BooleanLiteral) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    set_result(facts, at, scalar_bool());
                    return 0u8;
                };
                (IntegerLiteral { val width <- width, }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    if (width == 64u64) {
                        scalar_fact(facts, at, independent_value(), no_node());
                        return 0u8;
                    };
                    if (source_only && width == 32u64) {
                        set_result(facts, at, source_u32());
                        return 0u8
                    };
                    if (width != 8u64) return unsupported_narrow_execution();
                    set_result(facts, at, scalar_u8());
                    return 0u8;
                };
                (Call { val callee <- callee, val arguments <- argument_tail, }) -> {
                    if (!published_syntax_id(nodes, revision, used, callee) ||
                        !published_syntax_id(nodes, revision, used, arguments)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_direct_call(source, nodes, names, links, selected, facts, owners, views, cases,
                        at, callee.index, arguments.index, used, revision, source_only, mixed_aggregate_loan);
                };
                (EmptyCall { val callee <- callee, }) -> {
                    if (!published_syntax_id(nodes, revision, used, callee)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_direct_call(source, nodes, names, links, selected, facts, owners, views, cases,
                        at, callee.index, no_node(), used, revision, source_only, false);
                };
                (HereInvocation { val call <- call, }) -> {
                    if (ordinary_here_site(views, at)) {
                        copy_fact(facts, at, call.index);
                        return 0u8
                    };
                    return check_native_here_value(nodes, links, facts, at, call, used, revision)
                };
                (HereSupply) -> {
                    if (at < intrinsic (len)(views))
                        return check_ordinary_here_body(nodes, facts, views, at, used, revision);
                    return 0u8
                };
                (NamedArgument) -> {
                    if (at < intrinsic (len)(views)) {
                        case views[at] of {
                            OrdinaryHereLabel { val input <- operand, } -> { copy_fact(facts, at, input); };
                            _ -> {}
                        }
                    };
                    return 0u8
                };
                (ReturnValue { val value <- value, }) -> {
                    if (!published_syntax_id(nodes, revision, used, value)) return invalid_operand_tree();
                    return check_return(nodes, names, facts, at, value.index, used, revision);
                };
                (ReturnVoid) -> { return check_return(nodes, names, facts, at, no_node(), used, revision); };
                (ContinueValue) -> { return check_here_continue(nodes, names, links, facts, views, at,
                    used, revision); };
                (ContinueVoid) -> { return check_here_continue(nodes, names, links, facts, views, at, used,
                    revision); };
                (PredicateAssertion { val predicate <-, }) -> {
                    if (!published_syntax_id(nodes, revision, at, predicate)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_predicate_assertion(nodes, facts, at, predicate.index, used, revision)
                };
                (DiscardedExpression { val operand <- operand, }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    return check_explicit_discard(nodes, facts, at, operand.index);
                };
                (TextLiteral { val interior <- interior_zero, }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    set_fact(facts, at, string_kind(), borrowed_ref(), static_text_owner(), 0u64, 0u8);
                    facts[at].target_readonly <- 1u8;
                    facts[at].text_nul <- if (interior) { nul_present() } else { nul_absent() };
                    return 0u8;
                };
                (NullLiteral { val owner <- owner_name, }) -> {
                    if (names[at].scope == no_node()) return 0u8;
                    case owner of {
                        (NoLink) -> {};
                        (LinkTo { val name <- node, }) -> {
                            if (!published_syntax_id(nodes, revision, at, name)) return invalid_operand_tree();
                            (null_owner <- names[name.index].declaration):void;
                        };
                    };
                    set_fact(facts, at, null_literal(), 0u8, null_owner, 0u64, 0u8);
                    return 0u8;
                };
                (RaiseValue { val operand <- exception_value, }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return invalid_operand_tree();
                    if (names[at].scope == no_node()) return 0u8;
                    if (facts[operand.index].kind != exception_type()) return expected_exception_type();
                    set_result(facts, at, never_result());
                    return 0u8;
                };
                (RaisePending) -> {
                    if (names[at].scope != no_node()) { set_result(facts, at, never_result()); } else {};
                    return 0u8;
                };
                (NamedThrow) -> { set_result(facts, at, never_result()); return 0u8; };
                (BreakValue) -> { return check_break(nodes, names, links, facts, views, at, used, revision) };
                (BreakVoid) -> { return check_break(nodes, names, links, facts, views, at, used, revision) };
                (CaseFallthrough) -> { return record_case_fallthrough(nodes, names, facts, at, used, revision); };
                (CaseFailure) -> { set_result(facts, at, never_result()); return 0u8; };
                (_) -> {};
            };
        };
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, revision, used, at, assignment);
    if (mode == InvalidAssignment) return invalid_operand_tree();
    if (mode == FieldRebind ||
        (mode == FieldTransfer && names[assignment.destination].kind == record_initializer_label())) return 0u8;
    if (mode == AugmentedPlaceTransfer)
        return check_augmented_transfer(nodes, facts, at, assignment.destination, assignment.input,
                                       used, revision);
    if ((mode == PlaceRebind || mode == PlaceTransfer || mode == FieldTransfer) && names[at].scope == no_node()) return 0u8;
    val destination <- assignment.destination;
    if (mode == PlaceRebind) {
        if (source_only && destination < intrinsic (len)(cases)) {
            case cases[destination] of {
                StoredArrayField { val receiver <-, val fixed <-, val target_readonly <-, } -> {
                    if (facts[destination].kind == never_result()) {
                        copy_fact(facts, at, destination);
                        return 0u8
                    };
                    if (fixed || facts[receiver].target_readonly != 0u8) return expected_writable_place();
                    return check_array_rebind(nodes, facts, at, destination, assignment.input, target_readonly)
                };
                _ -> {}
            }
        };
        if (source_only && facts[destination].kind == source_array_loan() &&
            (facts[destination].array_slot != no_node() || has_slot_array(facts, destination))) {
            if (bound_array_slot(nodes, names, links, facts, destination, at, used, revision) == no_node())
                return expected_writable_place();
            return check_array_rebind(nodes, facts, at, destination, assignment.input,
                facts[destination].target_readonly != 0u8)
        };
        if (scalar_kind(facts[destination].kind))
            return check_local_rebind(nodes, names, facts, at, destination, assignment.input, used, revision);
        return check_text_installation(nodes, facts, at, destination, assignment.input)
    };
    if (mode == PlaceTransfer || mode == FieldTransfer) {
        val input <- assignment.input;
        if (source_only && mode == PlaceTransfer && destination < intrinsic (len)(cases)) {
            case cases[destination] of {
                IndexedAggregateDestination { val transfer <-, val element <-, } -> {
                    if (transfer != at) return invalid_operand_tree();
                    return check_indexed_bits_transfer(names, facts, cases, at, destination, input, element)
                };
                _ -> {}
            }
        };
        if (source_only && mode == PlaceTransfer && destination < intrinsic (len)(views) &&
            facts[destination].checks_array_bounds) {
            case views[destination] of {
                IndexedArrayDestination { val transfer <- assignment, val target <-, } -> {
                    if (transfer == at && target < destination && has_slot_array(facts, target)) {
                        if (facts[destination].kind == never_result() || facts[input].kind == never_result()) {
                            set_result(facts, at, never_result());
                            return 0u8
                        };
                        if (facts[target].array_scalar != 0u8)
                            return check_transfer(nodes, facts, at, destination, input, source_only);
                        return check_slot_sum_transfer(cases, facts, at, destination, input)
                    }
                };
                _ -> {}
            };
        };
        if (facts[destination].kind == product_kind())
            return check_transfer_call(nodes, names, links, facts, owners, at, destination, input, false, used, revision);
        if (!immutable_text_kind(facts[destination].kind))
            return check_transfer(nodes, facts, at, destination, input, source_only);
        if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
        # Reborrowing an init formal as an initialized place would expose its
        # current value before the caller's first-write proof.
        if (name_syntax(nodes, used, destination) == OrdinaryName) return unsupported_text_operation();
        return check_transfer_call(nodes, names, links, facts, owners, at, destination, input, false, used, revision);
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, revision, used, at, construction);
    if (shape == InvalidConstruction) return invalid_operand_tree();
    if (shape == PositionalConstruction || shape == BracedConstruction || shape == StorageReservation) {
        if (names[at].scope == no_node()) return 0u8;
        val kind <- names[construction.requested].kind;
        if (kind == builtin_string()) {
            if (shape != PositionalConstruction) return unsupported_text_operation();
            return check_text_construction(nodes, names, facts, at, used, revision, construction);
        };
        if (source_only && construction.requested < used &&
            is_lexical_builder(nodes, names, construction.requested, revision, used)) {
            if (shape != PositionalConstruction) return unsupported_text_operation();
            return check_empty_builder(names, selected, facts, at, construction);
        };
        if (kind == record_type()) {
            if (shape != BracedConstruction) return unsupported_product_layout();
            return check_product_construction(source, nodes, names, links, facts, owners,
                                              at, names[construction.requested].declaration, used, revision, construction);
        };
        if (shape == PositionalConstruction) return unproved_operand();
        return check_construction(nodes, names, selected, facts, at, construction);
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == InvalidLogical) return invalid_operand_tree();
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr) {
        if (names[at].scope == no_node()) return 0u8;
        return check_logical(nodes, facts, at, logical);
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val sequence <- inspect_sequence_entry(nodes, revision, used, at, entry);
    if (sequence == InvalidSequence) return invalid_operand_tree();
    if (sequence == BlockSequence || sequence == ModuleSequence) {
        check_sequence_item(nodes, facts, at, entry, source_only);
        return 0u8;
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    if (inspect_catch_binding(nodes, revision, used, at, caught))
        return if (facts[at].kind == exception_type()) { 0u8 } else { expected_exception_type() };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    if (inspect_guard_clause(nodes, revision, used, at, clause) == HandlerClause)
        return check_catch_clause(nodes, facts, at, used, revision, clause);
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val callable_form <- inspect_callable(nodes, revision, used, at, callable);
    if (callable_form == InvalidCallable) return invalid_operand_tree();
    if (callable_form == ModuleCallable || (source_only && callable_form == LexicalCallable))
        return check_callable_tail(facts, at, callable);
    if (names[at].scope == no_node()) return 0u8;
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    if (inspect_type_assertion(nodes, revision, used, at, assertion)) {
        if (names[assertion.annotation].kind == builtin_c_string()) return check_text_assertion(facts, at, assertion.operand);
        return check_enum_assertion(nodes, links, facts, at, assertion.operand, source_only);
    };
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, revision, used, at, local) && local.mode != ExceptionLocal)
        return check_local(nodes, names, selected, facts, at, used, revision, source_only, local);
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, revision, used, at, field))
        return check_field_access(source, nodes, names, links, facts, fields, at, used, revision,
            field, source_only);
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val operator <- inspect_binary(nodes, revision, used, at, binary);
    if (operator == InvalidBinary) return invalid_operand_tree();
    if (operator == ArithmeticBinary) return check_numeric_expression(nodes, facts, at, binary, source_only);
    if (operator == ComparisonBinary) return check_comparison(nodes, facts, at, binary, source_only);
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    val invocation <- inspect_invocation(nodes, revision, used, at, call);
    if (invocation == InvalidCallSyntax) return invalid_operand_tree();
    if (invocation == EffectfulInvocation)
        return check_symbolic_call(nodes, names, links, selected, facts, at, call.callee, call.arguments, used, revision);
    ref tail = make UInt64 { no_node() };
    if (block_tail(nodes, revision, used, at, tail)) {
        if (is_scope_block(nodes, at)) return check_scope_tail(facts, at, tail);
        if (tail != no_node() && facts[at].arm_result != 0u8) { copy_fact(facts, at, tail); } else {
            val result <- sequence_result(facts, tail);
            if (scalar_kind(result)) { set_bits_result(facts, at, tail); } else { set_result(facts, at, result); };
        };
        return 0u8;
    };
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    if (inspect_protected(nodes, revision, used, at, protected))
        return check_try_result(nodes, links, facts, at, used, revision, protected);
    ref branches = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branches)) return check_conditional(nodes, facts, at, branches, source_only);
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (inspect_case_arm(nodes, revision, used, at, arm))
        return prepare_case_arm(nodes, names, links, facts, at, used, revision, arm);
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    val registration <- inspect_defer(nodes, revision, used, at, deferred);
    if (registration == InvalidDefer) return invalid_operand_tree();
    if (registration == DeferCall && facts[deferred.invocation].text_intrinsic != 0u8) return unsupported_text_operation();
    if (registration == DeferCall || registration == DeferBody) { only_void(facts, at); return 0u8; };
    return 0u8;
}

func complete_enum_backing(links:const NameWork in L, interfaces:const ModuleInterfaces in I,
                           published:UInt64, facts:OperandFacts in F, at:UInt64, used:UInt64) -> void
    where {const owner L, const owner I, owner F} {
    if (facts[at].kind != scalar_enum()) return;
    val identity <- facts[at].identity;
    val module <- facts[at].identity_module;
    if (module == 0u64) {
        if (identity < used) { (facts[at].enum_backing <- links[identity].enum_backing):void };
        return
    };
    val head <- find_interface(interfaces, published, module, identity);
    if (head != no_node() && interfaces[head].interface_kind == enum_type()) {
        (facts[at].enum_backing <- interfaces[head].element_kind):void
    };
}

# Ordinary nodes are checked in postorder. Once a case subject is ready,
# its ordered scan checks each direct item in the context that reaches it.
func check_operand_range(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                         links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                         interfaces:const ModuleInterfaces in I, published:UInt64, owners:CallOwners in O, fields:const CaughtFieldUses in X,
                             views:const SuppliedViews in H, products:const Products in M, arguments:const TypeKeys in M,
                         cases:const ConstructorCaseFacts in C,
                demand:const DeclarationDemands in D,
                         report:OperandCheckResult in R, first:UInt64, past:UInt64, used:UInt64,
                             revision:UInt64, context:UInt64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, const owner I,
        owner O, const owner X, const owner H, const owner M, const owner C, const owner D, owner R} {
    val at <- first;
    val diagnostic <- 0u8;
    val enclosing_case <- no_node();
    for (unused in first .. past) {
        if (at == past) return true;
        if (needs_body_check(demand, at)) {
            if (at != context) { (facts[at].case_context <- context):void; };
            if (at < intrinsic (len)(demand)) { (facts[at].text_call <- demand[at].text_call):void };
            if (at == enclosing_case) {
                if (!check_case(source, nodes, names, links, selected, facts, interfaces, published, owners, fields, views,
                    products, arguments, cases, demand, report,
                                at, used, revision, context)) return false;
            } else {
                diagnostic <- check_operand(source, nodes, names, links, selected, facts, owners,
                    fields, views, products, arguments, cases, interfaces, published, intrinsic (len)(demand) != 0u64,
                    at < intrinsic (len)(demand) && demand[at].mixed_aggregate_loan, at, used, revision);
                if (diagnostic != 0u8) return operand_problem(report, at, diagnostic)
            };
            complete_enum_backing(links, interfaces, published, facts, at, used);
        };
        enclosing_case <- facts[at].case_after_subject;
        at <- if (enclosing_case != no_node() && enclosing_case < past) { enclosing_case } else { at + 1u64 };
    };
    return at == past;
}

func discard_result(facts:OperandFacts in F, at:UInt64, mode:UInt8) -> void where {owner F} {
    if (at == no_node()) return;
    facts[at].discarded_result <- mode;
    return;
}

func inherit_result_use(facts:OperandFacts in F, parent:UInt64, child:UInt64) -> void where {owner F} {
    if (child == no_node()) return;
    facts[child].arm_result <- facts[parent].arm_result;
    facts[child].discarded_result <- facts[parent].discarded_result;
    return;
}

func discard_aggregate_statement(nodes:const ExprNodes in N, cases:const ConstructorCaseFacts in C,
    facts:OperandFacts in F, written:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner C, owner F} {
    val at <- ungrouped(nodes, revision, used, written);
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- no_node() };
    if (inspect_assignment(nodes, revision, used, at, assignment) != PlaceTransfer ||
        assignment.input >= intrinsic (len)(cases) || assignment.destination >= intrinsic (len)(cases)) return;
    if ((case cases[at] of { BitsPlaceTransfer -> true; _ -> false }) ||
        (case cases[assignment.destination] of {
            IndexedAggregateDestination { val transfer <-, } -> transfer == at;
            _ -> false
        })) {
        discard_result(facts, at, explicit_discard());
        return
    };
    case cases[assignment.input] of {
        BitsConstruction { val transfer <-, } -> {
            if (transfer == at) { discard_result(facts, at, explicit_discard()) }
        };
        _ -> {}
    }
}

func is_braced_statement_guard(nodes:const ExprNodes in N, branch:const ConditionalSites in C,
    used:UInt64, revision:UInt64) -> bool where {const owner N, const owner C} {
    ref tail = make UInt64 { no_node() };
    if (is_scope_block(nodes, branch.consequent) || is_scope_block(nodes, branch.alternative) ||
        !block_tail(nodes, revision, used, branch.consequent, tail) ||
        !block_tail(nodes, revision, used, branch.alternative, tail) || tail != no_node()) return false;
    return case nodes[branch.test] of {
        Occupied { val syntax <- node, } -> case syntax.payload of {
            ReturningCondition -> false;
            _ -> true
        };
        Vacant -> false
    }
}

# Carry discard through parentheses, a grouping block's tail and the
# normal arms of a guard. Argument and arithmetic operands and independent
# invocations still establish results required by their own operations.
func prepare_result_use(nodes:const ExprNodes in N, facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, owner F} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    if (inspect_range_loop(nodes, revision, used, at, loop)) {
        discard_result(facts, loop.body, loop_discard());
        discard_result(facts, loop.empty, loop_discard());
        return;
    };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (inspect_case_arm(nodes, revision, used, at, arm)) {
        facts[arm.body].arm_result <- 1u8;
        return;
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch)) {
        facts[branch.consequent].arm_result <- 1u8;
        facts[branch.alternative].arm_result <- 1u8;
        if (facts[at].statement_operand && is_braced_statement_guard(nodes, branch, used, revision)) {
            # The guard can join without a payload. Only ordinary discard
            # reaches its arms, so nested value joins still check their types.
            discard_result(facts, at, statement_guard_discard());
            discard_result(facts, branch.consequent, explicit_discard());
            return
        };
        facts[branch.consequent].discarded_result <- facts[at].discarded_result;
        facts[branch.alternative].discarded_result <- facts[at].discarded_result;
        return;
    };
    # An explicit discard still requires its operand to establish its type.
    case nodes[at] of {
        (Vacant) -> { return; };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (DiscardedExpression { val operand <- operand, }) -> {
                    if (published_syntax_id(nodes, revision, at, operand))
                        { discard_result(facts, operand.index, explicit_discard()); } else {};
                    return;
                };
                (_) -> {};
            };
        };
    };
    if (facts[at].discarded_result == 0u8 && facts[at].arm_result == 0u8) return;
    ref child = make UInt64 { no_node() };
    if (inspect_group(nodes, revision, used, at, child) == ParenthesizedExpression ||
        (!is_scope_block(nodes, at) && block_tail(nodes, revision, used, at, child))) {
        inherit_result_use(facts, at, child);
        return;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, at, entry) == BlockSequence) {
        inherit_result_use(facts, at, entry.item);
        return;
    };
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    if (inspect_protected(nodes, revision, used, at, protected)) {
        inherit_result_use(facts, at, protected.body);
        inherit_result_use(facts, at, protected.clauses);
        return;
    };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    val mode <- inspect_guard_clause(nodes, revision, used, at, clause);
    if (mode == HandlerClause || mode == CleanupClause) {
        inherit_result_use(facts, at, clause.previous);
        if (mode == HandlerClause) { inherit_result_use(facts, at, clause.target); } else {};
        return;
    };
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (inspect_handler(nodes, revision, used, at, handler)) { inherit_result_use(facts, at, handler.body); } else {};
    return;
}

# Result evidence is computed only for demanded omitted-result functions.
# This profile requires a normal void tail or a reached void return, with
# no unproved call on the path used as evidence.
data ResultPath { normal:bool, returns_void:bool, }
array ResultPaths[UInt64]:ResultPath;

func path_normal(paths:const ResultPaths in P, at:UInt64) -> bool where {const owner P} {
    return at == no_node() || paths[at].normal
}

func path_returns_void(paths:const ResultPaths in P, at:UInt64) -> bool where {const owner P} {
    return at != no_node() && paths[at].returns_void
}

func append_result_path(paths:ResultPaths in P, at:UInt64, first:UInt64, next:UInt64) -> void
    where {owner P} {
    val enters <- path_normal(paths, first);
    paths[at].normal <- enters && path_normal(paths, next);
    (paths[at].returns_void <- path_returns_void(paths, first) || (enters && path_returns_void(paths, next))):void
}

func branch_result_path(paths:ResultPaths in P, at:UInt64, test:UInt64,
    first:UInt64, second:UInt64, takes_first:bool, takes_second:bool) -> void where {owner P} {
    val enters <- path_normal(paths, test);
    paths[at].normal <- enters &&
        ((takes_first && path_normal(paths, first)) || (takes_second && path_normal(paths, second)));
    val returns_void <- (takes_first && path_returns_void(paths, first)) ||
        (takes_second && path_returns_void(paths, second));
    (paths[at].returns_void <- path_returns_void(paths, test) || (enters && returns_void)):void
}

func collect_result_path(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const OperandFacts in F, paths:ResultPaths in P, at:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner F, owner P} {
    ref child = make UInt64 { no_node() };
    if (completion_syntax(nodes, at) == ReturnCompletion &&
        completion_operand(nodes, revision, used, at, child)) {
        (paths[at].returns_void <- path_returns_void(paths, child) ||
            (path_normal(paths, child) && (child == no_node() || facts[child].kind == void_result()))):void;
        return
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch)) {
        val truth <- boolean_literal(nodes, used, ungrouped(nodes, revision, used, branch.test));
        branch_result_path(paths, at, branch.test, branch.consequent, branch.alternative,
            truth != LiteralFalse, truth != LiteralTrue);
        return
    };
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    if (inspect_range_loop(nodes, revision, used, at, loop)) {
        val shape <- classify_literal_range(nodes, revision, used, loop.header);
        branch_result_path(paths, at, loop.header, loop.body, loop.empty,
            shape != EmptyLiteralRange, shape != NonemptyLiteralRange);
        return
    };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (inspect_range_header(nodes, revision, used, at, bounds)) {
        append_result_path(paths, at, bounds.lower, bounds.upper);
        return
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val sequence <- inspect_sequence_entry(nodes, revision, used, at, entry);
    if (sequence == BlockSequence || sequence == ArgumentSequence) {
        append_result_path(paths, at, entry.previous, entry.item);
        return
    };
    if (is_scope_block(nodes, at)) return;
    if (block_tail(nodes, revision, used, at, child) ||
        inspect_group(nodes, revision, used, at, child) == ParenthesizedExpression) {
        append_result_path(paths, at, child, no_node());
        return
    };
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false;
    };
    if (inspect_local_binding(nodes, revision, used, at, local) && local.mode != ExceptionLocal) {
        append_result_path(paths, at, local.initializer, no_node());
        return
    };
    val kind <- facts[at].kind;
    if (kind == never_result()) return;
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- no_node(); };
    val transfer <- inspect_assignment(nodes, revision, used, at, assignment);
    # Construction checks the written initializer. Its field name has no
    # operand to evaluate, so only the input contributes a result path.
    if (transfer == FieldTransfer && names[assignment.destination].kind == record_initializer_label()) {
        append_result_path(paths, at, assignment.input, no_node());
        return
    };
    if (kind == 0u8) return;
    if (transfer == PlaceTransfer || transfer == FieldTransfer || transfer == PlaceRebind ||
        transfer == FieldRebind || transfer == AugmentedPlaceTransfer) {
        append_result_path(paths, at, assignment.destination, assignment.input);
        return
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady) {
        append_result_path(paths, at, call.arguments, no_node());
        return
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val construction_form <- inspect_construction(nodes, revision, used, at, construction);
    if (construction_form == BracedConstruction || construction_form == PositionalConstruction) {
        append_result_path(paths, at, construction.placement, construction.contents);
        return
    };
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val binary_form <- inspect_binary(nodes, revision, used, at, binary);
    if (binary_form == ArithmeticBinary || binary_form == ComparisonBinary) {
        append_result_path(paths, at, binary.left_operand, binary.right_operand);
        return
    };
    ref logical = make LogicalSites { left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs; };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr) {
        branch_result_path(paths, at, logical.left_operand, logical.right_operand, no_node(),
            operation != LogicalNot, logical.right_evaluation != TakesRhs);
        return
    };
    ref index = make IndexSites { target <- no_node(); index <- no_node(); };
    if (inspect_index_selection(nodes, revision, used, at, index)) {
        append_result_path(paths, at, index.target, index.index);
        return
    };
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, revision, used, at, field)) {
        append_result_path(paths, at, field.receiver, no_node());
        return
    };
    case nodes[at] of {
        Occupied { val syntax <- node, } -> {
            case syntax.payload of {
                NameReference -> { (paths[at].normal <- true):void };
                IntegerLiteral -> { (paths[at].normal <- true):void };
                BooleanLiteral -> { (paths[at].normal <- true):void };
                TextLiteral -> { (paths[at].normal <- true):void };
                NullLiteral -> { (paths[at].normal <- true):void };
                ArrayLength { val target <-, } -> {
                    if (published_syntax_id(nodes, revision, at, target)) {
                        append_result_path(paths, at, target.index, no_node())
                    }
                };
                DiscardedExpression { val operand <-, } -> {
                    if (published_syntax_id(nodes, revision, at, operand)) {
                        append_result_path(paths, at, operand.index, no_node())
                    }
                };
                _ -> {}
            }
        };
        _ -> {}
    };
    return
}

func complete_omitted_results(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const OperandFacts in F, tree:const ParseResult in T, report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner F, const owner T, owner R} {
    ref paths = make ResultPaths(tree.used, make ResultPath { normal <- false; returns_void <- false });
    val scope <- no_node();
    for (at in 0u64 .. tree.used) {
        scope <- names[at].scope;
        if (scope < tree.used && facts[scope].omitted_result) {
            collect_result_path(nodes, names, facts, paths, at, tree.used, tree.revision)
        };
    };
    return validate_omitted_results(nodes, facts, paths, tree, report)
}

func validate_omitted_results(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    paths:const ResultPaths in P, tree:const ParseResult in T, report:OperandCheckResult in R) -> bool
    where {const owner N, const owner F, const owner P, const owner T, owner R} {
    ref sites = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    ref head = make UInt64 { no_node() };
    val body <- no_node();
    val kind <- 0u8;
    for (at in 0u64 .. tree.used) {
        if (facts[at].omitted_result) {
            if (inspect_callable(nodes, tree.revision, tree.used, at, sites) != ModuleCallable ||
                !find_signature_clause(nodes, tree.revision, tree.used, sites.signature, SignatureHead, head))
                return operand_problem(report, at, invalid_operand_tree());
            body <- sites.body;
            kind <- facts[body].kind;
            if (kind != void_result() && kind != never_result())
                return operand_problem(report, head,
                    if (scalar_kind(kind)) { value_tail_in_void_function() } else { unproved_result_contract() });
            if (!(kind == void_result() && paths[body].normal) && !paths[body].returns_void)
                return operand_problem(report, head, unproved_result_contract())
        }
    };
    return true
}

# A declared receiving reference supplies placement for a directly
# contained text construction. Explicit placement is checked separately.
func prepare_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, owner F} {
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (!inspect_local_binding(nodes, revision, used, at, local) || local.mode != ReferenceLocal) return;
    ref destination = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, local.binding, destination) != TypedBinding ||
        destination.owner_name == no_node() || names[destination.target_type].kind != builtin_string()) return;
    val construction <- ungrouped(nodes, revision, used, local.initializer);
    ref sites = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    if (inspect_construction(nodes, revision, used, construction, sites) == PositionalConstruction &&
        names[sites.requested].kind == builtin_string()) {
        (facts[construction].allocation_owner <- names[destination.owner_name].declaration):void;
    };
}

# Revisit a writable formal only when it reaches an allocation. Its
# incoming argument edges retain the actual owner from each checked call.
func demand_owner_inputs(facts:OperandFacts in F, owners:CallOwners in O, owner_site:UInt64, pending:UInt64 in P)
    -> void where {owner F, owner O, owner P} {
    val argument <- owners[owner_site].uses;
    val actual <- no_node();
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (argument == no_node()) return;
        facts[argument].owner_chain <- 0u64;
        actual <- facts[argument].owner;
        if (facts[actual].owner_chain == no_node()) {
            facts[actual].owner_chain <- 0u64;
            owners[actual].call_site <- pending;
            (pending <- actual):void;
        };
        argument <- facts[argument].owner_use_next;
    };
}

func close_allocation_owners(facts:OperandFacts in F, owners:CallOwners in O, used:UInt64) -> void
    where {owner F, owner O} {
    # Invocation substitutions are complete. Reuse their call-site words as work links.
    val pending <- no_node();
    for (site in 0u64 .. used) {
        if (facts[site].owner_chain != no_node()) {
            owners[site].call_site <- pending;
            (pending <- site):void;
        };
    };
    val site <- no_node();
    for (unused in 0u64 .. used) {
        if (pending == no_node()) return;
        site <- pending;
        pending <- owners[site].call_site;
        demand_owner_inputs(facts, owners, site, pending);
    };
}

# Operands and declarations refer to the bound syntax and its owner sites.
# Target-access demands are recorded for the completion pass, where flow can
# prove a target present or propagate a possible checked failure.
export func check_module_operands(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                  names:const NameBindings in B, links:const NameWork in L,
                                  selected:const SelectedExports in E, module:UInt64,
                                      facts:OperandFacts in F, interfaces:const ModuleInterfaces in I,
                                      published:UInt64,
                                  owners:CallOwners in O, fields:const CaughtFieldUses in X,
                                      views:const SuppliedViews in H, products:const Products in M, arguments:const TypeKeys in M,
                                  cases:const ConstructorCaseFacts in C,
                                  demand:const DeclarationDemands in D,
                                      report:OperandCheckResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner B, const owner L, const owner E,
        owner F, const owner I,
           owner O, const owner X, const owner H, const owner M, const owner C, const owner D, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_operand_tree();
    ref tail = make UInt64 { no_node() };
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || !module_tail(nodes, tree.revision, tree.used, tree.root, tail)) return false;
    if (published > intrinsic (len)(interfaces) ||
        intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(selected) < tree.used || intrinsic (len)(facts) < tree.used ||
        intrinsic (len)(owners) < tree.used ||
        (intrinsic (len)(cases) != 0u64 && intrinsic (len)(cases) < tree.used)) {
        report.diagnostic <- operand_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        set_fact(facts, at, 0u8, 0u8, no_node(), 0u64, 0u8);
        facts[at].needs_target <- 0u8;
        facts[at].discarded_result <- 0u8;
        facts[at].arm_result <- 0u8;
        facts[at].case_item <- 0u8;
        facts[at].case_match <- misses_case_arm();
        facts[at].case_body <- 0u8;
        facts[at].case_guard <- 0u8;
        facts[at].case_resume <- 0u8;
        facts[at].case_end <- 0u8;
        facts[at].case_presence <- unknown_target();
        facts[at].case_selection <- no_node();
        facts[at].case_context <- no_node();
        facts[at].case_after_subject <- no_node();
        facts[at].case_discriminator <- 0u8;
        facts[at].case_may_be_absent <- 0u8;
        facts[at].enum_constant <- 0u8;
        facts[at].discriminator_code <- 0u64;
        facts[at].case_excluded_at <- no_node();
        facts[at].case_exit_link <- no_node();
        facts[at].case_exit_tail <- no_node();
        facts[at].product_words <- 0u64;
        facts[at].bits_product <- false;
        facts[at].word_offset <- 0u64;
        facts[at].last_initializer <- no_node();
        facts[at].call_definition <- no_node();
        facts[at].allocation_owner <- no_node();
        facts[at].owner_chain <- no_node();
        facts[at].owner_use_next <- no_node();
        facts[at].passes_owner <- 0u8;
        facts[at].text_assertion <- 0u8;
        facts[at].enum_assertion_check <- false;
        facts[at].predicate_assertion_check <- false;
        facts[at].text_intrinsic <- 0u8;
        facts[at].omitted_result <- false;
        facts[at].statement_operand <- false;
        facts[at].text_method <- no_node();
        facts[at].text_call <- false;
        owners[at].call_site <- no_node();
        owners[at].actual_owner <- no_node();
        owners[at].uses <- no_node();
    };
    report.diagnostic <- 0u8;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <-
            no_node(); readonly <- false;
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    val annotation <- no_node();
    val diagnostic <- 0u8;
    val throws_annotation <- false;
    for (at in 0u64 .. tree.used) {
        throws_annotation <- inspect_signature(nodes, tree.revision, tree.used, at,
            signature) == ThrowsSignatureClause;
        if (throws_annotation ||
            inspect_catch_binding(nodes, tree.revision, tree.used, at, caught)) {
            annotation <- if (throws_annotation) {
                (signature.annotation)
            } else { (caught.annotation) };
            diagnostic <- exception_annotation(nodes, names, selected, facts, annotation, at,
                module, tree.used, tree.revision);
            if (diagnostic != 0u8) {
                if (annotation == no_node()) return operand_problem(report, at, diagnostic);
                return operand_problem(report, annotation, diagnostic);
            };
        };
    };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    for (at in 0u64 .. tree.used) {
        if (inspect_declaration(nodes, tree.revision, tree.used, at, declaration) == NominalRecord) {
            prepare_product_layout(nodes, names, links, facts, at, tree.revision, tree.used, declaration.entries);
        };
    };
    val source_only <- intrinsic (len)(demand) != 0u64;
    val form <- InvalidCallable;
    val has_omitted_result <- false;
    ref handler = make ScopedProcedureSites { head <- no_node(); signature <- no_node(); body <- no_node() };
    for (at in 0u64 .. tree.used) {
        form <- inspect_callable(nodes, tree.revision, tree.used, at, callable);
        if (needs_signature_check(demand, at) && (form == ModuleCallable || (source_only &&
            (form == CEntry || form == LexicalCallable)))) {
            check_signature(nodes, names, links, facts, views, selected, cases, source_only,
                            form == ModuleCallable && needs_body_check(demand, at), report, at, tree.used, tree.revision, callable);
            if (report.diagnostic != 0u8) return false;
            has_omitted_result <- has_omitted_result || facts[at].omitted_result;
            if (form == ModuleCallable &&
                transfer_name(source, nodes, definition_name(nodes, tree.revision, tree.used,
                    at)) &&
                !supported_transfer_signature(nodes, links, facts, at, tree.used, tree.revision))
                return operand_problem(report, at, unsupported_transfer_signature());
        } else {
            if (source_only && needs_signature_check(demand, at) &&
                inspect_scoped_procedure(nodes, tree.revision, tree.used, at, handler)) {
                check_scoped_operand_signature(nodes, names, links, facts, views, selected, cases,
                    report, at, tree.used, tree.revision, handler);
                if (report.diagnostic != 0u8) return false
            }
        };
    };
    val text_writer <- false;
    for (at in 0u64 .. tree.used) {
        if (needs_signature_check(demand, at) && inspect_callable(nodes, tree.revision, tree.used,
            at, callable) == ModuleCallable && links[at].next_method != no_node()) {
            text_writer <- source_only && (prepared_text_writer(views, at) || prepared_formatting_method(views, at));
            if ((source_only && !text_writer) ||
                transfer_name(source, nodes, definition_name(nodes, tree.revision, tree.used, at))) {
                (report.diagnostic <- check_transfer_signatures(nodes, links, facts, at, tree.used, tree.revision)):void
            } else {
                if (names[at].declaration == at &&
                    !check_value_family(nodes, links, facts, at, tree.used, tree.revision, text_writer, report)) return false
            };
            if (report.diagnostic != 0u8) { report.node <- at; return false; };
        };
    };
    val at <- no_node();
    ref selection = make CaseSites { subject <- no_node(); items <- no_node(); };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref void_result_clause = make UInt64 { no_node() };
    for (offset in 0u64 .. tree.used) {
        at <- tree.used - 1u64 - offset;
        if (source_only && links[at].next < tree.used &&
            inspect_sequence_entry(nodes, tree.revision, tree.used, at, entry) == BlockSequence) {
            facts[entry.item].statement_operand <- true;
            if (intrinsic (len)(cases) != 0u64) {
                discard_aggregate_statement(nodes, cases, facts, entry.item, tree.used, tree.revision)
            }
        };
        if (source_only && intrinsic (len)(cases) != 0u64 && facts[at].kind == void_result()) {
            form <- inspect_callable(nodes, tree.revision, tree.used, at, callable);
            if ((form == ModuleCallable || form == LexicalCallable) && !callable.function_form &&
                find_signature_clause(nodes, tree.revision, tree.used, callable.signature, ValueResultClause,
                    void_result_clause) && void_result_clause != no_node() &&
                !is_scope_block(nodes, callable.body) &&
                block_tail(nodes, tree.revision, tree.used, callable.body, tail) &&
                inspect_sequence_entry(nodes, tree.revision, tree.used, tail, entry) == BlockSequence) {
                discard_aggregate_statement(nodes, cases, facts, entry.item, tree.used, tree.revision)
            }
        };
        prepare_result_use(nodes, facts, at, tree.used, tree.revision);
        prepare_text_receiver(nodes, names, facts, at, tree.used, tree.revision);
        if (needs_body_check(demand, at) && inspect_case(nodes, tree.revision, tree.used, at,
            selection) && names[at].scope != no_node()) {
            (facts[selection.subject].case_after_subject <- at):void;
        } else {};
    };
    if (!check_operand_range(source, nodes, names, links, selected, facts, interfaces, published, owners, fields, views,
        products, arguments, cases, demand, report,
                             0u64, tree.used, tree.used, tree.revision, no_node())) return false;
    if (has_omitted_result) {
        if (!complete_omitted_results(nodes, names, facts, tree, report)) return false;
        for (definition in 0u64 .. tree.used) {
            if (facts[definition].omitted_result) { (facts[definition].kind <- void_result()):void }
        };
        val callee <- no_node();
        for (site in 0u64 .. tree.used) {
            callee <- facts[site].call_definition;
            if (callee < tree.used && facts[callee].omitted_result) {
                # Preserve the prepared actuals and their loan evidence.
                (facts[site].kind <- facts[callee].kind):void
            }
        };
    };
    close_allocation_owners(facts, owners, tree.used);
    # Number reserved allocation-chain words after the syntax-indexed words.
    val next <- tree.used;
    for (site in 0u64 .. tree.used) {
        if (facts[site].owner_chain != no_node()) {
            facts[site].owner_chain <- next;
            next <- next + 1u64;
        };
    };
    return true;
}
