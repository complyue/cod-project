using "SourceStorage.cod" SourceBytes;
using "ParserStorage.cod" {
    ExprNodes, len as syntax_len, no_node, module_node, module_item_node, block_node,
    block_item_node, full_scope_node, try_node, catch_clause_node, catch_handler_node,
    finally_clause_node, callable_node, is_function, parameter_node, ref_parameter_node,
    ptr_parameter_node, val_parameter_node, direct_place_parameter, init_place_parameter_node,
    owner_clause_node, readonly_declaration,
    result_clause_node, ref_result_node, throws_clause_node, catch_binding_node, typed_name_node, owned_type_node,
    val_binding_node, ptr_binding_node, ref_local_node, local_storage_binding, literal_node, name_node, null_node,
    group_node, integer_arithmetic, is_transfer, make_named_node, construction_body,
    construction_type_query_node, reserves_storage, call_node, checked_ref_argument, behave_node,
    return_node, throw_node, deferred_call_node, deferred_block_node, discarded_guard_result,
    discard_node, bool_node, compare_node, conditional_node, narrow_integer_node, range_node,
    range_header_node, literal_range, nonempty_literal_range, logical_not_node, logical_binary,
    skips_right, unequal_words, case_node, case_arm_node, case_false_pattern, case_true_pattern,
    case_fallthrough_node, case_failure_node, break_node, type_assertion_node, enum_declaration_node,
    case_member_pattern, case_null_pattern, data_record_node, field_access_node, initializer_assignment_node,
    ungrouped, text_literal_node, positional_construction, rebind_node,
};
using "ParserInput.cod" ParseResult;
using "NameResolution.cod" {
    NameBindings, NameWork, first_item, callable_head, signature_clause, enclosing_callable, builtin_u64,
    builtin_void, builtin_bool, ordinary_selection, symbolic_selection, callable_binding,
    formal_binding, local_binding, loop_index, exception_binding, find_enum_member,
    record_type, find_record_field, has_exception_parent, builtin_string, builtin_c_string, builtin_u8, owner_binding,
    definition_name, transfer_name,
};
using "ModuleExports.cod" {
    SelectedExports, exception_type_export, symbol_export, print_export_identity,
    exception_root_identity, text_size_export, text_byte_export, callable_export, ordinary_callable_shape,
};
using "ModuleExportStorage.cod" { enum_type, ModuleInterfaceRow, ModuleInterfaces, find_interface, write_interface_header };

# An owner is a lexical scope or an owner parameter's declaration. Exception
# type identity alone does not establish the incoming object's owner.
export data OperandFact {
    kind:u8;
    reception:u8;
    checked_exception:u8;
    target_readonly:u8;
    needs_target:u8;
    target_presence:u8;
    # Only admitted stable pointer holders and their copied selections get an identity.
    selection:u64;
    discarded_result:u8;
    arm_result:u8;
    case_item:u8;
    case_match:u8;
    case_body:u8;
    case_guard:u8;
    case_resume:u8;
    case_end:u8;
    case_presence:u8;
    case_selection:u64;
    case_context:u64;
    case_after_subject:u64;
    case_discriminator:u8;
    case_may_be_absent:u8;
    enum_constant:u8;
    discriminator_code:u64;
    case_excluded_at:u64;
    case_exclusion_member:u64;
    case_exclusion_previous:u64;
    case_exclusion_next:u64;
    case_exit_link:u64;
    case_exit_tail:u64;
    owner:u64;
    identity:u64;
    reservation:u64;
    product_words:u64;
    word_offset:u64;
    last_initializer:u64;
    writable_text_place:u8;
    call_definition:u64;
    text_nul:u8;
    allocation_owner:u64;
    owner_chain:u64;
    owner_use_next:u64;
    passes_owner:u8;
    text_assertion:u8;
    text_intrinsic:u8;
}
export array OperandFacts[u64]:OperandFact;

export data OwnerEvidence {
    call_site:u64;
    actual_owner:u64;
    uses:u64;
}
export array CallOwners[u64]:OwnerEvidence;

export data OperandCheckResult {
    diagnostic:u8;
    node:u64;
}

export func void_result() -> u8 { return 1u8; }
export func scalar_u64() -> u8 { return 2u8; }
export func exception_type() -> u8 { return 3u8; }
export func null_literal() -> u8 { return 4u8; }
export func never_result() -> u8 { return 5u8; }
func scalar_bool() -> u8 { return 6u8; }
func scalar_enum() -> u8 { return 7u8; }
export func product_kind() -> u8 { return 8u8; }
func string_kind() -> u8 { return 9u8; }
func c_string_kind() -> u8 { return 10u8; }
func scalar_u8() -> u8 { return 11u8; }
export func immutable_text_kind(kind:u8) -> bool {
    return kind == string_kind() || kind == c_string_kind();
}
func nul_absent() -> u8 { return 1u8; }
func nul_present() -> u8 { return 2u8; }
func static_text_owner() -> u64 { return no_node() - 1u64; }
export func scalar_kind(kind:u8) -> bool {
    return kind == scalar_u64() || kind == scalar_bool() || kind == scalar_enum() || kind == scalar_u8();
}

export func independent_value() -> u8 { return 1u8; }
export func local_place() -> u8 { return 2u8; }
export func borrowed_ref() -> u8 { return 3u8; }
export func nullable_ptr() -> u8 { return 4u8; }
export func readonly_exception() -> u8 { return 6u8; }

export func present_target() -> u8 { return 1u8; }
export func absent_target() -> u8 { return 2u8; }
export func unknown_target() -> u8 { return 3u8; }

export func unproved_operand() -> u8 { return 1u8; }
export func wrong_operand_type() -> u8 { return 2u8; }
export func expected_exception_type() -> u8 { return 3u8; }
export func unproved_result_contract() -> u8 { return 4u8; }
export func unproved_owner() -> u8 { return 5u8; }
export func incompatible_owner() -> u8 { return 6u8; }
export func expected_writable_place() -> u8 { return 7u8; }
export func unproved_nonnull_borrow() -> u8 { return 8u8; }
export func wrong_argument_count() -> u8 { return 9u8; }
export func wrong_return_type() -> u8 { return 10u8; }
export func unproved_call_target() -> u8 { return 11u8; }
export func operand_storage_exhausted() -> u8 { return 12u8; }
export func invalid_operand_tree() -> u8 { return 13u8; }
func wrong_finally_result() -> u8 { return 14u8; }
func duplicate_catch_category() -> u8 { return 15u8; }
func procedure_call_in_function() -> u8 { return 16u8; }
func value_tail_in_void_function() -> u8 { return 17u8; }
func expected_boolean_condition() -> u8 { return 18u8; }
func unproved_reservation_selection() -> u8 { return 19u8; }
func unsupported_narrow_execution() -> u8 { return 20u8; }
func readonly_owner_argument() -> u8 { return 21u8; }
func checked_selection_requires_ref() -> u8 { return 22u8; }
export func unsupported_case_subject() -> u8 { return 23u8; }
export func unsupported_case_pattern() -> u8 { return 24u8; }
func incomplete_value_case() -> u8 { return 25u8; }
func unsupported_scalar_assertion() -> u8 { return 27u8; }
func missing_enum_member() -> u8 { return 28u8; }
func incompatible_enum_type() -> u8 { return 29u8; }
export func unsupported_product_layout() -> u8 { return 30u8; }
func unknown_product_field() -> u8 { return 31u8; }
func repeated_readonly_initializer() -> u8 { return 32u8; }
func missing_product_initializer() -> u8 { return 33u8; }
func string_operand_required() -> u8 { return 34u8; }
func c_string_operand_required() -> u8 { return 35u8; }
func interior_literal_nul() -> u8 { return 36u8; }
export func unsupported_text_operation() -> u8 { return 37u8; }
func wrong_text_result_owner() -> u8 { return 38u8; }
func unproved_text_policy() -> u8 { return 39u8; }
func text_place_needs_initializer() -> u8 { return 40u8; }
func ambiguous_transfer() -> u8 { return 41u8; }
func duplicate_transfer_signature() -> u8 { return 42u8; }
export func unsupported_transfer_signature() -> u8 { return 43u8; }
export func unproved_transfer_owner() -> u8 { return 44u8; }
export func unsupported_imported_call() -> u8 { return 45u8; }

export func unreachable_case_item() -> u8 { return 1u8; }
export func misses_case_arm() -> u8 { return 0u8; }
export func tests_case_arm() -> u8 { return 1u8; }
export func matches_case_arm() -> u8 { return 2u8; }

export func case_guard_passes() -> u8 { return 1u8; }
export func case_guard_declines() -> u8 { return 2u8; }
export func case_guard_tests() -> u8 { return 3u8; }
func case_guard_exits() -> u8 { return 4u8; }

func set_fact(facts:OperandFacts in F, at:u64, kind:u8, reception:u8,
              owner_site:u64, identity:u64, checked_exception:u8) -> void where {owner F} {
    facts[at].kind <- kind;
    facts[at].reception <- reception;
    facts[at].owner <- owner_site;
    facts[at].identity <- identity;
    facts[at].reservation <- no_node();
    facts[at].checked_exception <- checked_exception;
    facts[at].target_readonly <- 0u8;
    facts[at].writable_text_place <- 0u8;
    facts[at].selection <- no_node();
    facts[at].text_nul <- 0u8;
    facts[at].target_presence <- if (kind == null_literal()) { absent_target() } else {
        if (reception == nullable_ptr()) { unknown_target() } else { present_target() }
    };
    return;
}

func scalar_fact(facts:OperandFacts in F, at:u64, reception:u8, owner_site:u64) -> void where {owner F} {
    set_fact(facts, at, scalar_u64(), reception, owner_site, 0u64, 0u8);
}

func copy_fact(facts:OperandFacts in F, destination:u64, source:u64) -> void where {owner F} {
    set_fact(facts, destination, facts[source].kind, facts[source].reception, facts[source].owner,
             facts[source].identity, facts[source].checked_exception);
    facts[destination].reservation <- facts[source].reservation;
    facts[destination].target_readonly <- facts[source].target_readonly;
    facts[destination].target_presence <- facts[source].target_presence;
    facts[destination].selection <- facts[source].selection;
    facts[destination].text_nul <- facts[source].text_nul;
    return;
}

func only_void(facts:OperandFacts in F, at:u64) -> void where {owner F} {
    set_fact(facts, at, void_result(), 0u8, no_node(), 0u64, 0u8);
}

func require_typed_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64, kind:u8) -> u8
    where {const owner N, owner F} {
    if (local_storage_binding(nodes[operand].kind))
        return unproved_operand();
    if (facts[operand].kind == 0u8) return unproved_operand();
    if (!scalar_kind(kind) || facts[operand].kind != kind) return wrong_operand_type();
    if (facts[operand].reception == nullable_ptr()) {
        facts[operand].needs_target <- 1u8;
        return 0u8;
    } else {};
    return 0u8;
}

func compatible_operand_nominal(facts:const OperandFacts in F, operand:u64, kind:u8, identity:u64) -> bool
    where {const owner F} {
    return facts[operand].kind != kind || (kind != scalar_enum() && kind != product_kind()) ||
        facts[operand].identity == identity;
}

func same_operand_type(facts:const OperandFacts in F, left:u64, right:u64) -> bool where {const owner F} {
    return facts[left].kind == facts[right].kind &&
        compatible_operand_nominal(facts, left, facts[right].kind, facts[right].identity);
}

func require_matching_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64, expected:u64) -> u8
    where {const owner N, owner F} {
    if (facts[expected].kind == scalar_enum() && facts[operand].kind == scalar_enum() &&
        !same_operand_type(facts, operand, expected)) return wrong_operand_type();
    return require_typed_bits(nodes, facts, operand, facts[expected].kind);
}

func require_bits(nodes:const ExprNodes in N, facts:OperandFacts in F, operand:u64) -> u8
    where {const owner N, owner F} {
    return require_typed_bits(nodes, facts, operand, scalar_u64());
}

func declared_scalar(binding:u8) -> u8 {
    if (binding == builtin_u64()) return scalar_u64();
    if (binding == builtin_u8()) return scalar_u8();
    if (binding == builtin_bool()) return scalar_bool();
    if (binding == enum_type()) return scalar_enum();
    return 0u8;
}

func nominal_identity(names:const NameBindings in B, annotation:u64) -> u64 where {const owner B} {
    val kind <- names[annotation].kind;
    if (kind == enum_type() || kind == record_type()) return names[annotation].declaration;
    return 0u64;
}

func declared_borrow(names:const NameBindings in B, facts:const OperandFacts in F, annotation:u64) -> u8
    where {const owner B, const owner F} {
    if (names[annotation].kind == record_type() && facts[names[annotation].declaration].product_words != 0u64)
        return product_kind();
    val kind <- names[annotation].kind;
    if (kind == builtin_string()) return string_kind();
    if (kind == builtin_c_string()) return c_string_kind();
    return declared_scalar(kind);
}

func prepare_product_layout(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                            facts:OperandFacts in F, record:u64) -> void
    where {const owner N, const owner B, const owner L, owner F} {
    if (has_exception_parent(nodes, names, record)) return;
    val field <- first_item(nodes, nodes[record].right);
    val words <- 0u64;
    val mode <- 0u8;
    val annotation <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (field == no_node()) {
            facts[record].product_words <- words;
            return;
        };
        mode <- nodes[field].kind;
        if (mode != parameter_node() && mode != val_parameter_node()) return;
        annotation <- nodes[nodes[field].right].right;
        if (declared_scalar(names[annotation].kind) == 0u8 && names[annotation].kind != builtin_string()) return;
        facts[field].word_offset <- words;
        words <- words + 1u64;
        field <- links[field].next;
    };
}

func owner_conflict(nodes:const ExprNodes in N, first:u64, second:u64) -> u8 where {const owner N} {
    if ((first != static_text_owner() && nodes[first].kind == owner_clause_node()) ||
        (second != static_text_owner() && nodes[second].kind == owner_clause_node()))
        return unproved_owner();
    return incompatible_owner();
}

func exception_annotation(names:const NameBindings in N, selected:const SelectedExports in E,
                          facts:OperandFacts in F, annotation:u64, at:u64) -> u8
    where {const owner N, const owner E, owner F} {
    if (names[annotation].kind != ordinary_selection()) return expected_exception_type();
    val site <- names[annotation].declaration;
    if (selected[site].kind != exception_type_export()) return expected_exception_type();
    set_fact(facts, at, exception_type(), readonly_exception(), no_node(),
             selected[site].identity, selected[site].checked);
    return 0u8;
}

func check_formal(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                  formal:u64, definition:u64) -> u8 where {const owner N, const owner B, owner F} {
    val form <- nodes[formal].kind;
    val binding <- nodes[formal].right;
    val annotation <- nodes[binding].right;
    val readonly <- if (nodes[binding].number == readonly_declaration()) { 1u8 } else { 0u8 };
    val place <- direct_place_parameter(form);
    if (nodes[annotation].kind == owned_type_node()) {
        if (form != ref_parameter_node() && form != ptr_parameter_node() && !place)
            return unproved_operand();
        val target <- nodes[annotation].left;
        val borrowed_kind <- declared_borrow(names, facts, target);
        if (names[target].kind == record_type() && (borrowed_kind == 0u8 || form == ptr_parameter_node()))
            return unsupported_product_layout();
        if (place && (borrowed_kind != string_kind() || readonly != 0u8)) return unsupported_text_operation();
        if (!place && immutable_text_kind(borrowed_kind) && (form != ref_parameter_node() || readonly == 0u8))
            return unsupported_text_operation();
        if (borrowed_kind == 0u8) return unproved_operand();
        val owner_site <- names[nodes[annotation].right].declaration;
        if (owner_site == no_node() || nodes[owner_site].kind != owner_clause_node()) return unproved_owner();
        val reception <- if (form == ptr_parameter_node()) { nullable_ptr() } else { borrowed_ref() };
        set_fact(facts, formal, borrowed_kind, reception, owner_site, nominal_identity(names, target), 0u8);
        if (reception == nullable_ptr()) { (facts[formal].selection <- formal):void; } else {};
        facts[formal].target_readonly <- if (place) { 1u8 } else { readonly };
        if (place) { (facts[formal].writable_text_place <- 1u8):void; };
        if (borrowed_kind == c_string_kind()) { (facts[formal].text_nul <- nul_absent()):void; };
        if (nodes[owner_site].number != readonly_declaration() && facts[owner_site].passes_owner == 0u8) {
            facts[owner_site].passes_owner <- 1u8;
            (facts[formal].passes_owner <- 1u8):void;
        };
        return 0u8;
    } else {};
    if (place) return unsupported_text_operation();
    if (form != parameter_node() && form != val_parameter_node() && form != ref_parameter_node() &&
        form != ptr_parameter_node()) return unproved_operand();
    val kind <- declared_scalar(names[annotation].kind);
    if (kind == 0u8) return unproved_operand();
    set_fact(facts, formal, kind, local_place(), definition, nominal_identity(names, annotation), 0u8);
    facts[formal].target_readonly <- readonly;
    return 0u8;
}

func check_formals(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:OperandFacts in F, report:OperandCheckResult in R,
                   definition:u64, tail:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, owner F, owner R} {
    val formal <- first_item(nodes, tail);
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return;
        report.diagnostic <- check_formal(nodes, names, facts, formal, definition);
        if (report.diagnostic != 0u8) { report.node <- formal; return; } else {};
        formal <- links[formal].next;
    };
}

func check_borrowed_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, definition:u64, clause:u64) -> u8
    where {const owner N, const owner B, owner F} {
    val annotation <- nodes[clause].right;
    if (nodes[annotation].kind != owned_type_node() || names[clause].declaration != no_node())
        return unsupported_text_operation();
    val target <- nodes[annotation].left;
    val kind <- declared_borrow(names, facts, target);
    val owner_site <- names[nodes[annotation].right].declaration;
    val readonly <- nodes[clause].number == readonly_declaration();
    if (kind != product_kind() && (!immutable_text_kind(kind) || !readonly))
        return unproved_result_contract();
    if (owner_site == no_node() || nodes[owner_site].kind != owner_clause_node()) return unproved_owner();
    set_fact(facts, definition, kind, borrowed_ref(), owner_site, nominal_identity(names, target), 0u8);
    facts[definition].target_readonly <- if (readonly) { 1u8 } else { 0u8 };
    if (kind == c_string_kind()) { (facts[definition].text_nul <- nul_absent()):void; };
    return 0u8;
}

func check_signature_clauses(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                             selected:const SelectedExports in E, facts:OperandFacts in F,
                             report:OperandCheckResult in R, definition:u64, first:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner R} {
    val clause <- first;
    val annotation <- no_node();
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) return;
        annotation <- nodes[clause].right;
        if (nodes[clause].kind == result_clause_node()) {
            if (names[annotation].kind == builtin_void()) {
                only_void(facts, definition);
            } else {
                kind <- declared_scalar(names[annotation].kind);
                if (kind == 0u8) {
                    report.node <- annotation;
                    report.diagnostic <- unproved_result_contract();
                    return;
                } else {};
                set_fact(facts, definition, kind, independent_value(), no_node(), nominal_identity(names, annotation), 0u8);
            };
        };
        if (nodes[clause].kind == ref_result_node()) {
            (report.diagnostic <- check_borrowed_result(nodes, names, facts, definition, clause)):void;
        };
        if (nodes[clause].kind == throws_clause_node()) {
            report.diagnostic <- exception_annotation(names, selected, facts, annotation, clause);
            if (report.diagnostic != 0u8) { report.node <- annotation; return; };
        };
        if (report.diagnostic != 0u8) { report.node <- clause; return; };
        clause <- links[clause].next;
    };
}

func check_signature(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     selected:const SelectedExports in E, facts:OperandFacts in F,
                     report:OperandCheckResult in R, definition:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner R} {
    val head <- callable_head(nodes, definition);
    check_formals(nodes, names, links, facts, report, definition, nodes[head].right, used);
    if (report.diagnostic != 0u8) return;
    check_signature_clauses(nodes, names, links, selected, facts, report, definition, links[head].next, used);
    if (report.diagnostic == 0u8 && facts[definition].kind == 0u8) {
        report.node <- head;
        (report.diagnostic <- unproved_result_contract()):void;
    } else {};
}

func check_local(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                  at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val binding <- nodes[at].left;
    val initializer <- nodes[at].right;
    val type_name <- no_node();
    if (nodes[binding].kind == typed_name_node()) { (type_name <- nodes[binding].right):void; } else {};
    val readonly <- if (type_name != no_node() && nodes[binding].number == readonly_declaration()) {
        1u8
    } else { 0u8 };
    val required_owner <- no_node();
    val value_binding <- nodes[at].kind == val_binding_node();
    if (type_name != no_node() && nodes[type_name].kind == owned_type_node()) {
        if (value_binding) return unproved_operand();
        required_owner <- names[nodes[type_name].right].declaration;
        (type_name <- nodes[type_name].left):void;
    } else {};
    val declared_kind <- if (type_name == no_node()) { 0u8 } else { declared_borrow(names, facts, type_name) };
    if (declared_kind == product_kind() || facts[initializer].kind == product_kind()) {
        if (value_binding || nodes[at].kind == ptr_binding_node()) return unsupported_product_layout();
    };
    if (immutable_text_kind(declared_kind) || immutable_text_kind(facts[initializer].kind)) {
        if (value_binding || nodes[at].kind == ptr_binding_node()) return unsupported_text_operation();
    };
    if (declared_kind == 0u8 && type_name != no_node()) return unproved_operand();
    val identity <- if (type_name == no_node()) { (facts[initializer].identity) } else { nominal_identity(names, type_name) };
    if (declared_kind == scalar_enum() && facts[initializer].kind == scalar_enum() &&
        identity != facts[initializer].identity) return incompatible_enum_type();
    if (facts[initializer].kind == never_result()) {
        if (required_owner != no_node() && nodes[initializer].kind == make_named_node()) {
            val placement <- facts[initializer].allocation_owner;
            val actual <- if (placement == no_node()) { (names[initializer].scope) } else { placement };
            if (required_owner != actual) return owner_conflict(nodes, actual, required_owner);
        };
        set_result(facts, at, never_result());
        return 0u8;
    } else {};
    if (value_binding) {
        val value_kind <- if (declared_kind == 0u8) { (facts[initializer].kind) } else { declared_kind };
        if (reserves_storage(nodes, initializer)) {
            if (facts[initializer].kind != value_kind) return wrong_operand_type();
            set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
            facts[at].target_readonly <- readonly;
            facts[at].reservation <- initializer;
            return 0u8;
        } else {};
        val diagnostic <- require_typed_bits(nodes, facts, initializer, value_kind);
        if (diagnostic != 0u8) return diagnostic;
        set_fact(facts, at, value_kind, local_place(), names[at].scope, identity, 0u8);
        facts[at].target_readonly <- readonly;
        return 0u8;
    } else {};
    if (local_storage_binding(nodes[initializer].kind)) return unproved_operand();
    val pointer <- nodes[at].kind == ptr_binding_node();
    val reception <- if (pointer) { nullable_ptr() } else { borrowed_ref() };
    val fresh <- facts[initializer].reception == independent_value();
    val kind <- if (type_name == no_node()) { (facts[initializer].kind) } else { declared_kind };
    val owner_site <- if (fresh) { (names[at].scope) } else { (facts[initializer].owner) };
    if (required_owner != no_node()) {
        if (owner_site != no_node() && owner_site != required_owner)
            return owner_conflict(nodes, owner_site, required_owner);
        (owner_site <- required_owner):void;
    } else {};
    if (facts[initializer].kind == null_literal()) {
        if (!pointer) return unproved_nonnull_borrow();
    } else {
        if (immutable_text_kind(kind)) {
            if (!immutable_text_kind(facts[initializer].kind)) return string_operand_required();
            if (kind == c_string_kind() && facts[initializer].kind != c_string_kind() &&
                !(nodes[ungrouped(nodes, initializer)].kind == text_literal_node() && facts[initializer].text_nul == nul_absent()))
                return c_string_operand_required();
        } else {
            if ((!scalar_kind(kind) && kind != product_kind()) || facts[initializer].kind != kind)
                return unproved_operand();
        };
        if (kind == product_kind() && facts[initializer].identity != identity) return wrong_operand_type();
        if (type_name != no_node() && facts[initializer].target_readonly != 0u8 && readonly == 0u8)
            return expected_writable_place();
    };
    if (owner_site == no_node()) return unproved_owner();
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].target_readonly <- if (type_name == no_node()) { (facts[initializer].target_readonly) } else { readonly };
    facts[at].reservation <- facts[initializer].reservation;
    facts[at].text_nul <- facts[initializer].text_nul;
    if (pointer) {
        facts[at].target_presence <- facts[initializer].target_presence;
        val selected <- facts[initializer].selection;
        (facts[at].selection <- if (selected == no_node()) { at } else { selected }):void;
    } else {};
    return 0u8;
}

func check_text_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                             facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner B, owner F} {
    val payload <- nodes[at].right;
    val tail <- nodes[payload].left;
    if (!positional_construction(nodes, at) || tail == no_node() || nodes[tail].left != no_node())
        return unsupported_text_operation();
    val source <- nodes[tail].right;
    val placement <- nodes[payload].right;
    val owner_site <- facts[at].allocation_owner;
    if (placement != no_node()) { (owner_site <- names[placement].declaration):void; };
    if (owner_site == no_node()) { (owner_site <- names[at].scope):void; };
    if (nodes[owner_site].kind == owner_clause_node() && nodes[owner_site].number == readonly_declaration())
        return readonly_owner_argument();
    facts[at].allocation_owner <- owner_site;
    (facts[owner_site].owner_chain <- 0u64):void;
    if (facts[source].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (!immutable_text_kind(facts[source].kind)) return string_operand_required();
    set_fact(facts, at, string_kind(), borrowed_ref(), owner_site, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- facts[source].text_nul;
    return 0u8;
}

func check_text_assertion(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val operand <- nodes[at].left;
    if (facts[operand].kind == never_result()) { copy_fact(facts, at, operand); return 0u8; };
    if (!immutable_text_kind(facts[operand].kind)) return string_operand_required();
    if (facts[operand].text_nul == nul_present()) return interior_literal_nul();
    set_fact(facts, at, c_string_kind(), borrowed_ref(), facts[operand].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].text_nul <- nul_absent();
    (facts[at].text_assertion <- if (facts[operand].text_nul == nul_absent()) { 0u8 } else { 1u8 }):void;
    return 0u8;
}

func check_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                        facts:OperandFacts in F, at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val requested <- nodes[at].left;
    val kind <- if (nodes[requested].kind == construction_type_query_node()) {
        (facts[nodes[requested].left].kind)
    } else { declared_scalar(names[requested].kind) };
    if (!scalar_kind(kind)) return unproved_operand();
    val identity <- if (nodes[requested].kind == construction_type_query_node()) {
        (facts[nodes[requested].left].identity)
    } else { nominal_identity(names, requested) };
    val owner_site <- names[at].scope;
    val explicit_owner <- nodes[nodes[at].right].right;
    if (explicit_owner != no_node() && names[explicit_owner].declaration != owner_site) return unproved_owner();
    val body <- construction_body(nodes, at);
    if (body == no_node()) {
        set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
        facts[at].reservation <- at;
        return 0u8;
    } else {};
    if (facts[body].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (kind == scalar_enum() && facts[body].kind == scalar_enum() && facts[body].identity != identity)
        return incompatible_enum_type();
    val diagnostic <- require_typed_bits(nodes, facts, body, kind);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, kind, borrowed_ref(), owner_site, identity, 0u8);
    return 0u8;
}

data ProductInitialization {
    count:u64;
    abrupt:bool;
}

func check_owner_access(nodes:const ExprNodes in N, actual_owner:u64, requires_allocation:bool) -> u8
    where {const owner N} {
    if (actual_owner == no_node()) return unproved_owner();
    val readonly_owner <- actual_owner == static_text_owner() ||
        (nodes[actual_owner].kind == owner_clause_node() && nodes[actual_owner].number == readonly_declaration());
    if (readonly_owner && requires_allocation) return readonly_owner_argument();
    return 0u8;
}

func record_owner_argument(nodes:const ExprNodes in N, facts:OperandFacts in F, owners:CallOwners in O,
                           formal:u64, actual_owner:u64, argument:u64, invocation:u64) -> u8
    where {const owner N, owner F, owner O} {
    val owner_parameter <- facts[formal].owner;
    val diagnostic <- check_owner_access(nodes, actual_owner, nodes[owner_parameter].number != readonly_declaration());
    if (diagnostic != 0u8) return diagnostic;
    if (owners[owner_parameter].call_site == invocation && owners[owner_parameter].actual_owner != actual_owner)
        return owner_conflict(nodes, owners[owner_parameter].actual_owner, actual_owner);
    owners[owner_parameter].call_site <- invocation;
    owners[owner_parameter].actual_owner <- actual_owner;
    if (facts[formal].passes_owner != 0u8) {
        facts[argument].owner_use_next <- owners[owner_parameter].uses;
        (owners[owner_parameter].uses <- argument):void;
    };
    return 0u8;
}

func binary_formals(nodes:const ExprNodes in N, links:const NameWork in L, definition:u64) -> u64
    where {const owner N, const owner L} {
    val tail <- nodes[callable_head(nodes, definition)].right;
    if (tail == no_node()) return no_node();
    val first <- nodes[tail].left;
    if (first == no_node() || nodes[first].left != no_node() || links[first].next != tail) return no_node();
    return first;
}

func owner_parameter(nodes:const ExprNodes in N, owner_site:u64) -> bool where {const owner N} {
    return owner_site != no_node() && owner_site != static_text_owner() && nodes[owner_site].kind == owner_clause_node();
}

func shares_owner(nodes:const ExprNodes in N, facts:const OperandFacts in F, first:u64, second:u64) -> bool
    where {const owner N, const owner F} {
    return facts[first].owner == facts[second].owner && owner_parameter(nodes, facts[first].owner);
}

func text_conforms(actual:u8, formal:u8) -> bool {
    return actual == formal || (actual == c_string_kind() && formal == string_kind());
}

func matching_transfer() -> u8 { return 1u8; }
func possible_transfer() -> u8 { return 2u8; }

func transfer_match(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                    at:u64, method:u64) -> u8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, method);
    val second <- links[first].next;
    val left <- nodes[at].left;
    val right <- nodes[at].right;
    if (!same_operand_type(facts, left, first) || !text_conforms(facts[right].kind, facts[second].kind))
        return 0u8;
    if (!shares_owner(nodes, facts, first, second) || facts[left].owner == facts[right].owner)
        return matching_transfer();
    if (owner_parameter(nodes, facts[left].owner) && owner_parameter(nodes, facts[right].owner))
        return possible_transfer();
    return 0u8;
}

# All admitted policies have a writable destination and readonly text input.
# Text conformance and owner equality constrain independent parts of the domain.
func transfer_dominates(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        narrow:u64, wide:u64, match_kind:u8) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, narrow);
    val other <- binary_formals(nodes, links, wide);
    val second <- links[first].next;
    val other_second <- links[other].next;
    if (!text_conforms(facts[second].kind, facts[other_second].kind)) return false;
    val narrow_owner <- shares_owner(nodes, facts, first, second);
    val wide_owner <- shares_owner(nodes, facts, other, other_second);
    if (wide_owner && !narrow_owner) return false;
    if (narrow_owner && !wide_owner && match_kind != matching_transfer()) return false;
    return narrow_owner != wide_owner || facts[second].kind != facts[other_second].kind;
}

func dominated_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        at:u64, family:u64, method:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val other <- family;
    val relation <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (other == no_node()) return false;
        if (other != method) {
            relation <- transfer_match(nodes, links, facts, at, other);
            if (relation != 0u8 && transfer_dominates(nodes, links, facts, other, method, relation))
                return true;
        };
        other <- links[other].next_method;
    };
    return false;
}

func select_transfer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                     at:u64, family:u64, selected:u64 in D) -> u8
    where {const owner N, const owner L, const owner F, owner D} {
    val method <- family;
    val relation <- 0u8;
    val ambiguous <- false;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (method == no_node()) {
            if (ambiguous) return ambiguous_transfer();
            return if (selected == no_node()) { unproved_text_policy() } else { 0u8 };
        };
        relation <- transfer_match(nodes, links, facts, at, method);
        if (relation != 0u8 && !dominated_transfer(nodes, links, facts, at, family, method)) {
            if (relation == possible_transfer()) return unproved_transfer_owner();
            if (selected != no_node()) { (ambiguous <- true):void; };
            (selected <- method):void;
        };
        method <- links[method].next_method;
    };
    return invalid_operand_tree();
}

func supported_transfer_signature(nodes:const ExprNodes in N, links:const NameWork in L,
                                  facts:const OperandFacts in F, definition:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition);
    if (first == no_node() || facts[definition].kind != void_result()) return false;
    val second <- links[first].next;
    val place <- facts[first].writable_text_place != 0u8 ||
        (facts[first].kind == product_kind() && facts[first].target_readonly == 0u8);
    return place && facts[first].reception == borrowed_ref() &&
        facts[second].reception == borrowed_ref() && facts[second].writable_text_place == 0u8 &&
        immutable_text_kind(facts[second].kind);
}

func check_transfer_signatures(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                               definition:u64) -> u8 where {const owner N, const owner L, const owner F} {
    val first <- binary_formals(nodes, links, definition);
    val second <- links[first].next;
    val member <- links[definition].next_method;
    val other <- no_node();
    val other_second <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (member == no_node()) return 0u8;
        other <- binary_formals(nodes, links, member);
        if (is_function(nodes, definition) != is_function(nodes, member))
            return unsupported_transfer_signature();
        other_second <- links[other].next;
        if (same_operand_type(facts, first, other) && same_operand_type(facts, second, other_second) &&
            shares_owner(nodes, facts, first, second) == shares_owner(nodes, facts, other, other_second))
            return duplicate_transfer_signature();
        member <- links[member].next_method;
    };
    return invalid_operand_tree();
}

func check_transfer_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:OperandFacts in F, owners:CallOwners in O, at:u64, initializing:bool) -> u8
    where {const owner N, const owner B, const owner L, owner F, owner O} {
    if (names[at].kind != callable_binding()) return unproved_text_policy();
    val destination <- nodes[at].left;
    val input <- nodes[at].right;
    if (facts[destination].kind == product_kind() &&
        (facts[destination].target_readonly != 0u8 || facts[destination].reception != borrowed_ref()))
        return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    val family <- names[at].declaration;
    val definition <- no_node();
    val diagnostic <- select_transfer(nodes, links, facts, at, family, definition);
    if (diagnostic != 0u8) return diagnostic;
    val place <- binary_formals(nodes, links, definition);
    val text <- links[place].next;
    if (initializing && nodes[place].kind != init_place_parameter_node()) return text_place_needs_initializer();
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val place_owner <- facts[destination].owner;
    diagnostic <- record_owner_argument(nodes, facts, owners, place, place_owner, at, at);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- record_owner_argument(nodes, facts, owners, text, facts[input].owner, input, at);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, void_result(), 0u8, place_owner, 0u64, 0u8);
    facts[at].call_definition <- definition;
    return 0u8;
}

func check_product_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N,
                               names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                               owners:CallOwners in O, state:ProductInitialization in P, at:u64, record:u64, assignment:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O, owner P} {
    if (nodes[assignment].kind != initializer_assignment_node() || !is_transfer(nodes, assignment))
        return unsupported_product_layout();
    val name <- ungrouped(nodes, nodes[assignment].left);
    val field <- find_record_field(source, nodes, links, record, name);
    if (field == no_node()) return unknown_product_field();
    val binding <- nodes[field].right;
    val first <- facts[field].last_initializer != at;
    if (!first && nodes[binding].number == readonly_declaration()) return repeated_readonly_initializer();
    val value <- nodes[assignment].right;
    val annotation <- nodes[binding].right;
    if (names[annotation].kind == builtin_string()) {
        val destination <- nodes[assignment].left;
        set_fact(facts, destination, string_kind(), borrowed_ref(), names[at].scope, 0u64, 0u8);
        facts[destination].writable_text_place <- 1u8;
        val diagnostic <- check_transfer_call(nodes, names, links, facts, owners, assignment, true);
        if (diagnostic != 0u8) return diagnostic;
    } else {
        if (facts[value].kind == never_result()) {
            (state.abrupt <- true):void;
        } else {
            val kind <- declared_scalar(names[annotation].kind);
            val bits_problem <- require_typed_bits(nodes, facts, value, kind);
            if (bits_problem != 0u8) return bits_problem;
            if (kind == scalar_enum() && facts[value].identity != nominal_identity(names, annotation))
                return incompatible_enum_type();
        };
    };
    facts[field].last_initializer <- at;
    facts[assignment].word_offset <- facts[field].word_offset;
    if (first) { (state.count <- state.count + 1u64):void; };
    return 0u8;
}

func check_product_construction(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                                owners:CallOwners in O, at:u64, record:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner O} {
    val words <- facts[record].product_words;
    val body <- construction_body(nodes, at);
    if (words == 0u64 || body == no_node()) return unsupported_product_layout();
    val owner_site <- names[at].scope;
    val placement <- nodes[nodes[at].right].right;
    if (placement != no_node() && names[placement].declaration != owner_site) return unproved_owner();
    ref state = make ProductInitialization { count <- 0u64; abrupt <- false; };
    val item <- first_item(nodes, nodes[body].left);
    val diagnostic <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) {
            if (state.count != words) return missing_product_initializer();
            facts[at].product_words <- words;
            if (state.abrupt) { set_result(facts, at, never_result()); }
            else { set_fact(facts, at, product_kind(), borrowed_ref(), owner_site, record, 0u8); };
            return 0u8;
        };
        diagnostic <- check_product_initializer(source, nodes, names, links, facts, owners, state, at, record, nodes[item].right);
        if (diagnostic != 0u8) return diagnostic;
        item <- links[item].next;
    };
    return invalid_operand_tree();
}

func check_field_access(source:const SourceBytes in S, nodes:const ExprNodes in N,
                        names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F, at:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F} {
    val receiver <- nodes[at].left;
    if (facts[receiver].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; };
    if (facts[receiver].kind != product_kind() || facts[receiver].reception != borrowed_ref())
        return unsupported_product_layout();
    val field <- find_record_field(source, nodes, links, facts[receiver].identity, nodes[at].right);
    if (field == no_node()) return unknown_product_field();
    val binding <- nodes[field].right;
    val annotation <- nodes[binding].right;
    val kind <- if (names[annotation].kind == builtin_string()) { string_kind() } else { declared_scalar(names[annotation].kind) };
    set_fact(facts, at, kind, borrowed_ref(), facts[receiver].owner,
             nominal_identity(names, annotation), 0u8);
    facts[at].word_offset <- facts[field].word_offset;
    facts[at].target_readonly <- if (facts[receiver].target_readonly != 0u8 ||
        nodes[binding].number == readonly_declaration()) { 1u8 } else { 0u8 };
    if (kind == string_kind()) {
        facts[at].writable_text_place <- if (facts[at].target_readonly == 0u8) { 1u8 } else { 0u8 };
        (facts[at].target_readonly <- 1u8):void;
    };
    return 0u8;
}

func check_text_installation(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val destination <- nodes[at].left;
    val input <- nodes[at].right;
    if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
    if (!immutable_text_kind(facts[input].kind)) return string_operand_required();
    if (facts[destination].owner != facts[input].owner)
        return owner_conflict(nodes, facts[destination].owner, facts[input].owner);
    set_fact(facts, at, string_kind(), borrowed_ref(), facts[destination].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    return 0u8;
}

func check_transfer(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val destination <- nodes[at].left;
    val supplied <- nodes[at].right;
    val reception <- facts[destination].reception;
    val kind <- facts[destination].kind;
    if (!scalar_kind(kind)) return unproved_operand();
    if (facts[destination].target_readonly != 0u8 ||
        (reception != local_place() && reception != borrowed_ref() && reception != nullable_ptr()))
        return expected_writable_place();
    val diagnostic <- require_typed_bits(nodes, facts, destination, kind);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_matching_bits(nodes, facts, supplied, destination);
    if (diagnostic != 0u8) return diagnostic;
    set_fact(facts, at, kind, borrowed_ref(), facts[destination].owner, facts[destination].identity, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].reservation <- facts[destination].reservation;
    return 0u8;
}

func check_argument_operand(nodes:const ExprNodes in N, facts:OperandFacts in F, argument:u64,
                            kind:u8, wanted:u8, identity:u64, readonly:u8) -> u8
    where {const owner N, owner F} {
    val actual <- nodes[argument].right;
    if (checked_ref_argument(nodes, argument) && wanted != borrowed_ref())
        return checked_selection_requires_ref();
    if (wanted == local_place()) {
        if (!compatible_operand_nominal(facts, actual, kind, identity)) return wrong_operand_type();
        val bits_problem <- require_typed_bits(nodes, facts, actual, kind);
        if (bits_problem != 0u8) return bits_problem;
        set_fact(facts, argument, kind, independent_value(), no_node(), identity, 0u8);
        return 0u8;
    } else {};
    if (local_storage_binding(nodes[actual].kind) ||
        facts[actual].kind == 0u8 || facts[actual].kind == null_literal()) return unproved_operand();
    if (immutable_text_kind(kind)) {
        if (!immutable_text_kind(facts[actual].kind)) return string_operand_required();
        if (kind == c_string_kind() && facts[actual].kind != c_string_kind() &&
            !(nodes[ungrouped(nodes, actual)].kind == text_literal_node() && facts[actual].text_nul == nul_absent()))
            return c_string_operand_required();
    } else {
        if (facts[actual].kind != kind || !compatible_operand_nominal(facts, actual, kind, identity))
            return wrong_operand_type();
    };
    if (facts[actual].reception == independent_value()) return unproved_owner();
    if (facts[actual].target_readonly != 0u8 && readonly == 0u8) return expected_writable_place();
    set_fact(facts, argument, kind, wanted, facts[actual].owner, identity, 0u8);
    return 0u8;
}

func check_argument(nodes:const ExprNodes in N, facts:OperandFacts in F, owners:CallOwners in O,
                    argument:u64, formal:u64, invocation:u64) -> u8 where {const owner N, owner F, owner O} {
    if (facts[formal].writable_text_place != 0u8) return unsupported_text_operation();
    val wanted <- facts[formal].reception;
    val diagnostic <- check_argument_operand(nodes, facts, argument, facts[formal].kind, wanted,
                                             facts[formal].identity, facts[formal].target_readonly);
    if (diagnostic != 0u8 || wanted == local_place()) return diagnostic;
    return record_owner_argument(nodes, facts, owners, formal, facts[argument].owner, argument, invocation);
}

func check_text_intrinsic(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                          at:u64, intrinsic_kind:u8) -> u8
    where {const owner N, const owner L, owner F} {
    if (intrinsic_kind != text_size_export() && intrinsic_kind != text_byte_export()) return unproved_call_target();
    val first <- first_item(nodes, nodes[at].right);
    if (first == no_node()) return wrong_argument_count();
    val next <- links[first].next;
    val byte <- intrinsic_kind == text_byte_export();
    if ((!byte && next != no_node()) || (byte && (next == no_node() || links[next].next != no_node())))
        return wrong_argument_count();
    val text <- nodes[first].right;
    if (!immutable_text_kind(facts[text].kind)) return string_operand_required();
    copy_fact(facts, first, text);
    if (byte) {
        val diagnostic <- require_bits(nodes, facts, nodes[next].right);
        if (diagnostic != 0u8) return diagnostic;
        scalar_fact(facts, next, independent_value(), no_node());
    };
    if (byte) { set_result(facts, at, scalar_u8()); } else { set_result(facts, at, scalar_u64()); };
    (facts[at].text_intrinsic <- intrinsic_kind):void;
    return 0u8;
}

func check_direct_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       selected:const SelectedExports in E, facts:OperandFacts in F,
                       owners:CallOwners in O, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner O} {
    val callee <- nodes[at].left;
    if (names[callee].kind == ordinary_selection()) {
        val site <- names[callee].declaration;
        if (selected[site].kind == callable_export()) return check_imported_call(nodes, names, links, facts, at, used);
        return check_text_intrinsic(nodes, links, facts, at, selected[site].kind);
    };
    if (names[callee].kind != callable_binding()) return unproved_call_target();
    val definition <- names[callee].declaration;
    if (links[definition].next_method != no_node()) return unsupported_transfer_signature();
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val head <- callable_head(nodes, definition);
    val formal <- first_item(nodes, nodes[head].right);
    val argument <- first_item(nodes, nodes[at].right);
    val result_owner <- facts[definition].owner;
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (formal == no_node() || argument == no_node()) {
            if (formal != argument) return wrong_argument_count();
            copy_fact(facts, at, definition);
            if (facts[definition].reception == borrowed_ref()) {
                if (owners[result_owner].call_site != at) return unproved_owner();
                (facts[at].owner <- owners[result_owner].actual_owner):void;
            };
            facts[at].call_definition <- definition;
            return 0u8;
        } else {};
        diagnostic <- check_argument(nodes, facts, owners, argument, formal, at);
        if (diagnostic != 0u8) return diagnostic;
        formal <- links[formal].next;
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func check_imported_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:OperandFacts in F, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F} {
    if (links[at].imported_function == no_node()) return unsupported_imported_call();
    if (links[at].imported_procedure != 0u8 && is_function(nodes, enclosing_callable(nodes, names, names[at].scope)))
        return procedure_call_in_function();
    val result_owner <- links[at].imported_owner_argument;
    val result_kind <- links[at].imported_kind;
    val argument <- first_item(nodes, nodes[at].right);
    val diagnostic <- 0u8;
    val witness <- no_node();
    val actual <- no_node();
    for (unused in 0u64 .. used) {
        if (argument == no_node()) {
            if (result_owner != no_node()) {
                set_fact(facts, at, result_kind, borrowed_ref(), facts[result_owner].owner, 0u64, 0u8);
                facts[at].target_readonly <- links[at].imported_target_readonly;
                if (result_kind == c_string_kind()) { (facts[at].text_nul <- nul_absent()):void; };
            } else {
                set_result(facts, at, result_kind);
            };
            return 0u8;
        };
        diagnostic <- check_argument_operand(nodes, facts, argument, links[argument].imported_kind,
                                             links[argument].imported_reception, 0u64,
                                             links[argument].imported_target_readonly);
        if (diagnostic != 0u8) return diagnostic;
        witness <- links[argument].imported_owner_argument;
        if (witness != no_node()) {
            actual <- facts[argument].owner;
            diagnostic <- check_owner_access(nodes, actual, links[argument].imported_owner_readonly == 0u8);
            if (diagnostic != 0u8) return diagnostic;
            if (argument != witness && facts[witness].owner != actual)
                return owner_conflict(nodes, facts[witness].owner, actual);
            if (links[argument].imported_passes_owner != 0u8) {
                facts[argument].owner_chain <- 0u64;
                (facts[actual].owner_chain <- 0u64):void;
            } else {};
        };
        argument <- links[argument].next;
    };
    return invalid_operand_tree();
}

func argument_at_position(links:const NameWork in L, first:u64, position:u64) -> u64 where {const owner L} {
    if (position == no_node()) return no_node();
    val argument <- first;
    for (index in 0u64 .. position) {
        if (argument == no_node()) return no_node();
        argument <- links[argument].next;
    };
    return argument;
}

func bind_imported_call(nodes:const ExprNodes in N, links:NameWork in L, contracts:const ModuleInterfaces in I,
                        at:u64, header:u64) -> bool where {const owner N, owner L, const owner I} {
    val first <- first_item(nodes, nodes[at].right);
    val argument <- first;
    val row <- header + 1u64;
    for (index in 0u64 .. contracts[header].entry_count) {
        if (argument == no_node()) return false;
        links[argument].imported_kind <- contracts[row].value_kind;
        links[argument].imported_reception <- contracts[row].native_reception;
        links[argument].imported_target_readonly <- contracts[row].target_readonly;
        links[argument].imported_owner_readonly <- contracts[row].owner_readonly;
        links[argument].imported_passes_owner <- contracts[row].native_passes_owner;
        links[argument].imported_owner_argument <- argument_at_position(links, first, contracts[row].owner_role);
        argument <- links[argument].next;
        (row <- row + 1u64):void;
    };
    if (argument != no_node()) return false;
    links[at].imported_function <- contracts[header].native_function;
    links[at].imported_kind <- contracts[header].result_kind;
    links[at].imported_procedure <- contracts[header].native_procedure;
    links[at].imported_target_readonly <- contracts[header].target_readonly;
    links[at].imported_owner_argument <- argument_at_position(links, first, contracts[header].owner_role);
    links[at].imported_failure <- contracts[header].failure_identity;
    links[at].imported_failure_checked <- contracts[header].failure_checked;
    return true;
}

export func prepare_imported_calls(nodes:const ExprNodes in N, names:const NameBindings in B,
                                  selected:const SelectedExports in E, links:NameWork in L,
                                  contracts:const ModuleInterfaces in I, used:u64, report:OperandCheckResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner L, const owner I, owner R} {
    val callee <- no_node();
    val site <- no_node();
    val header <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == call_node()) {
            callee <- nodes[at].left;
            if (names[callee].kind == ordinary_selection()) {
                site <- names[callee].declaration;
                if (selected[site].kind == callable_export() && selected[site].shape == ordinary_callable_shape()) {
                    header <- find_interface(contracts, selected[site].origin_module, selected[site].identity);
                    if (header != no_node() && contracts[header].native_function != no_node()) {
                        if (!bind_imported_call(nodes, links, contracts, at, header))
                            return operand_problem(report, at, wrong_argument_count());
                    };
                };
            };
        };
    };
    return true;
}

func native_scalar(kind:u8) -> bool { return scalar_kind(kind) && kind != scalar_enum(); }

func first_owner_parameter(links:const NameWork in L, facts:const OperandFacts in F,
                           first:u64, owner_site:u64, limit:u64) -> u64
    where {const owner L, const owner F} {
    val formal <- first;
    for (position in 0u64 .. limit) {
        if (formal == no_node()) return no_node();
        if (facts[formal].owner == owner_site) return position;
        formal <- links[formal].next;
    };
    return no_node();
}

func native_callable_arity(nodes:const ExprNodes in N, links:const NameWork in L,
                           facts:const OperandFacts in F, definition:u64) -> u64
    where {const owner N, const owner L, const owner F} {
    val kind <- facts[definition].kind;
    val head <- callable_head(nodes, definition);
    if (immutable_text_kind(kind)) {
        if (first_owner_parameter(links, facts, first_item(nodes, nodes[head].right),
                                  facts[definition].owner, head + 1u64) == no_node()) return no_node();
    } else {
        if (!native_scalar(kind) && kind != void_result()) return no_node();
    };
    return native_parameter_count(nodes, links, facts, head);
}

func native_parameter_count(nodes:const ExprNodes in N, links:const NameWork in L,
                            facts:const OperandFacts in F, head:u64) -> u64
    where {const owner N, const owner L, const owner F} {
    val formal <- first_item(nodes, nodes[head].right);
    val count <- 0u64;
    for (unused in 0u64 .. head + 1u64) {
        if (formal == no_node()) return count;
        if (!native_parameter(nodes, facts, formal)) return no_node();
        count <- count + 1u64;
        formal <- links[formal].next;
    };
    return no_node();
}

func native_parameter(nodes:const ExprNodes in N, facts:const OperandFacts in F, formal:u64) -> bool
    where {const owner N, const owner F} {
    val kind <- facts[formal].kind;
    val mode <- facts[formal].reception;
    val syntax <- nodes[formal].kind;
    if (mode == local_place())
        return native_scalar(kind) && (syntax == parameter_node() || syntax == val_parameter_node());
    if (facts[formal].writable_text_place != 0u8) return false;
    if (mode == borrowed_ref()) return native_scalar(kind) || immutable_text_kind(kind);
    return mode == nullable_ptr() && native_scalar(kind);
}

export func publish_native_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                                     links:const NameWork in L, facts:const OperandFacts in F, used:u64,
                                     module_id:u64, base:u64, contracts:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner L, const owner F, owner I} {
    val count <- 0u64;
    val arity <- no_node();
    val formal <- no_node();
    val first <- no_node();
    val failure <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == callable_node() && names[at].declaration == at && links[at].next_method == no_node()) {
            arity <- native_callable_arity(nodes, links, facts, at);
            if (arity != no_node()) {
                if (arity + 1u64 > intrinsic (len)(contracts) - count) return no_node();
                write_interface_header(contracts[count], module_id, at, callable_binding(), facts[at].kind, arity);
                contracts[count].native_function <- base + at;
                contracts[count].native_procedure <- if (is_function(nodes, at)) { 0u8 } else { 1u8 };
                failure <- signature_clause(nodes, nodes[at].left, throws_clause_node());
                # The root Exception has an identity of its own. Use an absent
                # node for an ordinary callable with no declared failure.
                contracts[count].failure_identity <- if (failure == no_node()) { no_node() } else { (facts[failure].identity) };
                if (failure != no_node()) { (contracts[count].failure_checked <- facts[failure].checked_exception):void; };
                first <- first_item(nodes, nodes[callable_head(nodes, at)].right);
                if (facts[at].reception == borrowed_ref()) {
                    contracts[count].target_readonly <- facts[at].target_readonly;
                    (contracts[count].owner_role <- first_owner_parameter(links, facts, first, facts[at].owner, arity)):void;
                };
                count <- count + 1u64;
                formal <- first;
                for (parameter in 0u64 .. arity) {
                    publish_native_parameter(nodes, links, facts, first, formal, arity, contracts[count]);
                    count <- count + 1u64;
                    (formal <- links[formal].next):void;
                };
            };
        };
    };
    return count;
}

func publish_native_parameter(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                              first:u64, formal:u64, arity:u64, row:ModuleInterfaceRow in I) -> void
    where {const owner N, const owner L, const owner F, owner I} {
    write_interface_header(row, 0u64, 0u64, 0u8, 0u8, 0u64);
    row.value_kind <- facts[formal].kind;
    row.native_reception <- facts[formal].reception;
    row.target_readonly <- facts[formal].target_readonly;
    if (row.native_reception == local_place()) return;
    val binder <- facts[formal].owner;
    # A role is the position of the first parameter that establishes this owner.
    row.owner_role <- first_owner_parameter(links, facts, first, binder, arity);
    row.owner_readonly <- if (nodes[binder].number == readonly_declaration()) { 1u8 } else { 0u8 };
    row.native_passes_owner <- if (facts[formal].passes_owner != 0u8 && facts[binder].owner_chain != no_node()) {
        1u8
    } else { 0u8 };
    return;
}

func check_symbolic_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                         selected:const SelectedExports in E, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner B, const owner E, owner F} {
    val callee <- nodes[at].left;
    if (names[callee].kind != symbolic_selection()) return unproved_call_target();
    val site <- names[callee].declaration;
    if (selected[site].kind != symbol_export() || selected[site].identity != print_export_identity())
        return unproved_call_target();
    val argument <- nodes[at].right;
    if (argument == no_node() || nodes[argument].left != no_node()) return wrong_argument_count();
    val diagnostic <- require_bits(nodes, facts, nodes[argument].right);
    if (diagnostic != 0u8) return diagnostic;
    scalar_fact(facts, argument, independent_value(), no_node());
    only_void(facts, at);
    return 0u8;
}

func result_kind(nodes:const ExprNodes in N, facts:OperandFacts in F, value:u64, read:bool) -> u8
    where {const owner N, owner F} {
    if (value == no_node()) return void_result();
    val kind <- facts[value].kind;
    if (read && scalar_kind(kind) && require_typed_bits(nodes, facts, value, kind) != 0u8) return 0u8;
    if (scalar_kind(kind) || kind == void_result() || kind == never_result()) return kind;
    if (!read && immutable_text_kind(kind)) return kind;
    return 0u8;
}

func set_result(facts:OperandFacts in F, at:u64, kind:u8) -> void where {owner F} {
    if (scalar_kind(kind)) { set_fact(facts, at, kind, independent_value(), no_node(), 0u64, 0u8); } else {
        set_fact(facts, at, kind, 0u8, no_node(), 0u64, 0u8);
    };
}

func set_bits_result(facts:OperandFacts in F, at:u64, value:u64) -> void where {owner F} {
    set_fact(facts, at, facts[value].kind, independent_value(), no_node(), facts[value].identity, 0u8);
}

func explicit_discard() -> u8 { return 1u8; }
func loop_discard() -> u8 { return 2u8; }

# List entries carry the reached normal tail type. Explicit discard still
# checks that type, without imposing a read of the tail's target.
func check_sequence_item(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val previous <- nodes[at].left;
    if (previous != no_node() && facts[previous].kind == never_result()) {
        set_result(facts, at, never_result());
        return;
    } else {};
    val expression <- nodes[at].right;
    if (facts[expression].kind == never_result()) { set_result(facts, at, never_result()); return; } else {};
    val kind <- void_result();
    if (!local_storage_binding(nodes[expression].kind)) {
        if (facts[at].arm_result != 0u8 && scalar_kind(facts[expression].kind)) {
            copy_fact(facts, at, expression);
            return;
        } else {};
        (kind <- result_kind(nodes, facts, expression, facts[at].discarded_result == 0u8)):void;
    } else {};
    if (scalar_kind(kind)) { set_bits_result(facts, at, expression); }
    else { set_result(facts, at, kind); };
}

func sequence_result(facts:const OperandFacts in F, tail:u64) -> u8 where {const owner F} {
    if (tail == no_node()) return void_result();
    return facts[tail].kind;
}

# Abrupt paths add no normal result to a full scope or try expression.
func merge_result(facts:OperandFacts in F, at:u64, kind:u8, identity:u64) -> u8 where {owner F} {
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind != 0u8 &&
        (facts[at].kind != kind || (kind == scalar_enum() && facts[at].identity != identity)))
        return unproved_result_contract();
    if (kind == scalar_enum()) { set_fact(facts, at, kind, independent_value(), no_node(), identity, 0u8); }
    else { set_result(facts, at, kind); };
    return 0u8;
}

func merge_arm_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, arm:u64) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (kind == never_result()) return 0u8;
    if (facts[at].discarded_result == loop_discard() && nodes[at].kind != case_node())
        return merge_result(facts, at, void_result(), 0u64);
    if (immutable_text_kind(kind)) return unsupported_text_operation();
    if (kind == product_kind()) return unsupported_product_layout();
    if (facts[at].kind == 0u8) {
        copy_fact(facts, at, arm);
        return 0u8;
    } else {};
    if (!same_operand_type(facts, at, arm)) return unproved_result_contract();
    val left <- facts[at].reception;
    val right <- facts[arm].reception;
    val nullable <- left == nullable_ptr() || right == nullable_ptr();
    if (kind == void_result() || left == independent_value() || right == independent_value()) {
        if (nullable) return unproved_nonnull_borrow();
        if (scalar_kind(kind)) { set_bits_result(facts, at, arm); } else { set_result(facts, at, kind); };
        return 0u8;
    } else {};
    val identity <- facts[at].identity;
    val owner_site <- facts[at].owner;
    if (owner_site == no_node() || facts[arm].owner == no_node()) return unproved_owner();
    if (owner_site != facts[arm].owner) return owner_conflict(nodes, owner_site, facts[arm].owner);
    val readonly <- if (facts[at].target_readonly != 0u8 || facts[arm].target_readonly != 0u8) { 1u8 } else { 0u8 };
    val reservation <- facts[at].reservation;
    if (reservation != facts[arm].reservation) return unproved_reservation_selection();
    val reception <- if (nullable) { nullable_ptr() } else { borrowed_ref() };
    val present <- facts[at].target_presence;
    val selected <- facts[at].selection;
    set_fact(facts, at, kind, reception, owner_site, identity, 0u8);
    facts[at].target_readonly <- readonly;
    facts[at].reservation <- reservation;
    if (present == facts[arm].target_presence) { (facts[at].target_presence <- present):void; } else {};
    if (selected == facts[arm].selection) { (facts[at].selection <- selected):void; } else {};
    return 0u8;
}

func check_conditional(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val condition <- nodes[at].left;
    if (facts[condition].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (require_typed_bits(nodes, facts, condition, scalar_bool()) != 0u8) return expected_boolean_condition();
    val diagnostic <- merge_arm_result(nodes, facts, at, nodes[at].right);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- merge_arm_result(nodes, facts, at, nodes[at].number);
    if (diagnostic == 0u8 && facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
    return diagnostic;
}

# Remaining canonical members are tracked by count and exclusion markers.
# A possible write through another view starts a fresh scan generation.
data CaseCoverage {
    total:u64;
    remaining:u64;
    absent:bool;
    only:u64;
    generation:u64;
    exclusions:u64;
}

# A case proof belongs to a saved address. An enclosing proof for another
# pointer, including one with the same declared owner, cannot supply it.
export func selected_target_presence(facts:const OperandFacts in F, at:u64) -> u8 where {const owner F} {
    val presence <- facts[at].target_presence;
    val selection <- facts[at].selection;
    if (presence != unknown_target() || selection == no_node()) return presence;
    val header <- facts[at].case_context;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (header == no_node()) return presence;
        if (facts[header].case_selection == selection) return facts[header].case_presence;
        header <- facts[header].case_context;
    };
    return presence;
}

func enter_case_context(facts:OperandFacts in F, outer:u64, header:u64) -> u64 where {owner F} {
    facts[header].case_context <- outer;
    if (facts[header].case_selection == no_node() || facts[header].case_presence == unknown_target()) return outer;
    return header;
}

func case_has_paths(coverage:const CaseCoverage in V) -> bool where {const owner V} {
    return coverage.absent || coverage.remaining != 0u64;
}

func case_presence(present:bool, absent:bool) -> u8 {
    if (present && !absent) return present_target();
    if (absent && !present) return absent_target();
    return unknown_target();
}

func initialize_case_coverage(nodes:const ExprNodes in N, names:const NameBindings in B,
                              links:const NameWork in L, facts:OperandFacts in F, at:u64,
                              coverage:CaseCoverage in V) -> void
    where {const owner N, const owner B, const owner L, owner F, owner V} {
    val subject <- nodes[at].left;
    val kind <- facts[subject].kind;
    if (kind == never_result()) return;
    val present <- selected_target_presence(facts, subject);
    coverage.absent <- present != present_target();
    if (present == absent_target()) return;
    if (kind == scalar_bool()) {
        coverage.total <- 2u64;
        coverage.remaining <- 2u64;
        if (facts[subject].reception == independent_value()) {
            val behavior <- case_condition(nodes, facts, subject);
            if (behavior == case_guard_passes() || behavior == case_guard_declines()) {
                coverage.only <- if (behavior == case_guard_passes()) { at } else { subject };
                (coverage.remaining <- 1u64):void;
            } else {};
        } else {};
        return;
    } else {};
    val domain <- facts[subject].identity;
    val member <- first_item(nodes, nodes[domain].right);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (member == no_node()) { (coverage.remaining <- coverage.total):void; return; } else {};
        if (names[member].declaration == member) { (coverage.total <- coverage.total + 1u64):void; } else {};
        member <- links[member].next;
    };
}

func reopen_case_domain(coverage:CaseCoverage in V, generation:u64) -> void where {owner V} {
    coverage.only <- no_node();
    coverage.generation <- generation;
    (coverage.remaining <- coverage.total):void;
}

func case_may_write(nodes:const ExprNodes in N, links:const NameWork in L, at:u64) -> bool
    where {const owner N, const owner L} {
    if (at == no_node()) return false;
    val kind <- nodes[at].kind;
    if (kind == bool_node() || kind == literal_node() || kind == name_node() ||
        kind == case_fallthrough_node() || kind == null_node()) return false;
    if (kind == group_node() || kind == type_assertion_node() || kind == discard_node() || kind == logical_not_node())
        return case_may_write(nodes, links, nodes[at].left);
    if (kind == conditional_node())
        return case_may_write(nodes, links, nodes[at].left) || case_may_write(nodes, links, nodes[at].right) ||
            case_may_write(nodes, links, nodes[at].number);
    if (kind == compare_node() || integer_arithmetic(kind) || logical_binary(kind))
        return case_may_write(nodes, links, nodes[at].left) || case_may_write(nodes, links, nodes[at].right);
    if (kind != block_node()) return true;
    val tail <- nodes[at].left;
    val item <- first_item(nodes, tail);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) return false;
        if (case_may_write(nodes, links, nodes[item].right)) return true;
        item <- links[item].next;
    };
    return true;
}

func case_condition(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    if (at == no_node()) return case_guard_passes();
    if (facts[at].kind == never_result()) return case_guard_exits();
    if (require_typed_bits(nodes, facts, at, scalar_bool()) != 0u8) return 0u8;
    val operand <- at;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (nodes[operand].kind == bool_node()) {
            return if (nodes[operand].number == 0u64) { case_guard_declines() } else { case_guard_passes() };
        } else {};
        if (nodes[operand].kind != group_node()) return case_guard_tests();
        operand <- nodes[operand].left;
    };
    return case_guard_tests();
}

# A direct registration before every transfer runs unless an earlier
# abrupt completion prevents the transfer itself. If the action cannot
# finish normally, its completion replaces the pending scan request.
export func has_terminal_defer_before(nodes:const ExprNodes in N, links:const NameWork in L,
                                      facts:const OperandFacts in F, tail:u64, before:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    val item <- first_item(nodes, tail);
    val expression <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) return false;
        expression <- nodes[item].right;
        if (nodes[expression].past > before) return false;
        if (nodes[expression].kind == deferred_block_node() && facts[nodes[expression].left].kind == never_result())
            return true;
        item <- links[item].next;
    };
    return false;
}

export func case_resumes_after_cleanup() -> u8 { return 1u8; }
func replaced_case_resume() -> u8 { return 2u8; }

# The destination identifies where this particular transfer stops. A
# finalizer that always exits discards the suspended transfer.
export func case_transfer_survives(nodes:const ExprNodes in N, names:const NameBindings in B,
                                  facts:const OperandFacts in F, at:u64) -> bool
    where {const owner N, const owner B, const owner F} {
    val stop <- names[names[at].declaration].finalizer;
    val cleanup <- names[at].finalizer;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (cleanup == stop) return true;
        if (cleanup == no_node() || facts[nodes[nodes[cleanup].right].right].kind == never_result()) return false;
        cleanup <- names[cleanup].finalizer;
    };
    return false;
}

func case_resume_kind(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, arm:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner F} {
    val body <- nodes[arm].right;
    val scan <- facts[arm].case_exit_link;
    if (scan == no_node()) return 0u8;
    val full <- nodes[body].kind == full_scope_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (scan == no_node()) return replaced_case_resume();
        if (case_transfer_survives(nodes, names, facts, scan) &&
            (!full || !has_terminal_defer_before(nodes, links, facts, nodes[body].left, nodes[scan].first)))
            return case_resumes_after_cleanup();
        scan <- facts[scan].case_exit_link;
    };
    return replaced_case_resume();
}

func prepare_case_arm(nodes:const ExprNodes in N, names:const NameBindings in B,
                      links:const NameWork in L, facts:OperandFacts in F, arm:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F} {
    facts[arm].case_resume <- case_resume_kind(nodes, names, links, facts, arm);
    val behavior <- case_condition(nodes, facts, nodes[arm].number);
    if (behavior == 0u8) return expected_boolean_condition();
    facts[arm].case_guard <- behavior;
    return 0u8;
}

func prepare_case_pattern(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          at:u64, pattern:u64, member:u64 in M) -> u8
    where {const owner S, const owner N, const owner B, const owner L, owner F, owner M} {
    member <- no_node();
    if (pattern == no_node()) return 0u8;
    val mode <- nodes[pattern].number;
    if (mode == case_null_pattern()) return 0u8;
    val subject <- nodes[at].left;
    val kind <- facts[subject].kind;
    if (kind == never_result()) return 0u8;
    if (kind == scalar_bool()) {
        if (mode != case_false_pattern() && mode != case_true_pattern()) return unsupported_case_pattern();
        member <- if (mode == case_true_pattern()) { at } else { subject };
        facts[pattern].discriminator_code <- if (mode == case_true_pattern()) { 1u64 } else { 0u64 };
        return 0u8;
    } else {};
    if (mode != case_member_pattern()) return unsupported_case_pattern();
    val spelling <- find_enum_member(source, nodes, pattern, nodes[facts[subject].identity].right);
    if (spelling == no_node()) return missing_enum_member();
    member <- names[spelling].declaration;
    facts[pattern].discriminator_code <- links[spelling].enum_code;
    return 0u8;
}

func match_case_arm(nodes:const ExprNodes in N, facts:OperandFacts in F, coverage:const CaseCoverage in V,
                    at:u64, arm:u64, member:u64) -> void
    where {const owner N, owner F, const owner V} {
    val pattern <- nodes[arm].left;
    val null_pattern <- pattern != no_node() && nodes[pattern].number == case_null_pattern();
    val all_pattern <- pattern == no_node();
    val had_present <- coverage.remaining != 0u64;
    val had_absence <- coverage.absent;
    facts[arm].case_discriminator <- if (member != no_node() && had_present) { 1u8 } else { 0u8 };
    facts[arm].case_may_be_absent <- if (had_absence) { 1u8 } else { 0u8 };
    if (member != no_node() && (!had_present || (coverage.only != no_node() && coverage.only != member) ||
        facts[member].case_excluded_at == coverage.generation)) return;
    if (null_pattern && !had_absence) return;
    val matches_present <- !null_pattern && had_present;
    val matches_absence <- (null_pattern || all_pattern) && had_absence;
    val matches_all <- all_pattern || (null_pattern && !had_present) ||
        (member != no_node() && coverage.remaining == 1u64 && !had_absence);
    facts[arm].case_match <- if (matches_all) { matches_case_arm() } else { tests_case_arm() };
    facts[arm].case_presence <- case_presence(matches_present, matches_absence);
    facts[arm].case_selection <- facts[nodes[at].left].selection;
    return;
}

# Share the indexed member table across cases. A nested case restores the
# enclosing scan's marks after consuming its own arms.
func exclude_case_member(facts:OperandFacts in F, coverage:CaseCoverage in V, member:u64, arm:u64) -> void
    where {owner F, owner V} {
    facts[arm].case_exclusion_member <- member;
    facts[arm].case_exclusion_previous <- facts[member].case_excluded_at;
    facts[arm].case_exclusion_next <- coverage.exclusions;
    facts[member].case_excluded_at <- coverage.generation;
    coverage.exclusions <- arm;
    return;
}

func restore_case_exclusions(facts:OperandFacts in F, coverage:const CaseCoverage in V) -> void
    where {owner F, const owner V} {
    val mark <- coverage.exclusions;
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (mark == no_node()) return;
        facts[facts[mark].case_exclusion_member].case_excluded_at <- facts[mark].case_exclusion_previous;
        mark <- facts[mark].case_exclusion_next;
    };
}

func finish_case_arm(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F,
                     coverage:CaseCoverage in V, at:u64, arm:u64, member:u64, borrowed:bool) -> u8
    where {const owner N, const owner L, owner F, owner V} {
    if (facts[arm].case_match == misses_case_arm()) return 0u8;
    val pattern <- nodes[arm].left;
    val matches_present <- coverage.remaining != 0u64 &&
        (pattern == no_node() || nodes[pattern].number != case_null_pattern());
    val matches_absence <- coverage.absent && (pattern == no_node() || nodes[pattern].number == case_null_pattern());
    val guard <- nodes[arm].number;
    val behavior <- facts[arm].case_guard;
    val body <- nodes[arm].right;
    val enters_body <- behavior != case_guard_exits() && behavior != case_guard_declines();
    val declines <- behavior == case_guard_declines() || behavior == case_guard_tests();
    val falls_through <- enters_body && facts[arm].case_resume == case_resumes_after_cleanup();
    if (declines || falls_through) {
        if (borrowed && matches_present && (case_may_write(nodes, links, guard) ||
                                             (falls_through && case_may_write(nodes, links, body)))) {
            reopen_case_domain(coverage, arm);
        } else {};
    } else {
        if (matches_absence) { (coverage.absent <- false):void; } else {};
        if (pattern == no_node()) { (coverage.remaining <- 0u64):void; } else {
            if (member != no_node()) {
                exclude_case_member(facts, coverage, member, arm);
                (coverage.remaining <- coverage.remaining - 1u64):void;
            } else {};
        };
    };
    if (!enters_body) return 0u8;
    facts[arm].case_body <- 1u8;
    return merge_arm_result(nodes, facts, at, body);
}

# Each case owns its exits in syntax postorder. Consume them at the direct
# guard, body or intervening statement they leave, after its reach is known.
func merge_case_breaks(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                       last:u64 in P, at:u64, through:u64, reached:bool) -> u8
    where {const owner N, const owner B, owner F, owner P} {
    if (through == no_node()) return 0u8;
    val value <- no_node();
    val diagnostic <- 0u8;
    val pending <- if (last == no_node()) { facts[at].case_exit_link } else { facts[last].case_exit_link };
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (pending == no_node() || pending > through) return 0u8;
        if (reached && case_transfer_survives(nodes, names, facts, pending)) {
            value <- nodes[pending].left;
            diagnostic <- if (value == no_node()) { merge_result(facts, at, void_result(), 0u64) }
                          else { merge_arm_result(nodes, facts, at, value) };
            if (diagnostic != 0u8) return diagnostic;
        } else {};
        last <- pending;
        pending <- facts[pending].case_exit_link;
    };
    return invalid_operand_tree();
}

func operand_problem(report:OperandCheckResult in R, at:u64, diagnostic:u8) -> bool where {owner R} {
    report.node <- at;
    report.diagnostic <- diagnostic;
    return false;
}

func check_case(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                owners:CallOwners in O, report:OperandCheckResult in R, at:u64, used:u64, outer:u64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, owner O, owner R} {
    val subject <- nodes[at].left;
    val kind <- facts[subject].kind;
    val completed <- kind != never_result();
    if (completed && kind != scalar_bool() && kind != scalar_enum() && kind != null_literal())
        return operand_problem(report, at, unsupported_case_subject());
    val borrowed <- facts[subject].reception != independent_value();
    ref coverage = make CaseCoverage {
        total <- 0u64; remaining <- 0u64; absent <- false; only <- no_node(); generation <- at; exclusions <- no_node();
    };
    initialize_case_coverage(nodes, names, links, facts, at, coverage);
    val item <- first_item(nodes, nodes[at].right);
    val cursor <- subject + 1u64;
    val last_exit <- no_node();
    val expression <- no_node();
    val reached <- false;
    val context <- no_node();
    val member <- no_node();
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (item == no_node()) {
            restore_case_exclusions(facts, coverage);
            if (!completed) { set_result(facts, at, never_result()); return true; } else {};
            if (case_has_paths(coverage)) {
                if (scalar_kind(facts[at].kind)) return operand_problem(report, at, incomplete_value_case());
                facts[at].case_end <- 1u8;
                only_void(facts, at);
                return true;
            } else {};
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return true;
        } else {};
        expression <- nodes[item].right;
        reached <- case_has_paths(coverage);
        if (!reached) { (facts[item].case_item <- unreachable_case_item()):void; } else {};
        if (nodes[expression].kind == case_arm_node()) {
            diagnostic <- prepare_case_pattern(source, nodes, names, links, facts, at, nodes[expression].left, member);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            if (reached) { match_case_arm(nodes, facts, coverage, at, expression, member); } else {};
            context <- enter_case_context(facts, outer, expression);
            if (!check_operand_range(source, nodes, names, links, selected, facts, owners, report,
                                     cursor, item, used, context)) return false;
            diagnostic <- finish_case_arm(nodes, links, facts, coverage, at, expression, member, borrowed);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, nodes[expression].number,
                                            facts[expression].case_match != misses_case_arm());
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
            (diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, nodes[expression].right,
                                             facts[expression].case_body != 0u8)):void;
        } else {
            if (reached) {
                facts[item].case_presence <- case_presence(coverage.remaining != 0u64, coverage.absent);
                (facts[item].case_selection <- facts[subject].selection):void;
            } else {};
            context <- enter_case_context(facts, outer, item);
            if (!check_operand_range(source, nodes, names, links, selected, facts, owners, report,
                                     cursor, item, used, context)) return false;
            diagnostic <- merge_case_breaks(nodes, names, facts, last_exit, at, expression, reached);
            if (reached) {
                if (facts[expression].kind == never_result()) {
                    coverage.remaining <- 0u64;
                    (coverage.absent <- false):void;
                } else {
                    if (borrowed && coverage.remaining != 0u64 && case_may_write(nodes, links, expression)) {
                        reopen_case_domain(coverage, item);
                    } else {};
                };
            } else {};
        };
        if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
        check_sequence_item(nodes, facts, item);
        cursor <- item + 1u64;
        item <- links[item].next;
    };
    return operand_problem(report, at, invalid_operand_tree());
}

func record_case_exit(facts:OperandFacts in F, at:u64, destination:u64) -> void where {owner F} {
    val prior <- facts[destination].case_exit_tail;
    if (prior == no_node()) { (facts[destination].case_exit_link <- at):void; }
    else { (facts[prior].case_exit_link <- at):void; };
    facts[destination].case_exit_tail <- at;
    set_result(facts, at, never_result());
    return;
}

func check_logical(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    val abrupt <- facts[left].kind == never_result();
    val diagnostic <- 0u8;
    if (!abrupt) {
        diagnostic <- require_typed_bits(nodes, facts, left, scalar_bool());
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    if (logical_binary(nodes[at].kind)) {
        val right <- nodes[at].right;
        if (facts[right].kind == never_result()) {
            (abrupt <- abrupt || (nodes[left].kind == bool_node() && !skips_right(nodes, at))):void;
        } else {
            diagnostic <- require_typed_bits(nodes, facts, right, scalar_bool());
            if (diagnostic != 0u8) return diagnostic;
        };
    } else {};
    set_result(facts, at, if (abrupt) { never_result() } else { scalar_bool() });
    return 0u8;
}

func merge_guard_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, arm:u64, discard:bool) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (discard && (scalar_kind(kind) || immutable_text_kind(kind)))
        return merge_result(facts, at, void_result(), 0u64);
    if (facts[at].arm_result == 0u8 || !scalar_kind(kind)) return merge_result(facts, at, kind, facts[arm].identity);
    if (facts[arm].reception == nullable_ptr() && facts[at].discarded_result == 0u8)
        return unproved_nonnull_borrow();
    # A native result slot can hold either bits or a target. A guard with
    # both would need to retain that distinction until its finalizer exits.
    if (scalar_kind(facts[at].kind) &&
        ((facts[at].reception == independent_value()) != (facts[arm].reception == independent_value())))
        return unproved_result_contract();
    return merge_arm_result(nodes, facts, at, arm);
}

func check_try_result(nodes:const ExprNodes in N, links:const NameWork in L, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner L, owner F} {
    val discard <- nodes[at].number == discarded_guard_result() || facts[at].discarded_result == loop_discard();
    val diagnostic <- merge_guard_result(nodes, facts, at, nodes[at].left, discard);
    if (diagnostic != 0u8) return diagnostic;
    val clause <- first_item(nodes, nodes[at].right);
    val arm <- no_node();
    val kind <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) {
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return 0u8;
        } else {};
        arm <- nodes[clause].right;
        if (nodes[clause].kind == catch_clause_node()) {
            diagnostic <- merge_guard_result(nodes, facts, at, nodes[arm].right, discard);
            if (diagnostic != 0u8) return diagnostic;
        } else {
            kind <- facts[arm].kind;
            if (kind == never_result()) { set_result(facts, at, kind); return 0u8; } else {};
            if (nodes[clause].kind != finally_clause_node() || kind != void_result()) return wrong_finally_result();
        };
        clause <- links[clause].next;
    };
    return unproved_result_contract();
}

func catch_category(nodes:const ExprNodes in N, facts:const OperandFacts in F, clause:u64) -> u64
    where {const owner N, const owner F} {
    val binding <- nodes[nodes[clause].right].left;
    val identity <- facts[binding].identity;
    return if (identity == no_node()) { exception_root_identity() } else { identity };
}

func check_catch_clause(nodes:const ExprNodes in N, facts:const OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner F} {
    val category <- catch_category(nodes, facts, at);
    val previous <- nodes[at].left;
    for (unused in 0u64 .. at) {
        if (previous == no_node()) return 0u8;
        if (catch_category(nodes, facts, previous) == category) return duplicate_catch_category();
        previous <- nodes[previous].left;
    };
    return 0u8;
}

func check_scope_tail(nodes:const ExprNodes in N, facts:OperandFacts in F, scope:u64) -> u8
    where {const owner N, owner F} {
    val tail <- nodes[scope].left;
    val identity <- if (tail == no_node()) { 0u64 } else { (facts[tail].identity) };
    val diagnostic <- merge_result(facts, scope, sequence_result(facts, tail), identity);
    if (diagnostic == 0u8 && facts[scope].kind == 0u8) {
        if (facts[scope].case_resume != 0u8) { set_result(facts, scope, never_result()); }
        else { only_void(facts, scope); };
    } else {};
    return diagnostic;
}

export func has_value_tail(nodes:const ExprNodes in N, facts:const OperandFacts in F, definition:u64) -> bool
    where {const owner N, const owner F} {
    return is_function(nodes, definition) && scalar_kind(facts[nodes[definition].right].kind);
}

func check_callable_tail(nodes:const ExprNodes in N, facts:const OperandFacts in F, definition:u64) -> u8
    where {const owner N, const owner F} {
    if (!is_function(nodes, definition)) return 0u8;
    val kind <- facts[nodes[definition].right].kind;
    if (kind == 0u8) return unproved_result_contract();
    if (scalar_kind(kind) && facts[definition].kind == void_result()) return value_tail_in_void_function();
    if (scalar_kind(kind) && !same_operand_type(facts, nodes[definition].right, definition)) return wrong_return_type();
    return 0u8;
}

func check_return(nodes:const ExprNodes in N, names:const NameBindings in B, facts:OperandFacts in F,
                   at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val scope <- names[at].scope;
    val value <- nodes[at].left;
    if (nodes[scope].kind == module_node()) return wrong_return_type();
    if (nodes[scope].kind == full_scope_node()) {
        val identity <- if (value == no_node()) { 0u64 } else { (facts[value].identity) };
        return merge_result(facts, scope, result_kind(nodes, facts, value, true), identity);
    } else {};
    if (nodes[scope].kind != callable_node()) return unproved_result_contract();
    if (value != no_node() && facts[value].kind == never_result()) return 0u8;
    if (facts[scope].kind == void_result()) {
        if (value != no_node() && facts[value].kind != void_result()) return wrong_return_type();
        return 0u8;
    } else {};
    if (value == no_node()) return wrong_return_type();
    if (facts[scope].kind == product_kind()) {
        if (!same_operand_type(facts, value, scope) || facts[value].reception != borrowed_ref())
            return wrong_return_type();
        if (facts[value].owner != facts[scope].owner)
            return owner_conflict(nodes, facts[value].owner, facts[scope].owner);
        if (facts[value].target_readonly != 0u8 && facts[scope].target_readonly == 0u8)
            return expected_writable_place();
        return 0u8;
    };
    if (immutable_text_kind(facts[scope].kind)) {
        if (!immutable_text_kind(facts[value].kind) ||
            (facts[scope].kind == c_string_kind() && facts[value].kind != c_string_kind()))
            return wrong_return_type();
        if (facts[value].owner != facts[scope].owner) return wrong_text_result_owner();
        return 0u8;
    };
    val diagnostic <- require_matching_bits(nodes, facts, value, scope);
    if (diagnostic == wrong_operand_type()) return wrong_return_type();
    return diagnostic;
}

func check_numeric_expression(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64, kind:u8) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    if (kind == group_node()) {
        val inside <- facts[left].kind;
        if (inside == product_kind()) return unsupported_product_layout();
        if (inside == void_result() || inside == never_result() || inside == exception_type() || immutable_text_kind(inside) ||
            facts[left].reception == nullable_ptr()) {
            copy_fact(facts, at, left);
            return 0u8;
        } else {};
        if (scalar_kind(inside) && facts[at].discarded_result != 0u8) {
            set_bits_result(facts, at, left);
            return 0u8;
        } else {};
        val projection <- require_typed_bits(nodes, facts, left, inside);
        if (projection != 0u8) return projection;
        set_bits_result(facts, at, left);
        return 0u8;
    } else {};
    val right <- nodes[at].right;
    val left_completes <- facts[left].kind != never_result();
    val right_completes <- facts[right].kind != never_result();
    val left_diagnostic <- if (left_completes) { require_bits(nodes, facts, left) } else { 0u8 };
    if (left_diagnostic != 0u8) return left_diagnostic;
    val right_diagnostic <- if (right_completes) { require_bits(nodes, facts, right) } else { 0u8 };
    if (right_diagnostic != 0u8) return right_diagnostic;
    if (!left_completes || !right_completes) { set_result(facts, at, never_result()); }
    else { scalar_fact(facts, at, independent_value(), no_node()); };
    return 0u8;
}

func check_comparison(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    val kind <- if (nodes[at].number <= unequal_words()) { (facts[left].kind) } else { scalar_u64() };
    val diagnostic <- require_typed_bits(nodes, facts, left, kind);
    if (diagnostic != 0u8) return diagnostic;
    diagnostic <- require_matching_bits(nodes, facts, nodes[at].right, left);
    if (diagnostic != 0u8) return diagnostic;
    set_result(facts, at, scalar_bool());
    return 0u8;
}

func check_range_header(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val lower <- nodes[at].left;
    val upper <- nodes[at].right;
    val diagnostic <- if (facts[lower].kind != never_result()) { require_bits(nodes, facts, lower) } else { 0u8 };
    if (diagnostic != 0u8) return diagnostic;
    if (facts[upper].kind != never_result()) {
        diagnostic <- require_bits(nodes, facts, upper);
        if (diagnostic != 0u8) return diagnostic;
    } else {};
    # Reads use the current index word. It exposes no writable binding slot.
    set_result(facts, at, scalar_u64());
    return 0u8;
}

func check_range_result(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val header <- nodes[at].left;
    val lower <- nodes[header].left;
    val upper <- nodes[header].right;
    val empty <- nodes[at].number;
    val body_continues <- facts[nodes[at].right].kind != never_result();
    val empty_continues <- empty == no_node() || facts[empty].kind != never_result();
    val continues <- if (literal_range(nodes, header)) {
        if (nonempty_literal_range(nodes, header)) { body_continues } else { empty_continues }
    } else { body_continues || empty_continues };
    if (facts[lower].kind == never_result() || facts[upper].kind == never_result() || !continues) {
        set_result(facts, at, never_result());
    } else { only_void(facts, at); };
}

func check_explicit_discard(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val kind <- result_kind(nodes, facts, nodes[at].left, false);
    if (kind == 0u8) return unproved_operand();
    set_result(facts, at, if (kind == never_result()) { kind } else { void_result() });
    return 0u8;
}

func check_enum_assertion(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          names:const NameBindings in B, links:const NameWork in L, facts:OperandFacts in F,
                          at:u64) -> u8 where {const owner S, const owner N, const owner B, const owner L, owner F} {
    val annotation <- nodes[at].right;
    if (names[annotation].kind != enum_type()) return unsupported_scalar_assertion();
    val domain <- names[annotation].declaration;
    val operand <- nodes[at].left;
    if (nodes[operand].kind == name_node() && names[operand].kind == 0u8) {
        val member <- find_enum_member(source, nodes, operand, nodes[domain].right);
        if (member == no_node()) return missing_enum_member();
        set_fact(facts, at, scalar_enum(), independent_value(), no_node(), domain, 0u8);
        facts[at].enum_constant <- 1u8;
        facts[at].discriminator_code <- links[member].enum_code;
        return 0u8;
    } else {};
    if (facts[operand].kind != never_result() &&
        (facts[operand].kind != scalar_enum() || facts[operand].identity != domain)) return incompatible_enum_type();
    copy_fact(facts, at, operand);
    return 0u8;
}

func check_operand(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   selected:const SelectedExports in E, facts:OperandFacts in F, owners:CallOwners in O,
                   at:u64, used:u64) -> u8
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, owner O} {
    val kind <- nodes[at].kind;
    if (kind == initializer_assignment_node()) return 0u8;
    if (kind == block_item_node() || kind == module_item_node()) {
        check_sequence_item(nodes, facts, at);
        return 0u8;
    } else {};
    if (kind == catch_binding_node()) {
        val annotation <- nodes[at].right;
        if (annotation != no_node()) return exception_annotation(names, selected, facts, annotation, at);
        set_fact(facts, at, exception_type(), readonly_exception(), no_node(), no_node(), 0u8);
        return 0u8;
    } else {};
    if (kind == catch_clause_node()) return check_catch_clause(nodes, facts, at);
    if (kind == callable_node()) return check_callable_tail(nodes, facts, at);
    if (names[at].scope == no_node()) return 0u8;
    if (kind == type_assertion_node()) {
        if (names[nodes[at].right].kind == builtin_c_string()) return check_text_assertion(nodes, facts, at);
        return check_enum_assertion(source, nodes, names, links, facts, at);
    };
    if (kind == narrow_integer_node()) {
        if (nodes[at].left != 8u64) return unsupported_narrow_execution();
        set_result(facts, at, scalar_u8());
        return 0u8;
    };
    if (kind == text_literal_node()) {
        set_fact(facts, at, string_kind(), borrowed_ref(), static_text_owner(), 0u64, 0u8);
        facts[at].target_readonly <- 1u8;
        (facts[at].text_nul <- if (nodes[at].number == 0u64) { nul_absent() } else { nul_present() }):void;
        return 0u8;
    };
    if (kind == literal_node()) { scalar_fact(facts, at, independent_value(), no_node()); return 0u8; } else {};
    if (kind == bool_node()) { set_result(facts, at, scalar_bool()); return 0u8; } else {};
    if (kind == name_node()) {
        val binding <- names[at].kind;
        if (binding == formal_binding() || binding == local_binding() || binding == exception_binding() ||
            binding == loop_index()) {
            copy_fact(facts, at, names[at].declaration);
            if (binding == formal_binding()) {
                (facts[at].writable_text_place <- facts[names[at].declaration].writable_text_place):void;
            };
        } else {};
        return 0u8;
    } else {};
    if (kind == null_node()) {
        val owner_name <- nodes[at].left;
        val owner_site <- no_node();
        if (owner_name != no_node()) { (owner_site <- names[owner_name].declaration):void; } else {};
        set_fact(facts, at, null_literal(), 0u8, owner_site, 0u64, 0u8);
        return 0u8;
    } else {};
    if (local_storage_binding(kind)) return check_local(nodes, names, facts, at);
    if (kind == make_named_node()) {
        val requested <- nodes[at].left;
        if (names[requested].kind == builtin_string()) return check_text_construction(nodes, names, facts, at);
        if (names[requested].kind == record_type())
            return check_product_construction(source, nodes, names, links, facts, owners, at, names[requested].declaration);
        return check_construction(nodes, names, facts, at);
    };
    if (kind == field_access_node()) return check_field_access(source, nodes, names, links, facts, at);
    if (integer_arithmetic(kind) || kind == group_node())
        return check_numeric_expression(nodes, facts, at, kind);
    if (kind == rebind_node()) return check_text_installation(nodes, facts, at);
    if (is_transfer(nodes, at)) {
        val destination <- nodes[at].left;
        if (facts[destination].kind == product_kind())
            return check_transfer_call(nodes, names, links, facts, owners, at, false);
        if (!immutable_text_kind(facts[destination].kind)) return check_transfer(nodes, facts, at);
        if (facts[destination].writable_text_place == 0u8) return expected_writable_place();
        # Reborrowing an init formal as an initialized place would expose its
        # current value before the caller's first-write proof.
        if (nodes[destination].kind == name_node()) return unsupported_text_operation();
        return check_transfer_call(nodes, names, links, facts, owners, at, false);
    };
    if (kind == compare_node()) return check_comparison(nodes, facts, at);
    if (kind == logical_not_node() || logical_binary(kind)) return check_logical(nodes, facts, at);
    if (kind == call_node()) return check_direct_call(nodes, names, links, selected, facts, owners, at, used);
    if (kind == behave_node()) return check_symbolic_call(nodes, names, selected, facts, at);
    if (kind == block_node()) {
        val tail <- nodes[at].left;
        if (tail != no_node() && facts[at].arm_result != 0u8) { copy_fact(facts, at, tail); } else {
            val result <- sequence_result(facts, tail);
            if (scalar_kind(result)) { set_bits_result(facts, at, tail); } else { set_result(facts, at, result); };
        };
        return 0u8;
    } else {};
    if (kind == full_scope_node()) return check_scope_tail(nodes, facts, at);
    if (kind == try_node()) return check_try_result(nodes, links, facts, at);
    if (kind == conditional_node()) return check_conditional(nodes, facts, at);
    if (kind == case_arm_node()) return prepare_case_arm(nodes, names, links, facts, at);
    if (kind == break_node()) {
        val target <- names[at].declaration;
        if (target == no_node() || nodes[target].kind != case_node()) return unproved_operand();
        record_case_exit(facts, at, target);
        return 0u8;
    } else {};
    if (kind == case_fallthrough_node()) {
        val arm <- names[at].declaration;
        val scope <- names[at].scope;
        record_case_exit(facts, at, arm);
        if (nodes[arm].right == scope && nodes[scope].kind == full_scope_node()) {
            (facts[scope].case_resume <- case_resumes_after_cleanup()):void;
        } else {};
        return 0u8;
    } else {};
    if (kind == case_failure_node()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (kind == range_header_node()) return check_range_header(nodes, facts, at);
    if (kind == range_node()) { check_range_result(nodes, facts, at); return 0u8; } else {};
    if (kind == discard_node()) return check_explicit_discard(nodes, facts, at);
    if (kind == return_node()) {
        val diagnostic <- check_return(nodes, names, facts, at);
        if (diagnostic == 0u8) { set_result(facts, at, never_result()); } else {};
        return diagnostic;
    } else {};
    if (kind == throw_node()) {
        val operand <- nodes[at].left;
        if (operand != no_node() && facts[operand].kind != exception_type()) return expected_exception_type();
        set_result(facts, at, never_result());
    } else {};
    if (kind == deferred_call_node() && facts[nodes[at].right].text_intrinsic != 0u8) return unsupported_text_operation();
    if (kind == deferred_call_node() || kind == deferred_block_node()) { only_void(facts, at); } else {};
    return 0u8;
}

# Ordinary nodes are checked in postorder. Once a case subject is ready,
# its ordered scan checks each direct item in the context that reaches it.
func check_operand_range(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                         links:const NameWork in L, selected:const SelectedExports in E, facts:OperandFacts in F,
                         owners:CallOwners in O, report:OperandCheckResult in R, first:u64, past:u64, used:u64,
                         context:u64) -> bool
    where {const owner S, const owner N, const owner B, const owner L, const owner E, owner F, owner O, owner R} {
    val at <- first;
    val diagnostic <- 0u8;
    val enclosing_case <- no_node();
    for (unused in first .. past) {
        if (at == past) return true;
        if (at != context) { (facts[at].case_context <- context):void; } else {};
        if (at == enclosing_case) {
            if (!check_case(source, nodes, names, links, selected, facts, owners, report,
                            at, used, context)) return false;
        } else {
            diagnostic <- check_operand(source, nodes, names, links, selected, facts, owners, at, used);
            if (diagnostic != 0u8) return operand_problem(report, at, diagnostic);
        };
        enclosing_case <- facts[at].case_after_subject;
        at <- if (enclosing_case != no_node() && enclosing_case < past) { enclosing_case } else { at + 1u64 };
    };
    return at == past;
}

func discard_result(facts:OperandFacts in F, at:u64, mode:u8) -> void where {owner F} {
    if (at == no_node()) return;
    facts[at].discarded_result <- mode;
    return;
}

func inherit_result_use(facts:OperandFacts in F, parent:u64, child:u64) -> void where {owner F} {
    if (child == no_node()) return;
    facts[child].arm_result <- facts[parent].arm_result;
    facts[child].discarded_result <- facts[parent].discarded_result;
    return;
}

# Carry discard through parentheses, a grouping block's tail and the
# normal arms of a guard. Argument and arithmetic operands and independent
# invocations still establish results required by their own operations.
func prepare_result_use(nodes:const ExprNodes in N, facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val kind <- nodes[at].kind;
    # An explicit discard still requires its operand to establish its type.
    if (kind == discard_node()) { discard_result(facts, nodes[at].left, explicit_discard()); return; } else {};
    if (kind == range_node()) {
        discard_result(facts, nodes[at].right, loop_discard());
        discard_result(facts, nodes[at].number, loop_discard());
        return;
    } else {};
    if (kind == case_arm_node()) {
        facts[nodes[at].right].arm_result <- 1u8;
        return;
    } else {};
    if (kind == conditional_node()) {
        val yes <- nodes[at].right;
        val no <- nodes[at].number;
        facts[yes].arm_result <- 1u8;
        facts[no].arm_result <- 1u8;
        facts[yes].discarded_result <- facts[at].discarded_result;
        facts[no].discarded_result <- facts[at].discarded_result;
        return;
    } else {};
    if (facts[at].discarded_result == 0u8 && facts[at].arm_result == 0u8) return;
    if (kind == group_node() || kind == block_node() || kind == try_node() ||
        kind == catch_clause_node() || kind == finally_clause_node()) {
        inherit_result_use(facts, at, nodes[at].left);
    } else {};
    if (kind == block_item_node() || kind == try_node() || kind == catch_clause_node() || kind == catch_handler_node()) {
        inherit_result_use(facts, at, nodes[at].right);
    } else {};
}

# A declared receiving reference supplies placement for a directly
# contained text construction. Explicit placement is checked separately.
func prepare_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
                           facts:OperandFacts in F, at:u64) -> void
    where {const owner N, const owner B, owner F} {
    if (nodes[at].kind != ref_local_node()) return;
    val destination <- nodes[at].left;
    if (nodes[destination].kind != typed_name_node()) return;
    val annotation <- nodes[destination].right;
    if (nodes[annotation].kind != owned_type_node() || names[nodes[annotation].left].kind != builtin_string()) return;
    val construction <- ungrouped(nodes, nodes[at].right);
    if (nodes[construction].kind == make_named_node() && names[nodes[construction].left].kind == builtin_string()) {
        (facts[construction].allocation_owner <- names[nodes[annotation].right].declaration):void;
    };
}

# Revisit a writable formal only when it reaches an allocation. Its
# incoming argument edges retain the actual owner from each checked call.
func demand_owner_inputs(facts:OperandFacts in F, owners:CallOwners in O, owner_site:u64, pending:u64 in P)
    -> void where {owner F, owner O, owner P} {
    val argument <- owners[owner_site].uses;
    val actual <- no_node();
    for (unused in 0u64 .. intrinsic (len)(facts)) {
        if (argument == no_node()) return;
        facts[argument].owner_chain <- 0u64;
        actual <- facts[argument].owner;
        if (facts[actual].owner_chain == no_node()) {
            facts[actual].owner_chain <- 0u64;
            owners[actual].call_site <- pending;
            (pending <- actual):void;
        };
        argument <- facts[argument].owner_use_next;
    };
}

func close_allocation_owners(facts:OperandFacts in F, owners:CallOwners in O, used:u64) -> void
    where {owner F, owner O} {
    # Invocation substitutions are complete. Reuse their call-site words as work links.
    val pending <- no_node();
    for (site in 0u64 .. used) {
        if (facts[site].owner_chain != no_node()) {
            owners[site].call_site <- pending;
            (pending <- site):void;
        };
    };
    val site <- no_node();
    for (unused in 0u64 .. used) {
        if (pending == no_node()) return;
        site <- pending;
        pending <- owners[site].call_site;
        demand_owner_inputs(facts, owners, site, pending);
    };
}

# Operands and declarations refer to the bound syntax and its owner sites.
# Target-access demands are recorded for the completion pass, where flow can
# prove a target present or propagate a possible checked failure.
export func check_module_operands(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                  names:const NameBindings in B, links:const NameWork in L,
                                  selected:const SelectedExports in E, facts:OperandFacts in F,
                                  owners:CallOwners in O, report:OperandCheckResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner B, const owner L, const owner E, owner F, owner O, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_operand_tree();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) return false;
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(selected) < tree.used || intrinsic (len)(facts) < tree.used ||
        intrinsic (len)(owners) < tree.used) {
        report.diagnostic <- operand_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        set_fact(facts, at, 0u8, 0u8, no_node(), 0u64, 0u8);
        facts[at].needs_target <- 0u8;
        facts[at].discarded_result <- 0u8;
        facts[at].arm_result <- 0u8;
        facts[at].case_item <- 0u8;
        facts[at].case_match <- misses_case_arm();
        facts[at].case_body <- 0u8;
        facts[at].case_guard <- 0u8;
        facts[at].case_resume <- 0u8;
        facts[at].case_end <- 0u8;
        facts[at].case_presence <- unknown_target();
        facts[at].case_selection <- no_node();
        facts[at].case_context <- no_node();
        facts[at].case_after_subject <- no_node();
        facts[at].case_discriminator <- 0u8;
        facts[at].case_may_be_absent <- 0u8;
        facts[at].enum_constant <- 0u8;
        facts[at].discriminator_code <- 0u64;
        facts[at].case_excluded_at <- no_node();
        facts[at].case_exit_link <- no_node();
        facts[at].case_exit_tail <- no_node();
        facts[at].product_words <- 0u64;
        facts[at].word_offset <- 0u64;
        facts[at].last_initializer <- no_node();
        facts[at].call_definition <- no_node();
        facts[at].allocation_owner <- no_node();
        facts[at].owner_chain <- no_node();
        facts[at].owner_use_next <- no_node();
        facts[at].passes_owner <- 0u8;
        facts[at].text_assertion <- 0u8;
        facts[at].text_intrinsic <- 0u8;
        owners[at].call_site <- no_node();
        owners[at].actual_owner <- no_node();
        owners[at].uses <- no_node();
    };
    report.diagnostic <- 0u8;
    for (at in 0u64 .. tree.used) {
        if (nodes[at].kind == data_record_node()) { prepare_product_layout(nodes, names, links, facts, at); };
    };
    for (at in 0u64 .. tree.used) {
        if (nodes[at].kind == callable_node()) {
            check_signature(nodes, names, links, selected, facts, report, at, tree.used);
            if (report.diagnostic != 0u8) return false;
            if (transfer_name(source, nodes, definition_name(nodes, at)) &&
                !supported_transfer_signature(nodes, links, facts, at))
                return operand_problem(report, at, unsupported_transfer_signature());
        } else {};
    };
    for (at in 0u64 .. tree.used) {
        if (nodes[at].kind == callable_node() && links[at].next_method != no_node()) {
            report.diagnostic <- check_transfer_signatures(nodes, links, facts, at);
            if (report.diagnostic != 0u8) { report.node <- at; return false; };
        };
    };
    val at <- no_node();
    for (offset in 0u64 .. tree.used) {
        at <- tree.used - 1u64 - offset;
        prepare_result_use(nodes, facts, at);
        prepare_text_receiver(nodes, names, facts, at);
        if (nodes[at].kind == case_node() && names[at].scope != no_node()) {
            (facts[nodes[at].left].case_after_subject <- at):void;
        } else {};
    };
    if (!check_operand_range(source, nodes, names, links, selected, facts, owners, report,
                             0u64, tree.used, tree.used, no_node())) return false;
    close_allocation_owners(facts, owners, tree.used);
    # Number reserved allocation-chain words after the syntax-indexed words.
    val next <- tree.used;
    for (site in 0u64 .. tree.used) {
        if (facts[site].owner_chain != no_node()) {
            facts[site].owner_chain <- next;
            next <- next + 1u64;
        };
    };
    return true;
}
