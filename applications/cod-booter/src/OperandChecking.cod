# An owner is a lexical scope or an owner parameter's declaration. Exception
# type identity alone does not establish the incoming object's owner.
data OperandFact {
    kind:u8;
    reception:u8;
    checked_exception:u8;
    target_readonly:u8;
    checked_borrow:u8;
    needs_target:u8;
    discarded_result:u8;
    arm_result:u8;
    owner:u64;
    identity:u64;
    reservation:u64;
}
array OperandFacts[u64]:OperandFact;

data OwnerEvidence {
    call_site:u64;
    actual_owner:u64;
}
array CallOwners[u64]:OwnerEvidence;

data OperandCheckResult {
    diagnostic:u8;
    node:u64;
}

func void_result() -> u8 { return 1u8; }
func scalar_u64() -> u8 { return 2u8; }
func exception_type() -> u8 { return 3u8; }
func null_literal() -> u8 { return 4u8; }
func never_result() -> u8 { return 5u8; }
func scalar_bool() -> u8 { return 6u8; }
func scalar_kind(kind:u8) -> bool { return kind == scalar_u64() || kind == scalar_bool(); }

func independent_value() -> u8 { return 1u8; }
func local_place() -> u8 { return 2u8; }
func borrowed_ref() -> u8 { return 3u8; }
func nullable_ptr() -> u8 { return 4u8; }
func readonly_exception() -> u8 { return 6u8; }

func unproved_operand() -> u8 { return 1u8; }
func wrong_operand_type() -> u8 { return 2u8; }
func expected_exception_type() -> u8 { return 3u8; }
func unproved_result_contract() -> u8 { return 4u8; }
func unproved_owner() -> u8 { return 5u8; }
func incompatible_owner() -> u8 { return 6u8; }
func expected_writable_place() -> u8 { return 7u8; }
func unproved_nonnull_borrow() -> u8 { return 8u8; }
func wrong_argument_count() -> u8 { return 9u8; }
func wrong_return_type() -> u8 { return 10u8; }
func unproved_call_target() -> u8 { return 11u8; }
func operand_storage_exhausted() -> u8 { return 12u8; }
func invalid_operand_tree() -> u8 { return 13u8; }
func wrong_finally_result() -> u8 { return 14u8; }
func duplicate_catch_category() -> u8 { return 15u8; }
func procedure_call_in_function() -> u8 { return 16u8; }
func value_tail_in_void_function() -> u8 { return 17u8; }
func expected_boolean_condition() -> u8 { return 18u8; }
func unproved_reservation_selection() -> u8 { return 19u8; }
func unsupported_narrow_execution() -> u8 { return 20u8; }
func readonly_owner_argument() -> u8 { return 21u8; }

func set_fact(ref facts:OperandFacts in F, at:u64, kind:u8, reception:u8,
              owner_site:u64, identity:u64, checked_exception:u8) -> void where {owner F} {
    facts[at].kind <- kind;
    facts[at].reception <- reception;
    facts[at].owner <- owner_site;
    facts[at].identity <- identity;
    facts[at].reservation <- no_node();
    facts[at].checked_exception <- checked_exception;
    facts[at].target_readonly <- 0u8;
    facts[at].checked_borrow <- 0u8;
    return;
}

func scalar_fact(ref facts:OperandFacts in F, at:u64, reception:u8, owner_site:u64) -> void where {owner F} {
    set_fact(facts, at, scalar_u64(), reception, owner_site, 0u64, 0u8);
}

func copy_fact(ref facts:OperandFacts in F, destination:u64, source:u64) -> void where {owner F} {
    set_fact(facts, destination, facts[source].kind, facts[source].reception, facts[source].owner,
             facts[source].identity, facts[source].checked_exception);
    facts[destination].reservation <- facts[source].reservation;
    facts[destination].target_readonly <- facts[source].target_readonly;
    return;
}

func only_void(ref facts:OperandFacts in F, at:u64) -> void where {owner F} {
    set_fact(facts, at, void_result(), 0u8, no_node(), 0u64, 0u8);
}

func require_typed_bits(nodes:const ExprNodes in N, ref facts:OperandFacts in F, operand:u64, kind:u8) -> u8
    where {const owner N, owner F} {
    if (local_storage_binding(nodes[operand].kind)) {
        return unproved_operand();
    } else {};
    if (facts[operand].kind == 0u8) { return unproved_operand(); } else {};
    if (!scalar_kind(kind) || facts[operand].kind != kind) { return wrong_operand_type(); } else {};
    if (facts[operand].reception == nullable_ptr()) {
        facts[operand].needs_target <- 1u8;
        return 0u8;
    } else {};
    return 0u8;
}

func require_bits(nodes:const ExprNodes in N, ref facts:OperandFacts in F, operand:u64) -> u8
    where {const owner N, owner F} {
    return require_typed_bits(nodes, facts, operand, scalar_u64());
}

func declared_scalar(binding:u8) -> u8 {
    if (binding == builtin_u64()) { return scalar_u64(); } else {};
    if (binding == builtin_bool()) { return scalar_bool(); } else {};
    return 0u8;
}

func owner_conflict(nodes:const ExprNodes in N, first:u64, second:u64) -> u8 where {const owner N} {
    if (nodes[first].kind == owner_clause_node() || nodes[second].kind == owner_clause_node()) {
        return unproved_owner();
    } else {};
    return incompatible_owner();
}

func exception_annotation(names:const NameBindings in N, selected:const SelectedExports in E,
                          ref facts:OperandFacts in F, annotation:u64, at:u64) -> u8
    where {const owner N, const owner E, owner F} {
    if (names[annotation].kind != ordinary_selection()) { return expected_exception_type(); } else {};
    val site <- names[annotation].declaration;
    if (selected[site].kind != exception_type_export()) { return expected_exception_type(); } else {};
    set_fact(facts, at, exception_type(), readonly_exception(), no_node(),
             selected[site].identity, selected[site].checked);
    return 0u8;
}

func check_formal(nodes:const ExprNodes in N, names:const NameBindings in B, ref facts:OperandFacts in F,
                  formal:u64, definition:u64) -> u8 where {const owner N, const owner B, owner F} {
    val form <- nodes[formal].kind;
    val binding <- nodes[formal].right;
    val annotation <- nodes[binding].right;
    val readonly <- if (nodes[binding].number == readonly_declaration()) { 1u8 } else { 0u8 };
    if (nodes[annotation].kind == owned_type_node()) {
        if (form != parameter_node() && form != ref_parameter_node() && form != ptr_parameter_node()) {
            return unproved_operand();
        } else {};
        val borrowed_kind <- declared_scalar(names[nodes[annotation].left].kind);
        if (borrowed_kind == 0u8) { return unproved_operand(); } else {};
        val owner_site <- names[nodes[annotation].right].declaration;
        if (owner_site == no_node() || nodes[owner_site].kind != owner_clause_node()) { return unproved_owner(); } else {};
        val reception <- if (form == ptr_parameter_node()) { nullable_ptr() } else { borrowed_ref() };
        set_fact(facts, formal, borrowed_kind, reception, owner_site, 0u64, 0u8);
        facts[formal].target_readonly <- readonly;
        return 0u8;
    } else {};
    if (form != parameter_node() && form != val_parameter_node() && form != ref_parameter_node() &&
        form != ptr_parameter_node()) { return unproved_operand(); } else {};
    val kind <- declared_scalar(names[annotation].kind);
    if (kind == 0u8) { return unproved_operand(); } else {};
    set_fact(facts, formal, kind, local_place(), definition, 0u64, 0u8);
    facts[formal].target_readonly <- readonly;
    return 0u8;
}

func check_formals(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   ref facts:OperandFacts in F, ref report:OperandCheckResult in R,
                   definition:u64, tail:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, owner F, owner R} {
    val formal <- first_item(nodes, tail);
    for (unused in 0u64 .. used) {
        if (formal == no_node()) { return; } else {};
        report.diagnostic <- check_formal(nodes, names, facts, formal, definition);
        if (report.diagnostic != 0u8) { report.node <- formal; return; } else {};
        (formal <- links[formal].next):void;
    };
}

func check_signature_clauses(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                             selected:const SelectedExports in E, ref facts:OperandFacts in F,
                             ref report:OperandCheckResult in R, definition:u64, first:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner R} {
    val clause <- first;
    val annotation <- no_node();
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (clause == no_node()) { return; } else {};
        annotation <- nodes[clause].right;
        if (nodes[clause].kind == result_clause_node()) {
            if (names[annotation].kind == builtin_void()) {
                only_void(facts, definition);
            } else {
                kind <- declared_scalar(names[annotation].kind);
                if (kind == 0u8) {
                    report.node <- annotation;
                    report.diagnostic <- unproved_result_contract();
                    return;
                } else {};
                set_result(facts, definition, kind);
            };
        } else {
            if (nodes[clause].kind == throws_clause_node()) {
                report.diagnostic <- exception_annotation(names, selected, facts, annotation, clause);
                if (report.diagnostic != 0u8) { report.node <- annotation; return; } else {};
            } else {};
        };
        (clause <- links[clause].next):void;
    };
}

func check_signature(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     selected:const SelectedExports in E, ref facts:OperandFacts in F,
                     ref report:OperandCheckResult in R, definition:u64, used:u64) -> void
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner R} {
    val head <- callable_head(nodes, definition);
    check_formals(nodes, names, links, facts, report, definition, nodes[head].right, used);
    if (report.diagnostic != 0u8) { return; } else {};
    check_signature_clauses(nodes, names, links, selected, facts, report, definition, links[head].next, used);
    if (report.diagnostic == 0u8 && facts[definition].kind == 0u8) {
        report.node <- head;
        (report.diagnostic <- unproved_result_contract()):void;
    } else {};
}

func check_local(nodes:const ExprNodes in N, names:const NameBindings in B, ref facts:OperandFacts in F,
                  at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val binding <- nodes[at].left;
    val initializer <- nodes[at].right;
    val type_name <- no_node();
    if (nodes[binding].kind == typed_name_node()) { (type_name <- nodes[binding].right):void; } else {};
    val readonly <- if (type_name != no_node() && nodes[binding].number == readonly_declaration()) {
        1u8
    } else { 0u8 };
    val required_owner <- no_node();
    val value_binding <- nodes[at].kind == val_binding_node();
    if (type_name != no_node() && nodes[type_name].kind == owned_type_node()) {
        if (value_binding) { return unproved_operand(); } else {};
        required_owner <- names[nodes[type_name].right].declaration;
        (type_name <- nodes[type_name].left):void;
    } else {};
    val declared_kind <- if (type_name == no_node()) { 0u8 } else { declared_scalar(names[type_name].kind) };
    if (declared_kind == 0u8 && type_name != no_node()) { return unproved_operand(); } else {};
    if (facts[initializer].kind == never_result()) {
        if (required_owner != no_node() && nodes[initializer].kind == make_named_node() &&
            required_owner != names[initializer].scope) {
            return owner_conflict(nodes, names[initializer].scope, required_owner);
        } else {};
        set_result(facts, at, never_result());
        return 0u8;
    } else {};
    if (value_binding) {
        val value_kind <- if (declared_kind == 0u8) { (facts[initializer].kind) } else { declared_kind };
        if (reserves_storage(nodes, initializer)) {
            if (facts[initializer].kind != value_kind) { return wrong_operand_type(); } else {};
            set_fact(facts, at, value_kind, local_place(), names[at].scope, 0u64, 0u8);
            facts[at].target_readonly <- readonly;
            facts[at].reservation <- initializer;
            return 0u8;
        } else {};
        val diagnostic <- require_typed_bits(nodes, facts, initializer, value_kind);
        if (diagnostic != 0u8) { return diagnostic; } else {};
        set_fact(facts, at, value_kind, local_place(), names[at].scope, 0u64, 0u8);
        facts[at].target_readonly <- readonly;
        return 0u8;
    } else {};
    if (local_storage_binding(nodes[initializer].kind)) { return unproved_operand(); } else {};
    val pointer <- nodes[at].kind == ptr_binding_node();
    val reception <- if (pointer) { nullable_ptr() } else { borrowed_ref() };
    val fresh <- facts[initializer].reception == independent_value();
    val kind <- if (type_name == no_node()) { (facts[initializer].kind) } else { declared_kind };
    val owner_site <- if (fresh) { (names[at].scope) } else { (facts[initializer].owner) };
    if (required_owner != no_node()) {
        if (owner_site != no_node() && owner_site != required_owner) {
            return owner_conflict(nodes, owner_site, required_owner);
        } else {};
        (owner_site <- required_owner):void;
    } else {};
    if (facts[initializer].kind == null_literal()) {
        if (!pointer) { return unproved_nonnull_borrow(); } else {};
    } else {
        if (!scalar_kind(kind) || facts[initializer].kind != kind) {
            return unproved_operand();
        } else {};
        if (type_name != no_node() && facts[initializer].target_readonly != 0u8 && readonly == 0u8) {
            return expected_writable_place();
        } else {};
    };
    if (owner_site == no_node()) { return unproved_owner(); } else {};
    set_fact(facts, at, kind, reception, owner_site, 0u64, 0u8);
    facts[at].target_readonly <- if (type_name == no_node()) { (facts[initializer].target_readonly) } else { readonly };
    facts[at].reservation <- facts[initializer].reservation;
    return 0u8;
}

func check_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                        ref facts:OperandFacts in F, at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val requested <- nodes[at].left;
    val kind <- if (nodes[requested].kind == construction_type_query_node()) {
        (facts[nodes[requested].left].kind)
    } else { declared_scalar(names[requested].kind) };
    if (!scalar_kind(kind)) { return unproved_operand(); } else {};
    val owner_site <- names[at].scope;
    val explicit_owner <- nodes[nodes[at].right].right;
    if (explicit_owner != no_node() && names[explicit_owner].declaration != owner_site) { return unproved_owner(); } else {};
    val body <- construction_body(nodes, at);
    if (body == no_node()) {
        set_fact(facts, at, kind, borrowed_ref(), owner_site, 0u64, 0u8);
        facts[at].reservation <- at;
        return 0u8;
    } else {};
    if (facts[body].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    val diagnostic <- require_typed_bits(nodes, facts, body, kind);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    set_fact(facts, at, kind, borrowed_ref(), owner_site, 0u64, 0u8);
    return 0u8;
}

func check_transfer(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val destination <- nodes[at].left;
    val supplied <- nodes[at].right;
    val reception <- facts[destination].reception;
    val kind <- facts[destination].kind;
    if (!scalar_kind(kind)) { return unproved_operand(); } else {};
    if (facts[destination].target_readonly != 0u8 ||
        (reception != local_place() && reception != borrowed_ref() && reception != nullable_ptr())) {
        return expected_writable_place();
    } else {};
    val diagnostic <- require_typed_bits(nodes, facts, destination, kind);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    diagnostic <- require_typed_bits(nodes, facts, supplied, kind);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    set_fact(facts, at, kind, borrowed_ref(), facts[destination].owner, 0u64, 0u8);
    facts[at].target_readonly <- 1u8;
    facts[at].reservation <- facts[destination].reservation;
    return 0u8;
}

func check_argument(nodes:const ExprNodes in N, ref facts:OperandFacts in F, ref owners:CallOwners in O,
                     argument:u64, formal:u64, invocation:u64) -> u8 where {const owner N, owner F, owner O} {
    val actual <- nodes[argument].right;
    val wanted <- facts[formal].reception;
    val kind <- facts[formal].kind;
    if (wanted == local_place()) {
        val diagnostic <- require_typed_bits(nodes, facts, actual, kind);
        if (diagnostic != 0u8) { return diagnostic; } else {};
        set_result(facts, argument, kind);
        return 0u8;
    } else {};
    if (local_storage_binding(nodes[actual].kind) ||
        facts[actual].kind == 0u8 || facts[actual].kind == null_literal()) { return unproved_operand(); } else {};
    if (facts[actual].kind != kind) { return wrong_operand_type(); } else {};
    val reception <- facts[actual].reception;
    if (reception == independent_value()) { return unproved_owner(); } else {};
    if (facts[actual].target_readonly != 0u8 && facts[formal].target_readonly == 0u8) { return expected_writable_place(); } else {};
    val owner_parameter <- facts[formal].owner;
    val actual_owner <- facts[actual].owner;
    if (actual_owner == no_node()) { return unproved_owner(); } else {};
    if (nodes[actual_owner].kind == owner_clause_node() && nodes[actual_owner].number == readonly_declaration() &&
        nodes[owner_parameter].number != readonly_declaration()) { return readonly_owner_argument(); } else {};
    if (owners[owner_parameter].call_site == invocation && owners[owner_parameter].actual_owner != actual_owner) {
        return owner_conflict(nodes, owners[owner_parameter].actual_owner, actual_owner);
    } else {};
    owners[owner_parameter].call_site <- invocation;
    owners[owner_parameter].actual_owner <- actual_owner;
    set_fact(facts, argument, kind, wanted, actual_owner, 0u64, 0u8);
    if (nodes[formal].kind == parameter_node() && reception == nullable_ptr()) {
        facts[argument].checked_borrow <- 1u8;
        (facts[actual].needs_target <- 1u8):void;
    } else {};
    return 0u8;
}

func check_direct_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       ref facts:OperandFacts in F, ref owners:CallOwners in O, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, owner F, owner O} {
    val callee <- nodes[at].left;
    if (names[callee].kind != callable_binding()) { return unproved_call_target(); } else {};
    val definition <- names[callee].declaration;
    if (!is_function(nodes, definition) && is_function(nodes, enclosing_callable(nodes, names, names[at].scope))) {
        return procedure_call_in_function();
    } else {};
    val head <- callable_head(nodes, definition);
    val formal <- first_item(nodes, nodes[head].right);
    val argument <- first_item(nodes, nodes[at].right);
    val diagnostic <- 0u8;
    for (unused in 0u64 .. used) {
        if (formal == no_node() || argument == no_node()) {
            if (formal != argument) { return wrong_argument_count(); } else {};
            copy_fact(facts, at, definition);
            return 0u8;
        } else {};
        diagnostic <- check_argument(nodes, facts, owners, argument, formal, at);
        if (diagnostic != 0u8) { return diagnostic; } else {};
        formal <- links[formal].next;
        (argument <- links[argument].next):void;
    };
    return invalid_operand_tree();
}

func check_symbolic_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                         selected:const SelectedExports in E, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner B, const owner E, owner F} {
    val callee <- nodes[at].left;
    if (names[callee].kind != symbolic_selection()) { return unproved_call_target(); } else {};
    val site <- names[callee].declaration;
    if (selected[site].kind != symbol_export() || selected[site].identity != print_export_identity()) {
        return unproved_call_target();
    } else {};
    val argument <- nodes[at].right;
    if (argument == no_node() || nodes[argument].left != no_node()) { return wrong_argument_count(); } else {};
    val diagnostic <- require_bits(nodes, facts, nodes[argument].right);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    scalar_fact(facts, argument, independent_value(), no_node());
    only_void(facts, at);
    return 0u8;
}

func result_kind(nodes:const ExprNodes in N, ref facts:OperandFacts in F, value:u64, read:bool) -> u8
    where {const owner N, owner F} {
    if (value == no_node()) { return void_result(); } else {};
    val kind <- facts[value].kind;
    if (read && scalar_kind(kind) && require_typed_bits(nodes, facts, value, kind) != 0u8) { return 0u8; } else {};
    if (scalar_kind(kind) || kind == void_result() || kind == never_result()) { return kind; } else {};
    return 0u8;
}

func set_result(ref facts:OperandFacts in F, at:u64, kind:u8) -> void where {owner F} {
    if (scalar_kind(kind)) { set_fact(facts, at, kind, independent_value(), no_node(), 0u64, 0u8); } else {
        set_fact(facts, at, kind, 0u8, no_node(), 0u64, 0u8);
    };
}

func explicit_discard() -> u8 { return 1u8; }
func loop_discard() -> u8 { return 2u8; }

# List entries carry the reached normal tail type. Explicit discard still
# checks that type, without imposing a read of the tail's target.
func check_sequence_item(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val previous <- nodes[at].left;
    if (previous != no_node() && facts[previous].kind == never_result()) {
        set_result(facts, at, never_result());
        return;
    } else {};
    val expression <- nodes[at].right;
    if (facts[expression].kind == never_result()) { set_result(facts, at, never_result()); return; } else {};
    val kind <- void_result();
    if (!local_storage_binding(nodes[expression].kind)) {
        if (facts[at].arm_result != 0u8 && scalar_kind(facts[expression].kind)) {
            copy_fact(facts, at, expression);
            return;
        } else {};
        (kind <- result_kind(nodes, facts, expression, facts[at].discarded_result == 0u8)):void;
    } else {};
    set_result(facts, at, kind);
}

func sequence_result(facts:const OperandFacts in F, tail:u64) -> u8 where {const owner F} {
    if (tail == no_node()) { return void_result(); } else {};
    return facts[tail].kind;
}

# Abrupt paths add no normal result to a full scope or try expression.
func merge_result(ref facts:OperandFacts in F, at:u64, kind:u8) -> u8 where {owner F} {
    if (kind == 0u8) { return unproved_result_contract(); } else {};
    if (kind == never_result()) { return 0u8; } else {};
    if (facts[at].kind != 0u8 && facts[at].kind != kind) { return unproved_result_contract(); } else {};
    set_result(facts, at, kind);
    return 0u8;
}

func merge_arm_result(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64, arm:u64) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (kind == 0u8) { return unproved_result_contract(); } else {};
    if (kind == never_result()) { return 0u8; } else {};
    if (facts[at].discarded_result == loop_discard()) { return merge_result(facts, at, void_result()); } else {};
    if (facts[at].kind == 0u8) {
        copy_fact(facts, at, arm);
        return 0u8;
    } else {};
    if (kind != facts[at].kind) { return unproved_result_contract(); } else {};
    val left <- facts[at].reception;
    val right <- facts[arm].reception;
    val nullable <- left == nullable_ptr() || right == nullable_ptr();
    if (kind == void_result() || left == independent_value() || right == independent_value()) {
        if (nullable) { return unproved_nonnull_borrow(); } else {};
        set_result(facts, at, kind);
        return 0u8;
    } else {};
    val owner_site <- facts[at].owner;
    if (owner_site == no_node() || facts[arm].owner == no_node()) { return unproved_owner(); } else {};
    if (owner_site != facts[arm].owner) { return owner_conflict(nodes, owner_site, facts[arm].owner); } else {};
    val readonly <- if (facts[at].target_readonly != 0u8 || facts[arm].target_readonly != 0u8) { 1u8 } else { 0u8 };
    val reservation <- facts[at].reservation;
    if (reservation != facts[arm].reservation) { return unproved_reservation_selection(); } else {};
    val reception <- if (nullable) { nullable_ptr() } else { borrowed_ref() };
    set_fact(facts, at, kind, reception, owner_site, 0u64, 0u8);
    facts[at].target_readonly <- readonly;
    facts[at].reservation <- reservation;
    return 0u8;
}

func check_conditional(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val condition <- nodes[at].left;
    if (facts[condition].kind == never_result()) { set_result(facts, at, never_result()); return 0u8; } else {};
    if (require_typed_bits(nodes, facts, condition, scalar_bool()) != 0u8) { return expected_boolean_condition(); } else {};
    val diagnostic <- merge_arm_result(nodes, facts, at, nodes[at].right);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    diagnostic <- merge_arm_result(nodes, facts, at, nodes[at].number);
    if (diagnostic == 0u8 && facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
    return diagnostic;
}

func check_logical(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    val abrupt <- facts[left].kind == never_result();
    val diagnostic <- 0u8;
    if (!abrupt) {
        diagnostic <- require_typed_bits(nodes, facts, left, scalar_bool());
        if (diagnostic != 0u8) { return diagnostic; } else {};
    } else {};
    if (logical_binary(nodes[at].kind)) {
        val right <- nodes[at].right;
        if (facts[right].kind == never_result()) {
            (abrupt <- abrupt || (nodes[left].kind == bool_node() && !skips_right(nodes, at))):void;
        } else {
            diagnostic <- require_typed_bits(nodes, facts, right, scalar_bool());
            if (diagnostic != 0u8) { return diagnostic; } else {};
        };
    } else {};
    set_result(facts, at, if (abrupt) { never_result() } else { scalar_bool() });
    return 0u8;
}

func merge_guard_result(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64, arm:u64, discard:bool) -> u8
    where {const owner N, owner F} {
    val kind <- facts[arm].kind;
    if (discard && scalar_kind(kind)) { return merge_result(facts, at, void_result()); } else {};
    if (facts[at].arm_result == 0u8 || !scalar_kind(kind)) { return merge_result(facts, at, kind); } else {};
    if (facts[arm].reception == nullable_ptr() && facts[at].discarded_result == 0u8) {
        return unproved_nonnull_borrow();
    } else {};
    # A native result slot can hold either bits or a target. A guard with
    # both would need to retain that distinction until its finalizer exits.
    if (scalar_kind(facts[at].kind) &&
        ((facts[at].reception == independent_value()) != (facts[arm].reception == independent_value()))) {
        return unproved_result_contract();
    } else {};
    return merge_arm_result(nodes, facts, at, arm);
}

func check_try_result(nodes:const ExprNodes in N, links:const NameWork in L, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner L, owner F} {
    val discard <- nodes[at].number == discarded_guard_result() || facts[at].discarded_result == loop_discard();
    val diagnostic <- merge_guard_result(nodes, facts, at, nodes[at].left, discard);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    val clause <- first_item(nodes, nodes[at].right);
    val arm <- no_node();
    val kind <- 0u8;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) {
            if (facts[at].kind == 0u8) { set_result(facts, at, never_result()); } else {};
            return 0u8;
        } else {};
        arm <- nodes[clause].right;
        if (nodes[clause].kind == catch_clause_node()) {
            diagnostic <- merge_guard_result(nodes, facts, at, nodes[arm].right, discard);
            if (diagnostic != 0u8) { return diagnostic; } else {};
        } else {
            kind <- facts[arm].kind;
            if (kind == never_result()) { set_result(facts, at, kind); return 0u8; } else {};
            if (nodes[clause].kind != finally_clause_node() || kind != void_result()) { return wrong_finally_result(); } else {};
        };
        (clause <- links[clause].next):void;
    };
    return unproved_result_contract();
}

func catch_category(nodes:const ExprNodes in N, facts:const OperandFacts in F, clause:u64) -> u64
    where {const owner N, const owner F} {
    val binding <- nodes[nodes[clause].right].left;
    val identity <- facts[binding].identity;
    return if (identity == no_node()) { exception_root_identity() } else { identity };
}

func check_catch_clause(nodes:const ExprNodes in N, facts:const OperandFacts in F, at:u64) -> u8
    where {const owner N, const owner F} {
    val category <- catch_category(nodes, facts, at);
    val previous <- nodes[at].left;
    for (unused in 0u64 .. at) {
        if (previous == no_node()) { return 0u8; } else {};
        if (catch_category(nodes, facts, previous) == category) { return duplicate_catch_category(); } else {};
        (previous <- nodes[previous].left):void;
    };
    return 0u8;
}

func check_scope_tail(nodes:const ExprNodes in N, ref facts:OperandFacts in F, scope:u64) -> u8
    where {const owner N, owner F} {
    val diagnostic <- merge_result(facts, scope, sequence_result(facts, nodes[scope].left));
    if (diagnostic == 0u8 && facts[scope].kind == 0u8) { only_void(facts, scope); } else {};
    return diagnostic;
}

func has_value_tail(nodes:const ExprNodes in N, facts:const OperandFacts in F, definition:u64) -> bool
    where {const owner N, const owner F} {
    return is_function(nodes, definition) && scalar_kind(facts[nodes[definition].right].kind);
}

func check_callable_tail(nodes:const ExprNodes in N, facts:const OperandFacts in F, definition:u64) -> u8
    where {const owner N, const owner F} {
    if (!is_function(nodes, definition)) { return 0u8; } else {};
    val kind <- facts[nodes[definition].right].kind;
    if (kind == 0u8) { return unproved_result_contract(); } else {};
    if (scalar_kind(kind) && facts[definition].kind == void_result()) { return value_tail_in_void_function(); } else {};
    if (scalar_kind(kind) && kind != facts[definition].kind) { return wrong_return_type(); } else {};
    return 0u8;
}

func check_return(nodes:const ExprNodes in N, names:const NameBindings in B, ref facts:OperandFacts in F,
                   at:u64) -> u8 where {const owner N, const owner B, owner F} {
    val scope <- names[at].scope;
    val value <- nodes[at].left;
    if (nodes[scope].kind == module_node()) { return wrong_return_type(); } else {};
    if (nodes[scope].kind == full_scope_node()) { return merge_result(facts, scope, result_kind(nodes, facts, value, true)); } else {};
    if (nodes[scope].kind != callable_node()) { return unproved_result_contract(); } else {};
    if (value != no_node() && facts[value].kind == never_result()) { return 0u8; } else {};
    if (facts[scope].kind == void_result()) {
        if (value != no_node() && facts[value].kind != void_result()) { return wrong_return_type(); } else {};
        return 0u8;
    } else {};
    if (value == no_node()) { return wrong_return_type(); } else {};
    val diagnostic <- require_typed_bits(nodes, facts, value, facts[scope].kind);
    if (diagnostic == wrong_operand_type()) { return wrong_return_type(); } else {};
    return diagnostic;
}

func check_numeric_expression(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64, kind:u8) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    if (kind == group_node()) {
        val inside <- facts[left].kind;
        if (inside == void_result() || inside == never_result() || inside == exception_type() ||
            facts[left].reception == nullable_ptr()) {
            copy_fact(facts, at, left);
            return 0u8;
        } else {};
        if (scalar_kind(inside) && facts[at].discarded_result != 0u8) {
            set_result(facts, at, inside);
            return 0u8;
        } else {};
        val projection <- require_typed_bits(nodes, facts, left, inside);
        if (projection != 0u8) { return projection; } else {};
        set_result(facts, at, inside);
        return 0u8;
    } else {};
    val right <- nodes[at].right;
    val left_completes <- facts[left].kind != never_result();
    val right_completes <- facts[right].kind != never_result();
    val left_diagnostic <- if (left_completes) { require_bits(nodes, facts, left) } else { 0u8 };
    if (left_diagnostic != 0u8) { return left_diagnostic; } else {};
    val right_diagnostic <- if (right_completes) { require_bits(nodes, facts, right) } else { 0u8 };
    if (right_diagnostic != 0u8) { return right_diagnostic; } else {};
    if (!left_completes || !right_completes) { set_result(facts, at, never_result()); }
    else { scalar_fact(facts, at, independent_value(), no_node()); };
    return 0u8;
}

func check_comparison(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val left <- nodes[at].left;
    val kind <- if (nodes[at].number <= unequal_words()) { (facts[left].kind) } else { scalar_u64() };
    val diagnostic <- require_typed_bits(nodes, facts, left, kind);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    diagnostic <- require_typed_bits(nodes, facts, nodes[at].right, kind);
    if (diagnostic != 0u8) { return diagnostic; } else {};
    set_result(facts, at, scalar_bool());
    return 0u8;
}

func check_range_header(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val lower <- nodes[at].left;
    val upper <- nodes[at].right;
    val diagnostic <- if (facts[lower].kind != never_result()) { require_bits(nodes, facts, lower) } else { 0u8 };
    if (diagnostic != 0u8) { return diagnostic; } else {};
    if (facts[upper].kind != never_result()) {
        diagnostic <- require_bits(nodes, facts, upper);
        if (diagnostic != 0u8) { return diagnostic; } else {};
    } else {};
    # Reads use the current index word. It exposes no writable binding slot.
    set_result(facts, at, scalar_u64());
    return 0u8;
}

func check_range_result(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val header <- nodes[at].left;
    val lower <- nodes[header].left;
    val upper <- nodes[header].right;
    val empty <- nodes[at].number;
    val body_continues <- facts[nodes[at].right].kind != never_result();
    val empty_continues <- empty == no_node() || facts[empty].kind != never_result();
    val continues <- if (literal_range(nodes, header)) {
        if (nonempty_literal_range(nodes, header)) { body_continues } else { empty_continues }
    } else { body_continues || empty_continues };
    if (facts[lower].kind == never_result() || facts[upper].kind == never_result() || !continues) {
        set_result(facts, at, never_result());
    } else { only_void(facts, at); };
}

func check_explicit_discard(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> u8
    where {const owner N, owner F} {
    val kind <- result_kind(nodes, facts, nodes[at].left, false);
    if (kind == 0u8) { return unproved_operand(); } else {};
    set_result(facts, at, if (kind == never_result()) { kind } else { void_result() });
    return 0u8;
}

func check_operand(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   selected:const SelectedExports in E, ref facts:OperandFacts in F, ref owners:CallOwners in O,
                   at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner E, owner F, owner O} {
    val kind <- nodes[at].kind;
    if (kind == block_item_node() || kind == module_item_node()) {
        check_sequence_item(nodes, facts, at);
        return 0u8;
    } else {};
    if (kind == catch_binding_node()) {
        val annotation <- nodes[at].right;
        if (annotation != no_node()) { return exception_annotation(names, selected, facts, annotation, at); } else {};
        set_fact(facts, at, exception_type(), readonly_exception(), no_node(), no_node(), 0u8);
        return 0u8;
    } else {};
    if (kind == catch_clause_node()) { return check_catch_clause(nodes, facts, at); } else {};
    if (kind == callable_node()) { return check_callable_tail(nodes, facts, at); } else {};
    if (names[at].scope == no_node()) { return 0u8; } else {};
    if (kind == narrow_integer_node()) { return unsupported_narrow_execution(); } else {};
    if (kind == literal_node()) { scalar_fact(facts, at, independent_value(), no_node()); return 0u8; } else {};
    if (kind == bool_node()) { set_result(facts, at, scalar_bool()); return 0u8; } else {};
    if (kind == name_node()) {
        val binding <- names[at].kind;
        if (binding == formal_binding() || binding == local_binding() || binding == exception_binding() ||
            binding == loop_index()) {
            copy_fact(facts, at, names[at].declaration);
        } else {};
        return 0u8;
    } else {};
    if (kind == null_node()) {
        val owner_name <- nodes[at].left;
        val owner_site <- no_node();
        if (owner_name != no_node()) { (owner_site <- names[owner_name].declaration):void; } else {};
        set_fact(facts, at, null_literal(), 0u8, owner_site, 0u64, 0u8);
        return 0u8;
    } else {};
    if (local_storage_binding(kind)) { return check_local(nodes, names, facts, at); } else {};
    if (kind == make_named_node()) { return check_construction(nodes, names, facts, at); } else {};
    if (integer_arithmetic(kind) || kind == group_node()) {
        return check_numeric_expression(nodes, facts, at, kind);
    } else {};
    if (is_transfer(nodes, at)) { return check_transfer(nodes, facts, at); } else {};
    if (kind == compare_node()) { return check_comparison(nodes, facts, at); } else {};
    if (kind == logical_not_node() || logical_binary(kind)) { return check_logical(nodes, facts, at); } else {};
    if (kind == call_node()) { return check_direct_call(nodes, names, links, facts, owners, at, used); } else {};
    if (kind == behave_node()) { return check_symbolic_call(nodes, names, selected, facts, at); } else {};
    if (kind == block_node()) {
        val tail <- nodes[at].left;
        if (tail != no_node() && facts[at].arm_result != 0u8) { copy_fact(facts, at, tail); } else {
            set_result(facts, at, sequence_result(facts, tail));
        };
        return 0u8;
    } else {};
    if (kind == full_scope_node()) { return check_scope_tail(nodes, facts, at); } else {};
    if (kind == try_node()) { return check_try_result(nodes, links, facts, at); } else {};
    if (kind == conditional_node()) { return check_conditional(nodes, facts, at); } else {};
    if (kind == range_header_node()) { return check_range_header(nodes, facts, at); } else {};
    if (kind == range_node()) { check_range_result(nodes, facts, at); return 0u8; } else {};
    if (kind == discard_node()) { return check_explicit_discard(nodes, facts, at); } else {};
    if (kind == return_node()) {
        val diagnostic <- check_return(nodes, names, facts, at);
        if (diagnostic == 0u8) { set_result(facts, at, never_result()); } else {};
        return diagnostic;
    } else {};
    if (kind == throw_node()) {
        val operand <- nodes[at].left;
        if (operand != no_node() && facts[operand].kind != exception_type()) { return expected_exception_type(); } else {};
        set_result(facts, at, never_result());
    } else {};
    if (kind == deferred_call_node() || kind == deferred_block_node()) { only_void(facts, at); } else {};
    return 0u8;
}

func discard_result(ref facts:OperandFacts in F, at:u64, mode:u8) -> void where {owner F} {
    if (at == no_node()) { return; } else {};
    facts[at].discarded_result <- mode;
    return;
}

func inherit_result_use(ref facts:OperandFacts in F, parent:u64, child:u64) -> void where {owner F} {
    if (child == no_node()) { return; } else {};
    facts[child].arm_result <- facts[parent].arm_result;
    facts[child].discarded_result <- facts[parent].discarded_result;
    return;
}

# Carry discard through parentheses, a grouping block's tail and the
# normal arms of a guard. Argument and arithmetic operands and independent
# invocations still establish results required by their own operations.
func prepare_result_use(nodes:const ExprNodes in N, ref facts:OperandFacts in F, at:u64) -> void
    where {const owner N, owner F} {
    val kind <- nodes[at].kind;
    # An explicit discard still requires its operand to establish its type.
    if (kind == discard_node()) { discard_result(facts, nodes[at].left, explicit_discard()); return; } else {};
    if (kind == range_node()) {
        discard_result(facts, nodes[at].right, loop_discard());
        discard_result(facts, nodes[at].number, loop_discard());
        return;
    } else {};
    if (kind == conditional_node()) {
        val yes <- nodes[at].right;
        val no <- nodes[at].number;
        facts[yes].arm_result <- 1u8;
        facts[no].arm_result <- 1u8;
        facts[yes].discarded_result <- facts[at].discarded_result;
        facts[no].discarded_result <- facts[at].discarded_result;
        return;
    } else {};
    if (facts[at].discarded_result == 0u8 && facts[at].arm_result == 0u8) { return; } else {};
    if (kind == group_node() || kind == block_node() || kind == try_node() ||
        kind == catch_clause_node() || kind == finally_clause_node()) {
        inherit_result_use(facts, at, nodes[at].left);
    } else {};
    if (kind == block_item_node() || kind == try_node() || kind == catch_clause_node() || kind == catch_handler_node()) {
        inherit_result_use(facts, at, nodes[at].right);
    } else {};
}

# Operands and declarations refer to the bound syntax and its owner sites.
# Target-access demands are recorded for the completion pass, where flow can
# prove a target present or propagate a possible checked failure.
func check_module_operands(nodes:const ExprNodes in N, tree:const ParseResult in T,
                           names:const NameBindings in B, links:const NameWork in L,
                           selected:const SelectedExports in E, ref facts:OperandFacts in F,
                           ref owners:CallOwners in O, ref report:OperandCheckResult in R) -> bool
    where {const owner N, const owner T, const owner B, const owner L, const owner E, owner F, owner O, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_operand_tree();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) { return false; } else {};
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(selected) < tree.used || intrinsic (len)(facts) < tree.used ||
        intrinsic (len)(owners) < tree.used) {
        report.diagnostic <- operand_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        set_fact(facts, at, 0u8, 0u8, no_node(), 0u64, 0u8);
        facts[at].needs_target <- 0u8;
        facts[at].discarded_result <- 0u8;
        facts[at].arm_result <- 0u8;
        owners[at].call_site <- no_node();
        owners[at].actual_owner <- no_node();
    };
    report.diagnostic <- 0u8;
    for (at in 0u64 .. tree.used) {
        if (nodes[at].kind == callable_node()) {
            check_signature(nodes, names, links, selected, facts, report, at, tree.used);
            if (report.diagnostic != 0u8) { return false; } else {};
        } else {};
    };
    for (offset in 0u64 .. tree.used) {
        prepare_result_use(nodes, facts, tree.used - 1u64 - offset);
    };
    # The syntax puts operands before their operation and local declarations
    # before uses. Callable contracts are already available for forward calls.
    for (at in 0u64 .. tree.used) {
        report.diagnostic <- check_operand(nodes, names, links, selected, facts, owners, at, tree.used);
        if (report.diagnostic != 0u8) { report.node <- at; return false; } else {};
    };
    return true;
}

export OperandFact;
export OperandFacts;
export OwnerEvidence;
export CallOwners;
export OperandCheckResult;
export check_module_operands;
export void_result;
export scalar_u64;
export scalar_kind;
export has_value_tail;
export never_result;
export exception_type;
export null_literal;
export independent_value;
export local_place;
export borrowed_ref;
export nullable_ptr;
export readonly_exception;
export unproved_operand;
export wrong_operand_type;
export expected_exception_type;
export unproved_result_contract;
export unproved_owner;
export incompatible_owner;
export expected_writable_place;
export unproved_nonnull_borrow;
export wrong_argument_count;
export wrong_return_type;
export unproved_call_target;
export operand_storage_exhausted;
export invalid_operand_tree;
