using "ASCII.cod";
using "ASCII.cod" ASCII {
    EXCLAMATION, DOUBLE_QUOTE, DOLLAR, AMPERSAND, LEFT_PAREN, RIGHT_PAREN, ASTERISK, PLUS, COMMA,
    MINUS, PERIOD, SLASH, DIGIT_0, DIGIT_2, DIGIT_3, DIGIT_4, DIGIT_6, DIGIT_8, DIGIT_9, COLON,
    SEMICOLON, LESS_THAN, GREATER_THAN, AT, UPPER_A, UPPER_C, UPPER_E, UPPER_Z, LEFT_BRACKET,
    BACKSLASH, RIGHT_BRACKET, UNDERSCORE, LOWER_A, LOWER_E, LOWER_F, LOWER_U, LOWER_Z, LEFT_BRACE,
    PIPE, RIGHT_BRACE
};
using "./SourceStorage.cod" { SourceBytes, Token };
using "./SourceAccess.cod" len;
using "std:text-storage" { utf8_size, utf8_byte }

export func end_of_source() -> UInt8 { return 0u8; }
export func identifier() -> UInt8 { return 1u8; }
export func symbol_name() -> UInt8 { return 2u8; }
export func integer_literal() -> UInt8 { return 3u8; }
export func real_literal() -> UInt8 { return 4u8; }
export func quoted_text() -> UInt8 { return 5u8; }
export func punctuation() -> UInt8 { return 6u8; }

export func unsupported_byte() -> UInt8 { return 7u8; }
export func missing_symbol_name() -> UInt8 { return 8u8; }
export func missing_exponent_digits() -> UInt8 { return 9u8; }
export func unterminated_module_path() -> UInt8 { return 10u8; }
export func newline_in_module_path() -> UInt8 { return 11u8; }
export func invalid_module_path_escape() -> UInt8 { return 12u8; }
export func reserved_fraction_operator() -> UInt8 { return 13u8; }
export func legacy_type_separator() -> UInt8 { return 14u8; }
export func multiline_text() -> UInt8 { return 15u8 }

export func lexical_error(kind:UInt8) -> bool {
    return kind >= unsupported_byte() && kind != multiline_text()
}

func word_is(source:const SourceBytes in S, token:const Token in T, spelling:const String in W)
    -> bool where {const owner S, const owner T, const owner W} {
    if (token.kind != identifier() || token.first > token.past) return false;
    val width <- token.past - token.first;
    if (width != utf8_size(spelling) || token.past > len(source)) return false;
    for (offset in 0u64 .. width) {
        if (source[token.first + offset] != utf8_byte(spelling, offset)) return false
    };
    return true
}

export func exception_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "exception")
}

export func own_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "own")
}

export func make_word(source:const SourceBytes in S, token:const Token in T) -> bool
