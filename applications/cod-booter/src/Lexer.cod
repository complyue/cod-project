func module_only_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return using_word(source, token) || import_word(source, token) || mixin_word(source, token) ||
        export_word(source, token) || conversion_word(source, token);
}

func touch_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "touch")
}

export func intrinsic_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "intrinsic")
}

export func len_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "len")
}

export func reserved_value_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return module_only_name(source, token) || touch_word(source, token) || intrinsic_word(source, token) ||
        true_word(source, token) || false_word(source, token) || null_word(source, token) || not_word(source, token) ||
        func_word(source, token) || proc_word(source, token) || ref_word(source, token) || ptr_word(source, token) ||
        val_word(source, token) || const_word(source, token) || make_word(source, token) || return_word(source, token) ||
        throw_word(source, token) || try_word(source, token) || catch_word(source, token) || finally_word(source, token) ||
        defer_word(source, token) || if_word(source, token) || for_word(source, token) || case_word(source, token) ||
        behave_word(source, token);
}

func numeric_type_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return word_is(source, token, "Int64") || word_is(source, token, "UInt8") ||
        word_is(source, token, "UInt32") || word_is(source, token, "UInt64") ||
        word_is(source, token, "Float32") || word_is(source, token, "Float64")
}

export func reserved_lexical_binder(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (reserved_value_name(source, token) || void_word(source, token) || typeof_word(source, token) ||
        region_word(source, token) || symbol_word(source, token)) return true;
    return is_word(source, token) || var_word(source, token) || effect_word(source, token) ||
        numeric_type_word(source, token) ||
        word_is(source, token, "bool") || word_is(source, token, "deref") || word_is(source, token, "global") ||
        word_is(source, token, "scalar") || word_is(source, token, "perform") ||
        word_is(source, token, "function") || word_is(source, token, "procedure")
}

export func reserved_module_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return reserved_value_name(source, token) || data_word(source, token) || type_word(source, token) ||
        unit_word(source, token) || array_word(source, token) ||
        numeric_type_word(source, token);
}

