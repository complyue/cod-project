func digit(byte:UInt8) -> bool {
    # ASCII '0' to '9'.
    return byte >= DIGIT_0 && byte <= DIGIT_9;
}

func name_start(byte:UInt8) -> bool {
    # ASCII letters and underscore.
    return (byte >= UPPER_A && byte <= UPPER_Z) ||
        (byte >= LOWER_A && byte <= LOWER_Z) || byte == UNDERSCORE;
}

func whitespace(byte:UInt8) -> bool {
    return byte == SPACE || (byte >= HT && byte <= CR);
}

func skip_trivia(source:const SourceBytes in S, first:UInt64, past:UInt64) -> UInt64 where {const owner S} {
    val comment <- false;
    val byte <- 0u8;
    for (at in first .. past) {
        byte <- source[at];
        # A newline ends a comment. '#' starts one anywhere outside a path.
        comment <- byte != LF && (comment || byte == HASH);
        if (!comment && !whitespace(byte)) return at;
    };
    return past;
}

func name_end(source:const SourceBytes in S, first:UInt64, past:UInt64) -> UInt64 where {const owner S} {
    val byte <- 0u8;
    for (at in first .. past) {
        byte <- source[at];
        if (!(name_start(byte) || digit(byte))) return at;
    };
    return past;
}

func digits_end(source:const SourceBytes in S, first:UInt64, past:UInt64) -> UInt64 where {const owner S} {
    for (at in first .. past) {
        if (!digit(source[at])) return at;
    };
    return past;
}

# Zero is a sentinel for lookahead only. scan_token still diagnoses a zero
# byte when it is present in the input itself.
func lookahead(source:const SourceBytes in S, at:UInt64, past:UInt64) -> UInt8 where {const owner S} {
    if (at >= past) return 0u8;
    return source[at];
}

func numeral_end(source:const SourceBytes in S, first:UInt64, past:UInt64,
                  token:Token in T) -> void where {const owner S, owner T} {
    val at <- digits_end(source, first + 1u64, past);
    val real <- false;
    val byte <- lookahead(source, at, past);
    if (byte == PERIOD && digit(lookahead(source, at + 1u64, past))) { # '.'
        at <- digits_end(source, at + 2u64, past);
        real <- true;
        (byte <- lookahead(source, at, past)):void;
    } else {};
    if (byte == LOWER_E || byte == UPPER_E) { # 'e' or 'E'
        real <- true;
        at <- at + 1u64;
        byte <- lookahead(source, at, past);
        if (byte == PLUS || byte == MINUS) { # '+' or '-'
            at <- at + 1u64;
            (byte <- lookahead(source, at, past)):void;
        } else {};
        if (!digit(byte)) {
            token.kind <- missing_exponent_digits();
            token.past <- at;
            return;
        } else {};
        at <- digits_end(source, at + 1u64, past);
        (byte <- lookahead(source, at, past)):void;
    } else {};

    if (byte == LOWER_F || (!real && byte == LOWER_U)) { # 'f' or 'u'
        val width <- lookahead(source, at + 1u64, past);
        if (byte == LOWER_U && width == DIGIT_8) { # 'u8'
            (at <- at + 2u64):void;
        } else {};
        if (width == DIGIT_3 || width == DIGIT_6) { # '3' or '6'
            val tail <- lookahead(source, at + 2u64, past);
            if ((width == DIGIT_3 && tail == DIGIT_2) || (width == DIGIT_6 && tail == DIGIT_4)) {
                real <- real || byte == LOWER_F;
                (at <- at + 3u64):void;
            } else {};
        } else {};
    } else {};
    token.kind <- if (real) { real_literal() } else { integer_literal() };
    token.past <- at;
    return;
}

func triple_quote(source:const SourceBytes in S, at:UInt64, past:UInt64) -> bool where {const owner S} {
    return at <= past && past - at >= 3u64 &&
        source[at] == DOUBLE_QUOTE && source[at + 1u64] == DOUBLE_QUOTE && source[at + 2u64] == DOUBLE_QUOTE
}

func quoted_text_end(source:const SourceBytes in S, first:UInt64, past:UInt64,
                      token:Token in T) -> void where {const owner S, owner T} {
    val multiline <- triple_quote(source, first, past);
    val width <- if (multiline) { 3u64 } else { 1u64 };
    val escaped <- false;
    val byte <- 0u8;
    for (at in first + width .. past) {
        byte <- source[at];
        if (!multiline && byte == LF) {
            token.kind <- newline_in_module_path();
            token.past <- at;
            return
        };
        if (!escaped && byte == DOUBLE_QUOTE && (!multiline || triple_quote(source, at, past))) {
            token.kind <- if (multiline) { multiline_text() } else { quoted_text() };
            token.past <- at + width;
            return
        };
        escaped <- !escaped && byte == BACKSLASH
    };
    token.kind <- unterminated_module_path();
    token.past <- past;
    return
}

func symbolic_source_byte(byte:UInt8) -> bool {
    # ! $ % & * + - . / : < = > |
    return byte == EXCLAMATION || (byte >= DOLLAR && byte <= AMPERSAND) || byte == ASTERISK ||
        byte == PLUS || (byte >= MINUS && byte <= SLASH) || byte == COLON ||
        (byte >= LESS_THAN && byte <= GREATER_THAN) || byte == PIPE
}

export func operator_past(source:const SourceBytes in S, first:UInt64, past:UInt64) -> UInt64
    where {const owner S} {
    if (first >= past || past > intrinsic (len)(source) || !symbolic_source_byte(source[first]))
        return first;
    for (at in first + 1u64 .. past) {
        if (!symbolic_source_byte(source[at])) return at
    };
    return past
}

# The source is a stable bounded byte view. The caller owns its lifetime.
# After a normal token, use token.past as the next first offset.
export func scan_token(source:const SourceBytes in S, first:UInt64,
                       token:Token in T) -> void where {const owner S, owner T} {
    val past <- len(source);
    val start <- skip_trivia(source, first, past);
    token.first <- start;
    token.past <- start;
    if (start >= past) {
        token.kind <- end_of_source();
        return;
    } else {};
    val byte <- source[start];
    if (name_start(byte)) {
        token.kind <- identifier();
        token.past <- name_end(source, start + 1u64, past);
        return;
    } else {};
    if (byte == AT) { # '@'
        if (name_start(lookahead(source, start + 1u64, past))) {
            token.kind <- symbol_name();
            token.past <- name_end(source, start + 2u64, past);
        } else {
            token.kind <- missing_symbol_name();
            token.past <- start + 1u64;
        };
        return;
    } else {};
    if (digit(byte)) {
        numeral_end(source, start, past, token);
        return;
    } else {};
    if (byte == DOUBLE_QUOTE) { # '"'
        quoted_text_end(source, start, past, token);
        return;
    } else {};
    if (symbolic_source_byte(byte)) {
        val end <- operator_past(source, start, past);
        token.past <- end;
        token.kind <- punctuation();
        if (end - start == 2u64 && source[start + 1u64] == byte) {
            if (byte == SLASH) { (token.kind <- reserved_fraction_operator()):void };
            if (byte == COLON) { (token.kind <- legacy_type_separator()):void };
        };
        return;
    };
    token.kind <- if (byte == LEFT_PAREN || byte == RIGHT_PAREN || byte == LEFT_BRACKET || byte == RIGHT_BRACKET ||
        byte == LEFT_BRACE || byte == RIGHT_BRACE || byte == COMMA || byte == SEMICOLON) {
        punctuation()
    } else { unsupported_byte() };
    token.past <- start + 1u64;
    return;
}

export SourceBytes;
export Token;
