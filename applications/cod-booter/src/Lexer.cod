export func c_linkage(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return token.kind == quoted_text() && token.past - token.first == 3u64 && source[token.first + 1u64] == UPPER_C; # "C"
}

export func valid_module_path(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val escaped <- false;
    val byte <- 0u8;
    for (at in token.first + 1u64 .. token.past - 1u64) {
        byte <- source[at];
        if (escaped && byte != DOUBLE_QUOTE && byte != BACKSLASH) return false;
        escaped <- !escaped && byte == BACKSLASH;
    };
    return !escaped;
}

