using "SourceStorage.cod" { SourceBytes, Token };
using "SourceAccess.cod" len;

export func end_of_source() -> u8 { return 0u8; }
export func identifier() -> u8 { return 1u8; }
export func symbol_name() -> u8 { return 2u8; }
export func integer_literal() -> u8 { return 3u8; }
export func real_literal() -> u8 { return 4u8; }
export func module_path() -> u8 { return 5u8; }
export func punctuation() -> u8 { return 6u8; }

export func unsupported_byte() -> u8 { return 7u8; }
export func missing_symbol_name() -> u8 { return 8u8; }
export func missing_exponent_digits() -> u8 { return 9u8; }
export func unterminated_module_path() -> u8 { return 10u8; }
export func newline_in_module_path() -> u8 { return 11u8; }
export func invalid_module_path_escape() -> u8 { return 12u8; }
export func reserved_fraction_operator() -> u8 { return 13u8; }
export func legacy_type_separator() -> u8 { return 14u8; }

func identifier_width(token:const Token in T, width:u64) -> bool where {const owner T} {
    return token.kind == identifier() && token.past - token.first == width;
}

export func exception_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 9u64) &&
        source[first] == 101u8 && source[first + 1u64] == 120u8 && source[first + 2u64] == 99u8 &&
        source[first + 3u64] == 101u8 && source[first + 4u64] == 112u8 && source[first + 5u64] == 116u8 &&
        source[first + 6u64] == 105u8 && source[first + 7u64] == 111u8 && source[first + 8u64] == 110u8;
}

export func own_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 3u64) &&
        source[first] == 111u8 && source[first + 1u64] == 119u8 && source[first + 2u64] == 110u8;
}

export func make_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) &&
        source[first] == 109u8 && source[first + 1u64] == 97u8 && source[first + 2u64] == 107u8 &&
        source[first + 3u64] == 101u8;
}

export func from_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) &&
        source[first] == 102u8 && source[first + 1u64] == 114u8 && source[first + 2u64] == 111u8 &&
        source[first + 3u64] == 109u8;
}

export func region_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 6u64) &&
        source[first] == 114u8 && source[first + 1u64] == 101u8 && source[first + 2u64] == 103u8 &&
        source[first + 3u64] == 105u8 && source[first + 4u64] == 111u8 && source[first + 5u64] == 110u8;
}

export func capacity_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 8u64) &&
        source[first] == 99u8 && source[first + 1u64] == 97u8 && source[first + 2u64] == 112u8 &&
        source[first + 3u64] == 97u8 && source[first + 4u64] == 99u8 && source[first + 5u64] == 105u8 &&
        source[first + 6u64] == 116u8 && source[first + 7u64] == 121u8;
}

export func defer_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 100u8 && source[first + 1u64] == 101u8 && # d e
        source[first + 2u64] == 102u8 && source[first + 3u64] == 101u8 && # f e
        source[first + 4u64] == 114u8; # r
}

export func catch_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 99u8 && source[first + 1u64] == 97u8 && # c a
        source[first + 2u64] == 116u8 && source[first + 3u64] == 99u8 && # t c
        source[first + 4u64] == 104u8; # h
}

export func finally_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 7u64)) return false;
    val first <- token.first;
    return source[first] == 102u8 && source[first + 1u64] == 105u8 && # f i
        source[first + 2u64] == 110u8 && source[first + 3u64] == 97u8 && # n a
        source[first + 4u64] == 108u8 && source[first + 5u64] == 108u8 && # l l
        source[first + 6u64] == 121u8; # y
}

export func try_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 3u64)) return false;
    val first <- token.first;
    return source[first] == 116u8 && source[first + 1u64] == 114u8 && source[first + 2u64] == 121u8; # t r y
}

export func const_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 99u8 && source[first + 1u64] == 111u8 && # c o
        source[first + 2u64] == 110u8 && source[first + 3u64] == 115u8 && source[first + 4u64] == 116u8; # n s t
}

export func behave_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 6u64)) return false;
    val first <- token.first;
    return source[first] == 98u8 && source[first + 1u64] == 101u8 && # b e
        source[first + 2u64] == 104u8 && source[first + 3u64] == 97u8 && # h a
        source[first + 4u64] == 118u8 && source[first + 5u64] == 101u8; # v e
}

export func throw_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 116u8 && source[first + 1u64] == 104u8 && # t h
        source[first + 2u64] == 114u8 && source[first + 3u64] == 111u8 && source[first + 4u64] == 119u8; # r o w
}

export func using_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 117u8 && source[first + 1u64] == 115u8 && # u s
        source[first + 2u64] == 105u8 && source[first + 3u64] == 110u8 && # i n
        source[first + 4u64] == 103u8; # g
}

export func as_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 2u64) && source[first] == 97u8 && source[first + 1u64] == 115u8;
}

export func symbol_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 6u64)) return false;
    val first <- token.first;
    return source[first] == 115u8 && source[first + 1u64] == 121u8 && # s y
        source[first + 2u64] == 109u8 && source[first + 3u64] == 98u8 && # m b
        source[first + 4u64] == 111u8 && source[first + 5u64] == 108u8; # o l
}

export func proc_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 112u8 && source[first + 1u64] == 114u8 && # p r
        source[first + 2u64] == 111u8 && source[first + 3u64] == 99u8; # o c
}

export func func_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 102u8 && source[first + 1u64] == 117u8 && # f u
        source[first + 2u64] == 110u8 && source[first + 3u64] == 99u8; # n c
}

export func array_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 5u64) && source[first] == 97u8 && source[first + 1u64] == 114u8 &&
        source[first + 2u64] == 114u8 && source[first + 3u64] == 97u8 && source[first + 4u64] == 121u8; # a r r a y
}

export func data_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) && source[first] == 100u8 && source[first + 1u64] == 97u8 &&
        source[first + 2u64] == 116u8 && source[first + 3u64] == 97u8; # d a t a
}

func type_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) &&
        source[first] == 116u8 && source[first + 1u64] == 121u8 && source[first + 2u64] == 112u8 &&
        source[first + 3u64] == 101u8; # type
}

func unit_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) &&
        source[first] == 117u8 && source[first + 1u64] == 110u8 && source[first + 2u64] == 105u8 &&
        source[first + 3u64] == 116u8; # unit
}

func import_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 6u64) &&
        source[first] == 105u8 && source[first + 1u64] == 109u8 && source[first + 2u64] == 112u8 &&
        source[first + 3u64] == 111u8 && source[first + 4u64] == 114u8 && source[first + 5u64] == 116u8; # import
}

func mixin_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 5u64) &&
        source[first] == 109u8 && source[first + 1u64] == 105u8 && source[first + 2u64] == 120u8 &&
        source[first + 3u64] == 105u8 && source[first + 4u64] == 110u8; # mixin
}

func conversion_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 10u64) &&
        source[first] == 99u8 && source[first + 1u64] == 111u8 && source[first + 2u64] == 110u8 &&
        source[first + 3u64] == 118u8 && source[first + 4u64] == 101u8 && source[first + 5u64] == 114u8 &&
        source[first + 6u64] == 115u8 && source[first + 7u64] == 105u8 && source[first + 8u64] == 111u8 &&
        source[first + 9u64] == 110u8; # conversion
}

export func rethrow_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 7u64) &&
        source[first] == 114u8 && source[first + 1u64] == 101u8 && source[first + 2u64] == 116u8 &&
        source[first + 3u64] == 104u8 && source[first + 4u64] == 114u8 && source[first + 5u64] == 111u8 &&
        source[first + 6u64] == 119u8; # rethrow
}

func module_only_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return using_word(source, token) || import_word(source, token) || mixin_word(source, token) ||
        export_word(source, token) || conversion_word(source, token);
}

func touch_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 5u64) &&
        source[first] == 116u8 && source[first + 1u64] == 111u8 && source[first + 2u64] == 117u8 &&
        source[first + 3u64] == 99u8 && source[first + 4u64] == 104u8; # touch
}

export func intrinsic_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 9u64) &&
        source[first] == 105u8 && source[first + 1u64] == 110u8 && source[first + 2u64] == 116u8 &&
        source[first + 3u64] == 114u8 && source[first + 4u64] == 105u8 && source[first + 5u64] == 110u8 &&
        source[first + 6u64] == 115u8 && source[first + 7u64] == 105u8 && source[first + 8u64] == 99u8;
}

export func len_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 3u64) &&
        source[first] == 108u8 && source[first + 1u64] == 101u8 && source[first + 2u64] == 110u8;
}

export func reserved_value_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return module_only_name(source, token) || touch_word(source, token) || intrinsic_word(source, token) ||
        true_word(source, token) || false_word(source, token) || null_word(source, token) || not_word(source, token) ||
        func_word(source, token) || proc_word(source, token) || ref_word(source, token) || ptr_word(source, token) ||
        val_word(source, token) || const_word(source, token) || make_word(source, token) || return_word(source, token) ||
        throw_word(source, token) || try_word(source, token) || catch_word(source, token) || finally_word(source, token) ||
        defer_word(source, token) || if_word(source, token) || for_word(source, token) || behave_word(source, token);
}

export func reserved_lexical_binder(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (reserved_value_name(source, token) || void_word(source, token) || typeof_word(source, token) ||
        region_word(source, token) || symbol_word(source, token)) return true;
    if (token.kind != identifier()) return false;
    val at <- token.first;
    val width <- token.past - at;
    if (width == 2u64) {
        return (source[at] == 105u8 && source[at + 1u64] == 115u8) || # is
            (source[at] == 117u8 && source[at + 1u64] == 56u8); # u8
    } else {};
    if (width == 3u64) {
        val first <- source[at];
        val middle <- source[at + 1u64];
        val last <- source[at + 2u64];
        return (first == 118u8 && middle == 97u8 && last == 114u8) || # var
            ((first == 105u8 || first == 117u8 || first == 102u8) && middle == 54u8 && last == 52u8) || # i64 u64 f64
            ((first == 117u8 || first == 102u8) && middle == 51u8 && last == 50u8); # u32 f32
    } else {};
    if (width == 4u64) { # bool
        return source[at] == 98u8 && source[at + 1u64] == 111u8 &&
            source[at + 2u64] == 111u8 && source[at + 3u64] == 108u8;
    } else {};
    if (width == 5u64) { # deref
        return source[at] == 100u8 && source[at + 1u64] == 101u8 && source[at + 2u64] == 114u8 &&
            source[at + 3u64] == 101u8 && source[at + 4u64] == 102u8;
    } else {};
    if (width == 6u64)
        return (source[at] == 101u8 && source[at + 1u64] == 102u8 && source[at + 2u64] == 102u8 && # effect
            source[at + 3u64] == 101u8 && source[at + 4u64] == 99u8 && source[at + 5u64] == 116u8) ||
            (source[at] == 103u8 && source[at + 1u64] == 108u8 && source[at + 2u64] == 111u8 && # global
            source[at + 3u64] == 98u8 && source[at + 4u64] == 97u8 && source[at + 5u64] == 108u8) ||
            (source[at] == 115u8 && source[at + 1u64] == 99u8 && source[at + 2u64] == 97u8 && # scalar
            source[at + 3u64] == 108u8 && source[at + 4u64] == 97u8 && source[at + 5u64] == 114u8);
    if (width == 7u64) { # perform
        return source[at] == 112u8 && source[at + 1u64] == 101u8 && source[at + 2u64] == 114u8 &&
            source[at + 3u64] == 102u8 && source[at + 4u64] == 111u8 && source[at + 5u64] == 114u8 &&
            source[at + 6u64] == 109u8;
    } else {};
    if (width == 8u64) { # function
        return source[at] == 102u8 && source[at + 1u64] == 117u8 && source[at + 2u64] == 110u8 &&
            source[at + 3u64] == 99u8 && source[at + 4u64] == 116u8 && source[at + 5u64] == 105u8 &&
            source[at + 6u64] == 111u8 && source[at + 7u64] == 110u8;
    } else {};
    if (width == 9u64)
        return (source[at] == 112u8 && source[at + 1u64] == 114u8 && source[at + 2u64] == 111u8 && # procedure
            source[at + 3u64] == 99u8 && source[at + 4u64] == 101u8 && source[at + 5u64] == 100u8 &&
            source[at + 6u64] == 117u8 && source[at + 7u64] == 114u8 && source[at + 8u64] == 101u8);
    return false;
}

export func reserved_module_name(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return reserved_value_name(source, token) || data_word(source, token) || type_word(source, token) ||
        unit_word(source, token) || array_word(source, token);
}

export func export_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 6u64) && source[first] == 101u8 && source[first + 1u64] == 120u8 &&
        source[first + 2u64] == 112u8 && source[first + 3u64] == 111u8 &&
        source[first + 4u64] == 114u8 && source[first + 5u64] == 116u8; # e x p o r t
}

export func handle_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 6u64) && source[first] == 104u8 && source[first + 1u64] == 97u8 &&
        source[first + 2u64] == 110u8 && source[first + 3u64] == 100u8 &&
        source[first + 4u64] == 108u8 && source[first + 5u64] == 101u8; # h a n d l e
}

export func here_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 4u64) && source[first] == 104u8 && source[first + 1u64] == 101u8 &&
        source[first + 2u64] == 114u8 && source[first + 3u64] == 101u8; # h e r e
}

export func c_linkage(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return token.kind == module_path() && token.past - token.first == 3u64 && source[token.first + 1u64] == 67u8; # "C"
}

export func if_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return identifier_width(token, 2u64) && source[token.first] == 105u8 && source[token.first + 1u64] == 102u8;
}

export func for_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 3u64) &&
        source[first] == 102u8 && source[first + 1u64] == 111u8 && source[first + 2u64] == 114u8;
}

export func continue_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 8u64) &&
        source[first] == 99u8 && source[first + 1u64] == 111u8 && source[first + 2u64] == 110u8 &&
        source[first + 3u64] == 116u8 && source[first + 4u64] == 105u8 && source[first + 5u64] == 110u8 &&
        source[first + 6u64] == 117u8 && source[first + 7u64] == 101u8;
}

export func break_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    val first <- token.first;
    return identifier_width(token, 5u64) &&
        source[first] == 98u8 && source[first + 1u64] == 114u8 && source[first + 2u64] == 101u8 &&
        source[first + 3u64] == 97u8 && source[first + 4u64] == 107u8;
}

export func else_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 101u8 && source[first + 1u64] == 108u8 && source[first + 2u64] == 115u8 && source[first + 3u64] == 101u8;
}

export func true_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 116u8 && source[first + 1u64] == 114u8 && source[first + 2u64] == 117u8 && source[first + 3u64] == 101u8;
}

export func false_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 102u8 && source[first + 1u64] == 97u8 && source[first + 2u64] == 108u8 &&
        source[first + 3u64] == 115u8 && source[first + 4u64] == 101u8;
}

export func not_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 3u64)) return false;
    val first <- token.first;
    return source[first] == 110u8 && source[first + 1u64] == 111u8 && source[first + 2u64] == 116u8; # n o t
}

export func void_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 118u8 && source[first + 1u64] == 111u8 && # v o
        source[first + 2u64] == 105u8 && source[first + 3u64] == 100u8; # i d
}

export func typeof_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 6u64)) return false;
    val first <- token.first;
    return source[first] == 116u8 && source[first + 1u64] == 121u8 && source[first + 2u64] == 112u8 &&
        source[first + 3u64] == 101u8 && source[first + 4u64] == 111u8 && source[first + 5u64] == 102u8; # typeof
}

export func in_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 2u64)) return false;
    val first <- token.first;
    return source[first] == 105u8 && source[first + 1u64] == 110u8; # i n
}

export func owner_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 111u8 && source[first + 1u64] == 119u8 && # o w
        source[first + 2u64] == 110u8 && source[first + 3u64] == 101u8 && # n e
        source[first + 4u64] == 114u8; # r
}

export func where_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 5u64)) return false;
    val first <- token.first;
    return source[first] == 119u8 && source[first + 1u64] == 104u8 && # w h
        source[first + 2u64] == 101u8 && source[first + 3u64] == 114u8 && # e r
        source[first + 4u64] == 101u8; # e
}

export func throws_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 6u64)) return false;
    val first <- token.first;
    return source[first] == 116u8 && source[first + 1u64] == 104u8 && # t h
        source[first + 2u64] == 114u8 && source[first + 3u64] == 111u8 && # r o
        source[first + 4u64] == 119u8 && source[first + 5u64] == 115u8; # w s
}

export func ptr_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 3u64)) return false;
    val first <- token.first;
    return source[first] == 112u8 && source[first + 1u64] == 116u8 && source[first + 2u64] == 114u8; # p t r
}

export func ref_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 3u64)) return false;
    val first <- token.first;
    return source[first] == 114u8 && source[first + 1u64] == 101u8 && source[first + 2u64] == 102u8; # r e f
}

export func val_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 3u64)) return false;
    val first <- token.first;
    return source[first] == 118u8 && source[first + 1u64] == 97u8 && source[first + 2u64] == 108u8; # v a l
}

export func null_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 4u64)) return false;
    val first <- token.first;
    return source[first] == 110u8 && source[first + 1u64] == 117u8 && # n u
        source[first + 2u64] == 108u8 && source[first + 3u64] == 108u8; # l l
}

export func return_word(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    if (!identifier_width(token, 6u64)) return false;
    val first <- token.first;
    return source[first] == 114u8 && source[first + 1u64] == 101u8 && # r e
        source[first + 2u64] == 116u8 && source[first + 3u64] == 117u8 && # t u
        source[first + 4u64] == 114u8 && source[first + 5u64] == 110u8; # r n
}

func digit(byte:u8) -> bool {
    # ASCII '0' to '9'.
    return byte >= 48u8 && byte <= 57u8;
}

func name_start(byte:u8) -> bool {
    # ASCII letters and underscore.
    return (byte >= 65u8 && byte <= 90u8) ||
        (byte >= 97u8 && byte <= 122u8) || byte == 95u8;
}

func whitespace(byte:u8) -> bool {
    return byte == 32u8 || (byte >= 9u8 && byte <= 13u8);
}

func skip_trivia(source:const SourceBytes in S, first:u64, past:u64) -> u64 where {const owner S} {
    val comment <- false;
    val byte <- 0u8;
    for (at in first .. past) {
        byte <- source[at];
        # A newline ends a comment. '#' starts one anywhere outside a path.
        comment <- byte != 10u8 && (comment || byte == 35u8);
        if (!comment && !whitespace(byte)) return at;
    };
    return past;
}

func name_end(source:const SourceBytes in S, first:u64, past:u64) -> u64 where {const owner S} {
    val byte <- 0u8;
    for (at in first .. past) {
        byte <- source[at];
        if (!(name_start(byte) || digit(byte))) return at;
    };
    return past;
}

func digits_end(source:const SourceBytes in S, first:u64, past:u64) -> u64 where {const owner S} {
    for (at in first .. past) {
        if (!digit(source[at])) return at;
    };
    return past;
}

# Zero is a sentinel for lookahead only. scan_token still diagnoses a zero
# byte when it is present in the input itself.
func lookahead(source:const SourceBytes in S, at:u64, past:u64) -> u8 where {const owner S} {
    if (at >= past) return 0u8;
    return source[at];
}

func numeral_end(source:const SourceBytes in S, first:u64, past:u64,
                  token:Token in T) -> void where {const owner S, owner T} {
    val at <- digits_end(source, first + 1u64, past);
    val real <- false;
    val byte <- lookahead(source, at, past);
    if (byte == 46u8 && digit(lookahead(source, at + 1u64, past))) { # '.'
        at <- digits_end(source, at + 2u64, past);
        real <- true;
        (byte <- lookahead(source, at, past)):void;
    } else {};
    if (byte == 101u8 || byte == 69u8) { # 'e' or 'E'
        real <- true;
        at <- at + 1u64;
        byte <- lookahead(source, at, past);
        if (byte == 43u8 || byte == 45u8) { # '+' or '-'
            at <- at + 1u64;
            (byte <- lookahead(source, at, past)):void;
        } else {};
        if (!digit(byte)) {
            token.kind <- missing_exponent_digits();
            token.past <- at;
            return;
        } else {};
        at <- digits_end(source, at + 1u64, past);
        (byte <- lookahead(source, at, past)):void;
    } else {};

    if (byte == 102u8 || (!real && byte == 117u8)) { # 'f' or 'u'
        val width <- lookahead(source, at + 1u64, past);
        if (byte == 117u8 && width == 56u8) { # 'u8'
            (at <- at + 2u64):void;
        } else {};
        if (width == 51u8 || width == 54u8) { # '3' or '6'
            val tail <- lookahead(source, at + 2u64, past);
            if ((width == 51u8 && tail == 50u8) || (width == 54u8 && tail == 52u8)) {
                real <- real || byte == 102u8;
                (at <- at + 3u64):void;
            } else {};
        } else {};
    } else {};
    token.kind <- if (real) { real_literal() } else { integer_literal() };
    token.past <- at;
    return;
}

func quoted_path_end(source:const SourceBytes in S, first:u64, past:u64,
                      token:Token in T) -> void where {const owner S, owner T} {
    val escaped <- false;
    val byte <- 0u8;
    for (at in first + 1u64 .. past) {
        byte <- source[at];
        if (escaped) {
            if (byte != 34u8 && byte != 92u8) { # '"' or backslash
                token.kind <- invalid_module_path_escape();
                token.past <- at + 1u64;
                return;
            } else {};
            escaped <- false;
        } else {
            if (byte == 34u8) {
                token.kind <- module_path();
                token.past <- at + 1u64;
                return;
            } else {};
            if (byte == 10u8) {
                token.kind <- newline_in_module_path();
                token.past <- at;
                return;
            } else {};
            escaped <- byte == 92u8;
        };
    };
    token.kind <- if (escaped) { invalid_module_path_escape() } else { unterminated_module_path() };
    token.past <- past;
    return;
}

func punctuation_width(first:u8, second:u8, third:u8) -> u64 {
    val less <- 60u8;
    val greater <- 62u8;
    val equals <- 61u8;
    val minus <- 45u8;
    val dot <- 46u8;
    val pipe <- 124u8;
    val ampersand <- 38u8;
    val bang <- 33u8;
    val dollar <- 36u8;
    val colon <- 58u8;

    # ...  <=>  <->
    if ((first == dot && second == dot && third == dot) ||
        (first == less && (second == equals || second == minus) && third == greater))
        return 3u64;
    # -> == != <= >= && || <- <: .. => |> <| !> <! $> <$
    if ((second == greater && (first == minus || first == equals || first == pipe ||
                               first == bang || first == dollar)) ||
        (second == equals && (first == equals || first == bang || first == less || first == greater)) ||
        (first == second && (first == dot || first == ampersand || first == pipe)) ||
        (first == less && (second == minus || second == colon || second == pipe ||
                           second == bang || second == dollar)))
        return 2u64;
    # () {} [] ; , : . + - * / % < > = !
    if (first == 40u8 || first == 41u8 || first == 123u8 || first == 125u8 ||
        first == 91u8 || first == 93u8 || first == 59u8 || first == 44u8 ||
        first == colon || first == dot || first == 43u8 || first == minus ||
        first == 42u8 || first == 47u8 || first == 37u8 ||
        first == less || first == greater || first == equals || first == bang)
        return 1u64;
    return 0u64;
}

# The source is a stable bounded byte view. The caller owns its lifetime.
# After a normal token, use token.past as the next first offset.
export func scan_token(source:const SourceBytes in S, first:u64,
                       token:Token in T) -> void where {const owner S, owner T} {
    val past <- len(source);
    val start <- skip_trivia(source, first, past);
    token.first <- start;
    token.past <- start;
    if (start >= past) {
        token.kind <- end_of_source();
        return;
    } else {};
    val byte <- source[start];
    if (name_start(byte)) {
        token.kind <- identifier();
        token.past <- name_end(source, start + 1u64, past);
        return;
    } else {};
    if (byte == 64u8) { # '@'
        if (name_start(lookahead(source, start + 1u64, past))) {
            token.kind <- symbol_name();
            token.past <- name_end(source, start + 2u64, past);
        } else {
            token.kind <- missing_symbol_name();
            token.past <- start + 1u64;
        };
        return;
    } else {};
    if (digit(byte)) {
        numeral_end(source, start, past, token);
        return;
    } else {};
    if (byte == 34u8) { # '"'
        quoted_path_end(source, start, past, token);
        return;
    } else {};
    val second_at <- start + 1u64;
    val second <- lookahead(source, second_at, past);
    if (byte == 47u8 && second == 47u8) { # '//'
        token.kind <- reserved_fraction_operator();
        token.past <- start + 2u64;
        return;
    } else {};
    if (byte == 58u8 && second == 58u8) { # '::'
        token.kind <- legacy_type_separator();
        token.past <- start + 2u64;
        return;
    } else {};
    val third <- if (second_at < past) { lookahead(source, second_at + 1u64, past) } else { 0u8 };
    val width <- punctuation_width(byte, second, third);
    token.kind <- if (width == 0u64) { unsupported_byte() } else { punctuation() };
    token.past <- start + (if (width == 0u64) { 1u64 } else { width });
    return;
}

export SourceBytes;
export Token;
