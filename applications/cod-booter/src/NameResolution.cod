export enum ModuleNameUse:u8 {
    LexicalName;
    SelectedValue;
    SelectedType;
    SelectedSymbol;
    SelectedPublication;
}

export data NameBinding {
    kind:u8;
    # A using node records the category supplied by its checked export.
    imported_kind:u8;
    module_use:ModuleNameUse;
    guarded_local:u8;
    declaration:u64;
    # Expressions record the full lexical scope that contains them.
    scope:u64;
    # Nearest try whose finalizer must run when leaving its protected group.
    finalizer:u64;
    # A scope owns this list. Each guarded declaration links to its predecessor.
    guarded_local_link:u64;
    handle_guard:u64;
}
export array NameBindings[u64]:NameBinding;

export data ProductTypeRecovery {
    maximum:u64;
    count:u64;
    incomplete:bool;
    first_diagnostic:u8;
    first_site:u64;
}

export data NameWorkSlot {
    receiver_import:ReceiverImportCheck;
    active:u64;
    module_selection:u64;
    selected_symbol:bool;
    case_schema_prepared:bool;
    enclosing_case_arm:u64;
    arm_case:u64;
    sum_loan_formals:bool;
    product_type_diagnostic:u8;
    product_type_site:u64;
    # Reaching installation at expression entry. The syntax count denotes
    # a join with no single proven installation.
    native_installation:u64;
    next:u64;
    next_method:u64;
    imported_interface:u64;
    imported_type_module:u64;
    imported_type_identity:u64;
    imported_function:u64;
    imported_owner_argument:u64;
    imported_failure:u64;
    imported_failure_module:u64;
    imported_kind:u8;
    imported_callable_kind:InterfaceCallableKind;
    imported_reception:u8;
    imported_target_readonly:u8;
    imported_owner_readonly:u8;
    imported_passes_owner:u8;
    imported_failure_checked:u8;
    enum_code:u64;
    value_module:u64;
    value_identity:u64;
    value_kind:u8;
    expects_here:u8;
}
export array NameWork[u64]:NameWorkSlot;

export data NameResolutionResult {
    diagnostic:u8;
    node:u64;
    enclosing_defer:u64;
}

data NameState {
    syntax_revision:u64;
    syntax_used:u64;
    used:u64;
    first:u64;
    module_names:u64;
    module_candidates:bool;
    runtime_floor:u64;
    transfer_binding:u64;
    transfer_resolved:bool;
    native_installation:u64;
    scope_node:u64;
    delayed:u64;
    guard:u64;
    finalizer:u64;
    loop_arm:bool;
    repeated:bool;
    here_group:bool;
    handoff:u64;
    case_target:u64;
    case_arm:u64;
    receiving_arm:u64;
    diagnostic:u8;
    failed_node:u64;
    enclosing_defer:u64;
}

export func ordinary_selection() -> u8 { return 1u8; }
export func symbolic_selection() -> u8 { return 2u8; }
export func callable_binding() -> u8 { return 3u8; }
export func formal_binding() -> u8 { return 4u8; }
export func local_binding() -> u8 { return 5u8; }
export func owner_binding() -> u8 { return 6u8; }
export func exception_binding() -> u8 { return 7u8; }
export func builtin_u64() -> u8 { return 8u8; }
export func builtin_void() -> u8 { return 9u8; }
export func lexical_owner() -> u8 { return 10u8; }
export func builtin_bool() -> u8 { return 11u8; }
export func c_handle_type() -> u8 { return 12u8; }
export func record_type() -> u8 { return 13u8; }
export func c_constructor() -> u8 { return 14u8; }
export func c_operation() -> u8 { return 15u8; }
export func c_entry() -> u8 { return 16u8; }
export func builtin_u8() -> u8 { return 17u8; }
export func builtin_u32() -> u8 { return 18u8; }
export func builtin_i64() -> u8 { return 19u8; }
export func builtin_f32() -> u8 { return 20u8; }
export func builtin_f64() -> u8 { return 21u8; }
export func array_type() -> u8 { return 22u8; }
export func loop_index() -> u8 { return 23u8; }
export func handle_binding() -> u8 { return 24u8; }
export func here_receiver_binding() -> u8 { return 25u8; }
export func enum_value() -> u8 { return 27u8; }
export func native_symbol_binding() -> u8 { return 28u8; }
export func builtin_string() -> u8 { return 29u8; }
export func builtin_c_string() -> u8 { return 30u8; }
export func reference_symbol_binding() -> u8 { return 31u8; }
export func abstract_type_binding() -> u8 { return 32u8; }
export func lexical_builder_type() -> u8 { return 33u8; }
export func record_initializer_label() -> u8 { return 36u8; }
func type_parameter_binding() -> u8 { return 34u8; }

export func text_type(kind:u8) -> bool {
    return kind == builtin_string() || kind == builtin_c_string();
}

func symbol_binding(kind:u8) -> bool {
    return kind == symbolic_selection() || kind == native_symbol_binding() || kind == reference_symbol_binding();
}

export func native_scalar(kind:u8) -> bool {
    return kind == builtin_u64() || kind == builtin_bool() || (kind >= builtin_u8() && kind <= builtin_f64());
}

export func unresolved_name() -> u8 { return 1u8; }
export func expected_symbol_binding() -> u8 { return 2u8; }
export func expected_type_binding() -> u8 { return 3u8; }
export func expected_owner_binding() -> u8 { return 4u8; }
export func duplicate_binding() -> u8 { return 5u8; }
export func unproved_module_binding() -> u8 { return 6u8; }
export func unproved_guard_binding() -> u8 { return 7u8; }
export func invalid_module_tree() -> u8 { return 8u8; }
export func name_storage_exhausted() -> u8 { return 9u8; }
export func nested_defer_in_drain() -> u8 { return 10u8; }
export func declaration_in_deferred_group() -> u8 { return 11u8; }
func dynamic_symbol_in_function() -> u8 { return 12u8; }
export func unsupported_module_declaration() -> u8 { return 13u8; }
export func unsupported_ordinary_construction() -> u8 { return 37u8; }
func unsupported_initializer_rebind() -> u8 { return 46u8; }
func unsupported_repeated_defer() -> u8 { return 47u8; }
func unsupported_repeated_construction() -> u8 { return 48u8; }
func declaration_in_loop_arm() -> u8 { return 49u8; }
func repeated_handle_acquisition() -> u8 { return 51u8; }
func declaration_in_here_group() -> u8 { return 61u8; }
func missing_here_control() -> u8 { return 62u8; }
func unsupported_here_group_storage() -> u8 { return 63u8; }
func owner_without_input() -> u8 { return 72u8; }
func owner_without_writable_input() -> u8 { return 73u8; }
func invalid_direct_string_place() -> u8 { return 107u8; }
func invalid_enum_backing() -> u8 { return 78u8; }
func invalid_enum_code() -> u8 { return 79u8; }
func invalid_enum_member_reference() -> u8 { return 80u8; }
func repeated_enum_code() -> u8 { return 81u8; }
func repeated_enum_name() -> u8 { return 82u8; }
func conflicting_enum_selection() -> u8 { return 83u8; }
func declaration_in_case_arm() -> u8 { return 90u8; }
func continue_crosses_case() -> u8 { return 91u8; }
func missing_case_arm() -> u8 { return 92u8; }
func unsupported_constructor_initializer() -> u8 { return 118u8; }
func conflicting_variadic_family() -> u8 { return 129u8 }
func unsupported_variadic_body() -> u8 { return 130u8 }
func unsupported_callable_promise() -> u8 { return 131u8 }
export func unprovided_callable_promise() -> u8 { return 132u8 }
func unsupported_handle_rebind() -> u8 { return 133u8 }
export func expected_value_binding() -> u8 { return 14u8; }
func protected_symbol_name() -> u8 { return 142u8 }

func reject_name(state:NameState in R, node:u64, diagnostic:u8) -> void where {owner R} {
    state.diagnostic <- diagnostic;
    (state.failed_node <- node):void;
}

func remember(bindings:NameBindings in B, at:u64, declaration:u64, kind:u8) -> void where {owner B} {
    bindings[at].kind <- kind;
    bindings[at].declaration <- declaration;
    bindings[at].module_use <- (LexicalName:ModuleNameUse);
    return;
}

func select_on_lexical_miss(bindings:NameBindings in B, work:const NameWork in W,
    state:const NameState in R, at:u64, role:ModuleNameUse, symbolic:bool) -> bool
    where {owner B, const owner W, const owner R} {
    if (!state.module_candidates || work[at].module_selection == no_node()) return false;
    remember(bindings, at, at, if (symbolic) { symbolic_selection() } else { ordinary_selection() });
    bindings[at].module_use <- role;
    return true
}

func admits_selected_type(kind:u8) -> bool {
    return kind == record_export() || kind == array_export() || kind == enum_export() ||
        kind == sum_export() || kind == abstract_type_export() || kind == nominal_exception_export() ||
        kind == exception_type_export() || kind == native_handle_export() || kind == lexical_builder_export() ||
        kind == builder_storage_export() || kind == lexical_result_export()
}

func project_bound_name_use(selections:const CheckedSelections in F, selected_used:u64,
    revision:u64, used:u64, work:const NameWork in W, bindings:const NameBindings in B,
    at:u64, selected:SelectedExport in E, interfaces:const ModuleInterfaces in I,
    interface_used:u64) -> u8
    where {const owner F, const owner W, const owner B, owner E, const owner I} {
    if (bindings[at].declaration != at || selected.kind != 0u8 ||
        !project_checked_resource(selections, selected_used, work[at].module_selection,
            revision, used, true, selected)) return unproved_module_binding();
    val kind <- selected.kind;
    if ((kind == symbol_export()) != (bindings[at].kind == symbolic_selection()))
        return expected_symbol_binding();
    val role <- bindings[at].module_use;
    if (role == (SelectedType:ModuleNameUse) && !admits_selected_type(kind)) return expected_type_binding();
    if (role == (SelectedValue:ModuleNameUse) && admits_selected_type(kind)) return expected_value_binding();
    if (kind == enum_export() || kind == sum_export()) {
        val header <- find_interface(interfaces, interface_used, selected.origin_module, selected.identity);
        val expected <- if (kind == enum_export()) { enum_type() } else { sum_type() };
        if (header == no_node() || interfaces[header].interface_kind != expected)
            return unproved_module_binding();
        if (kind == enum_export()) { (selected.enum_head <- header):void }
        else { (selected.sum_head <- header):void }
    };
    return 0u8
}

export func apply_module_name_uses(selections:const CheckedSelections in F, selected_used:u64,
    tree:const ParseResult in T, work:const NameWork in W, bindings:NameBindings in B,
    selected:SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:u64,
    report:NameResolutionResult in R) -> bool
    where {const owner F, const owner T, const owner W, owner B, owner E, const owner I, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_module_tree();
    if (selected_used > intrinsic (len)(selections) || tree.used > intrinsic (len)(work) ||
        tree.used > intrinsic (len)(bindings) || tree.used > intrinsic (len)(selected)) return false;
    for (at in 0u64 .. tree.used) {
        if (bindings[at].module_use != (LexicalName:ModuleNameUse)) {
            report.node <- at;
            report.diagnostic <- project_bound_name_use(selections, selected_used, tree.revision, tree.used,
                work, bindings, at, selected[at], interfaces, interface_used);
            if (report.diagnostic != 0u8) return false;
            (bindings[at].imported_kind <- selected[at].kind):void
        }
    };
    report.node <- no_node();
    report.diagnostic <- 0u8;
    return true
}

func spelling_start(nodes:const ExprNodes in N, at:u64) -> u64 where {const owner N} {
    val name <- name_syntax(nodes, syntax_len(nodes), at);
    if (name == SymbolicName) return syntax_first(nodes, syntax_len(nodes), at) + 1u64;
    if (name == OrdinaryName) return syntax_first(nodes, syntax_len(nodes), at);
    val operator_at <- named_operator_at(nodes, at);
    if (operator_at != no_node()) return operator_at;
    return syntax_first(nodes, syntax_len(nodes), at);
}

func spelling_end(source:const SourceBytes in S, nodes:const ExprNodes in N, at:u64)
    -> u64 where {const owner S, const owner N} {
    val name <- name_syntax(nodes, syntax_len(nodes), at);
    if (name == OrdinaryName || name == SymbolicName) return syntax_past(nodes, syntax_len(nodes), at);
    val operator_at <- named_operator_at(nodes, at);
    if (operator_at != no_node()) return operator_past(source, operator_at,
        syntax_past(nodes, syntax_len(nodes), at));
    return syntax_past(nodes, syntax_len(nodes), at);
}

# Keep the candidate separate from name binding. Only lookup in the
# applicable lexical scope can turn it into a selected resource use.
export func project_module_selection_candidates(
    source:const SourceBytes in S, nodes:const ExprNodes in N, catalog:const SourceBytes in B,
    graph:const SourceBytes in G, graph_used:u64, selections:const CheckedSelections in F,
    selected_used:u64, tree:const ParseResult in T, work:NameWork in W)
    -> bool where {const owner S, const owner N, const owner B, const owner G, const owner F,
                   const owner T, owner W} {
    if (tree.used > syntax_len(nodes) || tree.used > intrinsic (len)(work) ||
        selected_used > intrinsic (len)(selections) || graph_used > intrinsic (len)(graph))
        return false;
    val first <- 0u64;
    val past <- 0u64;
    val candidate <- no_node();
    val kind <- 0u8;
    for (at in 0u64 .. tree.used) {
        work[at].module_selection <- no_node();
        work[at].selected_symbol <- false;
        if (name_syntax(nodes, tree.used, at) != NotAName || named_operator_at(nodes, at) != no_node()) {
            first <- spelling_start(nodes, at);
            past <- spelling_end(source, nodes, at);
            if (first >= past || past > intrinsic (len)(source)) return false;
            candidate <- find_selected_name(selections, selected_used, tree.revision,
                source, catalog, graph, graph_used, first, past);
            if (candidate != no_node()) {
                kind <- checked_lexical_selection_kind(selections, selected_used, candidate, tree.revision, tree.used);
                if (kind == 0u8) return false;
                work[at].module_selection <- candidate;
                (work[at].selected_symbol <- kind == symbol_export()):void
            }
        }
    };
    return true
}

func same_name(source:const SourceBytes in S, nodes:const ExprNodes in N, left:u64, right:u64) -> bool
    where {const owner S, const owner N} {
    return same_bytes(source, spelling_start(nodes, left), spelling_end(source, nodes, left),
                      source, spelling_start(nodes, right), spelling_end(source, nodes, right));
}

func lookup(source:const SourceBytes in S, nodes:const ExprNodes in N, work:const NameWork in W,
            name:u64, first:u64, past:u64) -> u64 where {const owner S, const owner N, const owner W} {
    val candidate <- no_node();
    for (offset in 0u64 .. past - first) {
        candidate <- work[past - offset - 1u64].active;
        if (same_name(source, nodes, name, candidate)) return candidate;
    };
    return no_node();
}

func declare_name(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                   work:NameWork in W, state:NameState in R, name:u64, declaration:u64, kind:u8,
                   duplicate:u8) -> void where {const owner S, const owner N, owner B, owner W, owner R} {
    val bound <- lookup(source, nodes, work, name, state.first, state.used);
    val introducing_symbol <- symbol_binding(kind);
    if (bound != no_node()) {
        reject_name(state, name, if (introducing_symbol != symbol_binding(bindings[bound].kind)) {
            protected_symbol_name()
        } else { duplicate });
        return
    };
    if (!introducing_symbol && work[name].selected_symbol) {
        reject_name(state, name, protected_symbol_name());
        return
    };
    if (!introducing_symbol && state.first != 0u64) {
        val module_name <- lookup(source, nodes, work, name, 0u64, state.module_names);
        if (module_name != no_node() && symbol_binding(bindings[module_name].kind)) {
            reject_name(state, name, protected_symbol_name());
            return
        }
    };
    remember(bindings, name, declaration, kind);
    work[state.used].active <- name;
    (state.used <- state.used + 1u64):void;
}

func declare_module_name(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B, work:NameWork in W, state:NameState in R,
    name:u64, declaration:u64, kind:u8) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.module_candidates && work[name].module_selection != no_node()) {
        reject_name(state, name, if (work[name].selected_symbol) { protected_symbol_name() }
            else { unproved_module_binding() });
        return
    };
    declare_name(source, nodes, bindings, work, state, name, declaration, kind, duplicate_binding());
    return
}

func handle_available(nodes:const ExprNodes in N, bindings:const NameBindings in B,
                      declaration:u64, use:u64) -> bool where {const owner N, const owner B} {
    val guard <- bindings[declaration].handle_guard;
    return guard == no_node() || (syntax_first(nodes, syntax_len(nodes), guard) <= syntax_first(nodes, syntax_len(nodes), use) && syntax_past(nodes, syntax_len(nodes), use) <= syntax_past(nodes, syntax_len(nodes), guard));
}

# A lexical function can use its own declarations and the module namespace.
# Looking up the nearest declaration first still rejects a hidden runtime name.
func visible_runtime_name(source:const SourceBytes in S, nodes:const ExprNodes in N, work:const NameWork in W,
                          state:const NameState in R, name:u64, found:u64) -> bool
    where {const owner S, const owner N, const owner W, const owner R} {
    if (state.runtime_floor == 0u64) return true;
    if (lookup(source, nodes, work, name, state.runtime_floor, state.used) != no_node()) return true;
    return lookup(source, nodes, work, name, 0u64, state.module_names) == found;
}

func resolve_value(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                    work:const NameWork in W, state:NameState in R, name:u64, symbolic:bool) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node()) {
        if (select_on_lexical_miss(bindings, work, state, name,
            if (symbolic) { (SelectedSymbol:ModuleNameUse) } else { (SelectedValue:ModuleNameUse) }, symbolic)) {
            if (symbolic && is_function(nodes, enclosing_callable(nodes, bindings, state.scope_node)))
                { reject_name(state, name, dynamic_symbol_in_function()) };
            return
        };
        if (bindings[name].kind != enum_value()) { reject_name(state, name, unresolved_name()); } else {
            if (symbolic) { reject_name(state, name, expected_symbol_binding()); } else {};
        };
        return;
    } else {};
    if (!visible_runtime_name(source, nodes, work, state, name, found)) {
        reject_name(state, name, unresolved_name());
        return;
    };
    val kind <- bindings[found].kind;
    val declaration <- bindings[found].declaration;
    if (kind == c_handle_type() || kind == record_type() || kind == array_type() ||
        kind == enum_type() || kind == sum_type() || kind == abstract_type_binding()) {
        reject_name(state, name, expected_value_binding());
        return;
    } else {};
    if (kind == callable_binding()) {
        ref promise = make CallableSites { signature <- no_node(); body <- no_node(); function_form
            <- false; };
        if (inspect_callable(nodes, state.syntax_revision, state.syntax_used, declaration,
            promise) == ModuleCallablePromise) {
            reject_name(state, name, unprovided_callable_promise());
            return
        }
    };
    if (kind == handle_binding() && !handle_available(nodes, bindings, declaration, name)) {
        reject_name(state, name, unproved_guard_binding());
        return;
    } else {};
    if (symbolic) {
        if (!symbol_binding(kind)) { reject_name(state, name, expected_symbol_binding()); return; } else {};
        if (is_function(nodes, enclosing_callable(nodes, bindings, state.scope_node))) {
            reject_name(state, name, dynamic_symbol_in_function());
            return;
        } else {};
    } else {
        if (kind == native_symbol_binding() || kind == reference_symbol_binding()) {
            reject_name(state, name, expected_symbol_binding());
            return;
        };
    };
    remember(bindings, name, declaration, kind);
}

func resolve_owner(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                    work:const NameWork in W, state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val first <- syntax_first(nodes, syntax_len(nodes), name);
    # The explicit lexical owner 'here' denotes this full scope.
    if (syntax_past(nodes, syntax_len(nodes), name) - first == 4u64 && source[first] == 104u8 && source[first + 1u64] == 101u8 &&
        source[first + 2u64] == 114u8 && source[first + 3u64] == 101u8) {
        remember(bindings, name, state.scope_node, lexical_owner());
        return;
    } else {};
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
    if (bindings[found].kind != owner_binding()) { reject_name(state, name, expected_owner_binding()); return; } else {};
    remember(bindings, name, bindings[found].declaration, owner_binding());
}

func reject_noncallable_shadow(nodes:const ExprNodes in N, bindings:const NameBindings in B,
    work:const NameWork in W, state:NameState in R, callee:u64) -> void
    where {const owner N, const owner B, const owner W, owner R} {
    if (state.diagnostic != 0u8) return;
    val name <- ungrouped(nodes, state.syntax_revision, state.syntax_used, callee);
    if (name >= state.syntax_used || work[name].module_selection == no_node()) return;
    val kind <- bindings[name].kind;
    if (kind == loop_index() || kind == enum_value() || kind == exception_binding() || kind == handle_binding()) {
        reject_name(state, name, expected_value_binding());
        return
    };
    if (kind != formal_binding() && kind != local_binding()) return;
    val definition <- bindings[name].declaration;
    ref declared = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    val written <- no_node();
    if (kind == formal_binding()) {
        ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
        if (inspect_formal(nodes, state.syntax_revision, state.syntax_used, definition,
                           formal) != OrdinaryFormal) return;
        (written <- formal.binding):void
    } else {
        ref local = make LocalBindingSites {
            binding <- no_node(); initializer <- no_node(); mode <- ExceptionLocal; declaration_const <- false
        };
        if (!inspect_local_binding(nodes, state.syntax_revision, state.syntax_used, definition, local)) return;
        (written <- local.binding):void
    };
    if (inspect_binding(nodes, state.syntax_revision, state.syntax_used, written,
                        declared) != TypedBinding) return;
    val marker <- if (declared.target_type == no_node()) { (declared.annotation) }
                  else { (declared.target_type) };
    if (marker >= state.syntax_used) return;
    val type <- bindings[marker].kind;
    if (native_scalar(type) || text_type(type) || type == enum_type() ||
        type == record_type() || type == array_type() || type == sum_type() || type == c_handle_type()) {
        reject_name(state, name, expected_value_binding())
    }
}

func builtin_type_name(source:const SourceBytes in S, nodes:const ExprNodes in N, name:u64) -> u8
    where {const owner S, const owner N} {
    val first <- syntax_first(nodes, syntax_len(nodes), name);
    val length <- syntax_past(nodes, syntax_len(nodes), name) - first;
    if (length == 6u64 || (length == 7u64 && source[first] == 67u8)) {
        val start <- syntax_past(nodes, syntax_len(nodes), name) - 6u64;
        if (source[start] == 83u8 && source[start + 1u64] == 116u8 && source[start + 2u64] == 114u8 &&
            source[start + 3u64] == 105u8 && source[start + 4u64] == 110u8 && source[start + 5u64] == 103u8)
            return if (length == 6u64) { builtin_string() } else { builtin_c_string() };
    } else {};
    if (length == 3u64 && source[first] == 117u8 && source[first + 1u64] == 54u8 && source[first + 2u64] == 52u8)
        return builtin_u64();
    if (length == 4u64) {
        if (source[first] == 118u8 && source[first + 1u64] == 111u8 &&
            source[first + 2u64] == 105u8 && source[first + 3u64] == 100u8) return builtin_void();
        if (source[first] == 98u8 && source[first + 1u64] == 111u8 &&
            source[first + 2u64] == 111u8 && source[first + 3u64] == 108u8) return builtin_bool();
    } else {};
    if (length == 2u64 && source[first] == 117u8 && source[first + 1u64] == 56u8) return builtin_u8();
    if (length != 3u64) return 0u8;
    val initial <- source[first];
    val tens <- source[first + 1u64];
    val ones <- source[first + 2u64];
    if (tens == 51u8 && ones == 50u8) { # 32
        if (initial == 117u8) return builtin_u32();
        if (initial == 102u8) return builtin_f32();
    } else {};
    if (tens == 54u8 && ones == 52u8) { # 64
        if (initial == 105u8) return builtin_i64();
        if (initial == 102u8) return builtin_f64();
    } else {};
    return 0u8;
}

func scoped_type_parameter(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:const NameBindings in B,
                           scope:u64, name:u64, revision:u64, used:u64) -> u64
    where {const owner S, const owner N, const owner B} {
    val definition <- enclosing_callable(nodes, bindings, scope);
    if (definition == no_node()) return no_node();
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val mode <- inspect_callable(nodes, revision, used, definition, callable);
    if (mode != ModuleCallable && mode != LexicalCallable) return no_node();
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val clause <- callable.signature;
    val shape <- InvalidSignature;
    for (unused in 0u64 .. used) {
        shape <- inspect_signature(nodes, revision, used, clause, sites);
        if (shape == SignatureHead || shape == InvalidSignature || shape == OtherSignatureSyntax) return no_node();
        if (shape == TypeSignatureClause && same_name(source, nodes, name, sites.annotation)) return clause;
        clause <- sites.previous;
    };
    return no_node();
}

func resolve_type_name(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                        work:const NameWork in W, state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val parameter <- scoped_type_parameter(source, nodes, bindings, state.scope_node, name, state.syntax_revision, state.syntax_used);
    if (parameter != no_node()) {
        remember(bindings, name, parameter, type_parameter_binding());
        return;
    };
    val built_in <- builtin_type_name(source, nodes, name);
    if (built_in != 0u8) {
        remember(bindings, name, no_node(), built_in);
        return;
    } else {};
    val found <- lookup(source, nodes, work, name, 0u64, state.module_names);
    if (found == no_node()) {
        if (!select_on_lexical_miss(bindings, work, state, name, (SelectedType:ModuleNameUse), false))
            { reject_name(state, name, unresolved_name()) };
        return
    };
    val kind <- bindings[found].kind;
    if (kind != ordinary_selection() && kind != c_handle_type() && kind != record_type() && kind != array_type() &&
        kind != enum_type() && kind != sum_type() && kind != abstract_type_binding()) {
        reject_name(state, name, expected_type_binding());
        return;
    } else {};
    remember(bindings, name, bindings[found].declaration, kind);
}

func resolve_type_annotation(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                              work:const NameWork in W, state:NameState in R, annotation:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    ref sites = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!inspect_type_annotation(nodes, state.syntax_revision, state.syntax_used, annotation, sites)) {
        reject_name(state, annotation, invalid_module_tree());
        return;
    };
    resolve_type_name(source, nodes, bindings, work, state, sites.target_type);
    if (state.diagnostic == 0u8 && sites.owner_name != no_node()) {
        resolve_owner(source, nodes, bindings, work, state, sites.owner_name);
    };
}

func resolve_annotation(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:const NameWork in W, state:NameState in R, binding:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    ref sites = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val shape <- inspect_binding(nodes, state.syntax_revision, state.syntax_used, binding, sites);
    if (shape == InvalidBindingSyntax) { reject_name(state, binding, invalid_module_tree()); return; };
    if (shape == TypedBinding) {
        resolve_type_annotation(source, nodes, bindings, work, state, sites.annotation);
    };
}

func binder_name(nodes:const ExprNodes in N, revision:u64, used:u64, binding:u64) -> u64 where {const owner N} {
    ref sites = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, binding, sites) == InvalidBindingSyntax) return no_node();
    return sites.name;
}

func link_entries(nodes:const ExprNodes in N, work:NameWork in W, revision:u64, used:u64) -> bool
    where {const owner N, owner W} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val clause <- OtherSignatureSyntax;
    val current_kind <- OtherSequenceSyntax;
    val previous <- no_node();
    for (at in 0u64 .. used) {
        work[at].next <- no_node();
        work[at].receiver_import <- NoReceiverCallables;
        work[at].next_method <- no_node();
        work[at].case_schema_prepared <- false;
        work[at].enclosing_case_arm <- no_node();
        work[at].arm_case <- no_node();
        work[at].sum_loan_formals <- false;
        work[at].product_type_diagnostic <- 0u8;
        work[at].product_type_site <- no_node();
        work[at].imported_interface <- no_node();
        work[at].imported_type_module <- 0u64;
        work[at].imported_type_identity <- 0u64;
        work[at].imported_function <- no_node();
        work[at].imported_owner_argument <- no_node();
        work[at].imported_failure <- no_node();
        work[at].imported_failure_module <- 0u64;
        work[at].imported_kind <- 0u8;
        work[at].imported_callable_kind <- NoCallableKind;
        work[at].imported_reception <- 0u8;
        work[at].imported_target_readonly <- 0u8;
        work[at].imported_owner_readonly <- 0u8;
        work[at].imported_passes_owner <- 0u8;
        work[at].imported_failure_checked <- 0u8;
        current_kind <- inspect_sequence_entry(nodes, revision, used, at, entry);
        if (current_kind == InvalidSequence) return false;
        if (current_kind != OtherSequenceSyntax && entry.previous != no_node()) {
            previous <- entry.previous;
            if (inspect_sequence_entry(nodes, revision, used, previous, entry) != current_kind ||
                work[previous].next != no_node()) return false;
            (work[previous].next <- at):void;
        };
        clause <- inspect_signature(nodes, revision, used, at, signature);
        if (clause == InvalidSignature) return false;
        if (clause != OtherSignatureSyntax && clause != SignatureHead && signature.previous != no_node()) {
            previous <- signature.previous;
            clause <- inspect_signature(nodes, revision, used, previous, signature);
            if (clause == InvalidSignature || clause == OtherSignatureSyntax || work[previous].next != no_node()) return false;
            (work[previous].next <- at):void;
        };
    };
    return true;
}

export func find_record_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
                              work:const NameWork in W, record:u64, name:u64, revision:u64, used:u64) -> u64
    where {const owner S, const owner N, const owner W} {
    ref ordinal = make u64 { no_node() };
    return locate_record_field(source, nodes, work, record, name, revision, used, ordinal)
}

export func locate_record_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    work:const NameWork in W, record:u64, name:u64, revision:u64, used:u64, ordinal:u64 in O)
    -> u64 where {const owner S, const owner N, const owner W, owner O} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, record, declaration);
    if (shape != NominalRecord && shape != NativeRecord) return no_node();
    return locate_named_field(source, nodes, work, declaration.entries, name, revision, used, ordinal)
}

export func find_named_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    work:const NameWork in W, tail:u64, name:u64, revision:u64, used:u64)
    -> u64 where {const owner S, const owner N, const owner W} {
    ref ordinal = make u64 { no_node() };
    return locate_named_field(source, nodes, work, tail, name, revision, used, ordinal)
}

func locate_named_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    work:const NameWork in W, tail:u64, name:u64, revision:u64, used:u64, ordinal:u64 in O)
    -> u64 where {const owner S, const owner N, const owner W, owner O} {
    ref field = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, field)) return no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    for (index in 0u64 .. used) {
        if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding) return no_node();
        if (same_name(source, nodes, name, binding.name)) {
            ordinal <- index;
            return field
        };
        field <- work[field].next;
    };
    return no_node();
}

export func enclosing_callable(nodes:const ExprNodes in N, names:const NameBindings in B, scope:u64) -> u64
    where {const owner N, const owner B} {
    if (scope == no_node()) return scope;
    val site <- scope;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (site == no_node() || !is_scope_block(nodes, site)) return site;
        site <- names[site].scope;
    };
    return no_node();
}

# Lists link forward in the temporary workspace. Traversing a wide block or
# parameter list does not recurse through its preceding siblings.
func resolve_list(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                   work:NameWork in W, state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (tail == no_node()) return;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val kind <- inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, entry);
    ref item = make u64 { no_node() };
    if ((kind != BlockSequence && kind != ArgumentSequence) ||
        !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, kind, item)) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != kind) {
            reject_name(state, tail, invalid_module_tree());
            return;
        };
        bindings[item].scope <- state.scope_node;
        resolve_expression(source, nodes, bindings, work, state, entry.item);
        if (state.diagnostic != 0u8 || item == tail) return;
        item <- work[item].next;
    };
    reject_name(state, tail, invalid_module_tree());
}

func resolve_expression_links(source:const SourceBytes in S, nodes:const ExprNodes in N,
                              bindings:NameBindings in B, work:NameWork in W, state:NameState in R,
                              items:const NodeLink in I, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner I} {
    case items of {
        (NoLink) -> {};
        (LinkTo { val tail <- node; }) -> {
            if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, tail)) {
                reject_name(state, at, invalid_module_tree());
                return;
            };
            resolve_list(source, nodes, bindings, work, state, tail.index);
        };
    };
}

func resolve_full_scope(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                        work:NameWork in W, state:NameState in R, scope:u64, first_local:u64, attached_arm:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val used <- state.used;
    val first <- state.first;
    val scope_node <- state.scope_node;
    val guard <- state.guard;
    val delayed <- state.delayed;
    val loop_arm <- state.loop_arm;
    val repeated <- state.repeated;
    val here_group <- state.here_group;
    val handoff <- state.handoff;
    val case_target <- state.case_target;
    val case_arm <- state.case_arm;
    val native_installation <- state.native_installation;
    state.first <- first_local;
    state.scope_node <- scope;
    state.guard <- no_node();
    state.delayed <- no_node();
    state.loop_arm <- false;
    state.repeated <- false;
    state.here_group <- false;
    state.handoff <- no_node();
    state.case_target <- no_node();
    state.case_arm <- attached_arm;
    ref tail = make u64 { no_node() };
    if (block_tail(nodes, state.syntax_revision, state.syntax_used, scope, tail)) {
        resolve_list(source, nodes, bindings, work, state, tail);
    } else { reject_name(state, scope, invalid_module_tree()); };
    state.used <- used;
    state.first <- first;
    state.scope_node <- scope_node;
    state.delayed <- delayed;
    state.loop_arm <- loop_arm;
    state.repeated <- repeated;
    state.here_group <- here_group;
    state.handoff <- handoff;
    state.case_target <- case_target;
    state.case_arm <- case_arm;
    state.native_installation <- native_installation;
    (state.guard <- guard):void;
}

func join_native_installation(state:NameState in R, incoming:u64) -> void where {owner R} {
    if (state.native_installation != incoming) {
        (state.native_installation <- state.syntax_used):void
    }
}

func resolve_handler(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     work:NameWork in W, state:NameState in R, handler:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref action = make HandlerSites { binding <- no_node(); body <- no_node(); };
    ref binding = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    if (!inspect_handler(nodes, state.syntax_revision, state.syntax_used, handler, action) ||
        !inspect_catch_binding(nodes, state.syntax_revision, state.syntax_used, action.binding, binding)) {
        reject_name(state, handler, invalid_module_tree());
        return;
    };
    state.guard <- action.body;
    if (binding.annotation != no_node()) {
        resolve_type_name(source, nodes, bindings, work, state, binding.annotation);
        if (state.diagnostic != 0u8) return;
    };
    val used <- state.used;
    val first <- state.first;
    state.first <- used;
    declare_name(source, nodes, bindings, work, state, binding.name, action.binding, exception_binding(), duplicate_binding());
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, action.body);
    };
    state.used <- used;
    (state.first <- first):void;
}

func resolve_handler_with_installation_join(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                          bindings:NameBindings in B, work:NameWork in W,
                                          state:NameState in R, handler:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val incoming <- state.native_installation;
    resolve_handler(source, nodes, bindings, work, state, handler);
    join_native_installation(state, incoming)
}

func resolve_clauses(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     work:NameWork in W, state:NameState in R, tail:u64, enclosing_finalizer:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref clause = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, ClauseSequence, clause)) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    ref sites = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    val shape <- InvalidGuardClause;
    for (unused in 0u64 .. state.syntax_used) {
        if (clause == no_node()) return;
        shape <- inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, clause, sites);
        if (shape == HandlerClause) {
            resolve_handler_with_installation_join(source, nodes, bindings, work, state, sites.target);
        } else {
            if (shape != CleanupClause) { reject_name(state, clause, invalid_module_tree()); return; };
            state.guard <- sites.target;
            state.finalizer <- enclosing_finalizer;
            resolve_expression(source, nodes, bindings, work, state, sites.target);
        };
        if (state.diagnostic != 0u8 || clause == tail) return;
        clause <- work[clause].next;
    };
}

func resolve_try(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                 work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref group = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref last = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    if (!inspect_protected(nodes, state.syntax_revision, state.syntax_used, at, group)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    val shape <- inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, group.clauses, last);
    if (shape == InvalidGuardClause) { reject_name(state, at, invalid_module_tree()); return; };
    val guard <- state.guard;
    val enclosing_finalizer <- state.finalizer;
    val native_installation <- state.native_installation;
    state.guard <- group.body;
    if (shape == CleanupClause) { (state.finalizer <- at):void; };
    resolve_expression(source, nodes, bindings, work, state, group.body);
    join_native_installation(state, native_installation);
    if (state.diagnostic == 0u8) {
        resolve_clauses(source, nodes, bindings, work, state, group.clauses, enclosing_finalizer);
    };
    state.guard <- guard;
    (state.finalizer <- enclosing_finalizer):void;
}

func local_declaration_allowed(nodes:const ExprNodes in N, state:NameState in R, at:u64) -> bool where {const owner N, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return false;
    } else {};
    if (state.loop_arm) { reject_name(state, at, declaration_in_loop_arm()); return false; } else {};
    if (state.here_group) { reject_name(state, at, declaration_in_here_group()); return false; } else {};
    if (state.case_arm != no_node()) {
        ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
        if (!inspect_case_arm(nodes, state.syntax_revision, state.syntax_used, state.case_arm, arm)) {
            reject_name(state, state.case_arm, invalid_module_tree());
            return false;
        };
        if (!is_scope_block(nodes, arm.body)) {
            ref tail = make u64 { no_node() };
            if (block_tail(nodes, state.syntax_revision, state.syntax_used, arm.body, tail)) {
                reject_name(state, at, declaration_in_case_arm());
                return false;
            };
        };
    };
    return true;
}

func resolve_local(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                   work:NameWork in W, state:NameState in R, at:u64, binding:const NodeId in BIND,
                   initializer:const NodeId in INIT) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner BIND, const owner INIT} {
    if (!local_declaration_allowed(nodes, state, at)) return;
    if (!published_syntax_id(nodes, state.syntax_revision, at, binding) ||
        !published_syntax_id(nodes, state.syntax_revision, at, initializer)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_annotation(source, nodes, bindings, work, state, binding.index);
    if (state.diagnostic != 0u8) return;
    resolve_expression(source, nodes, bindings, work, state, initializer.index);
    if (state.diagnostic != 0u8) return;
    declare_name(source, nodes, bindings, work, state, binder_name(nodes, state.syntax_revision, state.syntax_used, binding.index), at, local_binding(), duplicate_binding());
    if (state.diagnostic == 0u8 && state.guard != no_node()) {
        val scope <- state.scope_node;
        bindings[at].guarded_local <- 1u8;
        bindings[at].guarded_local_link <- bindings[scope].guarded_local_link;
        (bindings[scope].guarded_local_link <- at):void;
    } else {};
}

func resolve_handle_owner(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:const NameWork in W, state:NameState in R, name:u64, lexical:bool) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node() || !visible_runtime_name(source, nodes, work, state, name, found)) {
        reject_name(state, name, unresolved_name());
        return;
    };
    val declaration <- bindings[found].declaration;
    val kind <- bindings[found].kind;
    if (kind == handle_binding() && !handle_available(nodes, bindings, declaration, name)) {
        reject_name(state, name, unproved_guard_binding());
        return;
    } else {};
    ref handle_site = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false; };
    if ((kind == handle_binding() &&
        inspect_handle_binding(nodes, state.syntax_revision, state.syntax_used, declaration, handle_site) == OwnHandleBinding) ||
        (!lexical && kind == owner_binding())) {
        remember(bindings, name, declaration, kind);
    } else { reject_name(state, name, expected_owner_binding()); };
}

func resolve_handle_local(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (!local_declaration_allowed(nodes, state, at)) return;
    ref handle_site = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false; };
    val mode <- inspect_handle_binding(nodes, state.syntax_revision, state.syntax_used, at, handle_site);
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if ((mode != OwnHandleBinding && mode != BorrowHandleBinding) ||
        inspect_binding(nodes, state.syntax_revision, state.syntax_used, handle_site.binding, binding) != TypedBinding) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_type_name(source, nodes, bindings, work, state, binding.target_type);
    if (state.diagnostic != 0u8) return;
    if (binding.owner_name != no_node()) {
        resolve_handle_owner(source, nodes, bindings, work, state, binding.owner_name, false);
        if (state.diagnostic != 0u8) return;
    };
    resolve_expression(source, nodes, bindings, work, state, handle_site.initializer);
    if (state.diagnostic != 0u8) return;
    declare_name(source, nodes, bindings, work, state, binding.name, at, handle_binding(), duplicate_binding());
    # A use within the same guard follows its successful binding. A sibling
    # or joined path needs a proof beyond source containment.
    if (state.diagnostic == 0u8) { (bindings[at].handle_guard <- state.guard):void; } else {};
}

func resolve_handle_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                                 work:NameWork in W, state:NameState in R, at:u64, installs_effect:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated && !installs_effect) { reject_name(state, at, repeated_handle_acquisition()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    ref constructor = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    val mode <- inspect_handle_construction(nodes, state.syntax_revision, state.syntax_used, at, constructor);
    if (mode != OwnHandleMake && mode != BorrowHandleMake) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_type_name(source, nodes, bindings, work, state, constructor.marker);
    if (state.diagnostic != 0u8) return;
    if (mode == BorrowHandleMake) {
        resolve_handle_owner(source, nodes, bindings, work, state, constructor.actual_owner, true);
        if (state.diagnostic != 0u8) return;
    };
    resolve_list(source, nodes, bindings, work, state, constructor.arguments);
}

func resolve_effect_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                                work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    bindings[at].scope <- state.scope_node;
    bindings[at].finalizer <- state.finalizer;
    ref inner = make u64 { no_node() };
    val shape <- inspect_group(nodes, state.syntax_revision, state.syntax_used, at, inner);
    if (shape == InvalidGroup) { reject_name(state, at, invalid_module_tree()); return; };
    if (shape == ParenthesizedExpression) {
        resolve_effect_initializer(source, nodes, bindings, work, state, inner);
        return;
    };
    ref constructor = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    if (inspect_handle_construction(nodes, state.syntax_revision, state.syntax_used, at, constructor) == OwnHandleMake) {
        resolve_handle_construction(source, nodes, bindings, work, state, at, true);
        return;
    };
    resolve_expression(source, nodes, bindings, work, state, at);
}

func resolve_defer(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                   work:NameWork in W, state:NameState in R, at:u64, action:const NodeId in I, block:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner I} {
    if (state.delayed != no_node()) {
        reject_name(state, at, nested_defer_in_drain());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated) { reject_name(state, at, unsupported_repeated_defer()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    val case_target <- state.case_target;
    val case_arm <- state.case_arm;
    val native_installation <- state.native_installation;
    state.native_installation <- state.syntax_used;
    if (block) {
        state.delayed <- at;
        state.case_target <- no_node();
        (state.case_arm <- no_node()):void;
    } else {};
    resolve_child_expression(source, nodes, bindings, work, state, at, action);
    state.native_installation <- if (block) { native_installation } else { (state.syntax_used) };
    state.delayed <- no_node();
    state.case_target <- case_target;
    state.case_arm <- case_arm;
    return;
}

func resolve_transfer_family(source:const SourceBytes in S, nodes:const ExprNodes in N,
                             bindings:NameBindings in B, work:const NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    if (!state.transfer_resolved) {
        state.transfer_binding <- lookup(source, nodes, work, at, 0u64, state.module_names);
        (state.transfer_resolved <- true):void;
    };
    val found <- state.transfer_binding;
    if (found == no_node()) {
        select_on_lexical_miss(bindings, work, state, at, (SelectedValue:ModuleNameUse), false);
        return
    };
    remember(bindings, at, bindings[found].declaration, bindings[found].kind);
}

func resolve_record_fields(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B,
                            work:NameWork in W, state:NameState in R, at:u64, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, at, tail, BlockSequence, item)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val field <- no_node();
    val mode <- FieldTransfer;
    val target <- no_node();
    for (unused in 0u64 .. state.syntax_used) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != BlockSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        field <- entry.item;
        mode <- inspect_assignment(nodes, state.syntax_revision, state.syntax_used, field, assignment);
        if (mode != FieldTransfer && mode != FieldRebind) {
            reject_name(state, field, unsupported_ordinary_construction());
            return;
        };
        target <- ungrouped(nodes, state.syntax_revision, state.syntax_used, assignment.destination);
        if (name_syntax(nodes, state.syntax_used, target) != OrdinaryName) {
            reject_name(state, field, unsupported_ordinary_construction());
            return;
        };
        bindings[assignment.destination].kind <- record_initializer_label();
        bindings[field].scope <- state.scope_node;
        bindings[field].finalizer <- state.finalizer;
        if (mode == FieldTransfer) { resolve_transfer_family(source, nodes, bindings, work, state, field); };
        resolve_expression(source, nodes, bindings, work, state, assignment.input);
        if (state.diagnostic != 0u8 || item == tail) return;
        item <- work[item].next;
    };
}

func resolve_record_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B,
                                 work:NameWork in W, state:NameState in R, body:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (body == no_node()) return;
    val tail <- no_node();
    if (!block_tail(nodes, state.syntax_revision, state.syntax_used, body, tail)) {
        reject_name(state, body, invalid_module_tree());
        return;
    };
    resolve_record_fields(source, nodes, bindings, work, state, body, tail);
}

func resolve_constructing_throw(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B,
                                 work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref syntax = make NamedThrowSites { requested <- no_node(); fields <- no_node(); cause <-
        no_node(); };
    if (!inspect_named_throw(nodes, state.syntax_revision, state.syntax_used, at,
        syntax) || syntax.cause != no_node()) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_type_name(source, nodes, bindings, work, state, syntax.requested);
    if (state.diagnostic != 0u8) return;
    resolve_record_fields(source, nodes, bindings, work, state, at, syntax.fields);
}

export func has_exception_parent(nodes:const ExprNodes in N, bindings:const NameBindings in B,
                                 form:u64, revision:u64, used:u64) -> bool where {const owner N, const owner B} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, form, declaration);
    if ((shape != NominalRecord && shape != NativeRecord) || declaration.parent_type == no_node()) return false;
    val parent <- declaration.parent_type;
    return bindings[parent].kind == ordinary_selection() &&
        bindings[bindings[parent].declaration].imported_kind == exception_type_export();
}

export func lexical_builder_record(nodes:const ExprNodes in N, bindings:const NameBindings in B,
                                    form:u64, revision:u64, used:u64) -> bool where {const owner N, const owner B} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, form, declaration) != NominalRecord ||
        has_exception_parent(nodes, bindings, form, revision, used)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref field = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_sequence_entry(nodes, revision, used, declaration.entries, entry) != FormalSequence ||
        entry.previous != no_node() || inspect_formal(nodes, revision, used, declaration.entries, field) != OrdinaryFormal ||
        field.mode != ValueFormal || inspect_binding(nodes, revision, used, field.binding, binding) != TypedBinding) return false;
    val marker <- binding.target_type;
    return bindings[marker].kind == ordinary_selection() &&
        bindings[bindings[marker].declaration].imported_kind == builder_storage_export();
}

export func is_lexical_builder(nodes:const ExprNodes in N, bindings:const NameBindings in B,
                               name:u64, revision:u64, used:u64) -> bool where {const owner N, const owner B} {
    val kind <- bindings[name].kind;
    val declaration <- bindings[name].declaration;
    if (kind == record_type()) return lexical_builder_record(nodes, bindings, declaration, revision, used);
    return kind == ordinary_selection() && bindings[declaration].imported_kind == lexical_builder_export();
}

func resolve_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated) { reject_name(state, at, unsupported_repeated_construction()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, state.syntax_revision, state.syntax_used, at, construction);
    if (shape != PositionalConstruction && shape != BracedConstruction && shape != StorageReservation) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    val requested <- construction.requested;
    val record_initializer <- false;
    val text_initializer <- false;
    val builder_initializer <- false;
    if (construction.queried_operand != no_node()) {
        resolve_expression(source, nodes, bindings, work, state, construction.queried_operand);
    } else {
        resolve_type_name(source, nodes, bindings, work, state, requested);
        if (state.diagnostic != 0u8) return;
        val kind <- bindings[requested].kind;
        val definition <- bindings[requested].declaration;
        text_initializer <- kind == builtin_string();
        builder_initializer <- is_lexical_builder(nodes, bindings, requested, state.syntax_revision, state.syntax_used);
        record_initializer <- (kind == record_type() && !has_exception_parent(nodes, bindings, definition, state.syntax_revision, state.syntax_used)) ||
            (kind == ordinary_selection() && bindings[definition].imported_kind == record_export());
        if (!text_initializer && !builder_initializer && !record_initializer &&
            !native_scalar(kind) && kind != builtin_void() && kind != enum_type()) {
            reject_name(state, at, unsupported_ordinary_construction());
            return;
        } else {};
    };
    if (state.diagnostic != 0u8) return;
    val owner_name <- construction.placement;
    if (owner_name != no_node()) {
        resolve_owner(source, nodes, bindings, work, state, owner_name);
        if (state.diagnostic != 0u8) return;
    } else {};
    if (shape == PositionalConstruction || text_initializer || builder_initializer) {
        val tail <- construction.contents;
        ref first = make u64 { no_node() };
        if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, ArgumentSequence, first)) {
            reject_name(state, at, invalid_module_tree());
            return;
        };
        val valid_count <- if (builder_initializer) {
            first == no_node() || (first != tail && work[first].next == tail)
        } else { text_initializer && first != no_node() && first == tail };
        if (shape != PositionalConstruction || !valid_count) {
            reject_name(state, at, unsupported_ordinary_construction());
            return;
        } else {};
        resolve_list(source, nodes, bindings, work, state, tail);
        return;
    } else {};
    val body <- construction.contents;
    if (record_initializer) {
        resolve_record_initializer(source, nodes, bindings, work, state, body);
    } else { resolve_expression(source, nodes, bindings, work, state, body); };
}

func resolve_range(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                   work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_loop(nodes, state.syntax_revision, state.syntax_used, at, loop) ||
        !inspect_range_header(nodes, state.syntax_revision, state.syntax_used, loop.header, bounds)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    val header <- loop.header;
    bindings[header].scope <- state.scope_node;
    resolve_expression(source, nodes, bindings, work, state, bounds.lower);
    if (state.diagnostic != 0u8) return;
    resolve_expression(source, nodes, bindings, work, state, bounds.upper);
    if (state.diagnostic != 0u8) return;

    val used <- state.used;
    val first <- state.first;
    val enclosing_arm <- state.loop_arm;
    val repeated <- state.repeated;
    val native_installation <- state.native_installation;
    val handoff <- state.handoff;
    val case_target <- state.case_target;
    state.first <- used;
    state.loop_arm <- true;
    state.repeated <- true;
    state.handoff <- no_node();
    state.case_target <- no_node();
    declare_name(source, nodes, bindings, work, state, bounds.index_binding, header, loop_index(), duplicate_binding());
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, loop.body);
    } else {};
    state.used <- used;
    state.first <- first;
    state.repeated <- repeated;
    state.native_installation <- native_installation;
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, loop.empty);
    } else {};
    state.native_installation <- native_installation;
    state.handoff <- handoff;
    state.case_target <- case_target;
    (state.loop_arm <- enclosing_arm):void;
}

func resolve_here_receivers(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                            work:NameWork in W, state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref receiver = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, HereReceiverSequence, receiver)) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val shape <- InvalidBindingSyntax;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (receiver == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, receiver, entry) != HereReceiverSequence) {
            reject_name(state, receiver, invalid_module_tree());
            return;
        };
        shape <- inspect_binding(nodes, state.syntax_revision, state.syntax_used, entry.item, binding);
        if (shape == InvalidBindingSyntax) { reject_name(state, receiver, invalid_module_tree()); return; };
        if (shape == TypedBinding) {
            resolve_type_name(source, nodes, bindings, work, state, binding.target_type);
            if (state.diagnostic != 0u8) return;
            if (binding.owner_name != no_node()) {
                resolve_handle_owner(source, nodes, bindings, work, state, binding.owner_name, false);
                if (state.diagnostic != 0u8) return;
            };
        };
        declare_name(source, nodes, bindings, work, state, binding.name,
                     receiver, here_receiver_binding(), duplicate_binding());
        if (state.diagnostic != 0u8) return;
        receiver <- work[receiver].next;
    };
}

func resolve_here_call(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                       work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    if (inspect_here_invocation(nodes, state.syntax_revision, state.syntax_used, at, sites) != HereReady) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_expression(source, nodes, bindings, work, state, sites.call);
    if (state.diagnostic != 0u8) return;
    val body <- sites.body;
    val first <- state.first;
    val used <- state.used;
    val group <- state.here_group;
    val target <- state.handoff;
    val case_target <- state.case_target;
    val case_arm <- state.case_arm;
    val native_installation <- state.native_installation;
    state.native_installation <- state.syntax_used;
    state.first <- used;
    resolve_here_receivers(source, nodes, bindings, work, state, sites.receivers);
    if (state.diagnostic == 0u8) {
        if (sites.full_scope) {
            bindings[body].scope <- state.scope_node;
            resolve_full_scope(source, nodes, bindings, work, state, body, used, no_node());
        } else {
            state.here_group <- true;
            state.case_target <- no_node();
            state.case_arm <- no_node();
            state.handoff <- at;
            resolve_expression(source, nodes, bindings, work, state, body);
        };
    } else {};
    state.used <- used;
    state.first <- first;
    state.here_group <- group;
    state.case_target <- case_target;
    state.case_arm <- case_arm;
    state.native_installation <- if (sites.full_scope) { native_installation } else { (state.syntax_used) };
    (state.handoff <- target):void;
}

func resolve_case(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                  work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref choice = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, state.syntax_revision, state.syntax_used, at, choice)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    work[at].enclosing_case_arm <- state.receiving_arm;
    resolve_expression(source, nodes, bindings, work, state, choice.subject);
    if (state.diagnostic != 0u8) return;
    val handoff <- state.handoff;
    val target <- state.case_target;
    val arm <- state.case_arm;
    val guard <- state.guard;
    state.handoff <- no_node();
    state.case_target <- at;
    state.case_arm <- no_node();
    state.guard <- at;
    resolve_list(source, nodes, bindings, work, state, choice.items);
    state.handoff <- handoff;
    state.case_target <- target;
    state.case_arm <- arm;
    (state.guard <- guard):void;
}

func register_case_receivers(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B, work:NameWork in W, state:NameState in R, tail:u64)
    -> void where {const owner S, const owner N, owner B, owner W, owner R} {
    ref receipt = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail,
        CaseReceiverSequence, receipt)) {
        reject_name(state, tail, invalid_module_tree());
        return
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    for (unused in 0u64 .. state.syntax_used) {
        if (receipt == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, receipt,
            entry) != CaseReceiverSequence) {
            reject_name(state, receipt, invalid_module_tree());
            return
        };
        declare_name(source, nodes, bindings, work, state, entry.item, receipt, local_binding(),
                     duplicate_binding());
        if (state.diagnostic != 0u8) return;
        bindings[receipt].scope <- state.scope_node;
        work[receipt].enclosing_case_arm <- state.receiving_arm;
        if (receipt == tail) return;
        (receipt <- work[receipt].next):void
    };
    reject_name(state, tail, invalid_module_tree());
}

func resolve_case_arm_body(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                      work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (!inspect_case_arm(nodes, state.syntax_revision, state.syntax_used, at, arm)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    val mode <- case_pattern(nodes, state.syntax_used, arm.pattern);
    val constructor <- arm.pattern;
    if (mode == ConstructorCaseTarget) {
        ref pattern = make ConstructorCaseSites { constructor <- no_node(); receiver_tail <- no_node() };
        if (!inspect_constructor_case(nodes, state.syntax_revision, state.syntax_used, arm.pattern, pattern)) {
            reject_name(state, arm.pattern, invalid_module_tree());
            return
        };
        constructor <- pattern.constructor;
        register_case_receivers(source, nodes, bindings, work, state, pattern.receiver_tail);
        if (state.diagnostic != 0u8) return
    };
    # A constructor uses module selection. An enum member still uses only its subject's type.
    if (mode == NamedCaseMember || mode == ConstructorCaseTarget) {
        val found <- lookup(source, nodes, work, constructor, 0u64, state.module_names);
        if (found != no_node() && bindings[found].kind == constructor_type()) {
            remember(bindings, constructor, bindings[found].declaration, constructor_type())
        }
    };
    val incoming <- state.native_installation;
    resolve_expression(source, nodes, bindings, work, state, arm.guard);
    if (state.diagnostic != 0u8) return;
    val body <- arm.body;
    if (is_scope_block(nodes, body)) {
        bindings[body].scope <- state.scope_node;
        resolve_full_scope(source, nodes, bindings, work, state, body, state.used, at);
        join_native_installation(state, incoming);
        return;
    } else {};
    val enclosing <- state.case_arm;
    state.case_arm <- at;
    resolve_expression(source, nodes, bindings, work, state, body);
    join_native_installation(state, incoming);
    (state.case_arm <- enclosing):void;
}

func resolve_case_arm(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
    work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val first <- state.first;
    val used <- state.used;
    val enclosing <- state.receiving_arm;
    work[at].enclosing_case_arm <- enclosing;
    work[at].arm_case <- state.case_target;
    state.receiving_arm <- at;
    state.first <- used;
    resolve_case_arm_body(source, nodes, bindings, work, state, at);
    state.receiving_arm <- enclosing;
    state.first <- first;
    state.used <- used;
    return
}

func resolve_control_completion(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                bindings:NameBindings in B, work:NameWork in W, state:NameState in R,
                                at:u64, continues:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref operand = make u64 { no_node() };
    if (!completion_operand(nodes, state.syntax_revision, state.syntax_used, at, operand)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    if (state.case_target != no_node()) {
        if (continues) { reject_name(state, at, continue_crosses_case()); return; };
        bindings[at].declaration <- state.case_target;
    } else {
        if (state.handoff == no_node()) { reject_name(state, at, missing_here_control()); return; };
        bindings[at].declaration <- state.handoff;
    };
    resolve_expression(source, nodes, bindings, work, state, operand);
    return;
}

func native_handle_destination(nodes:const ExprNodes in N, bindings:const NameBindings in B,
    destination:u64, revision:u64, used:u64) -> bool where {const owner N, const owner B} {
    val name <- ungrouped(nodes, revision, used, destination);
    if (name >= used || name_syntax(nodes, used, name) != OrdinaryName) return false;
    if (bindings[name].kind == handle_binding()) return true;
    if (bindings[name].kind != formal_binding()) return false;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    return inspect_formal(nodes, revision, used, bindings[name].declaration, formal) == OrdinaryFormal &&
        formal.mode == HandleFormal
}

func resolve_assignment(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                        work:NameWork in W, state:NameState in R, at:u64, transfer:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, state.syntax_revision, state.syntax_used, at, assignment);
    if (mode != PlaceTransfer && mode != PlaceRebind && mode != FieldTransfer &&
        mode != AugmentedPlaceTransfer) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    if (transfer) { resolve_transfer_family(source, nodes, bindings, work, state, at); };
    resolve_expression(source, nodes, bindings, work, state, assignment.destination);
    if (state.diagnostic != 0u8) return;
    if (mode == PlaceRebind && native_handle_destination(nodes, bindings, assignment.destination,
        state.syntax_revision, state.syntax_used)) {
        reject_name(state, assignment.destination, unsupported_handle_rebind());
        return
    };
    resolve_expression(source, nodes, bindings, work, state, assignment.input);
}

func resolve_logical(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref sites = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val mode <- inspect_logical(nodes, state.syntax_revision, state.syntax_used, at, sites);
    if (mode != LogicalNot && mode != LogicalAnd && mode != LogicalOr) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_expression(source, nodes, bindings, work, state, sites.left_operand);
    if (state.diagnostic != 0u8 || mode == LogicalNot) return;
    val enclosing_guard <- state.guard;
    val incoming <- state.native_installation;
    state.guard <- sites.right_operand;
    resolve_expression(source, nodes, bindings, work, state, sites.right_operand);
    join_native_installation(state, incoming);
    (state.guard <- enclosing_guard):void;
}

func resolve_child_expression(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                              work:NameWork in W, state:NameState in R, at:u64, child:const NodeId in C) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner C} {
    if (!published_syntax_id(nodes, state.syntax_revision, at, child)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_expression(source, nodes, bindings, work, state, child.index);
}

func resolve_binary_operands(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                             work:NameWork in W, state:NameState in R, at:u64,
                             operands:const BinaryOperands in O) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner O} {
    resolve_child_expression(source, nodes, bindings, work, state, at, operands.left_operand);
    if (state.diagnostic != 0u8) return;
    resolve_child_expression(source, nodes, bindings, work, state, at, operands.right_operand);
}

func resolve_conditional(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:NameWork in W, state:NameState in R, at:u64,
                         condition:const NodeId in Q, consequent:const NodeId in C, alternative:const NodeId in A)
    -> void where {const owner S, const owner N, owner B, owner W, owner R, const owner Q, const owner C, const owner A} {
    resolve_child_expression(source, nodes, bindings, work, state, at, condition);
    if (state.diagnostic != 0u8) return;
    val guard <- state.guard;
    val incoming <- state.native_installation;
    state.guard <- consequent.index;
    resolve_child_expression(source, nodes, bindings, work, state, at, consequent);
    val yes <- state.native_installation;
    if (state.diagnostic == 0u8) {
        state.guard <- alternative.index;
        state.native_installation <- incoming;
        resolve_child_expression(source, nodes, bindings, work, state, at, alternative);
    };
    if (state.native_installation != yes) {
        (state.native_installation <- state.syntax_used):void
    };
    (state.guard <- guard):void;
}

func resolve_effect(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     work:NameWork in W, state:NameState in R, at:u64, name:const NodeId in I, input:const NodeId in E,
                     installs:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner I, const owner E} {
    if (enclosing_callable(nodes, bindings, state.scope_node) == no_node() || state.delayed != no_node() ||
        !published_syntax_id(nodes, state.syntax_revision, at, name) ||
        !published_syntax_id(nodes, state.syntax_revision, at, input)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_value(source, nodes, bindings, work, state, name.index, true);
    if (state.diagnostic != 0u8) return;
    if (installs) {
        resolve_effect_initializer(source, nodes, bindings, work, state, input.index);
        if (state.diagnostic == 0u8) {
            (state.native_installation <- at):void
        }
    } else {
        resolve_expression(source, nodes, bindings, work, state, input.index);
    };
}

func resolve_assertion(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                        work:NameWork in W, state:NameState in R, at:u64, operand:const NodeId in I, target:const NodeId in T)
    -> void where {const owner S, const owner N, owner B, owner W, owner R, const owner I, const owner T} {
    if (!published_syntax_id(nodes, state.syntax_revision, at, operand) ||
        !published_syntax_id(nodes, state.syntax_revision, at, target)) {
        reject_name(state, at, invalid_module_tree());
        return;
    };
    resolve_type_name(source, nodes, bindings, work, state, target.index);
    if (state.diagnostic != 0u8) return;
    if (bindings[target.index].kind != builtin_c_string() &&
        name_syntax(nodes, state.syntax_used, operand.index) == OrdinaryName && bindings[operand.index].kind != enum_value() &&
        lookup(source, nodes, work, operand.index, 0u64, state.used) == no_node()) return;
    resolve_expression(source, nodes, bindings, work, state, operand.index);
}

func resolve_expression(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:NameWork in W, state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (at == no_node()) return;
    if (at >= state.syntax_used || at >= syntax_len(nodes)) {
        reject_name(state, no_node(), invalid_module_tree());
        return;
    };
    case nodes[at] of {
        (Vacant) -> { reject_name(state, no_node(), invalid_module_tree()); return; };
        (Occupied { val syntax <- node; }) -> {
            bindings[at].scope <- state.scope_node;
            bindings[at].finalizer <- state.finalizer;
            work[at].native_installation <- state.native_installation;
            case syntax.payload of {
                (Parenthesized { val expression <- expression; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, expression)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_expression(source, nodes, bindings, work, state, expression.index);
                    return;
                };
                (Transfer) -> {
                    resolve_assignment(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (AugmentedTransfer) -> {
                    resolve_assignment(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (Rebind) -> {
                    resolve_assignment(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (InitializerTransfer) -> {
                    resolve_assignment(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (InitializerRebind) -> { reject_name(state, at, unsupported_initializer_rebind()); return; };
                (NamedConstruction) -> {
                    resolve_construction(source, nodes, bindings, work, state, at);
                    return;
                };
                (LocalBinding { val binding <- binding; val initializer <- initializer; val mode <- mode; }) -> {
                    if (mode == ExceptionLocal) { reject_name(state, at, invalid_module_tree()); return; };
                    resolve_local(source, nodes, bindings, work, state, at, binding, initializer);
                    return;
                };
                (OwningHandleBinding) -> { resolve_handle_local(source, nodes, bindings, work, state, at); return; };
                (BorrowedHandleBinding) -> { resolve_handle_local(source, nodes, bindings, work, state, at); return; };
                (OwnHandleConstruction) -> {
                    resolve_handle_construction(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (BorrowHandleConstruction) -> {
                    resolve_handle_construction(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (BindSymbolEffect { val name <- name; val input <- input; }) -> {
                    resolve_effect(source, nodes, bindings, work, state, at, name, input, false);
                    return;
                };
                (InstallSymbolEffect { val name <- name; val input <- acquisition; }) -> {
                    resolve_effect(source, nodes, bindings, work, state, at, name, input, true);
                    return;
                };
                (CheckedTypeAssertion { val operand <- operand; val annotation <- annotation; }) -> {
                    resolve_assertion(source, nodes, bindings, work, state, at, operand, annotation);
                    return;
                };
                (CaseExpression) -> { resolve_case(source, nodes, bindings, work, state, at); return; };
                (CaseArm) -> { resolve_case_arm(source, nodes, bindings, work, state, at); return; };
                (CallableDefinition { val lexical <- lexical; }) -> {
                    if (!lexical) { reject_name(state, at, invalid_module_tree()); return; };
                    resolve_lexical_callable(source, nodes, bindings, work, state, at);
                    return;
                };
                (ProtectedBlock) -> { resolve_try(source, nodes, bindings, work, state, at); return; };
                (DeferredBlock { val body <- body; }) -> {
                    resolve_defer(source, nodes, bindings, work, state, at, body, true);
                    return;
                };
                (DeferredInvocation { val operand <- operand; val invocation <- invocation; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, invocation)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_defer(source, nodes, bindings, work, state, at, operand, false);
                    return;
                };
                (Conditional { val condition <- condition; val yes <- consequent; val no <- alternative; }) -> {
                    resolve_conditional(source, nodes, bindings, work, state, at, condition, yes, no);
                    return;
                };
                (ArithmeticExpression { val operands <- operands; }) -> {
                    resolve_binary_operands(source, nodes, bindings, work, state, at, operands);
                    return;
                };
                (ComparisonExpression { val operands <- operands; }) -> {
                    resolve_binary_operands(source, nodes, bindings, work, state, at, operands);
                    return;
                };
                (Concatenation { val operands <- operands; }) -> {
                    resolve_value(source, nodes, bindings, work, state, at, false);
                    if (state.diagnostic == 0u8) {
                        resolve_binary_operands(source, nodes, bindings, work, state, at, operands);
                    };
                    return;
                };
                (IndexSelection { val target <- target; val index <- index; }) -> {
                    resolve_child_expression(source, nodes, bindings, work, state, at, target);
                    if (state.diagnostic == 0u8) {
                        resolve_child_expression(source, nodes, bindings, work, state, at, index);
                    };
                    return;
                };
                (FieldSelection { val target <- target; val field <- field; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, field) ||
                        name_syntax(nodes, at, field.index) != OrdinaryName) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_child_expression(source, nodes, bindings, work, state, at, target);
                    return;
                };
                (ArrayLength { val target <- target; }) -> {
                    resolve_child_expression(source, nodes, bindings, work, state, at, target);
                    return;
                };
                (DiscardedExpression { val operand <- operand; }) -> {
                    resolve_child_expression(source, nodes, bindings, work, state, at, operand);
                    return;
                };
                (TextLiteral) -> { remember(bindings, at, at, builtin_string()); return; };
                (RaisePending) -> { return; };
                (NamedThrow) -> { resolve_constructing_throw(source, nodes, bindings, work, state,
                    at); return; };
                (RaiseValue { val operand <- exception_value; }) -> {
                    resolve_child_expression(source, nodes, bindings, work, state, at, operand);
                    return;
                };
                (NullLiteral { val owner_name <- owner_name; }) -> {
                    case owner_name of {
                        (NoLink) -> {};
                        (LinkTo { val name <- node; }) -> {
                            if (!published_syntax_id(nodes, state.syntax_revision, at, name)) {
                                reject_name(state, at, invalid_module_tree()); return;
                            };
                            resolve_owner(source, nodes, bindings, work, state, name.index);
                        };
                    };
                    return;
                };
                (CaseFailure) -> { return; };
                (CaseFallthrough) -> {
                    if (state.case_arm == no_node()) { reject_name(state, at, missing_case_arm()); return; };
                    bindings[at].declaration <- state.case_arm;
                    return;
                };
                (BooleanLiteral) -> { return; };
                (Negation) -> { resolve_logical(source, nodes, bindings, work, state, at); return; };
                (Conjunction) -> { resolve_logical(source, nodes, bindings, work, state, at); return; };
                (Disjunction) -> { resolve_logical(source, nodes, bindings, work, state, at); return; };
                (IntegerLiteral) -> { return; };
                (RangeLoop) -> {
                    resolve_range(source, nodes, bindings, work, state, at);
                    return;
                };
                (ContinueValue) -> {
                    resolve_control_completion(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (ContinueVoid) -> {
                    resolve_control_completion(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (BreakValue) -> {
                    resolve_control_completion(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (BreakVoid) -> {
                    resolve_control_completion(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (HereInvocation) -> {
                    resolve_here_call(source, nodes, bindings, work, state, at);
                    return;
                };
                (BlockSyntax { val items <- items; }) -> {
                    resolve_expression_links(source, nodes, bindings, work, state, items, at);
                    return;
                };
                (ScopeSyntax) -> {
                    resolve_full_scope(source, nodes, bindings, work, state, at, state.used, no_node());
                    return;
                };
                (SymbolReference) -> {
                    resolve_value(source, nodes, bindings, work, state, at, true);
                    return;
                };
                (SymbolicInvocation { val target <- callee; val arguments <- arguments; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, target)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_expression(source, nodes, bindings, work, state, target.index);
                    if (state.diagnostic != 0u8) return;
                    resolve_expression_links(source, nodes, bindings, work, state, arguments, at);
                    return;
                };

                (NameReference) -> {
                    resolve_value(source, nodes, bindings, work, state, at, false);
                    return;
                };
                (Call { val callee <- callee; val arguments <- argument_tail; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, callee) ||
                        !published_syntax_id(nodes, state.syntax_revision, state.syntax_used, arguments)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_expression(source, nodes, bindings, work, state, callee.index);
                    reject_noncallable_shadow(nodes, bindings, work, state, callee.index);
                    if (state.diagnostic != 0u8) return;
                    resolve_list(source, nodes, bindings, work, state, arguments.index);
                    return;
                };
                (EmptyCall { val callee <- callee; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, callee)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_expression(source, nodes, bindings, work, state, callee.index);
                    reject_noncallable_shadow(nodes, bindings, work, state, callee.index);
                    return;
                };
                (ReturnValue { val value <- value; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, value)) {
                        reject_name(state, at, invalid_module_tree());
                        return;
                    };
                    resolve_expression(source, nodes, bindings, work, state, value.index);
                    return;
                };
                (ReturnVoid) -> { return; };
                () -> {};
            };
        };
    };
    reject_name(state, at, invalid_module_tree());
}

func signature_name(nodes:const ExprNodes in N, revision:u64, used:u64, signature:u64) -> u64
    where {const owner N} {
    ref head = make u64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, signature, SignatureHead, head) || head == no_node()) return no_node();
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (inspect_signature(nodes, revision, used, head, sites) != SignatureHead) return no_node();
    return sites.name;
}

export func variadic_method_formal(nodes:const ExprNodes in N, revision:u64, used:u64, form:u64)
    -> u64 where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <-
        false; };
    val shape <- inspect_callable(nodes, revision, used, form, callable);
    if ((shape != ModuleCallable && shape != LexicalCallable) || callable.body >= used)
        return no_node();
    ref head = make u64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, head))
        return no_node();
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node();
        parameter_tail <- no_node(); readonly <- false;
    };
    if (inspect_signature(nodes, revision, used, head, sites) != SignatureHead ||
        formal_variadic_at(nodes, revision, used, sites.parameter_tail) == no_node())
            return no_node();
    return sites.parameter_tail
}

export func definition_name(nodes:const ExprNodes in N, revision:u64, used:u64, form:u64) -> u64 where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val mode <- inspect_callable(nodes, revision, used, form, callable);
    if (mode != OtherCallableSyntax && mode != InvalidCallable)
        return signature_name(nodes, revision, used, callable.signature);
    ref sites = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, form, sites);
    if (shape == OtherDeclaration || shape == InvalidDeclaration) return no_node();
    return sites.name;
}

func same_selection(nodes:const ExprNodes in N, selected:const SelectedExports in E,
                    left:u64, right:u64, revision:u64, used:u64) -> bool where {const owner N, const owner E} {
    if (selected[left].kind == callable_export()) {
        ref left_selection = make ModuleSelectionSites {
            path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
            symbolic <- false; mode <- UseResource;
            nature <- OrdinaryResource;
        };
        ref right_selection = make ModuleSelectionSites {
            path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
            symbolic <- false; mode <- UseResource;
            nature <- OrdinaryResource;
        };
        if (inspect_module_selection(nodes, revision, used, left, left_selection) != SelectionReady ||
            inspect_module_selection(nodes, revision, used, right, right_selection) != SelectionReady ||
            left_selection.mode != right_selection.mode || selected[left].dependency_module != selected[right].dependency_module)
            return false;
    };
    return selected[left].kind == selected[right].kind &&
        selected[left].origin_module == selected[right].origin_module && selected[left].identity == selected[right].identity;
}

func register_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         selected:const SelectedExports in E, work:NameWork in W, state:NameState in R,
                         form:u64, selection:const ModuleSelectionSites in Q) -> void
    where {const owner S, const owner N, owner B, const owner E, owner W, owner R, const owner Q} {
    if (selection.mode == ReexportResource) return;
    val name <- selection.local;
    val kind <- if (selection.symbolic) { symbolic_selection() } else { ordinary_selection() };
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found != no_node() && bindings[found].kind == kind &&
        same_selection(nodes, selected, bindings[found].declaration, form, state.syntax_revision, state.syntax_used)) {
        remember(bindings, name, bindings[found].declaration, kind);
    } else {
        declare_name(source, nodes, bindings, work, state, name, form, kind, unproved_module_binding());
    };
}

func register_constructors(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                           work:NameWork in W, state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref first = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, SumSequence, first) ||
        first == no_node()) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node(); };
    val arm <- first;
    for (unused in 0u64 .. state.syntax_used) {
        if (!inspect_sum_arm(nodes, state.syntax_revision, state.syntax_used, arm, sites)) {
            reject_name(state, arm, invalid_module_tree());
            return;
        };
        declare_module_name(source, nodes, bindings, work, state, sites.name, arm, constructor_type());
        if (arm == tail || state.diagnostic != 0u8) return;
        arm <- work[arm].next;
    };
    reject_name(state, tail, invalid_module_tree());
}

func register_module(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     selected:const SelectedExports in E, work:NameWork in W, state:NameState in R,
                     first:u64) -> void
    where {const owner S, const owner N, owner B, const owner E, owner W, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    val item <- first;
    val form <- no_node();
    val kind <- 0u8;
    val declaration_shape <- OtherDeclaration;
    val selection_shape <- SelectionReady;
    for (unused in 0u64 .. state.syntax_used) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != ModuleSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        form <- entry.item;
        declaration_shape <- inspect_declaration(nodes, state.syntax_revision, state.syntax_used, form, declaration);
        selection_shape <- inspect_module_selection(nodes, state.syntax_revision, state.syntax_used, form, selection);
        if (declaration_shape == InvalidDeclaration || selection_shape == InvalidSelection) {
            reject_name(state, form, invalid_module_tree());
            return;
        };
        kind <- declaration_binding_kind(declaration_shape);
        if (kind != 0u8) {
            declare_module_name(source, nodes, bindings, work, state, declaration.name, form, kind);
        };
        if (declaration_shape == NominalSum && state.diagnostic == 0u8) {
            register_constructors(source, nodes, bindings, work, state, declaration.entries);
        };
        if (selection_shape == SelectionReady) {
            register_selection(source, nodes, bindings, selected, work, state, form, selection);
        };
        if (state.diagnostic != 0u8) return;
        item <- work[item].next;
    };
}

func declaration_binding_kind(shape:DeclarationSyntax) -> u8 {
    return case shape of {
        (HandleTypeDeclaration) -> { c_handle_type() };
        (NominalRecord) -> { record_type() };
        (NativeRecord) -> { record_type() };
        (ArrayTypeDeclaration) -> { array_type() };
        (EnumTypeDeclaration) -> { enum_type() };
        (NominalSum) -> { sum_type() };
        (AbstractTypeDeclaration) -> { abstract_type_binding() };
        (NativeSymbolDeclaration) -> { native_symbol_binding() };
        (ReferenceSymbolDeclaration) -> { reference_symbol_binding() };
        (_) -> { 0u8 };
    };
}

func extensible_selection(nodes:const ExprNodes in N, selected:const SelectedExports in E,
                          site:u64, revision:u64, used:u64) -> bool where {const owner N, const owner E} {
    if (selected[site].kind != callable_export() || selected[site].shape != ordinary_callable_shape()) return false;
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    return inspect_module_selection(nodes, revision, used, site, selection) == SelectionReady &&
        selection.mode == ImportResource;
}

export func transfer_name(source:const SourceBytes in S, nodes:const ExprNodes in N, name:u64) -> bool
    where {const owner S, const owner N} {
    val first <- syntax_first(nodes, syntax_len(nodes), name);
    return syntax_past(nodes, syntax_len(nodes), name) == first + 2u64 && source[first] == 60u8 && source[first + 1u64] == 45u8;
}

func published_family_membership(interfaces:const ModuleInterfaces in I, published:u64,
    kind:u8, shape:u8, module:u64, declaration:u64) -> FamilyMembership where {const owner I} {
    if (kind != callable_export() || shape != ordinary_callable_shape() || module == 0u64)
        return (UnprovedMembership:FamilyMembership);
    val row <- find_interface(interfaces, published, module, declaration);
    if (row == no_node() || interfaces[row].interface_kind != callable_binding())
        return (UnprovedMembership:FamilyMembership);
    if (interfaces[row].membership == (VariadicMethod:FamilyMembership) &&
        interfaces[row].native_function != no_node()) return (UnprovedMembership:FamilyMembership);
    return interfaces[row].membership
}

func selected_family_membership(selected:const SelectedExports in E, site:u64,
    interfaces:const ModuleInterfaces in I, published:u64) -> FamilyMembership
    where {const owner E, const owner I} {
    if (site >= intrinsic (len)(selected)) return (UnprovedMembership:FamilyMembership);
    return published_family_membership(interfaces, published, selected[site].kind, selected[site].shape,
        selected[site].origin_module, selected[site].identity)
}

func checked_selection_membership(selections:const CheckedSelections in C, used:u64, at:u64,
    revision:u64, interfaces:const ModuleInterfaces in I, published:u64) -> FamilyMembership
    where {const owner C, const owner I} {
    if (at >= used || used > intrinsic (len)(selections)) return (UnprovedMembership:FamilyMembership);
    return case selections[at] of {
        SelectedResource {
            val origin <- revision; val kind <- export_kind; val shape <- shape;
            val module <- defining_module; val declaration <- identity;
        } -> {
            if (origin != revision) return (UnprovedMembership:FamilyMembership);
            return published_family_membership(interfaces, published, kind, shape, module, declaration)
        };
        _ -> (UnprovedMembership:FamilyMembership)
    }
}

func register_callables(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         selected:const SelectedExports in E, selections:const CheckedSelections in C,
                         selected_used:u64, work:NameWork in W, state:NameState in R,
                         interfaces:const ModuleInterfaces in I, published:u64,
                         first:u64, allow_families:bool) -> void
    where {const owner S, const owner N, owner B, const owner E, const owner C, owner W, owner R, const owner I} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref sites = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val item <- first;
    val form <- no_node();
    val name <- no_node();
    val found <- no_node();
    val family <- no_node();
    val variadic <- false;
    val inherited <- (UnprovedMembership:FamilyMembership);
    val candidate <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != ModuleSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        form <- entry.item;
        if (inspect_callable(nodes, state.syntax_revision, state.syntax_used, form, sites) == ModuleCallable) {
            name <- signature_name(nodes, state.syntax_revision, state.syntax_used, sites.signature);
            if (name == no_node()) { reject_name(state, form, invalid_module_tree()); return; };
            found <- lookup(source, nodes, work, name, 0u64, state.used);
            if ((found != no_node() && bindings[found].kind == constructor_type()) ||
                (found == no_node() && selected[name].constructor_selection != no_node())) {
                reject_name(state, form, unsupported_constructor_initializer());
                return;
            };
            variadic <- variadic_method_formal(nodes, state.syntax_revision, state.syntax_used,
                form) != no_node();
            if (found != no_node() && bindings[found].kind == ordinary_selection() &&
                (extensible_selection(nodes, selected, bindings[found].declaration,
                    state.syntax_revision, state.syntax_used) ||
                 (bindings[found].module_use == (SelectedValue:ModuleNameUse) &&
                  permits_module_family_extension(selections, selected_used, work[found].module_selection,
                      state.syntax_revision)))) {
                family <- bindings[found].declaration;
                inherited <- if (bindings[found].module_use == (SelectedValue:ModuleNameUse)) {
                    checked_selection_membership(selections, selected_used, work[found].module_selection,
                        state.syntax_revision, interfaces, published)
                } else { selected_family_membership(selected, family, interfaces, published) };
                if (inherited == (VariadicMethod:FamilyMembership) ||
                    (variadic && inherited == (FixedMethods:FamilyMembership))) {
                    reject_name(state, form, conflicting_variadic_family());
                    return
                }
            };
            if (found != no_node() && bindings[found].kind == callable_binding()) {
                family <- bindings[found].declaration;
                if (variadic_method_formal(nodes, state.syntax_revision, state.syntax_used,
                    form) != no_node() ||
                    variadic_method_formal(nodes, state.syntax_revision, state.syntax_used,
                        family) != no_node()) {
                    reject_name(state, form, conflicting_variadic_family());
                    return
                }
            };
            candidate <- work[name].module_selection;
            if (found == no_node() && state.module_candidates && candidate != no_node()) {
                if (!allow_families || !permits_module_family_extension(selections, selected_used,
                    candidate, state.syntax_revision)) {
                    reject_name(state, name, unproved_module_binding());
                    return
                };
                inherited <- checked_selection_membership(selections, selected_used, candidate,
                    state.syntax_revision, interfaces, published);
                if (inherited == (VariadicMethod:FamilyMembership) ||
                    (variadic && inherited == (FixedMethods:FamilyMembership))) {
                    reject_name(state, form, conflicting_variadic_family());
                    return
                };
                if (!select_on_lexical_miss(bindings, work, state, name,
                    (SelectedValue:ModuleNameUse), false)) {
                    reject_name(state, name, invalid_module_tree());
                    return
                };
                work[state.used].active <- name;
                (state.used <- state.used + 1u64):void
            } else {
                if (found != no_node() && bindings[found].kind == callable_binding() &&
                    (allow_families || transfer_name(source, nodes, name))) {
                    family <- bindings[found].declaration;
                    work[form].next_method <- work[family].next_method;
                    work[family].next_method <- form;
                    remember(bindings, name, family, callable_binding());
                } else {
                    if (allow_families && found != no_node() && bindings[found].kind == ordinary_selection() &&
                        (extensible_selection(nodes, selected, bindings[found].declaration,
                            state.syntax_revision, state.syntax_used) ||
                         (bindings[found].module_use == (SelectedValue:ModuleNameUse) &&
                          permits_module_family_extension(selections, selected_used,
                              work[found].module_selection, state.syntax_revision)))) {
                        remember(bindings, name, bindings[found].declaration, ordinary_selection());
                    } else {
                        declare_name(source, nodes, bindings, work, state, name, form, callable_binding(), unproved_module_binding());
                    }
                };
            };
            if (state.diagnostic != 0u8) return;
            remember(bindings, form, bindings[name].declaration, callable_binding());
        };
        item <- work[item].next;
    };
}

func register_callable_promises(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                 bindings:NameBindings in B, work:NameWork in W,
                                     state:NameState in R) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref promise = make CallableSites { signature <- no_node(); body <- no_node(); function_form <-
        false; };
    val name <- no_node();
    for (at in 0u64 .. state.syntax_used) {
        if (inspect_callable(nodes, state.syntax_revision, state.syntax_used, at,
            promise) == ModuleCallablePromise) {
            name <- signature_name(nodes, state.syntax_revision, state.syntax_used,
                promise.signature);
            if (name == no_node()) { reject_name(state, at, invalid_module_tree()); return };
            if (lookup(source, nodes, work, name, 0u64, state.used) != no_node()) {
                reject_name(state, name, unsupported_callable_promise());
                return
            };
            declare_name(source, nodes, bindings, work, state, name, at, callable_binding(),
                duplicate_binding());
            remember(bindings, at, at, callable_binding())
        }
    }
}

func register_c_callable(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B,
                          work:NameWork in W, state:NameState in R, form:u64, signature:u64, provider:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val name <- signature_name(nodes, state.syntax_revision, state.syntax_used, signature);
    ref result = make u64 { no_node() };
    if (name == no_node() ||
        !find_signature_clause(nodes, state.syntax_revision, state.syntax_used, signature, ValueResultClause, result)) {
        reject_name(state, form, invalid_module_tree());
        return;
    };
    if (provider && result == no_node()) {
        val found <- lookup(source, nodes, work, name, 0u64, state.used);
        if (found != no_node() && bindings[found].kind == c_handle_type()) {
            val marker <- bindings[found].declaration;
            remember(bindings, name, marker, c_handle_type());
            remember(bindings, form, marker, c_constructor());
            return;
        } else {};
    } else {};
    val kind <- if (provider) { c_operation() } else { c_entry() };
    declare_module_name(source, nodes, bindings, work, state, name, form, kind);
    remember(bindings, form, form, kind);
}

func register_native_callables(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B,
                                work:NameWork in W, state:NameState in R, first:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref sites = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val shape <- OtherCallableSyntax;
    val item <- first;
    val form <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != ModuleSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        form <- entry.item;
        shape <- inspect_callable(nodes, state.syntax_revision, state.syntax_used, form, sites);
        if (shape == InvalidCallable) { reject_name(state, form, invalid_module_tree()); return; };
        if (shape == CProvider || shape == CEntry) {
            register_c_callable(source, nodes, bindings, work, state, form, sites.signature,
                shape == CProvider);
            if (state.diagnostic != 0u8) return;
        } else {};
        item <- work[item].next;
    };
}

func bind_constraint_names(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                           work:NameWork in W, state:NameState in R, head:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val clause <- work[head].next;
    val shape <- InvalidSignature;
    for (unused in 0u64 .. state.syntax_used) {
        if (clause == no_node()) return;
        shape <- inspect_signature(nodes, state.syntax_revision, state.syntax_used, clause, signature);
        if (shape == InvalidSignature || shape == OtherSignatureSyntax || shape == SignatureHead) {
            reject_name(state, clause, invalid_module_tree());
            return;
        };
        if (shape == OwnerSignatureClause || shape == TypeSignatureClause) {
            declare_name(source, nodes, bindings, work, state, signature.annotation, clause,
                         if (shape == OwnerSignatureClause) { owner_binding() } else { type_parameter_binding() }, duplicate_binding());
        };
        if (state.diagnostic != 0u8) return;
        clause <- work[clause].next;
    };
}

func register_constraints(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:NameWork in W, state:NameState in R, head:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val first <- state.used;
    bind_constraint_names(source, nodes, bindings, work, state, head);
    if (state.diagnostic != 0u8) return;
    # The header uses one constraint namespace. Only owner bindings remain
    # lexical value names in the definition body.
    val next <- first;
    val name <- no_node();
    for (at in first .. state.used) {
        name <- work[at].active;
        if (bindings[name].kind == owner_binding()) {
            work[next].active <- name;
            (next <- next + 1u64):void;
        };
    };
    (state.used <- next):void;
}

func resolve_header_types(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:const NameWork in W, state:NameState in R, head:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val clause <- work[head].next;
    val shape <- InvalidSignature;
    for (unused in 0u64 .. state.syntax_used) {
        if (clause == no_node()) return;
        shape <- inspect_signature(nodes, state.syntax_revision, state.syntax_used, clause, signature);
        if (shape == ValueResultClause || shape == BorrowedResultClause ||
            shape == ThrowsSignatureClause || shape == ExceptionResultClause) {
            resolve_type_annotation(source, nodes, bindings, work, state, signature.annotation);
            if (state.diagnostic != 0u8) return;
        } else {
            if (shape != OwnerSignatureClause && shape != TypeSignatureClause) {
                reject_name(state, clause, invalid_module_tree());
                return;
            };
        };
        clause <- work[clause].next;
    };
}

func resolve_ordinary_formal(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B, work:NameWork in W, state:NameState in R, parameter:u64,
    formal:const FormalSites in F, binding:const BindingSites in F) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner F} {
    resolve_type_annotation(source, nodes, bindings, work, state, binding.annotation);
    if (state.diagnostic != 0u8) return;
    if ((formal.mode == PlaceFormal || formal.mode == InitializingPlaceFormal) &&
        (binding.readonly || bindings[binding.target_type].kind != builtin_string())) {
        reject_name(state, parameter, invalid_direct_string_place());
        return
    };
    declare_name(source, nodes, bindings, work, state, binding.name, parameter, formal_binding(), duplicate_binding())
}

func resolve_formals(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                     work:NameWork in W, state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref parameter = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, FormalSequence, parameter)) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val shape <- InvalidFormal;
    for (unused in 0u64 .. state.syntax_used) {
        if (parameter == no_node()) return;
        shape <- inspect_formal(nodes, state.syntax_revision, state.syntax_used, parameter, formal);
        if (shape == HereFormalSyntax) {
            resolve_here_formal(source, nodes, bindings, work, state, parameter, formal.signature);
        } else {
            if (shape != OrdinaryFormal ||
                inspect_binding(nodes, state.syntax_revision, state.syntax_used, formal.binding, binding) != TypedBinding) {
                reject_name(state, parameter, invalid_module_tree());
                return;
            };
            resolve_ordinary_formal(source, nodes, bindings, work, state, parameter, formal, binding)
        };
        if (state.diagnostic != 0u8) return;
        parameter <- work[parameter].next;
    };
}

func resolve_here_formal(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:NameWork in W, state:NameState in R, callback_entry:u64, callback_signature:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref callback = make u64 { no_node() };
    ref header = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, state.syntax_revision, state.syntax_used, callback_signature, SignatureHead, callback) ||
        inspect_signature(nodes, state.syntax_revision, state.syntax_used, callback, header) != SignatureHead) {
        reject_name(state, callback_entry, invalid_module_tree());
        return;
    };
    val enclosing_first <- state.first;
    val enclosing_used <- state.used;
    state.first <- enclosing_used;
    resolve_header_types(source, nodes, bindings, work, state, callback);
    if (state.diagnostic != 0u8) return;
    resolve_formals(source, nodes, bindings, work, state, header.parameter_tail);
    if (state.diagnostic != 0u8) return;
    state.first <- enclosing_first;
    state.used <- enclosing_used;
    # Only the callback's name enters the receiver's parameter scope.
    declare_name(source, nodes, bindings, work, state, header.name, callback_entry, formal_binding(), duplicate_binding());
}

func has_owner_input(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                     first:u64, clause:u64, readonly_owner:bool, revision:u64, used:u64) -> bool
    where {const owner N, const owner B, const owner W} {
    val input <- first;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    for (unused in 0u64 .. used) {
        if (input == no_node()) return false;
        if (inspect_formal(nodes, revision, used, input, formal) == OrdinaryFormal &&
            inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding &&
            binding.owner_name != no_node() && bindings[binding.owner_name].declaration == clause &&
            (readonly_owner || !binding.readonly)) return true;
        input <- work[input].next;
    };
    return false;
}

func lexical_result_owner(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                          callable:const CallableSites in C, formals:u64, revision:u64, used:u64) -> u64
    where {const owner N, const owner B, const owner W, const owner C} {
    if (callable.body == no_node() || is_scope_block(nodes, callable.body)) return no_node();
    ref clause = make u64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, callable.signature, BorrowedResultClause, clause) ||
        clause == no_node()) return no_node();
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    ref type = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_signature(nodes, revision, used, clause, signature) != BorrowedResultClause ||
        !inspect_type_annotation(nodes, revision, used, signature.annotation, type) ||
        type.owner_name == no_node()) return no_node();
    if (!is_lexical_builder(nodes, bindings, type.target_type, revision, used) &&
        (bindings[type.target_type].kind != builtin_string() || !signature.readonly)) return no_node();

    ref tail = make u64 { no_node() };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref returned = make u64 { no_node() };
    if (!block_tail(nodes, revision, used, callable.body, tail) ||
        inspect_sequence_entry(nodes, revision, used, tail, entry) != BlockSequence ||
        completion_syntax(nodes, entry.item) != ReturnCompletion ||
        !completion_operand(nodes, revision, used, entry.item, returned) || returned == no_node()) return no_node();
    val marker <- ungrouped(nodes, revision, used, returned);
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    if (direct_invocation(nodes, revision, used, marker, call) != DirectInvocationReady ||
        inspect_sequence_entry(nodes, revision, used, call.arguments, entry) != ArgumentSequence ||
        entry.previous != no_node() || bindings[call.callee].kind != ordinary_selection() ||
        bindings[bindings[call.callee].declaration].imported_kind != lexical_result_export()) return no_node();
    val owner <- bindings[type.owner_name].declaration;
    if (owner == no_node() ||
        inspect_signature(nodes, revision, used, owner, signature) != OwnerSignatureClause || signature.readonly) return no_node();
    return if (lexical_result_inputs(nodes, bindings, work, formals, owner, revision, used)) { owner } else { no_node() };
}

func lexical_result_inputs(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                            formals:u64, owner_site:u64, revision:u64, used:u64) -> bool
    where {const owner N, const owner B, const owner W} {
    ref input = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, formals, FormalSequence, input)) return false;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    for (unused in 0u64 .. used) {
        if (input == no_node()) return true;
        if (inspect_formal(nodes, revision, used, input, formal) != OrdinaryFormal ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding) return false;
        if (binding.owner_name != no_node() &&
            (!binding.readonly || bindings[binding.owner_name].declaration == owner_site)) return false;
        input <- work[input].next;
    };
    return false;
}

func check_owner_inputs(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                        state:NameState in R, head:u64, parameter_tail:u64, result_owner:u64) -> void
    where {const owner N, const owner B, const owner W, owner R} {
    ref first = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, parameter_tail, FormalSequence, first)) {
        reject_name(state, head, invalid_module_tree());
        return;
    };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val clause <- work[head].next;
    for (unused in 0u64 .. state.syntax_used) {
        if (clause == no_node()) return;
        if (inspect_signature(nodes, state.syntax_revision, state.syntax_used, clause, signature) == OwnerSignatureClause &&
            clause != result_owner &&
            !has_owner_input(nodes, bindings, work, first, clause, signature.readonly, state.syntax_revision, state.syntax_used)) {
            reject_name(state, clause, if (signature.readonly) { owner_without_input() } else { owner_without_writable_input() });
            return;
        };
        clause <- work[clause].next;
    };
}

func resolve_callable_body(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                           work:NameWork in W, state:NameState in R, definition:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val mode <- inspect_callable(nodes, state.syntax_revision, state.syntax_used, definition, callable);
    ref head = make u64 { no_node() };
    ref header = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (mode == InvalidCallable || mode == OtherCallableSyntax ||
        !find_signature_clause(nodes, state.syntax_revision, state.syntax_used, callable.signature, SignatureHead, head) ||
        inspect_signature(nodes, state.syntax_revision, state.syntax_used, head, header) != SignatureHead) {
        reject_name(state, definition, invalid_module_tree());
        return;
    };
    register_constraints(source, nodes, bindings, work, state, head);
    if (state.diagnostic != 0u8) return;
    resolve_header_types(source, nodes, bindings, work, state, head);
    if (state.diagnostic != 0u8) return;
    resolve_formals(source, nodes, bindings, work, state, header.parameter_tail);
    if (state.diagnostic != 0u8) return;
    if (callable.body != no_node()) {
        resolve_expression(source, nodes, bindings, work, state, callable.body);
    };
    if (state.diagnostic == 0u8 && mode != CProvider && mode != CEntry) {
        val result_owner <- lexical_result_owner(nodes, bindings, work, callable, header.parameter_tail, state.syntax_revision, state.syntax_used);
        if (result_owner != no_node()) {
            ref result = make u64 { no_node() };
            if (!find_signature_clause(nodes, state.syntax_revision, state.syntax_used, callable.signature,
                                      BorrowedResultClause, result) || result == no_node()) {
                reject_name(state, definition, invalid_module_tree());
                return;
            };
            (bindings[result].declaration <- result_owner):void;
        };
        check_owner_inputs(nodes, bindings, work, state, head, header.parameter_tail, result_owner);
    };
}

func resolve_callable(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                      work:NameWork in W, state:NameState in R, definition:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val enclosing <- state.scope_node;
    val native_installation <- state.native_installation;
    state.scope_node <- definition;
    state.native_installation <- no_node();
    resolve_callable_body(source, nodes, bindings, work, state, definition);
    state.scope_node <- enclosing;
    state.native_installation <- native_installation;
    (state.used <- state.module_names):void;
}

func resolve_lexical_callable(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                              work:NameWork in W, state:NameState in R, definition:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val mark <- state.used;
    declare_name(source, nodes, bindings, work, state, definition_name(nodes, state.syntax_revision, state.syntax_used, definition),
                 definition, callable_binding(), duplicate_binding());
    if (state.diagnostic != 0u8) return;
    remember(bindings, definition, definition, callable_binding());

    # The active declarations stay visible. Control destinations and new
    # declarations belong to the nested activation and never enter its caller.
    ref body = make NameState {
        syntax_revision <- state.syntax_revision; syntax_used <- state.syntax_used;
        used <- state.used; first <- state.used; module_names <- state.module_names; scope_node <- definition;
        module_candidates <- state.module_candidates;
        runtime_floor <- if (is_function(nodes, definition)) { mark } else { (state.runtime_floor) };
        transfer_binding <- no_node(); transfer_resolved <- false; native_installation <- no_node();
        delayed <- no_node(); guard <- no_node(); finalizer <- no_node(); loop_arm <- false; repeated <- false;
        here_group <- false; handoff <- no_node(); case_target <- no_node(); case_arm <- no_node();
        receiving_arm <- no_node(); diagnostic <- 0u8;
        failed_node <- no_node(); enclosing_defer <- no_node();
    };
    resolve_callable_body(source, nodes, bindings, work, body, definition);
    if (body.diagnostic != 0u8) {
        reject_name(state, body.failed_node, body.diagnostic);
        (state.enclosing_defer <- body.enclosing_defer):void;
    };
}

export func find_enum_member(source:const SourceBytes in S, nodes:const ExprNodes in N,
                             name:u64, tail:u64, revision:u64, used:u64) -> u64 where {const owner S, const owner N} {
    val member <- tail;
    ref sites = make EnumMemberSites { name <- no_node(); previous <- no_node(); initializer <- no_node(); };
    for (unused in 0u64 .. used) {
        if (!inspect_enum_member(nodes, revision, used, member, sites)) return no_node();
        if (same_name(source, nodes, name, sites.name)) return member;
        member <- sites.previous;
    };
    return no_node();
}

func enum_code_used(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                    prior:u64, code:u64, revision:u64, used:u64) -> bool where {const owner N, const owner B, const owner W} {
    val member <- prior;
    ref sites = make EnumMemberSites { name <- no_node(); previous <- no_node(); initializer <- no_node(); };
    for (unused in 0u64 .. used) {
        if (!inspect_enum_member(nodes, revision, used, member, sites)) return false;
        if (bindings[member].declaration == member && work[member].enum_code == code) return true;
        member <- sites.previous;
    };
    return false;
}

data EnumNumbering {
    limit:u64;
    signed:bool;
    previous:u64;
    has_previous:bool;
}

func resolve_enum_member(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:NameWork in W, state:NameState in R, numbering:EnumNumbering in E, member:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, owner E} {
    ref sites = make EnumMemberSites { name <- no_node(); previous <- no_node(); initializer <- no_node(); };
    if (!inspect_enum_member(nodes, state.syntax_revision, state.syntax_used, member, sites)) {
        reject_name(state, member, invalid_module_tree());
        return;
    };
    val prior <- sites.previous;
    val name <- sites.name;
    if (find_enum_member(source, nodes, name, prior, state.syntax_revision, state.syntax_used) != no_node()) {
        reject_name(state, name, repeated_enum_name());
        return;
    } else {};
    val maximum <- 18446744073709551615u64;
    val initializer <- sites.initializer;
    val canonical <- member;
    val code <- 0u64;
    if (initializer == no_node()) {
        if (numbering.has_previous) {
            if (numbering.previous == numbering.limit) { reject_name(state, name, invalid_enum_code()); return; } else {};
            # Signed -1 is stored using the all-ones code. Its successor is zero.
            (code <- if (numbering.previous == maximum) { 0u64 } else { numbering.previous + 1u64 }):void;
        } else {};
    } else {
        ref literal = make EnumIntegerSyntax { magnitude <- 0u64; negative <- false; width <- 0u64; };
        if (inspect_enum_integer(nodes, state.syntax_used, initializer, literal)) {
            val magnitude <- literal.magnitude;
            if (literal.negative) {
                if (!numbering.signed || literal.width != 0u64 || magnitude > 9223372036854775808u64) {
                    reject_name(state, initializer, invalid_enum_code());
                    return;
                } else {};
                (code <- if (magnitude == 0u64) { 0u64 } else { maximum - (magnitude - 1u64) }):void;
            } else {
                if (magnitude > numbering.limit) { reject_name(state, initializer, invalid_enum_code()); return; } else {};
                (code <- magnitude):void;
            };
        } else {
            val target <- find_enum_member(source, nodes, initializer, prior, state.syntax_revision, state.syntax_used);
            if (target == no_node()) { reject_name(state, initializer, invalid_enum_member_reference()); return; } else {};
            canonical <- bindings[target].declaration;
            (code <- work[target].enum_code):void;
        };
    };
    if (canonical == member) {
        if (enum_code_used(nodes, bindings, work, prior, code, state.syntax_revision, state.syntax_used)) {
            reject_name(state, name, repeated_enum_code());
            return;
        } else {};
        numbering.has_previous <- true;
        (numbering.previous <- code):void;
    } else {};
    remember(bindings, member, canonical, enum_type());
    (work[member].enum_code <- code):void;
}

func resolve_enum(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                  work:NameWork in W, state:NameState in R, backing:u64, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val kind <- builtin_type_name(source, nodes, backing);
    val limit <- 18446744073709551615u64;
    if (kind == builtin_i64()) { (limit <- 9223372036854775807u64):void; } else {
        if (kind == builtin_u8()) { (limit <- 255u64):void; } else {
            if (kind == builtin_u32()) { (limit <- 4294967295u64):void; } else {
                if (kind != builtin_u64()) { reject_name(state, backing, invalid_enum_backing()); return; } else {};
            };
        };
    };
    remember(bindings, backing, no_node(), kind);
    ref numbering = make EnumNumbering {
        limit <- limit; signed <- kind == builtin_i64(); previous <- 0u64; has_previous <- false;
    };
    ref member = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, EnumSequence, member)) {
        reject_name(state, tail, invalid_module_tree());
        return;
    };
    for (unused in 0u64 .. state.syntax_used) {
        if (member == no_node()) return;
        resolve_enum_member(source, nodes, bindings, work, state, numbering, member);
        if (state.diagnostic != 0u8) return;
        member <- work[member].next;
    };
}

func resolve_sum_fields(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                        work:NameWork in W, state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node(); };
    val arm <- tail;
    for (unused in 0u64 .. state.syntax_used) {
        if (arm == no_node()) return;
        if (!inspect_sum_arm(nodes, state.syntax_revision, state.syntax_used, arm, sites)) {
            reject_name(state, arm, invalid_module_tree());
            return;
        };
        resolve_formals(source, nodes, bindings, work, state, sites.fields);
        state.used <- state.module_names;
        if (state.diagnostic != 0u8) return;
        arm <- sites.previous;
    };
    if (arm != no_node()) { reject_name(state, arm, invalid_module_tree()); };
}

func resolve_plain_product(source:const SourceBytes in S, nodes:const ExprNodes in N,
    bindings:NameBindings in B, work:NameWork in W, state:NameState in R,
    selections:const CheckedSelections in C, selected_used:u64,
    interfaces:const ModuleInterfaces in I, published:u64, tail:u64) -> bool
    where {const owner S, const owner N, owner B, owner W, owner R, const owner C, const owner I} {
    ref parameter = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, FormalSequence, parameter)) {
        reject_name(state, tail, invalid_module_tree());
        return false
    };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref field = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    ref projected = make SelectedExport {
        checked_resource <- no_node(); selection_site <- no_node(); selection_public_row <- no_node();
        dependency_module <- 0u64; identity <- 0u64; kind <- 0u8; checked <- 0u8;
        origin_module <- 0u64; owner_module <- 0u64; owner_identity <- 0u64; shape <- 0u8;
        enum_head <- no_node(); next_enum_selection <- no_node(); enum_code <- 0u64;
        sum_head <- no_node(); next_sum_selection <- no_node(); constructor_selection <- no_node(); constructor_row <- no_node()
    };
    val marker <- no_node();
    val problem <- 0u8;
    val written_selection <- no_node();
    for (unused in 0u64 .. state.syntax_used) {
        if (parameter == no_node()) return false;
        if (inspect_formal(nodes, state.syntax_revision, state.syntax_used, parameter, formal) != OrdinaryFormal ||
            inspect_binding(nodes, state.syntax_revision, state.syntax_used, formal.binding, field) != TypedBinding) {
            reject_name(state, parameter, invalid_module_tree());
            return false
        };
        marker <- field.target_type;
        resolve_ordinary_formal(source, nodes, bindings, work, state, parameter, formal, field);
        if (state.diagnostic == 0u8 && bindings[marker].module_use == (SelectedType:ModuleNameUse)) {
            projected.kind <- 0u8;
            problem <- project_bound_name_use(selections, selected_used, state.syntax_revision, state.syntax_used,
                work, bindings, marker, projected, interfaces, published);
            if (problem != 0u8) { reject_name(state, marker, problem) }
        } else {
            if (state.diagnostic == 0u8 && bindings[marker].kind == ordinary_selection()) {
                # A written selection already has a projected resource at its directive.
                written_selection <- bindings[marker].declaration;
                if (written_selection >= state.syntax_used || bindings[written_selection].imported_kind == 0u8) {
                    reject_name(state, marker, unproved_module_binding())
                } else {
                    if (!admits_selected_type(bindings[written_selection].imported_kind)) {
                        reject_name(state, marker, expected_type_binding())
                    }
                }
            }
        };
        if (state.diagnostic != 0u8) return state.failed_node == marker &&
            (state.diagnostic == unresolved_name() || state.diagnostic == expected_type_binding());
        (parameter <- work[parameter].next):void
    };
    if (parameter != no_node()) { reject_name(state, parameter, invalid_module_tree()) };
    return false
}

func resolve_module_types(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                           work:NameWork in W, state:NameState in R, first:u64,
                           selections:const CheckedSelections in C, selected_used:u64,
                           interfaces:const ModuleInterfaces in I, published:u64,
                           recovery:ProductTypeRecovery in P) -> void
    where {const owner S, const owner N, owner B, owner W, owner R, const owner C, const owner I, owner P} {
    val item <- first;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- OtherDeclaration;
    val recovered <- false;
    val plain <- false;
    const val floor <- state.first;
    for (unused in 0u64 .. state.syntax_used) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != ModuleSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        shape <- inspect_declaration(nodes, state.syntax_revision, state.syntax_used, entry.item, declaration);
        plain <- shape == NominalRecord && declaration.parent_type == no_node();
        if (recovery.maximum != 0u64 && recovery.count >= recovery.maximum) {
            if (plain) { recovery.incomplete <- true; return }
        } else {
            if (shape == NominalRecord || shape == NativeRecord || shape == AbstractTypeDeclaration) {
                if (declaration.parent_type != no_node()) {
                    resolve_type_name(source, nodes, bindings, work, state, declaration.parent_type);
                    if (state.diagnostic != 0u8) return;
                };
            };
            if (shape == NominalRecord || shape == NativeRecord) {
                recovered <- false;
                if (plain && recovery.maximum != 0u64) {
                    (recovered <- resolve_plain_product(source, nodes, bindings, work, state, selections,
                        selected_used, interfaces, published, declaration.entries)):void
                } else {
                    resolve_formals(source, nodes, bindings, work, state, declaration.entries)
                };
                state.used <- state.module_names;
                state.first <- floor;
                if (recovered) {
                    work[entry.item].product_type_diagnostic <- state.diagnostic;
                    work[entry.item].product_type_site <- state.failed_node;
                    if (recovery.count == 0u64) {
                        recovery.first_diagnostic <- state.diagnostic;
                        (recovery.first_site <- state.failed_node):void
                    };
                    recovery.count <- recovery.count + 1u64;
                    state.failed_node <- no_node();
                    state.enclosing_defer <- no_node();
                    (state.diagnostic <- 0u8):void
                };
                if (state.diagnostic != 0u8) return;
            };
            if (shape == NominalSum) {
                resolve_sum_fields(source, nodes, bindings, work, state, declaration.entries);
                if (state.diagnostic != 0u8) return;
            };
        };
        item <- work[item].next;
    };
}

func resolve_publication(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                          work:const NameWork in W, state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val found <- lookup(source, nodes, work, name, 0u64, state.module_names);
    val symbolic <- name_syntax(nodes, state.syntax_used, name) == SymbolicName;
    if (found == no_node()) {
        if (!select_on_lexical_miss(bindings, work, state, name, (SelectedPublication:ModuleNameUse), symbolic))
            { reject_name(state, name, unresolved_name()) };
        return
    };
    if (symbolic != symbol_binding(bindings[found].kind)) {
        reject_name(state, name, expected_symbol_binding());
        return;
    };
    remember(bindings, name, bindings[found].declaration, bindings[found].kind);
}

func resolve_module_form(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                         work:NameWork in W, state:NameState in R, form:u64, definitions:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val mode <- inspect_callable(nodes, state.syntax_revision, state.syntax_used, form, callable);
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, state.syntax_revision, state.syntax_used, form, declaration);
    if (mode == InvalidCallable || shape == InvalidDeclaration) {
        reject_name(state, form, invalid_module_tree());
        return;
    };
    if (!definitions) {
        ref selection = make ModuleSelectionSites {
            path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
            symbolic <- false; mode <- UseResource;
            nature <- OrdinaryResource;
        };
        ref default_marks = make u64 { no_node() };
        if (inspect_default_set(nodes, state.syntax_revision, state.syntax_used, form, default_marks) ==
            SelectionReady) return;
        ref bulk = make BulkSelectionSites {
            path <- no_node(); mode <- UseResource; view <- DefaultPublic
        };
        if (inspect_bulk_selection(nodes, state.syntax_revision, state.syntax_used, form, bulk) ==
            SelectionReady) return;
        if (mode == OtherCallableSyntax && shape == OtherDeclaration &&
            inspect_module_selection(nodes, state.syntax_revision, state.syntax_used, form, selection) != SelectionReady) {
            resolve_expression(source, nodes, bindings, work, state, form);
        };
        return;
    };
    if (mode == ModuleCallable || mode == ModuleCallablePromise || mode == CProvider ||
        mode == CEntry) {
        resolve_callable(source, nodes, bindings, work, state, form);
        return;
    };
    if (shape == EnumTypeDeclaration) {
        resolve_enum(source, nodes, bindings, work, state, declaration.value_type, declaration.entries);
        return;
    };
    if (shape == HandleTypeDeclaration && declaration.parent_type != no_node()) {
        resolve_type_name(source, nodes, bindings, work, state, declaration.parent_type);
        return;
    };
    if (shape == ArrayTypeDeclaration) {
        resolve_type_name(source, nodes, bindings, work, state, declaration.index_type);
        if (state.diagnostic == 0u8) {
            resolve_type_name(source, nodes, bindings, work, state, declaration.value_type);
        };
        return;
    };
    if (shape == NativeSymbolDeclaration || shape == ReferenceSymbolDeclaration) {
        resolve_type_name(source, nodes, bindings, work, state, declaration.value_type);
        return;
    };
    if (shape == LocalPublication) {
        resolve_publication(source, nodes, bindings, work, state, declaration.name);
    };
}

func resolve_module_bodies(source:const SourceBytes in S, nodes:const ExprNodes in N, bindings:NameBindings in B,
                           work:NameWork in W, state:NameState in R, first:u64, definitions:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val item <- first;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. state.syntax_used) {
        if (item == no_node()) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != ModuleSequence) {
            reject_name(state, item, invalid_module_tree());
            return;
        };
        resolve_module_form(source, nodes, bindings, work, state, entry.item, definitions);
        if (state.diagnostic != 0u8) return;
        item <- work[item].next;
    };
}

export func first_module_variadic_formal(nodes:const ExprNodes in N, revision:u64, used:u64) -> u64
    where {const owner N} {
    ref declaration = make CallableSites { signature <- no_node(); body <- no_node(); function_form
        <- false; };
    val suffix <- no_node();
    for (at in 0u64 .. used) {
        if (inspect_callable(nodes, revision, used, at, declaration) == ModuleCallable) {
            suffix <- variadic_method_formal(nodes, revision, used, at);
            if (suffix != no_node()) return suffix
        }
    };
    return no_node()
}

func check_callable_profile(nodes:const ExprNodes in N, state:NameState in R, allow_structural:bool)
    -> void where {const owner N, owner R} {
    ref declaration = make CallableSites { signature <- no_node(); body <- no_node(); function_form
        <- false; };
    val unsupported <- no_node();
    val form <- OtherCallableSyntax;
    for (at in 0u64 .. state.syntax_used) {
        form <- inspect_callable(nodes, state.syntax_revision, state.syntax_used, at, declaration);
        unsupported <- variadic_method_formal(nodes, state.syntax_revision, state.syntax_used, at);
        if (unsupported != no_node() && (!allow_structural || form != ModuleCallable)) {
            reject_name(state, unsupported, unsupported_variadic_body());
            return
        }
    }
}

# Consume a successful parse from the same source revision. Both work arrays
# need one element per syntax node. A populated binding identifies a declaration
# in the syntax buffer or a builtin kind. On failure, use only the diagnostic.
export func resolve_module_names(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                  selected:const SelectedExports in E, bindings:NameBindings in B, work:NameWork in W,
                                  interfaces:const ModuleInterfaces in I, published:u64,
                                  declarations_only:bool, allow_structural:bool, selections:const CheckedSelections in C, selected_used:u64,
                                  report:NameResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner E, const owner C, owner B, owner W, const owner I, owner R} {
    ref recovery = make ProductTypeRecovery {
        maximum <- 0u64; count <- 0u64; incomplete <- false; first_diagnostic <- 0u8; first_site <- no_node()
    };
    return resolve_module_names_recovering(source, nodes, tree, selected, bindings, work, interfaces,
        published, declarations_only, allow_structural, selections, selected_used, report, recovery)
}

export func resolve_module_names_recovering(source:const SourceBytes in S, nodes:const ExprNodes in N,
    tree:const ParseResult in T, selected:const SelectedExports in E, bindings:NameBindings in B, work:NameWork in W,
    interfaces:const ModuleInterfaces in I, published:u64, declarations_only:bool, allow_structural:bool,
    selections:const CheckedSelections in C, selected_used:u64, report:NameResolutionResult in R,
    recovery:ProductTypeRecovery in P) -> bool
    where {const owner S, const owner N, const owner T, const owner E, const owner C, owner B, owner W,
        const owner I, owner R, owner P} {
    recovery.count <- 0u64;
    recovery.incomplete <- false;
    recovery.first_diagnostic <- 0u8;
    recovery.first_site <- no_node();
    report.node <- no_node();
    report.enclosing_defer <- no_node();
    report.diagnostic <- invalid_module_tree();
    if (selected_used > intrinsic (len)(selections) || tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64) return false;
    ref first = make u64 { no_node() };
    if (!first_module_item(nodes, tree.revision, tree.used, tree.root, first)) return false;
    if (intrinsic (len)(bindings) < tree.used || intrinsic (len)(work) < tree.used ||
        intrinsic (len)(selected) < tree.used) {
        report.diagnostic <- name_storage_exhausted();
        return false;
    } else {};
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    for (at in 0u64 .. tree.used) {
        if (selected[at].kind == enum_member_export()) {
            remember(bindings, at, at, enum_value());
        } else { remember(bindings, at, no_node(), 0u8); };
        bindings[at].imported_kind <- if (
            inspect_module_selection(nodes, tree.revision, tree.used, at, selection) == SelectionReady &&
            selection.mode != ReexportResource) { (selected[at].kind) } else { 0u8 };
        bindings[at].guarded_local <- 0u8;
        bindings[at].scope <- no_node();
        bindings[at].finalizer <- no_node();
        bindings[at].guarded_local_link <- no_node();
        bindings[at].handle_guard <- no_node();
    };
    if (!link_entries(nodes, work, tree.revision, tree.used)) return false;
    ref state = make NameState {
        syntax_revision <- tree.revision; syntax_used <- tree.used;
        used <- 0u64; first <- 0u64; module_names <- 0u64; runtime_floor <- 0u64; scope_node <- tree.root;
        module_candidates <- selected_used != 0u64;
        transfer_binding <- no_node(); transfer_resolved <- false; native_installation <- no_node();
        delayed <- no_node(); guard <- no_node(); finalizer <- no_node(); loop_arm <- false; repeated <- false;
        here_group <- false; handoff <- no_node(); case_target <- no_node(); case_arm <- no_node();
        receiving_arm <- no_node(); diagnostic <- 0u8;
        failed_node <- no_node(); enclosing_defer <- no_node();
    };

    register_module(source, nodes, bindings, selected, work, state, first);
    if (state.diagnostic == 0u8) {
        register_callables(source, nodes, bindings, selected, selections, selected_used, work, state, interfaces, published,
            first, declarations_only)
    };
    if (state.diagnostic == 0u8) {
        register_callable_promises(source, nodes, bindings, work, state)
    };
    if (state.diagnostic == 0u8) {
        check_callable_profile(nodes, state, allow_structural)
    };
    if (state.diagnostic == 0u8) { register_native_callables(source, nodes, bindings, work, state,
        first); } else {};
    if (state.diagnostic == 0u8) {
        for (slot in 0u64 .. state.used) {
            if (selected[work[slot].active].kind == enum_member_export()) {
                reject_name(state, work[slot].active, conflicting_enum_selection());
            } else {};
        };
    } else {};
    if (state.diagnostic == 0u8) {
        state.module_names <- state.used;
        state.first <- state.used;
        resolve_module_types(source, nodes, bindings, work, state, first, selections, selected_used,
            interfaces, published, recovery);
        if (state.diagnostic == 0u8 && recovery.count != 0u64)
            { reject_name(state, recovery.first_site, recovery.first_diagnostic) };
        if (state.diagnostic == 0u8) { resolve_module_bodies(source, nodes, bindings, work, state, first, true); };
    } else {};
    if (state.diagnostic == 0u8) {
        state.scope_node <- tree.root;
        resolve_module_bodies(source, nodes, bindings, work, state, first, false);
    } else {};
    report.node <- state.failed_node;
    report.enclosing_defer <- state.enclosing_defer;
    report.diagnostic <- state.diagnostic;
    return state.diagnostic == 0u8;
}
