using "ParserStorage.cod" callable_head_node;
using "ParserStorage.cod" c_handle_type_node;
using "ParserStorage.cod" c_procedure_node;
using "ParserStorage.cod" data_record_node;
using "ParserStorage.cod" c_record_node;
using "ParserStorage.cod" data_parent_node;
using "ParserStorage.cod" export_node;
using "ParserStorage.cod" handle_parameter_node;
using "ParserStorage.cod" here_parameter_node;
using "ParserStorage.cod" array_declaration_node;
using "ParserStorage.cod" is_function;
using "ParserStorage.cod" parameter_node;
using "ParserStorage.cod" ref_parameter_node;
using "ParserStorage.cod" ptr_parameter_node;
using "ParserStorage.cod" val_parameter_node;
using "ParserStorage.cod" result_clause_node;
using "ParserStorage.cod" throws_clause_node;
using "ParserStorage.cod" owner_clause_node;
using "ParserStorage.cod" readonly_declaration;
using "ParserStorage.cod" typed_name_node;
using "ParserStorage.cod" owned_type_node;
using "ParserStorage.cod" name_node;
using "ParserStorage.cod" field_access_node;
using "ParserStorage.cod" index_access_node;
using "ParserStorage.cod" array_length_node;
using "ParserStorage.cod" symbol_node;
using "ParserStorage.cod" literal_node;
using "ParserStorage.cod" group_node;
using "ParserStorage.cod" integer_arithmetic;
using "ParserStorage.cod" is_transfer;
using "ParserStorage.cod" make_named_node;
using "ParserStorage.cod" construction_body;
using "ParserStorage.cod" construction_type_query_node;
using "ParserStorage.cod" initializer_assignment_node;
using "ParserStorage.cod" call_node;
using "ParserStorage.cod" behave_node;
using "ParserStorage.cod" argument_node;
using "ParserStorage.cod" deferred_call_node;
using "ParserStorage.cod" deferred_block_node;
using "ParserStorage.cod" discard_node;
using "ParserStorage.cod" bool_node;
using "ParserStorage.cod" compare_node;
using "ParserStorage.cod" conditional_node;
using "ParserStorage.cod" range_node;
using "ParserStorage.cod" handle_local;
using "ParserStorage.cod" handle_construction;
using "ParserStorage.cod" owning_handle_local_node;
using "ParserStorage.cod" make_borrowed_handle_node;
using "ParserStorage.cod" here_call_node;
using "ParserStorage.cod" here_receiver_node;
using "ParserStorage.cod" break_node;
using "ParserStorage.cod" continue_node;
using "ParserStorage.cod" narrow_integer_node;
using "ParserStorage.cod" logical_not_node;
using "ParserStorage.cod" logical_binary;
using "ParserStorage.cod" block_node;
using "ParserStorage.cod" full_scope_node;
using "ParserStorage.cod" block_item_node;
using "ParserStorage.cod" try_node;
using "ParserStorage.cod" catch_clause_node;
using "ParserStorage.cod" finally_clause_node;
using "ParserStorage.cod" null_node;
using "ParserStorage.cod" return_node;
using "ParserStorage.cod" throw_node;
using "ParserStorage.cod" local_storage_binding;
using "ExpressionParser.cod" ParseResult;
using "ModuleExports.cod" SelectedExports;
using "ModuleExports.cod" record_export;

data NameBinding {
    kind:u8;
    # A using node records the category supplied by its checked export.
    imported_kind:u8;
    guarded_local:u8;
    declaration:u64;
    # Expressions record the full lexical scope that contains them.
    scope:u64;
    # A scope owns this list. Each guarded declaration links to its predecessor.
    guarded_local_link:u64;
    handle_guard:u64;
}
array NameBindings[u64]:NameBinding;

data NameWorkSlot {
    active:u64;
    next:u64;
}
array NameWork[u64]:NameWorkSlot;

data NameResolutionResult {
    diagnostic:u8;
    node:u64;
    enclosing_defer:u64;
}

data NameState {
    used:u64;
    first:u64;
    module_names:u64;
    scope_node:u64;
    delayed:u64;
    guard:u64;
    loop_arm:bool;
    repeated:bool;
    here_group:bool;
    handoff:u64;
    diagnostic:u8;
    failed_node:u64;
    enclosing_defer:u64;
}

func ordinary_selection() -> u8 { return 1u8; }
func symbolic_selection() -> u8 { return 2u8; }
func callable_binding() -> u8 { return 3u8; }
func formal_binding() -> u8 { return 4u8; }
func local_binding() -> u8 { return 5u8; }
func owner_binding() -> u8 { return 6u8; }
func exception_binding() -> u8 { return 7u8; }
func builtin_u64() -> u8 { return 8u8; }
func builtin_void() -> u8 { return 9u8; }
func lexical_owner() -> u8 { return 10u8; }
func builtin_bool() -> u8 { return 11u8; }
func c_handle_type() -> u8 { return 12u8; }
func record_type() -> u8 { return 13u8; }
func c_constructor() -> u8 { return 14u8; }
func c_operation() -> u8 { return 15u8; }
func c_entry() -> u8 { return 16u8; }
func builtin_u8() -> u8 { return 17u8; }
func builtin_u32() -> u8 { return 18u8; }
func builtin_i64() -> u8 { return 19u8; }
func builtin_f32() -> u8 { return 20u8; }
func builtin_f64() -> u8 { return 21u8; }
func array_type() -> u8 { return 22u8; }
func loop_index() -> u8 { return 23u8; }
func handle_binding() -> u8 { return 24u8; }
func here_receiver_binding() -> u8 { return 25u8; }

func native_scalar(kind:u8) -> bool {
    return kind == builtin_u64() || kind == builtin_bool() || (kind >= builtin_u8() && kind <= builtin_f64());
}

func unresolved_name() -> u8 { return 1u8; }
func expected_symbol_binding() -> u8 { return 2u8; }
func expected_type_binding() -> u8 { return 3u8; }
func expected_owner_binding() -> u8 { return 4u8; }
func duplicate_binding() -> u8 { return 5u8; }
func unproved_module_binding() -> u8 { return 6u8; }
func unproved_guard_binding() -> u8 { return 7u8; }
func invalid_module_tree() -> u8 { return 8u8; }
func name_storage_exhausted() -> u8 { return 9u8; }
func nested_defer_in_drain() -> u8 { return 10u8; }
func declaration_in_deferred_group() -> u8 { return 11u8; }
func dynamic_symbol_in_function() -> u8 { return 12u8; }
func unsupported_module_declaration() -> u8 { return 13u8; }
func unsupported_ordinary_construction() -> u8 { return 37u8; }
func unsupported_initializer_rebind() -> u8 { return 46u8; }
func unsupported_repeated_defer() -> u8 { return 47u8; }
func unsupported_repeated_construction() -> u8 { return 48u8; }
func declaration_in_loop_arm() -> u8 { return 49u8; }
func native_acquisition_in_function() -> u8 { return 50u8; }
func repeated_handle_acquisition() -> u8 { return 51u8; }
func declaration_in_here_group() -> u8 { return 61u8; }
func missing_here_control() -> u8 { return 62u8; }
func unsupported_here_group_storage() -> u8 { return 63u8; }
func owner_without_input() -> u8 { return 72u8; }
func owner_without_writable_input() -> u8 { return 73u8; }
func expected_value_binding() -> u8 { return 14u8; }

func reject_name(ref state:NameState in R, node:u64, diagnostic:u8) -> void where {owner R} {
    state.diagnostic <- diagnostic;
    (state.failed_node <- node):void;
}

func remember(ref bindings:NameBindings in B, at:u64, declaration:u64, kind:u8) -> void where {owner B} {
    bindings[at].kind <- kind;
    bindings[at].declaration <- declaration;
    return;
}

func spelling_start(nodes:const ExprNodes in N, at:u64) -> u64 where {const owner N} {
    if (nodes[at].kind == symbol_node()) { return nodes[at].first + 1u64; } else {};
    return nodes[at].first;
}

func same_name(source:const SourceBytes in S, nodes:const ExprNodes in N, left:u64, right:u64) -> bool
    where {const owner S, const owner N} {
    val start <- spelling_start(nodes, left);
    val other <- spelling_start(nodes, right);
    val length <- nodes[left].past - start;
    if (length != nodes[right].past - other) { return false; } else {};
    for (offset in 0u64 .. length) {
        if (source[start + offset] != source[other + offset]) { return false; } else {};
    };
    return true;
}

func lookup(source:const SourceBytes in S, nodes:const ExprNodes in N, work:const NameWork in W,
            name:u64, first:u64, past:u64) -> u64 where {const owner S, const owner N, const owner W} {
    val candidate <- no_node();
    for (offset in 0u64 .. past - first) {
        candidate <- work[past - offset - 1u64].active;
        if (same_name(source, nodes, name, candidate)) { return candidate; } else {};
    };
    return no_node();
}

func declare_name(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                   ref work:NameWork in W, ref state:NameState in R, name:u64, declaration:u64, kind:u8,
                   duplicate:u8) -> void where {const owner S, const owner N, owner B, owner W, owner R} {
    if (lookup(source, nodes, work, name, state.first, state.used) != no_node()) {
        reject_name(state, name, duplicate);
        return;
    } else {};
    remember(bindings, name, declaration, kind);
    work[state.used].active <- name;
    (state.used <- state.used + 1u64):void;
}

func handle_available(nodes:const ExprNodes in N, bindings:const NameBindings in B,
                      declaration:u64, use:u64) -> bool where {const owner N, const owner B} {
    val guard <- bindings[declaration].handle_guard;
    return guard == no_node() || (nodes[guard].first <= nodes[use].first && nodes[use].past <= nodes[guard].past);
}

func resolve_value(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                    work:const NameWork in W, ref state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
    val kind <- bindings[found].kind;
    val declaration <- bindings[found].declaration;
    if (kind == c_handle_type() || kind == record_type() || kind == array_type()) {
        reject_name(state, name, expected_value_binding());
        return;
    } else {};
    if (kind == handle_binding() && !handle_available(nodes, bindings, declaration, name)) {
        reject_name(state, name, unproved_guard_binding());
        return;
    } else {};
    if (nodes[name].kind == symbol_node()) {
        if (kind != symbolic_selection()) { reject_name(state, name, expected_symbol_binding()); return; } else {};
        if (is_function(nodes, enclosing_callable(nodes, bindings, state.scope_node))) {
            reject_name(state, name, dynamic_symbol_in_function());
            return;
        } else {};
    } else {};
    remember(bindings, name, declaration, kind);
}

func resolve_owner(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                    work:const NameWork in W, ref state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val first <- nodes[name].first;
    # The explicit lexical owner 'here' denotes this full scope.
    if (nodes[name].past - first == 4u64 && source[first] == 104u8 && source[first + 1u64] == 101u8 &&
        source[first + 2u64] == 114u8 && source[first + 3u64] == 101u8) {
        remember(bindings, name, state.scope_node, lexical_owner());
        return;
    } else {};
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
    if (bindings[found].kind != owner_binding()) { reject_name(state, name, expected_owner_binding()); return; } else {};
    remember(bindings, name, bindings[found].declaration, owner_binding());
}

func scalar_name(source:const SourceBytes in S, nodes:const ExprNodes in N, name:u64) -> u8
    where {const owner S, const owner N} {
    val first <- nodes[name].first;
    val length <- nodes[name].past - first;
    if (length == 3u64 && source[first] == 117u8 && source[first + 1u64] == 54u8 && source[first + 2u64] == 52u8) {
        return builtin_u64();
    } else {};
    if (length == 4u64) {
        if (source[first] == 118u8 && source[first + 1u64] == 111u8 &&
            source[first + 2u64] == 105u8 && source[first + 3u64] == 100u8) { return builtin_void(); } else {};
        if (source[first] == 98u8 && source[first + 1u64] == 111u8 &&
            source[first + 2u64] == 111u8 && source[first + 3u64] == 108u8) { return builtin_bool(); } else {};
    } else {};
    if (length == 2u64 && source[first] == 117u8 && source[first + 1u64] == 56u8) { return builtin_u8(); } else {};
    if (length != 3u64) { return 0u8; } else {};
    val initial <- source[first];
    val tens <- source[first + 1u64];
    val ones <- source[first + 2u64];
    if (tens == 51u8 && ones == 50u8) { # 32
        if (initial == 117u8) { return builtin_u32(); } else {};
        if (initial == 102u8) { return builtin_f32(); } else {};
    } else {};
    if (tens == 54u8 && ones == 52u8) { # 64
        if (initial == 105u8) { return builtin_i64(); } else {};
        if (initial == 102u8) { return builtin_f64(); } else {};
    } else {};
    return 0u8;
}

func resolve_type_name(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                        work:const NameWork in W, ref state:NameState in R, name:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val built_in <- scalar_name(source, nodes, name);
    if (built_in != 0u8) {
        remember(bindings, name, no_node(), built_in);
        return;
    } else {};
    val found <- lookup(source, nodes, work, name, 0u64, state.module_names);
    if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
    val kind <- bindings[found].kind;
    if (kind != ordinary_selection() && kind != c_handle_type() && kind != record_type() && kind != array_type()) {
        reject_name(state, name, expected_type_binding());
        return;
    } else {};
    remember(bindings, name, bindings[found].declaration, kind);
}

func resolve_annotation(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                         work:const NameWork in W, ref state:NameState in R, binding:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    if (nodes[binding].kind != typed_name_node()) { return; } else {};
    val annotation <- nodes[binding].right;
    if (nodes[annotation].kind != owned_type_node()) {
        resolve_type_name(source, nodes, bindings, work, state, annotation);
        return;
    } else {};
    resolve_type_name(source, nodes, bindings, work, state, nodes[annotation].left);
    if (state.diagnostic == 0u8) {
        resolve_owner(source, nodes, bindings, work, state, nodes[annotation].right);
    } else {};
}

func binder_name(nodes:const ExprNodes in N, binding:u64) -> u64 where {const owner N} {
    if (nodes[binding].kind == typed_name_node()) { return nodes[binding].left; } else {};
    return binding;
}

func formal(kind:u8) -> bool {
    return kind == parameter_node() || kind == ref_parameter_node() ||
        kind == ptr_parameter_node() || kind == val_parameter_node() ||
        kind == handle_parameter_node() || kind == here_parameter_node();
}

func list_entry(kind:u8) -> bool {
    return kind == module_item_node() || kind == block_item_node() || kind == argument_node() ||
        kind == catch_clause_node() || kind == finally_clause_node() ||
        kind == result_clause_node() || kind == throws_clause_node() || kind == owner_clause_node() ||
        kind == here_receiver_node() || formal(kind);
}

func link_entries(nodes:const ExprNodes in N, ref work:NameWork in W, used:u64) -> void
    where {const owner N, owner W} {
    val previous <- no_node();
    for (at in 0u64 .. used) {
        work[at].next <- no_node();
        if (list_entry(nodes[at].kind)) {
            previous <- nodes[at].left;
            if (previous != no_node()) { work[previous].next <- at; {}; } else {};
        } else {};
    };
}

func first_item(nodes:const ExprNodes in N, tail:u64) -> u64 where {const owner N} {
    if (tail == no_node()) { return tail; } else {};
    val current <- tail;
    for (unused in 0u64 .. tail + 1u64) {
        if (nodes[current].left == no_node()) { return current; } else {};
        (current <- nodes[current].left):void;
    };
    return no_node();
}

func signature_head(nodes:const ExprNodes in N, tail:u64) -> u64 where {const owner N} {
    val header <- tail;
    for (unused in 0u64 .. tail + 1u64) {
        if (nodes[header].kind == callable_head_node()) { return header; } else {};
        (header <- nodes[header].left):void;
    };
    return no_node();
}

func callable_head(nodes:const ExprNodes in N, definition:u64) -> u64 where {const owner N} {
    return signature_head(nodes, nodes[definition].left);
}

func signature_clause(nodes:const ExprNodes in N, tail:u64, kind:u8) -> u64 where {const owner N} {
    val clause <- tail;
    for (unused in 0u64 .. tail + 1u64) {
        if (nodes[clause].kind == kind) { return clause; } else {};
        if (nodes[clause].kind == callable_head_node()) { return no_node(); } else {};
        (clause <- nodes[clause].left):void;
    };
    return no_node();
}

func enclosing_callable(nodes:const ExprNodes in N, names:const NameBindings in B, scope:u64) -> u64
    where {const owner N, const owner B} {
    if (scope == no_node()) { return scope; } else {};
    val site <- scope;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (site == no_node() || nodes[site].kind != full_scope_node()) { return site; } else {};
        (site <- names[site].scope):void;
    };
    return no_node();
}

# Lists link forward in the temporary workspace. Traversing a wide block or
# parameter list does not recurse through its preceding siblings.
func resolve_list(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                   ref work:NameWork in W, ref state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val item <- first_item(nodes, tail);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) { return; } else {};
        bindings[item].scope <- state.scope_node;
        resolve_expression(source, nodes, bindings, work, state, nodes[item].right);
        if (state.diagnostic != 0u8 || item == tail) { return; } else {};
        (item <- work[item].next):void;
    };
}

func resolve_full_scope(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                        ref work:NameWork in W, ref state:NameState in R, scope:u64, first_local:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val used <- state.used;
    val first <- state.first;
    val scope_node <- state.scope_node;
    val guard <- state.guard;
    val delayed <- state.delayed;
    val loop_arm <- state.loop_arm;
    val repeated <- state.repeated;
    val here_group <- state.here_group;
    val handoff <- state.handoff;
    state.first <- first_local;
    state.scope_node <- scope;
    state.guard <- no_node();
    state.delayed <- no_node();
    state.loop_arm <- false;
    state.repeated <- false;
    state.here_group <- false;
    state.handoff <- no_node();
    resolve_list(source, nodes, bindings, work, state, nodes[scope].left);
    state.used <- used;
    state.first <- first;
    state.scope_node <- scope_node;
    state.delayed <- delayed;
    state.loop_arm <- loop_arm;
    state.repeated <- repeated;
    state.here_group <- here_group;
    state.handoff <- handoff;
    (state.guard <- guard):void;
}

func resolve_handler(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      ref work:NameWork in W, ref state:NameState in R, handler:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val binding <- nodes[handler].left;
    val annotation <- nodes[binding].right;
    if (annotation != no_node()) {
        resolve_type_name(source, nodes, bindings, work, state, annotation);
        if (state.diagnostic != 0u8) { return; } else {};
    } else {};
    val used <- state.used;
    val first <- state.first;
    state.first <- used;
    declare_name(source, nodes, bindings, work, state, nodes[binding].left, binding, exception_binding(), duplicate_binding());
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, nodes[handler].right);
    } else {};
    state.used <- used;
    (state.first <- first):void;
}

func resolve_clauses(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      ref work:NameWork in W, ref state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val clause <- first_item(nodes, tail);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) { return; } else {};
        if (nodes[clause].kind == catch_clause_node()) {
            state.guard <- nodes[nodes[clause].right].right;
            resolve_handler(source, nodes, bindings, work, state, nodes[clause].right);
        } else {
            state.guard <- nodes[clause].right;
            resolve_expression(source, nodes, bindings, work, state, nodes[clause].right);
        };
        if (state.diagnostic != 0u8 || clause == tail) { return; } else {};
        (clause <- work[clause].next):void;
    };
}

func resolve_try(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                  ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val guard <- state.guard;
    val body <- nodes[at].left;
    state.guard <- body;
    resolve_expression(source, nodes, bindings, work, state, body);
    if (state.diagnostic == 0u8) {
        resolve_clauses(source, nodes, bindings, work, state, nodes[at].right);
    } else {};
    (state.guard <- guard):void;
}

func local_declaration_allowed(ref state:NameState in R, at:u64) -> bool where {owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return false;
    } else {};
    if (state.loop_arm) { reject_name(state, at, declaration_in_loop_arm()); return false; } else {};
    if (state.here_group) { reject_name(state, at, declaration_in_here_group()); return false; } else {};
    return true;
}

func resolve_local(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                   ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (!local_declaration_allowed(state, at)) { return; } else {};
    val binding <- nodes[at].left;
    resolve_annotation(source, nodes, bindings, work, state, binding);
    if (state.diagnostic != 0u8) { return; } else {};
    resolve_expression(source, nodes, bindings, work, state, nodes[at].right);
    if (state.diagnostic != 0u8) { return; } else {};
    declare_name(source, nodes, bindings, work, state, binder_name(nodes, binding), at, local_binding(), duplicate_binding());
    if (state.diagnostic == 0u8 && state.guard != no_node()) {
        val scope <- state.scope_node;
        bindings[at].guarded_local <- 1u8;
        bindings[at].guarded_local_link <- bindings[scope].guarded_local_link;
        (bindings[scope].guarded_local_link <- at):void;
    } else {};
}

func resolve_handle_owner(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                          work:const NameWork in W, ref state:NameState in R, name:u64, lexical:bool) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val found <- lookup(source, nodes, work, name, 0u64, state.used);
    if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
    val declaration <- bindings[found].declaration;
    val kind <- bindings[found].kind;
    if (kind == handle_binding() && !handle_available(nodes, bindings, declaration, name)) {
        reject_name(state, name, unproved_guard_binding());
        return;
    } else {};
    if ((kind == handle_binding() && nodes[declaration].kind == owning_handle_local_node()) ||
        (!lexical && kind == owner_binding())) {
        remember(bindings, name, declaration, kind);
    } else { reject_name(state, name, expected_owner_binding()); };
}

func resolve_handle_local(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                          ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (!local_declaration_allowed(state, at)) { return; } else {};
    val binding <- nodes[at].left;
    val annotation <- nodes[binding].right;
    val explicit_owner <- nodes[annotation].kind == owned_type_node();
    val marker <- if (explicit_owner) { (nodes[annotation].left) } else { annotation };
    resolve_type_name(source, nodes, bindings, work, state, marker);
    if (state.diagnostic != 0u8) { return; } else {};
    if (explicit_owner) {
        resolve_handle_owner(source, nodes, bindings, work, state, nodes[annotation].right, false);
        if (state.diagnostic != 0u8) { return; } else {};
    } else {};
    resolve_expression(source, nodes, bindings, work, state, nodes[at].right);
    if (state.diagnostic != 0u8) { return; } else {};
    declare_name(source, nodes, bindings, work, state, binder_name(nodes, binding), at, handle_binding(), duplicate_binding());
    # A use within the same guard follows its successful binding. A sibling
    # or joined path needs a proof beyond source containment.
    if (state.diagnostic == 0u8) { (bindings[at].handle_guard <- state.guard):void; } else {};
}

func resolve_handle_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                                 ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated) { reject_name(state, at, repeated_handle_acquisition()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    if (is_function(nodes, enclosing_callable(nodes, bindings, state.scope_node))) {
        reject_name(state, at, native_acquisition_in_function());
        return;
    } else {};
    resolve_type_name(source, nodes, bindings, work, state, nodes[at].left);
    if (state.diagnostic != 0u8) { return; } else {};
    if (nodes[at].kind == make_borrowed_handle_node()) {
        resolve_handle_owner(source, nodes, bindings, work, state, nodes[at].number, true);
        if (state.diagnostic != 0u8) { return; } else {};
    } else {};
    resolve_list(source, nodes, bindings, work, state, nodes[at].right);
}

func resolve_defer(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                   ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, nested_defer_in_drain());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated) { reject_name(state, at, unsupported_repeated_defer()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    if (nodes[at].kind == deferred_block_node()) { state.delayed <- at; {}; } else {};
    resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
    state.delayed <- no_node();
    return;
}

func resolve_record_initializer(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                                 ref work:NameWork in W, ref state:NameState in R, body:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (body == no_node()) { return; } else {};
    val tail <- nodes[body].left;
    val item <- first_item(nodes, tail);
    val field <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) { return; } else {};
        field <- nodes[item].right;
        if (nodes[field].kind != initializer_assignment_node() || nodes[nodes[field].left].kind != name_node()) {
            reject_name(state, field, unsupported_ordinary_construction());
            return;
        } else {};
        resolve_expression(source, nodes, bindings, work, state, nodes[field].right);
        if (state.diagnostic != 0u8 || item == tail) { return; } else {};
        (item <- work[item].next):void;
    };
}

func resolve_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                          ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (state.delayed != no_node()) {
        reject_name(state, at, declaration_in_deferred_group());
        state.enclosing_defer <- state.delayed;
        return;
    } else {};
    if (state.repeated) { reject_name(state, at, unsupported_repeated_construction()); return; } else {};
    if (state.here_group) { reject_name(state, at, unsupported_here_group_storage()); return; } else {};
    val requested <- nodes[at].left;
    val record_initializer <- false;
    if (nodes[requested].kind == construction_type_query_node()) {
        resolve_expression(source, nodes, bindings, work, state, nodes[requested].left);
    } else {
        resolve_type_name(source, nodes, bindings, work, state, requested);
        if (state.diagnostic != 0u8) { return; } else {};
        val kind <- bindings[requested].kind;
        val definition <- bindings[requested].declaration;
        record_initializer <- (kind == record_type() && nodes[nodes[definition].left].kind != data_parent_node()) ||
            (kind == ordinary_selection() && bindings[definition].imported_kind == record_export());
        if (!record_initializer && !native_scalar(kind) && kind != builtin_void()) {
            reject_name(state, at, unsupported_ordinary_construction());
            return;
        } else {};
    };
    if (state.diagnostic != 0u8) { return; } else {};
    val owner_name <- nodes[nodes[at].right].right;
    if (owner_name != no_node()) {
        resolve_owner(source, nodes, bindings, work, state, owner_name);
        if (state.diagnostic != 0u8) { return; } else {};
    } else {};
    val body <- construction_body(nodes, at);
    if (record_initializer) {
        resolve_record_initializer(source, nodes, bindings, work, state, body);
    } else { resolve_expression(source, nodes, bindings, work, state, body); };
}

func resolve_range(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                   ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val header <- nodes[at].left;
    bindings[header].scope <- state.scope_node;
    resolve_expression(source, nodes, bindings, work, state, nodes[header].left);
    if (state.diagnostic != 0u8) { return; } else {};
    resolve_expression(source, nodes, bindings, work, state, nodes[header].right);
    if (state.diagnostic != 0u8) { return; } else {};

    val used <- state.used;
    val first <- state.first;
    val enclosing_arm <- state.loop_arm;
    val repeated <- state.repeated;
    val handoff <- state.handoff;
    state.first <- used;
    state.loop_arm <- true;
    state.repeated <- true;
    state.handoff <- no_node();
    declare_name(source, nodes, bindings, work, state, nodes[header].number, header, loop_index(), duplicate_binding());
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].right);
    } else {};
    state.used <- used;
    state.first <- first;
    state.repeated <- repeated;
    if (state.diagnostic == 0u8) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].number);
    } else {};
    state.handoff <- handoff;
    (state.loop_arm <- enclosing_arm):void;
}

func resolve_here_receivers(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                            ref work:NameWork in W, ref state:NameState in R, tail:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val receiver <- first_item(nodes, tail);
    val binding <- no_node();
    val annotation <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (receiver == no_node()) { return; } else {};
        binding <- nodes[receiver].right;
        if (nodes[binding].kind == typed_name_node()) {
            annotation <- nodes[binding].right;
            if (nodes[annotation].kind == owned_type_node()) {
                resolve_type_name(source, nodes, bindings, work, state, nodes[annotation].left);
                if (state.diagnostic != 0u8) { return; } else {};
                resolve_handle_owner(source, nodes, bindings, work, state, nodes[annotation].right, false);
            } else {
                resolve_type_name(source, nodes, bindings, work, state, annotation);
            };
            if (state.diagnostic != 0u8) { return; } else {};
        } else {};
        declare_name(source, nodes, bindings, work, state, binder_name(nodes, binding),
                     receiver, here_receiver_binding(), duplicate_binding());
        if (state.diagnostic != 0u8) { return; } else {};
        (receiver <- work[receiver].next):void;
    };
}

func resolve_here_call(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                       ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
    if (state.diagnostic != 0u8) { return; } else {};
    val supplied <- nodes[at].right;
    val body <- nodes[supplied].right;
    val first <- state.first;
    val used <- state.used;
    val group <- state.here_group;
    val target <- state.handoff;
    state.first <- used;
    resolve_here_receivers(source, nodes, bindings, work, state, nodes[supplied].left);
    if (state.diagnostic == 0u8) {
        if (nodes[body].kind == full_scope_node()) {
            bindings[body].scope <- state.scope_node;
            resolve_full_scope(source, nodes, bindings, work, state, body, used);
        } else {
            state.here_group <- true;
            state.handoff <- at;
            resolve_expression(source, nodes, bindings, work, state, body);
        };
    } else {};
    state.used <- used;
    state.first <- first;
    state.here_group <- group;
    (state.handoff <- target):void;
}

func resolve_expression(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                         ref work:NameWork in W, ref state:NameState in R, at:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (at == no_node()) { return; } else {};
    bindings[at].scope <- state.scope_node;
    val kind <- nodes[at].kind;
    if (kind == literal_node() || kind == narrow_integer_node() || kind == bool_node()) { return; } else {};
    if (kind == name_node() || kind == symbol_node()) {
        resolve_value(source, nodes, bindings, work, state, at);
        return;
    } else {};
    if (kind == block_node()) { resolve_list(source, nodes, bindings, work, state, nodes[at].left); return; } else {};
    if (kind == full_scope_node()) { resolve_full_scope(source, nodes, bindings, work, state, at, state.used); return; } else {};
    if (kind == try_node()) { resolve_try(source, nodes, bindings, work, state, at); return; } else {};
    if (kind == range_node()) { resolve_range(source, nodes, bindings, work, state, at); return; } else {};
    if (kind == here_call_node()) { resolve_here_call(source, nodes, bindings, work, state, at); return; } else {};
    if (kind == continue_node() || kind == break_node()) {
        if (state.handoff == no_node()) { reject_name(state, at, missing_here_control()); return; } else {};
        bindings[at].declaration <- state.handoff;
        resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
        return;
    } else {};
    if (kind == conditional_node()) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
        if (state.diagnostic != 0u8) { return; } else {};
        val guard <- state.guard;
        val chosen <- nodes[at].right;
        state.guard <- chosen;
        resolve_expression(source, nodes, bindings, work, state, chosen);
        if (state.diagnostic == 0u8) {
            state.guard <- nodes[at].number;
            resolve_expression(source, nodes, bindings, work, state, nodes[at].number);
        } else {};
        state.guard <- guard;
        return;
    } else {};
    if (local_storage_binding(kind)) {
        resolve_local(source, nodes, bindings, work, state, at);
        return;
    } else {};
    if (handle_local(kind)) {
        resolve_handle_local(source, nodes, bindings, work, state, at);
        return;
    } else {};
    if (handle_construction(kind)) {
        resolve_handle_construction(source, nodes, bindings, work, state, at);
        return;
    } else {};
    if (kind == make_named_node()) { resolve_construction(source, nodes, bindings, work, state, at); return; } else {};
    if (kind == initializer_assignment_node() && !is_transfer(nodes, at)) {
        reject_name(state, at, unsupported_initializer_rebind());
        return;
    } else {};
    if (kind == null_node()) {
        if (nodes[at].left != no_node()) { resolve_owner(source, nodes, bindings, work, state, nodes[at].left); } else {};
        return;
    } else {};
    if (kind == deferred_call_node() || kind == deferred_block_node()) {
        resolve_defer(source, nodes, bindings, work, state, at);
        return;
    } else {};
    if (kind == group_node() || kind == discard_node() || kind == return_node() || kind == throw_node() ||
        kind == logical_not_node() || kind == field_access_node() || kind == array_length_node()) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
        return;
    } else {};
    if (kind == call_node() || kind == behave_node()) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
        if (state.diagnostic == 0u8) { resolve_list(source, nodes, bindings, work, state, nodes[at].right); } else {};
        return;
    } else {};
    if (integer_arithmetic(kind) || kind == compare_node() || kind == index_access_node() || is_transfer(nodes, at) ||
        logical_binary(kind)) {
        resolve_expression(source, nodes, bindings, work, state, nodes[at].left);
        if (state.diagnostic != 0u8) { return; } else {};
        val enclosing_guard <- state.guard;
        if (logical_binary(kind)) { (state.guard <- nodes[at].right):void; } else {};
        resolve_expression(source, nodes, bindings, work, state, nodes[at].right);
        state.guard <- enclosing_guard;
        return;
    } else {};
    reject_name(state, at, invalid_module_tree());
}

func record_declaration(kind:u8) -> bool {
    return kind == data_record_node() || kind == c_record_node();
}

func declaration_requires_native_output(kind:u8) -> bool {
    return kind == c_handle_type_node() || record_declaration(kind) || kind == array_declaration_node() ||
        kind == c_procedure_node() || kind == export_node() || kind == export_from_node();
}

func type_declaration_name(nodes:const ExprNodes in N, form:u64) -> u64 where {const owner N} {
    val head <- nodes[form].left;
    if (nodes[head].kind == data_parent_node()) { return nodes[head].left; } else {};
    return head;
}

func definition_name(nodes:const ExprNodes in N, form:u64) -> u64 where {const owner N} {
    if (nodes[form].kind == callable_node() || nodes[form].kind == c_procedure_node()) {
        return nodes[callable_head(nodes, form)].left;
    } else {};
    return type_declaration_name(nodes, form);
}

func same_selected_identity(selected:const SelectedExports in E, left:u64, right:u64) -> bool
    where {const owner E} {
    return selected[left].kind == selected[right].kind &&
        selected[left].origin_module == selected[right].origin_module && selected[left].identity == selected[right].identity;
}

func register_module(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      selected:const SelectedExports in E, ref work:NameWork in W, ref state:NameState in R,
                      first:u64, allow_families:bool) -> void
    where {const owner S, const owner N, owner B, const owner E, owner W, owner R} {
    val item <- first;
    val form <- no_node();
    val form_kind <- 0u8;
    val name <- no_node();
    val found <- no_node();
    val kind <- ordinary_selection();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) { return; } else {};
        form <- nodes[item].right;
        form_kind <- nodes[form].kind;
        if (form_kind == c_handle_type_node() || record_declaration(form_kind) || form_kind == array_declaration_node()) {
            kind <- if (form_kind == c_handle_type_node()) { c_handle_type() } else {
                if (form_kind == array_declaration_node()) { array_type() } else { record_type() }
            };
            declare_name(source, nodes, bindings, work, state, type_declaration_name(nodes, form), form, kind, duplicate_binding());
        } else {};
        if (form_kind == using_node()) {
            name <- nodes[form].right;
            if (nodes[form].number != 0u64) { (name <- nodes[form].number - 1u64):void; } else {};
            kind <- if (nodes[name].kind == symbol_node()) { symbolic_selection() } else { ordinary_selection() };
            found <- lookup(source, nodes, work, name, 0u64, state.used);
            if (found != no_node() && bindings[found].kind == kind &&
                same_selected_identity(selected, bindings[found].declaration, form)) {
                remember(bindings, name, bindings[found].declaration, kind);
            } else {
                declare_name(source, nodes, bindings, work, state, name, form, kind, unproved_module_binding());
            };
        } else {};
        if (form_kind == callable_node()) {
            name <- definition_name(nodes, form);
            found <- lookup(source, nodes, work, name, 0u64, state.used);
            if (allow_families && found != no_node() && bindings[found].kind == callable_binding()) {
                remember(bindings, name, bindings[found].declaration, callable_binding());
            } else {
                declare_name(source, nodes, bindings, work, state, name, form, callable_binding(), unproved_module_binding());
            };
            remember(bindings, form, bindings[name].declaration, callable_binding());
        } else {};
        if (state.diagnostic != 0u8) { return; } else {};
        (item <- work[item].next):void;
    };
}

func register_c_procedure(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                          ref work:NameWork in W, ref state:NameState in R, form:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val header <- nodes[form].left;
    val name <- nodes[signature_head(nodes, header)].left;
    if (nodes[form].right == no_node() && signature_clause(nodes, header, result_clause_node()) == no_node()) {
        val found <- lookup(source, nodes, work, name, 0u64, state.used);
        if (found != no_node() && bindings[found].kind == c_handle_type()) {
            val marker <- bindings[found].declaration;
            remember(bindings, name, marker, c_handle_type());
            remember(bindings, form, marker, c_constructor());
            return;
        } else {};
    } else {};
    val kind <- if (nodes[form].right == no_node()) { c_operation() } else { c_entry() };
    declare_name(source, nodes, bindings, work, state, name, form, kind, duplicate_binding());
    remember(bindings, form, form, kind);
}

func register_native_procedures(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                                ref work:NameWork in W, ref state:NameState in R, first:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val item <- first;
    val form <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) { return; } else {};
        form <- nodes[item].right;
        if (nodes[form].kind == c_procedure_node()) {
            register_c_procedure(source, nodes, bindings, work, state, form);
            if (state.diagnostic != 0u8) { return; } else {};
        } else {};
        (item <- work[item].next):void;
    };
}

func register_owners(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      ref work:NameWork in W, ref state:NameState in R, head:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val clause <- work[head].next;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) { return; } else {};
        if (nodes[clause].kind == owner_clause_node()) {
            declare_name(source, nodes, bindings, work, state, nodes[clause].right, clause, owner_binding(), duplicate_binding());
            if (state.diagnostic != 0u8) { return; } else {};
        } else {};
        (clause <- work[clause].next):void;
    };
}

func resolve_header_types(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                           work:const NameWork in W, ref state:NameState in R, head:u64) -> void
    where {const owner S, const owner N, owner B, const owner W, owner R} {
    val clause <- work[head].next;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) { return; } else {};
        if (nodes[clause].kind != owner_clause_node()) {
            resolve_type_name(source, nodes, bindings, work, state, nodes[clause].right);
            if (state.diagnostic != 0u8) { return; } else {};
        } else {};
        (clause <- work[clause].next):void;
    };
}

func resolve_formals(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      ref work:NameWork in W, ref state:NameState in R, first:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val parameter <- first;
    val binding <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (parameter == no_node()) { return; } else {};
        if (nodes[parameter].kind == here_parameter_node()) {
            resolve_here_formal(source, nodes, bindings, work, state, parameter);
        } else {
            binding <- nodes[parameter].right;
            resolve_annotation(source, nodes, bindings, work, state, binding);
            if (state.diagnostic != 0u8) { return; } else {};
            declare_name(source, nodes, bindings, work, state, binder_name(nodes, binding),
                         parameter, formal_binding(), duplicate_binding());
        };
        if (state.diagnostic != 0u8) { return; } else {};
        (parameter <- work[parameter].next):void;
    };
}

func resolve_here_formal(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                         ref work:NameWork in W, ref state:NameState in R, callback_entry:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val callback <- signature_head(nodes, nodes[callback_entry].right);
    val enclosing_first <- state.first;
    val enclosing_used <- state.used;
    state.first <- enclosing_used;
    resolve_header_types(source, nodes, bindings, work, state, callback);
    if (state.diagnostic != 0u8) { return; } else {};
    resolve_formals(source, nodes, bindings, work, state, first_item(nodes, nodes[callback].right));
    if (state.diagnostic != 0u8) { return; } else {};
    state.first <- enclosing_first;
    state.used <- enclosing_used;
    # Only the callback's name enters the receiver's parameter scope.
    declare_name(source, nodes, bindings, work, state, nodes[callback].left, callback_entry, formal_binding(), duplicate_binding());
}

func has_owner_input(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                     first:u64, clause:u64) -> bool where {const owner N, const owner B, const owner W} {
    val readonly_owner <- nodes[clause].number == readonly_declaration();
    val input <- first;
    val binding <- no_node();
    val annotation <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (input == no_node()) { return false; } else {};
        if (nodes[input].kind != here_parameter_node()) {
            binding <- nodes[input].right;
            annotation <- nodes[binding].right;
            if (nodes[annotation].kind == owned_type_node() &&
                bindings[nodes[annotation].right].declaration == clause &&
                (readonly_owner || nodes[binding].number != readonly_declaration())) { return true; } else {};
        } else {};
        (input <- work[input].next):void;
    };
    return false;
}

func check_owner_inputs(nodes:const ExprNodes in N, bindings:const NameBindings in B, work:const NameWork in W,
                        ref state:NameState in R, head:u64) -> void
    where {const owner N, const owner B, const owner W, owner R} {
    val first <- first_item(nodes, nodes[head].right);
    val clause <- work[head].next;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) { return; } else {};
        if (nodes[clause].kind == owner_clause_node() && !has_owner_input(nodes, bindings, work, first, clause)) {
            reject_name(state, clause, if (nodes[clause].number == readonly_declaration()) {
                owner_without_input()
            } else { owner_without_writable_input() });
            return;
        } else {};
        (clause <- work[clause].next):void;
    };
}

func resolve_callable(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                      ref work:NameWork in W, ref state:NameState in R, definition:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val head <- callable_head(nodes, definition);
    val native <- nodes[definition].kind == c_procedure_node();
    state.scope_node <- definition;
    register_owners(source, nodes, bindings, work, state, head);
    if (state.diagnostic != 0u8) { return; } else {};
    resolve_header_types(source, nodes, bindings, work, state, head);
    if (state.diagnostic != 0u8) { return; } else {};
    resolve_formals(source, nodes, bindings, work, state, first_item(nodes, nodes[head].right));
    if (state.diagnostic == 0u8 && !native) { check_owner_inputs(nodes, bindings, work, state, head); } else {};
    if (state.diagnostic != 0u8) { return; } else {};
    if (nodes[definition].right != no_node()) {
        resolve_expression(source, nodes, bindings, work, state, nodes[definition].right);
    } else {};
    (state.used <- state.module_names):void;
}

func resolve_type_declaration(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                              ref work:NameWork in W, ref state:NameState in R, form:u64) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    if (nodes[form].kind == c_handle_type_node()) {
        if (nodes[form].right != no_node()) {
            resolve_type_name(source, nodes, bindings, work, state, nodes[form].right);
        } else {};
        return;
    } else {};
    if (nodes[form].kind == array_declaration_node()) {
        val shape <- nodes[form].right;
        resolve_type_name(source, nodes, bindings, work, state, nodes[shape].left);
        if (state.diagnostic == 0u8) { resolve_type_name(source, nodes, bindings, work, state, nodes[shape].right); } else {};
        return;
    } else {};
    val header <- nodes[form].left;
    if (nodes[header].kind == data_parent_node()) {
        resolve_type_name(source, nodes, bindings, work, state, nodes[header].right);
        if (state.diagnostic != 0u8) { return; } else {};
    } else {};
    resolve_formals(source, nodes, bindings, work, state, first_item(nodes, nodes[form].right));
    (state.used <- state.module_names):void;
}

func resolve_module_form(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                         ref work:NameWork in W, ref state:NameState in R, form:u64, definitions:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val kind <- nodes[form].kind;
    if (!definitions) {
        if (kind != callable_node() && kind != using_node() && !declaration_requires_native_output(kind)) {
            resolve_expression(source, nodes, bindings, work, state, form);
        } else {};
        return;
    } else {};
    if (kind == callable_node() || kind == c_procedure_node()) {
        resolve_callable(source, nodes, bindings, work, state, form);
        return;
    } else {};
    if (kind == c_handle_type_node() || record_declaration(kind) || kind == array_declaration_node()) {
        resolve_type_declaration(source, nodes, bindings, work, state, form);
        return;
    } else {};
    if (kind == export_node()) {
        val name <- nodes[form].left;
        val found <- lookup(source, nodes, work, name, 0u64, state.module_names);
        if (found == no_node()) { reject_name(state, name, unresolved_name()); return; } else {};
        if ((nodes[name].kind == symbol_node()) != (bindings[found].kind == symbolic_selection())) {
            reject_name(state, name, expected_symbol_binding());
            return;
        } else {};
        remember(bindings, name, bindings[found].declaration, bindings[found].kind);
    } else {};
}

func resolve_module_bodies(source:const SourceBytes in S, nodes:const ExprNodes in N, ref bindings:NameBindings in B,
                           ref work:NameWork in W, ref state:NameState in R, first:u64, definitions:bool) -> void
    where {const owner S, const owner N, owner B, owner W, owner R} {
    val item <- first;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node()) { return; } else {};
        resolve_module_form(source, nodes, bindings, work, state, nodes[item].right, definitions);
        if (state.diagnostic != 0u8) { return; } else {};
        (item <- work[item].next):void;
    };
}

# Consume a successful parse from the same source revision. Both work arrays
# need one element per syntax node. A populated binding identifies a declaration
# in the syntax buffer or a builtin kind. On failure, use only the diagnostic.
func resolve_module_names(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                           selected:const SelectedExports in E, ref bindings:NameBindings in B, ref work:NameWork in W,
                           declarations_only:bool, ref report:NameResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner E, owner B, owner W, owner R} {
    report.node <- no_node();
    report.enclosing_defer <- no_node();
    report.diagnostic <- invalid_module_tree();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) { return false; } else {};
    if (intrinsic (len)(bindings) < tree.used || intrinsic (len)(work) < tree.used ||
        intrinsic (len)(selected) < tree.used) {
        report.diagnostic <- name_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        remember(bindings, at, no_node(), 0u8);
        bindings[at].imported_kind <- if (nodes[at].kind == using_node()) { (selected[at].kind) } else { 0u8 };
        bindings[at].guarded_local <- 0u8;
        bindings[at].scope <- no_node();
        bindings[at].guarded_local_link <- no_node();
        bindings[at].handle_guard <- no_node();
    };
    link_entries(nodes, work, tree.used);
    ref state = make NameState {
        used <- 0u64; first <- 0u64; module_names <- 0u64; scope_node <- tree.root;
        delayed <- no_node(); guard <- no_node(); loop_arm <- false; repeated <- false;
        here_group <- false; handoff <- no_node(); diagnostic <- 0u8;
        failed_node <- no_node(); enclosing_defer <- no_node();
    };
    val first <- first_item(nodes, nodes[tree.root].left);
    register_module(source, nodes, bindings, selected, work, state, first, declarations_only);
    if (state.diagnostic == 0u8) { register_native_procedures(source, nodes, bindings, work, state, first); } else {};
    if (state.diagnostic == 0u8) {
        state.module_names <- state.used;
        state.first <- state.used;
        resolve_module_bodies(source, nodes, bindings, work, state, first, true);
    } else {};
    if (state.diagnostic == 0u8) {
        state.scope_node <- tree.root;
        resolve_module_bodies(source, nodes, bindings, work, state, first, false);
    } else {};
    report.node <- state.failed_node;
    report.enclosing_defer <- state.enclosing_defer;
    report.diagnostic <- state.diagnostic;
    return state.diagnostic == 0u8;
}

