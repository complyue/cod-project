using "ParserStorage.cod" {
    ExprNodes, len, literal_node, add_node, multiply_node, group_node, no_node,
};
using "ParserInput.cod" ParseResult;

export func arithmetic_node(kind:u8) -> bool {
    return kind == literal_node() || kind == add_node() || kind == multiply_node() || kind == group_node();
}

func node_ready(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    val operation_at <- nodes[at].operation_at;
    if (operation_at < nodes[at].first || operation_at >= nodes[at].past) return false;
    val kind <- nodes[at].kind;
    if (kind == literal_node()) return true;
    if (kind == group_node()) return nodes[at].left < at;
    if (kind == add_node() || kind == multiply_node())
        return nodes[at].left < at && nodes[at].right < at;
    return false;
}

# Emit in postorder so both operands are available. The backend emits checked
# arithmetic and reports runtime overflow at the operator's byte offset.
export proc lower_expression(here emit(ordinal:u64, kind:u8, number:u64, left:u64, right:u64,
                                      operation_at:u64) -> bool,
                             nodes:const ExprNodes in N, tree:const ParseResult in R,
                             rejected_node:u64 in D) -> bool
    where {const owner N, const owner R, owner D} {
    rejected_node <- no_node();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > len(nodes)) return false;
    if (tree.root != tree.used - 1u64) return false;
    for (at in 0u64 .. tree.used) {
        if (!node_ready(nodes, at) ||
            !emit(at, nodes[at].kind, nodes[at].number, nodes[at].left, nodes[at].right, nodes[at].operation_at)) {
            rejected_node <- at;
            return false;
        } else {};
    };
    return true;
}
