using "SourceStorage.cod" SourceBytes;
using "ParserStorage.cod" {
    ExprNodes, no_node, c_handle_type_node, c_record_node, c_procedure_node, callable_node, callable_head_node,
    array_declaration_node, export_node, export_from_node, module_item_node, symbol_node,
    data_parent_node, owned_type_node, ref_parameter_node, ptr_parameter_node, parameter_node,
    val_parameter_node, handle_parameter_node, here_parameter_node, checked_ref_argument,
    owning_handle_local_node, borrowed_handle_local_node, make_own_handle_node,
    make_borrowed_handle_node, handle_construction, group_node, name_node, literal_node, bool_node,
    typed_name_node, val_binding_node, here_call_node, call_node, full_scope_node, continue_node,
    break_node, return_node, narrow_integer_node, is_function, owner_clause_node,
    result_clause_node, throws_clause_node, field_access_node, import_node, local_resource_name,
};
using "NameResolution.cod" {
    NameBindings, NameWork, first_item, signature_head, signature_clause, record_declaration,
    c_handle_type, handle_binding, formal_binding, local_binding, loop_index, enclosing_callable,
    record_type, array_type, c_constructor, c_operation, c_entry, callable_binding, owner_binding,
    ordinary_selection, symbolic_selection, definition_name, native_scalar, builtin_bool,
    builtin_u8, builtin_u32, builtin_u64, builtin_i64, builtin_void,
};
using "ModuleExports.cod" {
    SelectedExports, same_name, ModuleExports, exception_type_export, exception_root_identity,
    native_handle_export, record_export, array_export, nominal_exception_export, callable_export, enum_export,
};
using "ModuleExportStorage.cod" { ModuleInterfaceRow, ModuleInterfaces, find_interface, write_interface_header, enum_type };
using "DeclarationTypes.cod" { type_module, type_identity };

export data NativeDeclarationResult {
    diagnostic:u8;
    node:u64;
}

func invalid_native_owner_type() -> u8 { return 16u8; }
func invalid_record_field() -> u8 { return 17u8; }
func recursive_record_layout() -> u8 { return 18u8; }
func invalid_native_failure() -> u8 { return 19u8; }
func native_owner_required() -> u8 { return 20u8; }
func mixed_native_owner_types() -> u8 { return 21u8; }
func invalid_native_parameter() -> u8 { return 22u8; }
func invalid_native_result() -> u8 { return 23u8; }
func duplicate_native_constructor() -> u8 { return 24u8; }
func invalid_native_access() -> u8 { return 25u8; }
func invalid_native_callback() -> u8 { return 26u8; }
func invalid_array_shape() -> u8 { return 27u8; }
func invalid_handle_initializer() -> u8 { return 52u8; }
func mismatched_handle_type() -> u8 { return 53u8; }
func invalid_handle_acquisition_mode() -> u8 { return 54u8; }
func missing_handle_constructor() -> u8 { return 55u8; }
func wrong_constructor_arity() -> u8 { return 57u8; }
func unproved_constructor_operand() -> u8 { return 58u8; }
func mismatched_actual_handle_owner() -> u8 { return 59u8; }
func invalid_constructor_bits() -> u8 { return 60u8; }
func here_operation_required() -> u8 { return 64u8; }
func unproved_imported_here_signature() -> u8 { return 65u8; }
func mismatched_here_receivers() -> u8 { return 66u8; }
func mismatched_here_receiver_type() -> u8 { return 67u8; }
func mismatched_here_feedback() -> u8 { return 68u8; }
func here_body_required() -> u8 { return 69u8; }
func native_here_in_function() -> u8 { return 70u8; }
func unproved_here_feedback() -> u8 { return 71u8; }

func reject_declaration(report:NativeDeclarationResult in R, at:u64, cause:u8) -> void where {owner R} {
    report.diagnostic <- cause;
    (report.node <- at):void;
}

func passed_by_reference(kind:u8) -> bool {
    return kind == ref_parameter_node() || kind == ptr_parameter_node();
}

func numeric_native(kind:u8) -> bool { return native_scalar(kind) && kind != builtin_bool(); }

func owning_handle() -> u8 { return 1u8; }
func child_handle() -> u8 { return 2u8; }
func bits_record() -> u8 { return 1u8; }
func numeric_record() -> u8 { return 2u8; }
func reference_record() -> u8 { return 3u8; }
func readonly_numeric_array() -> u8 { return 1u8; }
func numeric_record_array() -> u8 { return 2u8; }
func scalar_exception() -> u8 { return 1u8; }

func imported_kind(names:const NameBindings in B, selected:const SelectedExports in E, at:u64) -> u8
    where {const owner B, const owner E} {
    if (names[at].kind != ordinary_selection()) return 0u8;
    return selected[names[at].declaration].kind;
}

func exception_selection(names:const NameBindings in B, selected:const SelectedExports in E, at:u64) -> bool
    where {const owner B, const owner E} {
    return imported_kind(names, selected, at) == exception_type_export();
}

func exception_record(nodes:const ExprNodes in N, record:u64) -> bool where {const owner N} {
    return nodes[nodes[record].left].kind == data_parent_node();
}

func nominal_exception(nodes:const ExprNodes in N, names:const NameBindings in B,
                       selected:const SelectedExports in E, at:u64) -> bool
    where {const owner N, const owner B, const owner E} {
    if (names[at].kind == record_type()) return exception_record(nodes, names[at].declaration);
    return imported_kind(names, selected, at) == nominal_exception_export();
}

export func declared_exception_type(nodes:const ExprNodes in N, names:const NameBindings in B,
                                    selected:const SelectedExports in E, at:u64) -> bool
    where {const owner N, const owner B, const owner E} {
    return exception_selection(names, selected, at) || nominal_exception(nodes, names, selected, at);
}

func is_owning_handle(nodes:const ExprNodes in N, names:const NameBindings in B,
                      selected:const SelectedExports in E, at:u64) -> bool
    where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    if (names[at].kind == c_handle_type()) return nodes[target].right == no_node();
    return imported_kind(names, selected, at) == native_handle_export() && selected[target].shape == owning_handle();
}

func native_handle_marker(names:const NameBindings in B, selected:const SelectedExports in E, marker:u64) -> bool
    where {const owner B, const owner E} {
    return names[marker].kind == c_handle_type() || imported_kind(names, selected, marker) == native_handle_export();
}

func same_native_type(names:const NameBindings in B, selected:const SelectedExports in E, first:u64, second:u64) -> bool
    where {const owner B, const owner E} {
    val declared <- names[first].declaration;
    val supplied <- names[second].declaration;
    if (names[first].kind != ordinary_selection() || names[second].kind != ordinary_selection())
        return names[first].kind == names[second].kind && declared == supplied;
    return selected[declared].origin_module == selected[supplied].origin_module &&
        selected[declared].identity == selected[supplied].identity;
}

func uses_direct_scalars(nodes:const ExprNodes in N, names:const NameBindings in B,
                         fields:u64, numeric_only:bool) -> bool where {const owner N, const owner B} {
    val field <- fields;
    val declared_type <- 0u8;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (field == no_node()) return true;
        declared_type <- names[nodes[nodes[field].right].right].kind;
        if (passed_by_reference(nodes[field].kind) || !native_scalar(declared_type) || (numeric_only && !numeric_native(declared_type)))
            return false;
        field <- nodes[field].left;
    };
    return false;
}

func scalar_failure(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                    at:u64) -> bool where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    if (names[at].kind == record_type())
        return exception_record(nodes, target) && uses_direct_scalars(nodes, names, nodes[target].right, false);
    return imported_kind(names, selected, at) == nominal_exception_export() && selected[target].shape == scalar_exception();
}

# A record form has a layout fact distinct from the binding on its name.
# The parent and field cursor use that form's workspace slot during the walk.
func visiting_bits() -> u8 { return 23u8; }
func visiting_references() -> u8 { return 24u8; }
func finite_bits() -> u8 { return 25u8; }
func finite_references() -> u8 { return 26u8; }

func visit_record(nodes:const ExprNodes in N, names:NameBindings in B, work:NameWork in W,
                  record:u64, parent:u64) -> void where {const owner N, owner B, owner W} {
    names[record].kind <- visiting_bits();
    work[record].active <- parent;
    (work[record].next <- first_item(nodes, nodes[record].right)):void;
}

func check_record(nodes:const ExprNodes in N, names:NameBindings in B, work:NameWork in W, selected:const SelectedExports in E,
                  start:u64, used:u64, report:NativeDeclarationResult in R) -> void
    where {const owner N, owner B, owner W, const owner E, owner R} {
    if (names[start].kind != 0u8) return;
    visit_record(nodes, names, work, start, no_node());
    val record <- start;
    val field <- no_node();
    val declared_type <- no_node();
    val target <- no_node();
    val kind <- 0u8;
    val imported_record <- false;
    val references <- false;
    # A field can be visited twice, once before and once after its dependency.
    for (unused in 0u64 .. used * 2u64) {
        if (record == no_node()) return;
        field <- work[record].next;
        if (field == no_node()) {
            names[record].kind <- if (names[record].kind == visiting_bits()) { finite_bits() } else { finite_references() };
            (record <- work[record].active):void;
        } else {
            declared_type <- nodes[nodes[field].right].right;
            kind <- names[declared_type].kind;
            imported_record <- imported_kind(names, selected, declared_type) == record_export();
            references <- passed_by_reference(nodes[field].kind);
            if (!native_scalar(kind) && kind != record_type() && !imported_record) {
                reject_declaration(report, declared_type, invalid_record_field());
                return;
            } else {};
            target <- names[declared_type].declaration;
            if (kind == record_type() && exception_record(nodes, target)) {
                reject_declaration(report, declared_type, invalid_record_field());
                return;
            } else {};
            if (kind == record_type() && !references && names[target].kind == 0u8) {
                visit_record(nodes, names, work, target, record);
                (record <- target):void;
            } else {
                if (kind == record_type() && !references) {
                    if (names[target].kind == visiting_bits() || names[target].kind == visiting_references()) {
                        reject_declaration(report, declared_type, recursive_record_layout());
                        return;
                    } else {};
                    (references <- names[target].kind == finite_references()):void;
                } else {};
                if (imported_record && selected[target].shape == reference_record()) { (references <- true):void; } else {};
                if (references && nodes[record].kind == c_record_node()) {
                    reject_declaration(report, field, invalid_record_field());
                    return;
                } else {};
                if (references) { (names[record].kind <- visiting_references()):void; } else {};
                (work[record].next <- work[field].next):void;
            };
        };
    };
    reject_declaration(report, start, recursive_record_layout());
}

func check_type_declaration(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, form:u64,
                            report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner R} {
    val kind <- nodes[form].kind;
    if (kind == c_handle_type_node()) {
        val owner <- nodes[form].right;
        if (owner != no_node() && !is_owning_handle(nodes, names, selected, owner)) {
            reject_declaration(report, owner, invalid_native_owner_type());
        } else {};
        return;
    } else {};
    if (kind == array_declaration_node()) {
        val shape <- nodes[form].right;
        val index <- names[nodes[shape].left].kind;
        val element <- nodes[shape].right;
        val element_kind <- names[element].kind;
        val integral <- index == builtin_u8() || index == builtin_u32() || index == builtin_u64() || index == builtin_i64();
        val product <- (element_kind == record_type() && !exception_record(nodes, names[element].declaration)) ||
            imported_kind(names, selected, element) == record_export();
        if (!integral || (!native_scalar(element_kind) && !product)) {
            reject_declaration(report, shape, invalid_array_shape());
        } else {};
        return;
    } else {};
    if (record_declaration(kind) && exception_record(nodes, form)) {
        val parent <- nodes[nodes[form].left].right;
        if (!exception_selection(names, selected, parent) ||
            selected[names[parent].declaration].identity != exception_root_identity()) {
            reject_declaration(report, parent, invalid_native_failure());
        } else {};
    } else {};
}

func array_shape(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                 form:u64) -> u8 where {const owner N, const owner B, const owner E} {
    val shape <- nodes[form].right;
    if (names[nodes[shape].left].kind != builtin_u64()) return 0u8;
    val element <- nodes[shape].right;
    if (numeric_native(names[element].kind)) return readonly_numeric_array();
    val record <- names[element].declaration;
    if (names[element].kind == record_type() && !exception_record(nodes, record) && nodes[record].right != no_node() &&
        uses_direct_scalars(nodes, names, nodes[record].right, true)) return numeric_record_array();
    if (imported_kind(names, selected, element) == record_export() &&
        selected[record].shape == numeric_record()) return numeric_record_array();
    return 0u8;
}

func native_array_view(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                       at:u64, readonly:bool) -> bool where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    val shape <- 0u8;
    if (names[at].kind == array_type()) {
        (shape <- array_shape(nodes, names, selected, target)):void;
    } else {
        if (imported_kind(names, selected, at) == array_export()) { (shape <- selected[target].shape):void; } else {};
    };
    return shape == numeric_record_array() || (readonly && shape == readonly_numeric_array());
}

data NativeOwnerType {
    origin:u64;
    identity:u64;
}

# Zero is the current module's local namespace during checking. A checked
# dependency has a nonzero module identity and cannot depend on this module.
func handle_owner(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                  at:u64, root:NativeOwnerType in R) -> void
    where {const owner N, const owner B, const owner E, owner R} {
    val target <- names[at].declaration;
    if (names[at].kind == c_handle_type()) {
        val parent <- nodes[target].right;
        if (parent == no_node()) {
            root.origin <- 0u64;
            root.identity <- target;
            return;
        } else {};
        val owner_target <- names[parent].declaration;
        if (names[parent].kind == c_handle_type()) {
            root.origin <- 0u64;
            root.identity <- owner_target;
        } else {
            root.origin <- selected[owner_target].owner_module;
            root.identity <- selected[owner_target].owner_identity;
        };
        return;
    } else {};
    root.origin <- selected[target].owner_module;
    (root.identity <- selected[target].owner_identity):void;
}

func check_native_argument(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                           selected:const SelectedExports in E, parameter:u64, direction:u8,
                           report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val mode <- nodes[parameter].kind;
    val binding <- nodes[parameter].right;
    val annotation <- nodes[binding].right;
    if (mode != handle_parameter_node() && mode != ref_parameter_node()) {
        val kind <- native_value_kind(names, selected, annotation);
        if ((mode != val_parameter_node() && mode != parameter_node()) ||
            (!native_scalar(kind) && kind != enum_type())) {
            reject_declaration(report, parameter, invalid_native_parameter());
        } else {};
        return;
    } else {};
    if (nodes[annotation].kind != owned_type_node() || names[nodes[annotation].right].kind != owner_binding()) {
        reject_declaration(report, annotation, native_owner_required());
        return;
    } else {};
    val declared_type <- nodes[annotation].left;
    val role <- names[nodes[annotation].right].declaration;
    val readonly <- nodes[binding].number != 0u64;
    if (mode == ref_parameter_node()) {
        if (direction != c_operation() || !readonly || nodes[role].number == 0u64 ||
            !native_array_view(nodes, names, selected, declared_type, true)) {
            reject_declaration(report, parameter, invalid_native_parameter());
        } else {
            if (work[role].active == no_node()) { (work[role].active <- role):void; } else {};
        };
        return;
    } else {};
    if (!native_handle_marker(names, selected, declared_type)) {
        reject_declaration(report, declared_type, invalid_native_parameter());
        return;
    } else {};
    if (direction == c_operation() && readonly && nodes[role].number == 0u64) {
        reject_declaration(report, parameter, invalid_native_access());
        return;
    } else {};
    ref root = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
    handle_owner(nodes, names, selected, declared_type, root);
    val role_name <- nodes[role].right;
    val prior_module <- work[role_name].active;
    if (prior_module != no_node() && (prior_module != root.origin || work[role].active != root.identity)) {
        reject_declaration(report, parameter, mixed_native_owner_types());
        return;
    } else {};
    work[role_name].active <- root.origin;
    (work[role].active <- root.identity):void;
}

func native_value_kind(names:const NameBindings in B, selected:const SelectedExports in E, annotation:u64) -> u8
    where {const owner B, const owner E} {
    if (imported_kind(names, selected, annotation) == enum_export()) return enum_type();
    return names[annotation].kind;
}

func check_c_callback(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                      selected:const SelectedExports in E, callback:u64, supplier:u64, result:u64,
                      report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner W, const owner E, owner R} {
    val annotation <- nodes[nodes[supplier].right].right;
    val role <- names[nodes[annotation].right].declaration;
    if (!is_owning_handle(nodes, names, selected, nodes[annotation].left)) {
        reject_declaration(report, supplier, invalid_native_callback());
        return;
    } else {};
    val signature <- nodes[callback].right;
    val feedback <- signature_clause(nodes, signature, result_clause_node());
    if (feedback == no_node()) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    } else {};
    val marker <- nodes[feedback].right;
    val kind <- native_value_kind(names, selected, marker);
    if (kind != native_value_kind(names, selected, result) ||
        (kind == enum_type() && (type_module(names, selected, marker, 0u64) != type_module(names, selected, result, 0u64) ||
                                type_identity(names, selected, marker) != type_identity(names, selected, result)))) {
        reject_declaration(report, marker, invalid_native_callback());
        return;
    } else {};
    val failure <- signature_clause(nodes, signature, throws_clause_node());
    if (failure != no_node()) {
        val declared_type <- nodes[failure].right;
        if (!exception_selection(names, selected, declared_type) && !nominal_exception(nodes, names, selected, declared_type)) {
            reject_declaration(report, declared_type, invalid_native_failure());
            return;
        } else {};
    } else {};
    val parameter <- first_item(nodes, nodes[signature_head(nodes, signature)].right);
    if (parameter == no_node()) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    } else {};
    val binding <- no_node();
    val view <- no_node();
    val readonly <- false;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (parameter == no_node()) return;
        binding <- nodes[parameter].right;
        view <- nodes[binding].right;
        readonly <- nodes[binding].number != 0u64;
        if (nodes[parameter].kind != ref_parameter_node() || nodes[view].kind != owned_type_node() ||
            names[nodes[view].right].declaration != role || !native_array_view(nodes, names, selected, nodes[view].left, readonly)) {
            reject_declaration(report, parameter, invalid_native_callback());
            return;
        } else {};
        if (!readonly && nodes[role].number != 0u64) {
            reject_declaration(report, parameter, invalid_native_access());
            return;
        } else {};
        parameter <- work[parameter].next;
    };
}

func check_c_arguments(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                       selected:const SelectedExports in E, first:u64, direction:u8,
                       report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val parameter <- first;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (parameter == no_node()) return;
        check_native_argument(nodes, names, work, selected, parameter, direction, report);
        if (report.diagnostic != 0u8) return;
        parameter <- work[parameter].next;
    };
}

func check_handle_formals(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                          selected:const SelectedExports in E, form:u64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val head <- signature_head(nodes, nodes[form].left);
    val parameter <- first_item(nodes, nodes[head].right);
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (parameter == no_node()) return;
        if (nodes[parameter].kind == handle_parameter_node()) {
            check_native_argument(nodes, names, work, selected, parameter, callable_binding(), report);
            if (report.diagnostic != 0u8) return;
        } else {};
        parameter <- work[parameter].next;
    };
}

func check_c_procedure(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                       selected:const SelectedExports in E, form:u64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val direction <- names[form].kind;
    val header <- nodes[form].left;
    val head <- signature_head(nodes, header);
    val result <- signature_clause(nodes, header, result_clause_node());
    val failure <- signature_clause(nodes, header, throws_clause_node());
    val result_kind <- builtin_void();
    if (result != no_node()) { (result_kind <- native_value_kind(names, selected, nodes[result].right)):void; } else {};
    if (direction == c_constructor()) {
        val handle <- names[form].declaration;
        if (work[handle].active != no_node()) {
            reject_declaration(report, form, duplicate_native_constructor());
            return;
        } else {};
        work[handle].active <- form;
        if (failure != no_node()) {
            val declared_type <- nodes[failure].right;
            if (!scalar_failure(nodes, names, selected, declared_type)) {
                reject_declaration(report, declared_type, invalid_native_failure());
                return;
            } else {};
        } else {};
    } else {
        val valid <- if (direction == c_operation()) {
            result_kind == builtin_u8() || result_kind == builtin_void() || result_kind == enum_type()
        } else { result != no_node() && (native_scalar(result_kind) || result_kind == builtin_void() || result_kind == enum_type()) };
        if (failure != no_node()) {
            reject_declaration(report, failure, invalid_native_failure());
            return;
        } else {};
        if (!valid) {
            reject_declaration(report, if (result == no_node()) { form } else { result }, invalid_native_result());
            return;
        } else {};
    };
    val first <- first_item(nodes, nodes[head].right);
    val parameter <- first;
    val callback <- no_node();
    if (first != no_node() && nodes[first].kind == here_parameter_node()) {
        parameter <- work[first].next;
        if (direction != c_operation() || (result_kind != builtin_u8() && result_kind != enum_type()) || parameter == no_node() ||
            nodes[parameter].kind != handle_parameter_node() || work[parameter].next != no_node()) {
            reject_declaration(report, first, invalid_native_callback());
            return;
        } else {};
        (callback <- first):void;
    } else {};
    check_c_arguments(nodes, names, work, selected, parameter, direction, report);
    if (report.diagnostic != 0u8) return;
    if (callback != no_node()) {
        check_c_callback(nodes, names, work, selected, callback, work[callback].next, nodes[result].right, report);
        if (report.diagnostic != 0u8) return;
    } else {};
    val clause <- work[head].next;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (clause == no_node()) return;
        if (nodes[clause].kind == owner_clause_node() && work[clause].active == no_node()) {
            reject_declaration(report, clause, native_owner_required());
            return;
        } else {};
        clause <- work[clause].next;
    };
}

func ungrouped(nodes:const ExprNodes in N, at:u64) -> u64 where {const owner N} {
    val value <- at;
    for (unused in 0u64 .. at + 1u64) {
        if (nodes[value].kind != group_node()) return value;
        value <- nodes[value].left;
    };
    return value;
}

func handle_annotation(nodes:const ExprNodes in N, at:u64, formal:bool) -> u64 where {const owner N} {
    return nodes[if (formal) { (nodes[at].right) } else { (nodes[at].left) }].right;
}

func annotated_marker(nodes:const ExprNodes in N, annotation:u64) -> u64 where {const owner N} {
    return if (nodes[annotation].kind == owned_type_node()) { (nodes[annotation].left) } else { annotation };
}

data HandleLoan {
    marker:u64;
    owner:u64;
    readonly:bool;
}

# Follow the binding's initializer, keeping the actual owner and access of
# the selected borrow. A lexical name alone supplies neither.
func trace_handle_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
                       at:u64, loan:HandleLoan in L) -> bool
    where {const owner N, const owner B, owner L} {
    val value <- ungrouped(nodes, at);
    val declaration <- no_node();
    val annotation <- no_node();
    for (unused in 0u64 .. at + 1u64) {
        if (nodes[value].kind == make_borrowed_handle_node()) {
            loan.marker <- nodes[value].left;
            loan.owner <- names[nodes[value].number].declaration;
            loan.readonly <- false;
            return true;
        } else {};
        if (nodes[value].kind != name_node()) return false;
        declaration <- names[value].declaration;
        if (declaration == no_node()) return false;
        if (names[value].kind == formal_binding() && nodes[declaration].kind == handle_parameter_node()) {
            annotation <- handle_annotation(nodes, declaration, true);
            if (nodes[annotation].kind != owned_type_node() || names[nodes[annotation].right].kind != owner_binding())
                return false;
            loan.marker <- nodes[annotation].left;
            loan.owner <- names[nodes[annotation].right].declaration;
            loan.readonly <- nodes[nodes[declaration].right].number != 0u64;
            return true;
        } else {};
        if (names[value].kind != handle_binding()) return false;
        if (nodes[declaration].kind == owning_handle_local_node()) {
            loan.marker <- handle_annotation(nodes, declaration, false);
            loan.owner <- declaration;
            loan.readonly <- false;
            return true;
        } else {};
        value <- ungrouped(nodes, nodes[declaration].right);
    };
    return false;
}

func scalar_operand_kind(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W, at:u64) -> u8
    where {const owner N, const owner B, const owner W} {
    val value <- ungrouped(nodes, at);
    val kind <- nodes[value].kind;
    if (kind == literal_node()) return builtin_u64();
    if (kind == narrow_integer_node()) return if (nodes[value].left == 8u64) { builtin_u8() } else { builtin_u32() };
    if (kind == bool_node()) return builtin_bool();
    if (kind == field_access_node()) return work[value].value_kind;
    if (kind != name_node()) return 0u8;
    val binding <- names[value].kind;
    val declaration <- names[value].declaration;
    if (binding == loop_index()) return builtin_u64();
    if (binding == formal_binding() && (nodes[declaration].kind == val_parameter_node() ||
        nodes[declaration].kind == parameter_node()))
        return names[handle_annotation(nodes, declaration, true)].kind;
    if (binding == local_binding() && nodes[declaration].kind == val_binding_node() &&
        nodes[nodes[declaration].left].kind == typed_name_node())
        return names[handle_annotation(nodes, declaration, false)].kind;
    return 0u8;
}

func allows_handle_access(nodes:const ExprNodes in N, loan:const HandleLoan in L,
                          const_argument:bool, const_role:bool) -> bool where {const owner N, const owner L} {
    return (!loan.readonly || const_argument) &&
        (const_role || nodes[loan.owner].kind != owner_clause_node() || nodes[loan.owner].number == 0u64);
}

func describe_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                        selected:const SelectedExports in E, formal:u64, current_module:u64,
                        provider:bool, row:ModuleInterfaceRow in R)
    where {const owner N, const owner B, const owner E, owner R} {
    val binding <- nodes[formal].right;
    val annotation <- nodes[binding].right;
    write_interface_header(row, 0u64, 0u64, 0u8, 0u8, 0u64);
    val mode <- nodes[formal].kind;
    if (mode == handle_parameter_node() || mode == ref_parameter_node()) {
        val marker <- nodes[annotation].left;
        val role <- names[nodes[annotation].right].declaration;
        row.value_kind <- if (mode == handle_parameter_node()) { c_handle_type() } else { array_type() };
        row.type_module <- type_module(names, selected, marker, current_module);
        row.type_identity <- type_identity(names, selected, marker);
        row.owner_role <- role;
        row.target_readonly <- if (nodes[binding].number != 0u64 ||
            (mode == handle_parameter_node() && provider && nodes[role].number != 0u64)) { 1u8 } else { 0u8 };
        (row.owner_readonly <- if (nodes[role].number != 0u64) { 1u8 } else { 0u8 }):void;
    } else {
        row.value_kind <- native_value_kind(names, selected, annotation);
        if (row.value_kind == enum_type()) {
            row.type_module <- type_module(names, selected, annotation, current_module);
            (row.type_identity <- type_identity(names, selected, annotation)):void;
        } else {};
    };
}

func match_handle_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, parameter:const ModuleInterfaceRow in P,
                            operand:u64, loan:HandleLoan in L, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, owner L, owner R} {
    if (!trace_handle_loan(nodes, names, operand, loan) ||
        !native_handle_marker(names, selected, loan.marker) ||
        type_module(names, selected, loan.marker, 0u64) != parameter.type_module ||
        type_identity(names, selected, loan.marker) != parameter.type_identity) {
        reject_declaration(report, operand, mismatched_handle_type());
        return false;
    } else {};
    if (!allows_handle_access(nodes, loan, parameter.target_readonly != 0u8, parameter.owner_readonly != 0u8)) {
        reject_declaration(report, operand, invalid_native_access());
        return false;
    } else {};
    return true;
}

func match_constructor_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, parameter:const ModuleInterfaceRow in P,
                                 work:const NameWork in W, operand:u64, loan:HandleLoan in L, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, const owner W, owner L, owner R} {
    if (parameter.value_kind == c_handle_type())
        return match_handle_parameter(nodes, names, selected, parameter, operand, loan, report);
    val actual <- scalar_operand_kind(nodes, names, work, operand);
    val expected <- parameter.value_kind;
    if (actual != expected) {
        reject_declaration(report, operand,
            if (native_scalar(actual)) { invalid_constructor_bits() } else { unproved_constructor_operand() });
        return false;
    } else {};
    return true;
}

func shares_imported_owner(contracts:const ModuleInterfaces in C, work:const NameWork in W,
                            first:u64, limit:u64, first_actual:u64, role:u64, owner_site:u64) -> bool
    where {const owner C, const owner W} {
    val actual <- first_actual;
    for (row in first .. limit) {
        if (contracts[row].owner_role == role && work[actual].active != owner_site) return false;
        actual <- work[actual].next;
    };
    return true;
}

func check_imported_constructor(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, contracts:const ModuleInterfaces in C,
                                 work:NameWork in W, at:u64, report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, const owner C, owner W, owner R} {
    val marker <- nodes[at].left;
    val head <- find_interface(contracts, type_module(names, selected, marker, 0u64),
                                type_identity(names, selected, marker));
    if (head == no_node() || contracts[head].interface_kind != c_constructor()) {
        reject_declaration(report, at, missing_handle_constructor());
        return;
    } else {};
    val first <- first_item(nodes, nodes[at].right);
    val actual <- first;
    val operand <- no_node();
    val role <- no_node();
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    for (row in head + 1u64 .. head + 1u64 + contracts[head].entry_count) {
        if (actual == no_node()) { reject_declaration(report, at, wrong_constructor_arity()); return; } else {};
        operand <- nodes[actual].right;
        if (!match_constructor_parameter(nodes, names, selected, contracts[row], work, operand, loan, report))
            return;
        if (contracts[row].value_kind == c_handle_type()) {
            role <- contracts[row].owner_role;
            if (!shares_imported_owner(contracts, work, head + 1u64, row, first, role, loan.owner)) {
                reject_declaration(report, operand, mismatched_actual_handle_owner());
                return;
            } else {};
            (work[actual].active <- loan.owner):void;
        } else {};
        actual <- work[actual].next;
    };
    if (actual != no_node()) { reject_declaration(report, at, wrong_constructor_arity()); } else {};
}

func check_constructor_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, work:NameWork in W,
                                 at:u64, constructor:u64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val head <- signature_head(nodes, nodes[constructor].left);
    val formal <- first_item(nodes, nodes[head].right);
    val actual <- first_item(nodes, nodes[at].right);
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    ref parameter = make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node(); target_readonly <- 0u8; owner_readonly <- 0u8;
        has_here <- 0u8; failure_module <- 0u64; failure_identity <- 0u64;
        name_first <- 0u64; name_past <- 0u64; enum_code <- 0u64;
    };
    val operand <- no_node();
    val owner <- no_node();
    val role_name <- no_node();
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (formal == no_node() || actual == no_node()) {
            if (formal != actual) { reject_declaration(report, at, wrong_constructor_arity()); } else {};
            return;
        } else {};
        operand <- nodes[actual].right;
        describe_parameter(nodes, names, selected, formal, 0u64, false, parameter);
        if (!match_constructor_parameter(nodes, names, selected, parameter, work, operand, loan, report)) return;
        if (parameter.value_kind == c_handle_type()) {
            owner <- parameter.owner_role;
            role_name <- nodes[owner].right;
            if (work[role_name].active == at && work[owner].active != loan.owner) {
                reject_declaration(report, operand, mismatched_actual_handle_owner());
                return;
            } else {};
            work[role_name].active <- at;
            (work[owner].active <- loan.owner):void;
        } else {};
        formal <- work[formal].next;
        actual <- work[actual].next;
    };
}

func check_handle_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:NameWork in W,
                               at:u64, emit_object:bool, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val marker <- nodes[at].left;
    val owning <- nodes[at].kind == make_own_handle_node();
    if (!native_handle_marker(names, selected, marker) || owning != is_owning_handle(nodes, names, selected, marker)) {
        reject_declaration(report, marker, invalid_handle_acquisition_mode());
        return;
    } else {};
    if (owning && work[at].active == no_node()) {
        reject_declaration(report, at, invalid_handle_initializer());
        return;
    } else {};
    if (!owning) {
        val lexical <- names[nodes[at].number].declaration;
        val actual_type <- handle_annotation(nodes, lexical, false);
        if (!native_handle_marker(names, selected, actual_type)) {
            reject_declaration(report, nodes[at].number, mismatched_actual_handle_owner());
            return;
        } else {};
        ref required = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        ref actual = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        handle_owner(nodes, names, selected, marker, required);
        handle_owner(nodes, names, selected, actual_type, actual);
        if (required.origin != actual.origin || required.identity != actual.identity) {
            reject_declaration(report, nodes[at].number, mismatched_actual_handle_owner());
            return;
        } else {};
    } else {};
    # The declaration graph checks arguments after gathering their type evidence.
    if (names[marker].kind != c_handle_type()) return;
    val constructor <- work[names[marker].declaration].active;
    if (constructor == no_node()) {
        reject_declaration(report, at, missing_handle_constructor());
        return;
    } else {};
    if (emit_object) { check_constructor_arguments(nodes, names, selected, work, at, constructor, report); } else {};
}

func check_handle_local(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                        at:u64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner R} {
    val annotation <- handle_annotation(nodes, at, false);
    val marker <- annotated_marker(nodes, annotation);
    val initializer <- ungrouped(nodes, nodes[at].right);
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    if (nodes[at].kind == owning_handle_local_node()) {
        (loan.marker <- nodes[initializer].left):void;
    } else {
        if (!trace_handle_loan(nodes, names, initializer, loan)) {
            reject_declaration(report, initializer, invalid_handle_initializer());
            return;
        } else {};
    };
    if (!native_handle_marker(names, selected, marker) || !native_handle_marker(names, selected, loan.marker) ||
        !same_native_type(names, selected, marker, loan.marker)) {
        reject_declaration(report, initializer, mismatched_handle_type());
        return;
    } else {};
    if (nodes[annotation].kind == owned_type_node() && names[nodes[annotation].right].declaration != loan.owner) {
        reject_declaration(report, initializer, mismatched_actual_handle_owner());
        return;
    } else {};
}

func check_handle_expressions(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                              work:NameWork in W, used:u64, emit_object:bool, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val initializer <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == owning_handle_local_node()) {
            initializer <- ungrouped(nodes, nodes[at].right);
            if (nodes[initializer].kind != make_own_handle_node()) {
                reject_declaration(report, initializer, invalid_handle_initializer());
                return false;
            } else {};
            work[initializer].active <- at;
            {};
        } else {};
    };
    val kind <- 0u8;
    for (at in 0u64 .. used) {
        kind <- nodes[at].kind;
        if (handle_construction(kind)) {
            check_handle_construction(nodes, names, selected, work, at, emit_object, report);
        } else {
            if (kind == owning_handle_local_node() || kind == borrowed_handle_local_node()) {
                check_handle_local(nodes, names, selected, at, report);
            } else {};
        };
        if (report.diagnostic != 0u8) return false;
    };
    return true;
}

func native_here_parameter(nodes:const ExprNodes in N, definition:u64) -> u64 where {const owner N} {
    val head <- signature_head(nodes, nodes[definition].left);
    val first <- first_item(nodes, nodes[head].right);
    if (first == no_node() || nodes[first].kind != here_parameter_node()) return no_node();
    return first;
}

func declared_call_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                          work:const NameWork in W, selected:const SelectedExports in E, definition:u64) -> u8
    where {const owner N, const owner B, const owner W, const owner E} {
    val binding <- names[definition].kind;
    if (binding == callable_binding()) {
        if (work[definition].active != no_node()) return 0u8;
    } else {
        if (binding != c_operation() && binding != c_entry()) return 0u8;
    };
    val result <- signature_clause(nodes, nodes[definition].left, result_clause_node());
    if (result == no_node()) return builtin_void();
    val kind <- native_value_kind(names, selected, nodes[result].right);
    if (native_scalar(kind) || kind == builtin_void() || kind == enum_type()) return kind;
    return 0u8;
}

func check_here_receiver(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         receiver:u64, expected:const ModuleInterfaceRow in P, actual_owner:u64,
                         report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, owner R} {
    val binding <- nodes[receiver].right;
    if (nodes[binding].kind != typed_name_node()) return true;
    val annotation <- nodes[binding].right;
    val explicit_type <- annotated_marker(nodes, annotation);
    if (!native_array_view(nodes, names, selected, explicit_type, true) ||
        type_module(names, selected, explicit_type, 0u64) != expected.type_module ||
        type_identity(names, selected, explicit_type) != expected.type_identity) {
        reject_declaration(report, receiver, mismatched_here_receiver_type());
        return false;
    } else {};
    if (expected.target_readonly != 0u8 && nodes[binding].number == 0u64) {
        reject_declaration(report, receiver, invalid_native_access());
        return false;
    } else {};
    if (nodes[annotation].kind == owned_type_node() && names[nodes[annotation].right].declaration != actual_owner) {
        reject_declaration(report, receiver, mismatched_actual_handle_owner());
        return false;
    } else {};
    return true;
}

func check_here_supplier(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                          at:u64, report:NativeDeclarationResult in R) -> u64
    where {const owner N, const owner B, const owner W, owner R} {
    if (is_function(nodes, enclosing_callable(nodes, names, names[at].scope))) {
        reject_declaration(report, at, native_here_in_function());
        return no_node();
    } else {};
    val call <- nodes[at].left;
    val argument <- first_item(nodes, nodes[call].right);
    if (argument == no_node() || work[argument].next != no_node() || checked_ref_argument(nodes, argument)) {
        reject_declaration(report, call, invalid_native_callback());
        return no_node();
    } else {};
    return nodes[argument].right;
}

func attach_here_body(nodes:const ExprNodes in N, work:NameWork in W, at:u64)
    where {const owner N, owner W} {
    work[nodes[at].left].active <- at;
    work[at].value_kind <- builtin_u8();
    val body <- nodes[nodes[at].right].right;
    if (nodes[body].kind == full_scope_node()) { (work[body].active <- at):void; } else {};
}

func check_local_here(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                      work:NameWork in W, at:u64, callback:u64, report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val feedback <- signature_clause(nodes, nodes[callback].right, result_clause_node());
    if (native_value_kind(names, selected, nodes[feedback].right) == enum_type()) {
        reject_declaration(report, at, unproved_here_feedback());
        return;
    } else {};
    val operand <- check_here_supplier(nodes, names, work, at, report);
    if (operand == no_node()) return;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    ref parameter = make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node(); target_readonly <- 0u8; owner_readonly <- 0u8;
        has_here <- 0u8; failure_module <- 0u64; failure_identity <- 0u64;
        name_first <- 0u64; name_past <- 0u64; enum_code <- 0u64;
    };
    describe_parameter(nodes, names, selected, work[callback].next, 0u64, true, parameter);
    if (!match_handle_parameter(nodes, names, selected, parameter, operand, loan, report)) return;
    val supplied <- nodes[at].right;
    val header <- signature_head(nodes, nodes[callback].right);
    val expected <- first_item(nodes, nodes[header].right);
    val receiver <- first_item(nodes, nodes[supplied].left);
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (expected == no_node() || receiver == no_node()) {
            if (expected == receiver) { attach_here_body(nodes, work, at); } else {
                reject_declaration(report, supplied, mismatched_here_receivers());
            };
            return;
        } else {};
        describe_parameter(nodes, names, selected, expected, 0u64, true, parameter);
        if (!check_here_receiver(nodes, names, selected, receiver, parameter, loan.owner, report)) return;
        expected <- work[expected].next;
        receiver <- work[receiver].next;
    };
}

func check_selected_here(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         contracts:const ModuleInterfaces in C, work:NameWork in W,
                         at:u64, head:u64, report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, const owner C, owner W, owner R} {
    val supplied <- nodes[at].right;
    if (head == no_node()) { reject_declaration(report, supplied, unproved_imported_here_signature()); return; } else {};
    if (contracts[head].has_here == 0u8) {
        reject_declaration(report, supplied, here_operation_required());
        return;
    } else {};
    if (contracts[head].result_kind == enum_type()) {
        reject_declaration(report, at, unproved_here_feedback());
        return;
    } else {};
    val operand <- check_here_supplier(nodes, names, work, at, report);
    if (operand == no_node()) return;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    if (!match_handle_parameter(nodes, names, selected, contracts[head + 1u64], operand, loan, report))
        return;
    val receiver <- first_item(nodes, nodes[supplied].left);
    for (row in head + 2u64 .. head + 1u64 + contracts[head].entry_count) {
        if (receiver == no_node()) { reject_declaration(report, supplied, mismatched_here_receivers()); return; } else {};
        if (!check_here_receiver(nodes, names, selected, receiver, contracts[row], loan.owner, report)) return;
        receiver <- work[receiver].next;
    };
    if (receiver != no_node()) { reject_declaration(report, supplied, mismatched_here_receivers()); return; } else {};
    attach_here_body(nodes, work, at);
}

func prepare_local_calls(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         work:NameWork in W, used:u64, emit_object:bool, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val call <- no_node();
    val callee <- no_node();
    val definition <- no_node();
    val callback <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == call_node()) {
            callee <- nodes[at].left;
            if (names[callee].kind == c_operation() || names[callee].kind == callable_binding() || names[callee].kind == c_entry()) {
                definition <- names[callee].declaration;
                work[at].value_kind <- declared_call_result(nodes, names, work, selected, definition);
                if (names[callee].kind == c_operation() && native_here_parameter(nodes, definition) != no_node()) {
                    (work[at].expects_here <- 1u8):void;
                } else {};
            } else {};
        } else {
            if (nodes[at].kind == here_call_node()) {
                call <- nodes[at].left;
                callee <- nodes[call].left;
                if (nodes[call].kind == call_node() && names[callee].kind == ordinary_selection() &&
                    selected[names[callee].declaration].kind == callable_export()) {
                    if (emit_object) {
                        reject_declaration(report, nodes[at].right, unproved_imported_here_signature());
                        return false;
                    } else {};
                } else {
                    if (nodes[call].kind != call_node() || names[callee].kind != c_operation()) {
                        reject_declaration(report, nodes[at].right, here_operation_required());
                        return false;
                    } else {};
                    callback <- native_here_parameter(nodes, names[callee].declaration);
                    if (callback == no_node()) {
                        reject_declaration(report, nodes[at].right, here_operation_required());
                        return false;
                    } else {};
                    check_local_here(nodes, names, selected, work, at, callback, report);
                    if (report.diagnostic != 0u8) return false;
                };
            } else {};
        };
    };
    return true;
}

func check_here_completions(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                            used:u64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner W, owner R} {
    val kind <- 0u8;
    val scope <- no_node();
    val operand <- no_node();
    val value <- no_node();
    val feedback <- 0u8;
    for (at in 0u64 .. used) {
        kind <- nodes[at].kind;
        if (kind == call_node() && work[at].expects_here != 0u8 && work[at].active == no_node()) {
            reject_declaration(report, at, here_body_required());
            return false;
        } else {};
        scope <- names[at].scope;
        if (kind == continue_node() || kind == break_node() ||
            (kind == return_node() && scope != no_node() && work[scope].active != no_node() && nodes[scope].kind == full_scope_node())) {
            operand <- nodes[at].left;
            if (operand == no_node()) { reject_declaration(report, at, mismatched_here_feedback()); return false; } else {};
            value <- ungrouped(nodes, operand);
            feedback <- scalar_operand_kind(nodes, names, work, value);
            if (nodes[value].kind == call_node() || nodes[value].kind == here_call_node()) {
                (feedback <- work[value].value_kind):void;
            } else {};
            if (feedback != builtin_u8()) {
                reject_declaration(report, operand, if (feedback == 0u8) { unproved_here_feedback() } else { mismatched_here_feedback() });
                return false;
            } else {};
        } else {};
    };
    return true;
}

func selected_call_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                             selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, call:u64) -> u64
    where {const owner N, const owner B, const owner E, const owner C} {
    if (nodes[call].kind != call_node()) return no_node();
    val callee <- nodes[call].left;
    if (names[callee].kind != ordinary_selection()) return no_node();
    val site <- names[callee].declaration;
    if (selected[site].kind != callable_export()) return no_node();
    return find_interface(contracts, selected[site].origin_module, selected[site].identity);
}

export func check_module_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                                      selected:const SelectedExports in E, contracts:const ModuleInterfaces in C,
                                      work:NameWork in W, used:u64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner C, owner W, owner R} {
    report.diagnostic <- 0u8;
    report.node <- no_node();
    val kind <- 0u8;
    val call <- no_node();
    val head <- no_node();
    val marker <- no_node();
    for (at in 0u64 .. used) {
        kind <- nodes[at].kind;
        if (handle_construction(kind)) {
            marker <- nodes[at].left;
            if (names[marker].kind == ordinary_selection()) {
                check_imported_constructor(nodes, names, selected, contracts, work, at, report);
            } else {
                check_constructor_arguments(nodes, names, selected, work, at, work[names[marker].declaration].active, report);
            };
        } else {
            if (kind == call_node()) {
                head <- selected_call_interface(nodes, names, selected, contracts, at);
                if (head != no_node()) {
                    work[at].value_kind <- contracts[head].result_kind;
                    (work[at].expects_here <- contracts[head].has_here):void;
                } else {};
            } else {
                if (kind == here_call_node()) {
                    call <- nodes[at].left;
                    if (names[nodes[call].left].kind == ordinary_selection()) {
                        head <- selected_call_interface(nodes, names, selected, contracts, call);
                        check_selected_here(nodes, names, selected, contracts, work, at, head, report);
                    } else {};
                } else {};
            };
        };
        if (report.diagnostic != 0u8) return false;
    };
    return check_here_completions(nodes, names, work, used, report);
}

# Name binding supplies declaration identities and finishes using the active
# name table before these checks reuse its workspace.
export func check_native_declarations(nodes:const ExprNodes in N, names:NameBindings in B, work:NameWork in W,
                                      selected:const SelectedExports in E, used:u64, emit_object:bool, report:NativeDeclarationResult in R) -> bool
    where {const owner N, owner B, owner W, const owner E, owner R} {
    report.diagnostic <- 0u8;
    report.node <- no_node();
    for (at in 0u64 .. used) {
        work[at].active <- no_node();
        work[at].value_kind <- 0u8;
        work[at].expects_here <- 0u8;
    };
    for (at in 0u64 .. used) {
        check_type_declaration(nodes, names, selected, at, report);
        if (report.diagnostic != 0u8) return false;
    };
    for (at in 0u64 .. used) {
        if (record_declaration(nodes[at].kind)) {
            check_record(nodes, names, work, selected, at, used, report);
            if (report.diagnostic != 0u8) return false;
        } else {};
    };
    val definition <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == c_procedure_node()) {
            check_c_procedure(nodes, names, work, selected, at, report);
        } else {
            if (nodes[at].kind == callable_node()) {
                definition <- names[at].declaration;
                if (definition != at) { (work[definition].active <- at):void; } else {};
                check_handle_formals(nodes, names, work, selected, at, report);
            } else {};
        };
        if (report.diagnostic != 0u8) return false;
    };
    return check_handle_expressions(nodes, names, selected, work, used, emit_object, report) &&
        prepare_local_calls(nodes, names, selected, work, used, emit_object, report) &&
        (!emit_object || check_here_completions(nodes, names, work, used, report));
}

export data ModulePublication {
    module_identity:u64;
    source_first:u64;
}

func count_owner_clauses(nodes:const ExprNodes in N, tail:u64) -> u64 where {const owner N} {
    val clause <- tail;
    val count <- 0u64;
    for (unused in 0u64 .. tail + 1u64) {
        if (nodes[clause].kind == callable_head_node()) return count;
        if (nodes[clause].kind == owner_clause_node()) { (count <- count + 1u64):void; } else {};
        clause <- nodes[clause].left;
    };
    return count;
}

func stage_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                     selected:const SelectedExports in E, work:const NameWork in W,
                     contracts:ModuleInterfaces in C, count:u64, defining_module:u64, declaration:u64,
                     form:u64, kind:u8, result_kind:u8) -> u64
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val limit <- intrinsic (len)(contracts);
    if (count >= limit) return no_node();
    val next <- count + 1u64;
    val formal <- no_node();
    val callback <- no_node();
    val name <- no_node();
    val result_marker <- no_node();
    if (result_kind == enum_type()) {
        val result <- signature_clause(nodes, nodes[form].left, result_clause_node());
        (result_marker <- nodes[result].right):void;
    } else {};
    if (kind == c_operation() || kind == c_entry()) {
        (name <- definition_name(nodes, form)):void;
    } else {};
    if (kind == c_operation()) { (callback <- native_here_parameter(nodes, form)):void; } else {};
    if (kind == c_constructor() || kind == c_entry() || (kind == c_operation() && callback == no_node())) {
        val head <- signature_head(nodes, nodes[form].left);
        (formal <- first_item(nodes, nodes[head].right)):void;
    } else {};
    if (callback != no_node()) {
        if (next >= limit) return no_node();
        describe_parameter(nodes, names, selected, work[callback].next, defining_module, true, contracts[next]);
        next <- next + 1u64;
        val callback_head <- signature_head(nodes, nodes[callback].right);
        (formal <- first_item(nodes, nodes[callback_head].right)):void;
    } else {};
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (formal == no_node()) {
            write_interface_header(contracts[count], defining_module, declaration, kind, result_kind, next - count - 1u64);
            contracts[count].has_here <- if (callback == no_node()) { 0u8 } else { 1u8 };
            if (result_kind == enum_type()) {
                contracts[count].type_module <- type_module(names, selected, result_marker, defining_module);
                (contracts[count].type_identity <- type_identity(names, selected, result_marker)):void;
            } else {};
            if (kind == c_entry()) {
                (contracts[count].owner_count <- count_owner_clauses(nodes, nodes[form].left)):void;
            } else {};
            if (name != no_node()) {
                contracts[count].name_first <- nodes[name].first;
                (contracts[count].name_past <- nodes[name].past):void;
            } else {};
            return next;
        } else {};
        if (next >= limit) return no_node();
        describe_parameter(nodes, names, selected, formal, defining_module, kind == c_operation(), contracts[next]);
        if (kind == c_entry() && contracts[next].value_kind == c_handle_type()) {
            (contracts[next].owner_role <- count_owner_clauses(nodes, nodes[contracts[next].owner_role].left)):void;
        } else {};
        formal <- work[formal].next;
        next <- next + 1u64;
    };
    return no_node();
}

func stage_handle_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, work:const NameWork in W,
                            contracts:ModuleInterfaces in C, count:u64, defining_module:u64, marker:u64) -> u64
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val constructor <- work[marker].active;
    val next <- stage_interface(nodes, names, selected, work, contracts, count, defining_module,
        marker, constructor, if (constructor == no_node()) { c_handle_type() } else { c_constructor() }, 0u8);
    if (next == no_node()) return next;
    val name <- nodes[marker].left;
    contracts[count].name_first <- nodes[name].first;
    contracts[count].name_past <- nodes[name].past;
    val parent <- nodes[marker].right;
    if (parent != no_node()) {
        contracts[count].type_module <- type_module(names, selected, parent, defining_module);
        (contracts[count].type_identity <- type_identity(names, selected, parent)):void;
    } else {};
    if (constructor != no_node()) {
        val failure <- signature_clause(nodes, nodes[constructor].left, throws_clause_node());
        if (failure != no_node()) {
            val type_name <- nodes[failure].right;
            contracts[count].failure_module <- type_module(names, selected, type_name, defining_module);
            (contracts[count].failure_identity <- type_identity(names, selected, type_name)):void;
        } else {};
    } else {};
    return next;
}

func stage_array_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                           selected:const SelectedExports in E, row:ModuleInterfaceRow in R,
                           defining_module:u64, declaration:u64)
    where {const owner N, const owner B, const owner E, owner R} {
    write_interface_header(row, defining_module, declaration, array_type(), 0u8, 0u64);
    val element <- nodes[nodes[declaration].right].right;
    val kind <- names[element].kind;
    if (kind == record_type() || imported_kind(names, selected, element) == record_export()) {
        row.element_kind <- record_type();
        row.type_module <- type_module(names, selected, element, defining_module);
        (row.type_identity <- type_identity(names, selected, element)):void;
    } else {
        (row.element_kind <- kind):void;
    };
}

# The checked declarations retain their identity even when their names are
# private. Only ModuleExports contributes names to another module's lookup.
export func publish_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:const NameWork in W,
                               used:u64, defining_module:u64, contracts:ModuleInterfaces in C) -> u64
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val limit <- intrinsic (len)(contracts);
    val count <- 0u64;
    val kind <- 0u8;
    val form <- 0u8;
    val result_kind <- 0u8;
    for (at in 0u64 .. used) {
        kind <- names[at].kind;
        form <- nodes[at].kind;
        if (form == array_declaration_node()) {
            if (count >= limit) return no_node();
            stage_array_interface(nodes, names, selected, contracts[count], defining_module, at);
            (count <- count + 1u64):void;
        } else {};
        if (form == c_handle_type_node() && work[at].active == no_node()) {
            (count <- stage_handle_interface(nodes, names, selected, work, contracts, count,
                                             defining_module, at)):void;
        } else {
            if (form == c_procedure_node() && kind == c_constructor()) {
                (count <- stage_handle_interface(nodes, names, selected, work, contracts, count,
                                                 defining_module, names[at].declaration)):void;
            } else {
                if (form == c_procedure_node() || (form == callable_node() && names[at].declaration == at)) {
                    result_kind <- declared_call_result(nodes, names, work, selected, at);
                    (count <- stage_interface(nodes, names, selected, work, contracts, count, defining_module,
                                               at, at, kind, result_kind)):void;
                } else {};
            };
        };
        if (count == no_node()) return count;
    };
    return count;
}

func publish_selection(selected:const SelectedExports in E, site:u64,
                       exports:ModuleExports in X, at:u64) -> bool
    where {const owner E, owner X} {
    exports[at].origin_module <- selected[site].origin_module;
    exports[at].identity <- selected[site].identity;
    exports[at].kind <- selected[site].kind;
    exports[at].checked <- selected[site].checked;
    exports[at].owner_module <- selected[site].owner_module;
    exports[at].owner_identity <- selected[site].owner_identity;
    exports[at].shape <- selected[site].shape;
    return selected[site].kind != 0u8;
}

func publish_declaration(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         publication:const ModulePublication in P, name:u64, exports:ModuleExports in X, at:u64) -> bool
    where {const owner N, const owner B, const owner E, const owner P, owner X} {
    val target <- names[name].declaration;
    val kind <- names[name].kind;
    exports[at].origin_module <- publication.module_identity;
    exports[at].identity <- target;
    exports[at].checked <- 0u8;
    exports[at].owner_module <- 0u64;
    exports[at].owner_identity <- 0u64;
    (exports[at].shape <- 0u8):void;
    if (kind == ordinary_selection() || kind == symbolic_selection())
        return publish_selection(selected, target, exports, at);
    if (kind == c_handle_type()) {
        ref root = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        handle_owner(nodes, names, selected, name, root);
        exports[at].kind <- native_handle_export();
        exports[at].shape <- if (is_owning_handle(nodes, names, selected, name)) { owning_handle() } else { child_handle() };
        if (root.origin == 0u64) {
            (exports[at].owner_module <- publication.module_identity):void;
        } else {
            (exports[at].owner_module <- root.origin):void;
        };
        exports[at].owner_identity <- root.identity;
        return true;
    } else {};
    if (kind == record_type()) {
        if (exception_record(nodes, target)) {
            exports[at].kind <- nominal_exception_export();
            exports[at].checked <- 1u8;
            if (scalar_failure(nodes, names, selected, name)) { (exports[at].shape <- scalar_exception()):void; } else {};
        } else {
            exports[at].kind <- record_export();
            if (names[target].kind == finite_references()) {
                (exports[at].shape <- reference_record()):void;
            } else {
                exports[at].shape <- if (nodes[target].right != no_node() &&
                    uses_direct_scalars(nodes, names, nodes[target].right, true)) { numeric_record() } else { bits_record() };
                {};
            };
        };
        return true;
    } else {};
    if (kind == array_type()) {
        exports[at].kind <- array_export();
        exports[at].shape <- array_shape(nodes, names, selected, target);
        return true;
    } else {};
    if (kind == enum_type()) {
        exports[at].kind <- enum_export();
        exports[at].shape <- names[nodes[target].number].kind;
        return true;
    } else {};
    if (kind == c_operation() || kind == c_entry() || kind == callable_binding()) {
        exports[at].kind <- callable_export();
        return true;
    } else {};
    return false;
}

# Append explicit exports after successful binding. The caller holds the
# checked source bytes in the catalog and lends only the committed prefix.
# A re-export changes spelling and preserves the original definition.
export func publish_module_exports(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                   names:const NameBindings in B, selected:const SelectedExports in E,
                                   publication:const ModulePublication in P, used:u64, exports:ModuleExports in X,
                                   count:u64 in C, conflict:u64 in C) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner P, owner X, owner C} {
    conflict <- no_node();
    if (publication.module_identity == 0u64 || publication.module_identity == no_node() ||
        used > intrinsic (len)(nodes) ||
        used > intrinsic (len)(names) || used > intrinsic (len)(selected) || count > intrinsic (len)(exports))
        return false;
    val next <- count;
    val name <- no_node();
    val selection <- false;
    val first <- 0u64;
    val prior <- no_node();
    for (at in 0u64 .. used) {
        name <- no_node();
        selection <- nodes[at].kind == export_from_node();
        if (selection) {
            (name <- local_resource_name(nodes, at)):void;
        } else {
            if (nodes[at].kind == export_node()) { (name <- nodes[at].left):void; } else {};
            if (nodes[at].kind == module_item_node() && nodes[at].number != 0u64) {
                (name <- if (nodes[nodes[at].right].kind == import_node()) {
                    local_resource_name(nodes, nodes[at].right)
                } else { definition_name(nodes, nodes[at].right) }):void;
            } else {};
        };
        if (name != no_node()) {
            if (next == intrinsic (len)(exports) || nodes[name].past > no_node() - publication.source_first)
                return false;
            if (selection) {
                if (!publish_selection(selected, at, exports, next)) return false;
            } else {
                if (!publish_declaration(nodes, names, selected, publication, name, exports, next)) return false;
            };
            first <- nodes[name].first + if (nodes[name].kind == symbol_node()) { 1u64 } else { 0u64 };
            prior <- previous_public_name(source, publication, exports, count, next, first, nodes[name].past);
            if (prior != no_node() && (exports[prior].origin_module != exports[next].origin_module ||
                exports[prior].kind != exports[next].kind || exports[prior].identity != exports[next].identity)) {
                conflict <- name;
                return false;
            } else {};
            exports[next].publishing_module <- publication.module_identity;
            exports[next].module_first <- 0u64;
            exports[next].module_past <- 0u64;
            exports[next].name_first <- publication.source_first + first;
            exports[next].name_past <- publication.source_first + nodes[name].past;
            if (prior == no_node()) { (next <- next + 1u64):void; } else {};
        } else {};
    };
    count <- next;
    return true;
}

func previous_public_name(source:const SourceBytes in S, publication:const ModulePublication in P,
                          exports:const ModuleExports in E, start:u64, limit:u64, first:u64, past:u64)
    -> u64 where {const owner S, const owner P, const owner E} {
    val offset <- publication.source_first;
    for (at in start .. limit) {
        if (same_name(source, first, past, source, exports[at].name_first - offset, exports[at].name_past - offset))
            return at;
    };
    return no_node();
}
