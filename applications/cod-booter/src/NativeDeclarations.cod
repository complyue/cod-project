export data NativeDeclarationResult {
    diagnostic:UInt8,
    node:UInt64,
}

func invalid_native_owner_type() -> UInt8 { return 16u8; }
func invalid_native_failure() -> UInt8 { return 19u8; }
func native_owner_required() -> UInt8 { return 20u8; }
func mixed_native_owner_types() -> UInt8 { return 21u8; }
func invalid_native_parameter() -> UInt8 { return 22u8; }
func invalid_native_result() -> UInt8 { return 23u8; }
func duplicate_native_constructor() -> UInt8 { return 24u8; }
func invalid_native_access() -> UInt8 { return 25u8; }
func invalid_native_callback() -> UInt8 { return 26u8; }
func c_string_argument_required() -> UInt8 { return 99u8; }
func string_argument_required() -> UInt8 { return 100u8; }
func mismatched_symbol_installation() -> UInt8 { return 104u8; }
func invalid_nominal_parent() -> UInt8 { return 105u8; }
func cyclic_nominal_parent() -> UInt8 { return 106u8; }
func invalid_array_shape() -> UInt8 { return 27u8; }
func invalid_handle_initializer() -> UInt8 { return 52u8; }
func mismatched_handle_type() -> UInt8 { return 53u8; }
func invalid_handle_acquisition_mode() -> UInt8 { return 54u8; }
func missing_handle_constructor() -> UInt8 { return 55u8; }
func wrong_constructor_arity() -> UInt8 { return 57u8; }
func unproved_constructor_operand() -> UInt8 { return 58u8; }
func mismatched_actual_handle_owner() -> UInt8 { return 59u8; }
func invalid_constructor_bits() -> UInt8 { return 60u8; }
func ordinary_here_parameter_required() -> UInt8 { return 170u8; }
func duplicate_call_argument() -> UInt8 { return 171u8; }
func incompatible_forwarded_here() -> UInt8 { return 172u8; }
func missing_call_argument() -> UInt8 { return 173u8; }
func unknown_argument_label() -> UInt8 { return 174u8; }
func extra_call_argument() -> UInt8 { return 175u8; }
func here_operation_required() -> UInt8 { return 64u8; }
func unproved_imported_here_signature() -> UInt8 { return 65u8; }
func mismatched_here_receivers() -> UInt8 { return 66u8; }
func mismatched_here_receiver_type() -> UInt8 { return 67u8; }
func mismatched_here_feedback() -> UInt8 { return 68u8; }
func here_body_required() -> UInt8 { return 69u8; }
func procedure_in_function() -> UInt8 { return 70u8; }
func unproved_here_feedback() -> UInt8 { return 71u8; }
func mismatched_enum_feedback() -> UInt8 { return 88u8; }

export func unsupported_owning_region_result() -> UInt8 { return 119u8; }

func reject_declaration(report:NativeDeclarationResult in R, at:UInt64, cause:UInt8) -> void where {owner R} {
    report.diagnostic <- cause;
    (report.node <- at):void;
}

func check_callable_permissions(nodes:const ExprNodes in N, names:const NameBindings in B,
                              at:UInt64, kind:InterfaceCallableKind, report:NativeDeclarationResult in
                                  R) -> bool
    where {const owner N, const owner B, owner R} {
    if (kind == NoCallableKind) {
        reject_declaration(report, at, invalid_native_parameter());
        return false
    };
    if (kind == CheckedProcedure && is_function(nodes, enclosing_callable(nodes, names,
        names[at].scope))) {
        reject_declaration(report, at, procedure_in_function());
        return false
    };
    return true
}

func checked_callable_kind(function_form:bool) -> InterfaceCallableKind {
    return if (function_form) { CheckedFunction:InterfaceCallableKind } else {
        CheckedProcedure:InterfaceCallableKind }
}

export func native_declaration_first(nodes:const ExprNodes in N, used:UInt64,
                                     report:const NativeDeclarationResult in R) -> UInt64 where {const owner N, const owner R} {
    val first <- syntax_first(nodes, used, report.node);
    if (first == no_node() || report.diagnostic != invalid_array_shape()) return first;
    case nodes[report.node] of {
        (Vacant) -> {};
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (ArrayDefinition { val opening <- dimension_at, }) -> { return opening; };
                (_) -> {};
            }
        };
    };
    return first;
}

func passed_by_reference(mode:FormalMode) -> bool {
    return mode == ReferenceFormal || mode == PointerFormal;
}

func typed_parameter(nodes:const ExprNodes in N, revision:UInt64, used:UInt64, at:UInt64,
    fixed_values:bool, formal:FormalSites in F, binding:BindingSites in B) -> bool
    where {const owner N, owner F, owner B} {
    return inspect_formal(nodes, revision, used, at, formal) == OrdinaryFormal &&
        formal.mode != ReferenceSlotFormal &&
        (!formal_binding_is_fixed(nodes, revision, used, at) ||
            (fixed_values && (formal.mode == ValueFormal || formal.mode == ExplicitValueFormal))) &&
        inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding
}

func typed_formal(nodes:const ExprNodes in N, revision:UInt64, used:UInt64, at:UInt64,
    formal:FormalSites in F, binding:BindingSites in B) -> bool
    where {const owner N, owner F, owner B} {
    return typed_parameter(nodes, revision, used, at, false, formal, binding)
}

func signature_formals(nodes:const ExprNodes in N, revision:UInt64, used:UInt64, signature:UInt64,
                       head:UInt64 in H, first:UInt64 in F) -> bool where {const owner N, owner H, owner F} {
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    return find_signature_clause(nodes, revision, used, signature, SignatureHead, head) &&
        inspect_signature(nodes, revision, used, head, sites) == SignatureHead &&
        first_sequence_entry(nodes, revision, used, sites.parameter_tail, FormalSequence, first);
}

func numeric_native(kind:UInt8) -> bool { return native_scalar(kind) && kind != builtin_bool(); }

func owning_handle() -> UInt8 { return 1u8; }
func child_handle() -> UInt8 { return 2u8; }
export func reference_symbol_shape(nullable:bool, readonly:bool) -> UInt8 {
    if (nullable) return if (readonly) { 6u8 } else { 5u8 };
    return if (readonly) { 4u8 } else { 3u8 };
}
func readonly_numeric_array() -> UInt8 { return 1u8; }
func numeric_record_array() -> UInt8 { return 2u8; }
func scalar_exception() -> UInt8 { return 1u8; }

func imported_kind(names:const NameBindings in B, selected:const SelectedExports in E, at:UInt64) -> UInt8
    where {const owner B, const owner E} {
    if (names[at].kind != ordinary_selection()) return 0u8;
    return selected[names[at].declaration].kind;
}

func exception_selection(names:const NameBindings in B, selected:const SelectedExports in E, at:UInt64) -> bool
    where {const owner B, const owner E} {
    return imported_kind(names, selected, at) == exception_type_export();
}

func nominal_exception(nodes:const ExprNodes in N, names:const NameBindings in B,
                       selected:const SelectedExports in E, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E} {
    if (names[at].kind == record_type()) return has_exception_parent(nodes, names, names[at].declaration, revision, used);
    return imported_kind(names, selected, at) == nominal_exception_export();
}

export func declared_exception_type(nodes:const ExprNodes in N, names:const NameBindings in B,
                                    selected:const SelectedExports in E, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E} {
    return exception_selection(names, selected, at) || nominal_exception(nodes, names, selected, at, used, revision);
}

func is_owning_handle(nodes:const ExprNodes in N, names:const NameBindings in B,
                      selected:const SelectedExports in E, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    if (names[at].kind == c_handle_type()) {
        ref declaration = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        return inspect_declaration(nodes, revision, used, target, declaration) == HandleTypeDeclaration &&
            declaration.parent_type == no_node();
    };
    return imported_kind(names, selected, at) == native_handle_export() && selected[target].shape == owning_handle();
}

func native_handle_marker(names:const NameBindings in B, selected:const SelectedExports in E, marker:UInt64) -> bool
    where {const owner B, const owner E} {
    return names[marker].kind == c_handle_type() || imported_kind(names, selected, marker) == native_handle_export();
}

func same_native_type(names:const NameBindings in B, selected:const SelectedExports in E, first:UInt64, second:UInt64) -> bool
    where {const owner B, const owner E} {
    val declared <- names[first].declaration;
    val supplied <- names[second].declaration;
    if (names[first].kind != ordinary_selection() || names[second].kind != ordinary_selection())
        return names[first].kind == names[second].kind && declared == supplied;
    return selected[declared].origin_module == selected[supplied].origin_module &&
        selected[declared].identity == selected[supplied].identity;
}

func uses_direct_scalars(nodes:const ExprNodes in N, names:const NameBindings in B,
                         fields:UInt64, numeric_only:bool, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner B} {
    val field <- fields;
    val kind <- 0u8;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    for (unused in 0u64 .. used) {
        if (field == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, used, field, entry) != FormalSequence ||
            !typed_formal(nodes, revision, used, field, formal, binding)) return false;
        kind <- names[binding.target_type].kind;
        if (passed_by_reference(formal.mode) || !native_scalar(kind) || (numeric_only && !numeric_native(kind))) return false;
        field <- entry.previous;
    };
    return false;
}

func scalar_failure(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                    at:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    if (names[at].kind == record_type()) {
        ref declaration = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        return inspect_declaration(nodes, revision, used, target, declaration) == NominalRecord &&
            has_exception_parent(nodes, names, target, revision, used) &&
            uses_direct_scalars(nodes, names, declaration.entries, false, used, revision);
    };
    return imported_kind(names, selected, at) == nominal_exception_export() && selected[target].shape == scalar_exception();
}

func check_nominal_parent(nodes:const ExprNodes in N, names:const NameBindings in B,
                          selected:const SelectedExports in E, form:UInt64, used:UInt64, revision:UInt64,
                          report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner R} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, form, declaration);
    val abstract <- shape == AbstractTypeDeclaration;
    val parent <- declaration.parent_type;
    val identity <- 0u64;
    for (unused in 0u64 .. used) {
        if (parent == no_node()) return;
        if (shape == NativeRecord) {
            reject_declaration(report, parent, invalid_nominal_parent());
            return;
        };
        if (names[parent].kind == abstract_type_binding()) {
            if (!abstract) return;
            if (inspect_declaration(nodes, revision, used, names[parent].declaration, declaration) != AbstractTypeDeclaration) {
                reject_declaration(report, parent, invalid_nominal_parent());
                return;
            };
            (parent <- declaration.parent_type):void;
        } else {
            if (imported_kind(names, selected, parent) == abstract_type_export()) return;
            if (!abstract && exception_selection(names, selected, parent)) {
                identity <- selected[names[parent].declaration].identity;
                if (identity == exception_root_identity() || identity == error_root_identity()) return;
            };
            reject_declaration(report, parent, invalid_nominal_parent());
            return;
        };
    };
    reject_declaration(report, form, cyclic_nominal_parent());
}

func check_type_declaration(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I,
                            interface_used:UInt64, facts:const AggregateFacts in F, form:UInt64, used:UInt64, revision:UInt64,
                            report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, const owner I, const owner F, owner R} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, form, declaration);
    if (shape == NativeSymbolDeclaration) {
        val marker <- declaration.value_type;
        if (!is_owning_handle(nodes, names, selected, marker, used, revision))
            { reject_declaration(report, marker, invalid_native_owner_type()); } else {};
        return;
    };
    if (shape == HandleTypeDeclaration) {
        val actual <- declaration.parent_type;
        if (actual != no_node() && !is_owning_handle(nodes, names, selected, actual, used, revision))
            { reject_declaration(report, actual, invalid_native_owner_type()); } else {};
        return;
    };
    if (shape == ArrayTypeDeclaration) {
        val index <- names[declaration.index_type].kind;
        val element <- declaration.value_type;
        val element_kind <- names[element].kind;
        val integral <- index == builtin_u8() || index == builtin_u32() || index == builtin_u64() || index == builtin_i64();
        val imported <- imported_kind(names, selected, element);
        val storage <- array_element_storage(names, selected, interfaces, interface_used, facts, element);
        val product <- element_kind == record_type() || imported == record_export();
        val exception <- element_kind == record_type() &&
            has_exception_parent(nodes, names, names[element].declaration, revision, used);
        if (!integral || exception || storage == UnprovedAggregate || (storage == NonBitsAggregate && !product)) {
            reject_declaration(report, form, invalid_array_shape());
        } else {};
        return;
    };
    if (shape == NominalRecord || shape == NativeRecord || shape == AbstractTypeDeclaration)
        { check_nominal_parent(nodes, names, selected, form, used, revision, report); } else {};
    return;
}

func array_shape(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                 form:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B, const owner E} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, form, declaration) != ArrayTypeDeclaration ||
        names[declaration.index_type].kind != builtin_u64()) return 0u8;
    val element <- declaration.value_type;
    if (numeric_native(names[element].kind)) return readonly_numeric_array();
    val record <- names[element].declaration;
    if (names[element].kind == record_type() && !has_exception_parent(nodes, names, record, revision, used)) {
        val shape <- inspect_declaration(nodes, revision, used, record, declaration);
        if ((shape == NominalRecord || shape == NativeRecord) && declaration.entries != no_node() &&
            uses_direct_scalars(nodes, names, declaration.entries, true, used, revision)) return numeric_record_array();
    };
    if (imported_kind(names, selected, element) == record_export() &&
        selected[record].shape == numeric_record_shape()) return numeric_record_array();
    return 0u8;
}

func native_array_view(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                       at:UInt64, readonly:bool, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner B, const owner E} {
    val target <- names[at].declaration;
    val shape <- 0u8;
    if (names[at].kind == array_type()) {
        (shape <- array_shape(nodes, names, selected, target, used, revision)):void;
    } else {
        if (imported_kind(names, selected, at) == array_export()) { (shape <- selected[target].shape):void; } else {};
    };
    return shape == numeric_record_array() || (readonly && shape == readonly_numeric_array());
}

data NativeOwnerType {
    origin:UInt64,
    identity:UInt64,
}

# Zero is the current module's local namespace during checking. A checked
# dependency has a nonzero module identity and cannot depend on this module.
func handle_owner(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                  at:UInt64, root:NativeOwnerType in R, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    val target <- names[at].declaration;
    if (names[at].kind == c_handle_type()) {
        ref declaration = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        if (inspect_declaration(nodes, revision, used, target, declaration) != HandleTypeDeclaration) return false;
        val parent <- declaration.parent_type;
        if (parent == no_node()) {
            root.origin <- 0u64;
            root.identity <- target;
            return true;
        } else {};
        val owner_target <- names[parent].declaration;
        if (names[parent].kind == c_handle_type()) {
            root.origin <- 0u64;
            root.identity <- owner_target;
        } else {
            root.origin <- selected[owner_target].owner_module;
            root.identity <- selected[owner_target].owner_identity;
        };
        return true;
    } else {};
    root.origin <- selected[target].owner_module;
    root.identity <- selected[target].owner_identity;
    return true;
}

func check_native_argument(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                           selected:const SelectedExports in E, parameter:UInt64, direction:UInt8,
                           used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!typed_formal(nodes, revision, used, parameter, formal, binding)) {
        reject_declaration(report, parameter, invalid_native_parameter());
        return;
    };
    val mode <- formal.mode;
    val annotation <- binding.annotation;
    if (mode != HandleFormal && mode != ReferenceFormal) {
        val kind <- native_value_kind(names, selected, binding.target_type);
        if ((mode != ExplicitValueFormal && mode != ValueFormal) ||
            (!native_scalar(kind) && kind != enum_type())) {
            reject_declaration(report, parameter, invalid_native_parameter());
        } else {};
        return;
    } else {};
    if (binding.owner_name == no_node() || names[binding.owner_name].kind != owner_binding()) {
        reject_declaration(report, annotation, native_owner_required());
        return;
    } else {};
    val declared_type <- binding.target_type;
    val role <- names[binding.owner_name].declaration;
    val readonly <- binding.readonly;
    val const_role <- owner_constraint_syntax(nodes, role) == ReadonlyOwnerConstraint;
    if (mode == ReferenceFormal) {
        val marker <- names[declared_type].kind;
        if (text_type(marker)) {
            if (!readonly || !const_role || (direction != c_entry() && direction != c_operation())) {
                reject_declaration(report, parameter, invalid_native_parameter());
            } else {
                if (work[role].active == no_node()) { (work[role].active <- role):void };
            };
            return;
        } else {};
        if (direction != c_operation() || !readonly || !const_role ||
            !native_array_view(nodes, names, selected, declared_type, true, used, revision)) {
            reject_declaration(report, parameter, invalid_native_parameter());
        } else {
            if (work[role].active == no_node()) { (work[role].active <- role):void; } else {};
        };
        return;
    } else {};
    if (!native_handle_marker(names, selected, declared_type)) {
        reject_declaration(report, declared_type, invalid_native_parameter());
        return;
    } else {};
    if (direction == c_operation() && readonly && !const_role) {
        reject_declaration(report, parameter, invalid_native_access());
        return;
    } else {};
    ref root = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
    ref constraint = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!handle_owner(nodes, names, selected, declared_type, root, used, revision) ||
        inspect_signature(nodes, revision, used, role, constraint) != OwnerSignatureClause) {
        reject_declaration(report, parameter, native_owner_required());
        return;
    };
    val role_name <- constraint.annotation;
    val prior_module <- work[role_name].active;
    if (prior_module != no_node() && (prior_module != root.origin || work[role].active != root.identity)) {
        reject_declaration(report, parameter, mixed_native_owner_types());
        return;
    } else {};
    work[role_name].active <- root.origin;
    (work[role].active <- root.identity):void;
}

func native_value_kind(names:const NameBindings in B, selected:const SelectedExports in E, annotation:UInt64) -> UInt8
    where {const owner B, const owner E} {
    if (imported_kind(names, selected, annotation) == enum_export()) return enum_type();
    return names[annotation].kind;
}

func check_c_callback(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                      selected:const SelectedExports in E, callback:UInt64, supplier:UInt64, result:UInt64,
                      used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner W, const owner E, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!typed_formal(nodes, revision, used, supplier, formal, binding) || binding.owner_name == no_node() ||
        !is_owning_handle(nodes, names, selected, binding.target_type, used, revision)) {
        reject_declaration(report, supplier, invalid_native_callback());
        return;
    };
    val role <- names[binding.owner_name].declaration;
    if (inspect_formal(nodes, revision, used, callback, formal) != HereFormalSyntax) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    };
    val signature <- formal.signature;
    ref feedback = make UInt64 { no_node() };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, revision, used, signature, ValueResultClause, feedback) ||
        inspect_signature(nodes, revision, used, feedback, clause) != ValueResultClause) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    };
    val marker <- clause.annotation;
    val kind <- native_value_kind(names, selected, marker);
    if (kind != native_value_kind(names, selected, result) ||
        (kind == enum_type() && (type_module(names, selected, marker, 0u64) != type_module(names, selected, result, 0u64) ||
                                type_identity(names, selected, marker) != type_identity(names, selected, result)))) {
        reject_declaration(report, marker, invalid_native_callback());
        return;
    };
    ref failure = make UInt64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, signature, ThrowsSignatureClause, failure)) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    };
    if (failure != no_node()) {
        if (inspect_signature(nodes, revision, used, failure, clause) != ThrowsSignatureClause ||
            !declared_exception_type(nodes, names, selected, clause.annotation, used, revision)) {
            reject_declaration(report, clause.annotation, invalid_native_failure());
            return;
        };
    };
    ref head = make UInt64 { no_node() };
    ref parameter = make UInt64 { no_node() };
    if (!signature_formals(nodes, revision, used, signature, head, parameter) || parameter == no_node()) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    };
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return;
        if (!typed_formal(nodes, revision, used, parameter, formal, binding) ||
            formal.mode != ReferenceFormal || binding.owner_name == no_node() ||
            names[binding.owner_name].declaration != role ||
            !native_array_view(nodes, names, selected, binding.target_type, binding.readonly, used, revision)) {
            reject_declaration(report, parameter, invalid_native_callback());
            return;
        };
        if (!binding.readonly && owner_constraint_syntax(nodes, role) == ReadonlyOwnerConstraint) {
            reject_declaration(report, parameter, invalid_native_access());
            return;
        };
        parameter <- work[parameter].next;
    };
}

func check_c_arguments(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                       selected:const SelectedExports in E, first:UInt64, direction:UInt8, owning_constructor:bool,
                       used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val parameter <- first;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return;
        if (!typed_formal(nodes, revision, used, parameter, formal, binding)) {
            reject_declaration(report, parameter, invalid_native_parameter());
            return;
        };
        if (direction == c_constructor() && formal.mode == RetainedHandleFormal) {
            if (!owning_constructor || !native_handle_marker(names, selected, binding.target_type)) {
                reject_declaration(report, parameter, invalid_native_parameter());
                return;
            };
        } else {
            check_native_argument(nodes, names, work, selected, parameter, direction, used, revision, report);
        };
        if (report.diagnostic != 0u8) return;
        parameter <- work[parameter].next;
    };
}

func check_handle_formals(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                          selected:const SelectedExports in E, views:SuppliedViews in V,
                          signature:UInt64, direction:UInt8, used:UInt64, revision:UInt64,
                          report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner V, owner R} {
    ref head = make UInt64 { no_node() };
    ref parameter = make UInt64 { no_node() };
    if (!signature_formals(nodes, revision, used, signature, head, parameter)) {
        reject_declaration(report, signature, invalid_native_parameter());
        return;
    };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return;
        if (inspect_formal(nodes, revision, used, parameter, formal) == OrdinaryFormal && formal.mode == HandleFormal) {
            check_native_argument(nodes, names, work, selected, parameter,
                                  direction, used, revision, report);
            if (report.diagnostic != 0u8) return;
            prepare_handle_contract(nodes, names, selected, views, parameter, used, revision)
        };
        parameter <- work[parameter].next;
    };
}

func check_c_procedure(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                       selected:const SelectedExports in E, form:UInt64, header:UInt64, used:UInt64, revision:UInt64,
                       report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, owner W, const owner E, owner R} {
    val direction <- names[form].kind;
    ref head = make UInt64 { no_node() };
    ref first = make UInt64 { no_node() };
    ref result = make UInt64 { no_node() };
    ref borrowed_result = make UInt64 { no_node() };
    ref failure = make UInt64 { no_node() };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!signature_formals(nodes, revision, used, header, head, first) ||
        !find_signature_clause(nodes, revision, used, header, ValueResultClause, result) ||
        !find_signature_clause(nodes, revision, used, header, BorrowedResultClause, borrowed_result) ||
        !find_signature_clause(nodes, revision, used, header, ThrowsSignatureClause, failure)) {
        reject_declaration(report, header, invalid_native_parameter());
        return;
    };
    if (borrowed_result != no_node()) {
        reject_declaration(report, borrowed_result, invalid_native_result());
        return;
    } else {};
    val result_kind <- builtin_void();
    val result_marker <- no_node();
    if (result != no_node()) {
        if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause) {
            reject_declaration(report, result, invalid_native_result());
            return;
        };
        result_marker <- clause.annotation;
        (result_kind <- native_value_kind(names, selected, result_marker)):void;
    } else {};
    if (direction == c_constructor()) {
        val handle <- names[form].declaration;
        if (work[handle].active != no_node()) {
            reject_declaration(report, form, duplicate_native_constructor());
            return;
        } else {};
        work[handle].active <- form;
        if (failure != no_node()) {
            if (inspect_signature(nodes, revision, used, failure, clause) != ThrowsSignatureClause) {
                reject_declaration(report, failure, invalid_native_failure());
                return;
            };
            val declared_type <- clause.annotation;
            if (!scalar_failure(nodes, names, selected, declared_type, used, revision)) {
                reject_declaration(report, declared_type, invalid_native_failure());
                return;
            } else {};
        } else {};
    } else {
        val valid <- if (direction == c_operation()) {
            result_kind == builtin_bool() || result_kind == builtin_u8() ||
                result_kind == builtin_u64() ||
                result_kind == builtin_void() || result_kind == enum_type()
        } else { result != no_node() && (native_scalar(result_kind) || result_kind == builtin_void() || result_kind == enum_type()) };
        if (failure != no_node()) {
            reject_declaration(report, failure, invalid_native_failure());
            return;
        } else {};
        if (!valid) {
            reject_declaration(report, if (result == no_node()) { form } else { result }, invalid_native_result());
            return;
        } else {};
    };
    val parameter <- first;
    val callback <- no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (first != no_node() && inspect_formal(nodes, revision, used, first, formal) == HereFormalSyntax) {
        parameter <- work[first].next;
        if (direction != c_operation() || (result_kind != builtin_u8() && result_kind != enum_type()) || parameter == no_node() ||
            inspect_formal(nodes, revision, used, parameter, formal) != OrdinaryFormal ||
            formal.mode != HandleFormal || work[parameter].next != no_node()) {
            reject_declaration(report, first, invalid_native_callback());
            return;
        } else {};
        (callback <- first):void;
    } else {};
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val owning_constructor <- direction == c_constructor() &&
        inspect_declaration(nodes, revision, used, names[form].declaration, declaration) == HandleTypeDeclaration &&
        declaration.parent_type == no_node();
    check_c_arguments(nodes, names, work, selected, parameter, direction, owning_constructor, used, revision, report);
    if (report.diagnostic != 0u8) return;
    if (callback != no_node()) {
        check_c_callback(nodes, names, work, selected, callback, work[callback].next, result_marker, used, revision, report);
        if (report.diagnostic != 0u8) return;
    } else {};
    val current <- work[head].next;
    val shape <- InvalidSignature;
    for (unused in 0u64 .. used) {
        if (current == no_node()) return;
        shape <- inspect_signature(nodes, revision, used, current, clause);
        if (shape == InvalidSignature || (shape == OwnerSignatureClause && work[current].active == no_node())) {
            reject_declaration(report, current, native_owner_required());
            return;
        };
        current <- work[current].next;
    };
}

data HandleLoan {
    marker:UInt64,
    owner:UInt64,
    readonly:bool,
}

# Follow the binding's initializer, keeping the actual owner and access of
# the selected borrow. A lexical name alone supplies neither.
func trace_handle_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
                       at:UInt64, loan:HandleLoan in L, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, owner L} {
    val value <- ungrouped(nodes, revision, used, at);
    val declaration <- no_node();
    val readonly <- false;
    ref constructor = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    ref local = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false; };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val mode <- InvalidHandleBinding;
    for (unused in 0u64 .. used) {
        if (inspect_handle_construction(nodes, revision, used, value, constructor) == BorrowHandleMake) {
            loan.marker <- constructor.marker;
            loan.owner <- names[constructor.actual_owner].declaration;
            loan.readonly <- readonly;
            return true;
        };
        if (name_syntax(nodes, used, value) != OrdinaryName) return false;
        declaration <- names[value].declaration;
        if (declaration == no_node()) return false;
        if (names[value].kind == formal_binding()) {
            if (!typed_formal(nodes, revision, used, declaration, formal, binding) || formal.mode != HandleFormal ||
                binding.owner_name == no_node() || names[binding.owner_name].kind != owner_binding()) return false;
            loan.marker <- binding.target_type;
            loan.owner <- names[binding.owner_name].declaration;
            loan.readonly <- readonly || binding.readonly;
            return true;
        };
        if (names[value].kind != handle_binding()) return false;
        mode <- inspect_handle_binding(nodes, revision, used, declaration, local);
        if ((mode != OwnHandleBinding && mode != BorrowHandleBinding) ||
            inspect_binding(nodes, revision, used, local.binding, binding) != TypedBinding) return false;
        readonly <- readonly || local.readonly || binding.readonly;
        if (mode == OwnHandleBinding) {
            loan.marker <- binding.target_type;
            loan.owner <- declaration;
            loan.readonly <- readonly;
            return true;
        };
        value <- ungrouped(nodes, revision, used, local.initializer);
    };
    return false;
}

func scalar_operand_kind(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                          value:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B, const owner W} {
    if (value >= used) return 0u8;
    if (work[value].value_kind != 0u8) return work[value].value_kind;
    case nodes[value] of {
        (Vacant) -> { return 0u8; };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (IntegerLiteral { val width <- width, }) -> {
                    if (width == 64u64) return builtin_u64();
                    return if (width == 8u64) { builtin_u8() } else { builtin_u32() };
                };
                (BooleanLiteral) -> { return builtin_bool(); };
                (_) -> {};
            };
        };
    };
    if (name_syntax(nodes, used, value) != OrdinaryName) return 0u8;
    val kind <- names[value].kind;
    val declaration <- names[value].declaration;
    if (kind == loop_index()) return builtin_u64();
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (kind == formal_binding()) {
        ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
        if (typed_formal(nodes, revision, used, declaration, formal, binding) &&
            (formal.mode == ValueFormal || formal.mode == ExplicitValueFormal)) return names[binding.target_type].kind;
    };
    if (kind == local_binding()) {
        ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
        if (inspect_local_binding(nodes, revision, used, declaration, local) && local.mode == ValueLocal &&
            inspect_binding(nodes, revision, used, local.binding, binding) == TypedBinding) return names[binding.target_type].kind;
    };
    return 0u8;
}

func allows_handle_access(nodes:const ExprNodes in N, loan:const HandleLoan in L,
                          const_argument:bool, const_role:bool) -> bool where {const owner N, const owner L} {
    return (!loan.readonly || const_argument) &&
        (const_role || owner_constraint_syntax(nodes, loan.owner) != ReadonlyOwnerConstraint);
}

func describe_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                        selected:const SelectedExports in E, parameter:UInt64, current_module:UInt64,
                        provider:bool, fixed_values:bool, row:ModuleInterfaceRow in R, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!typed_parameter(nodes, revision, used, parameter, fixed_values, formal, binding)) return false;
    val marker <- binding.target_type;
    write_interface_header(row, 0u64, 0u64, 0u8, 0u8, 0u64);
    val mode <- formal.mode;
    row.field_mode <- mode;
    if (mode == RetainedHandleFormal) {
        row.value_kind <- c_handle_type();
        row.type_module <- type_module(names, selected, marker, current_module);
        row.type_identity <- type_identity(names, selected, marker);
        row.target_readonly <- if (binding.readonly) { 1u8 } else { 0u8 };
        row.owner_readonly <- row.target_readonly;
        return true;
    };
    if (mode == HandleFormal || mode == ReferenceFormal) {
        if (binding.owner_name == no_node()) return false;
        val role <- names[binding.owner_name].declaration;
        val const_role <- owner_constraint_syntax(nodes, role) == ReadonlyOwnerConstraint;
        val kind <- names[marker].kind;
        val scalar_place <- fixed_values && mode == ReferenceFormal && source_place_scalar(kind);
        val builder <- fixed_values && mode == ReferenceFormal && is_lexical_builder(nodes, names, marker, revision, used);
        row.value_kind <- if (mode == HandleFormal) { c_handle_type() }
                          else {
                              if (builder) { lexical_builder_type() } else {
                              if (text_type(kind) || scalar_place) { kind }
                              else { if (fixed_values && (kind == record_type() ||
                                  imported_kind(names, selected, marker) == record_export())) {
                                  record_type()
                              } else { array_type() } }
                              }
                          };
        if (fixed_values && mode == ReferenceFormal &&
            (kind == sum_type() || imported_kind(names, selected, marker) == sum_export())) {
            (row.value_kind <- sum_type()):void
        };
        if (!scalar_place) {
            row.type_module <- type_module(names, selected, marker, current_module);
            (row.type_identity <- type_identity(names, selected, marker)):void
        };
        row.owner_role <- role;
        row.target_readonly <- if (binding.readonly || (mode == HandleFormal && provider && const_role)) { 1u8 } else { 0u8 };
        (row.owner_readonly <- if (const_role) { 1u8 } else { 0u8 }):void;
    } else {
        row.value_kind <- native_value_kind(names, selected, marker);
        if (row.value_kind == enum_type()) {
            row.type_module <- type_module(names, selected, marker, current_module);
            (row.type_identity <- type_identity(names, selected, marker)):void;
        } else {};
    };
    return true;
}

func match_handle_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, parameter:const ModuleInterfaceRow in P,
                            operand:UInt64, loan:HandleLoan in L, used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, owner L, owner R} {
    if (!trace_handle_loan(nodes, names, operand, loan, used, revision)) {
        reject_declaration(report, operand, mismatched_handle_type());
        return false;
    };
    return match_selected_handle(nodes, names, selected, parameter, operand, loan, report)
}

func match_selected_handle(nodes:const ExprNodes in N, names:const NameBindings in B,
                           selected:const SelectedExports in E, parameter:const ModuleInterfaceRow in P,
                           operand:UInt64, loan:const HandleLoan in L, report:NativeDeclarationResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner P, const owner L, owner R} {
    if (!native_handle_marker(names, selected, loan.marker) ||
        type_module(names, selected, loan.marker, 0u64) != parameter.type_module ||
        type_identity(names, selected, loan.marker) != parameter.type_identity) {
        reject_declaration(report, operand, mismatched_handle_type());
        return false;
    } else {};
    if (!allows_handle_access(nodes, loan, parameter.target_readonly != 0u8, parameter.owner_readonly != 0u8)) {
        reject_declaration(report, operand, invalid_native_access());
        return false;
    } else {};
    return true;
}

func match_constructor_parameter(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, parameter:const ModuleInterfaceRow in P,
                                 work:const NameWork in W, operand:UInt64, loan:HandleLoan in L, used:UInt64, revision:UInt64,
                                 report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, const owner W, owner L, owner R} {
    if (parameter.value_kind == c_handle_type())
        return match_handle_parameter(nodes, names, selected, parameter, operand, loan, used, revision, report);
    val actual <- ungrouped(nodes, revision, used, operand);
    val kind <- scalar_operand_kind(nodes, names, work, actual, used, revision);
    val expected <- parameter.value_kind;
    if (kind != expected || (kind == enum_type() &&
        (work[actual].value_module != parameter.type_module || work[actual].value_identity != parameter.type_identity))) {
        reject_declaration(report, operand,
            if (native_scalar(kind) || kind == enum_type()) { invalid_constructor_bits() } else { unproved_constructor_operand() });
        return false;
    } else {};
    return true;
}

func shares_imported_owner(contracts:const ModuleInterfaces in C, work:const NameWork in W,
                            first:UInt64, limit:UInt64, first_actual:UInt64, role:UInt64, owner_site:UInt64) -> bool
    where {const owner C, const owner W} {
    val actual <- first_actual;
    for (row in first .. limit) {
        if (contracts[row].owner_role == role && work[actual].active != owner_site) return false;
        actual <- work[actual].next;
    };
    return true;
}

func check_imported_constructor(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, interface_count:UInt64,
                                 work:NameWork in W, at:UInt64, syntax:const HandleConstructionSites in H,
                                 used:UInt64, revision:UInt64, report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, const owner C, owner W, const owner H, owner R} {
    val marker <- syntax.marker;
    val head <- find_interface(contracts, interface_count, type_module(names, selected, marker, 0u64),
                                type_identity(names, selected, marker));
    if (head == no_node() || contracts[head].interface_kind != c_constructor()) {
        reject_declaration(report, at, missing_handle_constructor());
        return;
    } else {};
    if (!check_callable_permissions(nodes, names, at, contracts[head].callable_kind,
        report)) return;
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, syntax.arguments, ArgumentSequence, first)) {
        reject_declaration(report, at, wrong_constructor_arity());
        return;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val actual <- first;
    val operand <- no_node();
    val role <- no_node();
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    for (row in head + 1u64 .. head + 1u64 + contracts[head].entry_count) {
        if (inspect_sequence_entry(nodes, revision, used, actual, entry) != ArgumentSequence) { reject_declaration(report, at, wrong_constructor_arity()); return; } else {};
        operand <- entry.item;
        if (!match_constructor_parameter(nodes, names, selected, contracts[row], work, operand, loan, used, revision, report))
            return;
        if (contracts[row].value_kind == c_handle_type() && contracts[row].owner_role != no_node()) {
            role <- contracts[row].owner_role;
            if (!shares_imported_owner(contracts, work, head + 1u64, row, first, role, loan.owner)) {
                reject_declaration(report, operand, mismatched_actual_handle_owner());
                return;
            } else {};
            (work[actual].active <- loan.owner):void;
        } else {};
        actual <- work[actual].next;
    };
    if (actual != no_node()) { reject_declaration(report, at, wrong_constructor_arity()); } else {};
}

func check_constructor_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E, work:NameWork in W,
                                 at:UInt64, constructor:UInt64, syntax:const HandleConstructionSites in H,
                                 used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner W, const owner H, owner R} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref head = make UInt64 { no_node() };
    ref formal = make UInt64 { no_node() };
    ref actual = make UInt64 { no_node() };
    if (inspect_callable(nodes, revision, used, constructor, callable) != CProvider ||
        !signature_formals(nodes, revision, used, callable.signature, head, formal) ||
        !first_sequence_entry(nodes, revision, used, syntax.arguments, ArgumentSequence, actual)) {
        reject_declaration(report, at, wrong_constructor_arity());
        return;
    };
    if (!check_callable_permissions(nodes, names, at, checked_callable_kind(callable.function_form),
        report)) return;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref role = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    ref parameter = make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node(); target_readonly <- 0u8; owner_readonly <- 0u8;
        has_here <- 0u8; failure_module <- 0u64; failure_identity <- 0u64; failure_checked <- 0u8;
        name_first <- 0u64; name_past <- 0u64; enum_code <- 0u64;
        native_function <- no_node(); callable_kind <- NoCallableKind; native_reception <- 0u8;
        membership <- UnprovedMembership;
        native_passes_owner <- 0u8; payload <- make NoInterfacePayload {};
        aggregate_storage <- UnprovedAggregate; exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
        scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- NoArrayRead; source_numeric_fault <- false; source_writer <- NoSourceWriter; object_view <- make NoCallableObjectView {};
        array_slot_checked <- false; slot_target_invariant <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    };
    val operand <- no_node();
    val owner <- no_node();
    val role_name <- no_node();
    for (unused in 0u64 .. used) {
        if (formal == no_node() || actual == no_node()) {
            if (formal != actual) { reject_declaration(report, at, wrong_constructor_arity()); } else {};
            return;
        } else {};
        if (inspect_sequence_entry(nodes, revision, used, actual, entry) != ArgumentSequence ||
            !describe_parameter(nodes, names, selected, formal, 0u64, false, false, parameter, used, revision)) {
            reject_declaration(report, actual, unproved_constructor_operand());
            return;
        };
        operand <- entry.item;
        if (!match_constructor_parameter(nodes, names, selected, parameter, work, operand, loan, used, revision, report)) return;
        if (parameter.value_kind == c_handle_type() && parameter.owner_role != no_node()) {
            owner <- parameter.owner_role;
            if (inspect_signature(nodes, revision, used, owner, role) != OwnerSignatureClause) {
                reject_declaration(report, actual, native_owner_required());
                return;
            };
            role_name <- role.annotation;
            if (work[role_name].active == at && work[owner].active != loan.owner) {
                reject_declaration(report, operand, mismatched_actual_handle_owner());
                return;
            } else {};
            work[role_name].active <- at;
            (work[owner].active <- loan.owner):void;
        } else {};
        formal <- work[formal].next;
        actual <- work[actual].next;
    };
}

func check_handle_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:NameWork in W,
                               at:UInt64, owning:bool, syntax:const HandleConstructionSites in H, emit_object:bool,
                               used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, owner W, const owner H, owner R} {
    val marker <- syntax.marker;
    if (!native_handle_marker(names, selected, marker) || owning != is_owning_handle(nodes, names, selected, marker, used, revision)) {
        reject_declaration(report, marker, invalid_handle_acquisition_mode());
        return;
    };
    if (owning && work[at].active == no_node()) {
        reject_declaration(report, at, invalid_handle_initializer());
        return;
    };
    if (!owning) {
        val owner_name <- syntax.actual_owner;
        val lexical <- names[owner_name].declaration;
        ref local = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false; };
        ref binding = make BindingSites {
            name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
        };
        if (inspect_handle_binding(nodes, revision, used, lexical, local) != OwnHandleBinding ||
            inspect_binding(nodes, revision, used, local.binding, binding) != TypedBinding ||
            !native_handle_marker(names, selected, binding.target_type)) {
            reject_declaration(report, owner_name, mismatched_actual_handle_owner());
            return;
        };
        if (local.readonly) {
            reject_declaration(report, owner_name, invalid_native_access());
            return
        };
        ref required = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        ref actual = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        if (!handle_owner(nodes, names, selected, marker, required, used, revision) ||
            !handle_owner(nodes, names, selected, binding.target_type, actual, used, revision) ||
            required.origin != actual.origin || required.identity != actual.identity) {
            reject_declaration(report, owner_name, mismatched_actual_handle_owner());
            return;
        };
    };
    # The declaration graph checks arguments after gathering their type evidence.
    if (names[marker].kind != c_handle_type()) return;
    val constructor <- work[names[marker].declaration].active;
    if (constructor == no_node()) {
        reject_declaration(report, at, missing_handle_constructor());
        return;
    };
    if (emit_object) {
        check_constructor_arguments(nodes, names, selected, work, at, constructor, syntax, used, revision, report);
    } else {};
}

func check_handle_local(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                        at:UInt64, owning:bool, local:const BoundHandleSites in H, used:UInt64, revision:UInt64,
                        report:NativeDeclarationResult in R) -> void
    where {const owner N, const owner B, const owner E, const owner H, owner R} {
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, local.binding, binding) != TypedBinding) {
        reject_declaration(report, at, invalid_handle_initializer());
        return;
    };
    val marker <- binding.target_type;
    val initializer <- ungrouped(nodes, revision, used, local.initializer);
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    if (owning) {
        ref acquired = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
        if (inspect_handle_construction(nodes, revision, used, initializer, acquired) != OwnHandleMake) {
            reject_declaration(report, initializer, invalid_handle_initializer());
            return;
        };
        (loan.marker <- acquired.marker):void;
    } else {
        if (!trace_handle_loan(nodes, names, initializer, loan, used, revision)) {
            reject_declaration(report, initializer, invalid_handle_initializer());
            return;
        };
    };
    if (!native_handle_marker(names, selected, marker) || !native_handle_marker(names, selected, loan.marker) ||
        !same_native_type(names, selected, marker, loan.marker)) {
        reject_declaration(report, initializer, mismatched_handle_type());
        return;
    };
    if (binding.owner_name != no_node() && names[binding.owner_name].declaration != loan.owner) {
        reject_declaration(report, initializer, mismatched_actual_handle_owner());
    } else {};
}

func native_symbol_matches(nodes:const ExprNodes in N, names:const NameBindings in B,
                           selected:const SelectedExports in E, name:UInt64, marker:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E} {
    val declaration <- names[name].declaration;
    if (!is_owning_handle(nodes, names, selected, marker, used, revision)) return false;
    if (names[name].kind == native_symbol_binding()) {
        ref effect_name = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        return inspect_declaration(nodes, revision, used, declaration, effect_name) == NativeSymbolDeclaration &&
            same_native_type(names, selected, effect_name.value_type, marker);
    };
    return names[name].kind == symbolic_selection() && selected[declaration].kind == symbol_export() &&
        selected[declaration].shape == owning_handle() && selected[declaration].owner_module == type_module(names, selected, marker, 0u64) &&
        selected[declaration].owner_identity == type_identity(names, selected, marker);
}

func reference_symbol(names:const NameBindings in B, selected:const SelectedExports in E, name:UInt64) -> bool
    where {const owner B, const owner E} {
    if (names[name].kind == reference_symbol_binding()) return true;
    if (names[name].kind != symbolic_selection()) return false;
    val imported <- names[name].declaration;
    if (selected[imported].kind != symbol_export()) return false;
    val shape <- selected[imported].shape;
    return shape >= reference_symbol_shape(false, false) && shape <= reference_symbol_shape(true, true);
}

func attach_handle_acquisition(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:NameWork in W,
                               at:UInt64, expression:UInt64, effect_name:UInt64, used:UInt64, revision:UInt64,
                               report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    val initializer <- ungrouped(nodes, revision, used, expression);
    ref acquired = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    if (inspect_handle_construction(nodes, revision, used, initializer, acquired) != OwnHandleMake) {
        reject_declaration(report, if (initializer == no_node()) { expression } else { initializer }, invalid_handle_initializer());
        return false;
    };
    if (effect_name != no_node() && !native_symbol_matches(nodes, names, selected, effect_name, acquired.marker, used, revision)) {
        reject_declaration(report, initializer, mismatched_handle_type());
        return false;
    };
    work[initializer].active <- at;
    return true;
}

func same_native_symbol(names:const NameBindings in B, selected:const SelectedExports in E,
                        left:UInt64, right:UInt64) -> bool where {const owner B, const owner E} {
    val left_kind <- names[left].kind;
    if (left_kind != names[right].kind) return false;
    val a <- names[left].declaration;
    val b <- names[right].declaration;
    if (left_kind == native_symbol_binding()) return a == b && a != no_node();
    return left_kind == symbolic_selection() &&
        a < intrinsic (len)(selected) && b < intrinsic (len)(selected) &&
        selected[a].kind == symbol_export() && selected[b].kind == symbol_export() &&
        selected[a].origin_module == selected[b].origin_module &&
        selected[a].identity == selected[b].identity
}

# The selected installation belongs to the current lexical activation. A
# preceding install with the same spelling but a different identity is skipped.
func trace_installed_handle(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, work:const NameWork in W,
                            name:UInt64, loan:HandleLoan in L, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner W, owner L} {
    val install <- work[name].native_installation;
    val initializer <- no_node();
    ref acquired = make HandleConstructionSites {
        marker <- no_node(); arguments <- no_node(); actual_owner <- no_node()
    };
    for (unused in 0u64 .. used) {
        if (install >= used) return false;
        case nodes[install] of {
            Vacant -> { return false; };
            Occupied { val syntax <- node, } -> {
                case syntax.payload of {
                    InstallSymbolEffect { val bound <- name, val acquisition <- acquisition, } -> {
                        if (!published_syntax_id(nodes, revision, install, bound) ||
                            !published_syntax_id(nodes, revision, install, acquisition))
                            return false;
                        if (same_native_symbol(names, selected, name, bound.index)) {
                            initializer <- ungrouped(nodes, revision, install, acquisition.index);
                            if (initializer >= install ||
                                inspect_handle_construction(nodes, revision, install,
                                    initializer, acquired) != OwnHandleMake ||
                                work[initializer].active != install ||
                                !native_symbol_matches(nodes, names, selected, bound.index,
                                    acquired.marker, used, revision))
                                return false;
                            loan.marker <- acquired.marker;
                            loan.owner <- install;
                            loan.readonly <- false;
                            return true
                        }
                    };
                    _ -> { return false; }
                }
            }
        };
        install <- work[install].native_installation
    };
    return false
}

func check_effect_installation(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:NameWork in W,
                               at:UInt64, used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    return case nodes[at] of {
        (Vacant) -> { return false; };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (BindSymbolEffect { val name <- name, val input <- input, }) -> {
                    if (!published_syntax_id(nodes, revision, at, name) || !published_syntax_id(nodes, revision, at, input) ||
                        !reference_symbol(names, selected, name.index)) {
                        reject_declaration(report, at, mismatched_symbol_installation());
                        return false;
                    };
                    true
                };
                (InstallSymbolEffect { val name <- name, val acquisition <- acquisition, }) -> {
                    if (!published_syntax_id(nodes, revision, at, name) || !published_syntax_id(nodes, revision, at, acquisition) ||
                        reference_symbol(names, selected, name.index)) {
                        reject_declaration(report, at, mismatched_symbol_installation());
                        return false;
                    };
                    attach_handle_acquisition(nodes, names, selected, work, at, acquisition.index, name.index, used, revision, report)
                };
                (_) -> { true };
            }
        };
    };
}

func check_handle_expressions(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                              work:NameWork in W, used:UInt64, revision:UInt64, emit_object:bool,
                              report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner R} {
    ref local = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false; };
    val local_mode <- InvalidHandleBinding;
    for (at in 0u64 .. used) {
        local_mode <- inspect_handle_binding(nodes, revision, used, at, local);
        if (local_mode == InvalidHandleBinding) {
            reject_declaration(report, at, invalid_handle_initializer());
            return false;
        };
        if (local_mode == OwnHandleBinding &&
            !attach_handle_acquisition(nodes, names, selected, work, at, local.initializer, no_node(), used, revision, report))
            return false;
        if (!check_effect_installation(nodes, names, selected, work, at, used, revision, report)) return false;
    };
    ref acquired = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    val mode <- InvalidHandleConstruction;
    for (at in 0u64 .. used) {
        mode <- inspect_handle_construction(nodes, revision, used, at, acquired);
        if (mode == InvalidHandleConstruction) {
            reject_declaration(report, at, invalid_handle_initializer());
            return false;
        };
        if (mode == OwnHandleMake || mode == BorrowHandleMake) {
            check_handle_construction(nodes, names, selected, work, at, mode == OwnHandleMake, acquired, emit_object, used, revision, report);
        } else {
            local_mode <- inspect_handle_binding(nodes, revision, used, at, local);
            if (local_mode == OwnHandleBinding || local_mode == BorrowHandleBinding) {
                check_handle_local(nodes, names, selected, at, local_mode == OwnHandleBinding, local, used, revision, report);
            } else {};
        };
        if (report.diagnostic != 0u8) return false;
    };
    return true;
}

func native_here_parameter(nodes:const ExprNodes in N, definition:UInt64, used:UInt64, revision:UInt64) -> UInt64 where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref head = make UInt64 { no_node() };
    ref first = make UInt64 { no_node() };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (inspect_callable(nodes, revision, used, definition, callable) != CProvider ||
        !signature_formals(nodes, revision, used, callable.signature, head, first) ||
        inspect_formal(nodes, revision, used, first, formal) != HereFormalSyntax) return no_node();
    return first;
}

func declared_call_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                          work:const NameWork in W, selected:const SelectedExports in E, definition:UInt64,
                          used:UInt64, revision:UInt64, result_marker:UInt64 in M) -> UInt8
    where {const owner N, const owner B, const owner W, const owner E, owner M} {
    result_marker <- no_node();
    val binding <- names[definition].kind;
    if (binding == callable_binding()) {
        if (work[definition].active != no_node()) return 0u8;
    } else {
        if (binding != c_operation() && binding != c_entry()) return 0u8;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    if (form != ModuleCallable && form != ModuleCallablePromise && form != LexicalCallable &&
        form != CProvider && form != CEntry) return 0u8;
    ref result = make UInt64 { no_node() };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, revision, used, callable.signature, ValueResultClause, result)) return 0u8;
    if (result == no_node()) {
        if (!find_signature_clause(nodes, revision, used, callable.signature, BorrowedResultClause, result)) return 0u8;
        if (result == no_node()) {
            return if (callable.function_form && form != CProvider && form != CEntry) { 0u8 } else { builtin_void() }
        };
        ref target = make BindingSites {
            name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
        };
        if (inspect_signature(nodes, revision, used, result, clause) == BorrowedResultClause &&
            inspect_type_annotation(nodes, revision, used, clause.annotation, target) &&
            binding == callable_binding() && text_type(names[target.target_type].kind)) return names[target.target_type].kind;
        return 0u8;
    };
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause) return 0u8;
    val kind <- native_value_kind(names, selected, clause.annotation);
    if (!native_scalar(kind) && kind != builtin_void() && kind != enum_type()) return 0u8;
    result_marker <- clause.annotation;
    return kind;
}

func record_local_call_result(nodes:const ExprNodes in N, names:const NameBindings in B,
                              work:NameWork in W, selected:const SelectedExports in E, call:UInt64, definition:UInt64,
                              used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, owner W, const owner E} {
    ref marker = make UInt64 { no_node() };
    val kind <- declared_call_result(nodes, names, work, selected, definition, used, revision, marker);
    work[call].value_kind <- kind;
    if (kind == enum_type()) {
        work[call].value_module <- type_module(names, selected, marker, 0u64);
        (work[call].value_identity <- type_identity(names, selected, marker)):void;
    } else {};
    return;
}

func check_here_receiver(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         receiver:UInt64, expected:const ModuleInterfaceRow in P, actual_owner:UInt64, used:UInt64, revision:UInt64,
                         report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner P, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_sequence_entry(nodes, revision, used, receiver, entry) != HereReceiverSequence) {
        reject_declaration(report, receiver, invalid_native_callback());
        return false;
    };
    val shape <- inspect_binding(nodes, revision, used, entry.item, binding);
    if (shape == BareBinding) return true;
    if (shape != TypedBinding || !native_array_view(nodes, names, selected, binding.target_type, true, used, revision) ||
        type_module(names, selected, binding.target_type, 0u64) != expected.type_module ||
        type_identity(names, selected, binding.target_type) != expected.type_identity) {
        reject_declaration(report, receiver, mismatched_here_receiver_type());
        return false;
    };
    if (expected.target_readonly != 0u8 && !binding.readonly) {
        reject_declaration(report, receiver, invalid_native_access());
        return false;
    };
    if (binding.owner_name != no_node() && names[binding.owner_name].declaration != actual_owner) {
        reject_declaration(report, receiver, mismatched_actual_handle_owner());
        return false;
    };
    return true;
}

export data ArraySlotType {
    owner_site:UInt64,
    type_module:UInt64,
    type_identity:UInt64,
    element_module:UInt64,
    element_identity:UInt64,
}

export enum ArraySlotElement:UInt8 {
    ByteArrayElement, SumArrayElement, UInt64ArrayElement, ProductArrayElement, BoolArrayElement, EnumArrayElement,
}

export data SuppliedView =
    NoSuppliedView {} |
    PreparedGenericConstruction { owner_site:UInt64, member:UInt64, } |
    BoundGenericCall { header:UInt64, past:UInt64, arguments:UInt64, } |
    SuppliedArrayView { type_module:UInt64, type_identity:UInt64, owner_role:UInt64, body:UInt64, readonly:bool,
        } |
    HereFormalContract { first_parameter:UInt64, result_kind:UInt8, result_module:UInt64,
        result_identity:UInt64, } |
    PreparedHereInvocation { formal:UInt64, } |
    OrdinaryHereBody { formal:UInt64, call:UInt64, } |
    OrdinaryHereReceiver { kind:UInt8, } |
    OrdinaryHereCall { definition:UInt64, } |
    OrdinaryHereArgument { formal:UInt64, operand:UInt64, } |
    OrdinaryHereLabel { operand:UInt64, } |
    OrdinaryHereWrapper {} |
    OrdinaryHereInvocation { formal:UInt64, } |
    PreparedSourceHereRelay { formal:UInt64, } |
    PreparedSynchronousHere { call:UInt64, } |
    PreparedHandleFormal { marker:UInt64, owner_site:UInt64, readonly:bool, } |
    PreparedNativeOperation { definition:UInt64, actual_owner:UInt64, } |
    PreparedNativeLoanCall { module:UInt64, definition:UInt64, revision:UInt64,
        activation:UInt64, arity:UInt64, requires_body:bool, function_form:bool, } |
    PreparedNativeOperand { call_site:UInt64, revision:UInt64, position:UInt64, input:UInt64,
        kind:UInt8, owner_role:UInt64, owner_site:UInt64, type_module:UInt64, type_identity:UInt64,
        target_readonly:bool, owner_readonly:bool, } |
    ReadonlyByteRead { array_site:UInt64, index:UInt64, formal:UInt64, owner_site:UInt64,
        type_module:UInt64, type_identity:UInt64, } |
    ArraySlotFormal { owner_site:UInt64, type_module:UInt64, type_identity:UInt64, slot:bool,
        element:ArraySlotElement, element_module:UInt64, element_identity:UInt64, } |
    CheckedArraySlotBody { failures:ByteArrayFailures, } |
    CheckedImportedArraySlotCall { failures:ByteArrayFailures, } |
    IndexedArrayDestination { assignment:UInt64, target:UInt64, index:UInt64, } |
    IndexedArraySource { assignment:UInt64, target:UInt64, index:UInt64, } |
    PreparedArrayConstruction { requested:UInt64, placement:UInt64, length:UInt64, fill:UInt64,
        owner_site:UInt64, type_module:UInt64, type_identity:UInt64, element:ArraySlotElement,
        element_module:UInt64, element_identity:UInt64, } |
    EmptySumArrayFill { construction:UInt64, sum:UInt64, arm:UInt64, } |
    PreparedByteFunction { enum_result:bool, completion:ArrayReadCompletion, } |
    PreparedScalarLiteral { kind:UInt8, } |
    BoundNiladicScalarReturn { kind:UInt8, callee:UInt64, } |
    PreparedScalarPredicate {} |
    CheckedScalarPredicate {} |
    PreparedScalarFunction {} |
    CheckedScalarFunction { numeric_fault:bool, } |
    ImportedScalarPredicateCandidate {} |
    ReadonlyTextPredicate {} |
    ReadonlyTextPredicateBody { first_formal:UInt64, test:UInt64, tail:UInt64, returns_true:bool, } |
    ReadonlyIndexedByteReader {} |
    PreparedReadonlyQuery {} |
    PreparedArrayProcedure { allows_allocation:bool, } |
    CheckedArrayProcedure { completion:ArrayReadCompletion, numeric_fault:bool, allocates:bool, } |
    PreparedProductWriter {} |
    PreparedAggregateWriter {} |
    CheckedAggregateWriter { completion:ArrayReadCompletion, numeric_fault:bool, } |
    PreparedArrayInspector { inline_product:bool, } |
    CheckedArrayInspector { completion:ArrayReadCompletion, numeric_fault:bool, allocates:bool, } |
    PreparedParserWriter {} |
    PreparedWorkspaceLoans { publication_signature:bool, } |
    PreparedWorkspaceWriter {} |
    CheckedParserWriter { completion:ArrayReadCompletion, numeric_fault:bool, } |
    CheckedWorkspaceWriter { completion:ArrayReadCompletion, numeric_fault:bool, allocates:bool, } |
    PreparedProductWriterHelper {} |
    CheckedProductWriter { completion:ArrayReadCompletion, numeric_fault:bool, } |
    CheckedReadonlyReader { completion:ArrayReadCompletion, numeric_fault:bool, } |
    CheckedLiteralCall {} |
    CheckedScalarFunctionCall {} |
    CheckedScalarPredicateCall {} |
    CheckedReadonlyCall { aggregate_loan:bool, } |
    CheckedWriterCall {} |
    CheckedParserWriterCall { inline_input:bool, } |
    CheckedWorkspaceWriterCall { allocates:bool, requires_body:bool, } |
    CheckedSumWriterCall {} |
    CheckedArrayCall { allocates:bool, } |
    CheckedArrayReaderCall {} |
    ImportedTextPredicateCandidate {} |
    ImportedProductWriterCandidate {} |
    ImportedAggregateWriterCandidate {} |
    ImportedWorkspaceSumWriterCandidate { output:UInt64, } |
    ImportedProductWriter {} |
    PreparedArrayReaderLeaf { declared_array:UInt64, } |
    PreparedArrayReaderForward { declared_array:UInt64, callee:UInt64, } |
    CheckedArrayReaderForward { completion:ArrayReadCompletion, } |
    PreparedArrayLengthMethod { type_module:UInt64, type_identity:UInt64, } |
    ImportedArrayLengthCall { first:UInt64, past:UInt64, argument:UInt64, input:UInt64, } |
    ImportedSourceTextCall { family:UInt64, first:UInt64, past:UInt64, } |
    ImportedTextWriterCall { family:UInt64, past:UInt64, } |
    PreparedTextInstallation { operation:UInt64, name:UInt64, input:UInt64, previous:UInt64, } |
    PreparedFormattingMethod { marker:UInt64, operation:UInt64, receiver:UInt64, writer:UInt64, } |
    CompletedFormattingMethod {
        symbol_module:UInt64, symbol_identity:UInt64, receiver_module:UInt64, receiver_identity:UInt64,
        out_of_memory:bool, invalid_slice:bool, numeric_fault:bool,
    } |
    PreparedTextWriterMethod {} |
    CheckedTextWriterMethod { target_module:UInt64, target_identity:UInt64,
        piece_module:UInt64, piece_identity:UInt64, string_piece:bool, out_of_memory:bool, } |
    BoundReferenceSymbol { symbol_module:UInt64, symbol_identity:UInt64, target_module:UInt64,
        target_identity:UInt64, readonly:bool, nullable:bool, } |
    PreparedAcquisitionFailure { nominal:ExceptionType, };
export array SuppliedViews[UInt64]:SuppliedView;

func describe_byte_array_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    formal:UInt64, used:UInt64, revision:UInt64, proof:ArraySlotType in F) -> bool
    where {const owner N, const owner B, const owner E, const owner C, owner F} {
    ref shape = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    if (!typed_formal(nodes, revision, used, formal, shape, binding) ||
        shape.mode != ReferenceFormal || binding.owner_name >= used ||
        names[binding.owner_name].kind != owner_binding()) return false;
    val owner_site <- names[binding.owner_name].declaration;
    val marker <- binding.target_type;
    if (owner_site >= used || marker >= used) return false;
    if (!binding.readonly || owner_constraint_syntax(nodes, owner_site) != ReadonlyOwnerConstraint) return false;
    if (!describe_byte_array(nodes, names, selected, contracts, published, marker, used, revision, proof))
        return false;
    proof.owner_site <- owner_site;
    return true
}

func describe_local_u64_array_element(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, declaration:UInt64, used:UInt64, revision:UInt64,
    element:DeclaredType in T) -> bool
    where {const owner N, const owner B, const owner E, owner T} {
    ref schema = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    return used <= intrinsic (len)(names) &&
        inspect_declaration(nodes, revision, used, declaration, schema) == ArrayTypeDeclaration &&
        schema.index_type < used && schema.value_type < used &&
        names[schema.index_type].kind == builtin_u64() &&
        describe_type(nodes, names, selected, schema.value_type, 0u64, revision, used, element)
}

func published_u64_indexed_array(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> UInt64 where {const owner C} {
    val row <- find_interface(contracts, published, module, declaration);
    if (row >= published || contracts[row].interface_kind != array_type() ||
        contracts[row].entry_count != 0u64 || contracts[row].array_index_kind != builtin_u64()) return no_node();
    return row
}

export func describe_byte_array(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    marker:UInt64, used:UInt64, revision:UInt64, proof:ArraySlotType in F) -> bool
    where {const owner N, const owner B, const owner E, const owner C, owner F} {
    if (marker >= used) return false;
    val module <- type_module(names, selected, marker, 0u64);
    val declaration <- type_identity(names, selected, marker);
    if (names[marker].kind == array_type()) {
        ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        if (!describe_local_u64_array_element(nodes, names, selected, declaration, used, revision, element) ||
            element.kind != builtin_u8()) return false
    } else {
        if (names[marker].kind != ordinary_selection() || names[marker].declaration >= used ||
            selected[names[marker].declaration].kind != array_export() ||
            selected[names[marker].declaration].shape != readonly_numeric_array() || module == 0u64) return false;
        val row <- published_u64_indexed_array(contracts, published, module, declaration);
        if (row == no_node() || contracts[row].element_kind != builtin_u8()) return false
    };
    proof.type_module <- module;
    proof.type_identity <- declaration;
    proof.element_module <- 0u64;
    proof.element_identity <- no_node();
    return true
}

export func published_record_array_storage(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> AggregateStorage where {const owner C} {
    val header <- published_u64_indexed_array(contracts, published, module, declaration);
    if (header == no_node() || contracts[header].element_kind != record_type()) return UnprovedAggregate;
    return checked_aggregate_storage(contracts, published, contracts[header].type_module,
        contracts[header].type_identity, record_type())
}

export func published_record_array(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> bool where {const owner C} {
    return published_record_array_storage(contracts, published, module, declaration) == CoDBitsAggregate
}

func published_sum_array_header(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> UInt64 where {const owner C} {
    val header <- published_u64_indexed_array(contracts, published, module, declaration);
    if (header == no_node() || contracts[header].element_kind != sum_type() ||
        checked_aggregate_storage(contracts, published, contracts[header].type_module,
            contracts[header].type_identity, sum_type()) != CoDBitsAggregate) return no_node();
    return header
}

export func published_sum_array(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> bool where {const owner C} {
    return published_sum_array_header(contracts, published, module, declaration) != no_node()
}

func published_enum_element(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, identity:UInt64) -> bool where {const owner C} {
    val head <- find_interface(contracts, published, module, identity);
    return head < published && contracts[head].interface_kind == enum_type()
}

export func published_enum_array_header(contracts:const ModuleInterfaces in C, published:UInt64,
    module:UInt64, declaration:UInt64) -> UInt64 where {const owner C} {
    val head <- published_u64_indexed_array(contracts, published, module, declaration);
    if (head == no_node() || contracts[head].element_kind != enum_type() ||
        !published_enum_element(contracts, published, contracts[head].type_module, contracts[head].type_identity))
        return no_node();
    return head
}

func checked_bits_sum(contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, type:const DeclaredType in T)
    -> bool where {const owner C, const owner A, const owner T} {
    if (type.kind != sum_type()) return false;
    return if (type.defining_module == 0u64) {
        type.identity < intrinsic (len)(aggregate) && aggregate[type.identity] == CoDBitsAggregate
    } else {
        checked_aggregate_storage(contracts, published, type.defining_module, type.identity, sum_type()) == CoDBitsAggregate
    }
}

func checked_bits_record(contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, type:const DeclaredType in T)
    -> bool where {const owner C, const owner A, const owner T} {
    if (type.kind != record_type()) return false;
    val storage <- if (type.defining_module == 0u64) {
        if (type.identity >= intrinsic (len)(aggregate)) return false;
        (aggregate[type.identity])
    } else {
        checked_aggregate_storage(contracts, published, type.defining_module, type.identity, record_type())
    };
    return storage == CLayoutBitsRecord || storage == CoDBitsAggregate
}

func checked_sum_array_type(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    if (marker >= used) return false;
    if (names[marker].kind == array_type()) {
        ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        return describe_local_u64_array_element(nodes, names, selected,
            names[marker].declaration, used, revision, element) &&
            checked_bits_sum(contracts, published, aggregate, element)
    };
    val selection <- names[marker].declaration;
    return names[marker].kind == ordinary_selection() && selection < intrinsic (len)(selected) &&
        selected[selection].kind == array_export() &&
        published_sum_array(contracts, published, selected[selection].origin_module, selected[selection].identity)
}

func readonly_record_array_storage(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64) -> AggregateStorage
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    if (names[marker].kind == array_type()) {
        ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        if (!describe_local_u64_array_element(nodes, names, selected, names[marker].declaration,
            used, revision, element) || element.kind != record_type()) return UnprovedAggregate;
        return if (element.defining_module == 0u64) {
            if (element.identity >= used) return UnprovedAggregate;
            (aggregate[element.identity])
        } else {
            checked_aggregate_storage(contracts, published, element.defining_module,
                element.identity, record_type())
        }
    };
    val selection <- names[marker].declaration;
    if (names[marker].kind != ordinary_selection() || selection >= used ||
        selected[selection].kind != array_export()) return UnprovedAggregate;
    return published_record_array_storage(contracts, published, selected[selection].origin_module,
        selected[selection].identity)
}

func readonly_record_array(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    return readonly_record_array_storage(nodes, names, selected, contracts, published, aggregate,
        marker, used, revision) == CoDBitsAggregate
}

func describe_product_array_element(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64,
    element:DeclaredType in T) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A, owner T} {
    if (marker >= used) return false;
    if (names[marker].kind == array_type()) {
        if (!describe_local_u64_array_element(nodes, names, selected, names[marker].declaration,
            used, revision, element) || element.kind != record_type()) return false
    } else {
        val selection <- names[marker].declaration;
        if (names[marker].kind != ordinary_selection() || selection >= used ||
            selected[selection].kind != array_export()) return false;
        val row <- find_interface(contracts, published, selected[selection].origin_module, selected[selection].identity);
        if (row >= published || contracts[row].interface_kind != array_type() ||
            contracts[row].entry_count != 0u64 || contracts[row].array_index_kind != builtin_u64() ||
            contracts[row].element_kind != record_type()) return false;
        element.kind <- record_type();
        (element.defining_module <- contracts[row].type_module):void;
        (element.identity <- contracts[row].type_identity):void
    };
    val storage <- if (element.defining_module == 0u64) {
        if (element.identity >= used) return false;
        (aggregate[element.identity])
    } else {
        checked_aggregate_storage(contracts, published, element.defining_module, element.identity, record_type())
    };
    return storage == CLayoutBitsRecord || storage == CoDBitsAggregate
}

func describe_slot_array(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64,
    proof:ArraySlotType in F) -> UInt8
    where {const owner N, const owner B, const owner E, const owner C, const owner A, owner F} {
    if (marker >= used || used > intrinsic (len)(names)) return 0u8;
    if (names[marker].kind != array_type()) {
        val selection <- names[marker].declaration;
        if (names[marker].kind != ordinary_selection() || selection >= used ||
            selected[selection].kind != array_export()) return 0u8;
        val module <- selected[selection].origin_module;
        val identity <- selected[selection].identity;
        val head <- published_u64_indexed_array(contracts, published, module, identity);
        if (head == no_node()) return 0u8;
        val kind <- contracts[head].element_kind;
        if (kind == enum_type() || kind == sum_type()) {
            val element_module <- contracts[head].type_module;
            val element_identity <- contracts[head].type_identity;
            if (kind == enum_type()) {
                if (!published_enum_element(contracts, published, element_module, element_identity)) return 0u8
            } else {
                if (checked_aggregate_storage(contracts, published, element_module,
                    element_identity, sum_type()) != CoDBitsAggregate) return 0u8
            };
            proof.element_module <- element_module;
            (proof.element_identity <- element_identity):void
        } else {
            # The published element/index pair qualifies ordinary Boolean
            # storage independently of the native numeric loan shape.
            if (module == 0u64 || (kind != builtin_bool() &&
                ((kind != builtin_u8() && kind != builtin_u64()) ||
                 selected[selection].shape != readonly_numeric_array()))) return 0u8;
            proof.element_module <- 0u64;
            (proof.element_identity <- no_node()):void
        };
        proof.type_module <- module;
        proof.type_identity <- identity;
        return kind
    };
    val declaration <- names[marker].declaration;
    ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_local_u64_array_element(nodes, names, selected, declaration, used, revision, element))
        return 0u8;
    if (element.kind == enum_type()) {
        if (element.defining_module != 0u64 &&
            !published_enum_element(contracts, published, element.defining_module, element.identity)) return 0u8;
        proof.element_module <- element.defining_module;
        (proof.element_identity <- element.identity):void
    } else {
        if (element.kind != builtin_u8() && element.kind != builtin_u64() && element.kind != builtin_bool() &&
            (element.kind != sum_type() || element.defining_module != 0u64 || element.identity >= used ||
             element.identity >= intrinsic (len)(aggregate) ||
             aggregate[element.identity] != (CoDBitsAggregate:AggregateStorage))) return 0u8;
        proof.element_module <- 0u64;
        (proof.element_identity <- if (element.kind == sum_type()) { (element.identity) } else { no_node() }):void
    };
    proof.type_module <- 0u64;
    proof.type_identity <- declaration;
    return (element.kind)
}

func source_slot_parameter(nodes:const ExprNodes in N, work:const NameWork in W,
    definition:UInt64, member:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner W} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    if ((form != ModuleCallable && form != LexicalCallable) || callable.body == no_node()) return false;
    ref header = make UInt64 { no_node() };
    ref at = make UInt64 { no_node() };
    if (!signature_formals(nodes, revision, used, callable.signature, header, at)) return false;
    val next <- no_node();
    for (unused in 0u64 .. used) {
        if (at > member || at >= used) return false;
        if (at == member) return true;
        next <- work[at].next;
        if (next <= at) return false;
        (at <- next):void
    };
    return false
}

func slot_element(kind:UInt8) -> ArraySlotElement {
    if (kind == builtin_u8()) return (ByteArrayElement:ArraySlotElement);
    if (kind == builtin_u64()) return (UInt64ArrayElement:ArraySlotElement);
    if (kind == builtin_bool()) return (BoolArrayElement:ArraySlotElement);
    if (kind == record_type()) return (ProductArrayElement:ArraySlotElement);
    if (kind == enum_type()) return (EnumArrayElement:ArraySlotElement);
    return (SumArrayElement:ArraySlotElement)
}

func prepare_array_slot_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, selected:const SelectedExports in E, contracts:const ModuleInterfaces in C,
    published:UInt64, aggregate:const AggregateFacts in A, views:SuppliedViews in V, at:UInt64, used:UInt64,
    revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner W, const owner E, const owner C, const owner A, owner V, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    if (inspect_formal(nodes, revision, used, at, formal) != OrdinaryFormal) return true;
    val slot <- formal.mode == ReferenceSlotFormal;
    if (!slot && formal.mode != ReferenceFormal) return true;
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    ref proof = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    if (!formal_binding_is_fixed(nodes, revision, used, at) &&
        inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding &&
        binding.owner_name < at && names[binding.owner_name].kind == owner_binding() &&
        (!slot || !binding.readonly)) {
        val owner_site <- names[binding.owner_name].declaration;
        if (owner_site < used && owner_constraint_syntax(nodes, owner_site) != NotOwnerConstraint) {
            val kind <- describe_slot_array(nodes, names, selected, contracts, published, aggregate,
                binding.target_type, used, revision, proof);
            if (kind == 0u8) {
                ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
                if (describe_product_array_element(nodes, names, selected, contracts, published, aggregate,
                    binding.target_type, used, revision, element)) {
                    proof.type_module <- type_module(names, selected, binding.target_type, 0u64);
                    proof.type_identity <- type_identity(names, selected, binding.target_type);
                    (kind <- record_type()):void
                }
            };
            if (kind != 0u8 && (!slot || (kind != builtin_u64() && kind != builtin_bool() && kind != enum_type() &&
                source_slot_parameter(nodes, work, names[at].scope, at, used, revision)))) {
                views[at] <- make ArraySlotFormal {
                    owner_site <- owner_site; type_module <- proof.type_module; type_identity <- proof.type_identity;
                    slot <- slot; element <- slot_element(kind);
                    element_module <- proof.element_module; element_identity <- proof.element_identity
                };
                return true
            }
        }
    };
    if (slot) {
        reject_declaration(report, at, unsupported_reference_slot_formal());
        return false
    };
    return true
}

export enum SourceArrayFormals:UInt8 { NoSourceArrayFormal, EnumArrayLoanFormal, ArrayReferenceSlotFormal, }

export func prepared_array_signature(nodes:const ExprNodes in N, work:const NameWork in W,
    views:const SuppliedViews in V, signature:UInt64, used:UInt64, revision:UInt64) -> SourceArrayFormals
    where {const owner N, const owner W, const owner V} {
    ref head = make UInt64 { no_node() };
    ref at = make UInt64 { no_node() };
    if (!signature_formals(nodes, revision, used, signature, head, at)) return (NoSourceArrayFormal:SourceArrayFormals);
    val next <- no_node();
    val profile <- (NoSourceArrayFormal:SourceArrayFormals);
    for (unused in 0u64 .. used) {
        if (at == no_node()) return profile;
        if (at >= used || at >= intrinsic (len)(views)) return (NoSourceArrayFormal:SourceArrayFormals);
        case views[at] of {
            ArraySlotFormal { val passes_slot <- slot, val element <-, } -> {
                if (passes_slot) return (ArrayReferenceSlotFormal:SourceArrayFormals);
                if (element == (EnumArrayElement:ArraySlotElement)) {
                    (profile <- (EnumArrayLoanFormal:SourceArrayFormals)):void
                }
            };
            _ -> {}
        };
        next <- work[at].next;
        if (next <= at) return (NoSourceArrayFormal:SourceArrayFormals);
        (at <- next):void
    };
    return (NoSourceArrayFormal:SourceArrayFormals)
}

func callable_allocation_role(nodes:const ExprNodes in N, definition:UInt64, owner_site:UInt64,
    used:UInt64, revision:UInt64) -> bool where {const owner N} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    if (form != ModuleCallable && form != LexicalCallable) return false;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val at <- callable.signature;
    val role <- InvalidSignature;
    for (unused in 0u64 .. used) {
        role <- inspect_signature(nodes, revision, used, at, clause);
        if (at == owner_site) return role == OwnerSignatureClause && !clause.readonly;
        if (role == InvalidSignature || role == SignatureHead || clause.previous >= at) return false;
        (at <- clause.previous):void
    };
    return false
}

func prepare_empty_sum_array_fill(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, at:UInt64, fill:UInt64, sum:UInt64, used:UInt64,
    revision:UInt64) -> bool where {const owner N, const owner B, const owner W, owner V} {
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    ref fields = make UInt64 { no_node() };
    val shape <- inspect_construction(nodes, revision, at, fill, syntax);
    if ((shape != BracedConstruction && shape != StorageReservation) ||
        syntax.requested >= fill || syntax.queried_operand != no_node() || syntax.placement != no_node() ||
        names[syntax.requested].kind != constructor_type() ||
        (shape == BracedConstruction &&
         (!block_tail(nodes, revision, fill, syntax.contents, fields) || fields != no_node()))) return false;
    # In this source profile name registration has already rejected
    # initializer overloads, regardless of the argument count at this use.
    val arm <- names[syntax.requested].declaration;
    if (arm >= used) return false;
    ref position = make SumConstructorPosition { count <- 0u64; ordinal <- no_node() };
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node() };
    if (local_sum_constructor(nodes, names, work, sum, syntax.requested, used, revision, position) != arm || !inspect_sum_arm(nodes, revision, used, arm, sites) ||
        sites.fields != no_node()) return false;
    if (case views[fill] of { NoSuppliedView -> false; _ -> true }) return false;
    views[fill] <- make EmptySumArrayFill { construction <- at; sum <- sum; arm <- arm };
    return true
}

func prepare_source_array_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W,
    views:SuppliedViews in V, at:UInt64, used:UInt64, revision:UInt64,
    construction:const ConstructionSites in S, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W,
           owner V, const owner S, owner R} {
    val requested <- construction.requested;
    if (requested >= at || construction.queried_operand != no_node()) {
        reject_declaration(report, at, unsupported_ordinary_construction());
        return false
    };
    val placement <- construction.placement;
    val owner_site <- names[at].scope;
    if (placement != no_node()) {
        if (placement >= at || names[placement].kind != owner_binding()) {
            reject_declaration(report, at, unsupported_ordinary_construction());
            return false
        };
        owner_site <- names[placement].declaration;
        val definition <- enclosing_callable(nodes, names, names[at].scope);
        if (owner_site >= at || !callable_allocation_role(nodes, definition, owner_site, used, revision)) {
            reject_declaration(report, placement, unsupported_ordinary_construction());
            return false
        }
    };
    ref proof = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    val kind <- describe_slot_array(nodes, names, selected, contracts, published, aggregate,
        requested, used, revision, proof);
    val element_identity <- proof.element_identity;
    val element_module <- proof.element_module;
    if (kind == 0u8) {
        ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        if (describe_product_array_element(nodes, names, selected, contracts, published, aggregate,
            requested, used, revision, type)) {
            kind <- record_type();
            proof.type_module <- type_module(names, selected, requested, 0u64);
            proof.type_identity <- type_identity(names, selected, requested);
            element_module <- type.defining_module;
            (element_identity <- type.identity):void
        }
    };
    val imported_sum <- kind == sum_type() && element_module != 0u64;
    if (placement == no_node() && (owner_site >= used || kind == 0u8)) {
        reject_declaration(report, at, unsupported_ordinary_construction());
        return false
    };
    if (kind == 0u8) {
        reject_declaration(report, requested, unsupported_ordinary_construction());
        return false
    };
    ref count = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref fill = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (construction.contents >= at ||
        inspect_sequence_entry(nodes, revision, used, construction.contents, fill) != ArgumentSequence ||
        fill.previous >= construction.contents ||
        inspect_sequence_entry(nodes, revision, used, fill.previous, count) != ArgumentSequence ||
        count.previous != no_node() || count.item >= fill.previous || fill.item >= construction.contents) {
        reject_declaration(report, at, unsupported_ordinary_construction());
        return false
    };
    if (kind == sum_type() && !imported_sum && !prepare_empty_sum_array_fill(nodes, names, work, views, at,
        fill.item, proof.element_identity, used, revision)) {
        reject_declaration(report, fill.item, unsupported_ordinary_construction());
        return false
    };
    views[at] <- make PreparedArrayConstruction {
        requested <- requested; placement <- placement; length <- count.item; fill <- fill.item;
        owner_site <- owner_site; type_module <- proof.type_module; type_identity <- proof.type_identity;
        element <- slot_element(kind); element_module <- element_module; element_identity <- element_identity
    };
    return true
}

func has_array_slot_body(views:const SuppliedViews in V, at:UInt64) -> bool where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        CheckedArraySlotBody -> true;
        _ -> false
    }
}

export func finish_array_slot_body(views:SuppliedViews in V, at:UInt64,
    failures:const ByteArrayFailures in F) -> bool where {owner V, const owner F} {
    if (at >= intrinsic (len)(views)) return false;
    val empty <- case views[at] of {
        NoSuppliedView -> true;
        _ -> false
    };
    if (!empty) return false;
    views[at] <- make CheckedArraySlotBody { failures <- failures };
    return true
}

export func first_array_slot_work(views:const SuppliedViews in V, used:UInt64) -> UInt64
    where {const owner V} {
    if (used > intrinsic (len)(views)) return no_node();
    for (at in 0u64 .. used) {
        case views[at] of {
            PreparedArrayConstruction -> { return at };
            ArraySlotFormal { val aliases_slot <- slot, val element <-, } -> {
                if (aliases_slot || element == (EnumArrayElement:ArraySlotElement)) return at
            };
            _ -> {}
        }
    };
    return no_node()
}

export func prepared_array_construction(views:const SuppliedViews in V, at:UInt64) -> bool
    where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        PreparedArrayConstruction -> true;
        _ -> false
    }
}

func prepare_source_byte_read(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    views:SuppliedViews in V, at:UInt64, used:UInt64, revision:UInt64, index:const IndexSites in I) -> void
    where {const owner N, const owner B, const owner E, const owner C, owner V, const owner I} {
    val binding <- names[index.target].declaration;
    if (names[index.target].kind != formal_binding()) return;
    ref proof = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    if (describe_byte_array_formal(nodes, names, selected, contracts, published, binding, used, revision, proof)) {
        views[at] <- make ReadonlyByteRead {
            array_site <- index.target; index <- index.index; formal <- binding;
            owner_site <- proof.owner_site; type_module <- proof.type_module; type_identity <- proof.type_identity
        };
        return
    };
}

func independent_formal_type(nodes:const ExprNodes in N, formal:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    ref shape = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    if (formal_variadic_at(nodes, revision, used, formal) != no_node() ||
        !typed_formal(nodes, revision, used, formal, shape, binding) ||
        (shape.mode != ValueFormal && shape.mode != ExplicitValueFormal) ||
        binding.owner_name != no_node()) return no_node();
    return (binding.target_type)
}

export func independent_formal_kind(nodes:const ExprNodes in N, names:const NameBindings in B,
    formal:UInt64, used:UInt64, revision:UInt64) -> UInt8 where {const owner N, const owner B} {
    val type <- independent_formal_type(nodes, formal, used, revision);
    return if (type < used) { (names[type].kind) } else { 0u8 }
}

func independent_scalar_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    formal:UInt64, used:UInt64, revision:UInt64, kind:UInt8) -> bool where {const owner N, const owner B} {
    return independent_formal_kind(nodes, names, formal, used, revision) == kind
}

func single_completion_value(nodes:const ExprNodes in N, body:UInt64, kind:CompletionSyntax, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    val tail <- no_node();
    ref item = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val value <- no_node();
    if (!block_tail(nodes, revision, used, body, tail) ||
        inspect_sequence_entry(nodes, revision, used, tail, item) != BlockSequence ||
        item.previous != no_node() || completion_syntax(nodes, item.item) != kind ||
        !completion_operand(nodes, revision, used, item.item, value))
        return no_node();
    return value
}

func single_return_value(nodes:const ExprNodes in N, body:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    return single_completion_value(nodes, body, ReturnCompletion, used, revision)
}

func prepare_niladic_scalar_source(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, views:SuppliedViews in V, definition:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner L, owner V} {
    if (names[definition].kind != callable_binding() || names[definition].declaration != definition ||
        links[definition].next_method != no_node() || links[definition].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        !callable.function_form || is_scope_block(nodes, callable.body)) return;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, callable.signature, signature) != ValueResultClause) return;
    val kind <- names[signature.annotation].kind;
    if (kind != builtin_u8() && kind != builtin_u64()) return;
    val head <- signature.previous;
    if (inspect_signature(nodes, revision, used, head, signature) != SignatureHead ||
        signature.parameter_tail != no_node()) return;
    val operand <- single_return_value(nodes, callable.body, used, revision);
    if (operand >= used) return;
    val literal <- case nodes[operand] of {
        Occupied { val syntax <- node, } -> case syntax.payload of {
            IntegerLiteral { val width <- width, val value <- magnitude, } ->
                (kind == builtin_u8() && width == 8u64 && value <= 255u64) ||
                (kind == builtin_u64() && width == 64u64);
            _ -> false
        };
        _ -> false
    };
    if (literal) {
        views[definition] <- make PreparedScalarLiteral { kind <- kind };
        return
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, operand, call) != DirectInvocationReady ||
        call.arguments != no_node() || names[call.callee].kind != callable_binding()) return;
    val callee <- names[call.callee].declaration;
    if (callee >= used) return;
    views[definition] <- make BoundNiladicScalarReturn { kind <- kind; callee <- callee };
    return
}

func prepare_scalar_predicate(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:SuppliedViews in V,
    definition:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner E, const owner W, owner V} {
    if (names[definition].kind != callable_binding() || names[definition].declaration != definition ||
        work[definition].next_method != no_node() || work[definition].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        !callable.function_form || is_scope_block(nodes, callable.body)) return;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, callable.signature, signature) != ValueResultClause ||
        signature.annotation >= used || names[signature.annotation].kind != builtin_bool() ||
        inspect_signature(nodes, revision, used, signature.previous, signature) != SignatureHead) return;
    val parameter_type <- independent_formal_type(nodes, signature.parameter_tail, used, revision);
    if (parameter_type >= used) return;
    val parameter_kind <- native_value_kind(names, selected, parameter_type);
    if (parameter_kind != builtin_u8() && parameter_kind != enum_type()) return;
    val first <- no_node();
    if (!first_sequence_entry(nodes, revision, used, signature.parameter_tail, FormalSequence, first) ||
        first != signature.parameter_tail) return;
    val operand <- single_return_value(nodes, callable.body, used, revision);
    if (operand >= used) return;
    if (case nodes[operand] of {
        Occupied { val syntax <- node, } -> case syntax.payload of {
            ComparisonExpression -> true;
            Conjunction -> true;
            Disjunction -> true;
            Negation -> true;
            BooleanLiteral -> true;
            _ -> false
        };
        Vacant -> false
    }) {
        (views[definition] <- make PreparedScalarPredicate {}):void
    }
}

func scalar_return_body(nodes:const ExprNodes in N, body:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N} {
    val tail <- no_node();
    val result <- no_node();
    val empty <- no_node();
    ref item = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node() };
    if (!block_tail(nodes, revision, used, body, tail) ||
        inspect_sequence_entry(nodes, revision, used, tail, item) != BlockSequence ||
        completion_syntax(nodes, item.item) != ReturnCompletion ||
        !completion_operand(nodes, revision, used, item.item, result) || result >= item.item) return false;
    if (item.previous == no_node()) {
        val operand <- ungrouped(nodes, revision, used, result);
        if (operand >= used) return false;
        return case nodes[operand] of {
            Occupied { val syntax <- node, } -> case syntax.payload of {
                Conditional -> true;
                ArithmeticExpression -> true;
                _ -> false
            };
            Vacant -> false
        }
    };
    for (unused in 0u64 .. used) {
        if (inspect_sequence_entry(nodes, revision, used, item.previous, item) != BlockSequence ||
            !inspect_conditional(nodes, revision, used, item.item, branch) ||
            !block_tail(nodes, revision, used, branch.alternative, empty) || empty != no_node()) return false;
        if (completion_syntax(nodes, branch.consequent) == ReturnCompletion) {
            if (!completion_operand(nodes, revision, used, branch.consequent, result) ||
                result >= branch.consequent) return false
        } else {
            # Binding the outer guard need not inspect its whole body.
            # Ordinary body checking and completion cover the statements inside.
            if (is_scope_block(nodes, branch.consequent) ||
                !block_tail(nodes, revision, used, branch.consequent, result)) return false
        };
        if (item.previous == no_node()) return true
    };
    return false
}

# Demand the ordinary checker for eligible scalar return bodies.
# The shape supplies no exit proof.
func prepare_scalar_function(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:SuppliedViews in V,
    definition:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner E, const owner W, owner V} {
    if (names[definition].kind != callable_binding() || names[definition].declaration != definition ||
        work[definition].next_method != no_node() || work[definition].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        !callable.function_form || is_scope_block(nodes, callable.body)) return;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, callable.signature, signature) != ValueResultClause ||
        signature.annotation >= used) return;
    val result_kind <- names[signature.annotation].kind;
    if ((result_kind != builtin_u64() && result_kind != builtin_u8() && result_kind != builtin_bool()) ||
        inspect_signature(nodes, revision, used, signature.previous, signature) != SignatureHead ||
        !scalar_return_body(nodes, callable.body, used, revision)) return;
    val formal <- no_node();
    val type <- no_node();
    val kind <- 0u8;
    if (!first_sequence_entry(nodes, revision, used, signature.parameter_tail, FormalSequence, formal) ||
        formal == no_node()) return;
    for (unused in 0u64 .. used) {
        type <- independent_formal_type(nodes, formal, used, revision);
        if (type >= used) return;
        kind <- native_value_kind(names, selected, type);
        if (!source_call_scalar(kind) && kind != enum_type()) return;
        formal <- work[formal].next;
        if (formal == no_node()) {
            (views[definition] <- make PreparedScalarFunction {}):void;
            return
        };
    };
}

export func prepared_scalar_function(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedScalarFunction -> true; _ -> false })
}

export func checked_scalar_call(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of {
        CheckedScalarFunctionCall -> true;
        CheckedScalarPredicateCall -> true;
        _ -> false
    })
}

export func prepared_scalar_predicate(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedScalarPredicate -> true; _ -> false })
}

export func source_literal_kind(views:const SuppliedViews in V, definition:UInt64) -> UInt8
    where {const owner V} {
    if (definition >= intrinsic (len)(views)) return 0u8;
    return case views[definition] of {
        PreparedScalarLiteral { val kind <-, } -> (kind);
        _ -> 0u8
    }
}

# Publication reads the completed leaf table. A wrapper cannot act as
# a leaf receipt for another wrapper in this profile.
export func completed_niladic_source_kind(views:const SuppliedViews in V, definition:UInt64) -> UInt8
    where {const owner V} {
    if (definition >= intrinsic (len)(views)) return 0u8;
    return case views[definition] of {
        PreparedScalarLiteral { val kind <-, } -> { kind };
        BoundNiladicScalarReturn { val kind <-, val callee <-, } ->
            if (source_literal_kind(views, callee) == kind) { kind } else { 0u8 };
        _ -> 0u8
    }
}

func returns_formal_length(nodes:const ExprNodes in N, names:const NameBindings in B,
    body:UInt64, formal:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B} {
    val value <- single_return_value(nodes, body, used, revision);
    if (value >= used) return false;
    return case nodes[value] of {
        Occupied { val syntax <- node, } -> case syntax.payload of {
            ArrayLength { val target <-, } -> published_syntax_id(nodes, revision, value, target) &&
                names[target.index].kind == formal_binding() && names[target.index].declaration == formal;
            _ -> false
        };
        Vacant -> false
    }
}

# The complete supported signature has one readonly owner and an independent
# UInt64 result. Check the owner separately at the array formal.
func readonly_array_parameters(nodes:const ExprNodes in N, names:const NameBindings in B,
    signature:UInt64, used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner B} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, signature, clause) != OwnerSignatureClause ||
        !clause.readonly) return no_node();
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != ValueResultClause ||
        names[clause.annotation].kind != builtin_u64()) return no_node();
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return no_node();
    val first <- no_node();
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first))
        return no_node();
    return first
}

func reference_formal_marker(nodes:const ExprNodes in N, names:const NameBindings in B,
    parameter:UInt64, owner_site:UInt64, readonly:bool, used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner B} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    if (formal_variadic_at(nodes, revision, used, parameter) != no_node() ||
        !typed_formal(nodes, revision, used, parameter, formal, binding) ||
        formal.mode != ReferenceFormal || binding.readonly != readonly || binding.owner_name >= used ||
        names[binding.owner_name].kind != owner_binding() ||
        names[binding.owner_name].declaration != owner_site) return no_node();
    return binding.target_type
}

func readonly_formal_marker(nodes:const ExprNodes in N, names:const NameBindings in B,
    parameter:UInt64, owner_site:UInt64, used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner B} {
    return reference_formal_marker(nodes, names, parameter, owner_site, true, used, revision)
}

func prepare_array_length_method(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:SuppliedViews in V, at:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner E, const owner W, owner V} {
    if (names[at].kind != callable_binding()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form)
        return;
    val parameter <- readonly_array_parameters(nodes, names, callable.signature, used, revision);
    if (parameter >= used) return;
    if (work[parameter].next != no_node()) return;
    val marker <- readonly_formal_marker(nodes, names, parameter, callable.signature, used, revision);
    if (marker >= used || (names[marker].kind != array_type() &&
        imported_kind(names, selected, marker) != array_export())) return;
    if (!returns_formal_length(nodes, names, callable.body, parameter, used, revision)) return;
    views[at] <- make PreparedArrayLengthMethod {
        type_module <- type_module(names, selected, marker, 0u64);
        type_identity <- type_identity(names, selected, marker)
    };
    return
}

export func prepared_array_length_call(views:const SuppliedViews in V, at:UInt64)
    -> bool where {const owner V} {
    return at < intrinsic (len)(views) && (case views[at] of {
        ImportedArrayLengthCall -> true;
        _ -> false
    })
}

# The forwarding body contributes no operation except ordinary preparation
# of its exact formals and one literal, then return of the result.
func forwarded_read(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, value:UInt64, first:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N, const owner B, const owner W} {
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, value, call) != DirectInvocationReady ||
        names[call.callee].kind != callable_binding()) return no_node();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val argument <- no_node();
    if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, argument))
        return no_node();
    val formal <- first;
    for (position in 0u64 .. 4u64) {
        if (argument >= value || checked_ref_argument(nodes, argument) ||
            inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence)
            return no_node();
        if (position < 3u64) {
            if (names[entry.item].kind != formal_binding() || names[entry.item].declaration != formal ||
                !(case nodes[entry.item] of {
                    Occupied { val syntax <- node, } -> case syntax.payload of {
                        NameReference -> true; _ -> false
                    };
                    Vacant -> false
                })) return no_node();
            (formal <- work[formal].next):void
        } else {
            if (boolean_literal(nodes, used, entry.item) == OtherBooleanSyntax) return no_node()
        };
        argument <- work[argument].next
    };
    if (argument != no_node()) return no_node();
    return names[call.callee].declaration
}

func prepare_array_reader(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner E, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form)
        return;
    val first <- readonly_array_parameters(nodes, names, callable.signature, used, revision);
    if (first >= used || work[first].next >= used) return;
    val marker <- readonly_formal_marker(nodes, names, first, callable.signature, used, revision);
    if (marker >= used || names[marker].kind != array_type()) return;
    val declared_array <- names[marker].declaration;
    ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_local_u64_array_element(nodes, names, selected, declared_array, used, revision, element) ||
        element.kind != sum_type()) return;
    val second <- work[first].next;
    val third <- work[second].next;
    if (!independent_scalar_formal(nodes, names, second, used, revision, builtin_u64()) ||
        !independent_scalar_formal(nodes, names, third, used, revision, builtin_u64()))
        return;
    val fourth <- work[third].next;
    if (fourth == no_node()) {
        val callee <- forwarded_read(nodes, names, work,
            single_return_value(nodes, callable.body, used, revision), first, used, revision);
        if (callee < used) {
            (views[at] <- make PreparedArrayReaderForward { declared_array <- declared_array; callee <- callee }):void
        };
        return
    };
    if (independent_scalar_formal(nodes, names, fourth, used, revision, builtin_bool()) &&
        work[fourth].next == no_node()) {
        (views[at] <- make PreparedArrayReaderLeaf { declared_array <- declared_array }):void
    };
    return
}


export func forwarded_array_reader(views:const SuppliedViews in V, definition:UInt64) -> UInt64 where {const owner V} {
    return case views[definition] of {
        PreparedArrayReaderForward { val declared_array <-, val callee <-, } -> {
            if (callee >= intrinsic (len)(views)) return no_node();
            return case views[callee] of {
                PreparedArrayReaderLeaf { val target <- declared_array, } ->
                    if (target == declared_array) { callee } else { no_node() };
                _ -> no_node()
            }
        };
        _ -> no_node()
    }
}

export func finish_array_reader_forward(views:SuppliedViews in V, definition:UInt64, completion:ArrayReadCompletion)
    -> void where {owner V} {
    views[definition] <- make CheckedArrayReaderForward { completion <- completion };
    return
}

# Record the selected direct forwarding shape. Ordinary operand checking
# still owns nominal types, preparation and the actual owner substitutions.
export func forwarded_predicate_call(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, value:UInt64, first:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N, const owner B, const owner W} {
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, value, call) != DirectInvocationReady ||
        names[call.callee].kind != callable_binding()) return no_node();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val argument <- no_node();
    if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, argument))
        return no_node();
    val formal <- first;
    for (position in 0u64 .. 2u64) {
        if (formal >= used || argument >= value || checked_ref_argument(nodes, argument) ||
            inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
            name_syntax(nodes, used, entry.item) != OrdinaryName ||
            names[entry.item].kind != formal_binding() || names[entry.item].declaration != formal)
            return no_node();
        argument <- work[argument].next;
        (formal <- work[formal].next):void
    };
    if (argument != no_node() &&
        (argument >= value || checked_ref_argument(nodes, argument) || work[argument].next != no_node() ||
         inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
         text_literal_syntax(nodes, used, entry.item) == NotTextLiteral)) return no_node();
    return names[call.callee].declaration
}

# A predicate over the checked loan signature needs a completed normal result
# and escaping failures. Use the specialized Boolean equations for forwarding
# bodies with at most one leading conditional return of a literal.
func prepare_two_loan_predicate(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, definition:UInt64, body:UInt64,
    first:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, owner V} {
    val tail <- no_node();
    ref item = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val value <- no_node();
    if (is_scope_block(nodes, body) || !block_tail(nodes, revision, used, body, tail) ||
        inspect_sequence_entry(nodes, revision, used, tail, item) != BlockSequence ||
        completion_syntax(nodes, item.item) != ReturnCompletion ||
        !completion_operand(nodes, revision, used, item.item, value) || value >= item.item) return;
    (views[definition] <- make PreparedReadonlyQuery {}):void;
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs
    };
    if (forwarded_predicate_call(nodes, names, work, value, first, used, revision) >= used &&
        inspect_logical(nodes, revision, used, value, logical) != LogicalOr) return;
    val test <- no_node();
    val returns_true <- false;
    if (item.previous != no_node()) {
        ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node() };
        val empty <- no_node();
        val early <- no_node();
        if (inspect_sequence_entry(nodes, revision, used, item.previous, item) != BlockSequence ||
            item.previous != no_node() || !inspect_conditional(nodes, revision, used, item.item, branch) ||
            !block_tail(nodes, revision, used, branch.alternative, empty) || empty != no_node() ||
            completion_syntax(nodes, branch.consequent) != ReturnCompletion ||
            !completion_operand(nodes, revision, used, branch.consequent, early)) return;
        val literal <- boolean_literal(nodes, used, early);
        if (literal != LiteralTrue && literal != LiteralFalse) return;
        test <- branch.test;
        (returns_true <- literal == LiteralTrue):void
    };
    (views[definition] <- make ReadonlyTextPredicateBody {
        first_formal <- first; test <- test; tail <- value; returns_true <- returns_true
    }):void;
}

# Recognize the readonly byte-array profiles before checking their bodies.
# Only completed operand and exit evidence can publish a reader.
func prepare_readonly_reader(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val last_owner <- callable.signature;
    if (inspect_signature(nodes, revision, used, last_owner, clause) != OwnerSignatureClause || !clause.readonly) return;
    val previous_owner <- clause.previous;
    if (inspect_signature(nodes, revision, used, previous_owner, clause) != OwnerSignatureClause || !clause.readonly) return;
    val first_owner <- clause.previous;
    val third_owner <- inspect_signature(nodes, revision, used, first_owner, clause) == OwnerSignatureClause;
    if (third_owner && !clause.readonly) return;
    val result <- if (third_owner) { (clause.previous) } else { first_owner };
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause ||
        clause.annotation >= used) return;
    val output <- names[clause.annotation].kind;
    if (output != builtin_bool() &&
        ((output != builtin_u8() && output != builtin_u64()) || third_owner)) return;
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    val first <- no_node();
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first) || first >= used)
        return;
    val second <- work[first].next;
    if (second >= used) return;
    val third <- work[second].next;
    val array_owner <- if (third_owner) { first_owner } else { previous_owner };
    val marker <- readonly_formal_marker(nodes, names, first, array_owner, used, revision);
    ref bytes = make ArraySlotType { owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node() };
    if (!describe_byte_array(nodes, names, selected, contracts, published, marker, used, revision, bytes)) return;
    val record_owner <- if (third_owner) { previous_owner } else { last_owner };
    val record <- readonly_formal_marker(nodes, names, second, record_owner, used, revision);
    if (record >= used) return;
    val indexed <- !third_owner &&
        readonly_record_array(nodes, names, selected, contracts, published, aggregate, record, used, revision);
    if (output != builtin_bool() || indexed) {
        if (!indexed || !independent_scalar_formal(nodes, names, third, used, revision, builtin_u64())) return;
        val fourth <- work[third].next;
        if (!independent_scalar_formal(nodes, names, fourth, used, revision, builtin_u64())) return;
        if (output == builtin_bool()) {
            if (independent_scalar_tail(nodes, names, work, work[fourth].next, used, revision))
                { (views[at] <- make PreparedReadonlyQuery {}):void };
            return
        };
        if (work[fourth].next != no_node()) return;
        if (output == builtin_u8()) {
            (views[at] <- make ReadonlyIndexedByteReader {}):void
        } else {
            (views[at] <- make PreparedReadonlyQuery {}):void
        };
        return
    };
    if (third_owner) {
        if (third >= used || work[third].next != no_node()) return;
        val text <- readonly_formal_marker(nodes, names, third, last_owner, used, revision);
        if (text >= used || names[text].kind != builtin_string()) return
    } else {
        if (third != no_node()) return
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, record, 0u64, revision, used, type) || type.kind != record_type())
        return;
    val bits <- if (type.defining_module == 0u64) {
        type.identity < used && aggregate[type.identity] == CoDBitsAggregate
    } else {
        val header <- find_interface(contracts, published, type.defining_module, type.identity);
        header < published && contracts[header].interface_kind == record_type() &&
            contracts[header].aggregate_storage == CoDBitsAggregate
    };
    if (!bits) return;
    if (third_owner) {
        (views[at] <- make ReadonlyTextPredicate {}):void
    } else {
        prepare_two_loan_predicate(nodes, names, work, views, at, callable.body, first, used, revision)
    };
    return
}

export func array_reader_result_kind(views:const SuppliedViews in V, site:UInt64) -> UInt8
    where {const owner V} {
    if (site >= intrinsic (len)(views)) return 0u8;
    return case views[site] of {
        PreparedArrayReaderLeaf -> builtin_u64();
        ReadonlyTextPredicate -> builtin_bool();
        ReadonlyIndexedByteReader -> builtin_u8();
        _ -> 0u8
    }
}

export func readonly_indexed_byte_reader(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { ReadonlyIndexedByteReader -> true; _ -> false })
}

# A query receives independent scalar values and one readonly loan at
# each owner role, in owner-clause order. Check the two lists from their tails.
func readonly_query_inputs(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, signature:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val result <- no_node();
    if (!find_signature_clause(nodes, revision, used, signature, ValueResultClause, result) ||
        result == signature || inspect_signature(nodes, revision, used, result, clause) != ValueResultClause ||
        clause.annotation >= used) return false;
    val kind <- native_value_kind(names, selected, clause.annotation);
    if (kind != builtin_bool() && kind != builtin_u64() && kind != builtin_u8() && kind != enum_type())
        return false;
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return false;
    return check_readonly_input_parameters(nodes, names, selected, contracts, published, aggregate,
        clause.parameter_tail, signature, result, used, revision, false, false)
}

func check_readonly_input_parameters(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, tail:UInt64, last_owner:UInt64, result:UInt64, used:UInt64,
    revision:UInt64, only_arrays:bool, require_record:bool) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref bytes = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val formal <- tail;
    val role <- last_owner;
    val marker <- no_node();
    val annotation <- no_node();
    val parameter_kind <- 0u8;
    val array_kind <- 0u8;
    val storage <- UnprovedAggregate;
    val leading_array <- false;
    val found_record <- false;
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return role == result && (!require_record || found_record);
        if (inspect_sequence_entry(nodes, revision, used, formal, entry) != FormalSequence) return false;
        annotation <- independent_formal_type(nodes, formal, used, revision);
        parameter_kind <- if (annotation < used) { native_value_kind(names, selected, annotation) } else { 0u8 };
        leading_array <- only_arrays && entry.previous == no_node();
        if (leading_array || (!source_call_scalar(parameter_kind) && parameter_kind != enum_type())) {
            if (role == result ||
                inspect_signature(nodes, revision, used, role, clause) != OwnerSignatureClause || !clause.readonly)
                return false;
            marker <- readonly_formal_marker(nodes, names, formal, role, used, revision);
            if (marker >= used) return false;
            array_kind <- describe_slot_array(nodes, names, selected, contracts, published, aggregate,
                marker, used, revision, bytes);
            if (array_kind != builtin_u8() && array_kind != builtin_bool() &&
                array_kind != enum_type() && array_kind != sum_type() &&
                !checked_sum_array_type(nodes, names, selected, contracts, published, aggregate, marker, used, revision)) {
                storage <- readonly_record_array_storage(nodes, names, selected, contracts, published,
                    aggregate, marker, used, revision);
                if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) {
                    if (only_arrays || !describe_type(nodes, names, selected, marker, 0u64, revision, used, type))
                        return false;
                    if (!checked_bits_sum(contracts, published, aggregate, type)) {
                        if (!(require_record || (formal == tail && entry.previous == no_node() && clause.previous == result)) ||
                            !checked_bits_record(contracts, published, aggregate, type)) return false;
                        (found_record <- true):void
                    }
                }
            };
            (role <- clause.previous):void
        };
        (formal <- entry.previous):void
    };
    return false
}

# Readonly queries bind checked loans and scalar inputs. A single readonly
# record loan uses the same body and dependency completion.
func prepare_readonly_query(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node() ||
        !(case views[at] of { NoSuppliedView -> true; _ -> false })) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form) return;
    if (readonly_query_inputs(nodes, names, selected, contracts, published, aggregate, callable.signature, used, revision)) {
        (views[at] <- make PreparedReadonlyQuery {}):void;
        return
    };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val last_owner <- callable.signature;
    if (inspect_signature(nodes, revision, used, last_owner, clause) != OwnerSignatureClause || !clause.readonly) return;
    val preceding <- clause.previous;
    if (inspect_signature(nodes, revision, used, preceding, clause) != OwnerSignatureClause || !clause.readonly) return;
    val result_site <- clause.previous;
    if (inspect_signature(nodes, revision, used, result_site, clause) != ValueResultClause || clause.annotation >= used) return;
    val result <- names[clause.annotation].kind;
    if (result != builtin_bool() && result != builtin_u64()) return;
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first) ||
        first >= used) return;
    val marker <- readonly_formal_marker(nodes, names, first, preceding, used, revision);
    if (marker >= used) return;
    val input <- work[first].next;
    if (variadic_method_formal(nodes, revision, used, at) != no_node() ||
        !checked_sum_array_type(nodes, names, selected, contracts, published, aggregate, marker, used, revision)) return;
    # A syntax-site query has one extent; a range predicate has two.
    val extents <- if (result == builtin_u64()) { 1u64 } else { 2u64 };
    for (position in 0u64 .. extents) {
        if (!independent_scalar_formal(nodes, names, input, used, revision, builtin_u64())) return;
        (input <- work[input].next):void
    };
    val record <- readonly_formal_marker(nodes, names, input, last_owner, used, revision);
    if (record >= used || work[input].next != no_node()) return;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, record, 0u64, revision, used, type) || type.kind != record_type()) return;
    val storage <- if (type.defining_module == 0u64) {
        if (type.identity >= used || type.identity >= intrinsic (len)(aggregate)) return;
        (aggregate[type.identity])
    } else {
        checked_aggregate_storage(contracts, published, type.defining_module, type.identity, record_type())
    };
    if (storage == CLayoutBitsRecord || storage == CoDBitsAggregate) {
        (views[at] <- make PreparedReadonlyQuery {}):void
    };
    return
}

export func prepared_readonly_query(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) &&
        (case views[site] of {
            PreparedReadonlyQuery -> true;
            PreparedByteFunction { val enum_result <-, } -> !enum_result;
            _ -> false
        })
}

export func prepared_array_procedure(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) &&
        (case views[site] of { PreparedArrayProcedure -> true; _ -> false })
}

export func checked_source_array_call(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of {
        CheckedReadonlyCall -> true;
        CheckedWriterCall -> true;
        CheckedParserWriterCall -> true;
        CheckedWorkspaceWriterCall -> true;
        CheckedSumWriterCall -> true;
        CheckedArrayCall -> true;
        CheckedArrayReaderCall -> true;
        ImportedProductWriter -> true;
        _ -> false
    })
}

export func source_call_allocates(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of {
        CheckedArrayCall { val allocates <-, } -> allocates;
        CheckedWorkspaceWriterCall { val allocates <-, } -> allocates;
        _ -> false
    })
}

export func checked_literal_call(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { CheckedLiteralCall -> true; _ -> false })
}

export func readonly_reader_needs_body(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    if (site >= intrinsic (len)(views)) return false;
    return case views[site] of {
        ReadonlyTextPredicate -> true;
        ReadonlyTextPredicateBody -> true;
        ReadonlyIndexedByteReader -> true;
        _ -> false
    }
}

# An ordinary scanner-shaped function borrows already initialized storage.
# The signature alone introduces body demand and grants no call proof.
func prepare_product_writer(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val product_owner <- callable.signature;
    if (inspect_signature(nodes, revision, used, product_owner, clause) != OwnerSignatureClause || clause.readonly)
        return;
    val byte_owner <- clause.previous;
    if (inspect_signature(nodes, revision, used, byte_owner, clause) != OwnerSignatureClause || !clause.readonly)
        return;
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != ValueResultClause ||
        clause.annotation >= used || names[clause.annotation].kind != builtin_void() ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first) || first >= used)
        return;
    val offset <- work[first].next;
    val lines <- readonly_formal_marker(nodes, names, offset, byte_owner, used, revision);
    val reads_records <- lines < used;
    if (reads_records) {
        val storage <- readonly_record_array_storage(nodes, names, selected, contracts, published, aggregate,
            lines, used, revision);
        if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) return;
        (offset <- work[offset].next):void
    };
    if (!independent_scalar_formal(nodes, names, offset, used, revision, builtin_u64())) return;
    val next <- work[offset].next;
    if (next >= used) return;
    val helper <- work[next].next != no_node();
    val target <- if (helper) { (work[next].next) } else { next };
    if (target >= used || work[target].next != no_node() ||
        (helper && (reads_records || !independent_scalar_formal(nodes, names, next, used, revision, builtin_u64())))) return;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    if (!typed_formal(nodes, revision, used, target, formal, binding) ||
        formal.mode != ReferenceFormal || binding.readonly ||
        binding.owner_name >= used || names[binding.owner_name].declaration != product_owner) return;
    ref product = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, product) ||
        product.kind != record_type()) return;
    val target_storage <- if (product.defining_module == 0u64) {
        if (product.identity >= used) return;
        (aggregate[product.identity])
    } else {
        checked_aggregate_storage(contracts, published, product.defining_module, product.identity, record_type())
    };
    if (target_storage != CoDBitsAggregate && (!reads_records || target_storage != CLayoutBitsRecord)) return;
    val marker <- readonly_formal_marker(nodes, names, first, byte_owner, used, revision);
    ref bytes = make ArraySlotType { owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node() };
    if (describe_byte_array(nodes, names, selected, contracts, published, marker, used, revision, bytes)) {
        if (helper) { (views[at] <- make PreparedProductWriterHelper {}):void }
        else { (views[at] <- make PreparedProductWriter {}):void }
    }
}

# The array and record are initialized writable loans. The third role
# lends only a readonly finite-bits sum during the call.
func aggregate_writer_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, formal:UInt64, owner_site:UInt64, kind:UInt8, readonly:bool,
    used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    val marker <- reference_formal_marker(nodes, names, formal, owner_site, readonly, used, revision);
    if (marker >= used) return false;
    if (kind == array_type())
        return names[marker].kind == array_type() || imported_kind(names, selected, marker) == array_export();
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, marker, 0u64, revision, used, type) || type.kind != kind)
        return false;
    # The writer body already has the ordinary local scalar-product path.
    if (kind == record_type())
        return type.defining_module == 0u64 && type.identity < used && aggregate[type.identity] == CLayoutBitsRecord;
    return checked_bits_sum(contracts, published, aggregate, type)
}

func readonly_array_writer_input(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, formal:UInt64, owner_site:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    val marker <- readonly_formal_marker(nodes, names, formal, owner_site, used, revision);
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (marker >= used ||
        !describe_type(nodes, names, selected, marker, 0u64, revision, used, type)) return false;
    return checked_bits_sum(contracts, published, aggregate, type) ||
        checked_bits_record(contracts, published, aggregate, type)
}

# A fixed product writer borrows one initialized writable product. A
# result-bearing writer starts with that loan and takes scalar operands.
func prepare_published_product_writer(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    definition:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[definition].kind != callable_binding() || names[definition].declaration != definition ||
        work[definition].next_method != no_node() || work[definition].active != no_node() ||
        !(case views[definition] of { NoSuppliedView -> true; _ -> false })) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable || !callable.function_form) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val role <- callable.signature;
    if (inspect_signature(nodes, revision, used, role, clause) != OwnerSignatureClause || clause.readonly ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != ValueResultClause ||
        clause.annotation >= used) return;
    val result <- names[clause.annotation].kind;
    if ((result != builtin_void() && result != builtin_u64()) ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first) || first >= used) return;
    val marker <- reference_formal_marker(nodes, names, first, role, false, used, revision);
    if (marker < used) {
        if (work[first].next == no_node() || !independent_scalar_tail(nodes, names, work, work[first].next, used, revision)) return
    } else {
        if (result != builtin_void()) return;
        val output <- work[first].next;
        if (output >= used || work[output].next != no_node() ||
            !independent_scalar_formal(nodes, names, first, used, revision, builtin_u64())) return;
        (marker <- reference_formal_marker(nodes, names, output, role, false, used, revision)):void
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (marker >= used || !describe_type(nodes, names, selected, marker, 0u64, revision, used, type) ||
        type.kind != record_type()) return;
    val storage <- if (type.defining_module == 0u64) {
        if (type.identity >= used) return;
        (aggregate[type.identity])
    } else {
        checked_aggregate_storage(contracts, published, type.defining_module, type.identity, record_type())
    };
    if (storage == CoDBitsAggregate || storage == CLayoutBitsRecord) {
        (views[definition] <- make PreparedProductWriter {}):void
    }
}

func independent_scalar_tail(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, first:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner W} {
    val parameter <- first;
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return true;
        if (!source_call_scalar(independent_formal_kind(nodes, names, parameter, used, revision))) return false;
        (parameter <- work[parameter].next):void
    };
    return false
}

func prepare_aggregate_writer(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form ||
        variadic_method_formal(nodes, revision, used, at) != no_node()) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val array_owner <- callable.signature;
    val payload_owner <- no_node();
    if (inspect_signature(nodes, revision, used, array_owner, clause) != OwnerSignatureClause) return;
    if (clause.readonly) {
        payload_owner <- array_owner;
        array_owner <- clause.previous;
        if (inspect_signature(nodes, revision, used, array_owner, clause) != OwnerSignatureClause || clause.readonly) return
    };
    val result <- clause.previous;
    val record_owner <- no_node();
    if (inspect_signature(nodes, revision, used, result, clause) == OwnerSignatureClause) {
        if (clause.readonly) return;
        record_owner <- array_owner;
        array_owner <- result;
        (result <- clause.previous):void
    } else {
        if (payload_owner == no_node()) return
    };
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause ||
        clause.annotation >= used || names[clause.annotation].kind != builtin_void() ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first)) return;
    val array <- reference_formal_marker(nodes, names, first, array_owner, false, used, revision);
    if (array >= used) return;
    val second <- work[first].next;
    if (record_owner == no_node()) {
        ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        if (!describe_product_array_element(nodes, names, selected, contracts, published, aggregate,
            array, used, revision, element) ||
            !independent_scalar_formal(nodes, names, second, used, revision, builtin_u64())) return;
        val parameter <- work[second].next;
        for (unused in 0u64 .. used) {
            if (parameter >= used) return;
            if (work[parameter].next == no_node()) {
                if (readonly_array_writer_input(nodes, names, selected, contracts, published, aggregate,
                    parameter, payload_owner, used, revision)) {
                    (views[at] <- make PreparedAggregateWriter {}):void
                };
                return
            };
            if (!source_call_scalar(independent_formal_kind(nodes, names, parameter, used, revision))) return;
            (parameter <- work[parameter].next):void
        };
        return
    };
    if (!aggregate_writer_loan(nodes, names, selected, contracts, published, aggregate, second, record_owner,
        record_type(), false, used, revision)) return;
    val third <- work[second].next;
    if (payload_owner == no_node()) {
        if (checked_sum_array_type(nodes, names, selected, contracts, published, aggregate, array, used, revision) &&
            independent_scalar_tail(nodes, names, work, third, used, revision)) {
            (views[at] <- make PreparedAggregateWriter {}):void
        };
        return
    };
    if (names[array].kind != array_type() && imported_kind(names, selected, array) != array_export()) return;
    if (!independent_scalar_formal(nodes, names, third, used, revision, builtin_u64())) return;
    val fourth <- work[third].next;
    if (!independent_scalar_formal(nodes, names, fourth, used, revision, builtin_u64())) return;
    val fifth <- work[fourth].next;
    if (aggregate_writer_loan(nodes, names, selected, contracts, published, aggregate, fifth, payload_owner,
        sum_type(), true, used, revision) && work[fifth].next == no_node()) {
        (views[at] <- make PreparedAggregateWriter {}):void
    }
}

# Independent scalar formals do not participate in the owner mapping.
func preceding_loan_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, tail:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N, const owner B, const owner E} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val formal <- tail;
    val annotation <- no_node();
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (inspect_sequence_entry(nodes, revision, used, formal, entry) != FormalSequence) return no_node();
        annotation <- independent_formal_type(nodes, formal, used, revision);
        kind <- if (annotation < used) { native_value_kind(names, selected, annotation) } else { 0u8 };
        if (!source_call_scalar(kind) && kind != enum_type()) return formal;
        (formal <- entry.previous):void
    };
    return no_node()
}

func owner_result_site(nodes:const ExprNodes in N, tail:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val site <- tail;
    for (unused in 0u64 .. used) {
        if (inspect_signature(nodes, revision, used, site, clause) != OwnerSignatureClause) return site;
        (site <- clause.previous):void
    };
    return no_node()
}

# Token parsers take an optional readonly byte array, then a readonly
# token array, the two output loans, the extent and any other scalar inputs.
func token_parser_inputs(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, tail:UInt64, input_owner:UInt64,
    result:UInt64, output:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W} {
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, FormalSequence, first) || first >= used)
        return false;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, input_owner, clause) != OwnerSignatureClause || !clause.readonly)
        return false;
    val preceding <- clause.previous;
    val input <- first;
    if (preceding != result) {
        if (inspect_signature(nodes, revision, used, preceding, clause) != OwnerSignatureClause ||
            !clause.readonly || clause.previous != result) return false;
        val marker <- readonly_formal_marker(nodes, names, first, preceding, used, revision);
        ref bytes = make ArraySlotType {
            owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
        };
        if (!describe_byte_array(nodes, names, selected, contracts, published, marker, used, revision, bytes)) return false;
        (input <- work[first].next):void
    };
    if (input >= used || work[input].next != output) return false;
    val records <- readonly_formal_marker(nodes, names, input, input_owner, used, revision);
    return records < used &&
        readonly_record_array(nodes, names, selected, contracts, published, aggregate, records, used, revision)
}

func prepare_parser_writer(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form ||
        variadic_method_formal(nodes, revision, used, at) != no_node()) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val record_owner <- callable.signature;
    if (inspect_signature(nodes, revision, used, record_owner, clause) != OwnerSignatureClause || clause.readonly) return;
    val output_owner <- clause.previous;
    if (inspect_signature(nodes, revision, used, output_owner, clause) != OwnerSignatureClause || clause.readonly) return;
    val input_owner <- clause.previous;
    if (inspect_signature(nodes, revision, used, input_owner, clause) != OwnerSignatureClause || !clause.readonly) return;
    val result <- owner_result_site(nodes, input_owner, used, revision);
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause || clause.annotation >= used) return;
    val result_kind <- names[clause.annotation].kind;
    if ((result_kind != builtin_bool() && result_kind != builtin_void()) ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;

    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val tail <- clause.parameter_tail;
    val record <- preceding_loan_formal(nodes, names, selected, tail, used, revision);
    if (inspect_sequence_entry(nodes, revision, used, record, entry) != FormalSequence) return;
    val record_marker <- reference_formal_marker(nodes, names, record, record_owner, false, used, revision);
    ref record_type_info = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (record_marker >= used || !describe_type(nodes, names, selected, record_marker, 0u64, revision, used,
        record_type_info) || record_type_info.kind != record_type()) return;
    if (record_type_info.defining_module == 0u64) {
        if (record_type_info.identity >= used || aggregate[record_type_info.identity] != CLayoutBitsRecord) return
    } else {
        if (checked_aggregate_storage(contracts, published, record_type_info.defining_module,
            record_type_info.identity, record_type()) != CLayoutBitsRecord) return
    };

    val output <- preceding_loan_formal(nodes, names, selected, entry.previous, used, revision);
    if (inspect_sequence_entry(nodes, revision, used, output, entry) != FormalSequence ||
        !aggregate_writer_loan(nodes, names, selected, contracts, published, aggregate, output, output_owner,
            array_type(), false, used, revision)) return;
    val next <- work[output].next;
    val extents <- false;
    if (next == record) {
        (extents <- independent_scalar_formal(nodes, names, work[record].next, used, revision, builtin_u64())):void
    } else {
        if (next < record && work[record].next == no_node() &&
            independent_scalar_formal(nodes, names, next, used, revision, builtin_u64())) {
            val past <- work[next].next;
            (extents <- past == record || (past < record && work[past].next == record &&
                independent_scalar_formal(nodes, names, past, used, revision, builtin_u64()))):void
        }
    };
    if ((extents && token_parser_inputs(nodes, names, selected, contracts, published, aggregate, work,
             tail, input_owner, result, output, used, revision)) ||
        check_readonly_input_parameters(nodes, names, selected, contracts, published, aggregate,
            entry.previous, input_owner, result, used, revision, false, true)) {
        (views[at] <- make PreparedParserWriter {}):void
    }
}

func workspace_array_element(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, marker:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    ref array = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    val element <- describe_slot_array(nodes, names, selected, contracts, published, aggregate,
        marker, used, revision, array);
    if (element != 0u8) return element;
    if (checked_sum_array_type(nodes, names, selected, contracts, published, aggregate,
        marker, used, revision)) return sum_type();
    val storage <- readonly_record_array_storage(nodes, names, selected, contracts, published,
        aggregate, marker, used, revision);
    return if (storage == CLayoutBitsRecord || storage == CoDBitsAggregate) { record_type() } else { 0u8 }
}

# Mutating several compiler workspaces requires their complete initialized
# types. Formal order and owner-clause order can differ.
func prepare_workspace_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node() ||
        !(case views[at] of { NoSuppliedView -> true; _ -> false })) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form) return;
    val result <- owner_result_site(nodes, callable.signature, used, revision);
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val result_form <- inspect_signature(nodes, revision, used, result, clause);
    val result_kind <- 0u8;
    if (result_form == ValueResultClause) {
        if (clause.annotation >= used) return;
        result_kind <- names[clause.annotation].kind;
        if ((result_kind != builtin_bool() && result_kind != builtin_void() &&
             result_kind != builtin_u64() && result_kind != builtin_u8()) ||
            inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    } else {
        # A statement call can prepare local workspace loans using the head.
        # An omitted result remains unknown here and qualifies no publication.
        if (result_form != SignatureHead) return;
    };
    val published_result <- result_kind == builtin_bool() || result_kind == builtin_void();
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first)) return;
    ref shape = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val formal <- first;
    val marker <- no_node();
    val kind <- 0u8;
    val role <- no_node();
    val preceding <- no_node();
    val writable_arrays <- 0u64;
    val reads_record <- false;
    val readonly_arrays <- 0u64;
    val writable_records <- 0u64;
    val product_owner <- no_node();
    val shared_product_owner <- true;
    val writable_enum_array <- false;
    val writable_flag_array <- false;
    val writable_record_array <- false;
    val writable_sum_array <- false;
    val readonly_bytes <- false;
    val value_parameters <- false;
    val scalar_loans <- 0u64;
    val publication_signature <- false;
    val indexed_product_outputs <- false;
    val element <- 0u8;
    val previous_writable <- no_node();
    val adjacent_arrays <- false;
    for (unused in 0u64 .. used) {
        if (formal == no_node()) {
            # Name binding receives a parse record and paired writable tables.
            # Operand checking lends the parse record with readonly tables
            # and two writable result arrays separated by input loans. Each
            # readonly table was checked above, independently of their count.
            # Schema completion writes an enum table. Enum selection updates
            # binding and work tables among readonly schema inputs. Native
            # declaration checking also writes aggregate and supplied views.
            # Initialization phases fill ready command, graph and flag tables
            # through ordinary loans. Each table was checked independently.
            # An independent index may accompany two initialized products
            # under one owner. The result promises no particular field write.
            indexed_product_outputs <- result_kind == builtin_u64() && readonly_arrays != 0u64 &&
                !reads_record && writable_arrays == 0u64 && writable_records == 2u64 && shared_product_owner;
            # Member and schema validation give a Boolean with a report.
            # Member selection also writes product rows using source bytes.
            # Case preparation and expression checking also update an initialized first-site slot.
            # Completion checking writes both its site table and its report.
            # Caught-field preparation returns a diagnostic byte and writes
            # initialized sum rows, with a separate location on rejection.
            if (result_kind == builtin_u8()) {
                if (!reads_record && writable_records == 0u64 && readonly_arrays != 0u64 &&
                    writable_arrays == 1u64 && writable_sum_array && scalar_loans <= 1u64) {
                    (views[at] <- make PreparedWorkspaceLoans { publication_signature <- true }):void
                };
                return
            };
            publication_signature <- (scalar_loans == 1u64 && result_kind == builtin_bool() && !reads_record &&
                readonly_bytes && writable_arrays == 2u64 && writable_record_array && writable_records == 1u64 &&
                (readonly_arrays == 5u64 || (readonly_arrays == 8u64 && writable_sum_array))) ||
                (scalar_loans == 0u64 && (indexed_product_outputs || (published_result &&
                ((reads_record && readonly_arrays != 0u64 &&
                    ((writable_arrays == 0u64 && writable_records == 1u64) ||
                     (writable_arrays == 1u64 && writable_record_array && writable_records <= 1u64))) ||
                (!reads_record && result_kind == builtin_bool() && readonly_arrays > 1u64 && writable_records == 1u64 &&
                    (writable_arrays == 0u64 ||
                     (writable_arrays == 1u64 && writable_record_array && (readonly_bytes || readonly_arrays == 4u64)))) ||
                (!reads_record && result_kind == builtin_bool() && readonly_bytes && writable_records == 2u64 &&
                    ((readonly_arrays == 4u64 && writable_arrays == 5u64) ||
                     (readonly_arrays == 6u64 && writable_arrays == 4u64 && writable_record_array))) ||
                (!value_parameters && !reads_record && result_kind == builtin_bool() && readonly_arrays == 0u64 &&
                    writable_arrays == 1u64 && writable_record_array && writable_records == 2u64) ||
                (!reads_record && result_kind == builtin_void() && readonly_arrays == 1u64 && writable_arrays == 0u64 &&
                    writable_records == 1u64 && value_parameters) ||
                (reads_record && writable_arrays == 2u64 && writable_records != 0u64 &&
                (adjacent_arrays || (writable_record_array && readonly_bytes))) ||
                (!reads_record && writable_records == 1u64 &&
                    ((writable_arrays == 1u64 && writable_enum_array && readonly_arrays >= 4u64) ||
                     (writable_arrays == 2u64 && writable_record_array &&
                        ((readonly_arrays == 5u64 &&
                            (readonly_bytes || (result_kind == builtin_bool() && writable_sum_array))) ||
                         (readonly_arrays == 6u64 && readonly_bytes && result_kind == builtin_bool()))) ||
                     (writable_arrays == 4u64 && readonly_arrays >= 2u64))) ||
                (writable_flag_array && readonly_arrays != 0u64) ||
                (!value_parameters && !reads_record && readonly_arrays == 1u64 && readonly_bytes &&
                    writable_records == 1u64 && writable_record_array &&
                    (writable_arrays == 1u64 || (writable_arrays == 2u64 && writable_sum_array))) ||
                (writable_arrays == 1u64 && writable_record_array &&
                    readonly_arrays == 0u64 && writable_records == 0u64 && !reads_record &&
                    first < used && preceding < used && work[first].next == preceding &&
                    independent_scalar_formal(nodes, names, preceding, used, revision, builtin_u64()))))));
            if (publication_signature || (writable_arrays != 0u64 && (writable_records != 0u64 || writable_arrays >= 3u64))) {
                (views[at] <- make PreparedWorkspaceLoans { publication_signature <- publication_signature }):void
            };
            return
        };
        marker <- independent_formal_type(nodes, formal, used, revision);
        kind <- if (marker < used) { native_value_kind(names, selected, marker) } else { 0u8 };
        if (!source_call_scalar(kind) && kind != enum_type()) {
            if (formal_variadic_at(nodes, revision, used, formal) != no_node() ||
                !typed_formal(nodes, revision, used, formal, shape, binding) ||
                shape.mode != ReferenceFormal || binding.owner_name >= used ||
                names[binding.owner_name].kind != owner_binding() || binding.target_type >= used) return;
            role <- names[binding.owner_name].declaration;
            if (role <= result || role > callable.signature ||
                inspect_signature(nodes, revision, used, role, clause) != OwnerSignatureClause ||
                clause.readonly != binding.readonly) return;
            marker <- binding.target_type;
            if (names[marker].kind == array_type() || imported_kind(names, selected, marker) == array_export()) {
                element <- workspace_array_element(nodes, names, selected, contracts, published, aggregate,
                    marker, used, revision);
                if (element == 0u8) return;
                if (binding.readonly) {
                    readonly_bytes <- readonly_bytes || element == builtin_u8();
                    (readonly_arrays <- readonly_arrays + 1u64):void
                } else {
                    writable_record_array <- writable_record_array || element == record_type();
                    writable_sum_array <- writable_sum_array || element == sum_type();
                    writable_enum_array <- writable_enum_array || element == enum_type();
                    writable_flag_array <- writable_flag_array || element == builtin_bool();
                    adjacent_arrays <- previous_writable != no_node() && previous_writable == preceding;
                    previous_writable <- formal;
                    (writable_arrays <- writable_arrays + 1u64):void
                }
            } else {
                if (!binding.readonly && names[marker].kind == builtin_u64()) {
                    (scalar_loans <- scalar_loans + 1u64):void
                } else {
                    if (!describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, type)) return;
                    if (type.kind == sum_type()) {
                        if (result_kind == builtin_void() && !binding.readonly && work[formal].next == no_node() &&
                            readonly_arrays != 0u64 && writable_arrays == 0u64 && !reads_record &&
                            writable_records == 0u64 && scalar_loans == 0u64 &&
                            checked_bits_sum(contracts, published, aggregate, type)) {
                            (views[at] <- make PreparedWorkspaceLoans { publication_signature <- true }):void
                        };
                        return
                    };
                    if (!checked_bits_record(contracts, published, aggregate, type)) return;
                    if (binding.readonly) { (reads_record <- true):void } else {
                        if (writable_records == 0u64) { (product_owner <- role):void }
                        else { (shared_product_owner <- shared_product_owner && product_owner == role):void };
                        (writable_records <- writable_records + 1u64):void
                    }
                }
            };
        } else { (value_parameters <- true):void };
        preceding <- formal;
        (formal <- work[formal].next):void
    }
}

export func prepared_workspace_writer(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedWorkspaceWriter -> true; _ -> false })
}

# Find the writable sum position in a completed workspace writer's rows.
export func workspace_sum_output(contracts:const ModuleInterfaces in C, published:UInt64, header:UInt64)
    -> UInt64 where {const owner C} {
    if (header >= published || published > intrinsic (len)(contracts)) return no_node();
    val count <- contracts[header].entry_count;
    if (contracts[header].source_writer != WorkspaceWriter ||
        contracts[header].array_read_completion == NoArrayRead ||
        contracts[header].result_kind != builtin_void() ||
        count < 2u64 || count >= published - header) return no_node();
    val output <- header + count;
    val output_role <- contracts[output].owner_role;
    if (output_role >= contracts[header].owner_count ||
        !source_aggregate_formal(contracts, output, sum_type(), output_role, 0u8) ||
        checked_aggregate_storage(contracts, published, contracts[output].type_module,
            contracts[output].type_identity, sum_type()) != CoDBitsAggregate) return no_node();
    return output
}

export func prepared_workspace_loans(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of {
        PreparedWorkspaceLoans -> true;
        PreparedWorkspaceWriter -> true;
        _ -> false
    })
}

# Before the final output, an inspector can also receive one writable enum
# array. Its owner clause follows the readonly inputs' owner clauses.
func array_inspector_inputs(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, tail:UInt64, last_owner:UInt64, result:UInt64,
    used:UInt64, revision:UInt64, sum_output:bool) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, last_owner, clause) != OwnerSignatureClause) return false;
    if (clause.readonly)
        return !sum_output && check_readonly_input_parameters(nodes, names, selected, contracts, published, aggregate,
            tail, last_owner, result, used, revision, true, false);

    val input_owner <- clause.previous;
    if (input_owner == result) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref output = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    val formal <- tail;
    val annotation <- no_node();
    val kind <- 0u8;
    val marker <- no_node();
    for (unused in 0u64 .. used) {
        if (formal == no_node() ||
            inspect_sequence_entry(nodes, revision, used, formal, entry) != FormalSequence) return false;
        annotation <- independent_formal_type(nodes, formal, used, revision);
        kind <- if (annotation < used) { native_value_kind(names, selected, annotation) } else { 0u8 };
        if (!source_call_scalar(kind) && kind != enum_type()) {
            marker <- reference_formal_marker(nodes, names, formal, last_owner, false, used, revision);
            return marker < used && (if (sum_output) {
                checked_sum_array_type(nodes, names, selected, contracts, published, aggregate, marker, used, revision)
            } else {
                describe_slot_array(nodes, names, selected, contracts, published, aggregate,
                    marker, used, revision, output) == enum_type()
            }) &&
                check_readonly_input_parameters(nodes, names, selected, contracts, published, aggregate,
                    entry.previous, input_owner, result, used, revision, true, false)
        };
        (formal <- entry.previous):void
    };
    return false
}

func inspector_product_after_scalars(nodes:const ExprNodes in N, names:const NameBindings in B,
    tail:UInt64, product_owner:UInt64, scalar_owner:UInt64, used:UInt64, revision:UInt64,
    entry:SequenceEntry in Q) -> UInt64 where {const owner N, const owner B, owner Q} {
    val formal <- tail;
    val marker <- no_node();
    for (unused in 0u64 .. used) {
        if (inspect_sequence_entry(nodes, revision, used, formal, entry) != FormalSequence) return no_node();
        marker <- reference_formal_marker(nodes, names, formal, product_owner, false, used, revision);
        if (marker < used) return marker;
        marker <- reference_formal_marker(nodes, names, formal, scalar_owner, false, used, revision);
        if (marker >= used || !source_place_scalar(names[marker].kind)) return no_node();
        (formal <- entry.previous):void
    };
    return no_node()
}

# An inspector receives readonly arrays and initialized output places. A
# void inspector writes one finite-bits sum array before its scalar suffix.
# A scalar-result inspector can take a product followed by writable scalars.
func prepare_array_inspector(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, published:UInt64,
    aggregate:const AggregateFacts in A, work:const NameWork in W, views:SuppliedViews in V,
    at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner C, const owner A, const owner W, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || work[at].active != no_node()) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable || !callable.function_form ||
        variadic_method_formal(nodes, revision, used, at) != no_node()) return;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val output_owner <- callable.signature;
    if (inspect_signature(nodes, revision, used, output_owner, clause) != OwnerSignatureClause || clause.readonly) return;
    val last_input_owner <- clause.previous;
    ref result = make UInt64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, last_input_owner, ValueResultClause, result) ||
        inspect_signature(nodes, revision, used, result, clause) != ValueResultClause ||
        clause.annotation >= used) return;
    val kind <- native_value_kind(names, selected, clause.annotation);
    if (inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return;
    val tail <- clause.parameter_tail;
    if (kind == builtin_void()) {
        if (array_inspector_inputs(nodes, names, selected, contracts, published, aggregate,
            tail, output_owner, result, used, revision, true)) {
            (views[at] <- make PreparedArrayInspector { inline_product <- false }):void
        };
        return
    };
    if (kind != builtin_bool() && kind != builtin_u8() && kind != builtin_u64() && kind != enum_type()) return;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (inspect_sequence_entry(nodes, revision, used, tail, entry) != FormalSequence ||
        entry.previous == no_node() || last_input_owner == result) return;
    val output <- reference_formal_marker(nodes, names, tail, output_owner, false, used, revision);
    if (output >= used) return;
    val scalar_output <- source_place_scalar(names[output].kind);
    if (scalar_output && array_inspector_inputs(nodes, names, selected, contracts, published, aggregate,
        entry.previous, last_input_owner, result, used, revision, false)) {
        (views[at] <- make PreparedArrayInspector { inline_product <- false }):void;
        return
    };
    if (scalar_output) {
        if (inspect_signature(nodes, revision, used, last_input_owner, clause) != OwnerSignatureClause ||
            clause.readonly) return;
        val product_owner <- last_input_owner;
        last_input_owner <- clause.previous;
        (output <- inspector_product_after_scalars(nodes, names, entry.previous, product_owner,
            output_owner, used, revision, entry)):void
    };
    if (output >= used || !array_inspector_inputs(nodes, names, selected, contracts, published, aggregate,
        entry.previous, last_input_owner, result, used, revision, false)) return;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, output, 0u64, revision, used, type) ||
        type.kind != record_type()) return;
    val storage <- if (type.defining_module == 0u64) {
        if (type.identity >= used) return;
        (aggregate[type.identity])
    } else {
        checked_aggregate_storage(contracts, published, type.defining_module, type.identity, record_type())
    };
    if (storage == CLayoutBitsRecord || storage == CoDBitsAggregate) {
        (views[at] <- make PreparedArrayInspector {
            inline_product <- type.defining_module != 0u64 || storage == CoDBitsAggregate
        }):void
    }
}

export func prepared_array_inspector(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedArrayInspector -> true; _ -> false })
}

export func prepared_parser_writer(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedParserWriter -> true; _ -> false })
}

export func prepared_aggregate_writer(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedAggregateWriter -> true; _ -> false })
}

export func prepared_product_writer(views:const SuppliedViews in V, site:UInt64) -> bool where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of { PreparedProductWriter -> true; _ -> false })
}

export func prepared_writable_product_formal(views:const SuppliedViews in V, site:UInt64) -> bool
    where {const owner V} {
    return site < intrinsic (len)(views) && (case views[site] of {
        PreparedProductWriter -> true;
        PreparedProductWriterHelper -> true;
        PreparedWorkspaceWriter -> true;
        PreparedArrayInspector { val inline_product <-, } -> inline_product;
        _ -> false
    })
}

export func first_source_call_profile(views:const SuppliedViews in V, used:UInt64) -> UInt64
    where {const owner V} {
    for (site in 0u64 .. used) {
        if (readonly_reader_needs_body(views, site) || prepared_product_writer(views, site) ||
            prepared_scalar_predicate(views, site) || prepared_scalar_function(views, site) ||
            prepared_aggregate_writer(views, site) ||
            prepared_readonly_query(views, site) || prepared_array_procedure(views, site) ||
            prepared_parser_writer(views, site) || prepared_workspace_writer(views, site) ||
            prepared_array_inspector(views, site)) return site;
        if (case views[site] of {
            ImportedTextPredicateCandidate -> true;
            ImportedProductWriterCandidate -> true;
            ImportedAggregateWriterCandidate -> true;
            ImportedWorkspaceSumWriterCandidate -> true;
            ImportedScalarPredicateCandidate -> true;
            _ -> false
        }) return site
    };
    return no_node()
}

func prepare_byte_function(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, contracts:const ModuleInterfaces in C,
    published:UInt64, views:SuppliedViews in V, at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner W, const owner C, owner V} {
    if (names[at].kind != callable_binding() || names[at].declaration != at ||
        work[at].next_method != no_node() || !is_function(nodes, at)) return;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    ref failure = make UInt64 { no_node() };
    if (inspect_callable(nodes, revision, used, at, callable) != ModuleCallable ||
        !find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause, failure) ||
        failure != no_node() || count_owner_clauses(nodes, callable.signature, used, revision) != 1u64)
        return;
    ref result = make UInt64 { no_node() };
    val kind <- declared_call_result(nodes, names, work, selected, at, used, revision, result);
    if ((kind != enum_type() && kind != builtin_bool()) || result == no_node()) return;
    ref head = make UInt64 { no_node() };
    ref first = make UInt64 { no_node() };
    ref proof = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    if (!signature_formals(nodes, revision, used, callable.signature, head, first) ||
        !describe_byte_array_formal(nodes, names, selected, contracts, published, first, used, revision, proof))
        return;
    val second <- work[first].next;
    if (!independent_scalar_formal(nodes, names, second, used, revision, builtin_u64())) return;
    val third <- work[second].next;
    if (!independent_scalar_formal(nodes, names, third, used, revision, builtin_u64()) || work[third].next != no_node())
        return;
    views[at] <- make PreparedByteFunction { enum_result <- kind == enum_type(); completion <- NoArrayRead };
    return
}

export func prepared_byte_function(views:const SuppliedViews in V, at:UInt64, require_enum:bool)
    -> bool where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        PreparedByteFunction { val enum_result <-, } -> { !require_enum || enum_result };
        _ -> false
    }
}

export func first_byte_function(views:const SuppliedViews in V, used:UInt64)
    -> UInt64 where {const owner V} {
    for (at in 0u64 .. used) {
        if (prepared_byte_function(views, at, true)) return at
    };
    return no_node()
}

export func finish_byte_function(views:SuppliedViews in V, at:UInt64, completion:ArrayReadCompletion)
    -> void where {owner V} {
    if (prepared_byte_function(views, at, true)) {
        views[at] <- make PreparedByteFunction { enum_result <- true; completion <- completion };
        return
    }
}

func published_array_read_completion(views:const SuppliedViews in V, at:UInt64)
    -> ArrayReadCompletion where {const owner V} {
    if (at >= intrinsic (len)(views)) return NoArrayRead;
    return case views[at] of {
        PreparedByteFunction { val completion <-, } -> completion;
        CheckedArrayReaderForward { val completion <-, } -> completion;
        CheckedReadonlyReader { val completion <-, } -> completion;
        CheckedArrayProcedure { val completion <-, } -> completion;
        CheckedProductWriter { val completion <-, } -> completion;
        CheckedAggregateWriter { val completion <-, } -> completion;
        CheckedParserWriter { val completion <-, } -> completion;
        CheckedWorkspaceWriter { val completion <-, } -> completion;
        CheckedArrayInspector { val completion <-, } -> completion;
        _ -> NoArrayRead
    }
}

export func read_acquisition_failure(
    views:const SuppliedViews in V, at:UInt64, failure:ExceptionType in F) -> bool
    where {const owner V, owner F} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        (PreparedAcquisitionFailure { val type <- nominal, }) -> {
            failure.defining_module <- type.defining_module;
            failure.declaration <- type.declaration;
            failure.checked <- type.checked;
            true
        };
        _ -> false
    }
}

export func has_prepared_native_loans(views:const SuppliedViews in V, at:UInt64) -> bool
    where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        PreparedNativeLoanCall -> true;
        _ -> false
    }
}

export func native_loan_requires_body(views:const SuppliedViews in V, at:UInt64) -> bool
    where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        PreparedNativeLoanCall { val requires_body <-, } -> requires_body;
        _ -> false
    }
}

# Native operand preparation has already checked the selected identity and
# its ordered arguments. A C procedure plan cannot supply function completion.
export func prepared_native_function(views:const SuppliedViews in V, at:UInt64,
    revision:UInt64) -> bool where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        PreparedNativeLoanCall { val origin <- revision, val function_form <-, } ->
            function_form && origin == revision;
        _ -> false
    }
}

func remember_acquisition_failure(
    views:SuppliedViews in V, at:UInt64, failure:const ExceptionType in F) -> void
    where {owner V, const owner F} {
    views[at] <- make PreparedAcquisitionFailure { nominal <- failure };
    return
}

func read_local_constructor_failure(
    nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    definition:UInt64, module:UInt64, used:UInt64, revision:UInt64, failure:ExceptionType in F) -> bool
    where {const owner N, const owner B, const owner E, owner F} {
    ref callable = make CallableSites {
        signature <- no_node(); body <- no_node(); function_form <- false;
    };
    ref site = make UInt64 { no_node() };
    if (inspect_callable(nodes, revision, used, definition, callable) != CProvider ||
        !find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause,
            site))
        return false;
    failure.defining_module <- 0u64;
    if (site == no_node()) return true;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node();
        parameter_tail <- no_node(); readonly <- false;
    };
    return inspect_signature(nodes, revision, used, site, clause) == ThrowsSignatureClause &&
        resolve_exception_type(nodes, names, selected, clause.annotation, module, used, revision,
                               failure)
}

func read_imported_constructor_failure(
    contracts:const ModuleInterfaces in C, published:UInt64, head:UInt64, failure:ExceptionType in F)
    -> bool where {const owner C, owner F} {
    if (published > intrinsic (len)(contracts) || head >= published ||
        contracts[head].interface_kind != c_constructor()) return false;
    val module <- contracts[head].failure_module;
    failure.defining_module <- module;
    if (module == 0u64) return true;
    val identity <- contracts[head].failure_identity;
    val schema <- find_interface(contracts, published, module, identity);
    if (schema == no_node() || contracts[schema].interface_kind != record_type()) return false;
    val classification <- contracts[schema].exception_schema;
    if (classification != CheckedExceptionSchema && classification != UncheckedExceptionSchema)
        return false;
    failure.declaration <- identity;
    failure.checked <- classification == CheckedExceptionSchema;
    return true
}

export data HereContract {
    first_parameter:UInt64,
    result_kind:UInt8,
    result_module:UInt64,
    result_identity:UInt64,
}

export func inspect_here_contract(views:const SuppliedViews in V, formal:UInt64,
    contract:HereContract in C) -> bool
    where {const owner V, owner C} {
    if (formal >= intrinsic (len)(views)) return false;
    return case views[formal] of {
        (HereFormalContract { val first <- first_parameter, val kind <- result_kind,
                              val module <- result_module, val identity <- result_identity, }) -> {
            contract.first_parameter <- first;
            contract.result_kind <- kind;
            contract.result_module <- module;
            contract.result_identity <- identity;
            true
        };
        _ -> false
    }
}

export data HandleContract { marker:UInt64, owner_site:UInt64, readonly:bool, }

export func inspect_handle_contract(views:const SuppliedViews in V, formal:UInt64,
    contract:HandleContract in H) -> bool
    where {const owner V, owner H} {
    if (formal >= intrinsic (len)(views)) return false;
    return case views[formal] of {
        (PreparedHandleFormal { val marker <- marker, val owner_site <- owner_site, val readonly <-
            readonly, }) -> {
            contract.marker <- marker;
            contract.owner_site <- owner_site;
            contract.readonly <- readonly;
            true
        };
        _ -> false
    }
}

func prepare_handle_contract(nodes:const ExprNodes in N, names:const NameBindings in B,
                             selected:const SelectedExports in E, views:SuppliedViews in V,
                             formal:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, owner V} {
    ref input = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref formal_binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <-
            no_node(); readonly <- false
    };
    if (!typed_formal(nodes, revision, used, formal, input,
        formal_binding) || input.mode != HandleFormal) return;
    val owner_name <- formal_binding.owner_name;
    val marker <- formal_binding.target_type;
    if (owner_name >= used || marker >= used || names[owner_name].kind != owner_binding() ||
        !native_handle_marker(names, selected, marker)) return;
    views[formal] <- make PreparedHandleFormal {
        marker <- marker; owner_site <- names[owner_name].declaration; readonly <-
            formal_binding.readonly
    };
    return
}

func prepare_here_contract(nodes:const ExprNodes in N, names:const NameBindings in B,
                           selected:const SelectedExports in E, views:SuppliedViews in V,
                           formal:UInt64, signature:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, owner V} {
    val head <- no_node();
    val first <- no_node();
    val clause <- no_node();
    if (!signature_formals(nodes, revision, used, signature, head, first) ||
        !find_signature_clause(nodes, revision, used, signature, ThrowsSignatureClause,
            clause) || clause != no_node())
        return;
    ref result = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <-
            no_node(); readonly <- false;
    };
    if (!find_signature_clause(nodes, revision, used, signature, ValueResultClause, clause) ||
        inspect_signature(nodes, revision, used, clause, result) != ValueResultClause) return;
    val feedback <- result.annotation;
    val kind <- native_value_kind(names, selected, feedback);
    if (!native_scalar(kind) && kind != enum_type() && kind != builtin_void()) return;
    val module <- 0u64;
    val identity <- 0u64;
    if (kind == enum_type()) {
        module <- type_module(names, selected, feedback, 0u64);
        (identity <- type_identity(names, selected, feedback)):void
    };
    views[formal] <- make HereFormalContract {
        first_parameter <- first; result_kind <- kind; result_module <- module; result_identity <-
            identity
    };
    return
}

func remember_supplied_view(views:SuppliedViews in V, receiver:UInt64,
    parameter:const ModuleInterfaceRow in P,
                            actual_owner:UInt64, body:UInt64)
    -> void where {owner V, const owner P} {
    if (parameter.value_kind != array_type()) return;
    views[receiver] <- make SuppliedArrayView {
        type_module <- parameter.type_module; type_identity <- parameter.type_identity;
        owner_role <- actual_owner; body <- body; readonly <- parameter.target_readonly != 0u8;
    };
    return;
}

func check_here_supplier(nodes:const ExprNodes in N, call:UInt64, revision:UInt64, used:UInt64,
    report:NativeDeclarationResult in R) -> UInt64
    where {const owner N, owner R} {
    ref invocation = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (direct_invocation(nodes, revision, used, call, invocation) != DirectInvocationReady ||
        inspect_sequence_entry(nodes, revision, used, invocation.arguments, entry) != ArgumentSequence ||
        entry.previous != no_node() || checked_ref_argument(nodes, invocation.arguments)) {
        reject_declaration(report, call, invalid_native_callback());
        return no_node();
    };
    return entry.item;
}

func attach_here_body(work:NameWork in W, at:UInt64, sites:const HereSites in H) -> void
    where {owner W, const owner H} {
    val call <- sites.call;
    work[call].active <- at;
    work[at].value_kind <- work[call].value_kind;
    work[at].value_module <- work[call].value_module;
    work[at].value_identity <- work[call].value_identity;
    if (sites.full_scope) { (work[sites.body].active <- at):void; };
    return;
}

func check_local_here(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                      work:NameWork in W, views:SuppliedViews in V, at:UInt64, callback:UInt64,
                          revision:UInt64, used:UInt64,
                      report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, owner W, owner V, owner R} {
    ref sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    if (inspect_here_invocation(nodes, revision, used, at, sites) != HereReady) {
        reject_declaration(report, at, invalid_native_callback());
        return;
    };
    val operand <- check_here_supplier(nodes, sites.call, revision, used, report);
    if (operand == no_node()) return;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    ref parameter = make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node(); target_readonly <- 0u8; owner_readonly <- 0u8;
        has_here <- 0u8; failure_module <- 0u64; failure_identity <- 0u64; failure_checked <- 0u8;
        name_first <- 0u64; name_past <- 0u64; enum_code <- 0u64;
        native_function <- no_node(); callable_kind <- NoCallableKind; native_reception <- 0u8;
        membership <- UnprovedMembership;
        native_passes_owner <- 0u8; payload <- make NoInterfacePayload {};
        aggregate_storage <- UnprovedAggregate; exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
        scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- NoArrayRead; source_numeric_fault <- false; source_writer <- NoSourceWriter; object_view <- make NoCallableObjectView {};
        array_slot_checked <- false; slot_target_invariant <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    };
    if (!describe_parameter(nodes, names, selected, work[callback].next, 0u64, true, false, parameter, used, revision)) {
        reject_declaration(report, callback, invalid_native_callback());
        return;
    };
    if (!match_handle_parameter(nodes, names, selected, parameter, operand, loan, used, revision, report)) return;
    val supplied <- sites.supplied;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref header = make UInt64 { no_node() };
    ref expected = make UInt64 { no_node() };
    ref receiver = make UInt64 { no_node() };
    if (inspect_formal(nodes, revision, used, callback, formal) != HereFormalSyntax ||
        !signature_formals(nodes, revision, used, formal.signature, header, expected) ||
        !first_sequence_entry(nodes, revision, used, sites.receivers, HereReceiverSequence, receiver)) {
        reject_declaration(report, supplied, invalid_native_callback());
        return;
    };
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (expected == no_node() || receiver == no_node()) {
            if (expected == receiver) { attach_here_body(work, at, sites); } else {
                reject_declaration(report, supplied, mismatched_here_receivers());
            };
            return;
        } else {};
        if (!describe_parameter(nodes, names, selected, expected, 0u64, true, false, parameter, used, revision)) {
            reject_declaration(report, callback, invalid_native_callback());
            return;
        };
        if (!check_here_receiver(nodes, names, selected, receiver, parameter, loan.owner, used, revision, report)) return;
        remember_supplied_view(views, receiver, parameter, loan.owner, sites.body);
        expected <- work[expected].next;
        receiver <- work[receiver].next;
    };
}

func check_selected_here(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         contracts:const ModuleInterfaces in C, work:NameWork in W,
                             views:SuppliedViews in V,
                         at:UInt64, head:UInt64, revision:UInt64, used:UInt64, report:NativeDeclarationResult in R)
    where {const owner N, const owner B, const owner E, const owner C, owner W, owner V, owner R} {
    ref sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    if (inspect_here_invocation(nodes, revision, used, at, sites) != HereReady) {
        reject_declaration(report, at, invalid_native_callback());
        return;
    };
    val supplied <- sites.supplied;
    if (head == no_node()) { reject_declaration(report, supplied, unproved_imported_here_signature()); return; } else {};
    if (contracts[head].has_here != 1u8 || contracts[head].entry_count == 0u64 ||
        contracts[head + 1u64].value_kind != c_handle_type()) {
        reject_declaration(report, supplied, here_operation_required());
        return;
    } else {};
    val operand <- check_here_supplier(nodes, sites.call, revision, used, report);
    if (operand == no_node()) return;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    if (!match_handle_parameter(nodes, names, selected, contracts[head + 1u64], operand, loan, used, revision, report))
        return;
    ref receiver = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, sites.receivers, HereReceiverSequence, receiver)) {
        reject_declaration(report, supplied, invalid_native_callback());
        return;
    };
    for (row in head + 2u64 .. head + 1u64 + contracts[head].entry_count) {
        if (receiver == no_node()) { reject_declaration(report, supplied, mismatched_here_receivers()); return; } else {};
        if (contracts[row].value_kind != array_type() ||
            contracts[row].owner_role != contracts[head + 1u64].owner_role) {
            reject_declaration(report, supplied, unproved_imported_here_signature());
            return
        };
        if (!check_here_receiver(nodes, names, selected, receiver, contracts[row], loan.owner, used, revision, report)) return;
        remember_supplied_view(views, receiver, contracts[row], loan.owner, sites.body);
        receiver <- work[receiver].next;
    };
    if (receiver != no_node()) { reject_declaration(report, supplied, mismatched_here_receivers()); return; } else {};
    attach_here_body(work, at, sites);
    # A checked ordinary here header without a declared failure comes
    # from the direct synchronous relay proof at the defining visit.
    if (contracts[head].interface_kind == callable_binding() &&
        contracts[head].failure_identity == no_node()) {
        (views[at] <- make PreparedSynchronousHere { call <- sites.call }):void
    };
}

func forwarded_here_operand(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, views:const SuppliedViews in V,
                            operand:UInt64, call:UInt64, marker:UInt64, owner_role:UInt64, readonly:bool,
                            used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner E, const owner V} {
    val actual <- ungrouped(nodes, revision, used, operand);
    if (actual == no_node() || name_syntax(nodes, used, actual) != OrdinaryName ||
        names[actual].kind != here_receiver_binding()) return mismatched_here_receiver_type();
    val receiver <- names[actual].declaration;
    if (receiver >= used) return invalid_native_callback();
    return case views[receiver] of {
        (SuppliedArrayView { val module <- type_module, val identity <- type_identity, val role <-
            owner_role,
                            val body <- body, val supplied_readonly <- readonly, }) -> {
            if (role != owner_role) return mismatched_actual_handle_owner();
            if (supplied_readonly && !readonly) return invalid_native_access();
            if (body >= used || syntax_first(nodes, used, call) < syntax_first(nodes, used, body) ||
                syntax_past(nodes, used, call) > syntax_past(nodes, used, body) ||
                enclosing_callable(nodes, names, names[call].scope) != enclosing_callable(nodes,
                    names, names[body].scope))
                return invalid_native_callback();
            if (module != type_module(names, selected, marker,
                0u64) || identity != type_identity(names, selected, marker))
                return mismatched_here_receiver_type();
            0u8
        };
        _ -> mismatched_here_receiver_type()
    };
}

func check_forwarded_here_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
                                   selected:const SelectedExports in E, work:const NameWork in W,
                                   views:const SuppliedViews in V,
                                   at:UInt64, first_parameter:UInt64, arguments:UInt64, used:UInt64,
                                       revision:UInt64,
                                   report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner V, owner R} {
    val argument <- no_node();
    if (!first_sequence_entry(nodes, revision, at, arguments, ArgumentSequence, argument)) {
        reject_declaration(report, at, invalid_native_callback());
        return false;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <-
            no_node(); readonly <- false;
    };
    ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    val expected <- first_parameter;
    val marker <- no_node();
    val diagnostic <- 0u8;
    for (unused in 0u64 .. at + 1u64) {
        if (argument == no_node() && expected == no_node()) return true;
        if (!typed_formal(nodes, revision, used, expected, parameter, binding) ||
            inspect_sequence_entry(nodes, revision, at, argument, entry) != ArgumentSequence ||
            checked_ref_argument(nodes, argument)) {
            reject_declaration(report, at, mismatched_here_receivers());
            return false;
        };
        marker <- binding.target_type;
        if (parameter.mode != ReferenceFormal || binding.owner_name == no_node() ||
            !native_array_view(nodes, names, selected, marker, true, used, revision)) {
            reject_declaration(report, expected, mismatched_here_receiver_type());
            return false;
        };
        diagnostic <- forwarded_here_operand(nodes, names, selected, views, entry.item, at, marker,
                                             names[binding.owner_name].declaration,
                                                 binding.readonly, used, revision);
        if (diagnostic != 0u8) {
            reject_declaration(report, entry.item, diagnostic);
            return false;
        };
        if (argument == arguments) { (argument <- no_node()):void; }
            else { (argument <- work[argument].next):void; };
        expected <- work[expected].next;
    };
    reject_declaration(report, at, mismatched_here_receivers());
    return false;
}

func check_forwarded_here_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                              selected:const SelectedExports in E, work:NameWork in W,
                              views:SuppliedViews in V,
                              at:UInt64, call:const DirectCallSites in C, used:UInt64, revision:UInt64,
                              report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, const owner V, const owner C,
        owner R} {
    val callee <- call.callee;
    if (names[callee].kind != formal_binding()) return true;
    val formal <- names[callee].declaration;
    ref callback = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    if (inspect_formal(nodes, revision, used, formal, callback) != HereFormalSyntax) return true;
    ref contract = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <-
            0u64
    };
    if (!inspect_here_contract(views, formal, contract)) {
        reject_declaration(report, callee, unproved_here_feedback());
        return false
    };
    if (!check_forwarded_here_arguments(nodes, names, selected, work, views, at,
                                        contract.first_parameter, call.arguments, used, revision,
                                            report)) return false;
    views[at] <- make PreparedHereInvocation { formal <- formal };
    work[at].value_kind <- contract.result_kind;
    work[at].value_module <- contract.result_module;
    work[at].value_identity <- contract.result_identity;
    return true;
}

export func prepared_here_formal(views:const SuppliedViews in V,
    at:UInt64) -> UInt64 where {const owner V} {
    if (at >= intrinsic (len)(views)) return no_node();
    return case views[at] of {
        (PreparedHereInvocation { val formal <- formal, }) -> { formal };
        _ -> no_node()
    }
}

export func prepared_native_operation(views:const SuppliedViews in V, at:UInt64,
    definition:UInt64) -> bool
    where {const owner V} {
    if (at >= intrinsic (len)(views)) return false;
    return case views[at] of {
        (PreparedNativeOperation { val selected <- definition, val actual <- actual_owner, }) -> {
            selected == definition && actual != no_node()
        };
        _ -> false
    }
}

func remember_prepared_native_call(views:SuppliedViews in V, site:UInt64, definition:UInt64,
    owner_site:UInt64)
    -> void where {owner V} {
    views[site] <- make PreparedNativeOperation { definition <- definition; actual_owner <-
        owner_site };
    return
}

# Ordinary provider calls in this profile have one written handle. A native
# here parameter, when present, is prepared separately by the supplied-body check.
func prepare_native_loan_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                              selected:const SelectedExports in E, work:const NameWork in W,
                              views:SuppliedViews in V, definition:UInt64, at:UInt64, arguments:UInt64,
                                  used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner E, const owner W, owner V} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <-
        false; };
    val head <- no_node();
    val parameter <- no_node();
    val failure <- no_node();
    if (inspect_callable(nodes, revision, used, definition, callable) != CProvider ||
        !signature_formals(nodes, revision, used, callable.signature, head,
            parameter) || parameter == no_node() ||
        !find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause,
            failure) ||
        failure != no_node()) return;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    if (inspect_formal(nodes, revision, used, parameter, formal) == HereFormalSyntax) {
        (parameter <- work[parameter].next):void
    };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <-
            no_node(); readonly <- false
    };
    if (parameter == no_node() || work[parameter].next != no_node() ||
        !typed_formal(nodes, revision, used, parameter, formal,
            binding) || formal.mode != HandleFormal ||
        binding.owner_name >= used || names[binding.owner_name].kind != owner_binding()) return;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, arguments,
        entry) != ArgumentSequence || entry.previous != no_node())
        return;
    val operand <- entry.item;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false };
    if (operand == no_node() || !trace_handle_loan(nodes, names, operand, loan, used,
        revision)) return;
    val expected <- binding.target_type;
    if (!native_handle_marker(names, selected, expected) || !native_handle_marker(names, selected,
        loan.marker) ||
        type_module(names, selected, expected, 0u64) != type_module(names, selected, loan.marker,
            0u64) ||
        type_identity(names, selected, expected) != type_identity(names, selected,
            loan.marker)) return;
    val owner <- names[binding.owner_name].declaration;
    val readonly <- owner_constraint_syntax(nodes, owner) == ReadonlyOwnerConstraint;
    if (!allows_handle_access(nodes, loan, binding.readonly || readonly, readonly)) return;
    remember_prepared_native_call(views, at, definition, loan.owner);
    return
}

array ArgumentSlots[UInt64]:UInt64;

func here_formal_name(nodes:const ExprNodes in N, formal:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    val form <- inspect_formal(nodes, revision, used, formal, parameter);
    if (form == HereFormalSyntax) {
        val head <- no_node();
        ref header = make SignatureSites {
            previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
        };
        if (!find_signature_clause(nodes, revision, used, parameter.signature, SignatureHead, head) ||
            inspect_signature(nodes, revision, used, head, header) != SignatureHead) return no_node();
        return header.name
    };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    if (form != OrdinaryFormal || inspect_binding(nodes, revision, used, parameter.binding, binding) != TypedBinding)
        return no_node();
    return binding.name
}

func find_labeled_formal(source:const SourceBytes in S, nodes:const ExprNodes in N,
    work:const NameWork in W, label:UInt64, first:UInt64, used:UInt64, revision:UInt64) -> UInt64
    where {const owner S, const owner N, const owner W} {
    val first_byte <- syntax_first(nodes, used, label);
    val past_byte <- syntax_past(nodes, used, label);
    val formal <- first;
    val name <- no_node();
    for (unused in 0u64 .. used) {
        if (formal == no_node()) return no_node();
        name <- here_formal_name(nodes, formal, used, revision);
        if (name == no_node()) return no_node();
        if (same_bytes(source, first_byte, past_byte, source, syntax_first(nodes, used, name),
            syntax_past(nodes, used, name))) return formal;
        (formal <- work[formal].next):void
    };
    return no_node()
}

func scalar_here_contract(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, contract:const HereContract in H, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner W, const owner H} {
    if (contract.result_kind != builtin_void() && !source_call_scalar(contract.result_kind)) return false;
    val parameter <- contract.first_parameter;
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return true;
        if (!source_call_scalar(independent_formal_kind(nodes, names, parameter, used, revision))) return false;
        (parameter <- work[parameter].next):void
    };
    return false
}

func matches_forwarded_here(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:const SuppliedViews in V, input:UInt64,
    expected:const HereContract in H, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner W, const owner V, const owner H} {
    if (input >= used || names[input].kind != formal_binding()) return false;
    ref actual = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    if (!inspect_here_contract(views, names[input].declaration, actual) ||
        actual.result_kind != expected.result_kind) return false;
    val left <- actual.first_parameter;
    val right <- expected.first_parameter;
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (left == no_node() || right == no_node()) return left == right;
        kind <- independent_formal_kind(nodes, names, right, used, revision);
        if (kind == 0u8 || kind != independent_formal_kind(nodes, names, left, used, revision)) return false;
        left <- work[left].next;
        (right <- work[right].next):void
    };
    return false
}

func bind_ordinary_here_body(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, actual:const HereSites in A,
    expected:const HereContract in H, formal:UInt64, call:UInt64, used:UInt64, revision:UInt64)
    -> UInt8 where {const owner N, const owner B, const owner W, owner V, const owner A, const owner H} {
    val receiver <- no_node();
    if (!first_sequence_entry(nodes, revision, used, actual.receivers, HereReceiverSequence, receiver))
        return invalid_native_callback();
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    val parameter <- expected.first_parameter;
    val shape <- InvalidBindingSyntax;
    val kind <- 0u8;
    for (unused in 0u64 .. used) {
        if (receiver == no_node() || parameter == no_node()) {
            if (receiver != parameter) return mismatched_here_receivers();
            views[actual.supplied] <- make OrdinaryHereBody { formal <- formal; call <- call };
            return 0u8
        };
        if (inspect_sequence_entry(nodes, revision, used, receiver, entry) != HereReceiverSequence)
            return invalid_native_callback();
        shape <- inspect_binding(nodes, revision, used, entry.item, binding);
        kind <- independent_formal_kind(nodes, names, parameter, used, revision);
        if (shape == InvalidBindingSyntax || kind == 0u8) return invalid_native_callback();
        if (reference_here_receiver(nodes, receiver) ||
            (shape == TypedBinding && (binding.owner_name != no_node() || binding.target_type >= used ||
                names[binding.target_type].kind != kind))) return mismatched_here_receiver_type();
        views[receiver] <- make OrdinaryHereReceiver { kind <- kind };
        receiver <- work[receiver].next;
        (parameter <- work[parameter].next):void
    };
    return invalid_native_callback()
}

func bind_ordinary_here_input(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, input:UInt64, formal:UInt64,
    call:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner W, owner V} {
    ref actual = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false
    };
    val literal <- inspect_here_actual(nodes, revision, used, input, actual);
    ref expected = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    if (!inspect_here_contract(views, formal, expected)) {
        if (literal || (input < used && names[input].kind == formal_binding() &&
            is_here_formal(nodes, used, names[input].declaration))) return ordinary_here_parameter_required();
        return 0u8
    };
    if (literal) return bind_ordinary_here_body(nodes, names, work, views, actual, expected, formal, call, used, revision);
    return if (matches_forwarded_here(nodes, names, work, views, input, expected, used, revision)) {
        0u8
    } else { incompatible_forwarded_here() }
}

func bind_ordinary_here_call(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, work:const NameWork in W, views:SuppliedViews in V, slots:ArgumentSlots in M,
    actual:const DirectCallSites in A, call:UInt64, definition:UInt64, first:UInt64, attached:UInt64,
    used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner W, owner V, owner M, const owner A, owner R} {
    val positional <- first;
    val issue <- 0u8;
    if (attached != no_node()) {
        ref trailing = make HereSites {
            call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false
        };
        if (inspect_here_invocation(nodes, revision, used, attached, trailing) != HereReady || trailing.call != call) {
            reject_declaration(report, attached, invalid_native_callback());
            return false
        };
        issue <- bind_ordinary_here_input(nodes, names, work, views, trailing.supplied, first, call, used, revision);
        if (issue != 0u8) { reject_declaration(report, trailing.supplied, issue); return false };
        slots[first] <- call;
        (positional <- work[first].next):void
    };
    val argument <- no_node();
    if (!first_sequence_entry(nodes, revision, call, actual.arguments, ArgumentSequence, argument)) {
        reject_declaration(report, call, invalid_native_callback());
        return false
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref named = make NamedArgumentSites { operand <- no_node(); label <- no_node() };
    val input <- no_node();
    val formal <- no_node();
    val named_suffix <- false;
    val labeled <- false;
    for (unused in 0u64 .. used) {
        if (argument == no_node()) {
            formal <- first;
            for (remaining in 0u64 .. used) {
                if (formal == no_node()) {
                    views[call] <- make OrdinaryHereCall { definition <- definition };
                    if (attached != no_node()) { (views[attached] <- make OrdinaryHereWrapper {}):void };
                    return true
                };
                if (slots[formal] != call) { reject_declaration(report, call, missing_call_argument()); return false };
                (formal <- work[formal].next):void
            };
            reject_declaration(report, call, invalid_native_callback());
            return false
        };
        if (inspect_sequence_entry(nodes, revision, call, argument, entry) != ArgumentSequence ||
            checked_ref_argument(nodes, argument)) {
            reject_declaration(report, argument, invalid_native_callback());
            return false
        };
        input <- entry.item;
        formal <- positional;
        labeled <- inspect_named_argument(nodes, revision, argument, input, named);
        if (labeled) {
            formal <- find_labeled_formal(source, nodes, work, named.label, first, used, revision);
            if (formal == no_node()) {
                reject_declaration(report, named.label, unknown_argument_label());
                return false
            };
            if (named.operand == no_node()) {
                reject_declaration(report, input, missing_call_argument());
                return false
            };
            named_suffix <- named_suffix || formal != positional;
            views[input] <- make OrdinaryHereLabel { operand <- named.operand };
            (input <- named.operand):void
        } else {
            if (named_suffix) { reject_declaration(report, input, 45u8); return false }
        };
        if (formal == no_node()) {
            reject_declaration(report, entry.item, extra_call_argument());
            return false
        };
        if (slots[formal] == call) {
            reject_declaration(report, if (labeled) { (named.label) } else { (entry.item) }, duplicate_call_argument());
            return false
        };
        issue <- bind_ordinary_here_input(nodes, names, work, views, input, formal, call, used, revision);
        if (issue != 0u8) { reject_declaration(report, input, issue); return false };
        slots[formal] <- call;
        views[argument] <- make OrdinaryHereArgument { formal <- formal; operand <- input };
        if (formal == positional) { (positional <- work[formal].next):void };
        (argument <- work[argument].next):void
    };
    reject_declaration(report, call, invalid_native_callback());
    return false
}

func scalar_here_formals(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:const SuppliedViews in V, first:UInt64, used:UInt64,
    revision:UInt64) -> bool where {const owner N, const owner B, const owner W, const owner V} {
    ref expected = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    if (!is_here_formal(nodes, used, first)) return false;
    val parameter <- first;
    for (unused in 0u64 .. used) {
        if (parameter == no_node() || !is_here_formal(nodes, used, parameter)) return true;
        if (!inspect_here_contract(views, parameter, expected) ||
            !scalar_here_contract(nodes, names, work, expected, used, revision)) return false;
        (parameter <- work[parameter].next):void
    };
    return false
}

func prepare_ordinary_here_calls(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, work:const NameWork in W, views:SuppliedViews in V,
    used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner W, owner V, owner R} {
    ref slots = make ArgumentSlots(used, no_node());
    ref attached = make ArgumentSlots(used, no_node());
    ref syntax = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false
    };
    for (at in 0u64 .. used) {
        if (inspect_here_invocation(nodes, revision, used, at, syntax) == HereReady) {
            attached[syntax.call] <- at;
            (attached[syntax.supplied] <- at):void
        }
    };
    ref actual = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val first <- no_node();
    val head <- no_node();
    val definition <- no_node();
    for (at in 0u64 .. used) {
        if (direct_invocation(nodes, revision, used, at, actual) == DirectInvocationReady &&
            names[actual.callee].kind == callable_binding()) {
            definition <- names[actual.callee].declaration;
            if (definition < used && work[definition].next_method == no_node() &&
                work[definition].active == no_node() &&
                inspect_callable(nodes, revision, used, definition, callable) == ModuleCallable &&
                signature_formals(nodes, revision, used, callable.signature, head, first) &&
                scalar_here_formals(nodes, names, work, views, first, used, revision) &&
                variadic_method_formal(nodes, revision, used, definition) == no_node()) {
                if (!bind_ordinary_here_call(source, nodes, names, work, views, slots,
                    actual, at, definition, first, attached[at], used, revision, report)) return false
            }
        }
    };
    ref named = make NamedArgumentSites { operand <- no_node(); label <- no_node() };
    for (at in 0u64 .. used) {
        if (inspect_named_argument(nodes, revision, used, at, named) &&
            !(case views[at] of { OrdinaryHereLabel -> true; _ -> false })) {
            reject_declaration(report, at, 45u8);
            return false
        };
        if (attached[at] == no_node() && inspect_here_actual(nodes, revision, used, at, syntax) &&
            !(case views[at] of { OrdinaryHereBody -> true; _ -> false })) {
            reject_declaration(report, at, here_operation_required());
            return false
        }
    };
    return true
}

func prepare_local_calls(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         work:NameWork in W, views:SuppliedViews in V, used:UInt64, revision:UInt64,
                         emit_object:bool, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner V, owner R} {
    ref invocation = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    val direct <- InvalidInvocation;
    val here <- InvalidHere;
    val call <- no_node();
    val callee <- no_node();
    val definition <- no_node();
    val callback <- no_node();
    ref expected = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <- 0u64
    };
    for (at in 0u64 .. used) {
        direct <- direct_invocation(nodes, revision, used, at, invocation);
        if (direct == InvalidInvocation) {
            reject_declaration(report, at, invalid_native_callback());
            return false;
        };
        if (direct == DirectInvocationReady) {
            callee <- invocation.callee;
            if (names[callee].kind == formal_binding() &&
                inspect_here_contract(views, names[callee].declaration, expected) &&
                scalar_here_contract(nodes, names, work, expected, used, revision)) {
                views[at] <- make OrdinaryHereInvocation { formal <- names[callee].declaration };
                work[at].value_kind <- expected.result_kind
            };
            if (names[callee].kind == c_operation() || names[callee].kind == callable_binding() || names[callee].kind == c_entry()) {
                definition <- names[callee].declaration;
                if ((names[callee].kind != callable_binding() || work[definition].next_method ==
                    no_node()) &&
                    !check_callable_permissions(nodes, names, at,
                        checked_callable_kind(is_function(nodes, definition)), report))
                    return false;
                record_local_call_result(nodes, names, work, selected, at, definition, used, revision);
                if (names[callee].kind == c_operation()) {
                    prepare_native_loan_call(nodes, names, selected, work, views, definition, at,
                        invocation.arguments, used, revision);
                    if (native_here_parameter(nodes, definition, used, revision) != no_node()) {
                        (work[at].expects_here <- 1u8):void
                    }
                };
            } else {};
        } else {
            here <- inspect_here_invocation(nodes, revision, used, at, sites);
            if (here == InvalidHere) {
                reject_declaration(report, at, invalid_native_callback());
                return false;
            };
            if (here == HereReady && !(case views[at] of { OrdinaryHereWrapper -> true; _ -> false })) {
                call <- sites.call;
                if (direct_invocation(nodes, revision, used, call, invocation) != DirectInvocationReady) {
                    reject_declaration(report, sites.supplied, here_operation_required());
                    return false;
                };
                callee <- invocation.callee;
                if (names[callee].kind == ordinary_selection() &&
                    selected[names[callee].declaration].kind == callable_export()) {
                    if (emit_object) {
                        reject_declaration(report, sites.supplied, unproved_imported_here_signature());
                        return false;
                    } else {};
                } else {
                    if (names[callee].kind != c_operation()) {
                        reject_declaration(report, sites.supplied, here_operation_required());
                        return false;
                    } else {};
                    callback <- native_here_parameter(nodes, names[callee].declaration, used, revision);
                    if (callback == no_node()) {
                        reject_declaration(report, sites.supplied, here_operation_required());
                        return false;
                    } else {};
                    check_local_here(nodes, names, selected, work, views, at, callback, revision,
                        used, report);
                    if (report.diagnostic != 0u8) return false;
                };
            } else {};
        };
    };
    return true;
}

func here_completion_destination(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 work:const NameWork in W, at:UInt64, revision:UInt64, used:UInt64) -> UInt64
    where {const owner N, const owner B, const owner W} {
    val kind <- completion_syntax(nodes, at);
    if (kind == ContinueCompletion || kind == BreakCompletion) {
        val target <- names[at].declaration;
        if (target == no_node()) return no_node();
        ref sites = make HereSites {
            call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
        };
        if (inspect_here_invocation(nodes, revision, used, target, sites) == HereReady &&
            work[sites.call].expects_here != 0u8) return target;
        return no_node();
    };
    val scope <- names[at].scope;
    if (kind == ReturnCompletion && is_scope_block(nodes, scope)) return work[scope].active;
    return no_node();
}

export func prepared_source_here_relay(views:const SuppliedViews in V, at:UInt64) -> UInt64
    where {const owner V} {
    if (at >= intrinsic (len)(views)) return no_node();
    return case views[at] of {
        PreparedSourceHereRelay { val formal <-, } -> formal;
        _ -> no_node()
    }
}

# A direct synchronous native relay may publish its ordinary here signature
# after the defining body has been checked. The forwarded call already proved
# the receiver's exact, ordered offers and their common owner.
func prepare_source_here_relay(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, target:UInt64, forwarded:UInt64,
    used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, owner V} {
    val formal <- prepared_here_formal(views, forwarded);
    if (formal == no_node()) return;
    val definition <- enclosing_callable(nodes, names, names[target].scope);
    ref wrapper = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    if (definition >= used || names[definition].declaration != definition ||
        work[definition].next_method != no_node() || work[definition].active != no_node() ||
        inspect_callable(nodes, revision, used, definition, wrapper) != ModuleCallable || wrapper.function_form ||
        single_return_value(nodes, wrapper.body, used, revision) != target ||
        source_here_parameter(nodes, wrapper.signature, used, revision) != formal) return;
    ref supplied = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref provider = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref operand = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_here_invocation(nodes, revision, used, target, supplied) != HereReady ||
        single_completion_value(nodes, supplied.body, ContinueCompletion, used, revision) != forwarded ||
        direct_invocation(nodes, revision, used, supplied.call, call) != DirectInvocationReady ||
        names[call.callee].kind != c_operation() ||
        inspect_callable(nodes, revision, used, names[call.callee].declaration, provider) != CProvider ||
        !provider.function_form ||
        inspect_sequence_entry(nodes, revision, used, call.arguments, operand) != ArgumentSequence ||
        operand.previous != no_node() ||
        names[operand.item].kind != formal_binding() || names[operand.item].declaration != work[formal].next) return;
    views[definition] <- make PreparedSourceHereRelay { formal <- formal };
    return;
}

func prepare_forwarded_feedback(nodes:const ExprNodes in N, names:const NameBindings in B,
                                selected:const SelectedExports in E, work:NameWork in W,
                                views:SuppliedViews in V, used:UInt64, revision:UInt64, source_only:bool,
                                    report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, owner W, owner V, owner R} {
    ref operand = make UInt64 { no_node() };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    val target <- no_node();
    val value <- no_node();
    for (at in 0u64 .. used) {
        target <- here_completion_destination(nodes, names, work, at, revision, used);
        if (target != no_node() && work[target].value_kind != 0u8 &&
            completion_operand(nodes, revision, used, at, operand) && operand != no_node()) {
            value <- ungrouped(nodes, revision, used, operand);
            if (direct_invocation(nodes, revision, used, value, call) == DirectInvocationReady) {
                if (!check_forwarded_here_call(nodes, names, selected, work, views, value, call, used,
                    revision, report)) return false;
                if (source_only) { prepare_source_here_relay(nodes, names, work, views, target, value, used, revision) }
            };
        };
    };
    return true;
}

func check_here_completions(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                            used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner W, owner R} {
    val target <- no_node();
    val expected <- 0u8;
    val mismatch <- 0u8;
    ref operand = make UInt64 { no_node() };
    val value <- no_node();
    val feedback <- 0u8;
    for (at in 0u64 .. used) {
        if (work[at].expects_here != 0u8 && work[at].active == no_node()) {
            reject_declaration(report, at, here_body_required());
            return false;
        } else {};
        target <- here_completion_destination(nodes, names, work, at, revision, used);
        if (target != no_node()) {
            expected <- work[target].value_kind;
            mismatch <- if (expected == enum_type()) { mismatched_enum_feedback() }
                            else { mismatched_here_feedback() };
            if (!completion_operand(nodes, revision, used, at, operand)) {
                reject_declaration(report, at, invalid_native_callback());
                return false;
            };
            if (operand == no_node()) { reject_declaration(report, at, mismatch); return false; } else {};
            value <- ungrouped(nodes, revision, used, operand);
            feedback <- scalar_operand_kind(nodes, names, work, value, used, revision);
            if (feedback == 0u8) { reject_declaration(report, operand, unproved_here_feedback()); return false; } else {};
            if (feedback != expected || (expected == enum_type() &&
                (work[value].value_module != work[target].value_module ||
                 work[value].value_identity != work[target].value_identity))) {
                reject_declaration(report, operand, mismatch);
                return false;
            } else {};
        } else {};
    };
    return true;
}

func selected_call_interface(names:const NameBindings in B, selected:const SelectedExports in E,
                             contracts:const ModuleInterfaces in C, interface_count:UInt64, callee:UInt64) -> UInt64
    where {const owner B, const owner E, const owner C} {
    if (names[callee].kind != ordinary_selection()) return no_node();
    val site <- names[callee].declaration;
    if (selected[site].kind != callable_export()) return no_node();
    return find_interface(contracts, interface_count, selected[site].origin_module, selected[site].identity);
}

func selected_c_callable(names:const NameBindings in B, selected:const SelectedExports in E,
    callee:UInt64) -> bool
    where {const owner B, const owner E} {
    if (names[callee].kind != ordinary_selection()) return false;
    val site <- names[callee].declaration;
    return selected[site].origin_module != 0u64 && selected[site].kind == callable_export() &&
        selected[site].shape != ordinary_callable_shape() && selected[site].shape != array_slot_callable_shape()
}

func check_text_argument(nodes:const ExprNodes in N, work:const NameWork in W,
                         argument:UInt64, expected:UInt8, used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner W, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence) {
        reject_declaration(report, argument, invalid_native_parameter());
        return false;
    };
    val value <- ungrouped(nodes, revision, used, entry.item);
    val literal <- text_literal_syntax(nodes, used, value);
    if (literal == NulFreeLiteral || (literal == InteriorNulLiteral && expected != builtin_c_string())) return true;
    if (literal == InteriorNulLiteral) {
        reject_declaration(report, value, interior_nul_in_c_string());
        return false;
    };
    if (value != no_node()) {
        val actual <- work[value].value_kind;
        if (text_type(actual) && (actual == expected || actual == builtin_c_string())) return true;
    };
    val at <- if (value == no_node()) { entry.item } else { value };
    reject_declaration(report, at, if (expected == builtin_c_string()) { c_string_argument_required() }
                                   else { string_argument_required() });
    return false;
}

func check_native_operation_operand(nodes:const ExprNodes in N, names:const NameBindings in B,
                                    selected:const SelectedExports in E, work:const NameWork in W,
                                    argument:UInt64, parameter:const ModuleInterfaceRow in P,
                                        loan:HandleLoan in L,
                                    used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) ->
                                        bool
    where {const owner N, const owner B, const owner E, const owner W, const owner P, owner L,
        owner R} {
    val expected <- parameter.value_kind;
    if (text_type(expected)) return check_text_argument(nodes, work, argument, expected, used,
        revision, report);
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
        checked_ref_argument(nodes, argument)) {
        reject_declaration(report, argument, invalid_native_parameter());
        return false
    };
    if (expected == c_handle_type())
        return match_handle_parameter(nodes, names, selected, parameter, entry.item, loan, used,
            revision, report);
    val value <- ungrouped(nodes, revision, used, entry.item);
    val actual <- scalar_operand_kind(nodes, names, work, value, used, revision);
    val widens <- parameter.owner_role == no_node() && expected == builtin_u32() && actual == builtin_u8();
    if ((!native_scalar(expected) && expected != enum_type()) ||
        (actual != expected && !widens) ||
        (expected == enum_type() &&
         (work[value].value_module != parameter.type_module || work[value].value_identity !=
             parameter.type_identity))) {
        reject_declaration(report, entry.item, invalid_native_parameter());
        return false
    };
    return true
}

func ordinary_native_handle_scalars(nodes:const ExprNodes in N, names:const NameBindings in B,
                                    selected:const SelectedExports in E, work:const NameWork in W,
                                    signature:UInt64, first:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner W} {
    ref failure = make UInt64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, signature, ThrowsSignatureClause, failure) ||
        failure != no_node()) return false;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false;
    };
    val parameter <- first;
    val has_handle <- false;
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return has_handle;
        if (!typed_formal(nodes, revision, used, parameter, formal, binding)) return false;
        if (formal.mode == HandleFormal) {
            if (has_handle || binding.owner_name >= used ||
                names[binding.owner_name].kind != owner_binding() ||
                !native_handle_marker(names, selected, binding.target_type)) return false;
            (has_handle <- true):void
        } else {
            if ((formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
                binding.owner_name != no_node() ||
                !source_call_scalar(native_value_kind(names, selected,
                    binding.target_type))) return false
        };
        parameter <- work[parameter].next
    };
    return false
}

func imported_native_loan_profile(contracts:const ModuleInterfaces in C, published:UInt64, head:UInt64) -> bool
    where {const owner C} {
    if (published > intrinsic (len)(contracts) || head >= published) return false;
    val arity <- contracts[head].entry_count;
    if (arity >= published - head) return false;
    if (contracts[head].callable_kind == CheckedFunction) {
        if (!native_loan_scalar_result(contracts[head].result_kind)) return false;
        for (row in head + 1u64 .. head + 1u64 + arity) {
            if (contracts[row].value_kind == array_type() || contracts[row].value_kind == c_handle_type())
                return true
        };
        return false
    };
    # Procedure calls keep the existing closed signature profiles.
    if (contracts[head].callable_kind != CheckedProcedure) return false;
    if (contracts[head].result_kind == builtin_u64() && arity == 6u64) {
        return contracts[head + 1u64].value_kind == array_type() &&
            contracts[head + 4u64].value_kind == array_type()
    };
    if (contracts[head].result_kind == builtin_u8() && arity == 2u64) {
        val second <- contracts[head + 2u64].value_kind;
        return contracts[head + 1u64].value_kind == c_handle_type() &&
            (second == c_handle_type() || second == builtin_c_string())
    };
    return contracts[head].result_kind == enum_type() && arity == 5u64 &&
        contracts[head + 1u64].value_kind == c_handle_type() &&
        contracts[head + 2u64].value_kind == c_handle_type() &&
        contracts[head + 3u64].value_kind == c_handle_type() &&
        contracts[head + 4u64].value_kind == array_type() &&
        contracts[head + 5u64].value_kind == array_type()
}

func checked_native_loan_row(row:const ModuleInterfaceRow in R, roles:UInt64) -> bool
    where {const owner R} {
    if (row.interface_kind != 0u8 || row.owner_role >= roles || row.target_readonly > 1u8 ||
        row.owner_readonly > 1u8 || row.native_reception != 0u8 || row.native_passes_owner != 0u8)
        return false;
    if (row.value_kind == c_handle_type())
        return row.field_mode == HandleFormal && row.type_module != 0u64 &&
            row.type_identity != no_node();
    if (row.value_kind == array_type())
        return row.type_module != 0u64 && row.type_identity != no_node() && row.field_mode == ReferenceFormal &&
            row.target_readonly == 1u8 && row.owner_readonly == 1u8;
    return row.value_kind == builtin_c_string() && row.target_readonly == 1u8 &&
        row.owner_readonly == 1u8
}

func checked_native_value_row(row:const ModuleInterfaceRow in R) -> bool where {const owner R} {
    if (row.interface_kind != 0u8 ||
        (row.field_mode != ValueFormal && row.field_mode != ExplicitValueFormal) ||
        row.owner_role != no_node() || row.target_readonly != 0u8 || row.owner_readonly != 0u8 ||
        row.native_reception != 0u8 || row.native_passes_owner != 0u8) return false;
    if (row.value_kind == enum_type())
        return row.type_module != 0u64 && row.type_identity != no_node();
    return source_call_scalar(row.value_kind) && row.type_module == 0u64 && row.type_identity == 0u64
}

func checked_native_loan_result(contracts:const ModuleInterfaces in C, published:UInt64,
    head:UInt64) -> bool where {const owner C} {
    if (contracts[head].result_kind == builtin_u8() || contracts[head].result_kind == builtin_u64())
        return contracts[head].type_module == 0u64 && contracts[head].type_identity == 0u64;
    if (contracts[head].type_module == 0u64 || contracts[head].type_identity == no_node())
        return false;
    val result <- find_interface(contracts, published, contracts[head].type_module,
        contracts[head].type_identity);
    if (result == no_node() || contracts[result].interface_kind != enum_type() ||
        contracts[result].entry_count == 0u64) return false;
    val representation <- contracts[result].element_kind;
    if (representation != builtin_u8() && representation != builtin_u32() &&
        representation != builtin_u64() && representation != builtin_i64()) return false;
    for (member in result + 1u64 .. result + 1u64 + contracts[result].entry_count) {
        if (contracts[member].interface_kind != 0u8 || contracts[member].value_kind != enum_type())
            return false
    };
    return true
}

func native_owner_is_active(nodes:const ExprNodes in N, work:const NameWork in W,
    owner_site:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner W} {
    if (owner_site >= used) return false;
    ref local = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false };
    if (inspect_handle_binding(nodes, revision, used, owner_site, local) != OwnHandleBinding) return true;
    val acquisition <- ungrouped(nodes, revision, used, local.initializer);
    return acquisition < owner_site && work[acquisition].active == owner_site
}

func active_native_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, input:UInt64,
    loan:HandleLoan in L, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner W, owner L} {
    val value <- ungrouped(nodes, revision, used, input);
    if (value >= used) return false;
    if (name_syntax(nodes, used, value) == SymbolicName)
        return trace_installed_handle(nodes, names, selected, work, value, loan, used, revision);
    return trace_handle_loan(nodes, names, input, loan, used, revision) &&
        native_owner_is_active(nodes, work, loan.owner, used, revision)
}

export func inspect_acquired_handle_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, input:UInt64, invocation:UInt64,
    used:UInt64, revision:UInt64, contract:HandleContract in C) -> bool
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val value <- ungrouped(nodes, revision, used, input);
    if (value >= invocation || invocation >= used || name_syntax(nodes, used, value) != OrdinaryName ||
        names[value].kind != handle_binding()) return false;
    val holder <- names[value].declaration;
    if (holder >= value || names[holder].scope != names[invocation].scope) return false;
    ref local = make BoundHandleSites { binding <- no_node(); initializer <- no_node(); readonly <- false };
    if (inspect_handle_binding(nodes, revision, used, holder, local) != OwnHandleBinding) return false;
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false };
    if (!active_native_loan(nodes, names, selected, work, value, loan, used, revision) ||
        loan.owner != holder || loan.marker >= used || !native_handle_marker(names, selected, loan.marker))
        return false;
    contract.marker <- loan.marker;
    contract.owner_site <- loan.owner;
    contract.readonly <- loan.readonly;
    return true
}

func remember_native_operand(views:SuppliedViews in V, argument:UInt64, call:UInt64,
    revision:UInt64, position:UInt64, input:UInt64, owner_site:UInt64, row:const ModuleInterfaceRow in R)
    -> void where {owner V, const owner R} {
    views[argument] <- make PreparedNativeOperand {
        call_site <- call; revision <- revision; position <- position; input <- input;
        kind <- row.value_kind; owner_role <- row.owner_role; owner_site <- owner_site;
        type_module <- row.type_module; type_identity <- row.type_identity;
        target_readonly <- row.target_readonly != 0u8; owner_readonly <- row.owner_readonly != 0u8
    };
    return
}

func prepare_imported_native_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C,
    work:const NameWork in W, views:SuppliedViews in V, published:UInt64, head:UInt64, at:UInt64, first:UInt64,
    used:UInt64, revision:UInt64, report:NativeDeclarationResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner C, const owner W,
                   owner V, owner R} {
    val roles <- contracts[head].owner_count;
    val arity <- contracts[head].entry_count;
    val function_form <- contracts[head].callable_kind == CheckedFunction;
    val byte_procedure <- !function_form && contracts[head].result_kind == builtin_u64();
    if (contracts[head].failure_module != 0u64 || contracts[head].failure_identity != 0u64 ||
        contracts[head].failure_checked != 0u8 || roles == 0u64 || roles > arity ||
        contracts[head].owner_role != no_node() ||
        !checked_native_loan_result(contracts, published, head)) {
        reject_declaration(report, at, invalid_native_parameter());
        return false;
    };
    if (byte_procedure && (roles > 2u64 ||
        (roles == 2u64 && contracts[head + 1u64].owner_role == contracts[head + 4u64].owner_role))) {
        reject_declaration(report, at, invalid_native_parameter());
        return false
    };
    val argument <- first;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    val row <- no_node();
    val owner_site <- no_node();
    val kind <- 0u8;
    val type <- no_node();
    val requires_body <- !function_form;
    val value_parameter <- false;
    for (position in 0u64 .. arity) {
        row <- head + 1u64 + position;
        if (argument >= at ||
            inspect_sequence_entry(nodes, revision, at, argument, entry) != ArgumentSequence ||
            checked_ref_argument(nodes, argument)) {
            reject_declaration(report, at, invalid_native_parameter());
            return false
        };
        kind <- contracts[row].value_kind;
        value_parameter <- checked_native_value_row(contracts[row]);
        if (byte_procedure &&
            (if (position == 0u64 || position == 3u64) { kind != array_type() }
             else { kind != builtin_u64() || !value_parameter })) {
            reject_declaration(report, entry.item, invalid_native_parameter());
            return false
        };
        if (!(value_parameter && (function_form || byte_procedure)) &&
            !checked_native_loan_row(contracts[row], roles)) {
            reject_declaration(report, entry.item, invalid_native_parameter());
            return false
        };
        owner_site <- no_node();
        if (kind == c_handle_type()) {
            if (!active_native_loan(nodes, names, selected, work, entry.item, loan, used, revision)) {
                reject_declaration(report, entry.item, mismatched_actual_handle_owner());
                return false
            };
            if (!match_selected_handle(nodes, names, selected, contracts[row], entry.item, loan, report))
                return false;
            (owner_site <- loan.owner):void
        };
        if (kind == array_type()) {
            type <- find_interface(contracts, published, contracts[row].type_module, contracts[row].type_identity);
            if (type == no_node() || contracts[type].interface_kind != array_type() ||
                contracts[type].entry_count != 0u64 || contracts[type].array_index_kind != builtin_u64()) {
                reject_declaration(report, entry.item, invalid_native_parameter());
                return false
            };
            if (byte_procedure && contracts[type].element_kind != builtin_u8()) {
                reject_declaration(report, entry.item, invalid_native_parameter());
                return false
            };
            (requires_body <- true):void
        };
        remember_native_operand(views, argument, at, revision, position, entry.item, owner_site, contracts[row]);
        (argument <- work[argument].next):void
    };
    if (argument != no_node()) {
        reject_declaration(report, argument, invalid_native_parameter());
        return false;
    };
    views[at] <- make PreparedNativeLoanCall {
        module <- contracts[head].defining_module; definition <- contracts[head].declaration;
        revision <- revision; activation <- enclosing_callable(nodes, names, names[at].scope);
        arity <- arity; requires_body <- requires_body; function_form <- function_form
    };
    return true
}

func has_readonly_array_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, first:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner W} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    val parameter <- first;
    for (unused in 0u64 .. used) {
        if (parameter == no_node() || !typed_formal(nodes, revision, used, parameter, formal, binding)) return false;
        if (formal.mode == ReferenceFormal && binding.readonly &&
            (names[binding.target_type].kind == array_type() ||
             imported_kind(names, selected, binding.target_type) == array_export())) return true;
        parameter <- work[parameter].next
    };
    return false
}

func native_loan_scalar_result(kind:UInt8) -> bool {
    return kind == builtin_u8() || kind == builtin_u64() || kind == builtin_bool() || kind == enum_type()
}

func prepare_local_native_loans(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:SuppliedViews in V,
    definition:UInt64, signature:UInt64, first_parameter:UInt64, first_argument:UInt64,
    at:UInt64, used:UInt64, revision:UInt64, row:ModuleInterfaceRow in P, report:NativeDeclarationResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, owner V, owner P, owner R} {
    ref failure = make UInt64 { no_node() };
    val result <- work[at].value_kind;
    if (!find_signature_clause(nodes, revision, used, signature, ThrowsSignatureClause, failure) ||
        failure != no_node() ||
        !native_loan_scalar_result(result)) {
        reject_declaration(report, at, invalid_native_parameter());
        return false
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref handle = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false };
    val parameter <- first_parameter;
    val argument <- first_argument;
    val actual_owner <- no_node();
    val scalar_value <- false;
    val readonly_view <- false;
    for (position in 0u64 .. used) {
        if (argument == no_node() && parameter == no_node()) {
            views[at] <- make PreparedNativeLoanCall {
                module <- 0u64; definition <- definition; revision <- revision;
                activation <- enclosing_callable(nodes, names, names[at].scope); arity <- position; requires_body <- true; function_form <- true;
            };
            return true
        };
        if (argument >= at || parameter >= used ||
            inspect_sequence_entry(nodes, revision, at, argument, entry) != ArgumentSequence ||
            checked_ref_argument(nodes, argument) ||
            !describe_parameter(nodes, names, selected, parameter, 0u64, true, false, row, used, revision)) {
            reject_declaration(report, at, invalid_native_parameter());
            return false
        };
        actual_owner <- no_node();
        if (row.value_kind == c_handle_type() && row.field_mode == HandleFormal) {
            if (!active_native_loan(nodes, names, selected, work, entry.item, handle, used, revision) ||
                !match_selected_handle(nodes, names, selected, row, entry.item, handle, report)) {
                if (report.diagnostic == 0u8) {
                    reject_declaration(report, entry.item, mismatched_actual_handle_owner())
                };
                return false
            };
            (actual_owner <- handle.owner):void
        } else {
            scalar_value <- row.owner_role == no_node() &&
                (row.field_mode == ValueFormal || row.field_mode == ExplicitValueFormal) &&
                (source_call_scalar(row.value_kind) || row.value_kind == enum_type());
            readonly_view <- row.value_kind == array_type() && row.field_mode == ReferenceFormal &&
                row.owner_role < used && row.target_readonly == 1u8 && row.owner_readonly == 1u8;
            if (!scalar_value && !readonly_view) {
                reject_declaration(report, entry.item, invalid_native_parameter());
                return false
            }
        };
        remember_native_operand(views, argument, at, revision, position, entry.item, actual_owner, row);
        argument <- work[argument].next;
        parameter <- work[parameter].next
    };
    reject_declaration(report, at, invalid_native_parameter());
    return false
}

func check_native_operation_call(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, interface_count:UInt64,
                            work:NameWork in W, views:SuppliedViews in V, at:UInt64,
                                call:const DirectCallSites in D, used:UInt64,
                                revision:UInt64,
                            report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner C, owner W, const owner D,
        owner V, owner R} {
    val callee <- call.callee;
    ref argument = make UInt64 { no_node() };
    ref loan = make HandleLoan { marker <- no_node(); owner <- no_node(); readonly <- false; };
    if (!first_sequence_entry(nodes, revision, used, call.arguments, ArgumentSequence, argument)) {
        reject_declaration(report, at, invalid_native_parameter());
        return false;
    };
    if (names[callee].kind == c_operation()) {
        val definition <- names[callee].declaration;
        if (native_here_parameter(nodes, definition, used, revision) != no_node()) return true;
        ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
        ref signature_head = make UInt64 { no_node() };
        ref parameter = make UInt64 { no_node() };
        if (inspect_callable(nodes, revision, used, definition, callable) != CProvider ||
            !signature_formals(nodes, revision, used, callable.signature, signature_head, parameter)) {
            reject_declaration(report, at, invalid_native_parameter());
            return false;
        };
        ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
        ref binding = make BindingSites {
            name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
        };
        ref row = make ModuleInterfaceRow {
            defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
            interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; array_index_kind <- 0u8; value_kind <- 0u8;
            type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
            target_readonly <- 0u8; owner_readonly <- 0u8;
            has_here <- 0u8; failure_module <- 0u64; failure_identity <- 0u64;
            failure_checked <- 0u8;
            name_first <- 0u64; name_past <- 0u64; enum_code <- 0u64;
            native_function <- no_node(); callable_kind <- NoCallableKind; native_reception <- 0u8;
            native_passes_owner <- 0u8;
            membership <- UnprovedMembership;
            payload <- make NoInterfacePayload {}; aggregate_storage <- UnprovedAggregate;
            exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
            scalar_object_body <- false; scalar_source_body <- false; array_read_completion <- NoArrayRead; source_numeric_fault <- false; source_writer <- NoSourceWriter; object_view <- make NoCallableObjectView {};
            array_slot_checked <- false; slot_target_invariant <- false; source_allocates <- false;
            array_slot_failures <- make ByteArrayFailures {
                bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
            }
        };
        if (callable.function_form && has_readonly_array_formal(nodes, names, selected, work, parameter, used, revision))
            return prepare_local_native_loans(nodes, names, selected, work, views, definition,
                callable.signature, parameter, argument, at, used, revision, row, report);
        ref role = make SignatureSites {
            previous <- no_node(); name <- no_node(); annotation <- no_node();
            parameter_tail <- no_node(); readonly <- false;
        };
        val result <- work[at].value_kind;
        val scalar_function <- callable.function_form && native_loan_scalar_result(result) &&
            parameter < used && work[parameter].next < used;
        val handle_and_scalars <- (!callable.function_form || scalar_function) &&
            ordinary_native_handle_scalars(nodes, names, selected, work, callable.signature, parameter, used, revision);
        val checked_proc <- !callable.function_form && handle_and_scalars;
        val checked_local <- callable.function_form || checked_proc;
        val ordered <- scalar_function && handle_and_scalars;
        val expected <- 0u8;
        val owner <- no_node();
        val actual_owner <- no_node();
        ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
        for (position in 0u64 .. used) {
            if (argument == no_node() || parameter == no_node()) {
                if (checked_local && argument != parameter) {
                    reject_declaration(report, at, invalid_native_parameter());
                    return false
                };
                if (checked_proc) {
                    if (actual_owner == no_node() || (!native_scalar(result) &&
                        result != builtin_void())) {
                        reject_declaration(report, at, invalid_native_parameter());
                        return false
                    };
                    remember_prepared_native_call(views, at, definition, actual_owner)
                };
                if (ordered) {
                    views[at] <- make PreparedNativeLoanCall {
                        module <- 0u64; definition <- definition; revision <- revision;
                        activation <- enclosing_callable(nodes, names, names[at].scope);
                        arity <- position; requires_body <- false; function_form <- true
                    }
                };
                return true
            };
            if (checked_local) {
                if (!describe_parameter(nodes, names, selected, parameter, 0u64, true, false, row, used,
                    revision)) {
                    reject_declaration(report, argument, invalid_native_parameter());
                    return false
                };
                if (!check_native_operation_operand(nodes, names, selected, work, argument, row,
                    loan, used, revision, report))
                    return false;
                if (row.value_kind == c_handle_type()) {
                    owner <- row.owner_role;
                    if (inspect_signature(nodes, revision, used, owner,
                        role) != OwnerSignatureClause ||
                        (work[role.annotation].active == at && work[owner].active != loan.owner)) {
                        reject_declaration(report, argument, mismatched_actual_handle_owner());
                        return false
                    };
                    work[role.annotation].active <- at;
                    work[owner].active <- loan.owner;
                    actual_owner <- loan.owner;
                    if (ordered && !native_owner_is_active(nodes, work, actual_owner, used, revision)) {
                        (ordered <- false):void
                    }
                };
                if (ordered) {
                    if (inspect_sequence_entry(nodes, revision, at, argument, entry) != ArgumentSequence) {
                        reject_declaration(report, argument, invalid_native_parameter());
                        return false
                    };
                    remember_native_operand(views, argument, at, revision, position, entry.item,
                        if (row.value_kind == c_handle_type()) { actual_owner } else { no_node() }, row)
                }
            } else {
                if (typed_formal(nodes, revision, used, parameter, formal, binding) &&
                    formal.mode == ReferenceFormal && binding.owner_name != no_node()) {
                    expected <- names[binding.target_type].kind;
                    if (text_type(expected) && !check_text_argument(nodes, work, argument, expected,
                        used, revision, report)) return false
                }
            };
            argument <- work[argument].next;
            parameter <- work[parameter].next;
        };
        if (checked_local) {
            reject_declaration(report, at, invalid_native_parameter());
            return false
        };
        return true;
    };
    val head <- selected_call_interface(names, selected, contracts, interface_count, callee);
    if (head == no_node() || contracts[head].interface_kind != c_operation() || contracts[head].has_here != 0u8) return true;
    if (imported_native_loan_profile(contracts, interface_count, head))
        return prepare_imported_native_loans(nodes, names, selected, contracts, work, views,
                                           interface_count, head, at, argument, used, revision, report);
    val first <- argument;
    val checked <- contracts[head].callable_kind == CheckedFunction;
    for (row in head + 1u64 .. head + 1u64 + contracts[head].entry_count) {
        if (argument == no_node()) {
            if (!checked) return true;
            reject_declaration(report, at, invalid_native_parameter());
            return false
        };
        if (checked) {
            if (!check_native_operation_operand(nodes, names, selected, work, argument,
                contracts[row], loan, used, revision, report))
                return false;
            if (contracts[row].value_kind == c_handle_type()) {
                if (!shares_imported_owner(contracts, work, head + 1u64, row, first,
                    contracts[row].owner_role, loan.owner)) {
                    reject_declaration(report, argument, mismatched_actual_handle_owner());
                    return false
                };
                (work[argument].active <- loan.owner):void
            }
        } else {
            if (text_type(contracts[row].value_kind) &&
                !check_text_argument(nodes, work, argument, contracts[row].value_kind, used,
                    revision, report)) return false
        };
        (argument <- work[argument].next):void
    };
    if (checked && argument != no_node()) {
        reject_declaration(report, at, invalid_native_parameter());
        return false
    };
    return true;
}

func remember_indexed_array_destination(views:SuppliedViews in V, destination:UInt64, assignment:UInt64,
    indexed:const IndexSites in I) -> void where {owner V, const owner I} {
    views[destination] <- make IndexedArrayDestination {
        assignment <- assignment; target <- indexed.target; index <- indexed.index
    };
    return
}

func remember_indexed_array_source(views:SuppliedViews in V, input:UInt64, assignment:UInt64,
    indexed:const IndexSites in I) -> void where {owner V, const owner I} {
    views[input] <- make IndexedArraySource { assignment <- assignment; target <- indexed.target; index <- indexed.index };
    return
}

export func prepare_module_calls(nodes:const ExprNodes in N, names:const NameBindings in B,
                                   selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, interface_count:UInt64,
                                   aggregate:const AggregateFacts in A, work:NameWork in W, views:SuppliedViews in V,
                                   used:UInt64, revision:UInt64, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner C, const owner A, owner W, owner V, owner R} {
    if (used > intrinsic (len)(views)) {
        reject_declaration(report, no_node(), invalid_native_callback());
        return false;
    };
    val head <- no_node();
    val selection <- no_node();
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref public_item = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref sum_output = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64 };
    val profile <- (NoSourceHandle:SourceHandleProfile);
    for (at in 0u64 .. used) {
        prepare_niladic_scalar_source(nodes, names, work, views, at, used, revision);
        if (work[at].array_construction) {
            if (inspect_construction(nodes, revision, used, at, construction) != PositionalConstruction) {
                reject_declaration(report, at, unsupported_ordinary_construction());
                return false
            };
            if (!prepare_source_array_construction(nodes, names, selected, contracts, interface_count,
                aggregate, work, views, at, used, revision, construction, report)) return false
        };
        if (inspect_index_selection(nodes, revision, used, at, indexed)) {
            prepare_source_byte_read(nodes, names, selected, contracts, interface_count,
                views, at, used, revision, indexed)
        };
        if (!prepare_array_slot_formal(nodes, names, work, selected, contracts, interface_count,
            aggregate, views, at, used, revision, report)) return false;
        if (names[at].kind == 0u8 &&
            inspect_assignment(nodes, revision, used, at, assignment) == PlaceTransfer &&
            inspect_index_selection(nodes, revision, at, assignment.destination, indexed)) {
            # The reader admits no named indexed operator. The checked name
            # table must also have no selected ordinary transfer family here.
            remember_indexed_array_destination(views, assignment.destination, at, indexed);
            if (inspect_index_selection(nodes, revision, at, assignment.input, indexed) &&
                (case views[assignment.input] of { NoSuppliedView -> true; _ -> false })) {
                remember_indexed_array_source(views, assignment.input, at, indexed)
            }
        };
        prepare_array_length_method(nodes, names, selected, work, views, at, used, revision);
        prepare_array_reader(nodes, names, selected, work, views, at, used, revision);
        prepare_readonly_reader(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        prepare_product_writer(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        if (module_item_publication(nodes, used, at) &&
            inspect_sequence_entry(nodes, revision, used, at, public_item) == ModuleSequence) {
            prepare_published_product_writer(nodes, names, selected, contracts, interface_count,
                aggregate, work, views, public_item.item, used, revision);
            # The export marks the prepared signature as a body demand.
            # Local loan preparation alone does not demand another body.
            if (case views[public_item.item] of {
                PreparedWorkspaceLoans { val publication_signature <-, } -> publication_signature;
                _ -> false
            }) {
                (views[public_item.item] <- make PreparedWorkspaceWriter {}):void
            }
        };
        prepare_aggregate_writer(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        prepare_parser_writer(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        prepare_readonly_query(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        prepare_array_inspector(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        prepare_workspace_loans(nodes, names, selected, contracts, interface_count,
            aggregate, work, views, at, used, revision);
        if (case views[at] of { NoSuppliedView -> true; _ -> false }) {
            profile <- source_handle_signature(nodes, names, selected, work, at, used, revision, true);
            if (profile == (ArrayProcedure:SourceHandleProfile) || profile == (AllocatingArrayProcedure:SourceHandleProfile)) {
                (views[at] <- make PreparedArrayProcedure {
                    allows_allocation <- profile == (AllocatingArrayProcedure:SourceHandleProfile)
                }):void
            }
        };
        prepare_scalar_predicate(nodes, names, selected, work, views, at, used, revision);
        if (case views[at] of { NoSuppliedView -> true; _ -> false }) {
            prepare_scalar_function(nodes, names, selected, work, views, at, used, revision)
        };
        prepare_byte_function(nodes, names, selected, work, contracts, interface_count,
            views, at, used, revision);
        if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady) {
            head <- selected_call_interface(names, selected, contracts, interface_count, call.callee);
            if (selected_c_callable(names, selected, call.callee)) {
                if (head == no_node() || (contracts[head].interface_kind != c_operation() &&
                    contracts[head].interface_kind != c_entry())) {
                    reject_declaration(report, at, invalid_native_parameter());
                    return false
                };
                if (!check_callable_permissions(nodes, names, at, contracts[head].callable_kind,
                    report)) return false
            };
            if (head != no_node() && contracts[head].membership == (PromiseOnly:FamilyMembership)) {
                reject_declaration(report, at, unprovided_callable_promise());
                return false
            };
            if (head != no_node() && contracts[head].interface_kind == callable_binding() &&
                contracts[head].callable_kind != NoCallableKind &&
                !check_callable_permissions(nodes, names, at, contracts[head].callable_kind,
                    report)) return false;
            if (head != no_node()) {
                # Allocate product plans before binding the imported operands.
                if (contracts[head].array_read_completion != NoArrayRead &&
                    contracts[head].result_kind == builtin_bool() && contracts[head].owner_count == 2u64 &&
                    contracts[head].entry_count == 2u64 && interface_count - head > 2u64 &&
                    contracts[head + 2u64].value_kind == record_type() &&
                    contracts[head].source_writer == NoSourceWriter) {
                    (views[at] <- make ImportedTextPredicateCandidate {}):void
                };
                if (contracts[head].source_writer == ProductWriter) {
                    (views[at] <- make ImportedProductWriterCandidate {}):void
                };
                if (contracts[head].source_writer == AggregateWriter &&
                    work[names[call.callee].declaration].selected_aggregate_writer == head) {
                    (views[at] <- make ImportedAggregateWriterCandidate {}):void
                };
                if (workspace_sum_output(contracts, interface_count, head) != no_node()) {
                    selection <- names[call.callee].declaration;
                    if (selected[selection].shape == ordinary_callable_shape() && selected[selection].checked == 0u8 &&
                        selected[selection].dependency_module == selected[selection].origin_module &&
                        direct_source_using(nodes, selected[selection].selection_site, used, revision) &&
                        call.arguments < at &&
                        inspect_sequence_entry(nodes, revision, used, call.arguments, sum_output) == ArgumentSequence &&
                        sum_output.item < call.arguments && !checked_ref_argument(nodes, call.arguments)) {
                        (views[at] <- make ImportedWorkspaceSumWriterCandidate { output <- sum_output.item }):void
                    };
                };
                if (contracts[head].scalar_source_body && contracts[head].result_kind == builtin_bool()) {
                    (views[at] <- make ImportedScalarPredicateCandidate {}):void
                };
                work[at].value_kind <- contracts[head].result_kind;
                work[at].value_module <- contracts[head].type_module;
                work[at].value_identity <- contracts[head].type_identity;
                (work[at].expects_here <- contracts[head].has_here):void;
            } else {};
        } else {
            if (inspect_here_invocation(nodes, revision, used, at, sites) == HereReady &&
                direct_invocation(nodes, revision, used, sites.call, call) == DirectInvocationReady) {
                if (names[call.callee].kind == ordinary_selection()) {
                    check_selected_here(nodes, names, selected, contracts, work, views, at,
                                        selected_call_interface(names, selected, contracts, interface_count, call.callee), revision, used, report);
                    if (report.diagnostic != 0u8) return false;
                } else {};
            } else {};
        };
    };
    return prepare_forwarded_feedback(nodes, names, selected, work, views, used, revision, true, report);
}

func text_writer_signature(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    signature:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner W} {
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    if (inspect_signature(nodes, revision, used, signature, clause) != OwnerSignatureClause || !clause.readonly)
        return false;
    val output_owner <- clause.previous;
    if (inspect_signature(nodes, revision, used, output_owner, clause) != OwnerSignatureClause || clause.readonly ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != ValueResultClause ||
        clause.annotation >= used || names[clause.annotation].kind != builtin_void() ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead)
        return false;
    ref output = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, output) ||
        output >= used) return false;
    val piece <- work[output].next;
    if (piece >= used || work[piece].next != no_node()) return false;
    val target <- reference_formal_marker(nodes, names, output, output_owner, false, used, revision);
    val input <- readonly_formal_marker(nodes, names, piece, signature, used, revision);
    return target < used && input < used && is_lexical_builder(nodes, names, target, revision, used) &&
        (names[input].kind == builtin_string() || is_lexical_builder(nodes, names, input, revision, used))
}

export func prepared_text_writer(views:const SuppliedViews in V, at:UInt64) -> bool where {const owner V} {
    return at < intrinsic (len)(views) && (case views[at] of {
        PreparedTextWriterMethod -> true;
        CheckedTextWriterMethod -> true;
        _ -> false
    })
}

func text_writer_method_count(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    views:const SuppliedViews in V, head:UInt64, used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner B, const owner W, const owner V} {
    if (names[head].kind != callable_binding() || names[head].declaration != head) return 0u64;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val method <- head;
    val count <- 0u64;
    val function_form <- is_function(nodes, head);
    for (unused in 0u64 .. used) {
        if (method == no_node()) return count;
        if (method >= used || names[method].declaration != head ||
            !(case views[method] of { NoSuppliedView -> true; _ -> false }) ||
            inspect_callable(nodes, revision, used, method, callable) != ModuleCallable ||
            callable.body == no_node() || callable.function_form != function_form ||
            !text_writer_signature(nodes, names, work, callable.signature, used, revision)) return 0u64;
        method <- work[method].next_method;
        (count <- count + 1u64):void
    };
    return 0u64
}

# Finish the whole fixed family before any of its signatures can enter
# ordinary source selection. Only the signatures belong to this pass.
func prepare_text_writer_family(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    views:SuppliedViews in V, head:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner W, owner V} {
    val count <- text_writer_method_count(nodes, names, work, views, head, used, revision);
    if (count == 0u64) return false;
    val method <- head;
    for (unused in 0u64 .. count) {
        views[method] <- make PreparedTextWriterMethod {};
        (method <- work[method].next_method):void
    };
    return true
}

# A bound name identifies the symbol and its declared view. The selected
# target and actual owner are supplied at an evaluated read or installation.
func bind_reference_symbol(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, views:SuppliedViews in V, site:UInt64,
    used:UInt64, revision:UInt64) -> void where {const owner N, const owner B, const owner E, owner V} {
    if (!reference_symbol(names, selected, site) || name_syntax(nodes, used, site) != SymbolicName) return;
    val definition <- names[site].declaration;
    if (names[site].kind == symbolic_selection()) {
        val shape <- selected[definition].shape;
        views[site] <- make BoundReferenceSymbol {
            symbol_module <- selected[definition].origin_module; symbol_identity <- selected[definition].identity;
            target_module <- selected[definition].owner_module; target_identity <- selected[definition].owner_identity;
            readonly <- shape == reference_symbol_shape(false, true) || shape == reference_symbol_shape(true, true);
            nullable <- shape == reference_symbol_shape(true, false) || shape == reference_symbol_shape(true, true)
        };
        return
    };
    ref declared = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, definition, declared) != ReferenceSymbolDeclaration)
        return;
    views[site] <- make BoundReferenceSymbol {
        symbol_module <- 0u64; symbol_identity <- definition;
        target_module <- type_module(names, selected, declared.value_type, 0u64);
        target_identity <- type_identity(names, selected, declared.value_type);
        readonly <- declared.readonly; nullable <- declared.nullable
    };
    return
}

export func check_module_interfaces(
    nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, contracts:const ModuleInterfaces in C, interface_count:UInt64,
    work:NameWork in W, views:SuppliedViews in V, module:UInt64, used:UInt64, revision:UInt64,
    first_required:UInt64 in A, report:NativeDeclarationResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner C, owner W, owner V, owner A,
           owner R} {
    if (used > intrinsic (len)(views)) {
        reject_declaration(report, no_node(), invalid_native_failure());
        return false
    };
    first_required <- no_node();
    ref acquired = make HandleConstructionSites { marker <- no_node(); arguments <- no_node(); actual_owner <- no_node(); };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref failure = make ExceptionType { defining_module <- 0u64; declaration <- no_node(); checked <-
        false; };
    val mode <- InvalidHandleConstruction;
    val marker <- no_node();
    val constructor <- no_node();
    val valid <- false;
    for (at in 0u64 .. used) {
        bind_reference_symbol(nodes, names, selected, views, at, used, revision);
        if (prepare_text_writer_family(nodes, names, work, views, at, used, revision) ||
            prepared_source_here_relay(views, at) != no_node() ||
            (case views[at] of { OrdinaryHereCall -> true; OrdinaryHereInvocation -> true; _ -> false })) {
            if (first_required == no_node()) { (first_required <- at):void }
        };
        mode <- inspect_handle_construction(nodes, revision, used, at, acquired);
        if (mode == OwnHandleMake || mode == BorrowHandleMake) {
            marker <- acquired.marker;
            if (names[marker].kind == ordinary_selection()) {
                check_imported_constructor(nodes, names, selected, contracts, interface_count, work, at, acquired, used, revision, report);
                if (report.diagnostic != 0u8) return false;
                constructor <- find_interface(contracts, interface_count,
                    type_module(names, selected, marker, 0u64), type_identity(names, selected,
                        marker));
                (valid <- read_imported_constructor_failure(
                    contracts, interface_count, constructor, failure)):void
            } else {
                constructor <- work[names[marker].declaration].active;
                check_constructor_arguments(
                    nodes, names, selected, work, at, constructor, acquired, used, revision,
                        report);
                if (report.diagnostic != 0u8) return false;
                (valid <- read_local_constructor_failure(
                    nodes, names, selected, constructor, module, used, revision, failure)):void
            };
            if (!valid) {
                reject_declaration(report, at, invalid_native_failure());
                return false
            };
            if (failure.defining_module != 0u64) {
                remember_acquisition_failure(views, at, failure);
                if (first_required == no_node()) { (first_required <- at):void }
            }
        } else {};
        if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady) {
            if (!check_native_operation_call(nodes, names, selected, contracts, interface_count,
                work, views, at, call, used, revision, report)) return false;
            if (first_required == no_node() && native_loan_requires_body(views, at)) {
                (first_required <- at):void
            }
        };
    };
    return check_here_completions(nodes, names, work, used, revision, report);
}

# Name binding supplies declaration identities and finishes using the active
# name table before these checks reuse its workspace.
export func check_native_declarations(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                      names:NameBindings in B, work:NameWork in W,
                                      selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:UInt64,
                                      facts:AggregateFacts in F, views:SuppliedViews in V, used:UInt64,
                                          revision:UInt64, emit_object:bool,
                                      report:NativeDeclarationResult in R) -> bool
    where {const owner S, const owner N, owner B, owner W, const owner E, const owner I, owner F, owner V,
        owner R} {
    if (used > intrinsic (len)(views)) {
        reject_declaration(report, no_node(), invalid_native_callback());
        return false;
    };
    report.diagnostic <- 0u8;
    report.node <- no_node();
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    for (at in 0u64 .. used) {
        if (inspect_signature(nodes, revision, used, at, clause) == OwningRegionResultClause) {
            reject_declaration(report, at, unsupported_owning_region_result());
            return false;
        };
        work[at].active <- no_node();
        work[at].value_kind <- 0u8;
        work[at].value_module <- 0u64;
        work[at].value_identity <- 0u64;
        work[at].expects_here <- 0u8;
    };
    ref schemas = make SchemaCheck { diagnostic <- 0u8; node <- no_node(); };
    if (!check_aggregate_schemas(nodes, names, work, selected, interfaces, interface_used, facts, used, revision, schemas)) {
        reject_declaration(report, schemas.node, schemas.diagnostic);
        return false;
    };
    for (at in 0u64 .. used) {
        check_type_declaration(nodes, names, selected, interfaces, interface_used, facts, at, used, revision, report);
        if (report.diagnostic != 0u8) return false;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    val form <- InvalidCallable;
    val definition <- no_node();
    val ordinary_here_work <- false;
    for (at in 0u64 .. used) {
        if (inspect_formal(nodes, revision, used, at, formal) == HereFormalSyntax) {
            prepare_here_contract(nodes, names, selected, views, at, formal.signature, used, revision);
            (ordinary_here_work <- true):void
        };
        if (!ordinary_here_work) {
            ordinary_here_work <- case nodes[at] of {
                Occupied { val syntax <- node, } -> case syntax.payload of {
                    HereSupply -> true;
                    NamedArgument -> true;
                    _ -> false
                };
                Vacant -> false
            };
            {}
        };
        form <- inspect_callable(nodes, revision, used, at, callable);
        if (form == CProvider || form == CEntry) {
            check_c_procedure(nodes, names, work, selected, at, callable.signature, used, revision, report);
            if (form == CEntry && report.diagnostic == 0u8) {
                check_handle_formals(nodes, names, work, selected, views, callable.signature,
                                     c_entry(), used, revision, report)
            };
        } else {
            if (form == ModuleCallable || form == LexicalCallable) {
                definition <- names[at].declaration;
                if (definition != at) { (work[definition].active <- at):void; } else {};
                check_handle_formals(nodes, names, work, selected, views, callable.signature,
                                     callable_binding(), used, revision, report);
            } else {};
        };
        if (report.diagnostic != 0u8) return false;
    };
    return check_handle_expressions(nodes, names, selected, work, used, revision, emit_object, report) &&
        (!ordinary_here_work || prepare_ordinary_here_calls(source, nodes, names, work, views, used, revision, report)) &&
        prepare_local_calls(nodes, names, selected, work, views, used, revision, emit_object,
            report) &&
        (!emit_object ||
         (prepare_forwarded_feedback(nodes, names, selected, work, views, used, revision, false, report) &&
          check_here_completions(nodes, names, work, used, revision, report)));
}

export data ModulePublication {
    module_identity:UInt64,
    selection_count:UInt64,
    graph_spelling_count:UInt64,
}

func count_owner_clauses(nodes:const ExprNodes in N, tail:UInt64, used:UInt64, revision:UInt64) -> UInt64 where {const owner N} {
    val current <- tail;
    val count <- 0u64;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val shape <- InvalidSignature;
    for (unused in 0u64 .. used) {
        if (current == no_node()) return count;
        shape <- inspect_signature(nodes, revision, used, current, clause);
        if (shape == SignatureHead) return count;
        if (shape == InvalidSignature || shape == OtherSignatureSyntax) return no_node();
        if (shape == OwnerSignatureClause) { (count <- count + 1u64):void; } else {};
        current <- clause.previous;
    };
    return no_node();
}

func source_here_parameter(nodes:const ExprNodes in N, signature:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N} {
    val head <- no_node();
    val first <- no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    if (!signature_formals(nodes, revision, used, signature, head, first) ||
        inspect_formal(nodes, revision, used, first, formal) != HereFormalSyntax) return no_node();
    return first
}

func source_here_supplier(nodes:const ExprNodes in N, names:const NameBindings in B,
                          selected:const SelectedExports in E, at:UInt64, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N, const owner B, const owner E} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    if (!typed_formal(nodes, revision, used, at, formal, binding) || formal.mode != HandleFormal ||
        binding.owner_name >= used || names[binding.owner_name].kind != owner_binding() ||
        !native_handle_marker(names, selected, binding.target_type)) return no_node();
    return names[binding.owner_name].declaration
}

enum SourceHandleProfile:UInt8 { NoSourceHandle, SourceHandle, ArrayProcedure, AllocatingArrayProcedure, }

func source_handle_signature(
    nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    work:const NameWork in W, form:UInt64, used:UInt64, revision:UInt64, array_procedure:bool)
    -> SourceHandleProfile where {const owner N, const owner B, const owner E, const owner W} {
    ref sites = make CallableSites {
        signature <- no_node(); body <- no_node(); function_form <- false;
    };
    if (form >= used || names[form].kind != callable_binding() ||
        inspect_callable(nodes, revision, used, form, sites) != ModuleCallable ||
        sites.body >= used || names[form].declaration != form ||
            work[form].next_method != no_node())
        return (NoSourceHandle:SourceHandleProfile);
    if (array_procedure) {
        ref failure = make UInt64 { no_node() };
        if (sites.function_form || !find_signature_clause(nodes, revision, used, sites.signature,
            ThrowsSignatureClause, failure) || failure != no_node()) return (NoSourceHandle:SourceHandleProfile)
    };
    ref result = make UInt64 { no_node() };
    val scalar_result <- declared_call_result(nodes, names, work, selected, form, used, revision, result);
    val sum_value <- array_procedure && scalar_result == 0u8 &&
        local_sum_value_type(nodes, names, sites.signature, revision, used) != no_node();
    val kind <- if (sum_value) { sum_type() } else { scalar_result };
    if (!sum_value && !source_call_scalar(kind) && kind != builtin_void() && (!array_procedure || kind != enum_type()))
        return (NoSourceHandle:SourceHandleProfile);
    ref head = make UInt64 { no_node() };
    ref parameter = make UInt64 { no_node() };
    if (!signature_formals(nodes, revision, used, sites.signature, head, parameter)) return (NoSourceHandle:SourceHandleProfile);
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false;
    };
    val has_handle <- false;
    val has_array <- false;
    val has_output <- false;
    val has_record <- false;
    val has_readonly_array <- false;
    ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val parameter_kind <- 0u8;
    val owner_kind <- ReadonlyOwnerConstraint;
    val target_kind <- 0u8;
    val imported <- 0u8;
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) {
            if (!array_procedure) return if (has_handle) { (SourceHandle:SourceHandleProfile) } else { (NoSourceHandle:SourceHandleProfile) };
            if (!has_array) return (NoSourceHandle:SourceHandleProfile);
            if (sum_value) return (ArrayProcedure:SourceHandleProfile);
            if (has_record || (kind == builtin_u8() && has_output)) {
                return if ((kind == builtin_u8() || kind == enum_type()) && has_handle &&
                    has_record && has_readonly_array && has_output) {
                    (AllocatingArrayProcedure:SourceHandleProfile)
                } else { (NoSourceHandle:SourceHandleProfile) }
            };
            if (kind == enum_type()) {
                if (!has_handle) return (NoSourceHandle:SourceHandleProfile);
                # Diagnostic output may use lexical scratch while its loans stay live.
                if (has_readonly_array && has_output) return (AllocatingArrayProcedure:SourceHandleProfile);
                return (ArrayProcedure:SourceHandleProfile)
            };
            if (if (has_output) { has_readonly_array } else { has_handle })
                return (ArrayProcedure:SourceHandleProfile);
            return (NoSourceHandle:SourceHandleProfile)
        };
        if (!typed_parameter(nodes, revision, used, parameter, array_procedure, formal, binding)) return (NoSourceHandle:SourceHandleProfile);
        if (sum_value && formal.mode == HandleFormal) return (NoSourceHandle:SourceHandleProfile);
        if (formal.mode == HandleFormal) {
            if (source_here_supplier(nodes, names, selected, parameter, used,
                revision) == no_node())
                return (NoSourceHandle:SourceHandleProfile);
            (has_handle <- true):void
        } else {
            if (array_procedure && formal.mode == ReferenceFormal) {
                if (binding.owner_name >= used || names[binding.owner_name].kind != owner_binding())
                    return (NoSourceHandle:SourceHandleProfile);
                owner_kind <- owner_constraint_syntax(nodes, names[binding.owner_name].declaration);
                target_kind <- names[binding.target_type].kind;
                imported <- imported_kind(names, selected, binding.target_type);
                if ((kind == builtin_u8() || kind == enum_type()) &&
                    (target_kind == record_type() || imported == record_export())) {
                    if (!binding.readonly || owner_kind != ReadonlyOwnerConstraint) return (NoSourceHandle:SourceHandleProfile);
                    (has_record <- true):void
                } else {
                    if (target_kind != array_type() && imported != array_export()) return (NoSourceHandle:SourceHandleProfile);
                    if (sum_value && (!binding.readonly || owner_kind != ReadonlyOwnerConstraint))
                        return (NoSourceHandle:SourceHandleProfile);
                    if (!binding.readonly && owner_kind != WritableOwnerConstraint) return (NoSourceHandle:SourceHandleProfile);
                    if (!binding.readonly && kind != enum_type() && kind != builtin_u8() &&
                        (kind != builtin_void() || target_kind != array_type() ||
                         !describe_local_u64_array_element(nodes, names, selected, names[binding.target_type].declaration,
                            used, revision, element) || element.kind != sum_type() || element.defining_module != 0u64))
                        return (NoSourceHandle:SourceHandleProfile);
                    has_array <- true;
                    has_output <- has_output || !binding.readonly;
                    (has_readonly_array <- has_readonly_array || binding.readonly):void
                }
            } else {
                parameter_kind <- native_value_kind(names, selected, binding.target_type);
                if ((formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
                    binding.owner_name != no_node() ||
                    (!source_call_scalar(parameter_kind) && (sum_value || !array_procedure || parameter_kind != enum_type())))
                    return (NoSourceHandle:SourceHandleProfile)
            }
        };
        parameter <- work[parameter].next
    };
    return (NoSourceHandle:SourceHandleProfile)
}

export func source_handle_callable(
    nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    work:const NameWork in W, form:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner W} {
    return source_handle_signature(nodes, names, selected, work, form, used, revision, false) == (SourceHandle:SourceHandleProfile)
}

export func first_source_handle_callable(
    nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    work:const NameWork in W, used:UInt64, revision:UInt64)
    -> UInt64 where {const owner N, const owner B, const owner E, const owner W} {
    for (at in 0u64 .. used) {
        if (source_handle_callable(nodes, names, selected, work, at, used, revision)) return at
    };
    return no_node()
}

func source_here_view(nodes:const ExprNodes in N, names:const NameBindings in B,
                      selected:const SelectedExports in E, at:UInt64, role:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    return typed_formal(nodes, revision, used, at, formal,
        binding) && formal.mode == ReferenceFormal &&
        binding.owner_name < used && names[binding.owner_name].kind == owner_binding() &&
        names[binding.owner_name].declaration == role &&
        native_array_view(nodes, names, selected, binding.target_type, binding.readonly, used,
            revision)
}

func stage_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                     selected:const SelectedExports in E, work:const NameWork in W,
                     contracts:ModuleInterfaces in C, count:UInt64, defining_module:UInt64, declaration:UInt64,
                     form:UInt64, kind:UInt8, source_callback:UInt64, array_read_completion:ArrayReadCompletion, source_writer:SourceWriter, scalar_source_body:bool, scoped_routine:bool,
                     used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val limit <- intrinsic (len)(contracts);
    if (count >= limit) return no_node();
    val next <- count + 1u64;
    ref parameter = make UInt64 { no_node() };
    ref head = make UInt64 { no_node() };
    ref result_marker = make UInt64 { no_node() };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val result_kind <- 0u8;
    val callback <- source_callback;
    val name <- no_node();
    val owner_count <- 0u64;
    val shape <- InvalidCallable;
    val source_here <- source_callback != no_node();
    val source_handle <- kind == callable_binding() && !source_here &&
        source_handle_callable(nodes, names, selected, work, form, used, revision);
    val source_array_reader <- array_read_completion != NoArrayRead;
    val role <- no_node();
    if (form != no_node()) {
        shape <- inspect_callable(nodes, revision, used, form, callable);
        if (shape != ModuleCallable && shape != ModuleCallablePromise && shape != CProvider &&
            shape != CEntry)
            return no_node();
        (result_kind <- declared_call_result(nodes, names, work, selected, form, used, revision, result_marker)):void;
        if (source_array_reader && shape == ModuleCallable && result_kind == 0u8) {
            result_marker <- local_sum_value_type(nodes, names, callable.signature, revision, used);
            if (result_marker != no_node()) { (result_kind <- sum_type()):void }
        };
    } else {};
    if (kind == c_operation() || kind == c_entry()) {
        name <- definition_name(nodes, revision, used, form);
        if (name == no_node()) return no_node();
    } else {};
    if (kind == c_operation()) {
        (callback <- native_here_parameter(nodes, form, used, revision)):void
    };
    val indexed_owners <- kind == c_entry() || source_handle || source_array_reader || scoped_routine ||
        (kind == c_operation() && callback == no_node());
    if (indexed_owners) {
        owner_count <- count_owner_clauses(nodes, callable.signature, used, revision);
        if (owner_count == no_node()) return no_node();
    } else {};
    if (kind == c_constructor() || kind == c_entry() || source_handle || source_array_reader || scoped_routine || scalar_source_body ||
        (kind == c_operation() && callback == no_node())) {
        if (!signature_formals(nodes, revision, used, callable.signature, head, parameter)) return no_node();
    } else {};
    if (callback != no_node()) {
        val supplier <- work[callback].next;
        if (source_here) {
            role <- source_here_supplier(nodes, names, selected, supplier, used, revision);
            if (role == no_node() || work[supplier].next != no_node() || callable.function_form ||
                (!native_scalar(result_kind) && result_kind != enum_type())) return no_node()
        };
        if (next >= limit ||
            !describe_parameter(nodes, names, selected, supplier, defining_module, true, false,
                                contracts[next], used, revision))
            return no_node();
        next <- next + 1u64;
        ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
        if (inspect_formal(nodes, revision, used, callback, formal) != HereFormalSyntax ||
            !signature_formals(nodes, revision, used, formal.signature, head, parameter)) return no_node();
    } else {};
    val ordinal <- no_node();
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) {
            write_interface_header(contracts[count], defining_module, declaration, kind, result_kind, next - count - 1u64);
            contracts[count].payload <- make NoInterfacePayload {};
            if (kind == callable_binding()) {
                if (shape == ModuleCallablePromise) {
                    (contracts[count].membership <- (PromiseOnly:FamilyMembership)):void;
                    return next
                };
                if (variadic_method_formal(nodes, revision, used, form) == no_node()) {
                    (contracts[count].membership <- (FixedMethods:FamilyMembership)):void
                } else {
                    (contracts[count].membership <- (VariadicMethod:FamilyMembership)):void
                }
            };
            if (form != no_node() && (kind != callable_binding() || work[form].next_method ==
                no_node())) {
                (contracts[count].callable_kind <-
                    checked_callable_kind(callable.function_form)):void
            };
            contracts[count].has_here <- if (callback == no_node()) { 0u8 } else { 1u8 };
            contracts[count].owner_count <- owner_count;
            contracts[count].array_read_completion <- array_read_completion;
            contracts[count].source_writer <- source_writer;
            contracts[count].scalar_source_body <- scalar_source_body;
            if (source_array_reader || scalar_source_body || scoped_routine) { (contracts[count].failure_identity <- no_node()):void };
            if (result_kind == enum_type() || result_kind == sum_type()) {
                contracts[count].type_module <- type_module(names, selected, result_marker, defining_module);
                (contracts[count].type_identity <- type_identity(names, selected, result_marker)):void;
            } else {};
            if (name != no_node()) {
                contracts[count].name_first <- syntax_first(nodes, used, name);
                (contracts[count].name_past <- syntax_past(nodes, used, name)):void;
            } else {};
            return next;
        };
        if (role != no_node() && !source_here_view(nodes, names, selected, parameter, role, used,
            revision))
            return no_node();
        if (next >= limit ||
            !describe_parameter(nodes, names, selected, parameter, defining_module,
                kind == c_operation(), kind == callable_binding(),
                                contracts[next], used, revision))
            return no_node();
        if ((source_writer == ProductWriter && work[parameter].next == no_node() && contracts[next].field_mode == ReferenceFormal) ||
            (source_writer == AggregateWriter && next == count + 2u64 && contracts[next].field_mode == ReferenceFormal)) {
            (contracts[next].value_kind <- record_type()):void
        };
        if (indexed_owners &&
            (contracts[next].value_kind == c_handle_type() ||
                text_type(contracts[next].value_kind) || contracts[next].value_kind == lexical_builder_type() ||
                 contracts[next].value_kind == array_type() ||
                 contracts[next].value_kind == record_type() || contracts[next].value_kind == sum_type() ||
                 (source_place_scalar(contracts[next].value_kind) && contracts[next].field_mode == ReferenceFormal))) {
            if (inspect_signature(nodes, revision, used, contracts[next].owner_role, clause) != OwnerSignatureClause) return no_node();
            ordinal <- count_owner_clauses(nodes, clause.previous, used, revision);
            if (ordinal == no_node()) return no_node();
            (contracts[next].owner_role <- ordinal):void;
        } else {};
        parameter <- work[parameter].next;
        next <- next + 1u64;
    };
    return no_node();
}

func stage_checked_source_failure(nodes:const ExprNodes in N, names:const NameBindings in B,
                                  selected:const SelectedExports in E,
                                  row:ModuleInterfaceRow in R, failure:UInt64, defining_module:UInt64,
                                  used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    if (failure == no_node()) {
        row.failure_identity <- no_node();
        return true
    };
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node();
        parameter_tail <- no_node(); readonly <- false
    };
    ref type = make ExceptionType {
        defining_module <- 0u64; declaration <- no_node(); checked <- false
    };
    if (inspect_signature(nodes, revision, used, failure, clause) != ThrowsSignatureClause ||
        !resolve_exception_type(nodes, names, selected, clause.annotation, defining_module,
                                used, revision, type)) return false;
    row.failure_identity <- type.declaration;
    row.failure_module <- type.defining_module;
    row.failure_checked <- if (type.checked) { 1u8 } else { 0u8 };
    return true
}

func stage_checked_here_contract(nodes:const ExprNodes in N, names:const NameBindings in B,
                                 selected:const SelectedExports in E,
                                     views:const SuppliedViews in V,
                                 row:ModuleInterfaceRow in R, callback:UInt64, failure:UInt64,
                                 defining_module:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner V, owner R} {
    ref contract = make HereContract {
        first_parameter <- no_node(); result_kind <- 0u8; result_module <- 0u64; result_identity <-
            0u64
    };
    if (!inspect_here_contract(views, callback, contract) ||
        row.result_kind != contract.result_kind)
        return false;
    if (contract.result_kind == enum_type()) {
        val module <- if (contract.result_module == 0u64) {
            defining_module
        } else { (contract.result_module) };
        if (module != row.type_module || contract.result_identity != row.type_identity) return false
    };
    return stage_checked_source_failure(nodes, names, selected, row, failure, defining_module,
                                        used, revision)
}

func stage_handle_interface(nodes:const ExprNodes in N, names:const NameBindings in B,
                            selected:const SelectedExports in E, work:const NameWork in W,
                            contracts:ModuleInterfaces in C, count:UInt64, defining_module:UInt64, marker:UInt64,
                            used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner B, const owner E, const owner W, owner C} {
    val constructor <- work[marker].active;
    val next <- stage_interface(nodes, names, selected, work, contracts, count, defining_module,
        marker, constructor, if (constructor == no_node()) { c_handle_type() }
            else { c_constructor() },
        no_node(), NoArrayRead, NoSourceWriter, false, false, used, revision);
    if (next == no_node()) return next;
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (inspect_declaration(nodes, revision, used, marker, declaration) != HandleTypeDeclaration) return no_node();
    contracts[count].name_first <- syntax_first(nodes, used, declaration.name);
    contracts[count].name_past <- syntax_past(nodes, used, declaration.name);
    val parent <- declaration.parent_type;
    if (parent != no_node()) {
        contracts[count].type_module <- type_module(names, selected, parent, defining_module);
        (contracts[count].type_identity <- type_identity(names, selected, parent)):void;
    } else {};
    if (constructor != no_node()) {
        ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
        ref failure = make UInt64 { no_node() };
        if (inspect_callable(nodes, revision, used, constructor, callable) != CProvider ||
            !find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause, failure))
            return no_node();
        if (failure != no_node()) {
            ref clause = make SignatureSites {
                previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
            };
            if (inspect_signature(nodes, revision, used, failure, clause) != ThrowsSignatureClause) return no_node();
            val type_name <- clause.annotation;
            contracts[count].failure_module <- type_module(names, selected, type_name, defining_module);
            (contracts[count].failure_identity <- type_identity(names, selected, type_name)):void;
        } else {};
    } else {};
    return next;
}

func stage_array_interface(names:const NameBindings in B, selected:const SelectedExports in E,
                           row:ModuleInterfaceRow in R, defining_module:UInt64, declaration:UInt64, index:UInt64, element:UInt64)
    where {const owner B, const owner E, owner R} {
    write_interface_header(row, defining_module, declaration, array_type(), 0u8, 0u64);
    val kind <- names[element].kind;
    if (kind == ordinary_selection()) {
        val selection <- imported_kind(names, selected, element);
        if (selection == record_export()) { (kind <- record_type()):void; };
        if (selection == sum_export()) { (kind <- sum_type()):void; };
        if (selection == enum_export()) { (kind <- enum_type()):void; };
    };
    row.array_index_kind <- names[index].kind;
    row.element_kind <- kind;
    if (kind == record_type() || kind == sum_type() || kind == enum_type()) {
        row.type_module <- type_module(names, selected, element, defining_module);
        (row.type_identity <- type_identity(names, selected, element)):void;
    };
    return;
}

# The checked declarations retain their identity even when their names are
# private. Only ModuleExports contributes names to another module's lookup.
# Every selectable member must have the independently proved length body.
# The family header identifies the exact interpretation published by this module.
func array_length_method_count(names:const NameBindings in B, work:const NameWork in W,
    views:const SuppliedViews in V, head:UInt64, used:UInt64) -> UInt64
    where {const owner B, const owner W, const owner V} {
    val count <- 0u64;
    val method <- head;
    for (unused in 0u64 .. used) {
        if (method == no_node()) return count;
        if (method >= used || names[method].declaration != head) return 0u64;
        case views[method] of {
            PreparedArrayLengthMethod -> {};
            _ -> { return 0u64 }
        };
        count <- count + 1u64;
        method <- work[method].next_method
    };
    return 0u64
}

func stage_array_length_family(names:const NameBindings in B, work:const NameWork in W,
    views:const SuppliedViews in V, head:UInt64, used:UInt64, defining_module:UInt64,
    contracts:ModuleInterfaces in C, first:UInt64) -> UInt64
    where {const owner B, const owner W, const owner V, owner C} {
    val count <- array_length_method_count(names, work, views, head, used);
    if (count == 0u64) return first;
    val limit <- intrinsic (len)(contracts);
    if (first >= limit || count >= limit - first) return no_node();
    write_interface_header(contracts[first], defining_module, head,
        array_length_family_interface(), builtin_u64(), count);
    contracts[first].owner_count <- 1u64;
    contracts[first].callable_kind <- CheckedFunction;
    contracts[first].membership <- FixedMethods;
    contracts[first].failure_identity <- no_node();
    val method <- head;
    val past <- first + 1u64 + count;
    for (row in first + 1u64 .. past) {
        case views[method] of {
            PreparedArrayLengthMethod { val module <- type_module, val identity <- type_identity, } -> {
                write_interface_header(contracts[row], defining_module, method, 0u8, 0u8, 0u64);
                contracts[row].value_kind <- array_type();
                contracts[row].type_module <- if (module == 0u64) { defining_module } else { module };
                contracts[row].type_identity <- identity;
                contracts[row].owner_role <- 0u64;
                contracts[row].target_readonly <- 1u8;
                contracts[row].owner_readonly <- 1u8;
                (contracts[row].field_mode <- ReferenceFormal):void
            };
            _ -> { return no_node() }
        };
        method <- work[method].next_method
    };
    return past
}

# A singleton ordinary procedure can carry checked scoped text behavior
# with scalar inputs, initialized readonly loans and explicit builders.
export func source_text_routine_signature(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in I,
    published:UInt64, aggregate:const AggregateFacts in A, definition:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner I, const owner A} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (names[definition].declaration != definition || work[definition].next_method != no_node() ||
        inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        callable.function_form || callable.body >= used) return false;
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val result <- owner_result_site(nodes, callable.signature, used, revision);
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause || clause.annotation >= used ||
        (names[clause.annotation].kind != builtin_bool() && names[clause.annotation].kind != builtin_void()) ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead) return false;
    ref start = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, start)) return false;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val parameter <- start;
    val marker <- no_node();
    val role <- no_node();
    val builder <- false;
    for (unused in 0u64 .. used) {
        if (parameter == no_node()) return true;
        marker <- independent_formal_type(nodes, parameter, used, revision);
        if (marker < used) {
            if (names[marker].kind != builtin_u8() && names[marker].kind != builtin_u64() &&
                names[marker].kind != builtin_bool()) return false;
        } else {
            if (formal_variadic_at(nodes, revision, used, parameter) != no_node() ||
                !typed_formal(nodes, revision, used, parameter, formal, binding) ||
                formal.mode != ReferenceFormal || binding.target_type >= used ||
                binding.owner_name >= used || names[binding.owner_name].kind != owner_binding()) return false;
            role <- names[binding.owner_name].declaration;
            if (role <= result || role > callable.signature ||
                inspect_signature(nodes, revision, used, role, clause) != OwnerSignatureClause ||
                binding.readonly != clause.readonly) return false;
            marker <- binding.target_type;
            builder <- is_lexical_builder(nodes, names, marker, revision, used);
            if (!builder && (!binding.readonly ||
                (names[marker].kind != builtin_string() && names[marker].kind != array_type() &&
                 imported_kind(names, selected, marker) != array_export() &&
                 (!describe_type(nodes, names, selected, marker, 0u64, revision, used, type) ||
                  !checked_bits_record(interfaces, published, aggregate, type))))) return false
        };
        (parameter <- work[parameter].next):void
    };
    return false
}

export data SourceTextMethodSites { formal:UInt64, body:UInt64, signature:UInt64, }

export func unary_text_method(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, definition:UInt64, used:UInt64, revision:UInt64, sites:SourceTextMethodSites in S)
    -> UInt64 where {const owner N, const owner B, const owner W, owner S} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    if (inspect_callable(nodes, revision, used, definition, callable) != ModuleCallable ||
        callable.function_form || callable.body == no_node()) return no_node();
    ref clause = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false
    };
    val role <- callable.signature;
    val shape <- inspect_signature(nodes, revision, used, role, clause);
    val borrowed <- shape == OwnerSignatureClause;
    if (borrowed && !clause.readonly) return no_node();
    val result <- if (borrowed) { (clause.previous) } else { role };
    if (inspect_signature(nodes, revision, used, result, clause) != ValueResultClause ||
        clause.annotation >= used || names[clause.annotation].kind != builtin_void() ||
        inspect_signature(nodes, revision, used, clause.previous, clause) != SignatureHead)
        return no_node();
    ref first = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, clause.parameter_tail, FormalSequence, first) ||
        first >= used || work[first].next != no_node()) return no_node();
    val marker <- if (borrowed) { readonly_formal_marker(nodes, names, first, role, used, revision) }
        else { independent_formal_type(nodes, first, used, revision) };
    if (marker >= used) return no_node();
    if (!borrowed && names[marker].kind != builtin_u64()) return no_node();
    if (borrowed && names[marker].kind != builtin_string() && !is_lexical_builder(nodes, names, marker, revision, used))
        return no_node();
    sites.formal <- first;
    sites.body <- callable.body;
    sites.signature <- callable.signature;
    return marker
}

data TextReceiverCandidate { definition:UInt64, module:UInt64, identity:UInt64, out_of_memory:bool, }

# Every represented writer has exact nominal input types. This profile
# retains a single concrete receiver for the given piece type. An additional
# match or incomplete method leaves dispatch pending.
func select_text_receiver(work:const NameWork in W, views:const SuppliedViews in V,
    writer:UInt64, string_piece:bool, piece_module:UInt64, piece_identity:UInt64,
    result:TextReceiverCandidate in C, used:UInt64) -> bool
    where {const owner W, const owner V, owner C} {
    val method <- writer;
    for (unused in 0u64 .. used) {
        if (method == no_node()) return result.definition != no_node();
        if (method >= used) return false;
        case views[method] of {
            CheckedTextWriterMethod {
                val target_module <-, val target_identity <-, val module <- piece_module,
                val identity <- piece_identity, val text <- string_piece, val out_of_memory <-,
            } -> {
                if (text == string_piece && (text || (module == piece_module && identity == piece_identity))) {
                    if (result.definition != no_node()) return false;
                    result.definition <- method;
                    result.module <- target_module;
                    result.identity <- target_identity;
                    (result.out_of_memory <- out_of_memory):void
                }
            };
            _ -> { return false }
        };
        (method <- work[method].next_method):void
    };
    return false
}

export data TextReceiverSite { operation:UInt64, receiver:UInt64, writer:UInt64, }

export func bind_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
    views:const SuppliedViews in V, sites:const SourceTextMethodSites in S, bound:TextReceiverSite in R,
    used:UInt64, revision:UInt64) -> bool where {const owner N, const owner B, const owner V, const owner S, owner R} {
    ref operation = make UInt64 { no_node() };
    if (!linear_void_body(nodes, revision, used, sites.body, operation) || operation == no_node()) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, operation, call) != DirectInvocationReady ||
        names[call.callee].kind != callable_binding()) return false;
    val writer <- names[call.callee].declaration;
    if (!prepared_text_writer(views, writer) ||
        inspect_sequence_entry(nodes, revision, used, call.arguments, entry) != ArgumentSequence ||
        checked_ref_argument(nodes, call.arguments) || names[entry.item].kind != formal_binding() ||
        names[entry.item].declaration != sites.formal) return false;
    val first <- entry.previous;
    if (inspect_sequence_entry(nodes, revision, used, first, entry) != ArgumentSequence ||
        entry.previous != no_node() || checked_ref_argument(nodes, first)) return false;
    val receiver <- entry.item;
    if (!(case views[receiver] of {
        BoundReferenceSymbol { val symbol_module <-, val symbol_identity <-, val target_module <-,
            val target_identity <-, val readonly <-, val nullable <-, } ->
                symbol_module != no_node() && symbol_identity != no_node() &&
                target_module != no_node() && target_identity != no_node() && !readonly && !nullable;
        _ -> false
    })) return false;
    bound.operation <- operation;
    bound.receiver <- receiver;
    bound.writer <- writer;
    return true
}

export func complete_text_receiver(work:const NameWork in W, views:const SuppliedViews in V,
    operation:UInt64, receiver:UInt64, writer:UInt64, string_piece:bool, piece_module:UInt64,
    piece_identity:UInt64, defining_module:UInt64, used:UInt64, result:InterfacePayload in P) -> void
    where {const owner W, const owner V, owner P} {
    ref candidate = make TextReceiverCandidate {
        definition <- no_node(); module <- 0u64; identity <- no_node(); out_of_memory <- false
    };
    val ready <- select_text_receiver(work, views, writer, string_piece, piece_module, piece_identity, candidate, used);
    val canonical_symbol <- 0u64;
    case views[receiver] of {
        BoundReferenceSymbol {
            val symbol_module <-, val symbol_identity <-, val target_module <-, val target_identity <-,
        } -> {
            canonical_symbol <- if (symbol_module == 0u64) { defining_module } else { symbol_module };
            if (ready) {
                (result <- make CheckedTextReceiver {
                    symbol_module <- canonical_symbol; symbol_identity <- symbol_identity;
                    receiver_module <- if (candidate.module == 0u64) { defining_module } else { (candidate.module) };
                    receiver_identity <- candidate.identity; out_of_memory <- candidate.out_of_memory;
                    invalid_slice <- false; numeric_fault <- false; bounds <- false
                }):void;
                return
            };
            (result <- make DeferredTextReceiver {
                operation <- operation; receiver <- receiver; writer <- writer;
                symbol_module <- canonical_symbol; symbol_identity <- symbol_identity;
                target_module <- if (target_module == 0u64) { defining_module } else { target_module };
                target_identity <- target_identity
            }):void
        };
        _ -> { (result <- make NoInterfacePayload {}):void }
    };
    return
}

export func prepared_formatting_method(views:const SuppliedViews in V, method:UInt64) -> bool where {const owner V} {
    return method < intrinsic (len)(views) && (case views[method] of { PreparedFormattingMethod -> true; _ -> false })
}

func stage_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:const SuppliedViews in V, sites:const SourceTextMethodSites in S,
    row:ModuleInterfaceRow in R, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner W, const owner V, const owner S, owner R} {
    ref bound = make TextReceiverSite { operation <- no_node(); receiver <- no_node(); writer <- no_node() };
    if (!bind_text_receiver(nodes, names, views, sites, bound, used, revision)) return;
    val piece_module <- if (row.type_module == row.defining_module) { 0u64 } else { (row.type_module) };
    complete_text_receiver(work, views, bound.operation, bound.receiver, bound.writer,
        row.value_kind == builtin_string(), piece_module, row.type_identity, row.defining_module, used, row.payload);
    return
}

# Keep the signature range private unless every member in the defining
# family fits. A pending dispatch carries no body completion.
func stage_source_text_family(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, views:const SuppliedViews in V, head:UInt64, used:UInt64,
    defining_module:UInt64, revision:UInt64, contracts:ModuleInterfaces in C, first:UInt64) -> UInt64
    where {const owner N, const owner B, const owner E, const owner W, const owner V, owner C} {
    if (first >= intrinsic (len)(contracts)) return no_node();
    val next <- first + 1u64;
    val method <- head;
    val marker <- no_node();
    val builder <- false;
    val numeric <- false;
    val has_numeric <- false;
    val complete <- true;
    ref sites = make SourceTextMethodSites { formal <- no_node(); body <- no_node(); signature <- no_node() };
    for (unused in 0u64 .. used) {
        if (method == no_node()) {
            if (has_numeric && !complete) return first;
            write_interface_header(contracts[first], defining_module, head,
                source_text_family_interface(), 0u8, next - first - 1u64);
            contracts[first].membership <- FixedMethods;
            (contracts[first].callable_kind <- CheckedProcedure):void;
            return next
        };
        if (method >= used || names[method].declaration != head) return first;
        marker <- unary_text_method(nodes, names, work, method, used, revision, sites);
        if (marker == no_node()) return first;
        builder <- is_lexical_builder(nodes, names, marker, revision, used);
        numeric <- names[marker].kind == builtin_u64();
        has_numeric <- has_numeric || numeric;
        complete <- complete && (case views[method] of { CompletedFormattingMethod -> true; _ -> false });
        if (numeric && !complete) return first;
        if (next >= intrinsic (len)(contracts)) return no_node();
        write_interface_header(contracts[next], defining_module, method, 0u8, builtin_void(), 0u64);
        contracts[next].value_kind <- if (numeric) { builtin_u64() }
            else { if (builder) { lexical_builder_type() } else { builtin_string() } };
        if (builder) {
            contracts[next].type_module <- type_module(names, selected, marker, defining_module);
            (contracts[next].type_identity <- type_identity(names, selected, marker)):void
        };
        if (!numeric) {
            contracts[next].field_mode <- ReferenceFormal;
            contracts[next].owner_role <- 0u64;
            contracts[next].target_readonly <- 1u8;
            (contracts[next].owner_readonly <- 1u8):void
        };
        case views[method] of {
            CompletedFormattingMethod {
                val symbol_module <-, val symbol_identity <-, val receiver_module <-, val receiver_identity <-,
                val out_of_memory <-, val invalid_slice <-, val numeric_fault <-,
            } -> {
                (contracts[next].payload <- make CheckedTextReceiver {
                    symbol_module <- symbol_module; symbol_identity <- symbol_identity;
                    receiver_module <- receiver_module; receiver_identity <- receiver_identity;
                    out_of_memory <- out_of_memory; invalid_slice <- invalid_slice; numeric_fault <- numeric_fault; bounds <- false
                }):void
            };
            _ -> { stage_text_receiver(nodes, names, work, views, sites, contracts[next], used, revision) }
        };
        method <- work[method].next_method;
        (next <- next + 1u64):void
    };
    return first
}

# Every visible member competes using its exact prepared signature.
# An unsupported member leaves this completed family unavailable.
func stage_text_writer_family(names:const NameBindings in B, work:const NameWork in W,
    views:const SuppliedViews in V, head:UInt64, used:UInt64, module:UInt64, function_form:bool,
    contracts:ModuleInterfaces in C, first:UInt64) -> UInt64
    where {const owner B, const owner W, const owner V, owner C} {
    if (!prepared_text_writer(views, head)) return first;
    if (first >= intrinsic (len)(contracts)) return no_node();
    val method <- head;
    val row <- first + 1u64;
    for (unused in 0u64 .. used) {
        if (method == no_node()) {
            write_interface_header(contracts[first], module, head, text_writer_family_interface(),
                builtin_void(), row - first - 1u64);
            contracts[first].membership <- FixedMethods;
            (contracts[first].callable_kind <- checked_callable_kind(function_form)):void;
            return row
        };
        if (method >= used || names[method].declaration != head) return first;
        case views[method] of {
            CheckedTextWriterMethod { val target_module <-, val target_identity <-, val piece_module <-,
                                      val piece_identity <-, val string_piece <-, val out_of_memory <-, } -> {
                if (row >= intrinsic (len)(contracts)) return no_node();
                write_interface_header(contracts[row], module, method, 0u8, builtin_void(), 0u64);
                contracts[row].value_kind <- if (string_piece) { builtin_string() } else { lexical_builder_type() };
                if (!string_piece) {
                    contracts[row].type_module <- if (piece_module == 0u64) { module } else { piece_module };
                    (contracts[row].type_identity <- piece_identity):void
                };
                (contracts[row].payload <- make CheckedTextWriter {
                    target_module <- if (target_module == 0u64) { module } else { target_module };
                    target_identity <- target_identity; out_of_memory <- out_of_memory
                }):void
            };
            _ -> { return first }
        };
        method <- work[method].next_method;
        (row <- row + 1u64):void
    };
    return first
}

export func publish_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B,
                               selected:const SelectedExports in E, work:const NameWork in W,
                               views:const SuppliedViews in V, routines:const ScopedRoutineContracts in H,
                               used:UInt64, revision:UInt64, defining_module:UInt64, start:UInt64, contracts:ModuleInterfaces in C,
                               report:NativeDeclarationResult in R) -> UInt64
    where {const owner N, const owner B, const owner E, const owner W, const owner V, const owner H, owner C,
        owner R} {
    val limit <- intrinsic (len)(contracts);
    val count <- start;
    val scoped_routine <- false;
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref failure = make UInt64 { no_node() };
    val kind <- 0u8;
    val shape <- InvalidDeclaration;
    val form <- InvalidCallable;
    val first <- 0u64;
    val ordinary <- false;
    val callback <- no_node();
    val source_handle <- false;
    val array_read_completion <- NoArrayRead;
    val source_writer <- NoSourceWriter;
    val scalar_source_body <- false;
    for (at in 0u64 .. used) {
        kind <- names[at].kind;
        shape <- inspect_declaration(nodes, revision, used, at, declaration);
        if (shape == ArrayTypeDeclaration) {
            if (count >= limit) return no_node();
            stage_array_interface(names, selected, contracts[count], defining_module, at,
                declaration.index_type, declaration.value_type);
            (count <- count + 1u64):void;
        } else {};
        if (shape == HandleTypeDeclaration && work[at].active == no_node()) {
            (count <- stage_handle_interface(nodes, names, selected, work, contracts, count,
                                             defining_module, at, used, revision)):void;
        } else {
            form <- inspect_callable(nodes, revision, used, at, callable);
            if (form == CProvider && kind == c_constructor()) {
                (count <- stage_handle_interface(nodes, names, selected, work, contracts, count,
                                                 defining_module, names[at].declaration, used, revision)):void;
            } else {
                ordinary <- form == ModuleCallable && kind == callable_binding() && names[at].declaration == at;
                if (ordinary &&
                    !find_signature_clause(nodes, revision, used, callable.signature,
                        ThrowsSignatureClause, failure)) return no_node();
                source_handle <- ordinary &&
                    source_handle_callable(nodes, names, selected, work, at, used, revision);
                callback <- if (ordinary && failure != no_node()) {
                    source_here_parameter(nodes, callable.signature, used, revision)
                } else { prepared_source_here_relay(views, at) };
                if (!has_array_slot_body(views, at) && (form == CProvider || form == CEntry ||
                    (ordinary && failure == no_node()) || callback != no_node() || source_handle ||
                    (form == ModuleCallablePromise && names[at].declaration == at))) {
                    first <- count;
                    if (ordinary && failure == no_node()) {
                        (count <- stage_array_length_family(names, work, views, at, used,
                            defining_module, contracts, count)):void
                    };
                    if (count == first && ordinary && failure == no_node()) {
                        (count <- stage_source_text_family(nodes, names, selected, work, views, at, used,
                            defining_module, revision, contracts, count)):void
                    };
                    if (count == first && ordinary && failure == no_node()) {
                        (count <- stage_text_writer_family(names, work, views, at, used, defining_module,
                            callable.function_form, contracts, first)):void
                    };
                    if (count == no_node()) return no_node();
                    if (count == first) {
                        array_read_completion <- published_array_read_completion(views, at);
                        if (prepared_byte_function(views, at, true) && array_read_completion == NoArrayRead) {
                            reject_declaration(report, at, invalid_native_parameter());
                            return no_node()
                        };
                        source_writer <- case views[at] of {
                            CheckedProductWriter -> ProductWriter;
                            CheckedAggregateWriter -> AggregateWriter;
                            CheckedParserWriter -> ParserWriter;
                            CheckedWorkspaceWriter -> WorkspaceWriter;
                            CheckedArrayInspector -> ArrayInspector;
                            _ -> NoSourceWriter
                        };
                        scalar_source_body <- case views[at] of {
                            CheckedScalarPredicate -> true;
                            CheckedScalarFunction -> true;
                            _ -> false
                        };
                        scoped_routine <- at < intrinsic (len)(routines) && (case routines[at] of {
                            CheckedTextReceiver -> true;
                            CheckedLocalTextRoutine -> true;
                            _ -> false
                        });
                        (count <- stage_interface(nodes, names, selected, work, contracts, count, defining_module,
                            at, at, kind, callback, array_read_completion, source_writer, scalar_source_body, scoped_routine,
                            used, revision)):void;
                        if (count != no_node()) {
                            if (scoped_routine) { (contracts[first].payload <- routines[at]):void };
                            case views[at] of {
                                CheckedScalarFunction { val numeric_fault <-, } -> {
                                    (contracts[first].source_numeric_fault <- numeric_fault):void
                                };
                                CheckedReadonlyReader { val numeric_fault <-, } -> {
                                    (contracts[first].source_numeric_fault <- numeric_fault):void
                                };
                                CheckedArrayProcedure { val numeric_fault <-, val allocates <-, } -> {
                                    contracts[first].source_numeric_fault <- numeric_fault;
                                    contracts[first].array_slot_failures.out_of_memory <- allocates;
                                    contracts[first].array_slot_failures.region_capacity <- allocates;
                                    (contracts[first].array_slot_failures.invalid_capacity <- allocates):void
                                };
                                CheckedProductWriter { val numeric_fault <-, } -> {
                                    (contracts[first].source_numeric_fault <- numeric_fault):void
                                };
                                CheckedAggregateWriter { val numeric_fault <-, } -> {
                                    (contracts[first].source_numeric_fault <- numeric_fault):void
                                };
                                CheckedArrayInspector { val numeric_fault <-, val allocates <-, } -> {
                                    contracts[first].source_numeric_fault <- numeric_fault;
                                    contracts[first].array_slot_failures.out_of_memory <- allocates;
                                    contracts[first].array_slot_failures.region_capacity <- allocates;
                                    (contracts[first].array_slot_failures.invalid_capacity <- allocates):void
                                };
                                CheckedWorkspaceWriter { val numeric_fault <-, val allocates <-, } -> {
                                    contracts[first].source_numeric_fault <- numeric_fault;
                                    contracts[first].array_slot_failures.out_of_memory <- allocates;
                                    contracts[first].array_slot_failures.region_capacity <- allocates;
                                    (contracts[first].array_slot_failures.invalid_capacity <- allocates):void
                                };
                                CheckedParserWriter { val numeric_fault <-, } -> {
                                    (contracts[first].source_numeric_fault <- numeric_fault):void
                                };
                                _ -> {}
                            }
                        };
                        if (callback != no_node() && (count == no_node() ||
                            !stage_checked_here_contract(nodes, names, selected, views,
                                contracts[first],
                                                         callback, failure, defining_module,
                                                         used, revision))) {
                            reject_declaration(report, at, unproved_imported_here_signature());
                            return no_node()
                        };
                        if (source_handle && (count == no_node() ||
                            !stage_checked_source_failure(nodes, names, selected, contracts[first],
                                failure, defining_module, used, revision))) {
                            reject_declaration(report, at, invalid_native_failure());
                            return no_node()
                        }
                    }
                } else {};
            };
        };
        if (count == no_node()) return count;
    };
    return count;
}

func publish_selection(selected:const SelectedExports in E, site:UInt64,
                       exports:ModuleExports in X, at:UInt64) -> bool
    where {const owner E, owner X} {
    exports[at].origin_module <- selected[site].origin_module;
    exports[at].identity <- selected[site].identity;
    exports[at].kind <- selected[site].kind;
    exports[at].checked <- selected[site].checked;
    exports[at].owner_module <- selected[site].owner_module;
    exports[at].owner_identity <- selected[site].owner_identity;
    exports[at].shape <- selected[site].shape;
    return selected[site].kind != 0u8;
}

func publish_declaration(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                         facts:const AggregateFacts in F,
                         publication:const ModulePublication in P, name:UInt64, exports:ModuleExports in X, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner F, const owner P, owner X} {
    val target <- names[name].declaration;
    val kind <- names[name].kind;
    exports[at].origin_module <- publication.module_identity;
    exports[at].identity <- target;
    exports[at].checked <- 0u8;
    exports[at].owner_module <- 0u64;
    exports[at].owner_identity <- 0u64;
    (exports[at].shape <- 0u8):void;
    if (kind == ordinary_selection() || kind == symbolic_selection())
        return publish_selection(selected, target, exports, at);
    if (kind == generic_product_binding()) {
        exports[at].kind <- generic_product_export();
        return true
    };
    if (kind == callable_binding() && target < used && names[target].kind == generic_method_binding()) {
        exports[at].kind <- generic_callable_export();
        return true
    };
    if (builtin_type_kind(kind)) {
        exports[at].kind <- scalar_type_export();
        exports[at].origin_module <- 0u64;
        exports[at].identity <- kind;
        (exports[at].shape <- kind):void;
        return true
    };
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- inspect_declaration(nodes, revision, used, target, declaration);
    if (kind == native_symbol_binding()) {
        if (shape != NativeSymbolDeclaration) return false;
        val marker <- declaration.value_type;
        exports[at].kind <- symbol_export();
        exports[at].shape <- owning_handle();
        exports[at].owner_module <- type_module(names, selected, marker, publication.module_identity);
        exports[at].owner_identity <- type_identity(names, selected, marker);
        return true;
    } else {};
    if (kind == sum_type()) {
        if (shape != NominalSum) return false;
        val sum_storage <- facts[target];
        if (sum_storage != CoDBitsAggregate && sum_storage != NonBitsAggregate) return false;
        exports[at].shape <- aggregate_export_shape(sum_storage, false);
        exports[at].kind <- sum_export();
        return true;
    };
    if (kind == reference_symbol_binding()) {
        if (shape != ReferenceSymbolDeclaration) return false;
        val type <- declaration.value_type;
        exports[at].kind <- symbol_export();
        exports[at].shape <- reference_symbol_shape(declaration.nullable, declaration.readonly);
        exports[at].owner_module <- type_module(names, selected, type, publication.module_identity);
        exports[at].owner_identity <- type_identity(names, selected, type);
        return true;
    };
    if (kind == c_handle_type()) {
        ref root = make NativeOwnerType { origin <- 0u64; identity <- 0u64; };
        if (!handle_owner(nodes, names, selected, name, root, used, revision)) return false;
        exports[at].kind <- native_handle_export();
        exports[at].shape <- if (is_owning_handle(nodes, names, selected, name, used, revision)) { owning_handle() } else { child_handle() };
        if (root.origin == 0u64) {
            (exports[at].owner_module <- publication.module_identity):void;
        } else {
            (exports[at].owner_module <- root.origin):void;
        };
        exports[at].owner_identity <- root.identity;
        return true;
    } else {};
    if (kind == abstract_type_binding()) {
        exports[at].kind <- abstract_type_export();
        return true;
    };
    if (kind == record_type()) {
        if (shape != NominalRecord && shape != NativeRecord) return false;
        if (lexical_builder_record(nodes, names, target, revision, used)) {
            exports[at].kind <- lexical_builder_export();
            return true;
        };
        if (has_exception_parent(nodes, names, target, revision, used)) {
            exports[at].kind <- nominal_exception_export();
            val parent <- declaration.parent_type;
            exports[at].checked <- if (selected[names[parent].declaration].identity == error_root_identity()) { 0u8 } else { 1u8 };
            if (scalar_failure(nodes, names, selected, name, used, revision)) { (exports[at].shape <- scalar_exception()):void; } else {};
        } else {
            exports[at].kind <- record_export();
            val record_storage <- facts[target];
            if (record_storage == UnprovedAggregate) return false;
            (exports[at].shape <- aggregate_export_shape(record_storage, record_storage == CLayoutBitsRecord &&
                declaration.entries != no_node() && uses_direct_scalars(nodes, names, declaration.entries, true, used, revision))):void;
        };
        return true;
    } else {};
    if (kind == array_type()) {
        exports[at].kind <- array_export();
        exports[at].shape <- array_shape(nodes, names, selected, target, used, revision);
        return true;
    } else {};
    if (kind == enum_type()) {
        if (shape != EnumTypeDeclaration) return false;
        exports[at].kind <- enum_export();
        exports[at].shape <- names[declaration.value_type].kind;
        return true;
    } else {};
    if (kind == callable_binding()) {
        exports[at].kind <- callable_export();
        exports[at].shape <- ordinary_callable_shape();
        ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form
            <- false; };
        ref failure = make UInt64 { no_node() };
        if (inspect_callable(nodes, revision, used, target, callable) != ModuleCallable ||
            !find_signature_clause(nodes, revision, used, callable.signature, ThrowsSignatureClause,
                failure)) return false;
        exports[at].checked <- if (failure == no_node()) { 0u8 } else { 1u8 };
        return true;
    };
    if (kind == c_operation() || kind == c_entry()) {
        exports[at].kind <- callable_export();
        return true;
    } else {};
    return false;
}

func local_symbol_spelling(source:const SourceBytes in S, nodes:const ExprNodes in N,
    revision:UInt64, used:UInt64, declaration:UInt64, first:UInt64, past:UInt64)
    -> bool where {const owner S, const owner N} {
    val defining <- definition_name(nodes, revision, used, declaration);
    if (defining >= used || name_syntax(nodes, used, defining) != SymbolicName) return false;
    val defining_first <- syntax_first(nodes, used, defining);
    val defining_past <- syntax_past(nodes, used, defining);
    return defining_first < defining_past && defining_past <= intrinsic (len)(source) &&
        same_bytes(source, first, past, source, defining_first + 1u64, defining_past)
}

# Append explicit exports after successful binding. The caller holds the
# checked source bytes in the catalog and lends only the committed prefix.
# A re-export changes spelling and preserves the original definition.
export func publish_module_exports(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                   names:const NameBindings in B, selected:const SelectedExports in E,
                                   selections:const CheckedSelections in T,
                                   catalog:const SourceBytes in K, graph:const SourceBytes in G,
                                   facts:const AggregateFacts in F,
                                   publication:const ModulePublication in P, used:UInt64, revision:UInt64, exports:ModuleExports in X,
                                   spellings:StagedExportNames in X, uses:StagedExportUses in X,
                                   views:const CallableUseProofs in V,
                                   count:UInt64 in C, conflict:UInt64 in C) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner T,
           const owner K, const owner G, const owner F, const owner P, const owner V, owner X, owner C} {
    conflict <- no_node();
    if (publication.module_identity == 0u64 || publication.module_identity == no_node() ||
        used > intrinsic (len)(nodes) ||
        used > intrinsic (len)(names) || used > intrinsic (len)(selected) || used > intrinsic (len)(facts) ||
        count > intrinsic (len)(exports) || intrinsic (len)(spellings) != intrinsic (len)(exports) ||
        intrinsic (len)(uses) != intrinsic (len)(exports) ||
        publication.selection_count > intrinsic (len)(selections) ||
        publication.graph_spelling_count > intrinsic (len)(graph))
        return false;
    val next <- count;
    val name <- no_node();
    val selection <- false;
    val first <- 0u64;
    val past <- 0u64;
    val prior <- no_node();
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref resource = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource; nature <- OrdinaryResource;
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    val expanded <- OtherSelectionSyntax;
    for (at in 0u64 .. used) {
        name <- no_node();
        selection <- inspect_module_selection(nodes, revision, used, at, resource) == SelectionReady &&
            resource.mode == ReexportResource;
        if (selection) {
            (name <- resource.local):void;
        } else {
            if (inspect_declaration(nodes, revision, used, at, declaration) == LocalPublication) {
                (name <- declaration.name):void;
            } else {};
            if (module_item_publication(nodes, used, at)) {
                if (inspect_sequence_entry(nodes, revision, used, at, entry) != ModuleSequence) return false;
                expanded <- inspect_bulk_selection(nodes, revision, used, entry.item, bulk);
                if (expanded == InvalidSelection) return false;
                if (expanded == SelectionReady) {
                    if (bulk.mode != ImportResource ||
                        !append_public_imports(source, catalog, graph, selections, publication, revision,
                                               entry.item, exports, spellings, uses, views, count, next)) {
                        conflict <- entry.item;
                        return false
                    }
                } else {
                    (name <- if (inspect_module_selection(nodes, revision, used, entry.item, resource) == SelectionReady &&
                                 resource.mode == ImportResource) {
                        resource.local
                    } else { definition_name(nodes, revision, used, entry.item) }):void
                }
            } else {};
        };
        if (name != no_node()) {
            past <- syntax_past(nodes, used, name);
            if (next == intrinsic (len)(exports) || past > intrinsic (len)(source)) return false;
            if (selection) {
                if (!publish_selection(selected, at, exports, next)) return false;
                (uses[next] <- selected[at].checked_resource):void
            } else {
                if (!publish_declaration(nodes, names, selected, facts, publication, name, exports, next, used, revision)) return false;
                if (names[name].kind == ordinary_selection() || names[name].kind == symbolic_selection()) {
                    if (names[name].declaration >= used) return false;
                    (uses[next] <- selected[names[name].declaration].checked_resource):void
                } else { (uses[next] <- no_node()):void }
            };
            first <- syntax_first(nodes, used, name) + if (name_syntax(nodes, used, name) == SymbolicName) { 1u64 } else { 0u64 };
            if (first >= past) return false;
            if (exports[next].kind == symbol_export() && exports[next].origin_module == publication.module_identity &&
                !local_symbol_spelling(source, nodes, revision, used, exports[next].identity, first, past)) {
                conflict <- name;
                return false
            };
            remember_source_export_name(spellings, next, first, past);
            prior <- previous_public_name(source, catalog, graph, publication.graph_spelling_count,
                spellings, count, next);
            if (prior != no_node() && !same_public_identity(exports, uses, views, revision, prior, next)) {
                conflict <- name;
                return false;
            } else {};
            exports[next].publishing_module <- publication.module_identity;
            exports[next].module_first <- 0u64;
            exports[next].module_past <- 0u64;
            exports[next].name_first <- first;
            exports[next].name_past <- past;
            if (prior == no_node()) { (next <- next + 1u64):void; } else {};
        } else {};
    };
    count <- next;
    return true;
}

func remember_source_export_name(spellings:StagedExportNames in R, at:UInt64, first:UInt64, past:UInt64)
    -> void where {owner R} {
    spellings[at] <- make SourceSpelling { span <- make SourceSpan { first <- first; past <- past } };
    return
}

func remember_graph_export_name(spellings:StagedExportNames in R, at:UInt64, first:UInt64, past:UInt64)
    -> void where {owner R} {
    spellings[at] <- make GraphSpelling { span <- make SourceSpan { first <- first; past <- past } };
    return
}

func same_public_identity(exports:const ModuleExports in E, uses:const StagedExportUses in E,
    views:const CallableUseProofs in V, revision:UInt64, before:UInt64, after:UInt64)
    -> bool where {const owner E, const owner V} {
    return exports[before].origin_module == exports[after].origin_module &&
        exports[before].kind == exports[after].kind && exports[before].identity == exports[after].identity &&
        checked_callable_context(views, uses[before], revision) ==
            checked_callable_context(views, uses[after], revision)
}

func previous_public_name(source:const SourceBytes in S, catalog:const SourceBytes in B,
    graph:const SourceBytes in G, graph_used:UInt64, spellings:const StagedExportNames in E,
    start:UInt64, limit:UInt64) -> UInt64 where {const owner S, const owner B, const owner G, const owner E} {
    for (at in start .. limit) {
        if (same_selection_spelling(spellings[at], spellings[limit], source, catalog, graph, graph_used))
            return at;
    };
    return no_node();
}

func append_public_imports(source:const SourceBytes in S, catalog:const SourceBytes in B,
    graph:const SourceBytes in G, selections:const CheckedSelections in T,
    publication:const ModulePublication in P, revision:UInt64, directive:UInt64,
    exports:ModuleExports in X, spellings:StagedExportNames in X, uses:StagedExportUses in X,
    views:const CallableUseProofs in V, start:UInt64, next:UInt64 in C)
    -> bool where {const owner S, const owner B, const owner G, const owner T, const owner P,
                   const owner V, owner X, owner C} {
    val previous <- no_node();
    val site <- no_node();
    for (row in 0u64 .. publication.selection_count) {
        site <- checked_selection_site(selections, publication.selection_count, row, revision);
        if (site == no_node()) return false;
        if (site == directive) {
            if (next >= intrinsic (len)(exports) ||
                !project_public_import(selections, publication.selection_count, row, revision,
                    directive, publication.graph_spelling_count, publication.module_identity,
                    exports[next])) return false;
            remember_graph_export_name(spellings, next, exports[next].name_first, exports[next].name_past);
            uses[next] <- row;
            previous <- previous_public_name(source, catalog, graph, publication.graph_spelling_count,
                spellings, start, next);
            if (previous != no_node() &&
                !same_public_identity(exports, uses, views, revision, previous, next)) return false;
            if (previous == no_node()) { (next <- next + 1u64):void }
        }
    };
    return true
}
