using "./Deque.cod" { deque, push_back, pop_back };
using "./ParserStorage.cod" {
    ExprNodes, no_node, CallableSites, module_item_publication,
    DeclarationSites, inspect_declaration, DeclarationSyntax { LocalPublication }, inspect_callable, find_signature_clause, omits_callable_result,
    DirectCallSites, inspect_invocation, InvocationSyntax { InvalidCallSyntax, OrdinaryInvocation, EffectfulInvocation },
    ScopedProcedureSites, inspect_scoped_procedure, NamedThrowSites, inspect_named_throw,
    first_sequence_entry, inspect_sequence_entry, SequenceEntry, SequenceSyntax { ArgumentSequence, ModuleSequence },
    module_tail, AssignmentSites, inspect_assignment, predicate_operand, formal_binding_is_fixed,
    FormalSites, inspect_formal, FormalSyntax { OrdinaryFormal }, FormalMode { ExplicitValueFormal, ReferenceFormal },
    LocalBindingSites, inspect_local_binding, LocalMode { ValueLocal, ReferenceLocal },
    AssignmentSyntax { PlaceTransfer, FieldTransfer, InvalidAssignment },
};
using "./ParserStorage.cod" CallableSyntax { ModuleCallable, LexicalCallable, CEntry };
using "./ParserStorage.cod" SignatureSyntax { ThrowsSignatureClause };
using "./ParserStorage.cod" { case_pattern, CasePatternSyntax { ReferenceCaseTarget } };
using "./NameResolution.cod" {
    NameBindings, NameWork, enclosing_callable, callable_binding, local_binding, formal_binding, record_type,
    uninstantiated_method, procedure_symbol_binding
};
using "./ExceptionPayload.cod" { CaughtFieldUses, CaughtFieldUse { CaughtField } };
using "./ExceptionTypes.cod" ExceptionType;
using "./NativeDeclarations.cod" {
    SuppliedViews, SuppliedView { PreparedFormattingMethod, ImportedSourceTextCall, ImportedTextWriterCall, PreparedGenericConstruction, BoundGenericCall, ImportedProductWriter, CheckedImportedArraySlotCall, CheckedArrayCall, CheckedReadonlyCall, CheckedSumWriterCall, CheckedWorkspaceWriterCall, CheckedScalarFunctionCall }, read_acquisition_failure,
    source_text_routine_signature, native_loan_requires_body, source_handle_callable, prepared_array_procedure, prepared_text_writer,
    prepared_source_here_relay, SourceArrayFormals { NoSourceArrayFormal, ArrayReferenceSlotFormal },
    prepared_byte_function, prepared_array_construction, prepared_array_signature, readonly_reader_needs_body, prepared_product_writer, prepared_scalar_predicate, prepared_scalar_function, prepared_aggregate_writer, prepared_readonly_query, prepared_parser_writer, prepared_workspace_writer, prepared_array_inspector
};
using "./ModuleExports.cod" SelectedExports;
using "./ModuleExportStorage.cod" { ModuleInterfaces, sum_type, enum_type };
using "./AggregateSchemas.cod" AggregateFacts;
using "./ModuleExportStorage.cod" ArrayReadCompletion { NoArrayRead };
using "./CaseSchemas.cod" { ConstructorCaseFacts, ConstructorCaseFact { CaseFieldReceipt, CaseProductField, InlineProductFormal, ArrayFieldRecordFormal, InlineProductField, BitsConstruction, IndexedAggregateDestination, IndexedAggregateLoan, LexicalProductReference, LexicalSumReference, FreshSumInvocation, ProductLoanInvocation, ImportedFreshSumInvocation, SumValueResult } };

export data DeclarationDemand {
    scope:UInt64,
    first_call:UInt64,
    next_call:UInt64,
    callee:UInt64,
    pending:UInt64,
    receipt_pending:UInt64,
    declared_failure:UInt64,
    receipt_body:bool,
    product_body_dependency:bool,
    mixed_aggregate_loan:bool,
    slot_body:bool,
    fixed_borrow:bool,
    text_call:bool,
    public_text_routine:bool,
    requires_byte_completion:bool,
    signature:bool,
    body:bool,
}
export array DeclarationDemands[UInt64]:DeclarationDemand;

export func needs_body_check(demand:const DeclarationDemands in D, at:UInt64) -> bool
    where {const owner D} {
    val extent <- intrinsic (len)(demand);
    if (extent == 0u64) return true;
    if (at >= extent) return false;
    if (demand[at].body) return true;
    val scope <- demand[at].scope;
    return scope < extent && demand[scope].body
}

export func needs_signature_check(demand:const DeclarationDemands in D, at:UInt64) -> bool
    where {const owner D} {
    val extent <- intrinsic (len)(demand);
    return extent == 0u64 || (at < extent && demand[at].signature)
}

func selects_caught_field(fields:const CaughtFieldUses in F, at:UInt64) -> bool where {const owner F} {
    if (at >= intrinsic (len)(fields)) return false;
    return case fields[at] of {
        CaughtField -> true;
        _ -> false
    }
}

func require_body(demand:DeclarationDemands in D, definition:UInt64, count:UInt64 in Q, used:UInt64,
                  signature:bool) -> bool
    where {owner D, owner Q} {
    if (definition >= used) return false;
    if (demand[definition].body) return true;
    if (count >= used) return false;
    demand[definition].signature <- signature;
    demand[definition].body <- true;
    demand[count].pending <- definition;
    count <- count + 1u64;
    return true
}

func require_capture_context(nodes:const ExprNodes in N, names:const NameBindings in B,
    demand:DeclarationDemands in D, first:UInt64, root:UInt64, used:UInt64, count:UInt64 in Q)
    -> bool where {const owner N, const owner B, owner D, owner Q} {
    val scope <- first;
    for (unused in 0u64 .. used) {
        if (scope == no_node()) return true;
        if (!require_body(demand, scope, count, used, scope != root)) return false;
        if (scope == root) return true;
        (scope <- enclosing_callable(nodes, names, names[scope].scope)):void
    };
    return false
}

func require_receipt_body(demand:DeclarationDemands in D, definition:UInt64, body_count:UInt64 in B,
    receipt_count:UInt64 in R, used:UInt64) -> bool where {owner D, owner B, owner R} {
    if (definition >= used) return false;
    if (demand[definition].receipt_body) return true;
    if (receipt_count >= used || !require_body(demand, definition, body_count, used, true)) return false;
    demand[definition].receipt_body <- true;
    demand[receipt_count].receipt_pending <- definition;
    receipt_count <- receipt_count + 1u64;
    return true
}

func local_body(nodes:const ExprNodes in N, revision:UInt64, used:UInt64, definition:UInt64,
                         sites:CallableSites in S) -> bool where {const owner N, owner S} {
    val form <- inspect_callable(nodes, revision, used, definition, sites);
    return form == ModuleCallable || form == LexicalCallable || form == CEntry
}

func family_needs_checked_operands(links:const NameWork in W, demand:const DeclarationDemands in D,
                                    head:UInt64, used:UInt64) -> bool where {const owner W, const owner D} {
    val definition <- head;
    for (unused in 0u64 .. used) {
        if (definition == no_node()) return false;
        if (definition >= used || demand[definition].declared_failure != no_node() ||
            links[definition].sum_loan_formals || demand[definition].slot_body || demand[definition].fixed_borrow) return true;
        (definition <- links[definition].next_method):void
    };
    return true
}

func collect_aggregate_loan_demand(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in W, cases:const ConstructorCaseFacts in C, tail:UInt64, used:UInt64,
    revision:UInt64, mixed_aggregate:bool in P) -> bool
    where {const owner N, const owner B, const owner W, const owner C, owner P} {
    mixed_aggregate <- false;
    if (intrinsic (len)(cases) == 0u64) return false;
    ref argument = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, ArgumentSequence, argument)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val receipt <- no_node();
    val needs_receipt <- false;
    for (unused in 0u64 .. used) {
        if (argument >= used || inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence)
            return false;
        if (entry.item < intrinsic (len)(cases)) {
            case cases[entry.item] of {
                # Check the body for writable indexed loans, including when
                # the array schema came from a published dependency.
                IndexedAggregateLoan { val consumer <-, val array_module <-, val writable <-, } -> {
                    if (consumer == argument && (array_module == 0u64 || writable)) { (needs_receipt <- true):void }
                };
                InlineProductField { val type <- value_type, } -> {
                    if (type.kind == record_type()) { (mixed_aggregate <- true):void }
                };
                CaseProductField { val type <- value_type, } -> {
                    if (type.kind == record_type()) { (mixed_aggregate <- true):void }
                };
                _ -> {}
            }
        };
        if (names[entry.item].kind == formal_binding()) {
            receipt <- names[entry.item].declaration;
            if (receipt < intrinsic (len)(cases)) {
                case cases[receipt] of {
                    InlineProductFormal { val readonly <-, val demand_on_use <-, } -> {
                        if (!readonly && demand_on_use) { (needs_receipt <- true):void }
                    };
                    ArrayFieldRecordFormal -> {
                        mixed_aggregate <- true;
                        (needs_receipt <- true):void
                    };
                    _ -> {}
                }
            }
        };
        if (names[entry.item].kind == local_binding()) {
            receipt <- names[entry.item].declaration;
            if (receipt < entry.item && receipt < intrinsic (len)(cases)) {
                case cases[receipt] of {
                    LexicalProductReference -> { (mixed_aggregate <- true):void };
                    CaseFieldReceipt { val type <- value_type, } -> {
                        if (type.kind == record_type() || type.kind == sum_type()) {
                            mixed_aggregate <- true;
                            (needs_receipt <- true):void
                        }
                    };
                    _ -> {}
                }
            }
        };
        if (argument == tail || links[argument].next <= argument) return needs_receipt;
        (argument <- links[argument].next):void
    };
    return false
}

func require_transfer_signatures(links:const NameWork in W, demand:DeclarationDemands in D,
                                 head:UInt64, used:UInt64) -> bool where {const owner W, owner D} {
    val definition <- head;
    for (unused in 0u64 .. used) {
        if (definition == no_node()) return true;
        if (definition >= used) return false;
        demand[definition].signature <- true;
        (definition <- links[definition].next_method):void
    };
    return definition == no_node()
}

func require_called_contracts(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in W, demand:DeclarationDemands in D,
    scope:UInt64, revision:UInt64, used:UInt64, count:UInt64 in Q, receipt_count:UInt64 in R,
    prove_loans:bool) -> UInt64 where {const owner N, const owner B, const owner W,
        owner D, owner Q, owner R} {
    ref sites = make CallableSites {
        signature <- no_node(); body <- no_node(); function_form <- false;
    };
    val call <- demand[scope].first_call;
    val definition <- no_node();
    val form <- CEntry;
    for (unused in 0u64 .. used) {
        if (call == no_node()) return no_node();
        definition <- demand[call].callee;
        if (definition >= used) return call;
        form <- inspect_callable(nodes, revision, used, definition, sites);
        if (form != ModuleCallable && form != LexicalCallable && form != CEntry) return call;
        demand[definition].signature <- true;
        # Assignment and initializer policies bind the family on the use itself.
        if (names[call].kind == callable_binding() &&
            !require_transfer_signatures(links, demand, definition, used)) return call;
        if (prove_loans) {
            if (!require_receipt_body(demand, definition, count, receipt_count, used)) return call
        } else {
            if ((demand[call].product_body_dependency || form == LexicalCallable ||
                (form == ModuleCallable && sites.function_form && links[definition].next_method == no_node() &&
                    names[definition].declaration == definition && links[definition].active == no_node() &&
                    omits_callable_result(nodes, revision, used, sites.signature))) &&
                !require_body(demand, definition, count, used, true)) return call
        };
        (call <- demand[call].next_call):void
    };
    return call
}

# The enum interface still consumes the restricted byte completion.
# Follow its bound source edges without demanding that proof of unrelated Bool readers.
func require_byte_completions(views:const SuppliedViews in V, demand:DeclarationDemands in D,
    used:UInt64, count:UInt64 in Q) -> UInt64 where {const owner V, owner D, owner Q} {
    ref pending = make deque[UInt64]();
    for (definition in 0u64 .. used) {
        if (prepared_byte_function(views, definition, true)) {
            demand[definition].requires_byte_completion <- true;
            push_back(pending, definition)
        }
    };
    val call <- no_node();
    val definition <- no_node();
    # One step takes a pending definition or advances a bound call edge.
    for (step in 0u64 .. used + used) {
        if (call == no_node()) {
            case pop_back(pending) of {
                (null) -> { return no_node(); };
                (ref caller:UInt64 in here) -> { (call <- demand[caller].first_call):void; };
            }
        } else {
            definition <- demand[call].callee;
            if (prepared_byte_function(views, definition, false) && !demand[definition].requires_byte_completion) {
                if (!require_body(demand, definition, count, used, true)) return call;
                demand[definition].requires_byte_completion <- true;
                push_back(pending, definition)
            };
            (call <- demand[call].next_call):void
        }
    };
    return no_node()
}

data TextBodyDemand {
    first_use:UInt64, next_use:UInt64, pending:UInt64, seen:bool, family_seen:bool,
}
array TextBodyDemands[UInt64]:TextBodyDemand;

func text_call_profile(views:const SuppliedViews in V, at:UInt64) -> bool where {const owner V} {
    return at < intrinsic (len)(views) && (case views[at] of {
        ImportedSourceTextCall -> true;
        ImportedTextWriterCall -> true;
        _ -> false
    })
}

func first_text_use(views:const SuppliedViews in V, used:UInt64) -> UInt64 where {const owner V} {
    for (at in 0u64 .. used) {
        if (text_call_profile(views, at)) return at
    };
    return no_node()
}

func request_text_body(rows:TextBodyDemands in X, definition:UInt64, count:UInt64 in Q) -> void
    where {owner X, owner Q} {
    if (!rows[definition].seen) {
        rows[definition].seen <- true;
        rows[count].pending <- definition;
        (count <- count + 1u64):void
    };
    return
}

export func published_local_family(nodes:const ExprNodes in N, names:const NameBindings in B, at:UInt64,
    used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner B} {
    if (!module_item_publication(nodes, used, at)) return no_node();
    ref item = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (inspect_sequence_entry(nodes, revision, used, at, item) != ModuleSequence) return no_node();
    val member <- item.item;
    if (names[member].kind == callable_binding()) return names[member].declaration;
    ref declared = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    if (inspect_declaration(nodes, revision, used, member, declared) == LocalPublication &&
        declared.name < used && names[declared.name].kind == callable_binding())
        return names[declared.name].declaration;
    return no_node()
}

# Demand the ordinary callers of prepared text calls so published routines
# can describe their completion. Only bound direct family edges participate.
func require_text_callers(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, links:const NameWork in L, views:const SuppliedViews in V,
    interfaces:const ModuleInterfaces in I, published:UInt64, aggregate:const AggregateFacts in A,
    demand:DeclarationDemands in D, root:UInt64, used:UInt64, revision:UInt64,
    body_count:UInt64 in Q, receipt_count:UInt64 in R) -> UInt64
    where {const owner N, const owner B, const owner E, const owner L, const owner V, const owner I, const owner A,
        owner D, owner Q, owner R} {
    val first <- first_text_use(views, used);
    if (first == no_node()) return no_node();
    if (used > 9223372036854775807u64) return first;
    ref rows = make TextBodyDemands(used, make TextBodyDemand {
        first_use <- no_node(); next_use <- no_node(); pending <- no_node(); seen <- false; family_seen <- false
    });
    ref count = make UInt64 { 0u64 };
    val callee <- no_node();
    val scope <- no_node();
    for (at in 0u64 .. used) {
        callee <- published_local_family(nodes, names, at, used, revision);
        if (callee < used && source_text_routine_signature(nodes, names, selected, links,
            interfaces, published, aggregate, callee, used, revision)) {
            (demand[callee].public_text_routine <- true):void
        };
        scope <- demand[at].scope;
        callee <- demand[at].callee;
        if (scope < used && !uninstantiated_method(names[scope].kind)) {
            if (callee < used) {
                rows[at].next_use <- rows[callee].first_use;
                (rows[callee].first_use <- at):void
            };
            if (at >= first && text_call_profile(views, at)) { request_text_body(rows, scope, count) }
        }
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val body <- no_node();
    val head <- no_node();
    val use <- no_node();
    val item <- 0u64;
    for (step in 0u64 .. used + used) {
        if (use == no_node()) {
            if (item == count) return no_node();
            body <- rows[item].pending;
            item <- item + 1u64;
            if (body != root && !local_body(nodes, revision, used, body, callable)) return body;
            if (demand[body].public_text_routine) {
                if (!require_receipt_body(demand, body, body_count, receipt_count, used)) return body
            } else {
                if (!require_body(demand, body, body_count, used, body != root)) return body
            };
            head <- names[body].declaration;
            if (head < used && !rows[head].family_seen) {
                rows[head].family_seen <- true;
                (use <- rows[head].first_use):void
            }
        } else {
            demand[use].text_call <- true;
            request_text_body(rows, demand[use].scope, count);
            (use <- rows[use].next_use):void
        }
    };
    return no_node()
}

export func discover_declaration_demand(
    nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in W, selected:const SelectedExports in E,
    fields:const CaughtFieldUses in F, views:const SuppliedViews in V,
    interfaces:const ModuleInterfaces in I, published:UInt64, aggregate:const AggregateFacts in A,
    cases:const ConstructorCaseFacts in C, demand:DeclarationDemands in D,
    root:UInt64, used:UInt64, revision:UInt64, problem:UInt64 in P) -> bool
    where {const owner N, const owner B, const owner W, const owner E, const owner F, const owner V,
           const owner I, const owner A, const owner C, owner D, owner P} {
    if (used > intrinsic (len)(nodes) || used > intrinsic (len)(names) ||
        used > intrinsic (len)(links) || used > intrinsic (len)(demand)) return false;
    ref tail = make UInt64 { no_node() };
    if (used == 0u64 || root != used - 1u64 || !module_tail(nodes, revision, used, root, tail)) {
        problem <- root;
        return false
    };
    ref callable = make CallableSites {
        signature <- no_node(); body <- no_node(); function_form <- false;
    };
    ref clause = make UInt64 { no_node() };
    ref count = make UInt64 { 0u64 };
    ref receipt_count = make UInt64 { 0u64 };
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ExplicitValueFormal };
    val array_formals <- (NoSourceArrayFormal:SourceArrayFormals);
    val scope <- no_node();
    for (site in 0u64 .. used) {
        # Record fixed reference formals before binding any caller demand.
        # The selected target's access still belongs to ordinary operand checking.
        scope <- names[site].scope;
        if (scope < used && !uninstantiated_method(names[scope].kind) &&
            formal_binding_is_fixed(nodes, revision, used, site) &&
            inspect_formal(nodes, revision, used, site, formal) == OrdinaryFormal && formal.mode == ReferenceFormal) {
            if (!local_body(nodes, revision, used, scope, callable) || !require_body(demand, scope, count, used, true)) {
                problem <- site;
                return false
            };
            (demand[scope].fixed_borrow <- true):void
        };
        if (!uninstantiated_method(names[site].kind) && local_body(nodes, revision, used, site, callable)) {
            if (!find_signature_clause(
                nodes, revision, used, callable.signature, ThrowsSignatureClause, clause)) {
                problem <- site;
                return false
            };
            demand[site].declared_failure <- clause;
            case views[site] of {
                PreparedFormattingMethod { val operation <-, } -> {
                    demand[site].signature <- true;
                    if (operation == no_node() && !require_body(demand, site, count, used, true)) {
                        problem <- site;
                        return false
                    }
                };
                _ -> {}
            };
            array_formals <- prepared_array_signature(nodes, links, views, callable.signature, used, revision);
            if (array_formals != (NoSourceArrayFormal:SourceArrayFormals)) {
                demand[site].slot_body <- array_formals == (ArrayReferenceSlotFormal:SourceArrayFormals);
                if (!require_receipt_body(demand, site, count, receipt_count, used)) {
                    problem <- site;
                    return false
                }
            };
            if ((prepared_product_writer(views, site) || prepared_scalar_predicate(views, site) ||
                prepared_scalar_function(views, site) || prepared_aggregate_writer(views, site) || prepared_readonly_query(views, site) ||
                prepared_array_procedure(views, site) ||
                prepared_parser_writer(views, site) || prepared_workspace_writer(views, site) || prepared_array_inspector(views, site)) &&
                !require_receipt_body(demand, site, count, receipt_count, used)) {
                problem <- site;
                return false
            };
            if ((clause != no_node() || prepared_text_writer(views, site) ||
                 prepared_source_here_relay(views, site) != no_node() ||
                 links[site].sum_loan_formals || prepared_byte_function(views, site, true) ||
                 readonly_reader_needs_body(views, site) ||
                 source_handle_callable(nodes, names, selected, links, site, used, revision)) &&
                !require_body(demand, site, count, used, true)) {
                problem <- site;
                return false
            }
        };
    };
    ref invocation = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref handler = make ScopedProcedureSites { head <- no_node(); signature <- no_node(); body <- no_node() };
    ref assignment = make AssignmentSites {
        destination <- no_node(); input <- no_node(); operator_at <- no_node()
    };
    ref construction = make NamedThrowSites {
        requested <- no_node(); fields <- no_node(); cause <- no_node();
    };
    ref failure = make ExceptionType {
        defining_module <- 0u64; declaration <- no_node(); checked <- false;
    };
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false
    };
    val definition <- no_node();
    val checked_call <- false;
    val shape <- InvalidCallSyntax;
    val callee <- no_node();
    val transfer <- InvalidAssignment;
    val aggregate_operation <- false;
    val needs_receipt <- false;
    ref mixed_aggregate = make bool { false };
    for (site in 0u64 .. used) {
        scope <- enclosing_callable(nodes, names, names[site].scope);
        demand[site].scope <- scope;
        if (inspect_scoped_procedure(nodes, revision, used, site, handler) &&
            (!require_body(demand, site, count, used, true) ||
             !require_capture_context(nodes, names, demand, scope, root, used, count))) {
            problem <- site;
            return false
        };
        if (scope >= used || !uninstantiated_method(names[scope].kind)) {
            if (site < intrinsic (len)(cases) &&
                (case cases[site] of { SumValueResult -> true; _ -> false }) &&
                !require_receipt_body(demand, site, count, receipt_count, used)) {
                problem <- site;
                return false
            };
            checked_call <- links[site].imported_interface != no_node() &&
                (links[site].imported_failure_checked != 0u8 || links[site].expects_here != 0u8 ||
                 (links[site].imported_array_read_completion != NoArrayRead && links[site].imported_kind == enum_type()) ||
                 (site < intrinsic (len)(views) && (case views[site] of {
                     CheckedScalarFunctionCall -> true;
                     ImportedProductWriter -> true; CheckedArrayCall -> true; CheckedImportedArraySlotCall -> true;
                     CheckedSumWriterCall -> true;
                     CheckedWorkspaceWriterCall { val requires_body <-, } -> requires_body;
                     CheckedReadonlyCall { val aggregate_loan <-, } -> aggregate_loan;
                     _ -> false
                 })));
            if (site < intrinsic (len)(views) && (case views[site] of {
                ImportedSourceTextCall -> true;
                ImportedTextWriterCall -> true;
                _ -> false
            })) { (checked_call <- true):void };
            shape <- inspect_invocation(nodes, revision, used, site, invocation);
            if (shape == InvalidCallSyntax) {
                problem <- site;
                return false
            };
            if (shape == EffectfulInvocation &&
                names[invocation.callee].kind == procedure_symbol_binding()) {
                (checked_call <- true):void
            };
            callee <- if (shape == OrdinaryInvocation) { (invocation.callee) } else { no_node() };
            if (names[site].kind == callable_binding()) {
                transfer <- inspect_assignment(nodes, revision, used, site, assignment);
                if (transfer == PlaceTransfer || transfer == FieldTransfer) { (callee <- site):void; };
            };
            if (callee < used && names[callee].kind == callable_binding()) {
                definition <- names[callee].declaration;
                if (definition >= used) {
                    problem <- site;
                    return false
                };
                demand[site].callee <- definition;
                if (site < intrinsic (len)(cases)) {
                    (demand[site].product_body_dependency <- case cases[site] of {
                        ProductLoanInvocation { val target <- definition, } -> target == definition;
                        _ -> false
                    }):void
                };
                if (scope < used) {
                    demand[site].next_call <- demand[scope].first_call;
                    (demand[scope].first_call <- site):void
                };
                checked_call <- family_needs_checked_operands(links, demand, definition, used) ||
                    prepared_byte_function(views, definition, true);
                if (shape == OrdinaryInvocation) {
                    needs_receipt <- collect_aggregate_loan_demand(nodes, names, links, cases,
                        invocation.arguments, used, revision, mixed_aggregate);
                    if (mixed_aggregate && links[definition].next_method == no_node() &&
                        inspect_callable(nodes, revision, used, definition, callable) == ModuleCallable) {
                        demand[site].mixed_aggregate_loan <- true;
                        demand[site].product_body_dependency <- true;
                        (checked_call <- true):void
                    };
                    if (needs_receipt ||
                        (site < intrinsic (len)(cases) && (case cases[site] of {
                            FreshSumInvocation { val selected <- definition, } -> selected == definition;
                            _ -> false
                        }))) {
                        if (!require_receipt_body(demand, definition, count, receipt_count, used)) {
                            problem <- site;
                            return false
                        };
                        (checked_call <- true):void
                    }
                }
            };
            if (prepared_array_construction(views, site) &&
                (!local_body(nodes, revision, used, scope, callable) ||
                 !require_receipt_body(demand, scope, count, receipt_count, used))) {
                problem <- site;
                return false
            };
            if (site < intrinsic (len)(views) &&
                (case views[site] of { PreparedGenericConstruction -> true; BoundGenericCall -> true; _ -> false }) &&
                (scope >= used || (scope != root && !local_body(nodes, revision, used, scope, callable)) ||
                 !require_body(demand, scope, count, used, scope != root))) {
                problem <- site;
                return false
            };
            aggregate_operation <- site < intrinsic (len)(cases) &&
                (case cases[site] of {
                    BitsConstruction { val consumer <- transfer, val type <- value_type, } ->
                        type.defining_module == 0u64 && type.kind == sum_type() && consumer > site &&
                        consumer < used && inspect_assignment(nodes, revision, used, consumer, assignment) == PlaceTransfer &&
                        assignment.input == site;
                    IndexedAggregateDestination -> true;
                    InlineProductField { val receiver <-, val writable <-, val demand_on_use <-, } ->
                        writable && demand_on_use && receiver < site &&
                        (case cases[receiver] of { InlineProductField -> true; _ -> false });
                    LexicalSumReference -> true;
                    ImportedFreshSumInvocation -> true;
                    _ -> false
                });
            if (links[site].case_schema_prepared || aggregate_operation || selects_caught_field(fields, site) || checked_call ||
                native_loan_requires_body(views, site) || read_acquisition_failure(views, site, failure) ||
                inspect_named_throw(nodes, revision, used, site, construction) ||
                case_pattern(nodes, used, site) == ReferenceCaseTarget ||
                predicate_operand(nodes, revision, used, site) != no_node() ||
                (inspect_local_binding(nodes, revision, used, site, local) && local.declaration_const &&
                    (local.mode == ValueLocal || local.mode == ReferenceLocal)) ||
                (formal_binding_is_fixed(nodes, revision, used, site) &&
                    inspect_formal(nodes, revision, used, site, formal) == OrdinaryFormal &&
                    formal.mode == ExplicitValueFormal)) {
                if (scope >= used ||
                    (scope != root && !local_body(nodes, revision, used, scope, callable) &&
                     !inspect_scoped_procedure(nodes, revision, used, scope, handler)) ||
                    !require_body(demand, scope, count, used, scope != root)) {
                    problem <- site;
                    return false
                }
            };
        };
    };
    val text_problem <- require_text_callers(nodes, names, selected, links, views, interfaces, published, aggregate,
        demand, root, used, revision, count, receipt_count);
    if (text_problem != no_node()) { problem <- text_problem; return false };
    # Reached bodies can forward a loan or determine allocation operands.
    # Check them before accepting the receiving body's contract.
    val failed <- require_byte_completions(views, demand, used, count);
    if (failed != no_node()) { problem <- failed; return false; };
    for (item in 0u64 .. used) {
        if (item < receipt_count) {
            failed <- require_called_contracts(nodes, names, links, demand, demand[item].receipt_pending, revision,
                used, count, receipt_count, true);
            if (failed != no_node()) {
                problem <- failed;
                return false
            }
        }
    };
    for (item in 0u64 .. used) {
        if (item >= count) return true;
        failed <- require_called_contracts(nodes, names, links, demand, demand[item].pending, revision, used,
            count, receipt_count, false);
        if (failed != no_node()) {
            problem <- failed;
            return false
        }
    };
    return count == used
}
