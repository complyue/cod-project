    enum_type, ArrayReadCompletion { NoArrayRead, CheckedArrayRead, ArrayReadMayFailBounds }
};

enum ContractOperationKind:UInt8 {
    NoContractOperation; PendingExpression; CheckedLeaf; FalseValue; TrueValue;
    ForwardValue; NegateValue; ConjoinValues; DisjoinValues; ReturnFalseOrTail;
}
data ContractOperation {
    kind:ContractOperationKind;
    first:UInt64;
    second:UInt64;
}
array ContractOperations[UInt64]:ContractOperation;

func request_expression(operations:ContractOperations in P, at:UInt64, formal:UInt64) -> void where {owner P} {
    operations[at].kind <- (PendingExpression:ContractOperationKind);
    (operations[at].first <- formal):void
}

func collect_predicate_expression(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, facts:const OperandFacts in F, sites:const CompletionSites in X,
    operations:ContractOperations in P, at:UInt64, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner W, const owner F, const owner X, owner P} {
    val formal <- operations[at].first;
    operations[at].kind <- (NoContractOperation:ContractOperationKind);
    operations[at].first <- no_node();
    if (facts[at].kind != scalar_bool()) return;
    val literal <- boolean_literal(nodes, used, at);
    if (literal == LiteralFalse || literal == LiteralTrue) {
        operations[at].kind <- if (literal == LiteralTrue) {
            (TrueValue:ContractOperationKind)
        } else { (FalseValue:ContractOperationKind) };
        return
    };
    val operand <- no_node();
    if (inspect_group(nodes, revision, used, at, operand) == ParenthesizedExpression) {
        operations[at].kind <- (ForwardValue:ContractOperationKind);
        operations[at].first <- operand;
        request_expression(operations, operand, formal);
        return
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs
    };
    operations[at].kind <- case inspect_logical(nodes, revision, used, at, logical) of {
        LogicalAnd -> (ConjoinValues:ContractOperationKind);
        LogicalOr -> (DisjoinValues:ContractOperationKind);
        LogicalNot -> (NegateValue:ContractOperationKind);
        _ -> (NoContractOperation:ContractOperationKind)
    };
    if (operations[at].kind != (NoContractOperation:ContractOperationKind)) {
        operations[at].first <- logical.left_operand;
        request_expression(operations, logical.left_operand, formal);
        if (operations[at].kind != (NegateValue:ContractOperationKind)) {
            operations[at].second <- logical.right_operand;
            request_expression(operations, logical.right_operand, formal)
        };
        return
    };
    val target <- forwarded_predicate_call(nodes, names, work, at, formal, used, revision);
    if (target < used && facts[at].call_definition == target && can_continue(sites, at)) {
        operations[at].kind <- (ForwardValue:ContractOperationKind);
        (operations[at].first <- target):void
    };
}

# Extract source structure once. Ordinary checking has already prepared
# the arguments and selected the call. No completed predicate is read here.
func collect_predicate_operations(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:const SuppliedViews in V, facts:const OperandFacts in F,
    sites:const CompletionSites in X, operations:ContractOperations in P, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner W, const owner V, const owner F, const owner X, owner P} {
    for (at in 0u64 .. used) {
        case views[at] of {
            ReadonlyTextPredicate -> {
                if (sites[at].array_read_completion != NoArrayRead) {
                    (operations[at].kind <- (CheckedLeaf:ContractOperationKind)):void
                }
            };
            ReadonlyTextPredicateBody { val formal <- first_formal; val test <-; val tail <-; val returns_true <-; } -> {
                if (facts[at].kind == scalar_bool()) {
                    if (test == no_node()) {
                        operations[at].kind <- (ForwardValue:ContractOperationKind);
                        (operations[at].first <- tail):void
                    } else {
                        operations[at].kind <- if (returns_true) { (DisjoinValues:ContractOperationKind) } else { (ReturnFalseOrTail:ContractOperationKind) };
                        operations[at].first <- test;
                        operations[at].second <- tail;
                        request_expression(operations, test, formal)
                    };
                    request_expression(operations, tail, formal)
                }
            };
            _ -> {}
        }
    };
    val at <- no_node();
    for (offset in 0u64 .. used) {
        at <- used - 1u64 - offset;
        if (operations[at].kind == (PendingExpression:ContractOperationKind)) {
            collect_predicate_expression(nodes, names, work, facts, sites, operations, at, used, revision)
        }
    };
}


enum ContractVisit:UInt8 { Unvisited; VisitingFirst; VisitingSecond; Leaving; Finished; Cyclic; }
data ContractTraversal {
    visit:ContractVisit;
    stack_site:UInt64;
    ordered_site:UInt64;
}
array ContractTraversals[UInt64]:ContractTraversal;

func advance_contract_order(operations:const ContractOperations in P, scratch:ContractTraversals in S,
    depth:UInt64 in D, count:UInt64 in D, used:UInt64) -> void where {const owner P, owner S, owner D} {
    val at <- scratch[depth - 1u64].stack_site;
    val child <- no_node();
    if (scratch[at].visit == (VisitingFirst:ContractVisit)) {
        child <- operations[at].first;
        (scratch[at].visit <- (VisitingSecond:ContractVisit)):void
    } else {
        if (scratch[at].visit == (VisitingSecond:ContractVisit)) {
            child <- operations[at].second;
            (scratch[at].visit <- (Leaving:ContractVisit)):void
        } else {
            scratch[at].visit <- (Finished:ContractVisit);
            scratch[count].ordered_site <- at;
            count <- count + 1u64;
            (depth <- depth - 1u64):void;
            return
        }
    };
    if (child >= used || operations[child].kind == (NoContractOperation:ContractOperationKind)) return;
    if (scratch[child].visit == (Unvisited:ContractVisit)) {
        scratch[child].visit <- (VisitingFirst:ContractVisit);
        scratch[depth].stack_site <- child;
        (depth <- depth + 1u64):void;
        return
    };
    if (scratch[child].visit != (Finished:ContractVisit)) {
        for (item in 0u64 .. depth) {
            (scratch[scratch[item].stack_site].visit <- (Cyclic:ContractVisit)):void
        };
        (depth <- 0u64):void
    };
}

# Establish dependency order using only the recorded edges. An active back
# edge leaves the unfinished chain unavailable. Propagate that limit to
# all later users too, independently of source declaration order.
func order_contract_operations(operations:const ContractOperations in P, scratch:ContractTraversals in S,
    used:UInt64) -> UInt64 where {const owner P, owner S} {
    ref count = make UInt64 { 0u64 };
    ref depth = make UInt64 { 0u64 };
    val root <- 0u64;
    # One root examination and at most three stack steps per operation.
    for (step in 0u64 .. used * 4u64) {
        if (depth == 0u64) {
            if (root == used) return count;
            if (operations[root].kind != (NoContractOperation:ContractOperationKind) &&
                scratch[root].visit == (Unvisited:ContractVisit)) {
                scratch[0u64].stack_site <- root;
                scratch[root].visit <- (VisitingFirst:ContractVisit);
                (depth <- 1u64):void
            };
            (root <- root + 1u64):void
        } else {
            advance_contract_order(operations, scratch, depth, count, used)
        };
    };
    return count
}

# No completed normal Bool alternative means the profile could not prove
# the operation. The admitted leaf conservatively allows both values.
data PredicateOutcome { can_true:bool; can_false:bool; bounds:bool; numeric:bool; }
array PredicateOutcomes[UInt64]:PredicateOutcome;

func apply_predicate_operation(operation:const ContractOperation in P, sites:const CompletionSites in X,
    outcomes:PredicateOutcomes in O, at:UInt64) -> void where {const owner P, const owner X, owner O} {
    val kind <- operation.kind;
    if (kind == (CheckedLeaf:ContractOperationKind)) {
        outcomes[at].can_true <- true;
        outcomes[at].can_false <- true;
        outcomes[at].bounds <- sites[at].array_read_completion == ArrayReadMayFailBounds;
        (outcomes[at].numeric <- sites[at].numeric_fault):void;
        return
    };
    if (kind == (TrueValue:ContractOperationKind) || kind == (FalseValue:ContractOperationKind)) {
        outcomes[at].can_true <- kind == (TrueValue:ContractOperationKind);
        (outcomes[at].can_false <- kind == (FalseValue:ContractOperationKind)):void;
        return
    };
    val first <- operation.first;
    val yes <- outcomes[first].can_true;
    val no <- outcomes[first].can_false;
    if (!yes && !no) return;
    val reaches_right <- if (kind == (ConjoinValues:ContractOperationKind)) { yes } else { no };
    val combines <- kind == (ConjoinValues:ContractOperationKind) || kind == (DisjoinValues:ContractOperationKind) || kind == (ReturnFalseOrTail:ContractOperationKind);
    val bounds <- outcomes[first].bounds;
    val numeric <- outcomes[first].numeric;
    if (combines) {
        val tail_true <- false;
        val tail_false <- false;
        if (reaches_right) {
            val second <- operation.second;
            tail_true <- outcomes[second].can_true;
            tail_false <- outcomes[second].can_false;
            if (!tail_true && !tail_false) return;
            bounds <- bounds || outcomes[second].bounds;
            (numeric <- numeric || outcomes[second].numeric):void
        };
        if (kind == (ConjoinValues:ContractOperationKind)) {
            yes <- tail_true;
            (no <- no || tail_false):void
        } else {
            if (kind == (DisjoinValues:ContractOperationKind)) {
                yes <- yes || tail_true;
                (no <- tail_false):void
            } else {
                no <- yes || tail_false;
                (yes <- tail_true):void
            }
        }
    } else {
        if (kind == (NegateValue:ContractOperationKind)) {
            val original_true <- yes;
            yes <- no;
            (no <- original_true):void
        }
    };
    outcomes[at].can_true <- yes;
    outcomes[at].can_false <- no;
    outcomes[at].bounds <- bounds;
    (outcomes[at].numeric <- numeric):void;
}

func has_predicate_body(views:const SuppliedViews in V, used:UInt64) -> bool where {const owner V} {
    for (at in 0u64 .. used) {
        if (case views[at] of { ReadonlyTextPredicateBody -> true; _ -> false }) return true
    };
    return false
}

export func finish_text_predicates(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, facts:const OperandFacts in F,
    sites:const CompletionSites in X, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner B, const owner W, owner V, const owner F, const owner X} {
    if (used > 4611686018427387903u64 || !has_predicate_body(views, used)) return;
    ref operations = make ContractOperations(used, make ContractOperation {
        kind <- (NoContractOperation:ContractOperationKind); first <- no_node(); second <- no_node()
    });
    collect_predicate_operations(nodes, names, work, views, facts, sites, operations, used, revision);
    ref traversal = make ContractTraversals(used, make ContractTraversal {
        visit <- (Unvisited:ContractVisit); stack_site <- no_node(); ordered_site <- no_node()
    });
    val count <- order_contract_operations(operations, traversal, used);
    ref outcomes = make PredicateOutcomes(used, make PredicateOutcome {
        can_true <- false; can_false <- false; bounds <- false; numeric <- false
    });
    val site <- no_node();
    for (item in 0u64 .. count) {
        site <- traversal[item].ordered_site;
        apply_predicate_operation(operations[site], sites, outcomes, site)
    };
    for (at in 0u64 .. used) {
        if ((outcomes[at].can_true || outcomes[at].can_false) &&
            (case views[at] of { ReadonlyTextPredicateBody -> true; _ -> false })) {
            (views[at] <- make CheckedReadonlyReader {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric
            }):void
        }
    };
}

data FunctionEffects { available:bool; bounds:bool; numeric:bool; allocates:bool; }
array FunctionEffectRows[UInt64]:FunctionEffects;

data FunctionCallNode { first_caller:UInt64; caller:UInt64; next_caller:UInt64; }
array FunctionCallGraph[UInt64]:FunctionCallNode;
enum FunctionEffect:UInt8 { UnavailableBody; EscapingBounds; FatalArithmetic; LexicalArrayAllocation; }

func checked_unsigned_arithmetic_kind(kind:UInt8) -> bool {
    return kind == scalar_u8() || kind == scalar_u64()
}

func prepared_synchronous_here(views:const SuppliedViews in V, site:UInt64, call:UInt64)
    -> bool where {const owner V} {
    if (site >= intrinsic (len)(views)) return false;
    return case views[site] of {
        PreparedSynchronousHere { val invocation <- call; } -> call == no_node() || invocation == call;
        _ -> false
    }
}

func lexical_array_allocation(names:const NameBindings in B, facts:const OperandFacts in F,
    views:const SuppliedViews in V, at:UInt64) -> bool
    where {const owner B, const owner F, const owner V} {
    return case views[at] of {
        PreparedArrayConstruction { val placement <-; val owner_site <-; } ->
            placement == no_node() && owner_site == names[at].scope && allocated_source_array(facts, at);
        _ -> false
    }
}

func checked_function_operation(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const OperandFacts in F, views:const SuppliedViews in V, cases:const ConstructorCaseFacts in C,
    at:UInt64, callee:UInt64, stops_before_entry:bool, checked_call:bool) -> bool
    where {const owner N, const owner B, const owner F, const owner V, const owner C} {
    if (at < intrinsic (len)(cases) &&
        (case cases[at] of {
            LexicalProductReference -> true;
            LexicalSumReference -> true;
            LexicalSumRebind -> true;
            _ -> false
        })) return true;
    return case nodes[at] of {
        Occupied { val syntax <- node; } -> case syntax.payload of {
            NameReference -> true;
            BooleanLiteral -> true;
            IntegerLiteral -> true;
            Negation -> true;
            Conjunction -> true;
            Disjunction -> true;
            Parenthesized -> true;
            Transfer -> names[at].kind == 0u8;
            ComparisonExpression -> true;
            ArithmeticExpression -> checked_unsigned_arithmetic_kind(facts[at].kind) || facts[at].kind == never_result();
            DiscardedExpression -> true;
            FieldSelection -> true;
            IndexSelection -> facts[at].checks_array_bounds || facts[at].kind == never_result();
            ArrayLength -> true;
            NamedConstruction -> lexical_array_allocation(names, facts, views, at) ||
                (facts[at].kind == independent_sum_bits() &&
                 (case views[at] of { EmptySumArrayFill -> true; _ -> false })) ||
                (facts[at].allocation_owner == no_node() &&
                ((at < intrinsic (len)(cases) && (case cases[at] of { BitsConstruction -> true; _ -> false })) ||
                 completed_lexical_bits_target(facts, at, names[at].scope)));
            CheckedTypeAssertion -> facts[at].kind == declared_scalar(enum_type());
            BracedInitializer -> true;
            InitializerTransfer -> names[at].kind == 0u8;
            CaseExpression -> true;
            CaseArm -> true;
            ConstructorCasePattern -> true;
            CaseValueReceiver -> true;
            Conditional -> true;
            ReturningCondition -> true;
            BlockSyntax -> true;
            BlockItem -> true;
            ArgumentItem -> true;
            ReturnVoid -> true;
            ReturnValue -> true;
            LocalBinding { val mode <-; val initializer <-; } -> mode == ValueLocal ||
                (mode == ReferenceLocal && (completed_lexical_bits_target(facts, at, names[at].scope) ||
                    (initializer.index < at && lexical_array_allocation(names, facts, views, initializer.index))));
            AnnotatedBinding -> true;
            RangeHeader -> true;
            RangeLoop -> true;
            HereInvocation -> prepared_synchronous_here(views, at, no_node());
            HereSupply -> true;
            Formal -> true;
            HereReceiver -> true;
            ContinueValue -> true;
            Call -> callee != no_node() || stops_before_entry || checked_call ||
                checked_literal_call(views, at) || prepared_array_length_call(views, at);
            EmptyCall -> callee != no_node() || checked_literal_call(views, at);
            _ -> false
        };
        Vacant -> false
    }
}

# Collect local effects and reverse edges over the checked operations. Each
# call site belongs to only one callee's list of possible entered calls.
func collect_function_operations(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:const SuppliedViews in V, facts:const OperandFacts in F,
    demand:const DeclarationDemands in D, sites:const CompletionSites in X, cases:const ConstructorCaseFacts in C,
    calls:FunctionCallGraph in P, local:FunctionEffectRows in E, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, const owner V, const owner F,
        const owner D, const owner X, const owner C, owner P, owner E} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val result <- 0u8;
    for (definition in 0u64 .. used) {
        if (demand[definition].receipt_body && names[definition].kind == callable_binding() &&
            names[definition].declaration == definition && work[definition].next_method == no_node() &&
            inspect_callable(nodes, revision, used, definition, callable) == ModuleCallable &&
            !is_scope_block(nodes, callable.body) &&
            demand[definition].declared_failure == no_node() && facts[definition].reception != borrowed_ref()) {
            result <- facts[definition].kind;
            if ((result == void_result() || result == scalar_bool() || result == declared_scalar(builtin_u8()) ||
                 result == scalar_u64() || result == declared_scalar(enum_type()) || result == independent_sum_bits()) &&
                !can_miss_return(nodes, facts, sites, definition, revision, used)) {
                if (readonly_indexed_byte_reader(views, definition)) {
                    # The earlier completion pass already proved this leaf.
                    if (sites[definition].array_read_completion != NoArrayRead) {
                        local[definition].available <- true;
                        local[definition].bounds <- sites[definition].array_read_completion == ArrayReadMayFailBounds;
                        (local[definition].numeric <- sites[definition].numeric_fault):void
                    }
                } else {
                    (local[definition].available <- true):void
                }
            }
        }
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    val definition <- no_node();
    val callee <- no_node();
    val event <- 0u8;
    val ordinary <- false;
    val stops_before_entry <- false;
    val checked_call <- false;
    val imported_effects <- false;
    for (at in 0u64 .. used) {
        definition <- demand[at].scope;
        if (definition < used && definition != at && local[definition].available &&
            !readonly_indexed_byte_reader(views, definition) && sites[at].event != skipped_operand()) {
            callee <- facts[at].call_definition;
            ordinary <- inspect_invocation(nodes, revision, used, at, call) == OrdinaryInvocation;
            stops_before_entry <- ordinary &&
                (!can_continue(sites, call.callee) || !can_continue(sites, call.arguments));
            imported_effects <- checked_source_array_call(views, at) || checked_scalar_call(views, at);
            checked_call <- ordinary && (imported_effects ||
                prepared_native_function(views, at, revision) ||
                (work[at].imported_interface != no_node() &&
                 (work[at].imported_array_read_completion != NoArrayRead ||
                  prepared_synchronous_here(views, work[at].active, at))));
            if ((callee != no_node() && (!ordinary || callee >= used || callee != demand[at].callee)) ||
                !checked_function_operation(nodes, names, facts, views, cases, at, callee, stops_before_entry,
                    checked_call)) {
                (local[definition].available <- false):void
            } else {
                event <- sites[at].event;
                if (event == possible_failure() || event == definite_failure()) {
                    if (sites[at].category_module == 0u64 && sites[at].category == index_out_of_bounds_identity() &&
                        sites[at].destination == definition) {
                        (local[definition].bounds <- true):void
                    } else {
                        if (sites[at].category_module == 0u64 && sites[at].category == out_of_memory_identity() &&
                            sites[at].destination == definition && lexical_array_allocation(names, facts, views, at)) {
                            (local[definition].allocates <- true):void
                        } else { (local[definition].available <- false):void }
                    }
                };
                if (checked_call && !stops_before_entry && source_call_allocates(views, at)) {
                    (local[definition].allocates <- true):void
                };
                if (can_continue(sites, at)) {
                    if ((imported_effects && work[at].imported_numeric_fault) ||
                        (checked_unsigned_arithmetic_kind(facts[at].kind) &&
                         (case nodes[at] of {
                            Occupied { val syntax <- node; } -> case syntax.payload of {
                                ArithmeticExpression -> true; _ -> false
                            };
                            Vacant -> false
                         }))) {
                        (local[definition].numeric <- true):void
                    };
                };
                if (callee != no_node() && !stops_before_entry) {
                    calls[at].caller <- definition;
                    calls[at].next_caller <- calls[callee].first_caller;
                    (calls[callee].first_caller <- at):void
                }
            }
        }
    };
}

func has_function_effect(row:const FunctionEffects in R, category:FunctionEffect) -> bool
    where {const owner R} {
    return case category of {
        UnavailableBody -> !row.available;
        EscapingBounds -> row.bounds;
        FatalArithmetic -> row.numeric;
        LexicalArrayAllocation -> row.allocates
    }
}

func remember_function_effect(row:FunctionEffects in R, category:FunctionEffect) -> void
    where {owner R} {
    case category of {
        UnavailableBody -> (row.available <- false):void;
        EscapingBounds -> (row.bounds <- true):void;
        FatalArithmetic -> (row.numeric <- true):void;
        LexicalArrayAllocation -> (row.allocates <- true):void
    }
}

# Close one possible outcome over the frozen graph. A function enters the
# stack at most once. Components without a local origin add no outcome.
func propagate_function_effect(calls:const FunctionCallGraph in P, local:const FunctionEffectRows in L,
    outcomes:FunctionEffectRows in O, used:UInt64, category:FunctionEffect)
    -> void where {const owner P, const owner L, owner O} {
    ref stack = make deque[UInt64]();
    for (at in 0u64 .. used) {
        if (has_function_effect(local[at], category)) {
            remember_function_effect(outcomes[at], category);
            if (calls[at].first_caller != no_node()) {
                push_back(stack, at)
            }
        }
    };
    val edge <- no_node();
    val caller <- no_node();
    # Each step takes a stack entry or visits a call site.
    for (step in 0u64 .. used + used) {
        if (edge == no_node()) {
            case pop_back(stack) of {
                (null) -> { return; };
                (ref item:UInt64 in here) -> { (edge <- calls[item].first_caller):void; };
            }
        } else {
            caller <- calls[edge].caller;
            if (!has_function_effect(outcomes[caller], category)) {
                remember_function_effect(outcomes[caller], category);
                if (calls[caller].first_caller != no_node()) {
                    push_back(stack, caller)
                }
            };
            (edge <- calls[edge].next_caller):void
        }
    }
}

func has_closed_function_candidate(views:const SuppliedViews in V, used:UInt64) -> bool where {const owner V} {
    for (at in 0u64 .. used) {
        if (prepared_product_writer(views, at) || prepared_scalar_predicate(views, at) ||
            prepared_scalar_function(views, at) || prepared_aggregate_writer(views, at) || prepared_readonly_query(views, at) ||
            prepared_array_procedure(views, at) ||
            prepared_parser_writer(views, at) || prepared_workspace_writer(views, at) || prepared_array_inspector(views, at)) return true
    };
    return false
}

export func finish_closed_source_functions(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, views:SuppliedViews in V, facts:const OperandFacts in F,
    demand:const DeclarationDemands in D, sites:const CompletionSites in X, cases:const ConstructorCaseFacts in C,
    used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, owner V, const owner F, const owner D, const owner X, const owner C} {
    if (used > 9223372036854775807u64 || !has_closed_function_candidate(views, used)) return;
    ref calls = make FunctionCallGraph(used, make FunctionCallNode {
        first_caller <- no_node(); caller <- no_node(); next_caller <- no_node()
    });
    ref local = make FunctionEffectRows(used, make FunctionEffects { available <- false; bounds <- false; numeric <- false; allocates <- false });
    collect_function_operations(nodes, names, work, views, facts, demand, sites, cases, calls, local, used, revision);
    ref outcomes = make FunctionEffectRows(used, make FunctionEffects { available <- true; bounds <- false; numeric <- false; allocates <- false });
    propagate_function_effect(calls, local, outcomes, used, UnavailableBody:FunctionEffect);
    propagate_function_effect(calls, local, outcomes, used, EscapingBounds:FunctionEffect);
    propagate_function_effect(calls, local, outcomes, used, FatalArithmetic:FunctionEffect);
    propagate_function_effect(calls, local, outcomes, used, LexicalArrayAllocation:FunctionEffect);
    val nonallocating <- false;
    for (at in 0u64 .. used) {
        nonallocating <- outcomes[at].available && !outcomes[at].allocates;
        if (prepared_product_writer(views, at) && nonallocating) {
            (views[at] <- make CheckedProductWriter {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric
            }):void
        };
        if (prepared_aggregate_writer(views, at) && nonallocating) {
            (views[at] <- make CheckedAggregateWriter {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric
            }):void
        };
        if (prepared_array_inspector(views, at) && outcomes[at].available) {
            (views[at] <- make CheckedArrayInspector {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric; allocates <- outcomes[at].allocates
            }):void
        };
        if (prepared_workspace_writer(views, at) && outcomes[at].available) {
            (views[at] <- make CheckedWorkspaceWriter {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric; allocates <- outcomes[at].allocates
            }):void
        };
        if (prepared_parser_writer(views, at) && nonallocating) {
            (views[at] <- make CheckedParserWriter {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric
            }):void
        };
        if (prepared_readonly_query(views, at) && nonallocating) {
            (views[at] <- make CheckedReadonlyReader {
                completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                numeric_fault <- outcomes[at].numeric
            }):void
        };
        case views[at] of {
            PreparedArrayProcedure { val mixed_record <-; } -> {
                if (outcomes[at].available && (mixed_record || !outcomes[at].allocates)) {
                    (views[at] <- make CheckedArrayProcedure {
                        completion <- if (outcomes[at].bounds) { ArrayReadMayFailBounds } else { CheckedArrayRead };
                        numeric_fault <- outcomes[at].numeric; allocates <- outcomes[at].allocates
                    }):void
                }
            };
            _ -> {}
        };
        if (prepared_scalar_function(views, at) && nonallocating && !outcomes[at].bounds) {
            (views[at] <- make CheckedScalarFunction { numeric_fault <- outcomes[at].numeric }):void
        };
        if (prepared_scalar_predicate(views, at) && nonallocating &&
            !outcomes[at].bounds && !outcomes[at].numeric) {
            (views[at] <- make CheckedScalarPredicate {}):void
        }
    };
}
