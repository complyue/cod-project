using "std:exceptions" Exception;

export enum ABIRepresentation:u8 {
    ABIInt8 = 0;
    ABIInt32 = 1;
    ABIInt64 = 2;
    ABIFloat32 = 3;
    ABIFloat64 = 4;
}
export handle type ProviderLayout;
export data ProviderLayoutException <: Exception { status:u8; }

proc "C" ProviderLayout() throws ProviderLayoutException;
export proc "C" provider_alloc_size(handle layout:ProviderLayout in L, representation:ABIRepresentation) -> u64
    where {const owner L};
export proc "C" provider_abi_alignment(handle layout:ProviderLayout in L, representation:ABIRepresentation) -> u64
    where {const owner L};
export proc "C" provider_struct_alignment(handle layout:ProviderLayout in L) -> u64
    where {const owner L};
