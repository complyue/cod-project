using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" len as syntax_len;
using "ParserStorage.cod" no_node;
using "ParserStorage.cod" module_node;
using "ParserStorage.cod" module_item_node;
using "ParserStorage.cod" callable_node;
using "ParserStorage.cod" callable_head_node;
using "ParserStorage.cod" is_function;
using "ParserStorage.cod" throws_clause_node;
using "ParserStorage.cod" block_node;
using "ParserStorage.cod" full_scope_node;
using "ParserStorage.cod" block_item_node;
using "ParserStorage.cod" argument_node;
using "ParserStorage.cod" try_node;
using "ParserStorage.cod" catch_clause_node;
using "ParserStorage.cod" catch_handler_node;
using "ParserStorage.cod" finally_clause_node;
using "ParserStorage.cod" deferred_call_node;
using "ParserStorage.cod" deferred_block_node;
using "ParserStorage.cod" discard_node;
using "ParserStorage.cod" compare_node;
using "ParserStorage.cod" conditional_node;
using "ParserStorage.cod" range_node;
using "ParserStorage.cod" range_header_node;
using "ParserStorage.cod" literal_range;
using "ParserStorage.cod" nonempty_literal_range;
using "ParserStorage.cod" bool_node;
using "ParserStorage.cod" logical_not_node;
using "ParserStorage.cod" logical_binary;
using "ParserStorage.cod" skips_right;
using "ParserStorage.cod" return_node;
using "ParserStorage.cod" throw_node;
using "ParserStorage.cod" group_node;
using "ParserStorage.cod" call_node;
using "ParserStorage.cod" behave_node;
using "ParserStorage.cod" is_transfer;
using "ParserStorage.cod" make_named_node;
using "ParserStorage.cod" construction_body;
using "ParserStorage.cod" integer_arithmetic;
using "ParserStorage.cod" null_node;
using "ParserStorage.cod" name_node;
using "ParserStorage.cod" ptr_binding_node;
using "ParserStorage.cod" ptr_parameter_node;
using "ParserStorage.cod" val_binding_node;
using "ExpressionParser.cod" ParseResult;
using "NameResolution.cod" NameBindings;
using "NameResolution.cod" NameWork;
using "NameResolution.cod" first_item;
using "NameResolution.cod" enclosing_callable;
using "NameResolution.cod" exception_binding;
using "OperandChecking.cod" OperandFacts;
using "OperandChecking.cod" nullable_ptr;
using "OperandChecking.cod" borrowed_ref;
using "OperandChecking.cod" never_result;
using "OperandChecking.cod" void_result;
using "OperandChecking.cod" has_value_tail;
using "ModuleExports.cod" exception_root_identity;
using "ModuleExports.cod" null_pointer_identity;
using "ModuleExports.cod" missing_return_identity;

data CompletionSite {
    event:u8;
    presence:u8;
    can_continue:u8;
    local_return:u8;
    retains_caught:u8;
    forwarded_operand:u8;
    in_delayed_body:u8;
    may_miss_return:u8;
    guarded_by:u64;
    incoming_handler:u64;
    throws_clause:u64;
    category:u64;
    destination:u64;
    cleanup_first:u64;
    cleanup_stop:u64;
    registration:u64;
    previous_defer:u64;
    last_defer:u64;
    replacing_try:u64;
    missing_return_user:u64;
    missing_return_work:u64;
}
array CompletionSites[u64]:CompletionSite;

data CompletionCheckResult {
    diagnostic:u8;
    node:u64;
}

func possible_failure() -> u8 { return 1u8; }
func definite_failure() -> u8 { return 2u8; }
func callable_return() -> u8 { return 3u8; }
func skipped_operand() -> u8 { return 4u8; }

func present_target() -> u8 { return 1u8; }
func absent_target() -> u8 { return 2u8; }
func unknown_target() -> u8 { return 3u8; }

func uncovered_checked_failure() -> u8 { return 1u8; }
func uncovered_deferred_failure() -> u8 { return 2u8; }
func unproved_deferred_error() -> u8 { return 3u8; }
func missing_rethrow_context() -> u8 { return 4u8; }
func unproved_rethrow_capture() -> u8 { return 5u8; }
func completion_storage_exhausted() -> u8 { return 7u8; }
func invalid_completion_tree() -> u8 { return 8u8; }
func unproved_incoming_exception() -> u8 { return 9u8; }
func unproved_throw_operand() -> u8 { return 10u8; }
func unproved_caught_handoff() -> u8 { return 11u8; }
func unproved_nonnull_argument() -> u8 { return 12u8; }

func initialize_site(ref sites:CompletionSites in X, at:u64) -> void where {owner X} {
    sites[at].event <- 0u8;
    sites[at].presence <- 0u8;
    sites[at].can_continue <- 1u8;
    sites[at].local_return <- 0u8;
    sites[at].retains_caught <- 0u8;
    sites[at].forwarded_operand <- 0u8;
    sites[at].in_delayed_body <- 0u8;
    sites[at].may_miss_return <- 0u8;
    sites[at].guarded_by <- no_node();
    sites[at].incoming_handler <- no_node();
    sites[at].throws_clause <- no_node();
    sites[at].category <- no_node();
    sites[at].destination <- no_node();
    sites[at].cleanup_first <- no_node();
    sites[at].cleanup_stop <- no_node();
    sites[at].registration <- no_node();
    sites[at].previous_defer <- no_node();
    sites[at].last_defer <- no_node();
    sites[at].replacing_try <- no_node();
    sites[at].missing_return_user <- no_node();
    sites[at].missing_return_work <- no_node();
    return;
}

func inherit_context(ref sites:CompletionSites in X, parent:u64, child:u64, guarded_by:u64, incoming_handler:u64,
                     replacing_try:u64) -> void
    where {owner X} {
    if (child == no_node()) { return; } else {};
    sites[child].guarded_by <- guarded_by;
    sites[child].incoming_handler <- incoming_handler;
    sites[child].replacing_try <- replacing_try;
    sites[child].in_delayed_body <- sites[parent].in_delayed_body;
    if (sites[parent].event == skipped_operand()) { (sites[child].event <- skipped_operand()):void; } else {};
    return;
}

func binary_context(kind:u8) -> bool {
    return kind == module_item_node() || kind == block_item_node() || kind == argument_node() ||
        kind == catch_clause_node() || kind == call_node() || kind == behave_node() ||
        integer_arithmetic(kind) || kind == compare_node();
}

func prepare_context(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                     ref sites:CompletionSites in X, at:u64) -> void
    where {const owner N, const owner F, owner X} {
    val kind <- nodes[at].kind;
    val guard <- sites[at].guarded_by;
    val incoming <- sites[at].incoming_handler;
    val replacing <- sites[at].replacing_try;
    val left <- nodes[at].left;
    val right <- nodes[at].right;
    if (kind == deferred_block_node()) {
        val body <- nodes[at].left;
        inherit_context(sites, at, body, no_node(), no_node(), no_node());
        sites[body].in_delayed_body <- 1u8;
        return;
    } else {};
    if (kind == finally_clause_node()) {
        inherit_context(sites, at, nodes[at].left, guard, incoming, replacing);
        if (replacing != no_node() && nodes[replacing].right == at) {
            (replacing <- sites[replacing].replacing_try):void;
        } else {};
        inherit_context(sites, at, nodes[at].right, guard, incoming, replacing);
        return;
    } else {};
    if (kind == try_node()) {
        val last <- nodes[at].right;
        if (nodes[last].kind == finally_clause_node() && facts[nodes[last].right].kind == never_result()) {
            (replacing <- at):void;
        } else {};
        inherit_context(sites, at, nodes[at].left, at, incoming, replacing);
        inherit_context(sites, at, last, guard, incoming, replacing);
        return;
    } else {};
    if (kind == callable_node()) {
        inherit_context(sites, at, nodes[at].right, no_node(), no_node(), no_node());
        return;
    } else {};
    if (kind == catch_handler_node()) {
        inherit_context(sites, at, nodes[at].right, guard, at, replacing);
        return;
    } else {};
    if (kind == deferred_call_node()) {
        sites[nodes[at].right].registration <- at;
        inherit_context(sites, at, nodes[at].left, guard, incoming, replacing);
        return;
    } else {};
    if (kind == conditional_node()) {
        inherit_context(sites, at, nodes[at].left, guard, incoming, replacing);
        inherit_context(sites, at, nodes[at].right, guard, incoming, replacing);
        inherit_context(sites, at, nodes[at].number, guard, incoming, replacing);
        return;
    } else {};
    if (kind == range_node()) {
        val empty <- nodes[at].number;
        inherit_context(sites, at, left, guard, incoming, replacing);
        inherit_context(sites, at, right, guard, incoming, replacing);
        inherit_context(sites, at, empty, guard, incoming, replacing);
        val bounds_stop <- facts[nodes[left].left].kind == never_result() || facts[nodes[left].right].kind == never_result();
        val literal <- literal_range(nodes, left);
        val nonempty <- literal && nonempty_literal_range(nodes, left);
        if (bounds_stop || (literal && !nonempty)) { (sites[right].event <- skipped_operand()):void; } else {};
        if (empty != no_node() && (bounds_stop || nonempty)) { (sites[empty].event <- skipped_operand()):void; } else {};
        return;
    } else {};
    if (kind == range_header_node()) {
        inherit_context(sites, at, left, guard, incoming, replacing);
        inherit_context(sites, at, right, guard, incoming, replacing);
        if (facts[left].kind == never_result()) { (sites[right].event <- skipped_operand()):void; } else {};
        return;
    } else {};
    if (logical_binary(kind)) {
        inherit_context(sites, at, left, guard, incoming, replacing);
        inherit_context(sites, at, right, guard, incoming, replacing);
        if (facts[left].kind == never_result() || skips_right(nodes, at)) {
            (sites[right].event <- skipped_operand()):void;
        } else {};
        return;
    } else {};
    if (binary_context(kind) || is_transfer(nodes, at)) {
        inherit_context(sites, at, left, guard, incoming, replacing);
        inherit_context(sites, at, right, guard, incoming, replacing);
        if (integer_arithmetic(kind) && facts[left].kind == never_result()) {
            (sites[right].event <- skipped_operand()):void;
        } else {};
        return;
    } else {};
    if (kind == val_binding_node() || kind == ptr_binding_node()) {
        inherit_context(sites, at, nodes[at].right, guard, incoming, replacing);
        return;
    } else {};
    if (kind == make_named_node()) {
        inherit_context(sites, at, construction_body(nodes, at), guard, incoming, replacing);
        return;
    } else {};
    if (kind == module_node() || kind == block_node() || kind == full_scope_node() ||
        kind == group_node() || kind == discard_node() || kind == return_node() || kind == throw_node() ||
        kind == logical_not_node()) {
        inherit_context(sites, at, nodes[at].left, guard, incoming, replacing);
    } else {};
}

func declared_throw(nodes:const ExprNodes in N, definition:u64) -> u64 where {const owner N} {
    val clause <- nodes[definition].left;
    for (unused in 0u64 .. definition) {
        if (nodes[clause].kind == throws_clause_node()) { return clause; } else {};
        if (nodes[clause].kind == callable_head_node()) { return no_node(); } else {};
        (clause <- nodes[clause].left):void;
    };
    return no_node();
}

func covers(caught:u64, category:u64) -> bool {
    return caught == no_node() || caught == exception_root_identity() || caught == category;
}

func matching_handler(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                      sites:const CompletionSites in X, at:u64, category:u64, used:u64) -> u64
    where {const owner N, const owner L, const owner F, const owner X} {
    val guard <- sites[at].guarded_by;
    val replacing <- sites[at].replacing_try;
    val clause <- no_node();
    val handler <- no_node();
    for (unused in 0u64 .. used) {
        # An enclosing guard follows the intervening finalizer's try in postorder.
        if (guard == no_node() || guard > replacing) { return no_node(); } else {};
        if (clause == no_node()) { (clause <- first_item(nodes, nodes[guard].right)):void; } else {};
        if (clause != no_node() && nodes[clause].kind == catch_clause_node()) {
            handler <- nodes[clause].right;
            if (covers(facts[nodes[handler].left].identity, category)) { return handler; } else {};
            (clause <- links[clause].next):void;
        } else { (clause <- no_node()):void; };
        if (clause == no_node()) { (guard <- sites[guard].guarded_by):void; } else {};
    };
    return no_node();
}

func record_exit(ref sites:CompletionSites in X, at:u64, event:u8, category:u64, destination:u64,
                 scope:u64, stop:u64) -> void where {owner X} {
    sites[at].event <- event;
    sites[at].category <- category;
    sites[at].destination <- destination;
    sites[at].cleanup_first <- if (scope == stop) { no_node() } else { scope };
    sites[at].cleanup_stop <- stop;
    return;
}

# Concrete failures can use this destination directly. A root contract
# still dispatches by runtime type from guarded_by, preserving catch order.
func route_failure(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:const OperandFacts in F, ref sites:CompletionSites in X, at:u64, used:u64,
                   category:u64, checked:u8, event:u8) -> u8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    val scope <- names[at].scope;
    val handler <- matching_handler(nodes, links, facts, sites, at, category, used);
    if (handler != no_node()) {
        record_exit(sites, at, event, category, handler, scope, names[nodes[handler].right].scope);
        return 0u8;
    } else {};
    val replacing <- sites[at].replacing_try;
    if (replacing != no_node()) {
        record_exit(sites, at, event, category, nodes[replacing].right, scope, names[replacing].scope);
        return 0u8;
    } else {};
    if (sites[at].in_delayed_body != 0u8) {
        return if (checked != 0u8 || category == exception_root_identity()) {
            uncovered_deferred_failure()
        } else { unproved_deferred_error() };
    } else {};
    val boundary <- enclosing_callable(nodes, names, scope);
    if (checked != 0u8 || category == exception_root_identity()) {
        val contract <- sites[boundary].throws_clause;
        if (contract == no_node() || !covers(facts[contract].identity, category)) {
            return uncovered_checked_failure();
        } else {};
    } else {};
    record_exit(sites, at, event, category, boundary, scope, no_node());
    return 0u8;
}

func record_presence(nodes:const ExprNodes in N, names:const NameBindings in B, facts:const OperandFacts in F,
                     ref sites:CompletionSites in X, at:u64) -> void
    where {const owner N, const owner B, const owner F, owner X} {
    val kind <- nodes[at].kind;
    if (kind == null_node()) {
        sites[at].presence <- absent_target();
        return;
    } else {};
    if (facts[at].reception != nullable_ptr()) { return; } else {};
    if (kind == group_node()) {
        sites[at].presence <- sites[nodes[at].left].presence;
        return;
    } else {};
    if (kind == ptr_parameter_node()) {
        sites[at].presence <- unknown_target();
        return;
    } else {};
    if (kind == ptr_binding_node()) {
        val source <- nodes[at].right;
        if (facts[source].reception == nullable_ptr() || nodes[source].kind == null_node()) {
            sites[at].presence <- sites[source].presence;
        } else {
            sites[at].presence <- present_target();
        };
        return;
    } else {};
    if (kind == name_node()) {
        sites[at].presence <- sites[names[at].declaration].presence;
        return;
    } else {};
}

func record_registration(names:const NameBindings in B, ref sites:CompletionSites in X, at:u64) -> void
    where {const owner B, owner X} {
    val scope <- names[at].scope;
    sites[at].previous_defer <- sites[scope].last_defer;
    sites[scope].last_defer <- at;
    return;
}

func can_continue(sites:const CompletionSites in X, child:u64) -> bool where {const owner X} {
    return child == no_node() || sites[child].can_continue != 0u8;
}

func can_miss_return(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                     sites:const CompletionSites in X, definition:u64) -> bool
    where {const owner N, const owner F, const owner X} {
    if (nodes[definition].kind != callable_node() || !can_continue(sites, nodes[definition].right)) { return false; } else {};
    if (!is_function(nodes, definition)) { return true; } else {};
    return facts[definition].kind != void_result() && !has_value_tail(nodes, facts, definition);
}

func operands_can_complete(nodes:const ExprNodes in N, sites:const CompletionSites in X, at:u64) -> bool
    where {const owner N, const owner X} {
    val kind <- nodes[at].kind;
    if (kind == block_item_node() || kind == argument_node() || integer_arithmetic(kind) ||
        kind == compare_node() || is_transfer(nodes, at) || kind == call_node() || kind == behave_node()) {
        return can_continue(sites, nodes[at].left) && can_continue(sites, nodes[at].right);
    } else {};
    if (kind == conditional_node()) {
        return can_continue(sites, nodes[at].left) &&
            (can_continue(sites, nodes[at].right) || can_continue(sites, nodes[at].number));
    } else {};
    if (kind == range_node()) {
        val header <- nodes[at].left;
        if (!can_continue(sites, nodes[header].left) || !can_continue(sites, nodes[header].right)) { return false; } else {};
        val body_continues <- can_continue(sites, nodes[at].right);
        val empty_continues <- can_continue(sites, nodes[at].number);
        if (literal_range(nodes, header)) {
            return if (nonempty_literal_range(nodes, header)) { body_continues } else { empty_continues };
        } else {};
        return body_continues || empty_continues;
    } else {};
    if (logical_binary(kind)) {
        val left <- nodes[at].left;
        if (!can_continue(sites, left)) { return false; } else {};
        return nodes[left].kind != bool_node() || skips_right(nodes, at) || can_continue(sites, nodes[at].right);
    } else {};
    if (kind == full_scope_node()) {
        return sites[at].local_return != 0u8 || can_continue(sites, nodes[at].left);
    } else {};
    if (kind == group_node() || kind == discard_node() || kind == block_node() ||
        kind == throw_node() || kind == return_node() || kind == deferred_call_node() || kind == logical_not_node()) {
        return can_continue(sites, nodes[at].left);
    } else {};
    if (kind == val_binding_node() || kind == ptr_binding_node()) {
        return can_continue(sites, nodes[at].right);
    } else {};
    if (kind == make_named_node()) { return can_continue(sites, construction_body(nodes, at)); } else {};
    return true;
}

func check_call_completion(nodes:const ExprNodes in N, names:const NameBindings in B,
                           links:const NameWork in L, facts:const OperandFacts in F,
                           ref sites:CompletionSites in X, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    val definition <- names[nodes[at].left].declaration;
    val declaration <- sites[definition].throws_clause;
    if (declaration == no_node()) { return 0u8; } else {};
    val category <- facts[declaration].identity;
    val checked <- facts[declaration].checked_exception;
    if (sites[at].registration != no_node()) {
        if (checked != 0u8 || category == exception_root_identity()) { return uncovered_deferred_failure(); } else {};
        # Unchecked deferred failures need the separate residual-error pass.
        return unproved_deferred_error();
    } else {};
    return route_failure(nodes, names, links, facts, sites, at, used, category, checked, possible_failure());
}

func caught_operand(nodes:const ExprNodes in N, names:const NameBindings in B, at:u64, binding:u64) -> u64
    where {const owner N, const owner B} {
    val operand <- at;
    for (unused in 0u64 .. at + 1u64) {
        if (nodes[operand].kind != group_node()) {
            if (nodes[operand].kind == name_node() && names[operand].kind == exception_binding() &&
                names[operand].declaration == binding) { return operand; } else {};
            return no_node();
        } else {};
        (operand <- nodes[operand].left):void;
    };
    return no_node();
}

func handoff_leaves_handler(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                            sites:const CompletionSites in X, at:u64, handler:u64, category:u64, used:u64) -> bool
    where {const owner N, const owner L, const owner F, const owner X} {
    val guard <- sites[at].guarded_by;
    val clause <- no_node();
    # A guard contained in the handler precedes it in postorder. Declared
    # root evidence may reach any local catch. A local finally can replace
    # the outgoing failure or use the holder while propagation owns it.
    for (unused in 0u64 .. used) {
        if (guard >= handler) { return true; } else {};
        if (clause == no_node()) { (clause <- first_item(nodes, nodes[guard].right)):void; } else {};
        if (nodes[clause].kind == finally_clause_node() || category == no_node() ||
            category == exception_root_identity()) { return false; } else {};
        if (covers(facts[nodes[nodes[clause].right].left].identity, category)) { return false; } else {};
        clause <- links[clause].next;
        if (clause == no_node()) { (guard <- sites[guard].guarded_by):void; } else {};
    };
    return false;
}

func check_throw_completion(nodes:const ExprNodes in N, names:const NameBindings in B,
                            links:const NameWork in L, facts:const OperandFacts in F,
                            ref sites:CompletionSites in X, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    val operand <- nodes[at].left;
    val incoming <- sites[at].incoming_handler;
    if (incoming == no_node()) {
        return if (operand == no_node()) { missing_rethrow_context() } else { unproved_throw_operand() };
    } else {};
    val binding <- nodes[incoming].left;
    if (operand == no_node() && names[nodes[incoming].right].scope != names[at].scope) {
        return unproved_rethrow_capture();
    } else {};
    val name <- if (operand == no_node()) { no_node() } else { caught_operand(nodes, names, operand, binding) };
    if (operand != no_node() && name == no_node()) { return unproved_throw_operand(); } else {};
    val category <- facts[binding].identity;
    if (!handoff_leaves_handler(nodes, links, facts, sites, at, incoming, category, used)) {
        return unproved_caught_handoff();
    } else {};
    sites[incoming].retains_caught <- 1u8;
    if (name != no_node()) { sites[name].forwarded_operand <- 1u8; {}; } else {};
    if (category != no_node()) {
        return route_failure(nodes, names, links, facts, sites, at, used, category,
                             facts[binding].checked_exception, definite_failure());
    } else {};
    # A catch without a type annotation can have narrower incoming failures.
    # Accept a route covering the root, or report the missing incoming proof.
    val diagnostic <- route_failure(nodes, names, links, facts, sites, at, used,
                                    exception_root_identity(), 1u8, definite_failure());
    if (diagnostic == uncovered_checked_failure()) { return unproved_incoming_exception(); } else {};
    return diagnostic;
}

func check_event(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 facts:const OperandFacts in F, ref sites:CompletionSites in X, at:u64, used:u64) -> u8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    if (sites[at].event == skipped_operand()) {
        sites[at].can_continue <- 0u8;
        return 0u8;
    } else {};
    record_presence(nodes, names, facts, sites, at);
    if (!operands_can_complete(nodes, sites, at)) {
        sites[at].can_continue <- 0u8;
        return 0u8;
    } else {};
    if (facts[at].needs_target != 0u8 && sites[at].presence != present_target()) {
        val event <- if (sites[at].presence == absent_target()) { definite_failure() } else { possible_failure() };
        if (event == definite_failure()) {
            sites[at].can_continue <- 0u8;
            {};
        } else {};
        return route_failure(nodes, names, links, facts, sites, at, used, null_pointer_identity(), 1u8, event);
    } else {};
    val kind <- nodes[at].kind;
    if (kind == argument_node() && facts[at].reception == borrowed_ref()) {
        val actual <- nodes[at].right;
        if (facts[actual].reception == nullable_ptr() && sites[actual].presence != present_target()) {
            return unproved_nonnull_argument();
        } else {};
    } else {};
    if (kind == call_node()) { return check_call_completion(nodes, names, links, facts, sites, at, used); } else {};
    if (kind == deferred_call_node() || kind == deferred_block_node()) {
        record_registration(names, sites, at);
        return 0u8;
    } else {};
    if (kind == throw_node()) {
        sites[at].can_continue <- 0u8;
        return check_throw_completion(nodes, names, links, facts, sites, at, used);
    } else {};
    if (kind == return_node()) {
        sites[at].can_continue <- 0u8;
        val scope <- names[at].scope;
        sites[scope].local_return <- 1u8;
        record_exit(sites, at, callable_return(), no_node(), scope, scope, no_node());
    } else {};
    if (facts[at].kind == never_result()) { sites[at].can_continue <- 0u8; {}; } else {};
    return 0u8;
}

# Every normal fallthrough crosses the direct items of the procedure body.
# A delayed block registered there that has no ordinary continuation
# replaces fallthrough. Any escaping language failure from it is checked
# separately against the drain's own coverage.
func has_terminal_defer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        body:u64, used:u64) -> bool
    where {const owner N, const owner L, const owner F} {
    if (nodes[body].kind != block_node()) { return false; } else {};
    val item <- first_item(nodes, nodes[body].left);
    val expression <- no_node();
    for (unused in 0u64 .. used) {
        if (item == no_node()) { return false; } else {};
        expression <- nodes[item].right;
        if (nodes[expression].kind == deferred_block_node() && facts[nodes[expression].left].kind == never_result()) {
            return true;
        } else {};
        (item <- links[item].next):void;
    };
    return false;
}

func enqueue_return_failure(ref sites:CompletionSites in X, definition:u64, count:u64) -> u64 where {owner X} {
    if (sites[definition].may_miss_return != 0u8) { return count; } else {};
    sites[definition].may_miss_return <- 1u8;
    sites[count].missing_return_work <- definition;
    return count + 1u64;
}

func propagate_return_failure(nodes:const ExprNodes in N, names:const NameBindings in B, ref sites:CompletionSites in X,
                               ref report:CompletionCheckResult in R, definition:u64, queued:u64, used:u64) -> u64
    where {const owner N, const owner B, owner X, owner R} {
    val count <- queued;
    val use <- sites[definition].missing_return_user;
    val caller <- no_node();
    for (unused in 0u64 .. used) {
        if (use == no_node()) { return count; } else {};
        if (sites[use].registration != no_node() || sites[use].in_delayed_body != 0u8) {
            report.node <- use;
            report.diagnostic <- unproved_deferred_error();
            return no_node();
        } else {};
        caller <- enclosing_callable(nodes, names, names[use].scope);
        if (nodes[caller].kind == callable_node()) { (count <- enqueue_return_failure(sites, caller, count)):void; } else {};
        (use <- sites[use].missing_return_user):void;
    };
    return count;
}

# An unchecked missing return may cross ordinary calls. Follow reverse
# call edges to closure before admitting a deferred invocation, where a
# residual failure would require the deferred-error queue.
func check_missing_return_paths(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                                facts:const OperandFacts in F, ref sites:CompletionSites in X,
                                ref report:CompletionCheckResult in R, used:u64) -> bool
    where {const owner N, const owner B, const owner L, const owner F, owner X, owner R} {
    val count <- 0u64;
    val definition <- no_node();
    for (at in 0u64 .. used) {
        if (can_miss_return(nodes, facts, sites, at) &&
            !has_terminal_defer(nodes, links, facts, nodes[at].right, used)) {
            (count <- enqueue_return_failure(sites, at, count)):void;
        } else {};
        if (nodes[at].kind == throw_node() && sites[at].category == missing_return_identity()) {
            definition <- enclosing_callable(nodes, names, names[at].scope);
            if (sites[at].destination == definition && nodes[definition].kind == callable_node()) {
                (count <- enqueue_return_failure(sites, definition, count)):void;
            } else {};
        } else {};
    };
    if (count == 0u64) { return true; } else {};
    for (at in 0u64 .. used) {
        if (nodes[at].kind == call_node() && can_continue(sites, at) &&
            (sites[at].registration != no_node() || (sites[at].replacing_try == no_node() &&
             matching_handler(nodes, links, facts, sites, at, missing_return_identity(), used) == no_node()))) {
            definition <- names[nodes[at].left].declaration;
            sites[at].missing_return_user <- sites[definition].missing_return_user;
            sites[definition].missing_return_user <- at;
            {};
        } else {};
    };
    for (item in 0u64 .. used) {
        if (item == count) { return true; } else {};
        count <- propagate_return_failure(nodes, names, sites, report, sites[item].missing_return_work, count, used);
        if (count == no_node()) { return false; } else {};
    };
    return true;
}

# The inputs are the same bound module revision. Cleanup links describe
# candidates in reverse registration order. Taking a link on an actual exit
# still depends on whether its registration succeeded on the executed path.
func check_module_completion(nodes:const ExprNodes in N, tree:const ParseResult in T,
                             names:const NameBindings in B, links:const NameWork in L, facts:const OperandFacts in F,
                             ref sites:CompletionSites in X, ref report:CompletionCheckResult in R) -> bool
    where {const owner N, const owner T, const owner B, const owner L, const owner F, owner X, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_completion_tree();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) { return false; } else {};
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(facts) < tree.used || intrinsic (len)(sites) < tree.used) {
        report.diagnostic <- completion_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        initialize_site(sites, at);
        if (nodes[at].kind == callable_node()) {
            sites[at].throws_clause <- declared_throw(nodes, at);
            {};
        } else {};
    };
    val site <- tree.root;
    # Syntax is postorder, so a reverse visit supplies each child's context
    # before the child is visited. Ordinary brace groups keep that context.
    for (offset in 0u64 .. tree.used) {
        site <- tree.root - offset;
        prepare_context(nodes, facts, sites, site);
    };
    for (at in 0u64 .. tree.used) {
        report.diagnostic <- check_event(nodes, names, links, facts, sites, at, tree.used);
        if (report.diagnostic != 0u8) { report.node <- at; return false; } else {};
    };
    return check_missing_return_paths(nodes, names, links, facts, sites, report, tree.used);
}

