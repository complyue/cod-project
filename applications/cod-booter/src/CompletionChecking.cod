export data CompletionSite {
    event:UInt8,
    presence:UInt8,
    can_continue:UInt8,
    local_return:UInt8,
    retains_caught:UInt8,
    forwarded_operand:UInt8,
    in_delayed_body:UInt8,
    in_supplied_body:bool,
    array_read_completion:ArrayReadCompletion,
    numeric_fault:bool,
    slot_summary:bool,
    array_failures:ByteArrayFailures,
    case_break:UInt8,
    case_scan:UInt8,
    guarded_by:UInt64,
    incoming_handler:UInt64,
    throws_clause:UInt64,
    category:UInt64,
    category_module:UInt64,
    destination:UInt64,
    cleanup_first:UInt64,
    cleanup_stop:UInt64,
    registration:UInt64,
    previous_defer:UInt64,
    last_defer:UInt64,
    replacing_try:UInt64,
}
export array CompletionSites[UInt64]:CompletionSite;

export data CompletionCheckResult {
    diagnostic:UInt8,
    node:UInt64,
}

export func possible_failure() -> UInt8 { return 1u8; }
export func definite_failure() -> UInt8 { return 2u8; }
export func callable_return() -> UInt8 { return 3u8; }
export func skipped_operand() -> UInt8 { return 4u8; }
func case_scan_resume() -> UInt8 { return 5u8; }

export func uncovered_checked_failure() -> UInt8 { return 1u8; }
export func uncovered_deferred_failure() -> UInt8 { return 2u8; }
export func unproved_deferred_error() -> UInt8 { return 3u8; }
export func missing_rethrow_context() -> UInt8 { return 4u8; }
export func unproved_rethrow_capture() -> UInt8 { return 5u8; }
export func completion_storage_exhausted() -> UInt8 { return 7u8; }
export func invalid_completion_tree() -> UInt8 { return 8u8; }
export func unproved_incoming_exception() -> UInt8 { return 9u8; }
export func unproved_throw_operand() -> UInt8 { return 10u8; }
export func unproved_caught_handoff() -> UInt8 { return 11u8; }
func unproved_nonnull_argument() -> UInt8 { return 12u8; }
func unproved_nonnull_binding() -> UInt8 { return 16u8; }
export func unsupported_case_transfer() -> UInt8 { return 18u8; }
func unproved_byte_completion() -> UInt8 { return 20u8; }
func unproved_numeric_fault_route() -> UInt8 { return 21u8; }

func initialize_site(sites:CompletionSites in X, at:UInt64) -> void where {owner X} {
    sites[at].event <- 0u8;
    sites[at].presence <- 0u8;
    sites[at].can_continue <- 1u8;
    sites[at].local_return <- 0u8;
    sites[at].retains_caught <- 0u8;
    sites[at].forwarded_operand <- 0u8;
    sites[at].in_delayed_body <- 0u8;
    sites[at].in_supplied_body <- false;
    sites[at].array_read_completion <- NoArrayRead;
    sites[at].numeric_fault <- false;
    sites[at].slot_summary <- false;
    sites[at].array_failures.bounds <- false;
    sites[at].array_failures.out_of_memory <- false;
    sites[at].array_failures.region_capacity <- false;
    sites[at].array_failures.invalid_capacity <- false;

    sites[at].case_break <- 0u8;
    sites[at].case_scan <- 0u8;
    sites[at].guarded_by <- no_node();
    sites[at].incoming_handler <- no_node();
    sites[at].throws_clause <- no_node();
    sites[at].category <- no_node();
    sites[at].category_module <- 0u64;
    sites[at].destination <- no_node();
    sites[at].cleanup_first <- no_node();
    sites[at].cleanup_stop <- no_node();
    sites[at].registration <- no_node();
    sites[at].previous_defer <- no_node();
    sites[at].last_defer <- no_node();
    sites[at].replacing_try <- no_node();
    return;
}

func inherit_context(sites:CompletionSites in X, parent:UInt64, child:UInt64, guarded_by:UInt64, incoming_handler:UInt64,
                     replacing_try:UInt64) -> void
    where {owner X} {
    if (child == no_node()) return;
    sites[child].guarded_by <- guarded_by;
    sites[child].incoming_handler <- incoming_handler;
    sites[child].replacing_try <- replacing_try;
    sites[child].in_delayed_body <- sites[parent].in_delayed_body;
    sites[child].in_supplied_body <- sites[parent].in_supplied_body;
    if (sites[parent].event == skipped_operand()) { (sites[child].event <- skipped_operand()):void; } else {};
    return;
}

func prepare_context(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                     sites:CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner F, owner X} {
    val guard <- sites[at].guarded_by;
    val incoming <- sites[at].incoming_handler;
    val replacing <- sites[at].replacing_try;
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (inspect_range_loop(nodes, revision, used, at, loop) &&
        inspect_range_header(nodes, revision, used, loop.header, bounds)) {
        inherit_context(sites, at, loop.header, guard, incoming, replacing);
        inherit_context(sites, at, loop.body, guard, incoming, replacing);
        inherit_context(sites, at, loop.empty, guard, incoming, replacing);
        val bounds_stop <- facts[bounds.lower].kind == never_result() || facts[bounds.upper].kind == never_result();
        val shape <- classify_literal_range(nodes, revision, used, loop.header);
        if (bounds_stop || shape == EmptyLiteralRange) { (sites[loop.body].event <- skipped_operand()):void; };
        if (loop.empty != no_node() && (bounds_stop || shape == NonemptyLiteralRange)) {
            (sites[loop.empty].event <- skipped_operand()):void;
        };
        return;
    };
    if (inspect_range_header(nodes, revision, used, at, bounds)) {
        inherit_context(sites, at, bounds.lower, guard, incoming, replacing);
        inherit_context(sites, at, bounds.upper, guard, incoming, replacing);
        if (facts[bounds.lower].kind == never_result()) { (sites[bounds.upper].event <- skipped_operand()):void; };
        return;
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, revision, used, at, assignment);
    if (mode == PlaceTransfer || mode == PlaceRebind || mode == FieldTransfer ||
        mode == FieldRebind || mode == AugmentedPlaceTransfer) {
        inherit_context(sites, at, assignment.destination, guard, incoming, replacing);
        inherit_context(sites, at, assignment.input, guard, incoming, replacing);
        if ((mode == AugmentedPlaceTransfer ||
                (mode == PlaceTransfer && facts[assignment.destination].checks_array_bounds)) &&
            facts[assignment.destination].kind == never_result()) {
            (sites[assignment.input].event <- skipped_operand()):void
        };
        return;
    };
    if (facts[at].checks_array_bounds) {
        ref index = make IndexSites { target <- no_node(); index <- no_node() };
        if (inspect_index_selection(nodes, revision, used, at, index)) {
            inherit_context(sites, at, index.target, guard, incoming, replacing);
            inherit_context(sites, at, index.index, guard, incoming, replacing);
            if (facts[index.target].kind == never_result()) {
                (sites[index.index].event <- skipped_operand()):void
            };
            return
        }
    };
    ref inner = make UInt64 { no_node() };
    if (inspect_group(nodes, revision, used, at, inner) == ParenthesizedExpression) {
        inherit_context(sites, at, inner, guard, incoming, replacing);
        return;
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val construction_form <- inspect_construction(nodes, revision, used, at, construction);
    if (construction_form == StorageReservation || construction_form == PositionalConstruction || construction_form == BracedConstruction) {
        inherit_context(sites, at, construction.contents, guard, incoming, replacing);
        return;
    };
    ref constructed = make NamedThrowSites { requested <- no_node(); fields <- no_node(); cause <-
        no_node(); };
    if (inspect_named_throw(nodes, revision, used, at, constructed)) {
        inherit_context(sites, at, constructed.fields, guard, incoming, replacing);
        return;
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr) {
        inherit_context(sites, at, logical.left_operand, guard, incoming, replacing);
        if (operation != LogicalNot) {
            inherit_context(sites, at, logical.right_operand, guard, incoming, replacing);
            if (facts[logical.left_operand].kind == never_result() || logical.right_evaluation == SkipsRhs) {
                (sites[logical.right_operand].event <- skipped_operand()):void;
            };
        };
        return;
    };
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    val defer_shape <- inspect_defer(nodes, revision, used, at, deferred);
    if (defer_shape == DeferBody) {
        inherit_context(sites, at, deferred.operand, no_node(), no_node(), no_node());
        (sites[deferred.operand].in_delayed_body <- 1u8):void;
        return;
    };
    if (defer_shape == DeferCall) {
        sites[deferred.invocation].registration <- at;
        inherit_context(sites, at, deferred.operand, guard, incoming, replacing);
        return;
    };
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    if (inspect_protected(nodes, revision, used, at, protected)) {
        if (inspect_guard_clause(nodes, revision, used, protected.clauses, clause) == CleanupClause &&
            facts[clause.target].kind == never_result()) { (replacing <- at):void; };
        inherit_context(sites, at, protected.body, at, incoming, replacing);
        inherit_context(sites, at, protected.clauses, guard, incoming, replacing);
        return;
    };
    if (inspect_guard_clause(nodes, revision, used, at, clause) == CleanupClause) {
        inherit_context(sites, at, clause.previous, guard, incoming, replacing);
        if (replacing != no_node() && inspect_protected(nodes, revision, used, replacing, protected) &&
            protected.clauses == at) { (replacing <- sites[replacing].replacing_try):void; };
        inherit_context(sites, at, clause.target, guard, incoming, replacing);
        return;
    };
    ref caught = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (inspect_handler(nodes, revision, used, at, caught)) {
        inherit_context(sites, at, caught.body, guard, at, replacing);
        return;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val callable_form <- inspect_callable(nodes, revision, used, at, callable);
    if (callable_form == ModuleCallable || callable_form == LexicalCallable || callable_form == CEntry) {
        inherit_context(sites, at, callable.body, no_node(), no_node(), no_node());
        return;
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch)) {
        inherit_context(sites, at, branch.test, guard, incoming, replacing);
        inherit_context(sites, at, branch.consequent, guard, incoming, replacing);
        inherit_context(sites, at, branch.alternative, guard, incoming, replacing);
        return;
    };
    ref choice = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (inspect_case(nodes, revision, used, at, choice)) {
        inherit_context(sites, at, choice.subject, guard, incoming, replacing);
        inherit_context(sites, at, choice.items, guard, incoming, replacing);
        return;
    };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (inspect_case_arm(nodes, revision, used, at, arm)) {
        inherit_context(sites, at, arm.guard, guard, incoming, replacing);
        inherit_context(sites, at, arm.body, guard, incoming, replacing);
        if (arm.guard != no_node() && facts[at].case_match == misses_case_arm()) {
            (sites[arm.guard].event <- skipped_operand()):void;
        };
        if (facts[at].case_body == 0u8) { (sites[arm.body].event <- skipped_operand()):void; };
        return;
    };
    ref sequence = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val role <- inspect_sequence_entry(nodes, revision, used, at, sequence);
    if (role == ModuleSequence || role == BlockSequence || role == ArgumentSequence || role == ClauseSequence) {
        inherit_context(sites, at, sequence.previous, guard, incoming, replacing);
        inherit_context(sites, at, sequence.item, guard, incoming, replacing);
        if (role == BlockSequence && facts[at].case_item == unreachable_case_item()) {
            (sites[sequence.item].event <- skipped_operand()):void;
        };
        return;
    };
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val binary_shape <- inspect_binary(nodes, revision, used, at, binary);
    if (binary_shape == ArithmeticBinary || binary_shape == ComparisonBinary) {
        inherit_context(sites, at, binary.left_operand, guard, incoming, replacing);
        inherit_context(sites, at, binary.right_operand, guard, incoming, replacing);
        if (binary_shape == ArithmeticBinary && facts[binary.left_operand].kind == never_result()) {
            (sites[binary.right_operand].event <- skipped_operand()):void;
        };
        return;
    };
    ref supplied = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node();
        body <- no_node(); full_scope <- false
    };
    if (inspect_here_invocation(nodes, revision, used, at, supplied) == HereReady) {
        inherit_context(sites, at, supplied.call, guard, incoming, replacing);
        inherit_context(sites, at, supplied.body, guard, incoming, replacing);
        sites[supplied.body].in_supplied_body <- true;
        return
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    val invocation <- inspect_invocation(nodes, revision, used, at, call);
    if (invocation == OrdinaryInvocation || invocation == EffectfulInvocation) {
        inherit_context(sites, at, call.callee, guard, incoming, replacing);
        inherit_context(sites, at, call.arguments, guard, incoming, replacing);
        return;
    };
    ref binding = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, revision, used, at, binding) && binding.mode != ExceptionLocal) {
        inherit_context(sites, at, binding.initializer, guard, incoming, replacing);
        return;
    };
    ref handle = make BoundHandleSites {
        binding <- no_node(); initializer <- no_node(); readonly <- false
    };
    val binding_form <- inspect_handle_binding(nodes, revision, used, at, handle);
    if (binding_form == OwnHandleBinding || binding_form == BorrowHandleBinding) {
        inherit_context(sites, at, handle.initializer, guard, incoming, replacing);
        return
    };
    ref acquisition = make HandleConstructionSites {
        marker <- no_node(); arguments <- no_node(); actual_owner <- no_node()
    };
    val acquisition_form <- inspect_handle_construction(nodes, revision, used, at, acquisition);
    if (acquisition_form == OwnHandleMake || acquisition_form == BorrowHandleMake) {
        inherit_context(sites, at, acquisition.arguments, guard, incoming, replacing);
        return
    };
    ref child = make UInt64 { no_node() };
    if (module_tail(nodes, revision, used, at, child) || block_tail(nodes, revision, used, at, child) ||
        completion_operand(nodes, revision, used, at, child) ||
        direct_operand(nodes, revision, used, at, facts[at].enum_constant == 0u8, child)) {
        inherit_context(sites, at, child, guard, incoming, replacing);
    };
}

func direct_operand(nodes:const ExprNodes in N, revision:UInt64, used:UInt64, at:UInt64, runtime_assertion:bool,
                    child:UInt64 in R) -> bool where {const owner N, owner R} {
    if (at >= used || at >= syntax_len(nodes)) return false;
    if (native_installation_input(nodes, revision, used, at, child)) return true;
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, revision, used, at, field)) {
        child <- field.receiver;
        return true;
    };
    return case nodes[at] of {
        (Vacant) -> { false };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (BindSymbolEffect { val input <-, }) -> {
                    if (!published_syntax_id(nodes, revision, at, input)) return false;
                    (child <- input.index):void;
                    true
                };
                (DiscardedExpression { val operand <- operand, }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return false;
                    child <- operand.index;
                    true
                };
                (PredicateAssertion { val predicate <-, }) -> {
                    if (!published_syntax_id(nodes, revision, at, predicate)) return false;
                    (child <- predicate.index):void;
                    true
                };
                (CheckedTypeAssertion { val operand <- operand, }) -> {
                    if (!runtime_assertion || !published_syntax_id(nodes, revision, at, operand)) return false;
                    child <- operand.index;
                    true
                };
                (RaiseValue { val operand <- exception_value, }) -> {
                    if (!published_syntax_id(nodes, revision, at, operand)) return false;
                    child <- operand.index;
                    true
                };
                (RaisePending) -> { child <- no_node(); true };
                (_) -> { false };
            }
        };
    };
}

func covers(facts:const OperandFacts in F, expected:UInt64, module:UInt64, category:UInt64,
    checked:UInt8) -> bool where {const owner F} {
    return exception_type_covers(facts[expected].identity_module, facts[expected].identity, module,
        category, checked != 0u8);
}

func first_guard_clause(nodes:const ExprNodes in N, revision:UInt64, used:UInt64,
                         guard:UInt64, clause:UInt64 in R) -> bool where {const owner N, owner R} {
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    return inspect_protected(nodes, revision, used, guard, protected) &&
        first_sequence_entry(nodes, revision, used, protected.clauses, ClauseSequence, clause);
}

func matching_handler(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                      sites:const CompletionSites in X, at:UInt64, module:UInt64, category:UInt64,
                          checked:UInt8, used:UInt64, revision:UInt64) -> UInt64
    where {const owner N, const owner L, const owner F, const owner X} {
    val guard <- sites[at].guarded_by;
    val replacing <- sites[at].replacing_try;
    ref clause = make UInt64 { no_node() };
    ref selected = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref handler = make HandlerSites { binding <- no_node(); body <- no_node(); };
    for (unused in 0u64 .. used) {
        # An enclosing guard follows the intervening finalizer's try in postorder.
        if (guard == no_node() || guard > replacing) return no_node();
        if (clause == no_node() && !first_guard_clause(nodes, revision, used, guard, clause)) return no_node();
        if (inspect_guard_clause(nodes, revision, used, clause, selected) == HandlerClause) {
            if (!inspect_handler(nodes, revision, used, selected.target, handler)) return no_node();
            if (covers(facts, handler.binding, module, category, checked)) return selected.target;
            (clause <- links[clause].next):void;
        } else { (clause <- no_node()):void; };
        if (clause == no_node()) { (guard <- sites[guard].guarded_by):void; };
    };
    return no_node();
}

func record_exit(sites:CompletionSites in X, at:UInt64, event:UInt8, category:UInt64, destination:UInt64,
                 scope:UInt64, stop:UInt64) -> void where {owner X} {
    sites[at].event <- event;
    sites[at].category <- category;
    sites[at].destination <- destination;
    sites[at].cleanup_first <- if (scope == stop) { no_node() } else { scope };
    sites[at].cleanup_stop <- stop;
    return;
}

# Concrete failures can use this destination directly. A root contract
# still dispatches by runtime type from guarded_by, preserving catch order.
func route_exception(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L,
                     facts:const OperandFacts in F, sites:CompletionSites in X, at:UInt64, used:UInt64,
                         revision:UInt64,
                     module:UInt64, category:UInt64, checked:UInt8, event:UInt8) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    val scope <- names[at].scope;
    sites[at].category_module <- module;
    val handler <- matching_handler(nodes, links, facts, sites, at, module, category, checked, used,
        revision);
    if (handler != no_node()) {
        ref catch_site = make HandlerSites { binding <- no_node(); body <- no_node(); };
        if (!inspect_handler(nodes, revision, used, handler, catch_site)) return invalid_completion_tree();
        record_exit(sites, at, event, category, handler, scope, names[catch_site.body].scope);
        return 0u8;
    } else {};
    val replacing <- sites[at].replacing_try;
    if (replacing != no_node()) {
        ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
        if (!inspect_protected(nodes, revision, used, replacing, protected)) return invalid_completion_tree();
        record_exit(sites, at, event, category, protected.clauses, scope, names[replacing].scope);
        return 0u8;
    } else {};
    if (sites[at].in_delayed_body != 0u8)
        return if (checked != 0u8 || (module == 0u64 && category == exception_root_identity())) {
            uncovered_deferred_failure()
        } else { unproved_deferred_error() };
    val boundary <- enclosing_callable(nodes, names, scope);
    if (checked != 0u8 || (module == 0u64 && category == exception_root_identity())) {
        val contract <- sites[boundary].throws_clause;
        if (contract == no_node() || !covers(facts, contract, module, category, checked))
            return uncovered_checked_failure();
    } else {};
    record_exit(sites, at, event, category, boundary, scope, no_node());
    return 0u8;
}

func route_failure(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L,
                   facts:const OperandFacts in F, sites:CompletionSites in X, at:UInt64, used:UInt64,
                       revision:UInt64,
                   category:UInt64, checked:UInt8, event:UInt8) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    return route_exception(nodes, names, links, facts, sites, at, used, revision, 0u64, category,
        checked, event);
}

func record_registration(names:const NameBindings in B, sites:CompletionSites in X, at:UInt64) -> void
    where {const owner B, owner X} {
    val scope <- names[at].scope;
    sites[at].previous_defer <- sites[scope].last_defer;
    sites[scope].last_defer <- at;
    return;
}

export func can_continue(sites:const CompletionSites in X, child:UInt64) -> bool where {const owner X} {
    return child == no_node() || sites[child].can_continue != 0u8;
}

export func can_miss_return(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                            sites:const CompletionSites in X, definition:UInt64, revision:UInt64, used:UInt64) -> bool
    where {const owner N, const owner F, const owner X} {
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val form <- inspect_callable(nodes, revision, used, definition, callable);
    if ((form != ModuleCallable && form != LexicalCallable) || !can_continue(sites, callable.body))
        return false;
    if (!callable.function_form) {
        if (facts[definition].kind != void_result()) return true;
        ref result_clause = make UInt64 { no_node() };
        return !find_signature_clause(nodes, revision, used, callable.signature, ValueResultClause, result_clause) ||
            result_clause == no_node()
    };
    return facts[definition].kind != void_result() && !has_value_tail(facts, callable.body, callable.function_form);
}

func operands_can_complete(nodes:const ExprNodes in N, sites:const CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner X} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    if (inspect_range_loop(nodes, revision, used, at, loop)) {
        ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
        if (!inspect_range_header(nodes, revision, used, loop.header, bounds) ||
            !can_continue(sites, bounds.lower) || !can_continue(sites, bounds.upper)) return false;
        val body_continues <- can_continue(sites, loop.body);
        val empty_continues <- can_continue(sites, loop.empty);
        return case classify_literal_range(nodes, revision, used, loop.header) of {
            (NonemptyLiteralRange) -> { body_continues };
            (EmptyLiteralRange) -> { empty_continues };
            (_) -> { body_continues || empty_continues };
        };
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, revision, used, at, assignment);
    if (mode == PlaceTransfer || mode == PlaceRebind || mode == FieldTransfer ||
        mode == FieldRebind || mode == AugmentedPlaceTransfer)
        return can_continue(sites, assignment.destination) && can_continue(sites, assignment.input);
    ref index = make IndexSites { target <- no_node(); index <- no_node() };
    if (inspect_index_selection(nodes, revision, used, at, index))
        return can_continue(sites, index.target) && can_continue(sites, index.index);
    ref inner = make UInt64 { no_node() };
    if (inspect_group(nodes, revision, used, at, inner) == ParenthesizedExpression) return can_continue(sites, inner);
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, revision, used, at, construction);
    if (shape == StorageReservation || shape == PositionalConstruction || shape == BracedConstruction)
        return can_continue(sites, construction.contents);
    ref acquisition = make HandleConstructionSites {
        marker <- no_node(); arguments <- no_node(); actual_owner <- no_node();
    };
    val acquisition_form <- inspect_handle_construction(nodes, revision, used, at, acquisition);
    if (acquisition_form == OwnHandleMake || acquisition_form == BorrowHandleMake)
        return can_continue(sites, acquisition.arguments);
    ref handle = make BoundHandleSites {
        binding <- no_node(); initializer <- no_node(); readonly <- false;
    };
    val handle_form <- inspect_handle_binding(nodes, revision, used, at, handle);
    if (handle_form == OwnHandleBinding || handle_form == BorrowHandleBinding)
        return can_continue(sites, handle.initializer);
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    if (operation == InvalidLogical) return false;
    if (operation == LogicalNot) return can_continue(sites, logical.left_operand);
    if (operation == LogicalAnd || operation == LogicalOr)
        return can_continue(sites, logical.left_operand) &&
            (logical.right_evaluation != TakesRhs || can_continue(sites, logical.right_operand));
    ref sequence = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val role <- inspect_sequence_entry(nodes, revision, used, at, sequence);
    if (role == BlockSequence || role == ArgumentSequence)
        return can_continue(sites, sequence.previous) && can_continue(sites, sequence.item);
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val binary_shape <- inspect_binary(nodes, revision, used, at, binary);
    if (binary_shape == ArithmeticBinary || binary_shape == ComparisonBinary)
        return can_continue(sites, binary.left_operand) && can_continue(sites, binary.right_operand);
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    val invocation <- inspect_invocation(nodes, revision, used, at, call);
    if (invocation == OrdinaryInvocation || invocation == EffectfulInvocation)
        return can_continue(sites, call.callee) && can_continue(sites, call.arguments);
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch))
        return can_continue(sites, branch.test) &&
            (can_continue(sites, branch.consequent) || can_continue(sites, branch.alternative));
    ref defer_sites = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    if (inspect_defer(nodes, revision, used, at, defer_sites) == DeferCall) return can_continue(sites, defer_sites.operand);
    ref child = make UInt64 { no_node() };
    if (block_tail(nodes, revision, used, at, child))
        return (is_scope_block(nodes, at) && sites[at].local_return != 0u8) || can_continue(sites, child);
    if (completion_operand(nodes, revision, used, at, child) || direct_operand(nodes, revision, used, at, true, child))
        return can_continue(sites, child);
    ref binding = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, revision, used, at, binding) && binding.mode != ExceptionLocal)
        return can_continue(sites, binding.initializer);
    return true;
}

func check_call_completion(nodes:const ExprNodes in N, names:const NameBindings in B,
                           links:const NameWork in L, facts:const OperandFacts in F,
                           sites:CompletionSites in X, at:UInt64, module:UInt64, category:UInt64, checked:UInt8,
                               used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    if (category == no_node()) return 0u8;
    if (sites[at].registration != no_node()) {
        if (checked != 0u8 || (module == 0u64 && category == exception_root_identity()))
            return uncovered_deferred_failure();
        # Unchecked deferred failures need the separate residual-error pass.
        return unproved_deferred_error();
    } else {};
    return route_exception(nodes, names, links, facts, sites, at, used, revision, module, category,
        checked, possible_failure());
}

func caught_operand(nodes:const ExprNodes in N, names:const NameBindings in B,
                    at:UInt64, binding:UInt64, revision:UInt64, used:UInt64) -> UInt64 where {const owner N, const owner B} {
    val operand <- ungrouped(nodes, revision, used, at);
    if (name_syntax(nodes, used, operand) == OrdinaryName && names[operand].kind == exception_binding() &&
        names[operand].declaration == binding) return operand;
    return no_node();
}

func handoff_leaves_handler(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                            sites:const CompletionSites in X, at:UInt64, handler:UInt64, binding:UInt64,
                                used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner L, const owner F, const owner X} {
    val guard <- sites[at].guarded_by;
    ref clause = make UInt64 { no_node() };
    ref selected = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref nested = make HandlerSites { binding <- no_node(); body <- no_node(); };
    val category <- facts[binding].identity;
    val module <- facts[binding].identity_module;
    # A guard contained in the handler precedes it in postorder. Declared
    # root evidence may reach any local catch. A local finally can replace
    # the outgoing failure or use the holder while propagation owns it.
    for (unused in 0u64 .. used) {
        if (guard >= handler) return true;
        if (clause == no_node() && !first_guard_clause(nodes, revision, used, guard, clause)) return false;
        if (inspect_guard_clause(nodes, revision, used, clause, selected) != HandlerClause || category == no_node() ||
            (module == 0u64 && category == exception_root_identity()) || !inspect_handler(nodes,
                revision, used, selected.target, nested)) return false;
        if (covers(facts, nested.binding, module, category,
            facts[binding].checked_exception)) return false;
        clause <- links[clause].next;
        if (clause == no_node()) { (guard <- sites[guard].guarded_by):void; } else {};
    };
    return false;
}

func check_throw_completion(nodes:const ExprNodes in N, names:const NameBindings in B,
                            links:const NameWork in L, facts:const OperandFacts in F,
                            sites:CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, owner X} {
    ref operand = make UInt64 { no_node() };
    if (!direct_operand(nodes, revision, used, at, false, operand)) return invalid_completion_tree();
    val incoming <- sites[at].incoming_handler;
    if (incoming == no_node())
        return if (operand == no_node()) { missing_rethrow_context() } else { unproved_throw_operand() };
    ref caught = make HandlerSites { binding <- no_node(); body <- no_node(); };
    if (!inspect_handler(nodes, revision, used, incoming, caught)) return invalid_completion_tree();
    val binding <- caught.binding;
    if (operand == no_node() && names[caught.body].scope != names[at].scope)
        return unproved_rethrow_capture();
    val name <- if (operand == no_node()) { no_node() } else { caught_operand(nodes, names, operand, binding, revision, used) };
    if (operand != no_node() && name == no_node()) return unproved_throw_operand();
    val category <- facts[binding].identity;
    if (!handoff_leaves_handler(nodes, links, facts, sites, at, incoming, binding, used, revision))
        return unproved_caught_handoff();
    sites[incoming].retains_caught <- 1u8;
    if (name != no_node()) { sites[name].forwarded_operand <- 1u8; {}; } else {};
    if (category != no_node())
        return route_exception(nodes, names, links, facts, sites, at, used, revision,
            facts[binding].identity_module, category,
                             facts[binding].checked_exception, definite_failure());
    # A catch without a type annotation can have narrower incoming failures.
    # Accept a route covering the root, or report the missing incoming proof.
    val diagnostic <- route_failure(nodes, names, links, facts, sites, at, used, revision,
                                    exception_root_identity(), 1u8, definite_failure());
    if (diagnostic == uncovered_checked_failure()) return unproved_incoming_exception();
    return diagnostic;
}

func case_can_complete(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                       sites:const CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64,
                       choice:const CaseSites in I) -> bool
    where {const owner N, const owner L, const owner F, const owner X, const owner I} {
    if (!can_continue(sites, choice.subject)) return false;
    if (facts[at].case_end != 0u8 || sites[at].case_break != 0u8) return true;
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, choice.items, BlockSequence, item)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    for (unused in 0u64 .. used) {
        if (item == no_node()) return false;
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return false;
        if (inspect_case_arm(nodes, revision, used, entry.item, arm) && facts[entry.item].case_body != 0u8 &&
            can_continue(sites, arm.guard) && can_continue(sites, arm.body)) return true;
        item <- links[item].next;
    };
    return false;
}

func check_case_transfer(nodes:const ExprNodes in N, names:const NameBindings in B, facts:const OperandFacts in F,
                         sites:CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64, breaking:bool) -> UInt8
    where {const owner N, const owner B, const owner F, owner X} {
    val target <- names[at].declaration;
    val scope <- names[at].scope;
    val stop <- names[target].scope;
    if (scope != stop) {
        ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
        if (breaking || !inspect_case_arm(nodes, revision, used, target, arm) ||
            arm.body != scope || !is_scope_block(nodes, scope)) return unsupported_case_transfer();
        record_exit(sites, at, case_scan_resume(), no_node(), target, scope, stop);
    } else {};
    sites[at].can_continue <- 0u8;
    val cleanup <- names[at].finalizer;
    val boundary <- names[target].finalizer;
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref clause = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (cleanup == boundary) {
            if (breaking) { (sites[target].case_break <- 1u8):void; } else {};
            return 0u8;
        } else {};
        if (cleanup == no_node()) return invalid_completion_tree();
        if (breaking) { (sites[cleanup].case_break <- 1u8):void; }
        else { (sites[cleanup].case_scan <- 1u8):void; };
        if (!inspect_protected(nodes, revision, used, cleanup, protected) ||
            inspect_guard_clause(nodes, revision, used, protected.clauses, clause) != CleanupClause)
            return invalid_completion_tree();
        if (facts[clause.target].kind == never_result()) return 0u8;
        cleanup <- names[cleanup].finalizer;
    };
    return invalid_completion_tree();
}

# Immediate calls use the abrupt exit, which bypasses catches and runs
# lexical cleanup and finally. Delayed and supplied calls have separate
# completion boundaries; an active defer also still needs its own proof.
func supports_immediate_numeric_exit(nodes:const ExprNodes in N, names:const NameBindings in B,
    sites:const CompletionSites in X, at:UInt64, used:UInt64) -> bool
    where {const owner N, const owner B, const owner X} {
    if (sites[at].in_supplied_body) return false;
    val scope <- names[at].scope;
    for (unused in 0u64 .. used) {
        if (scope == no_node()) return true;
        if (scope >= used || sites[scope].last_defer != no_node()) return false;
        if (!is_scope_block(nodes, scope)) return true;
        scope <- names[scope].scope
    };
    return false
}

func requires_byte_completion(views:const SuppliedViews in V, demand:const DeclarationDemands in D,
    definition:UInt64) -> bool where {const owner V, const owner D} {
    return if (intrinsic (len)(demand) == 0u64) { prepared_byte_function(views, definition, false) }
        else { definition < intrinsic (len)(demand) && demand[definition].requires_byte_completion }
}

func check_event(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 facts:const OperandFacts in F, views:const SuppliedViews in H,
                 demand:const DeclarationDemands in D, constructions:const ExceptionConstructionFacts in E,
                 sites:CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64, text_oom:bool) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, const owner H, const owner D, const owner E, owner X} {
    if (sites[at].event == skipped_operand()) {
        sites[at].can_continue <- 0u8;
        return 0u8;
    } else {};
    sites[at].presence <- selected_target_presence(facts, at);
    if (!operands_can_complete(nodes, sites, at, used, revision)) {
        sites[at].can_continue <- 0u8;
        return 0u8;
    } else {};
    val initializer_read <- at < intrinsic (len)(constructions) && (case constructions[at] of {
        ExceptionInitializerTargetRead -> true;
        _ -> false
    });
    val target <- if (facts[at].needs_target != 0u8 || initializer_read) { at } else { no_node() };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    if (inspect_sequence_entry(nodes, revision, used, at, entry) == ArgumentSequence && facts[at].reception == borrowed_ref()) {
        val actual <- entry.item;
        if (facts[actual].reception == nullable_ptr() && sites[actual].presence != present_target()) {
            if (!checked_ref_argument(nodes, at)) return unproved_nonnull_argument();
            (target <- actual):void;
        } else {};
    } else {};
    if (target != no_node() && sites[target].presence != present_target()) {
        val event <- if (sites[target].presence == absent_target()) { definite_failure() } else { possible_failure() };
        if (event == definite_failure()) {
            sites[at].can_continue <- 0u8;
            {};
        } else {};
        return route_failure(nodes, names, links, facts, sites, at, used, revision, null_pointer_identity(), 1u8, event);
    } else {};
    ref binding = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, revision, used, at, binding) && binding.mode == ReferenceLocal &&
        facts[binding.initializer].reception == nullable_ptr() &&
        sites[binding.initializer].presence != present_target()) return unproved_nonnull_binding();
    if (facts[at].predicate_assertion_check)
        return route_failure(nodes, names, links, facts, sites, at, used, revision,
            assertion_failed_identity(), 0u8, possible_failure());
    if (facts[at].text_assertion != 0u8 || facts[at].enum_assertion_check)
        return route_failure(nodes, names, links, facts, sites, at, used, revision, type_assertion_failed_identity(), 0u8, possible_failure());
    if (facts[at].checks_array_bounds)
        return route_failure(nodes, names, links, facts, sites, at, used, revision,
            index_out_of_bounds_identity(), 0u8, possible_failure());
    if (facts[at].allocation_owner != no_node()) {
        val generic <- at < intrinsic (len)(views) && (case views[at] of { BoundGenericCall -> true; _ -> false });
        if ((allocated_source_array(facts, at) || generic) && (sites[at].registration != no_node() ||
            sites[at].in_delayed_body != 0u8 || sites[at].in_supplied_body)) return unproved_deferred_error();
        return route_failure(nodes, names, links, facts, sites, at, used, revision,
            out_of_memory_identity(), 0u8, possible_failure())
    };
    ref failure = make ExceptionType {
        defining_module <- 0u64; declaration <- no_node(); checked <- false;
    };
    if (read_acquisition_failure(views, at, failure)) {
        return check_call_completion(
            nodes, names, links, facts, sites, at, failure.defining_module, failure.declaration,
            if (failure.checked) { 1u8 } else { 0u8 }, used, revision)
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    if (inspect_invocation(nodes, revision, used, at, call) == OrdinaryInvocation) {
        if (facts[at].loans_scoped_aggregate && has_prepared_native_loans(views, at) &&
            (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8 ||
             sites[at].in_supplied_body)) return unproved_deferred_error();
        if (prepared_array_length_call(views, at)) {
            if (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8)
                return unproved_deferred_error();
            return 0u8
        };
        if (links[at].imported_interface != no_node()) {
            val diagnostic <- check_call_completion(nodes, names, links, facts, sites, at,
                links[at].imported_failure_module, links[at].imported_failure,
                                                    links[at].imported_failure_checked, used, revision);
            if (diagnostic != 0u8) return diagnostic;
            # The declaration alone cannot prove coverage of residual
            # failures raised while draining an imported deferred call.
            if (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8 ||
                ((facts[at].loans_scoped_aggregate || facts[at].loans_array_slot) && sites[at].in_supplied_body))
                return unproved_deferred_error();
            # Keep the declared exit in the ordinary completion row. For a
            # slot call the distinct unchecked escapes use the published
            # category set and this site's existing handler/cleanup context.
            if (links[at].imported_numeric_fault && !supports_immediate_numeric_exit(nodes, names, sites, at, used))
                return unproved_numeric_fault_route();
            if (links[at].imported_array_read_completion == ArrayReadMayFailBounds)
                return route_failure(nodes, names, links, facts, sites, at, used, revision,
                    index_out_of_bounds_identity(), 0u8, possible_failure());
            return 0u8;
        };
        if (text_oom && (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8))
            return unproved_deferred_error();
        if (facts[at].text_intrinsic == builder_append_export() || text_oom)
            return route_failure(nodes, names, links, facts, sites, at, used, revision, out_of_memory_identity(), 0u8, possible_failure());
        if (facts[at].text_intrinsic == text_byte_export())
            return route_failure(nodes, names, links, facts, sites, at, used, revision, index_out_of_bounds_identity(), 0u8, possible_failure());
        if (facts[at].text_intrinsic != 0u8) return 0u8;
    };
    if (facts[at].call_definition != no_node()) {
        if ((facts[at].loans_owning_handle || facts[at].loans_scoped_aggregate || facts[at].loans_array_slot) && (sites[at].in_supplied_body ||
            sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8))
            return unproved_deferred_error();
        val declaration <- sites[facts[at].call_definition].throws_clause;
        val definition <- facts[at].call_definition;
        if (requires_byte_completion(views, demand, definition) &&
            (requires_byte_completion(views, demand, enclosing_callable(nodes, names, names[at].scope)) ||
             prepared_byte_function(views, definition, true))) {
            if (definition >= at || declaration != no_node() ||
                sites[definition].array_read_completion == NoArrayRead) return unproved_byte_completion();
            if (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8)
                return unproved_deferred_error();
            if (sites[definition].array_read_completion == ArrayReadMayFailBounds)
                return route_failure(nodes, names, links, facts, sites, at, used, revision,
                    index_out_of_bounds_identity(), 0u8, possible_failure());
            return 0u8
        };
        if (declaration == no_node()) return 0u8;
        return check_call_completion(nodes, names, links, facts, sites, at,
            facts[declaration].identity_module, facts[declaration].identity,
                                     facts[declaration].checked_exception, used, revision);
    };
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    val defer_shape <- inspect_defer(nodes, revision, used, at, deferred);
    if (defer_shape == DeferCall || defer_shape == DeferBody) {
        record_registration(names, sites, at);
        return 0u8;
    };
    ref choice = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (inspect_case(nodes, revision, used, at, choice)) {
        sites[at].can_continue <- if (case_can_complete(nodes, links, facts, sites, at, used, revision, choice)) {
            1u8
        } else { 0u8 };
        return 0u8;
    };
    val completion <- completion_syntax(nodes, at);
    if (completion == BreakCompletion) return check_case_transfer(nodes, names, facts, sites, at, used, revision, true);
    case nodes[at] of {
        (Vacant) -> { return invalid_completion_tree(); };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (CaseFallthrough) -> { return check_case_transfer(nodes, names, facts, sites, at, used, revision, false); };
                (CaseFailure) -> {
                    sites[at].can_continue <- 0u8;
                    return route_failure(nodes, names, links, facts, sites, at, used, revision,
                                         unexpected_case_identity(), 0u8, definite_failure());
                };
                (RaisePending) -> {
                    sites[at].can_continue <- 0u8;
                    return check_throw_completion(nodes, names, links, facts, sites, at, used, revision);
                };
                (RaiseValue) -> {
                    sites[at].can_continue <- 0u8;
                    return check_throw_completion(nodes, names, links, facts, sites, at, used, revision);
                };
                (NamedThrow) -> {
                    sites[at].can_continue <- 0u8;
                    if (at >= intrinsic (len)(constructions)) return unproved_throw_operand();
                    return case constructions[at] of {
                        (ConstructedException { val failure <- nominal, val tail <- last_initializer, val reaches <- reaches_throw, }) -> {
                            if (!reaches || !can_continue(sites, tail)) return 0u8;
                            route_exception(nodes, names, links, facts, sites, at, used, revision,
                                failure.defining_module, failure.declaration,
                                if (failure.checked) { 1u8 } else { 0u8 }, definite_failure())
                        };
                        _ -> unproved_throw_operand()
                    };
                };
                (_) -> {};
            };
        };
    };
    if (completion == ReturnCompletion) {
        sites[at].can_continue <- 0u8;
        val scope <- names[at].scope;
        sites[scope].local_return <- 1u8;
        record_exit(sites, at, callable_return(), no_node(), scope, scope, no_node());
    };
    if (facts[at].kind == never_result()) { sites[at].can_continue <- 0u8; {}; } else {};
    return 0u8;
}

func record_array_read_completion(nodes:const ExprNodes in N, names:const NameBindings in B,
    links:const NameWork in L, facts:const OperandFacts in F, views:const SuppliedViews in V,
    demand:const DeclarationDemands in D, sites:CompletionSites in X, at:UInt64, used:UInt64, revision:UInt64) -> UInt8
    where {const owner N, const owner B, const owner L, const owner F, const owner V, const owner D, owner X} {
    if (requires_byte_completion(views, demand, at)) {
        if (can_miss_return(nodes, facts, sites, at, revision, used)) return unproved_byte_completion();
        if (sites[at].array_read_completion == NoArrayRead) {
            (sites[at].array_read_completion <- CheckedArrayRead):void
        };
        return 0u8
    };
    val event <- sites[at].event;
    if (event == skipped_operand() || names[at].scope == no_node()) return 0u8;
    val definition <- enclosing_callable(nodes, names, names[at].scope);
    if (!requires_byte_completion(views, demand, definition)) return 0u8;
    if (allocated_source_array(facts, at)) return unproved_byte_completion();
    val failed <- event == possible_failure() || event == definite_failure();
    if (!failed && !can_continue(sites, at)) return 0u8;
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    val invokes <- inspect_invocation(nodes, revision, used, at, call) == OrdinaryInvocation;
    ref index = make IndexSites { target <- no_node(); index <- no_node() };
    val unproved_index <- !facts[at].checks_array_bounds &&
        inspect_index_selection(nodes, revision, used, at, index);
    if (unproved_index) return unproved_byte_completion();
    if (invokes && links[at].imported_array_read_completion == NoArrayRead &&
        !prepared_byte_function(views, facts[at].call_definition, false))
        return unproved_byte_completion();
    if (failed && sites[at].replacing_try != no_node()) return unproved_byte_completion();
    if (failed && sites[at].destination == definition) {
        if (sites[at].category_module != 0u64 || sites[at].category != index_out_of_bounds_identity())
            return unproved_byte_completion();
        (sites[definition].array_read_completion <- ArrayReadMayFailBounds):void
    };
    return 0u8
}

# These leaf summaries only cover known primitive operations and exact literal
# or length callees. Numeric faults bypass the catchable exception channel.
func array_reader_operation(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    views:const SuppliedViews in H, at:UInt64, result:UInt8) -> bool
    where {const owner N, const owner F, const owner H} {
    val target <- facts[at].call_definition;
    val numeric_reader <- result == builtin_u8() || result == builtin_bool();
    val literal_kind <- if (numeric_reader) { builtin_u8() } else { builtin_u64() };
    val literal_call <- result == builtin_u8() && checked_literal_call(views, at);
    if (target != no_node() && source_literal_kind(views, target) != literal_kind) return false;
    return case nodes[at] of {
        Occupied { val syntax <- node, } -> case syntax.payload of {
            NameReference -> true;
            IntegerLiteral -> true;
            BooleanLiteral -> true;
            ComparisonExpression -> true;
            ReturningCondition -> true;
            Conditional -> true;
            Disjunction -> true;
            Conjunction -> true;
            Parenthesized -> true;
            FieldSelection -> true;
            ArrayLength -> true;
            ArithmeticExpression -> numeric_reader &&
                (facts[at].kind == scalar_u64() || facts[at].kind == scalar_u8() || facts[at].kind == never_result());
            Call -> literal_call || (result == builtin_bool() && (prepared_array_length_call(views, at) ||
                facts[at].text_intrinsic == text_size_export() || facts[at].text_intrinsic == text_byte_export()));
            ArgumentItem -> result == builtin_bool();
            RangeHeader -> result == builtin_bool();
            RangeLoop -> result == builtin_bool();
            LocalBinding { val mode <-, } -> numeric_reader && mode == ValueLocal;
            IndexSelection -> facts[at].checks_array_bounds || facts[at].kind == never_result();
            EmptyCall -> literal_call || target != no_node();
            CaseExpression -> true;
            CaseArm -> true;
            ConstructorCasePattern -> true;
            ReferenceCasePattern -> true;
            CaseValueReceiver -> true;
            BlockSyntax -> true;
            BlockItem -> true;
            ReturnValue -> true;
            _ -> false
        };
        Vacant -> false
    }
}

func record_array_reader_completion(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    views:const SuppliedViews in H, sites:CompletionSites in X, definition:UInt64, at:UInt64, result:UInt8, used:UInt64, revision:UInt64)
    -> void where {const owner N, const owner F, const owner H, owner X} {
    if (sites[definition].array_read_completion == NoArrayRead || sites[at].event == skipped_operand())
        return;
    if (!array_reader_operation(nodes, facts, views, at, result)) {
        sites[definition].array_read_completion <- NoArrayRead;
        return
    };
    if ((result == builtin_u8() || result == builtin_bool()) && can_continue(sites, at)) {
        ref binary = make BinarySites {
            left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal
        };
        if (inspect_binary(nodes, revision, used, at, binary) == ArithmeticBinary) {
            (sites[definition].numeric_fault <- true):void
        };
    };
    if (sites[at].event == possible_failure() || sites[at].event == definite_failure()) {
        if (sites[at].category_module == 0u64 && sites[at].category == index_out_of_bounds_identity() &&
            sites[at].destination == definition && sites[at].replacing_try == no_node()) {
            (sites[definition].array_read_completion <- ArrayReadMayFailBounds):void
        } else {
            (sites[definition].array_read_completion <- NoArrayRead):void
        }
    };
    return
}

# Every normal fallthrough crosses the direct items of the procedure body.
# A delayed block registered there that has no ordinary continuation
# replaces fallthrough. Any escaping language failure from it is checked
# separately against the drain's own coverage.
func has_terminal_defer(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                        body:UInt64, revision:UInt64, used:UInt64) -> bool
    where {const owner N, const owner L, const owner F} {
    ref tail = make UInt64 { no_node() };
    return !is_scope_block(nodes, body) && block_tail(nodes, revision, used, body, tail) &&
        has_terminal_defer_before(nodes, links, facts, tail, no_node(), revision, used);
}

func is_failure_statement(nodes:const ExprNodes in N, at:UInt64) -> bool where {const owner N} {
    return case nodes[at] of {
        (Vacant) -> { false };
        (Occupied { val syntax <- node, }) -> {
            case syntax.payload of {
                (CaseFailure) -> { true };
                (RaisePending) -> { true };
                (RaiseValue) -> { true };
                (_) -> { false };
            };
        };
    };
}

data EscapingFailureEdge {
    first_use:UInt64,
    next_use:UInt64,
    caller:UInt64,
    delayed_use:UInt64,
}
array EscapingFailureEdges[UInt64]:EscapingFailureEdge;

data ReachedFailure {
    seen:bool,
    order:UInt64,
}
array ReachedFailures[UInt64]:ReachedFailure;

func enqueue_failure(reached:ReachedFailures in W, definition:UInt64, count:UInt64) -> UInt64 where {owner W} {
    if (reached[definition].seen) return count;
    reached[definition].seen <- true;
    reached[count].order <- definition;
    return count + 1u64
}

func record_array_failure(failures:ByteArrayFailures in F, category:UInt64) -> bool where {owner F} {
    if (category == index_out_of_bounds_identity()) { failures.bounds <- true; return true };
    if (category == out_of_memory_identity()) { failures.out_of_memory <- true; return true };
    if (category == region_capacity_identity()) { failures.region_capacity <- true; return true };
    if (category == invalid_capacity_identity()) { failures.invalid_capacity <- true; return true };
    return false
}

func invocation_reached(nodes:const ExprNodes in N, sites:const CompletionSites in X,
    at:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner X} {
    return sites[at].event != skipped_operand() && operands_can_complete(nodes, sites, at, used, revision)
}

func enqueue_slot_callees(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    demand:const DeclarationDemands in D, sites:CompletionSites in X, reached:ReachedFailures in W, definition:UInt64, used:UInt64, revision:UInt64,
    pending:UInt64 in Q, report:CompletionCheckResult in R) -> bool
    where {const owner N, const owner F, const owner D, owner X, owner W, owner Q, owner R} {
    val call <- demand[definition].first_call;
    val callee <- no_node();
    val next <- no_node();
    for (unused in 0u64 .. used) {
        if (call == no_node()) return true;
        if (call >= used) {
            report.node <- definition;
            report.diagnostic <- invalid_completion_tree();
            return false
        };
        callee <- facts[call].call_definition;
        if (callee != no_node() && invocation_reached(nodes, sites, call, used, revision)) {
            if (callee >= used || !demand[callee].body) {
                report.node <- call;
                report.diagnostic <- invalid_completion_tree();
                return false
            };
            if (!sites[callee].slot_summary) {
                sites[callee].slot_summary <- true;
                (pending <- enqueue_failure(reached, callee, pending)):void
            }
        };
        next <- demand[call].next_call;
        if (next != no_node() && next >= call) {
            report.node <- call;
            report.diagnostic <- invalid_completion_tree();
            return false
        };
        call <- next
    };
    return call == no_node()
}

# Mark the reached, checked dependencies of slot bodies. The failure
# collector reads this membership after the traversal has finished.
func mark_slot_summary_dependencies(nodes:const ExprNodes in N, facts:const OperandFacts in F,
    demand:const DeclarationDemands in D, sites:CompletionSites in X, used:UInt64, revision:UInt64,
    report:CompletionCheckResult in R) -> bool
    where {const owner N, const owner F, const owner D, owner X, owner R} {
    ref reached = make ReachedFailures(used, make ReachedFailure { seen <- false; order <- no_node() });
    val pending <- 0u64;
    for (definition in 0u64 .. used) {
        if (demand[definition].slot_body) {
            sites[definition].slot_summary <- true;
            (pending <- enqueue_failure(reached, definition, pending)):void
        }
    };
    for (item in 0u64 .. used) {
        if (item == pending) return true;
        if (!enqueue_slot_callees(nodes, facts, demand, sites, reached, reached[item].order,
            used, revision, pending, report)) return false
    };
    return true
}

func in_slot_summary(demand:const DeclarationDemands in D, sites:const CompletionSites in X,
    at:UInt64, used:UInt64) -> bool where {const owner D, const owner X} {
    val definition <- demand[at].scope;
    return definition < used && sites[definition].slot_summary
}

func imported_array_escapes(views:const SuppliedViews in H, at:UInt64, category:UInt64)
    -> bool where {const owner H} {
    return case views[at] of {
        CheckedImportedArraySlotCall { val failures <-, } ->
            (category == index_out_of_bounds_identity() && failures.bounds) ||
            (category == out_of_memory_identity() && failures.out_of_memory) ||
            (category == region_capacity_identity() && failures.region_capacity) ||
            (category == invalid_capacity_identity() && failures.invalid_capacity);
        _ -> source_call_allocates(views, at) &&
            (category == out_of_memory_identity() || category == region_capacity_identity() ||
                category == invalid_capacity_identity())
    }
}

func collect_failure_roots(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                           facts:const OperandFacts in F, sites:const CompletionSites in X,
                           views:const SuppliedViews in H, demand:const DeclarationDemands in D, reached:ReachedFailures in W,
                           used:UInt64, revision:UInt64, category:UInt64, array_summary:bool) -> UInt64
    where {const owner N, const owner B, const owner L, const owner F, const owner X, const owner H, const owner D, owner W} {
    # This non-array allocation pass follows only the checked builder
    # append origin and ordinary local calls.
    val builder_summary <- !array_summary && category == out_of_memory_identity();
    val count <- 0u64;
    val definition <- no_node();
    val form <- InvalidCallable;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    val event <- 0u8;
    val routed <- false;
    val imported <- false;
    val allocation <- false;
    val broad_rethrow <- false;
    val replacement <- false;
    for (at in 0u64 .. used) {
        if (!array_summary || in_slot_summary(demand, sites, at, used)) {
            form <- inspect_callable(nodes, revision, used, at, callable);
            if (needs_body_check(demand, at) && category == missing_return_identity() &&
                (form == ModuleCallable || form == LexicalCallable) && can_miss_return(nodes, facts, sites, at, revision, used) &&
                !has_terminal_defer(nodes, links, facts, callable.body, revision, used)) {
                (count <- enqueue_failure(reached, at, count)):void;
            } else {};
            event <- sites[at].event;
            routed <- (array_summary || (builder_summary && (facts[at].text_intrinsic == builder_append_export() || facts[at].scoped_text_method != no_node()))) &&
                (event == possible_failure() || event == definite_failure());
            if ((routed || (!builder_summary && is_failure_statement(nodes, at))) &&
                sites[at].category_module == 0u64 && sites[at].category == category) {
                definition <- enclosing_callable(nodes, names, names[at].scope);
                form <- inspect_callable(nodes, revision, used, definition, callable);
                if (sites[at].destination == definition && (form == ModuleCallable || form == LexicalCallable)) {
                    (count <- enqueue_failure(reached, definition, count)):void;
                } else {};
            } else {};
            imported <- !builder_summary && links[at].imported_interface != no_node() &&
                (if (array_summary) {
                    invocation_reached(nodes, sites, at, used, revision) &&
                        (imported_array_escapes(views, at, category) ||
                            (!facts[at].loans_array_slot && links[at].imported_array_read_completion == NoArrayRead))
                } else { can_continue(sites, at) });
            allocation <- array_summary && category != index_out_of_bounds_identity() &&
                allocated_source_array(facts, at) && can_continue(sites, at);
            broad_rethrow <- routed && is_failure_statement(nodes, at) &&
                sites[at].category_module == 0u64 && sites[at].category == exception_root_identity();
            replacement <- routed && sites[at].category_module == 0u64 && sites[at].category == category &&
                sites[at].replacing_try != no_node();
            if (needs_body_check(demand, at) && (imported || allocation || broad_rethrow || replacement) &&
                (array_summary || sites[at].replacing_try == no_node()) &&
                matching_handler(nodes, links, facts, sites, at, 0u64, category, 0u8, used,
                    revision) == no_node()) {
                definition <- enclosing_callable(nodes, names, names[at].scope);
                form <- inspect_callable(nodes, revision, used, definition, callable);
                if (form == ModuleCallable || form == LexicalCallable) {
                    (count <- enqueue_failure(reached, definition, count)):void;
                };
            };
        };
    };
    return count
}

func collect_failure_edges(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                           facts:const OperandFacts in F, sites:const CompletionSites in X,
                           demand:const DeclarationDemands in D, edges:EscapingFailureEdges in E, used:UInt64, revision:UInt64, category:UInt64, array_summary:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner X, const owner D, owner E} {
    val definition <- no_node();
    val caller <- no_node();
    val form <- InvalidCallable;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    for (at in 0u64 .. used) {
        if (!array_summary || in_slot_summary(demand, sites, at, used)) {
            if (facts[at].call_definition != no_node() &&
                (if (array_summary) { invocation_reached(nodes, sites, at, used, revision) }
                    else { can_continue(sites, at) }) &&
                (sites[at].registration != no_node() || ((array_summary || sites[at].replacing_try == no_node()) &&
                 matching_handler(nodes, links, facts, sites, at, 0u64, category, 0u8, used,
                     revision) == no_node()))) {
                definition <- facts[at].call_definition;
                if (sites[at].registration != no_node() || sites[at].in_delayed_body != 0u8) {
                    # The old reverse-use traversal considered the last recorded use first.
                    (edges[definition].delayed_use <- at):void
                } else {
                    caller <- enclosing_callable(nodes, names, names[at].scope);
                    form <- inspect_callable(nodes, revision, used, caller, callable);
                    if (form == ModuleCallable || form == LexicalCallable) {
                        edges[at].caller <- caller;
                        edges[at].next_use <- edges[definition].first_use;
                        (edges[definition].first_use <- at):void
                    };
                };
            };
        };
    };
}

func add_failure_callers(edges:const EscapingFailureEdges in E, reached:ReachedFailures in W,
                         definition:UInt64, pending:UInt64) -> UInt64 where {const owner E, owner W} {
    val count <- pending;
    val use <- edges[definition].first_use;
    for (unused in 0u64 .. intrinsic (len)(edges)) {
        if (use == no_node()) return count;
        count <- enqueue_failure(reached, edges[use].caller, count);
        use <- edges[use].next_use;
    };
    return count
}

# This completion only schedules a newly reached recorded callable.
func complete_escaping_failures(edges:const EscapingFailureEdges in E, reached:ReachedFailures in W,
                                initial:UInt64) -> UInt64 where {const owner E, owner W} {
    val count <- initial;
    for (item in 0u64 .. intrinsic (len)(reached)) {
        if (item == count) return count;
        (count <- add_failure_callers(edges, reached, reached[item].order, count)):void;
    };
    return count
}

# Report in definition discovery order, using each definition’s first delayed use.
func check_delayed_failures(edges:const EscapingFailureEdges in E, reached:const ReachedFailures in W,
                            count:UInt64, report:CompletionCheckResult in R) -> bool
    where {const owner E, const owner W, owner R} {
    val use <- no_node();
    for (item in 0u64 .. count) {
        use <- edges[reached[item].order].delayed_use;
        if (use != no_node()) {
            report.node <- use;
            report.diagnostic <- unproved_deferred_error();
            return false
        };
    };
    return true
}

func check_escaping_failure_paths(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                                 facts:const OperandFacts in F, sites:CompletionSites in X,
                                 views:const SuppliedViews in H, demand:const DeclarationDemands in D, report:CompletionCheckResult in R,
                                 used:UInt64, revision:UInt64, category:UInt64, array_summary:bool) -> bool
    where {const owner N, const owner B, const owner L, const owner F, owner X, const owner H, const owner D, owner R} {
    ref reached = make ReachedFailures(used, make ReachedFailure { seen <- false; order <- no_node() });
    val roots <- collect_failure_roots(nodes, names, links, facts, sites, views, demand, reached, used, revision, category, array_summary);
    if (roots == 0u64) return true;
    ref edges = make EscapingFailureEdges(used, make EscapingFailureEdge {
        first_use <- no_node(); next_use <- no_node(); caller <- no_node(); delayed_use <- no_node()
    });
    collect_failure_edges(nodes, names, links, facts, sites, demand, edges, used, revision, category, array_summary);
    val count <- complete_escaping_failures(edges, reached, roots);
    if (!check_delayed_failures(edges, reached, count, report)) return false;
    if (array_summary) {
        val definition <- no_node();
        for (item in 0u64 .. count) {
            definition <- reached[item].order;
            if (demand[definition].slot_body && !record_array_failure(sites[definition].array_failures, category)) {
                report.node <- definition;
                report.diagnostic <- invalid_completion_tree();
                return false
            }
        }
    };
    return true
}

# The inputs are the same bound module revision. Cleanup links describe
# candidates in reverse registration order. Taking a link on an actual exit
# still depends on whether its registration succeeded on the executed path.
export func check_module_completion(nodes:const ExprNodes in N, tree:const ParseResult in T,
                                    names:const NameBindings in B, links:const NameWork in L, facts:const OperandFacts in F,
                                    views:const SuppliedViews in H,
                                    demand:const DeclarationDemands in D, text:const ScopedTextOutcomes in Q,
                                    constructions:const ExceptionConstructionFacts in E,
                                        sites:CompletionSites in X,
                                    report:CompletionCheckResult in R) -> bool
    where {const owner N, const owner T, const owner B, const owner L, const owner F, const owner H, const owner Q,
           const owner D, const owner E, owner X, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_completion_tree();
    ref tail = make UInt64 { no_node() };
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) || tree.root != tree.used - 1u64 ||
        !module_tail(nodes, tree.revision, tree.used, tree.root, tail)) return false;
    val construction_count <- intrinsic (len)(constructions);
    if ((construction_count != 0u64 && construction_count < tree.used) ||
        intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(facts) < tree.used || intrinsic (len)(sites) < tree.used) {
        report.diagnostic <- completion_storage_exhausted();
        return false;
    } else {};
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref failure = make UInt64 { no_node() };
    val form <- InvalidCallable;
    for (at in 0u64 .. tree.used) {
        initialize_site(sites, at);
        if (needs_body_check(demand, at) &&
            array_reader_result_kind(views, at) != 0u8) {
            (sites[at].array_read_completion <- CheckedArrayRead):void
        };
        form <- inspect_callable(nodes, tree.revision, tree.used, at, callable);
        if (form == ModuleCallable || form == LexicalCallable) {
            if (!find_signature_clause(nodes, tree.revision, tree.used, callable.signature, ThrowsSignatureClause, failure)) {
                report.node <- at;
                return false;
            };
            (sites[at].throws_clause <- failure):void;
        };
    };
    val site <- tree.root;
    # Syntax is postorder, so a reverse visit supplies each child's context
    # before the child is visited. Ordinary brace groups keep that context.
    for (offset in 0u64 .. tree.used) {
        site <- tree.root - offset;
        prepare_context(nodes, facts, sites, site, tree.used, tree.revision);
    };
    val slot_bodies <- false;
    val builder_append <- false;
    val definition <- no_node();
    val reader_result <- 0u8;
    for (at in 0u64 .. tree.used) {
        if (needs_body_check(demand, at)) {
            if (at < intrinsic (len)(demand) && demand[at].slot_body) { (slot_bodies <- true):void };
            report.diagnostic <- check_event(
                nodes, names, links, facts, views, demand, constructions, sites, at, tree.used, tree.revision,
                at < intrinsic (len)(text) && text[at]);
            if (report.diagnostic == 0u8) {
                report.diagnostic <- record_array_read_completion(nodes, names, links, facts, views,
                    demand, sites, at, tree.used, tree.revision)
            };
            if (report.diagnostic != 0u8) { report.node <- at; return false; };
            builder_append <- builder_append || ((facts[at].text_intrinsic == builder_append_export() ||
                facts[at].scoped_text_method != no_node()) && sites[at].event == possible_failure());
            definition <- if (at < intrinsic (len)(demand)) { (demand[at].scope) } else { no_node() };
            if (definition < tree.used && definition != at &&
                sites[definition].array_read_completion != NoArrayRead) {
                reader_result <- array_reader_result_kind(views, definition);
                if (reader_result != 0u8) {
                    record_array_reader_completion(nodes, facts, views, sites, definition, at,
                        reader_result, tree.used, tree.revision)
                }
            };
            reader_result <- array_reader_result_kind(views, at);
            if (reader_result != 0u8) {
                if (facts[at].kind != declared_scalar(reader_result) ||
                    can_miss_return(nodes, facts, sites, at, tree.revision, tree.used)) {
                    (sites[at].array_read_completion <- NoArrayRead):void
                }
            }
        }
    };
    return check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
        tree.used, tree.revision, missing_return_identity(), false) &&
        check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report, tree.used,
            tree.revision, unexpected_case_identity(), false) &&
        (!builder_append || check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
            tree.used, tree.revision, out_of_memory_identity(), false)) &&
        (!slot_bodies || (mark_slot_summary_dependencies(nodes, facts, demand, sites,
            tree.used, tree.revision, report) &&
            check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
                tree.used, tree.revision, index_out_of_bounds_identity(), true) &&
            check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
                tree.used, tree.revision, out_of_memory_identity(), true) &&
            check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
                tree.used, tree.revision, invalid_capacity_identity(), true) &&
            check_escaping_failure_paths(nodes, names, links, facts, sites, views, demand, report,
                tree.used, tree.revision, region_capacity_identity(), true)))
}
