using "ASCII.cod" ASCII {
    LEFT_PAREN, RIGHT_PAREN, COMMA, MINUS, PERIOD, COLON, SEMICOLON, GREATER_THAN, LEFT_BRACE,
    RIGHT_BRACE
};
using "./Lexer.cod" {
    const_word, exception_word, handle_word, here_word, identifier, init_word, in_word, not_word, own_word, owner_word,
    ptr_word, ref_word, region_word, reserved_lexical_binder, reserved_module_name, throws_word, val_word, var_word,
    where_word, within_word, punctuation,
};
using "./ParserInput.cod" {
    ParseResult, append_syntax_node, append_qualified_type, exception_binder_width,
    expected_name, expected_type, parse_binding_name,
    parse_identifier, parse_module_name, parse_resource_name, punct_at, punct_pair_at,
};
using "./ParserStorage.cod" {
    ExprNodes, Tokens, NodeId, syntax_first, syntax_past, exception_result_node, no_node, ref_result_node,
    result_clause_node, throws_clause_node, BindingSites, inspect_binding,
    formal_variadic_at,
};
using "./ParserStorage.cod" NodeLink { NoLink, LinkTo };
using "./ParserStorage.cod" ExprPayload {
    CallableHeader, ValueResult, BorrowedResult, ExceptionResult, OwningRegionResult, ThrowsClause, Formal, HereFormal,
    OwnerConstraint, TypeConstraint, ProcedureSymbol, ProcedureTypeInput, ProcedureTypeAnnotation, ScopedProcedureHeader,
};
using "./ParserStorage.cod" FormalMode {
    ValueFormal, ExplicitValueFormal, ReferenceFormal, PointerFormal, PlaceFormal, InitializingPlaceFormal,
    HandleFormal, RetainedHandleFormal, ExceptionFormal, ReferenceSlotFormal, IdentityOnlyRefFormal,
};
using "./ParserStorage.cod" BindingSyntax { TypedBinding };
using "./SourceStorage.cod" SourceBytes;

func expected_parameter_list() -> UInt8 { return 23u8; }
export func expected_owner_clause() -> UInt8 { return 24u8; }
func invalid_exception_owner() -> UInt8 { return 35u8; }
func invalid_value_parameter_owner() -> UInt8 { return 41u8; }
func invalid_value_result_owner() -> UInt8 { return 53u8; }
func expected_identity_reference() -> UInt8 { return 50u8; }

func direct_place_head(source:const SourceBytes in S, tokens:const Tokens in T, at:UInt64, past:UInt64) -> bool
    where {const owner S, const owner T} {
    return at + 2u64 < past && val_word(source, tokens[at]) && var_word(source, tokens[at + 1u64]) &&
        punct_at(source, tokens, at + 2u64, past) != COLON;
}

func ellipsis_at(source:const SourceBytes in S, tokens:const Tokens in T, at:UInt64, past:UInt64)
    -> bool where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) return false;
    val first <- tokens[at].first;
    return tokens[at].past - first == 3u64 && source[first] == PERIOD &&
        source[first + 1u64] == PERIOD && source[first + 2u64] == PERIOD
}

# Formal parameters link to their preceding parameter and retain the typed name.
export func parse_parameter(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R,
                     past:UInt64, previous:UInt64, field:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_name(); return false; } else {};
    val kind <- ValueFormal;
    val identity_only <- !field && at + 1u64 < past && not_word(source, tokens[at]) &&
        init_word(source, tokens[at + 1u64]);
    val width <- exception_binder_width(source, tokens, at, past);
    val reference_slot <- !field && at + 1u64 < past && ref_word(source, tokens[at]) && var_word(source, tokens[at + 1u64]);
    val const_prefix <- !field && at + 1u64 < past && const_word(source, tokens[at]);
    val fixed_value <- const_prefix && val_word(source, tokens[at + 1u64]);
    val fixed_reference <- const_prefix && !fixed_value && punct_at(source, tokens, at + 2u64, past) == COLON;
    val binding_const <- fixed_value || fixed_reference;
    if (identity_only || reference_slot || binding_const) {
        if (identity_only) {
            result.next <- at + 2u64;
            if (result.next >= past || !ref_word(source, tokens[result.next])) {
                result.diagnostic <- expected_identity_reference();
                return false
            };
            kind <- IdentityOnlyRefFormal;
            (result.next <- at + 3u64):void
        } else {
            kind <- if (reference_slot) { ReferenceSlotFormal } else {
                if (fixed_value) { ExplicitValueFormal } else { ReferenceFormal }
            };
            (result.next <- at + (if (fixed_reference) { 1u64 } else { 2u64 })):void
        }
    } else {
        if (width != 0u64) {
            kind <- ExceptionFormal;
            (result.next <- at + width):void;
        } else {
            if (!field && init_word(source, tokens[at]) && direct_place_head(source, tokens, at + 1u64, past)) {
                kind <- InitializingPlaceFormal;
                (result.next <- at + 3u64):void;
            } else {
                if (!field && direct_place_head(source, tokens, at, past)) {
                    kind <- PlaceFormal;
                    (result.next <- at + 2u64):void;
                } else {
                    if (ref_word(source, tokens[at])) { (kind <- ReferenceFormal):void; } else {};
                    if (ptr_word(source, tokens[at])) { (kind <- PointerFormal):void; } else {};
                    if (val_word(source, tokens[at])) { (kind <- ExplicitValueFormal):void; } else {};
                    if (handle_word(source, tokens[at]) && punct_at(source, tokens, at + 1u64, past) != COLON) {
                        (kind <- HandleFormal):void;
                    } else {};
                    if (kind != ValueFormal) { (result.next <- at + 1u64):void; } else {};
                };
            };
        };
    };
    if (!parse_binding_name(source, tokens, nodes, result, past, true, true, field))
        return false;
    val binding <- result.root;
    ref sites = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, result.revision, result.used, binding, sites) != TypedBinding) {
        result.diagnostic <- expected_type();
        return false;
    };
    val qualified <- sites.owner_name != no_node();
    if (fixed_reference && !qualified) {
        result.diagnostic <- expected_owner_clause();
        return false;
    };
    if (kind == ExceptionFormal && qualified) {
        result.diagnostic <- invalid_exception_owner();
        return false;
    } else {};
    if (kind == ExplicitValueFormal && qualified) {
        result.diagnostic <- invalid_value_parameter_owner();
        return false;
    } else {};
    if (!field && kind == ValueFormal && qualified) { (kind <- ReferenceFormal):void; } else {};
    val first <- tokens[at].first;
    if (kind == HandleFormal && !qualified && within_word(source, tokens[at + 1u64])) {
        (kind <- RetainedHandleFormal):void;
    };
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    val suffix <- no_node();
    val end <- syntax_past(nodes, result.used, binding);
    if (!field && ellipsis_at(source, tokens, result.next, past)) {
        suffix <- tokens[result.next].first;
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void
    };
    append_syntax_node(nodes, result, first, end, make Formal {
        previous <- preceding;
        binding <- make NodeId { revision <- result.revision; index <- binding; };
        mode <- kind;
        binding_const <- binding_const;
        variadic_at <- suffix;
    });
    return result.diagnostic == 0u8;
}

func parameter_delimiter(source:const SourceBytes in S, tokens:const Tokens in T, nodes:const ExprNodes in A,
    result:ParseResult in R, past:UInt64, last:UInt64, allow_variadic:bool) -> UInt8
    where {const owner S, const owner T, const owner A, owner R} {
    val delimiter <- punct_at(source, tokens, result.next, past);
    if ((formal_variadic_at(nodes, result.revision, result.used, last) != no_node() &&
         (!allow_variadic || delimiter != RIGHT_PAREN)) ||
        (delimiter != RIGHT_PAREN && delimiter != COMMA)) {
        result.diagnostic <- expected_parameter_list();
        return 0u8
    };
    if (delimiter == COMMA) { (result.next <- result.next + 1u64):void };
    return delimiter
}

func parse_ordinary_parameters(source:const SourceBytes in S, tokens:const Tokens in T,
    nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, preceding:UInt64, allow_variadic:bool)
    -> UInt64 where {const owner S, const owner T, owner A, owner R} {
    val last <- preceding;
    if (last == no_node() && punct_at(source, tokens, result.next, past) == RIGHT_PAREN) return last;
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_parameter(source, tokens, nodes, result, past, last, false)) return no_node();
        last <- result.root;
        delimiter <- parameter_delimiter(source, tokens, nodes, result, past, last, allow_variadic);
        if (delimiter == RIGHT_PAREN) return last;
        if (delimiter != COMMA) return no_node()
    };
    result.diagnostic <- expected_parameter_list();
    return no_node()
}

func parse_parameters(source:const SourceBytes in S, tokens:const Tokens in T,
    nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, multiple_here:bool, allow_variadic:bool)
    -> UInt64 where {const owner S, const owner T, owner A, owner R} {
    val last <- no_node();
    val at <- result.next;
    val delimiter <- 0u8;
    # Only the leading run can contain here formals. Their nested lists are
    # ordinary parameters and enter that parser directly.
    for (unused in result.next .. past) {
        at <- result.next;
        if (at >= past || !here_word(source, tokens[at]) ||
            punct_at(source, tokens, at + 1u64, past) == COLON)
            return parse_ordinary_parameters(source, tokens, nodes, result, past, last, allow_variadic);
        parse_here_parameter(source, tokens, nodes, result, past, last);
        if (result.diagnostic != 0u8) return no_node();
        last <- result.root;
        delimiter <- parameter_delimiter(source, tokens, nodes, result, past, last, allow_variadic);
        if (delimiter == RIGHT_PAREN) return last;
        if (delimiter != COMMA) return no_node();
        if (!multiple_here)
            return parse_ordinary_parameters(source, tokens, nodes, result, past, last, allow_variadic)
    };
    result.diagnostic <- expected_parameter_list();
    return no_node()
}

func start_parameter_list(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, lexical:bool, operators:bool) -> UInt64
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val reserved <- at < past && (if (lexical) { reserved_lexical_binder(source, tokens[at]) }
                                  else { reserved_module_name(source, tokens[at]) });
    if (reserved) { result.diagnostic <- expected_name(); return no_node(); } else {};
    if (operators) {
        if (!parse_resource_name(source, tokens, nodes, result, past)) return no_node();
    } else {
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return no_node();
    };
    val name <- result.root;
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != LEFT_PAREN) { # '('
        result.diagnostic <- expected_parameter_list();
        return no_node();
    } else {};
    result.next <- open + 1u64;
    return name;
}

func finish_callable_head(tokens:const Tokens in T, nodes:ExprNodes in A, result:ParseResult in R,
                          name:UInt64, parameters:UInt64, open:UInt64) -> void
    where {const owner T, owner A, owner R} {
    val close <- result.next;
    ref entries = make NoLink {};
    if (parameters != no_node()) {
        entries = make LinkTo { node <- make NodeId { revision <- result.revision; index <- parameters; }; };
        {};
    };
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), tokens[close].past, make CallableHeader {
        name <- make NodeId { revision <- result.revision; index <- name; };
        parameters <- entries;
        opening <- open;
    });
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

# Each header clause links to the preceding header node and its own operand.
func parse_owning_region_result(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                                result:ParseResult in R, previous:UInt64, first:UInt64, past:UInt64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val end <- tokens[result.next + 1u64].past;
    result.next <- result.next + 2u64;
    val readonly <- false;
    ref schema = make NoLink {};
    if (punct_at(source, tokens, result.next, past) == COLON) {
        result.next <- result.next + 1u64;
        if (result.next < past && const_word(source, tokens[result.next])) {
            readonly <- true;
            (result.next <- result.next + 1u64):void;
        };
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
        schema = make LinkTo { node <- make NodeId { revision <- result.revision; index <- result.root; }; };
        (end <- syntax_past(nodes, result.used, result.root)):void;
    };
    if (result.next < past && tokens[result.next].kind == identifier() &&
        !throws_word(source, tokens[result.next]) && !where_word(source, tokens[result.next])) {
        result.diagnostic <- expected_type();
        return false;
    };
    append_syntax_node(nodes, result, first, end, make OwningRegionResult {
        previous <- make NodeId { revision <- result.revision; index <- previous; };
        schema <- schema; readonly <- readonly;
    });
    return result.diagnostic == 0u8;
}

func parse_type_clause(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                       result:ParseResult in R, past:UInt64, kind:UInt8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val previous <- result.root;
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val clause_kind <- kind;
    val explicit_value <- false;
    if (kind == result_clause_node() && result.next < past) {
        val at <- result.next;
        if (at + 1u64 < past && own_word(source, tokens[at]) && region_word(source, tokens[at + 1u64]))
            return parse_owning_region_result(source, tokens, nodes, result, previous, first, past);
        val width <- 0u64;
        if (exception_word(source, tokens[at]) && punct_at(source, tokens, at + 1u64, past) == COLON) {
            (width <- 1u64):void;
        } else {
            if (own_word(source, tokens[at]) && at + 1u64 < past && exception_word(source, tokens[at + 1u64])) {
                (width <- 2u64):void;
            } else {};
        };
        if (width != 0u64) {
            result.next <- at + width;
            if (punct_at(source, tokens, result.next, past) != COLON) { result.diagnostic <- expected_type(); return false; } else {};
            result.next <- result.next + 1u64;
            (clause_kind <- exception_result_node()):void;
        } else {
            if (val_word(source, tokens[at])) {
                result.next <- at + 1u64;
                (explicit_value <- true):void;
            } else {
                if (ref_word(source, tokens[at])) {
                    result.next <- at + 1u64;
                    (clause_kind <- ref_result_node()):void;
                } else {};
            };
        };
    } else {};
    val readonly <- kind == result_clause_node() && result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
    val annotation <- result.root;
    if (clause_kind == result_clause_node() && result.next < past && in_word(source, tokens[result.next])) {
        if (explicit_value) {
            result.diagnostic <- invalid_value_result_owner();
            return false
        };
        (clause_kind <- ref_result_node()):void;
    } else {};
    if (clause_kind == ref_result_node()) {
        if (result.next >= past || !in_word(source, tokens[result.next])) {
            result.diagnostic <- expected_owner_clause();
            return false;
        } else {};
        val site <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        val owner_name <- result.root;
        append_qualified_type(nodes, result, annotation, owner_name, site);
        if (result.diagnostic != 0u8) return false;
        (annotation <- result.root):void;
    } else {};
    val end <- syntax_past(nodes, result.used, annotation);
    ref previous_item = make NodeId { revision <- result.revision; index <- previous; };
    ref selected_type = make NodeId { revision <- result.revision; index <- annotation; };
    if (clause_kind == throws_clause_node()) {
        append_syntax_node(nodes, result, first, end, make ThrowsClause {
            previous <- previous_item; exception_type <- selected_type;
        });
    } else {
        if (clause_kind == ref_result_node()) {
            append_syntax_node(nodes, result, first, end, make BorrowedResult {
                previous <- previous_item; owner_qualified_type <- selected_type; readonly <- readonly;
            });
        } else {
            if (clause_kind == exception_result_node()) {
                append_syntax_node(nodes, result, first, end, make ExceptionResult {
                    previous <- previous_item; type_name <- selected_type; readonly <- readonly;
                });
            } else {
                append_syntax_node(nodes, result, first, end, make ValueResult {
                    previous <- previous_item; type_name <- selected_type; readonly <- readonly;
                    explicit_value <- explicit_value;
                });
            };
        };
    };
    return result.diagnostic == 0u8;
}

func parse_here_parameter(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, previous:UInt64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val name <- start_parameter_list(source, tokens, nodes, result, past, true, false);
    if (name == no_node()) return;
    val open <- tokens[result.next - 1u64].first;
    val parameters <- parse_ordinary_parameters(source, tokens, nodes, result, past, no_node(), false);
    if (result.diagnostic != 0u8) return;
    finish_callable_head(tokens, nodes, result, name, parameters, open);
    if (result.diagnostic != 0u8) return;
    if (!punct_pair_at(source, tokens, result.next, past, MINUS, GREATER_THAN)) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    if (!parse_type_clause(source, tokens, nodes, result, past, result_clause_node())) return;
    if (result.next < past && throws_word(source, tokens[result.next])) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) return;
    } else {};
    val signature <- result.root;
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, signature), make HereFormal {
        previous <- preceding;
        signature <- make NodeId { revision <- result.revision; index <- signature; };
    });
}

func parse_callable_head(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, native:bool, operators:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val name <- start_parameter_list(source, tokens, nodes, result, past, false, operators);
    if (name == no_node()) return;
    val open <- tokens[result.next - 1u64].first;
    val parameters <- parse_parameters(source, tokens, nodes, result, past, !native, !native);
    if (result.diagnostic != 0u8) return;
    finish_callable_head(tokens, nodes, result, name, parameters, open);
}

func parse_owner_clause(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:UInt64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val readonly <- at < past && const_word(source, tokens[at]);
    val owner_at <- if (readonly) { at + 1u64 } else { at };
    if (owner_at >= past || !owner_word(source, tokens[owner_at])) {
        result.diagnostic <- expected_owner_clause();
        return false;
    } else {};
    val previous <- result.root;
    result.next <- owner_at + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    val owner_name <- result.root;
    val first <- tokens[at].first;
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, owner_name), make OwnerConstraint {
        previous <- preceding;
        declared_owner <- make NodeId { revision <- result.revision; index <- owner_name; };
        readonly <- readonly;
    });
    return result.diagnostic == 0u8;
}

func parse_constraint(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, ordinary:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (!ordinary || at >= past || owner_word(source, tokens[at]) || const_word(source, tokens[at]))
        return parse_owner_clause(source, tokens, nodes, result, past);
    val previous <- result.root;
    if (!parse_module_name(source, tokens, nodes, result, past)) return false;
    val name <- result.root;
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), syntax_past(nodes, result.used, name),
                       make TypeConstraint {
        previous <- make NodeId { revision <- result.revision; index <- previous; };
        type_name <- make NodeId { revision <- result.revision; index <- name; };
    });
    return result.diagnostic == 0u8;
}

export func parse_constraints(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, ordinary:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != LEFT_BRACE) { # '{'
        if (ordinary) { parse_constraint(source, tokens, nodes, result, past, ordinary):void; return; };
        result.diagnostic <- expected_owner_clause();
        return;
    } else {};
    result.next <- result.next + 1u64;
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_constraint(source, tokens, nodes, result, past, ordinary)) return;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == RIGHT_BRACE) { result.next <- result.next + 1u64; return; } else {}; # '}'
        if (delimiter != COMMA) { result.diagnostic <- expected_owner_clause(); return; } else {}; # ','
        result.next <- result.next + 1u64;
    };
    (result.diagnostic <- expected_owner_clause()):void;
}

func parse_signature_clauses(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, native:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_pair_at(source, tokens, result.next, past, MINUS, GREATER_THAN)) { # '->'
        if (!parse_type_clause(source, tokens, nodes, result, past, result_clause_node())) return;
    } else {};
    val leading_throws <- result.next < past && throws_word(source, tokens[result.next]);
    if (leading_throws) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) return;
    } else {};
    if (result.next < past && where_word(source, tokens[result.next])) {
        parse_constraints(source, tokens, nodes, result, past, !native);
        if (result.diagnostic != 0u8) return;
    } else {};
    if (!leading_throws && result.next < past && throws_word(source, tokens[result.next])) {
        if (!parse_type_clause(source, tokens, nodes, result, past, throws_clause_node())) return;
    } else {};
}

export func parse_callable_signature(source:const SourceBytes in S, tokens:const Tokens in T,
                                     nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, native:bool,
                                     operators:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_callable_head(source, tokens, nodes, result, past, native, operators);
    if (result.diagnostic != 0u8) return;
    val has_result <- punct_pair_at(source, tokens, result.next, past, MINUS, GREATER_THAN);
    parse_signature_clauses(source, tokens, nodes, result, past, native);
    if (result.diagnostic == 0u8 && !native && !has_result &&
        punct_at(source, tokens, result.next, past) == SEMICOLON) {
        (result.diagnostic <- expected_type()):void
    };
}

export func parse_scoped_procedure_signature(source:const SourceBytes in S, tokens:const Tokens in T,
                                             nodes:ExprNodes in A, result:ParseResult in R, past:UInt64, name:UInt64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    result.next <- open + 1u64;
    val parameters <- parse_parameters(source, tokens, nodes, result, past, true, true);
    if (result.diagnostic != 0u8) return;
    val close <- result.next;
    ref entries = make NoLink {};
    if (parameters != no_node()) {
        entries = make LinkTo { node <- make NodeId { revision <- result.revision; index <- parameters; }; };
        {};
    };
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, name), tokens[close].past, make ScopedProcedureHeader {
        name <- make NodeId { revision <- result.revision; index <- name; };
        parameters <- entries;
        opening <- tokens[open].first;
    });
    if (result.diagnostic != 0u8) return;
    result.next <- close + 1u64;
    parse_signature_clauses(source, tokens, nodes, result, past, false);
}

func parse_procedure_type(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:UInt64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_type(); return false; };
    val mode <- ValueFormal;
    if (ref_word(source, tokens[at])) { (mode <- ReferenceFormal):void; } else {
        if (ptr_word(source, tokens[at])) { (mode <- PointerFormal):void; } else {
            if (val_word(source, tokens[at])) { (mode <- ExplicitValueFormal):void; } else {};
        };
    };
    if (mode != ValueFormal) { (result.next <- at + 1u64):void; } else {};
    val readonly <- result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (result.next < past && region_word(source, tokens[result.next])) {
        result.diagnostic <- expected_type();
        return false;
    };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
    val type_name <- result.root;
    append_syntax_node(nodes, result, tokens[at].first, syntax_past(nodes, result.used, type_name), make ProcedureTypeAnnotation {
        type_name <- make NodeId { revision <- result.revision; index <- type_name; };
        mode <- mode;
        readonly <- readonly;
    });
    return result.diagnostic == 0u8;
}

func append_procedure_input(nodes:ExprNodes in A, result:ParseResult in R, previous:UInt64) -> void
    where {owner A, owner R} {
    val annotation <- result.root;
    ref prior = make NoLink {};
    if (previous != no_node()) {
        prior = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, annotation), syntax_past(nodes, result.used, annotation),
        make ProcedureTypeInput {
            previous <- prior;
            annotation <- make NodeId { revision <- result.revision; index <- annotation; };
        });
}

func parse_procedure_inputs(source:const SourceBytes in S, tokens:const Tokens in T,
                            nodes:ExprNodes in A, result:ParseResult in R, past:UInt64) -> UInt64
    where {const owner S, const owner T, owner A, owner R} {
    val tail <- no_node();
    if (punct_at(source, tokens, result.next, past) == RIGHT_PAREN) return tail; # ')'
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (!parse_procedure_type(source, tokens, nodes, result, past)) return no_node();
        append_procedure_input(nodes, result, tail);
        if (result.diagnostic != 0u8) return no_node();
        tail <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == RIGHT_PAREN) return tail;
        if (delimiter != COMMA) { result.diagnostic <- expected_parameter_list(); return no_node(); };
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_parameter_list();
    return no_node();
}

export func parse_procedure_symbol_type(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                                        result:ParseResult in R, past:UInt64, first:UInt64, name:UInt64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 2u64; # 'proc('
    val tail <- parse_procedure_inputs(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val arrow <- result.next + 1u64;
    result.next <- arrow;
    if (!punct_pair_at(source, tokens, arrow, past, MINUS, GREATER_THAN)) { result.diagnostic <- expected_type(); return; };
    val arrow_first <- tokens[arrow].first;
    result.next <- arrow + 1u64;
    if (!parse_procedure_type(source, tokens, nodes, result, past)) return;
    val output <- result.root;
    ref inputs = make NoLink {};
    if (tail != no_node()) {
        inputs = make LinkTo { node <- make NodeId { revision <- result.revision; index <- tail; }; };
        {};
    };
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, output), make ProcedureSymbol {
        name <- make NodeId { revision <- result.revision; index <- name; };
        input_types <- inputs;
        result_type <- make NodeId { revision <- result.revision; index <- output; };
        arrow <- arrow_first;
    });
}
