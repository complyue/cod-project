export func type_module(names:const NameBindings in B, selected:const SelectedExports in E,
                        marker:u64, current_module:u64) -> u64 where {const owner B, const owner E} {
    if (names[marker].kind == ordinary_selection()) return selected[names[marker].declaration].origin_module;
    return current_module;
}

export func type_identity(names:const NameBindings in B, selected:const SelectedExports in E,
                          marker:u64) -> u64 where {const owner B, const owner E} {
    val declaration <- names[marker].declaration;
    if (names[marker].kind == ordinary_selection()) return selected[declaration].identity;
    return declaration;
}

export data DeclaredType {
    kind:u8;
    defining_module:u64;
    identity:u64;
}

export data DeclaredExpressionResult {
    diagnostic:u8;
    node:u64;
}

export func unproved_type_assertion() -> u8 { return 84u8; }
func missing_enum_member() -> u8 { return 85u8; }
func incompatible_enum_assertion() -> u8 { return 86u8; }
func unproved_enum_operand() -> u8 { return 87u8; }
func unproved_case_subject() -> u8 { return 93u8; }
func invalid_case_pattern_type() -> u8 { return 94u8; }
func missing_case_member() -> u8 { return 95u8; }
func invalid_case_guard_type() -> u8 { return 96u8; }
func invalid_c_string_operand() -> u8 { return 97u8; }
export func interior_nul_in_c_string() -> u8 { return 98u8; }
func invalid_string_operand() -> u8 { return 102u8; }
func readonly_string_owner() -> u8 { return 103u8; }
func invalid_string_installation() -> u8 { return 110u8; }

export func describe_type(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                   annotation:u64, current_module:u64, revision:u64, used:u64, result:DeclaredType in R) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    ref parsed = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (!inspect_type_annotation(nodes, revision, used, annotation, parsed)) return false;
    val marker <- parsed.target_type;
    val kind <- names[marker].kind;
    if (native_scalar(kind) || text_type(kind)) {
        result.kind <- kind;
        result.defining_module <- 0u64;
        result.identity <- 0u64;
        return true;
    } else {};
    val nominal <- kind;
    if (is_lexical_builder(nodes, names, marker, revision, used)) {
        result.kind <- lexical_builder_type();
        result.defining_module <- type_module(names, selected, marker, current_module);
        result.identity <- type_identity(names, selected, marker);
        return true;
    };
    if (kind == ordinary_selection()) {
        val exported <- selected[names[marker].declaration].kind;
        nominal <- 0u8;
        if (exported == record_export()) { (nominal <- record_type()):void; };
        if (exported == enum_export()) { (nominal <- enum_type()):void; };
        if (exported == sum_export()) { (nominal <- sum_type()):void; };
    } else {};
    if (nominal != record_type() && nominal != enum_type() && nominal != sum_type()) return false;
    result.kind <- nominal;
    result.defining_module <- type_module(names, selected, marker, current_module);
    result.identity <- type_identity(names, selected, marker);
    return true;
}

func local_member_type(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                       selected:const SelectedExports in E, work:const NameWork in W,
                       name:u64, revision:u64, used:u64, inline_only:bool,
                       result:DeclaredType in T, ordinal:u64 in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, owner T, owner R} {
    val field <- locate_record_field(source, nodes, work, result.identity, name, revision, used, ordinal);
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    return inspect_formal(nodes, revision, used, field, formal) == OrdinaryFormal &&
        (!inline_only || formal.mode == ValueFormal || formal.mode == ExplicitValueFormal) &&
        inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding &&
        describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, result);
}

func imported_member_type(source:const SourceBytes in S, nodes:const ExprNodes in N,
                          spellings:const SourceBytes in P, spelling_used:u64,
                          interfaces:const ModuleInterfaces in I, interface_count:u64,
                          name:u64, used:u64, inline_only:bool, result:DeclaredType in T,
                          ordinal:u64 in R) -> bool
    where {const owner S, const owner N, const owner P, const owner I, owner T, owner R} {
    val head <- find_interface(interfaces, interface_count, result.defining_module, result.identity);
    if (head == no_node() || interfaces[head].interface_kind != record_type() ||
        spelling_used > intrinsic (len)(spellings)) return false;
    val first <- syntax_first(nodes, used, name);
    val past <- syntax_past(nodes, used, name);
    for (row in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (interfaces[row].name_first >= interfaces[row].name_past ||
            interfaces[row].name_past > spelling_used) return false;
        if (same_bytes(source, first, past, spellings, interfaces[row].name_first, interfaces[row].name_past)) {
            if (inline_only && interfaces[row].field_mode != ValueFormal &&
                interfaces[row].field_mode != ExplicitValueFormal) return false;
            ordinal <- row - head - 1u64;
            result.kind <- interfaces[row].value_kind;
            result.defining_module <- interfaces[row].type_module;
            result.identity <- interfaces[row].type_identity;
            return true;
        } else {};
    };
    return false;
}

export func describe_record_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    spellings:const SourceBytes in P, spelling_used:u64,
    interfaces:const ModuleInterfaces in I, interface_count:u64,
    name:u64, used:u64, revision:u64, result:DeclaredType in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W,
           const owner P, const owner I, owner R} {
    ref ordinal = make u64 { no_node() };
    return describe_record_member(source, nodes, names, selected, work, spellings, spelling_used, interfaces,
        interface_count, name, used, revision, false, result, ordinal)
}

export func describe_record_member(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    spellings:const SourceBytes in P, spelling_used:u64,
    interfaces:const ModuleInterfaces in I, interface_count:u64,
    name:u64, used:u64, revision:u64, inline_only:bool, result:DeclaredType in T, ordinal:u64 in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W,
           const owner P, const owner I, owner T, owner R} {
    if (result.kind != record_type()) return false;
    if (result.defining_module == 0u64)
        return local_member_type(source, nodes, names, selected, work, name, revision, used, inline_only,
            result, ordinal);
    return imported_member_type(source, nodes, spellings, spelling_used, interfaces, interface_count, name,
        used, inline_only, result, ordinal)
}

# Follow only syntax and bound declarations here. The result carries the
# nominal type, with no claim about target readiness or a readable loan.
func trace_type(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                selected:const SelectedExports in E, work:const NameWork in W,
                spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                at:u64, used:u64, revision:u64, result:DeclaredType in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    ref inside = make u64 { no_node() };
    val grouping <- inspect_group(nodes, revision, used, at, inside);
    if (grouping == InvalidGroup) return false;
    if (grouping == ParenthesizedExpression)
        return trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, inside, used, revision, result);
    case nodes[at] of {
        (Vacant) -> { return false; };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (TextLiteral) -> {
                    result.kind <- builtin_string();
                    result.defining_module <- 0u64;
                    result.identity <- 0u64;
                    return true;
                };
                (BooleanLiteral) -> {
                    result.kind <- builtin_bool();
                    result.defining_module <- 0u64;
                    result.identity <- 0u64;
                    return true;
                };
                (IntegerLiteral { val width <- width; }) -> {
                    result.kind <- if (width == 8u64) { builtin_u8() } else {
                        if (width == 32u64) { builtin_u32() } else {
                            if (width == 0u64) { builtin_i64() } else { builtin_u64() }
                        }
                    };
                    result.defining_module <- 0u64;
                    result.identity <- 0u64;
                    return true;
                };
                (_) -> {};
            };
        };
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, revision, used, at, construction);
    if (shape == PositionalConstruction || shape == BracedConstruction || shape == StorageReservation)
        return describe_type(nodes, names, selected, construction.requested, 0u64, revision, used, result);
    ref tail = make u64 { no_node() };
    if (!is_scope_block(nodes, at) && block_tail(nodes, revision, used, at, tail)) {
        ref item = make SequenceEntry { previous <- no_node(); item <- no_node(); };
        return inspect_sequence_entry(nodes, revision, used, tail, item) == BlockSequence &&
            trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, item.item, used, revision, result);
    };
    ref here_sites = make HereSites {
        call <- no_node(); supplied <- no_node(); receivers <- no_node(); body <- no_node(); full_scope <- false;
    };
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, revision, used, at, logical);
    val boolean <- inspect_binary(nodes, revision, used, at, binary) == ComparisonBinary ||
        operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr;
    if (boolean) {
        result.kind <- builtin_bool();
        result.defining_module <- 0u64;
        result.identity <- 0u64;
        return true;
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    if (direct_invocation(nodes, revision, used, at, call) == DirectInvocationReady ||
        inspect_here_invocation(nodes, revision, used, at, here_sites) == HereReady ||
        inspect_type_assertion(nodes, revision, used, at, assertion)) {
        if (work[at].value_kind == 0u8) return false;
        result.kind <- work[at].value_kind;
        result.defining_module <- work[at].value_module;
        result.identity <- work[at].value_identity;
        return true;
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, revision, used, at, branch)) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, branch.test, used, revision, result) ||
            result.kind != builtin_bool()) return false;
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, branch.consequent, used, revision, result)) return false;
        val left_kind <- result.kind;
        val left_module <- result.defining_module;
        val left_identity <- result.identity;
        return trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, branch.alternative, used, revision, result) &&
            result.kind == left_kind && result.defining_module == left_module && result.identity == left_identity;
    };
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, revision, used, at, selection)) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, selection.receiver, used, revision, result) ||
            result.kind != record_type()) return false;
        return describe_record_field(source, nodes, names, selected, work, spellings, intrinsic (len)(spellings), interfaces,
            interface_count, selection.field, used, revision, result)
    };
    if (name_syntax(nodes, used, at) != OrdinaryName) return false;
    val binding <- names[at].kind;
    val declaration <- names[at].declaration;
    if (binding == enum_value()) {
        if (work[at].value_kind != enum_type()) return false;
        result.kind <- enum_type();
        result.defining_module <- work[at].value_module;
        result.identity <- work[at].value_identity;
        return true;
    } else {};
    ref typed = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (binding == formal_binding()) {
        ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
        return inspect_formal(nodes, revision, used, declaration, formal) == OrdinaryFormal &&
            inspect_binding(nodes, revision, used, formal.binding, typed) == TypedBinding &&
            describe_type(nodes, names, selected, typed.annotation, 0u64, revision, used, result);
    };
    if (binding != local_binding()) return false;
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (!inspect_local_binding(nodes, revision, used, declaration, local) || local.initializer >= at) return false;
    val initializer <- local.initializer;
    if (inspect_binding(nodes, revision, used, local.binding, typed) == TypedBinding) {
        if (!describe_type(nodes, names, selected, typed.annotation, 0u64, revision, used, result)) return false;
        if (result.kind != enum_type()) return true;
        val defining_module <- result.defining_module;
        val identity <- result.identity;
        return trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, initializer, used, revision, result) &&
            result.kind == enum_type() && result.defining_module == defining_module && result.identity == identity;
    } else {};
    return trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, initializer, used, revision, result);
}

func declared_expression_failure(report:DeclaredExpressionResult in R, code:u8, at:u64) -> bool where {owner R} {
    report.diagnostic <- code;
    report.node <- at;
    return false;
}

# Bind the spelling against the already selected domain. The name binding
# and backing code refer to its canonical member regardless of spelling.
func bind_enum_spelling(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                        work:NameWork in W, spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                        spelling:u64, destination:u64, type:const DeclaredType in T, revision:u64, used:u64) -> u8
    where {const owner S, const owner N, owner B, owner W, const owner P, const owner I, const owner T} {
    if (type.defining_module == 0u64) {
        ref domain = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        if (inspect_declaration(nodes, revision, used, type.identity, domain) != EnumTypeDeclaration) return unproved_type_assertion();
        val local_member <- find_enum_member(source, nodes, spelling, domain.entries, revision, used);
        if (local_member == no_node()) return missing_enum_member();
        names[destination].declaration <- names[local_member].declaration;
        work[destination].enum_code <- work[local_member].enum_code;
        return 0u8;
    } else {};
    val head <- find_interface(interfaces, interface_count, type.defining_module, type.identity);
    if (head == no_node() || interfaces[head].interface_kind != enum_type())
        return unproved_type_assertion();
    val member <- enum_spelling(source, syntax_first(nodes, used, spelling), syntax_past(nodes, used, spelling), spellings, interfaces, head);
    if (member == no_node()) return missing_enum_member();
    names[destination].declaration <- interfaces[member].declaration;
    work[destination].enum_code <- interfaces[member].enum_code;
    return 0u8;
}

func integer_code(nodes:const ExprNodes in N, used:u64, revision:u64, at:u64, code:u64 in C)
    -> bool where {const owner N, owner C} {
    val literal <- ungrouped(nodes, revision, used, at);
    if (literal >= used || literal >= intrinsic (len)(nodes)) return false;
    return case nodes[literal] of {
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (IntegerLiteral { val value <- magnitude; }) -> { (code <- value):void; true };
                (_) -> { false };
            }
        };
        (_) -> { false };
    }
}

func bind_enum_code(nodes:const ExprNodes in N, names:NameBindings in B, work:NameWork in W,
                    interfaces:const ModuleInterfaces in I, interface_count:u64, code:u64,
                    destination:u64, type:const DeclaredType in T, revision:u64, used:u64) -> u8
    where {const owner N, owner B, owner W, const owner I, const owner T} {
    if (type.defining_module == 0u64) {
        ref domain = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        if (inspect_declaration(nodes, revision, used, type.identity, domain) != EnumTypeDeclaration)
            return unproved_type_assertion();
        if (names[domain.value_type].kind == builtin_i64() && code > 9223372036854775807u64)
            return missing_enum_member();
        val member <- find_enum_code(nodes, names, work, domain.entries, code, revision, used);
        if (member == no_node()) return missing_enum_member();
        names[destination].declaration <- member;
        work[destination].enum_code <- code;
        return 0u8
    };
    val head <- find_interface(interfaces, interface_count, type.defining_module, type.identity);
    if (head == no_node() || interfaces[head].interface_kind != enum_type())
        return unproved_type_assertion();
    val width <- interfaces[head].entry_count;
    if (width >= interface_count - head) return unproved_type_assertion();
    if (interfaces[head].element_kind == builtin_i64() && code > 9223372036854775807u64)
        return missing_enum_member();
    for (row in head + 1u64 .. head + 1u64 + width) {
        if (interfaces[row].value_kind != enum_type()) return unproved_type_assertion();
        if (interfaces[row].enum_code == code) {
            names[destination].declaration <- interfaces[row].declaration;
            work[destination].enum_code <- code;
            return 0u8
        }
    };
    return missing_enum_member()
}

func remember_type(work:NameWork in W, at:u64, type:const DeclaredType in T) -> void
    where {owner W, const owner T} {
    work[at].value_kind <- type.kind;
    work[at].value_module <- type.defining_module;
    (work[at].value_identity <- type.identity):void;
}

func readonly_owner_name(nodes:const ExprNodes in N, names:const NameBindings in B, at:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner B} {
    if (at == no_node() || names[at].kind != owner_binding()) return false;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    return inspect_signature(nodes, revision, used, names[at].declaration, signature) == OwnerSignatureClause && signature.readonly;
}

func check_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
                         receiver:const LocalBindingSites in L, used:u64, revision:u64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner L, owner R} {
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_binding(nodes, revision, used, receiver.binding, binding) != TypedBinding || binding.owner_name == no_node()) return true;
    val initializer <- ungrouped(nodes, revision, used, receiver.initializer);
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    if (inspect_construction(nodes, revision, used, initializer, construction) != PositionalConstruction ||
        names[construction.requested].kind != builtin_string()) return true;
    if (readonly_owner_name(nodes, names, binding.owner_name, used, revision))
        return declared_expression_failure(report, readonly_string_owner(), binding.owner_name);
    return true;
}

func check_text_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                              selected:const SelectedExports in E, work:const NameWork in W,
                              spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                              tail:u64, owner_name:u64, used:u64, revision:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    if (readonly_owner_name(nodes, names, owner_name, used, revision))
        return declared_expression_failure(report, readonly_string_owner(), owner_name);
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, ArgumentSequence, item))
        return declared_expression_failure(report, invalid_string_operand(), tail);
    ref argument = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref actual = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val operand <- no_node();
    for (unused in 0u64 .. 2u64) {
        if (item == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, used, item, argument) != ArgumentSequence)
            return declared_expression_failure(report, invalid_string_operand(), item);
        operand <- argument.item;
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, operand, used, revision, actual) ||
            (!text_type(actual.kind) && actual.kind != lexical_builder_type()))
            return declared_expression_failure(report, invalid_string_operand(), operand);
        if (item == tail) return true;
        item <- work[item].next;
    };
    return false;
}

func prepare_enum_domain(nodes:const ExprNodes in N, names:const NameBindings in B, work:NameWork in W,
                         interfaces:const ModuleInterfaces in I, interface_count:u64,
                         wanted:const DeclaredType in T, at:u64, used:u64, revision:u64) -> bool
    where {const owner N, const owner B, owner W, const owner I, const owner T} {
    if (wanted.defining_module != 0u64) {
        val head <- find_interface(interfaces, interface_count, wanted.defining_module, wanted.identity);
        if (head == no_node() || interfaces[head].interface_kind != enum_type() ||
            interfaces[head].entry_count == 0u64 || interfaces[head].entry_count >= interface_count - head)
            return false;
        for (member in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
            if (interfaces[member].value_kind != enum_type()) return false
        };
        work[at].enum_members <- head;
        work[at].enum_backing <- interfaces[head].element_kind;
    } else {
        ref domain = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        ref first = make u64 { no_node() };
        if (inspect_declaration(nodes, revision, used, wanted.identity, domain) != EnumTypeDeclaration ||
            !first_sequence_entry(nodes, revision, used, domain.entries, EnumSequence, first)) return false;
        work[at].enum_members <- first;
        work[at].enum_backing <- names[domain.value_type].kind;
    };
    return work[at].enum_backing != 0u8
}

func mark_folded_operand(nodes:const ExprNodes in N, work:NameWork in W, operand:u64, used:u64, revision:u64)
    -> void where {const owner N, owner W} {
    ref inner = make u64 { no_node() };
    val current <- operand;
    for (unused in 0u64 .. used) {
        work[current].enum_assertion <- FoldedEnumOperand;
        if (inspect_group(nodes, revision, used, current, inner) != ParenthesizedExpression) return;
        (current <- inner):void
    };
}

func prepare_selected_enum_value(names:const NameBindings in B, selected:const SelectedExports in E,
                                 work:NameWork in W, interfaces:const ModuleInterfaces in I,
                                 interface_count:u64, at:u64) -> bool
    where {const owner B, const owner E, owner W, const owner I} {
    val selected_value <- names[at].declaration;
    if (selected_value >= intrinsic (len)(selected)) return false;
    val head <- selected[selected_value].enum_head;
    if (head >= interface_count || interfaces[head].interface_kind != enum_type() ||
        interfaces[head].defining_module != selected[selected_value].origin_module) return false;
    work[at].value_kind <- enum_type();
    work[at].value_module <- interfaces[head].defining_module;
    work[at].value_identity <- interfaces[head].declaration;
    work[at].enum_code <- selected[selected_value].enum_code;
    return true
}

# Complete only the bound enum selection. Value operands are checked later,
# against this selection and their own ordered evaluation facts.
export func prepare_enum_assertions(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                                   selected:const SelectedExports in E, work:NameWork in W,
                                   spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                                   interface_count:u64, used:u64, revision:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, owner R} {
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    ref wanted = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    ref code = make u64 { 0u64 };
    val operand <- no_node();
    val problem <- 0u8;
    val numeric <- false;
    for (at in 0u64 .. used) {
        if (names[at].kind == enum_value() &&
            !prepare_selected_enum_value(names, selected, work, interfaces, interface_count, at))
            return declared_expression_failure(report, unproved_enum_operand(), at);
        if (inspect_type_assertion(nodes, revision, used, at, assertion) &&
            describe_type(nodes, names, selected, assertion.annotation, 0u64, revision, used, wanted) &&
            wanted.kind == enum_type()) {
            if (!prepare_enum_domain(nodes, names, work, interfaces, interface_count, wanted, at, used, revision))
                return declared_expression_failure(report, unproved_type_assertion(), assertion.annotation);
            operand <- assertion.operand;
            numeric <- integer_code(nodes, used, revision, operand, code);
            if (numeric || (name_syntax(nodes, used, operand) == OrdinaryName && names[operand].kind == 0u8)) {
                problem <- if (numeric) {
                    bind_enum_code(nodes, names, work, interfaces, interface_count, code, at, wanted, revision, used)
                } else {
                    bind_enum_spelling(source, nodes, names, work, spellings, interfaces, interface_count,
                                      operand, at, wanted, revision, used)
                };
                if (problem != 0u8) return declared_expression_failure(report, problem,
                    if (problem == missing_enum_member()) { operand } else { (assertion.annotation) });
                mark_folded_operand(nodes, work, operand, used, revision);
                (work[at].enum_assertion <- ConstantEnumAssertion):void
            } else {
                (work[at].enum_assertion <- ValueEnumAssertion):void
            };
            remember_type(work, at, wanted);
        };
    };
    return true
}

func check_type_assertion(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                          selected:const SelectedExports in E, work:NameWork in W,
                          spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                          at:u64, used:u64, revision:u64, assertion:const AssertionSites in Q, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, owner W, const owner P, const owner I, const owner Q, owner R} {
    val operand <- assertion.operand;
    ref actual = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    if (work[at].enum_assertion == ConstantEnumAssertion) return true;
    if (work[at].enum_assertion == ValueEnumAssertion) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count,
                        operand, used, revision, actual))
            return declared_expression_failure(report, unproved_enum_operand(), operand);
        if (actual.kind != work[at].enum_backing &&
            (actual.kind != enum_type() || actual.defining_module != work[at].value_module ||
             actual.identity != work[at].value_identity))
            return declared_expression_failure(report, incompatible_enum_assertion(), operand);
        return true
    };
    ref wanted = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val annotation <- assertion.annotation;
    if (!describe_type(nodes, names, selected, annotation, 0u64, revision, used, wanted))
        return declared_expression_failure(report, unproved_type_assertion(), annotation);
    if (wanted.kind == builtin_c_string()) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, operand, used, revision, actual) || !text_type(actual.kind))
            return declared_expression_failure(report, invalid_c_string_operand(), operand);
        val selected_text <- ungrouped(nodes, revision, used, operand);
        if (text_literal_syntax(nodes, used, selected_text) == InteriorNulLiteral)
            return declared_expression_failure(report, interior_nul_in_c_string(), selected_text);
        remember_type(work, at, wanted);
        return true;
    };
    return declared_expression_failure(report, unproved_type_assertion(), annotation)
}

func check_case_pattern(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                        work:NameWork in W, spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                        pattern:u64, subject:const DeclaredType in T, used:u64, revision:u64) -> u8
    where {const owner S, const owner N, owner B, owner W, const owner P, const owner I, const owner T} {
    val mode <- case_pattern(nodes, used, pattern);
    if (subject.kind == builtin_bool()) {
        if (mode != TrueCaseTarget && mode != FalseCaseTarget) return invalid_case_pattern_type();
        (work[pattern].enum_code <- if (mode == TrueCaseTarget) { 1u64 } else { 0u64 }):void;
    } else {
        if (subject.kind != enum_type()) return unproved_case_subject();
        if (mode != NamedCaseMember) return invalid_case_pattern_type();
        val code <- bind_enum_spelling(source, nodes, names, work, spellings, interfaces, interface_count, pattern, pattern, subject, revision, used);
        if (code == missing_enum_member()) return missing_case_member();
        if (code != 0u8) return unproved_case_subject();
    };
    remember_type(work, pattern, subject);
    return 0u8;
}

func check_case_declaration(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                            selected:const SelectedExports in E, work:NameWork in W,
                            spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                            at:u64, used:u64, revision:u64, choice:const CaseSites in C, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, const owner C, owner R} {
    ref subject = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    ref predicate = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val operand <- choice.subject;
    # Null patterns retain their syntax. The flow checker will prove
    # presence and readability for the execution of the other patterns.
    val known <- trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, operand, used, revision, subject);
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, choice.items, BlockSequence, item))
        return declared_expression_failure(report, unproved_case_subject(), at);
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    val pattern <- no_node();
    val guard <- no_node();
    val code <- 0u8;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (item == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence)
            return declared_expression_failure(report, unproved_case_subject(), item);
        if (inspect_case_arm(nodes, revision, used, entry.item, arm)) {
            pattern <- arm.pattern;
            if (pattern != no_node() && case_pattern(nodes, used, pattern) != NullCaseTarget) {
                if (!known) return declared_expression_failure(report, unproved_case_subject(), operand);
                code <- check_case_pattern(source, nodes, names, work, spellings, interfaces, interface_count, pattern, subject, used, revision);
                if (code != 0u8) return declared_expression_failure(report, code, pattern);
            } else {};
            guard <- arm.guard;
            if (guard != no_node() &&
                trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, guard, used, revision, predicate) &&
                predicate.kind != builtin_bool())
                return declared_expression_failure(report, invalid_case_guard_type(), guard);
        } else {};
        item <- work[item].next;
    };
    return true;
}

func check_place_installation(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                             selected:const SelectedExports in E, work:const NameWork in W,
                             spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                             destination:u64, input:u64, used:u64, revision:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    if (name_syntax(nodes, used, destination) != OrdinaryName || names[destination].kind != formal_binding()) return true;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (inspect_formal(nodes, revision, used, names[destination].declaration, formal) != OrdinaryFormal ||
        (formal.mode != PlaceFormal && formal.mode != InitializingPlaceFormal)) return true;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    if (trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, input, used, revision, type) && !text_type(type.kind))
        return declared_expression_failure(report, invalid_string_installation(), input);
    return true;
}

export func check_declared_expressions(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                                       selected:const SelectedExports in E, work:NameWork in W,
                                       spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64,
                                       used:u64, revision:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, owner R} {
    ref local = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    ref assertion = make AssertionSites { operand <- no_node(); annotation <- no_node(); colon <- 0u64; };
    ref choice = make CaseSites { subject <- no_node(); items <- no_node(); };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val place_operation <- PlaceRebind;
    for (at in 0u64 .. used) {
        if (inspect_local_binding(nodes, revision, used, at, local) && local.mode != ExceptionLocal &&
            !check_text_receiver(nodes, names, local, used, revision, report)) return false;
        if (inspect_construction(nodes, revision, used, at, construction) == PositionalConstruction &&
            (names[construction.requested].kind == builtin_string() ||
             is_lexical_builder(nodes, names, construction.requested, revision, used)) &&
            !check_text_construction(source, nodes, names, selected, work, spellings, interfaces, interface_count,
                                     construction.contents, construction.placement, used, revision, report)) return false;
        if (inspect_type_assertion(nodes, revision, used, at, assertion) &&
            !check_type_assertion(source, nodes, names, selected, work, spellings, interfaces, interface_count, at, used, revision, assertion, report)) return false;
        if (!work[at].case_schema_prepared && inspect_case(nodes, revision, used, at, choice) &&
            !check_case_declaration(source, nodes, names, selected, work, spellings, interfaces, interface_count, at, used, revision, choice, report)) return false;
        place_operation <- inspect_assignment(nodes, revision, used, at, assignment);
        if (place_operation == PlaceRebind &&
            !check_place_installation(source, nodes, names, selected, work, spellings, interfaces, interface_count,
                                      assignment.destination, assignment.input, used, revision, report)) return false;
    };
    return true;
}

export func prepare_native_operand_types(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                                     selected:const SelectedExports in E, work:NameWork in W,
                                     spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, interface_count:u64, used:u64, revision:u64)
    where {const owner S, const owner N, const owner B, const owner E, owner W, const owner P, const owner I} {
    ref result = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    val composite <- false;
    ref tail = make u64 { no_node() };
    for (at in 0u64 .. used) {
        composite <- inspect_field_selection(nodes, revision, used, at, selection) ||
            (!is_scope_block(nodes, at) && block_tail(nodes, revision, used, at, tail)) ||
            inspect_conditional(nodes, revision, used, at, branch);
        if ((composite || (name_syntax(nodes, used, at) == OrdinaryName && names[at].kind != 0u8)) &&
            trace_type(source, nodes, names, selected, work, spellings, interfaces, interface_count, at, used, revision, result)) {
            if (result.kind == enum_type() || text_type(result.kind) || (composite && native_scalar(result.kind))) {
                work[at].value_kind <- result.kind;
                work[at].value_module <- result.defining_module;
                (work[at].value_identity <- result.identity):void;
            } else {};
        } else {};
    };
}

func stage_record(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                  work:const NameWork in W, record:u64, defining_module:u64, count:u64, revision:u64, used:u64,
                  storage:AggregateStorage, declaration:const DeclarationSites in D, interfaces:ModuleInterfaces in I)
    -> u64 where {const owner N, const owner B, const owner E, const owner W, const owner D, owner I} {
    if (lexical_builder_record(nodes, names, record, revision, used)) return count;
    val limit <- intrinsic (len)(interfaces);
    if (count >= limit || storage == UnprovedAggregate) return no_node();
    ref field = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, declaration.entries, FormalSequence, field)) return no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val next <- count + 1u64;
    val name <- declaration.name;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    ref failure = make ExceptionType { defining_module <- 0u64; declaration <- no_node(); checked <-
        false; };
    val nominal_failure <- resolve_exception_type(nodes, names, selected, name, defining_module,
        used, revision, failure);
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (field == no_node()) {
            write_interface_header(interfaces[count], defining_module, record, record_type(), 0u8, next - count - 1u64);
            interfaces[count].name_first <- syntax_first(nodes, used, name);
            interfaces[count].name_past <- syntax_past(nodes, used, name);
            interfaces[count].aggregate_storage <- storage;
            if (nominal_failure) { (interfaces[count].exception_schema <-
                exception_schema(failure)):void; };
            return next;
        } else {};
        if (next >= limit || inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding ||
            !describe_type(nodes, names, selected, binding.annotation, defining_module, revision, used, type))
            return no_node();
        write_interface_header(interfaces[next], 0u64, 0u64, 0u8, 0u8, 0u64);
        interfaces[next].value_kind <- type.kind;
        interfaces[next].type_module <- type.defining_module;
        interfaces[next].type_identity <- type.identity;
        interfaces[next].name_first <- syntax_first(nodes, used, binding.name);
        interfaces[next].name_past <- syntax_past(nodes, used, binding.name);
        interfaces[next].field_mode <- formal.mode;
        interfaces[next].target_readonly <- if (binding.readonly) { 1u8 } else { 0u8 };
        field <- work[field].next;
        next <- next + 1u64;
    };
    return no_node();
}

func stage_enum(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                declaration:u64, module:u64, start:u64, revision:u64, used:u64, domain:const DeclarationSites in D, interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner W, const owner D, owner I} {
    val limit <- intrinsic (len)(interfaces);
    if (start >= limit) return no_node();
    ref member = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, domain.entries, EnumSequence, member)) return no_node();
    ref entry = make EnumMemberSites { name <- no_node(); previous <- no_node(); initializer <- no_node(); };
    val row <- start + 1u64;
    val name <- domain.name;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (member == no_node()) {
            write_interface_header(interfaces[start], module, declaration, enum_type(), 0u8, row - start - 1u64);
            interfaces[start].element_kind <- names[domain.value_type].kind;
            interfaces[start].name_first <- syntax_first(nodes, used, name);
            interfaces[start].name_past <- syntax_past(nodes, used, name);
            return row;
        } else {};
        if (row >= limit || !inspect_enum_member(nodes, revision, used, member, entry)) return no_node();
        write_interface_header(interfaces[row], 0u64, names[member].declaration, 0u8, 0u8, 0u64);
        interfaces[row].value_kind <- enum_type();
        interfaces[row].enum_code <- work[member].enum_code;
        interfaces[row].name_first <- syntax_first(nodes, used, entry.name);
        interfaces[row].name_past <- syntax_past(nodes, used, entry.name);
        member <- work[member].next;
        row <- row + 1u64;
    };
    return no_node();
}

func stage_constructor_field(interfaces:ModuleInterfaces in I, row:u64, first:u64, past:u64,
                             type:const DeclaredType in T, mode:FormalMode, readonly:bool) -> void
    where {owner I, const owner T} {
    write_sum_row(interfaces, row, 0u64, 0u64, 0u8, 0u64, first, past, make ConstructorField {
        field_kind <- type.kind; field_module <- type.defining_module; field_identity <- type.identity;
        mode <- mode; readonly <- readonly;
    });
}

func stage_constructor_header(interfaces:ModuleInterfaces in I, start:u64, module:u64, arm:u64,
                              sum:u64, entries:u64, first:u64, past:u64) -> void where {owner I} {
    write_sum_row(interfaces, start, module, arm, constructor_type(), entries, first, past,
                  make ConstructorInterface { sum_module <- module; sum_declaration <- sum; });
}

func stage_constructor(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                       work:const NameWork in W, defining_module:u64, sum:u64, arm:u64, start:u64, revision:u64, used:u64,
                       sites:const SumArmSites in A, interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner E, const owner W, const owner A, owner I} {
    val limit <- intrinsic (len)(interfaces);
    if (start >= limit) return no_node();
    ref field = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, sites.fields, FormalSequence, field)) return no_node();
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val next <- start + 1u64;
    for (unused in 0u64 .. used + 1u64) {
        if (field == no_node()) {
            stage_constructor_header(interfaces, start, defining_module, arm, sum, next - start - 1u64,
                                     syntax_first(nodes, used, sites.name), syntax_past(nodes, used, sites.name));
            return next;
        };
        if (next >= limit || inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
            inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding ||
            !describe_type(nodes, names, selected, binding.annotation, defining_module, revision, used, type))
            return no_node();
        stage_constructor_field(interfaces, next, syntax_first(nodes, used, binding.name),
                                syntax_past(nodes, used, binding.name), type, formal.mode, binding.readonly);
        field <- work[field].next;
        next <- next + 1u64;
    };
    return no_node();
}

func stage_constructor_reference(interfaces:ModuleInterfaces in I, row:u64, defining_module:u64, arm:u64)
    -> void where {owner I} {
    write_sum_row(interfaces, row, 0u64, 0u64, 0u8, 0u64, 0u64, 0u64,
                  make ConstructorReference { defining_module <- defining_module; declaration <- arm; });
}

func stage_sum_members(nodes:const ExprNodes in N, work:const NameWork in W, defining_module:u64,
                       first:u64, last:u64, start:u64, revision:u64, used:u64, interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner W, owner I} {
    val limit <- intrinsic (len)(interfaces);
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node(); };
    val arm <- first;
    val row <- start;
    for (unused in 0u64 .. used) {
        if (row >= limit || !inspect_sum_arm(nodes, revision, used, arm, sites)) return no_node();
        stage_constructor_reference(interfaces, row, defining_module, arm);
        row <- row + 1u64;
        if (arm == last) return row;
        arm <- work[arm].next;
    };
    return no_node();
}

func stage_sum(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
               work:const NameWork in W, defining_module:u64, sum:u64, start:u64, revision:u64, used:u64,
               storage:AggregateStorage, domain:const DeclarationSites in D, interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner E, const owner W, const owner D, owner I} {
    val limit <- intrinsic (len)(interfaces);
    if (start >= limit || (storage != CoDBitsAggregate && storage != NonBitsAggregate)) return no_node();
    ref first = make u64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, domain.entries, SumSequence, first) || first == no_node())
        return no_node();
    val member_past <- stage_sum_members(nodes, work, defining_module, first, domain.entries, start + 1u64, revision, used, interfaces);
    if (member_past == no_node()) return no_node();
    write_sum_row(interfaces, start, defining_module, sum, sum_type(), member_past - start - 1u64,
                  syntax_first(nodes, used, domain.name), syntax_past(nodes, used, domain.name), make SumInterface {});
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node(); };
    val arm <- first;
    val row <- member_past;
    for (entry in start + 1u64 .. member_past) {
        if (!inspect_sum_arm(nodes, revision, used, arm, sites)) return no_node();
        row <- stage_constructor(nodes, names, selected, work, defining_module, sum, arm, row, revision, used, sites, interfaces);
        if (row == no_node() || checked_sum_constructor(interfaces, row, start, entry) == no_node())
            return no_node();
        arm <- work[arm].next;
    };
    interfaces[start].aggregate_storage <- storage;
    return row;
}

# Complete member shape is available by an already resolved defining identity.
export func publish_type_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                                      work:const NameWork in W, facts:const AggregateFacts in F,
                                      used:u64, revision:u64, defining_module:u64, start:u64,
                                      interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner E, const owner W, const owner F, owner I} {
    if (used > intrinsic (len)(facts)) return no_node();
    val count <- start;
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- NominalRecord;
    for (at in 0u64 .. used) {
        shape <- inspect_declaration(nodes, revision, used, at, declaration);
        if (shape == NominalRecord || shape == NativeRecord) {
            (count <- stage_record(nodes, names, selected, work, at, defining_module, count,
                                  revision, used, facts[at], declaration, interfaces)):void;
        } else {
            if (shape == EnumTypeDeclaration) {
                (count <- stage_enum(nodes, names, work, at, defining_module, count,
                                    revision, used, declaration, interfaces)):void;
            };
        };
        if (shape == NominalSum) {
            (count <- stage_sum(nodes, names, selected, work, defining_module, at, count,
                                revision, used, facts[at], declaration, interfaces)):void;
        };
        if (count == no_node()) return count;
    };
    return count;
}
