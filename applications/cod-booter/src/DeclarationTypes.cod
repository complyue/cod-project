using "SourceStorage.cod" SourceBytes;
using "SourceAccess.cod" same_bytes;
using "ParserStorage.cod" {
    ExprNodes, no_node, group_node, ungrouped, name_node, owned_type_node, typed_name_node, data_parent_node,
    make_named_node, field_access_node, enum_declaration_node, type_assertion_node, literal_node, text_literal_node,
    narrow_integer_node, bool_node, call_node, here_call_node, compare_node, logical_not_node, logical_binary,
    case_node, case_arm_node, case_member_pattern, case_true_pattern, case_false_pattern, case_null_pattern,
    readonly_declaration, local_storage_binding, positional_construction, rebind_node, direct_place_parameter,
};
using "NameResolution.cod" {
    NameBindings, NameWork, first_item, find_record_field, record_declaration, formal_binding, local_binding,
    ordinary_selection, record_type, native_scalar, enum_value, find_enum_member,
    is_lexical_builder, lexical_builder_record, lexical_builder_type,
    builtin_u64, builtin_u32, builtin_u8, builtin_bool, builtin_string, builtin_c_string, text_type, owner_binding,
};
using "ModuleExports.cod" { SelectedExports, record_export, enum_export, enum_spelling };
using "ModuleExportStorage.cod" { ModuleInterfaces, find_interface, write_interface_header, enum_type };

export func type_module(names:const NameBindings in B, selected:const SelectedExports in E,
                        marker:u64, current_module:u64) -> u64 where {const owner B, const owner E} {
    if (names[marker].kind == ordinary_selection()) return selected[names[marker].declaration].origin_module;
    return current_module;
}

export func type_identity(names:const NameBindings in B, selected:const SelectedExports in E,
                          marker:u64) -> u64 where {const owner B, const owner E} {
    val declaration <- names[marker].declaration;
    if (names[marker].kind == ordinary_selection()) return selected[declaration].identity;
    return declaration;
}

data DeclaredType {
    kind:u8;
    defining_module:u64;
    identity:u64;
}

export data DeclaredExpressionResult {
    diagnostic:u8;
    node:u64;
}

export func unproved_type_assertion() -> u8 { return 84u8; }
func missing_enum_member() -> u8 { return 85u8; }
func incompatible_enum_assertion() -> u8 { return 86u8; }
func unproved_enum_operand() -> u8 { return 87u8; }
func unproved_case_subject() -> u8 { return 93u8; }
func invalid_case_pattern_type() -> u8 { return 94u8; }
func missing_case_member() -> u8 { return 95u8; }
func invalid_case_guard_type() -> u8 { return 96u8; }
func invalid_c_string_operand() -> u8 { return 97u8; }
export func interior_nul_in_c_string() -> u8 { return 98u8; }
func invalid_string_operand() -> u8 { return 102u8; }
func readonly_string_owner() -> u8 { return 103u8; }
func invalid_string_installation() -> u8 { return 110u8; }

func describe_type(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                   annotation:u64, current_module:u64, result:DeclaredType in R) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    if (annotation == no_node()) return false;
    val marker <- if (nodes[annotation].kind == owned_type_node()) { (nodes[annotation].left) } else { annotation };
    val kind <- names[marker].kind;
    if (native_scalar(kind) || text_type(kind)) {
        result.kind <- kind;
        result.defining_module <- 0u64;
        result.identity <- 0u64;
        return true;
    } else {};
    val nominal <- kind;
    if (is_lexical_builder(nodes, names, marker)) {
        result.kind <- lexical_builder_type();
        result.defining_module <- type_module(names, selected, marker, current_module);
        result.identity <- type_identity(names, selected, marker);
        return true;
    };
    if (kind == ordinary_selection()) {
        val exported <- selected[names[marker].declaration].kind;
        if (exported == record_export()) { (nominal <- record_type()):void; } else {
            if (exported == enum_export()) { (nominal <- enum_type()):void; } else { return false; };
        };
    } else {};
    if (nominal != record_type() && nominal != enum_type()) return false;
    result.kind <- nominal;
    result.defining_module <- type_module(names, selected, marker, current_module);
    result.identity <- type_identity(names, selected, marker);
    return true;
}

func local_member_type(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                       selected:const SelectedExports in E, work:const NameWork in W, name:u64, result:DeclaredType in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, owner R} {
    val field <- find_record_field(source, nodes, work, result.identity, name);
    return field != no_node() && describe_type(nodes, names, selected, nodes[nodes[field].right].right, 0u64, result);
}

func imported_member_type(source:const SourceBytes in S, nodes:const ExprNodes in N, spellings:const SourceBytes in P,
                          interfaces:const ModuleInterfaces in I, name:u64, result:DeclaredType in R) -> bool
    where {const owner S, const owner N, const owner P, const owner I, owner R} {
    val head <- find_interface(interfaces, result.defining_module, result.identity);
    if (head == no_node() || interfaces[head].interface_kind != record_type()) return false;
    val first <- nodes[name].first;
    val past <- nodes[name].past;
    for (row in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (same_bytes(source, first, past, spellings, interfaces[row].name_first, interfaces[row].name_past)) {
            result.kind <- interfaces[row].value_kind;
            result.defining_module <- interfaces[row].type_module;
            result.identity <- interfaces[row].type_identity;
            return true;
        } else {};
    };
    return false;
}

# Follow only syntax and bound declarations here. The result carries the
# nominal type, with no claim about target readiness or a readable loan.
func trace_type(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                selected:const SelectedExports in E, work:const NameWork in W,
                spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                at:u64, result:DeclaredType in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    val kind <- nodes[at].kind;
    if (kind == text_literal_node()) {
        result.kind <- builtin_string();
        result.defining_module <- 0u64;
        result.identity <- 0u64;
        return true;
    } else {};
    val boolean <- kind == bool_node() || kind == compare_node() || kind == logical_not_node() || logical_binary(kind);
    if (kind == literal_node() || kind == narrow_integer_node() || boolean) {
        result.kind <- if (boolean) { builtin_bool() } else {
            if (nodes[at].left == 8u64) { builtin_u8() } else {
                if (nodes[at].left == 32u64) { builtin_u32() } else { builtin_u64() }
            }
        };
        result.defining_module <- 0u64;
        result.identity <- 0u64;
        return true;
    } else {};
    if (kind == call_node() || kind == here_call_node() || kind == type_assertion_node()) {
        if (work[at].value_kind == 0u8) return false;
        result.kind <- work[at].value_kind;
        result.defining_module <- work[at].value_module;
        result.identity <- work[at].value_identity;
        return true;
    } else {};
    if (kind == make_named_node())
        return describe_type(nodes, names, selected, nodes[at].left, 0u64, result);
    if (kind == group_node())
        return trace_type(source, nodes, names, selected, work, spellings, interfaces, nodes[at].left, result);
    if (kind == field_access_node()) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, nodes[at].left, result) ||
            result.kind != record_type()) return false;
        if (result.defining_module == 0u64)
            return local_member_type(source, nodes, names, selected, work, nodes[at].right, result);
        return imported_member_type(source, nodes, spellings, interfaces, nodes[at].right, result);
    } else {};
    if (kind != name_node()) return false;
    val binding <- names[at].kind;
    val declaration <- names[at].declaration;
    if (binding == enum_value()) {
        val head <- selected[declaration].enum_head;
        result.kind <- enum_type();
        result.defining_module <- interfaces[head].defining_module;
        result.identity <- interfaces[head].declaration;
        return true;
    } else {};
    if (binding == formal_binding()) {
        val formal <- nodes[declaration].right;
        if (formal == no_node() || nodes[formal].kind != typed_name_node()) return false;
        return describe_type(nodes, names, selected, nodes[formal].right, 0u64, result);
    } else {};
    if (binding != local_binding()) return false;
    val local <- nodes[declaration].left;
    val initializer <- nodes[declaration].right;
    if (initializer == no_node() || initializer >= at) return false;
    if (nodes[local].kind == typed_name_node()) {
        if (!describe_type(nodes, names, selected, nodes[local].right, 0u64, result)) return false;
        if (result.kind != enum_type()) return true;
        val defining_module <- result.defining_module;
        val identity <- result.identity;
        return trace_type(source, nodes, names, selected, work, spellings, interfaces, initializer, result) &&
            result.kind == enum_type() && result.defining_module == defining_module && result.identity == identity;
    } else {};
    return trace_type(source, nodes, names, selected, work, spellings, interfaces, initializer, result);
}

func declared_expression_failure(report:DeclaredExpressionResult in R, code:u8, at:u64) -> bool where {owner R} {
    report.diagnostic <- code;
    report.node <- at;
    return false;
}

# Bind the spelling against the already selected domain. The name binding
# and backing code refer to its canonical member regardless of spelling.
func bind_enum_spelling(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                        work:NameWork in W, spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                        spelling:u64, destination:u64, type:const DeclaredType in T) -> u8
    where {const owner S, const owner N, owner B, owner W, const owner P, const owner I, const owner T} {
    if (type.defining_module == 0u64) {
        val local_member <- find_enum_member(source, nodes, spelling, nodes[type.identity].right);
        if (local_member == no_node()) return missing_enum_member();
        names[destination].declaration <- names[local_member].declaration;
        work[destination].enum_code <- work[local_member].enum_code;
        return 0u8;
    } else {};
    val head <- find_interface(interfaces, type.defining_module, type.identity);
    if (head == no_node() || interfaces[head].interface_kind != enum_type())
        return unproved_type_assertion();
    val member <- enum_spelling(source, nodes[spelling].first, nodes[spelling].past, spellings, interfaces, head);
    if (member == no_node()) return missing_enum_member();
    names[destination].declaration <- interfaces[member].declaration;
    work[destination].enum_code <- interfaces[member].enum_code;
    return 0u8;
}

func remember_type(work:NameWork in W, at:u64, type:const DeclaredType in T) -> void
    where {owner W, const owner T} {
    work[at].value_kind <- type.kind;
    work[at].value_module <- type.defining_module;
    (work[at].value_identity <- type.identity):void;
}

func readonly_owner_name(nodes:const ExprNodes in N, names:const NameBindings in B, at:u64) -> bool
    where {const owner N, const owner B} {
    return at != no_node() && names[at].kind == owner_binding() &&
        nodes[names[at].declaration].number == readonly_declaration();
}

func check_text_receiver(nodes:const ExprNodes in N, names:const NameBindings in B,
                         at:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, owner R} {
    val binding <- nodes[at].left;
    if (nodes[binding].kind != typed_name_node()) return true;
    val annotation <- nodes[binding].right;
    if (nodes[annotation].kind != owned_type_node()) return true;
    val operand <- nodes[at].right;
    if (operand == no_node()) return true;
    val initializer <- ungrouped(nodes, operand);
    if (nodes[initializer].kind != make_named_node() || names[nodes[initializer].left].kind != builtin_string())
        return true;
    val destination <- nodes[annotation].right;
    if (readonly_owner_name(nodes, names, destination))
        return declared_expression_failure(report, readonly_string_owner(), destination);
    return true;
}

func check_text_construction(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                              selected:const SelectedExports in E, work:const NameWork in W,
                              spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                              at:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    val payload <- nodes[at].right;
    val owner_name <- nodes[payload].right;
    if (readonly_owner_name(nodes, names, owner_name))
        return declared_expression_failure(report, readonly_string_owner(), owner_name);
    val tail <- nodes[payload].left;
    val first <- first_item(nodes, tail);
    if (first == no_node()) return true;
    ref actual = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val item <- first;
    val operand <- no_node();
    for (unused in 0u64 .. 2u64) {
        if (item == no_node()) return true;
        operand <- nodes[item].right;
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, operand, actual) ||
            (!text_type(actual.kind) && actual.kind != lexical_builder_type()))
            return declared_expression_failure(report, invalid_string_operand(), operand);
        if (item == tail) return true;
        item <- work[item].next;
    };
    return false;
}

func check_type_assertion(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                          selected:const SelectedExports in E, work:NameWork in W,
                          spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                          at:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, owner R} {
    ref wanted = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val annotation <- nodes[at].right;
    if (!describe_type(nodes, names, selected, annotation, 0u64, wanted))
        return declared_expression_failure(report, unproved_type_assertion(), annotation);
    val operand <- nodes[at].left;
    ref actual = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    if (wanted.kind == builtin_c_string()) {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, operand, actual) || !text_type(actual.kind))
            return declared_expression_failure(report, invalid_c_string_operand(), operand);
        val selected_text <- ungrouped(nodes, operand);
        if (nodes[selected_text].kind == text_literal_node() && nodes[selected_text].number != 0u64)
            return declared_expression_failure(report, interior_nul_in_c_string(), selected_text);
        remember_type(work, at, wanted);
        return true;
    } else {};
    if (wanted.kind != enum_type())
        return declared_expression_failure(report, unproved_type_assertion(), annotation);
    if (nodes[operand].kind == name_node() && names[operand].kind == 0u8) {
        val code <- bind_enum_spelling(source, nodes, names, work, spellings, interfaces, operand, at, wanted);
        if (code == missing_enum_member()) return declared_expression_failure(report, code, operand);
        if (code != 0u8) return declared_expression_failure(report, code, annotation);
        (names[at].kind <- enum_value()):void;
    } else {
        if (!trace_type(source, nodes, names, selected, work, spellings, interfaces, operand, actual))
            return declared_expression_failure(report, unproved_enum_operand(), operand);
        if (actual.kind != enum_type() || actual.defining_module != wanted.defining_module || actual.identity != wanted.identity)
            return declared_expression_failure(report, incompatible_enum_assertion(), operand);
    };
    remember_type(work, at, wanted);
    return true;
}

func check_case_pattern(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                        work:NameWork in W, spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                        pattern:u64, subject:const DeclaredType in T) -> u8
    where {const owner S, const owner N, owner B, owner W, const owner P, const owner I, const owner T} {
    val mode <- nodes[pattern].number;
    if (subject.kind == builtin_bool()) {
        if (mode != case_true_pattern() && mode != case_false_pattern()) return invalid_case_pattern_type();
        (work[pattern].enum_code <- if (mode == case_true_pattern()) { 1u64 } else { 0u64 }):void;
    } else {
        if (subject.kind != enum_type()) return unproved_case_subject();
        if (mode != case_member_pattern()) return invalid_case_pattern_type();
        val code <- bind_enum_spelling(source, nodes, names, work, spellings, interfaces, pattern, pattern, subject);
        if (code == missing_enum_member()) return missing_case_member();
        if (code != 0u8) return unproved_case_subject();
    };
    remember_type(work, pattern, subject);
    return 0u8;
}

func check_case_declaration(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                            selected:const SelectedExports in E, work:NameWork in W,
                            spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                            at:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, owner R} {
    ref subject = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    ref predicate = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val operand <- nodes[at].left;
    # Null patterns retain their syntax. The flow checker will prove
    # presence and readability for the execution of the other patterns.
    val known <- trace_type(source, nodes, names, selected, work, spellings, interfaces, operand, subject);
    val item <- first_item(nodes, nodes[at].right);
    val arm <- no_node();
    val pattern <- no_node();
    val guard <- no_node();
    val code <- 0u8;
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (item == no_node()) return true;
        arm <- nodes[item].right;
        if (nodes[arm].kind == case_arm_node()) {
            pattern <- nodes[arm].left;
            if (pattern != no_node() && nodes[pattern].number != case_null_pattern()) {
                if (!known) return declared_expression_failure(report, unproved_case_subject(), operand);
                code <- check_case_pattern(source, nodes, names, work, spellings, interfaces, pattern, subject);
                if (code != 0u8) return declared_expression_failure(report, code, pattern);
            } else {};
            guard <- nodes[arm].number;
            if (guard != no_node() &&
                trace_type(source, nodes, names, selected, work, spellings, interfaces, guard, predicate) &&
                predicate.kind != builtin_bool())
                return declared_expression_failure(report, invalid_case_guard_type(), guard);
        } else {};
        item <- work[item].next;
    };
    return true;
}

func check_place_installation(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                             selected:const SelectedExports in E, work:const NameWork in W,
                             spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                             at:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W, const owner P, const owner I, owner R} {
    val destination <- nodes[at].left;
    if (nodes[destination].kind != name_node() || names[destination].kind != formal_binding() ||
        !direct_place_parameter(nodes[names[destination].declaration].kind)) return true;
    val input <- nodes[at].right;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    if (trace_type(source, nodes, names, selected, work, spellings, interfaces, input, type) && !text_type(type.kind))
        return declared_expression_failure(report, invalid_string_installation(), input);
    return true;
}

export func check_declared_expressions(source:const SourceBytes in S, nodes:const ExprNodes in N, names:NameBindings in B,
                                       selected:const SelectedExports in E, work:NameWork in W,
                                       spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I,
                                       used:u64, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, owner B, const owner E, owner W, const owner P, const owner I, owner R} {
    val kind <- 0u8;
    for (at in 0u64 .. used) {
        kind <- nodes[at].kind;
        if (local_storage_binding(kind) && !check_text_receiver(nodes, names, at, report)) return false;
        if (kind == make_named_node() && positional_construction(nodes, at) &&
            (names[nodes[at].left].kind == builtin_string() || is_lexical_builder(nodes, names, nodes[at].left)) &&
            !check_text_construction(source, nodes, names, selected, work, spellings, interfaces, at, report)) return false;
        if (kind == type_assertion_node() &&
            !check_type_assertion(source, nodes, names, selected, work, spellings, interfaces, at, report)) return false;
        if (kind == case_node() &&
            !check_case_declaration(source, nodes, names, selected, work, spellings, interfaces, at, report)) return false;
        if (kind == rebind_node() &&
            !check_place_installation(source, nodes, names, selected, work, spellings, interfaces, at, report)) return false;
    };
    return true;
}

export func prepare_native_operand_types(source:const SourceBytes in S, nodes:const ExprNodes in N, names:const NameBindings in B,
                                     selected:const SelectedExports in E, work:NameWork in W,
                                     spellings:const SourceBytes in P, interfaces:const ModuleInterfaces in I, used:u64)
    where {const owner S, const owner N, const owner B, const owner E, owner W, const owner P, const owner I} {
    ref result = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    val kind <- 0u8;
    for (at in 0u64 .. used) {
        kind <- nodes[at].kind;
        if ((kind == field_access_node() || (kind == name_node() && names[at].kind != 0u8)) &&
            trace_type(source, nodes, names, selected, work, spellings, interfaces, at, result)) {
            if (result.kind == enum_type() || text_type(result.kind) ||
                (kind == field_access_node() && native_scalar(result.kind))) {
                work[at].value_kind <- result.kind;
                work[at].value_module <- result.defining_module;
                (work[at].value_identity <- result.identity):void;
            } else {};
        } else {};
    };
}

func stage_record(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                  work:const NameWork in W, record:u64, defining_module:u64, count:u64, interfaces:ModuleInterfaces in I)
    -> u64 where {const owner N, const owner B, const owner E, const owner W, owner I} {
    if (lexical_builder_record(nodes, names, record)) return count;
    val limit <- intrinsic (len)(interfaces);
    if (count >= limit) return no_node();
    val field <- first_item(nodes, nodes[record].right);
    val next <- count + 1u64;
    val binding <- no_node();
    val spelling <- no_node();
    val head <- nodes[record].left;
    val name <- if (nodes[head].kind == data_parent_node()) { (nodes[head].left) } else { head };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64; };
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (field == no_node()) {
            write_interface_header(interfaces[count], defining_module, record, record_type(), 0u8, next - count - 1u64);
            interfaces[count].name_first <- nodes[name].first;
            interfaces[count].name_past <- nodes[name].past;
            return next;
        } else {};
        binding <- nodes[field].right;
        spelling <- nodes[binding].left;
        if (next >= limit || !describe_type(nodes, names, selected, nodes[binding].right, defining_module, type))
            return no_node();
        write_interface_header(interfaces[next], 0u64, 0u64, 0u8, 0u8, 0u64);
        interfaces[next].value_kind <- type.kind;
        interfaces[next].type_module <- type.defining_module;
        interfaces[next].type_identity <- type.identity;
        interfaces[next].name_first <- nodes[spelling].first;
        interfaces[next].name_past <- nodes[spelling].past;
        field <- work[field].next;
        next <- next + 1u64;
    };
    return no_node();
}

func stage_enum(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
                declaration:u64, module:u64, start:u64, interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner W, owner I} {
    val limit <- intrinsic (len)(interfaces);
    if (start >= limit) return no_node();
    val member <- first_item(nodes, nodes[declaration].right);
    val row <- start + 1u64;
    val name <- nodes[declaration].left;
    val spelling <- no_node();
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (member == no_node()) {
            write_interface_header(interfaces[start], module, declaration, enum_type(), 0u8, row - start - 1u64);
            interfaces[start].element_kind <- names[nodes[declaration].number].kind;
            interfaces[start].name_first <- nodes[name].first;
            interfaces[start].name_past <- nodes[name].past;
            return row;
        } else {};
        if (row >= limit) return no_node();
        spelling <- nodes[member].right;
        write_interface_header(interfaces[row], 0u64, names[member].declaration, 0u8, 0u8, 0u64);
        interfaces[row].value_kind <- enum_type();
        interfaces[row].enum_code <- work[member].enum_code;
        interfaces[row].name_first <- nodes[spelling].first;
        interfaces[row].name_past <- nodes[spelling].past;
        member <- work[member].next;
        row <- row + 1u64;
    };
    return no_node();
}

# Complete member shape is available by an already resolved defining identity.
export func publish_type_interfaces(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
                                      work:const NameWork in W, used:u64, defining_module:u64, start:u64,
                                      interfaces:ModuleInterfaces in I) -> u64
    where {const owner N, const owner B, const owner E, const owner W, owner I} {
    val count <- start;
    for (at in 0u64 .. used) {
        if (record_declaration(nodes[at].kind)) {
            (count <- stage_record(nodes, names, selected, work, at, defining_module, count, interfaces)):void;
        } else {
            if (nodes[at].kind == enum_declaration_node()) {
                (count <- stage_enum(nodes, names, work, at, defining_module, count, interfaces)):void;
            } else {};
        };
        if (count == no_node()) return count;
    };
    return count;
}
