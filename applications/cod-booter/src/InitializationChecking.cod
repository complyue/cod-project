using "./ParserStorage.cod" no_node;
using "./NativeCommands.cod" {
    NativeCommands, NativePlan, initialization_access, local_binding_fact,
    word_constant, copy_word, branch_equal, write_flow_flag, branch_on_flow_flag,
    require_initialized_place, copy_completion,
};
using "./InitializationFlow.cod" {
    InitializationOperation, InitializationOperations, InitializationIndices, InitializationTags, extract_initialization_flow,
};
using "./InitializationFlow.cod" InitializationAccess { NoAccess };
using "./InitializationFlow.cod" FlowFlagWrite { KeepFlags };
using "./InitializationControl.cod" {
    InitializationState, InitializationStates, InitializationFlag, InitializationFlags,
    InitializationControlResult, complete_initialization_control,
};
using "./InitializationReadiness.cod" {
    UnreadyFact, UnreadyFacts, InitializationResult, complete_initialization_readiness, check_initialization,
};

func initialization_storage_exhausted() -> u8 { return 14u8; }
func invalid_initialization_flow() -> u8 { return 15u8; }

func prove_initialization(code:const NativeCommands in C, plan:const NativePlan in P, result:InitializationResult in R)
    -> bool where {const owner C, const owner P, owner R} {
    val used <- plan.used;
    val extent <- if (used >= plan.labels) { used } else { plan.labels };
    val spare <- intrinsic (len)(code) - used;
    if (extent >= spare) {
        result.diagnostic <- initialization_storage_exhausted();
        return false
    };
    val capacity <- spare - extent;
    ref operations = make InitializationOperations(used, make InitializationOperation {
        activation <- no_node(); first <- no_node(); second <- no_node(); labels <- false;
        access <- NoAccess; tag <- 0u64; site <- no_node();
        writes <- KeepFlags; write_slot <- no_node(); write_input <- no_node();
        guard_slot <- no_node(); guard_expected <- no_node(); known_guard <- no_node()
    });
    ref labels = make InitializationIndices(plan.labels, no_node());
    ref entries = make InitializationIndices(used, no_node());
    ref resets = make InitializationTags(extent + 1u64, false);
    ref demanded = make InitializationTags(extent + 1u64, false);
    if (!extract_initialization_flow(code, plan, operations, labels, entries, resets, demanded)) return false;

    ref states = make InitializationStates(capacity, make InitializationState {
        operation <- no_node(); history <- no_node(); previous <- no_node();
        first <- no_node(); second <- no_node()
    });
    ref flags = make InitializationFlags(capacity, make InitializationFlag {
        previous <- no_node(); slot <- no_node(); value <- no_node()
    });
    ref operation_heads = make InitializationIndices(used, no_node());
    ref roots = make InitializationIndices(used, no_node());
    ref control = make InitializationControlResult { states <- 0u64; flags <- 0u64; exhausted <- false };
    if (!complete_initialization_control(operations, entries, states, flags, operation_heads, roots, control)) {
        if (control.exhausted) { (result.diagnostic <- initialization_storage_exhausted()):void };
        return false
    };

    ref facts = make UnreadyFacts(capacity, make UnreadyFact {
        state <- no_node(); tag <- 0u64; previous <- no_node()
    });
    ref heads = make InitializationIndices(control.states, no_node());
    ref count = make u64 { 0u64 };
    if (!complete_initialization_readiness(operations, demanded, states, roots, control.states, facts, heads, count)) {
        result.diagnostic <- initialization_storage_exhausted();
        return false
    };
    return check_initialization(operations, states, operation_heads, control.states, facts, heads, count, result)
}

func publish_commands(code:NativeCommands in C, plan:NativePlan in P) -> void
    where {owner C, owner P} {
    val next <- 0u64;
    for (at in 0u64 .. plan.used) {
        if (!local_binding_fact(code[at].opcode) && code[at].opcode != require_initialized_place()) {
            if (initialization_access(code[at].opcode)) { code[at].c <- 0u64; (code[at].d <- 0u64):void; } else {};
            if (code[at].opcode == write_flow_flag()) { (code[at].opcode <- word_constant()):void; } else {};
            if (code[at].opcode == branch_on_flow_flag()) { (code[at].opcode <- branch_equal()):void; };
            if (code[at].opcode == copy_completion()) {
                code[at].opcode <- copy_word();
                (code[at].c <- 0u64):void;
            };
            if (next != at) {
                code[next].opcode <- code[at].opcode;
                code[next].a <- code[at].a;
                code[next].b <- code[at].b;
                code[next].c <- code[at].c;
                (code[next].d <- code[at].d):void;
            } else {};
            (next <- next + 1u64):void;
        } else {};
    };
    plan.used <- next;
    return;
}

export func check_native_initialization(code:NativeCommands in C, plan:NativePlan in P,
                                        result:InitializationResult in R) -> bool
    where {owner C, owner P, owner R} {
    result.diagnostic <- invalid_initialization_flow();
    result.node <- no_node();
    if (plan.used > intrinsic (len)(code)) return false;
    if (plan.initialization_obligations && (!plan.initialization_notes || !prove_initialization(code, plan, result)))
        return false;
    if (plan.initialization_notes) { publish_commands(code, plan) };
    result.diagnostic <- 0u8;
    return true
}
