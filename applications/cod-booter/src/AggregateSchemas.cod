using "./ParserStorage.cod" {
    ExprNodes, no_node, DeclarationSites, inspect_declaration, FormalSites, inspect_formal, BindingSites, inspect_binding,
    SumArmSites, inspect_sum_arm, first_sequence_entry, SequenceEntry, inspect_sequence_entry,
    DeclarationSyntax { NominalRecord, NativeRecord, NominalSum },
    SequenceSyntax { FormalSequence, SumSequence },
    FormalSyntax { OrdinaryFormal }, BindingSyntax { TypedBinding },
    FormalMode { ValueFormal, ExplicitValueFormal, ReferenceFormal, PointerFormal },
};
using "./NameResolution.cod" {
    NameBindings, NameWork, record_type, ordinary_selection, native_scalar, builtin_string,
    has_exception_parent, lexical_builder_record,
};
using "./ModuleExports.cod" { SelectedExports, record_export, enum_export, sum_export };
using "./ModuleExportStorage.cod" {
    ModuleInterfaces, checked_aggregate_storage, enum_type, sum_type,
    AggregateStorage { UnprovedAggregate, CoDBitsAggregate, CLayoutBitsRecord, NonBitsAggregate },
};

export array AggregateFacts[UInt64]:AggregateStorage;

enum SchemaKind:UInt8 { NoSchema; ProductSchema; NativeSchema; SumSchema; }
data SchemaDeclaration { kind:SchemaKind; referent:bool; entries:UInt64; }
array SchemaDeclarations[UInt64]:SchemaDeclaration;

# Steps are indexed by their original declaration, arm or field site.
data SchemaStep =
    NoSchemaStep {} |
    InvalidSchemaStart {} |
    SchemaStart { arm:UInt64; field:UInt64; storage:AggregateStorage; native:bool; } |
    ArmSuccessor { arm:UInt64; field:UInt64; } |
    FieldInput {
        site:UInt64; next:UInt64; next_valid:bool; storage:AggregateStorage; dependency:UInt64;
    };
array SchemaSteps[UInt64]:SchemaStep;

enum SchemaProgress:UInt8 { Unvisited; Active; Complete; }
data SchemaCursor {
    progress:SchemaProgress; parent:UInt64; arm:UInt64; field:UInt64; storage:AggregateStorage; native:bool;
}
array SchemaCursors[UInt64]:SchemaCursor;

export data SchemaCheck { diagnostic:UInt8; node:UInt64; }

func reject_schema(check:SchemaCheck in R, at:UInt64, cycle:bool) -> bool where {owner R} {
    check.diagnostic <- if (cycle) { 18u8 } else { 17u8 };
    check.node <- at;
    return false;
}

func imported_storage(interfaces:const ModuleInterfaces in I, interface_used:UInt64,
                       selected:const SelectedExports in E, selection:UInt64) -> AggregateStorage
    where {const owner I, const owner E} {
    if (selection >= intrinsic (len)(selected)) return UnprovedAggregate;
    val kind <- selected[selection].kind;
    if (kind == enum_export()) return CoDBitsAggregate;
    val type_kind <- 0u8;
    if (kind == record_export()) { (type_kind <- record_type()):void; };
    if (kind == sum_export()) { (type_kind <- sum_type()):void; };
    if (type_kind == 0u8 || selected[selection].origin_module == 0u64) return UnprovedAggregate;
    return checked_aggregate_storage(interfaces, interface_used, selected[selection].origin_module,
                                     selected[selection].identity, type_kind);
}

export func array_element_storage(names:const NameBindings in B, selected:const SelectedExports in E,
                                   interfaces:const ModuleInterfaces in I, interface_used:UInt64,
                                   facts:const AggregateFacts in F, marker:UInt64)
    -> AggregateStorage where {const owner B, const owner E, const owner I, const owner F} {
    val kind <- names[marker].kind;
    val target <- names[marker].declaration;
    if (native_scalar(kind)) return CLayoutBitsRecord;
    if (kind == enum_type()) return CoDBitsAggregate;
    if (kind == ordinary_selection()) return imported_storage(interfaces, interface_used, selected, target);
    if ((kind == record_type() || kind == sum_type()) && target < intrinsic (len)(facts)) return facts[target];
    return UnprovedAggregate;
}

func combined_storage(outer:AggregateStorage, field:AggregateStorage) -> AggregateStorage {
    if (outer == NonBitsAggregate || field == NonBitsAggregate) return NonBitsAggregate;
    if (outer == CoDBitsAggregate || field == CoDBitsAggregate) return CoDBitsAggregate;
    return CLayoutBitsRecord;
}

func next_field(nodes:const ExprNodes in N, work:const NameWork in W, revision:UInt64, field:UInt64, tail:UInt64,
                result:UInt64 in R) -> bool where {const owner N, const owner W, owner R} {
    val following <- work[field].next;
    if (field > tail || (following == no_node()) != (field == tail)) return false;
    if (following != no_node()) {
        ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
        if (following <= field || following > tail ||
            inspect_sequence_entry(nodes, revision, tail + 1u64, following, entry) != FormalSequence ||
            entry.previous != field) return false;
    };
    result <- following;
    return true;
}

func collect_schema_declarations(nodes:const ExprNodes in N, names:const NameBindings in B,
    declarations:SchemaDeclarations in D, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, owner D} {
    ref sites = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    val shape <- NominalRecord;
    for (at in 0u64 .. used) {
        shape <- inspect_declaration(nodes, revision, used, at, sites);
        if (shape == NominalSum) {
            declarations[at] <- make SchemaDeclaration { kind <- (SumSchema:SchemaKind); referent <- true; entries <- sites.entries }
        } else {
            if ((shape == NominalRecord || shape == NativeRecord) &&
                !lexical_builder_record(nodes, names, at, revision, used)) {
                declarations[at] <- make SchemaDeclaration {
                    kind <- if (shape == NativeRecord) { (NativeSchema:SchemaKind) } else { (ProductSchema:SchemaKind) };
                    referent <- !has_exception_parent(nodes, names, at, revision, used);
                    entries <- sites.entries;
                }
            }
        }
    };
    return
}

data SchemaFieldReceipt {
    site:UInt64; next:UInt64; next_valid:bool; storage:AggregateStorage; dependency:UInt64;
}

func collect_field_input(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:UInt64,
    declarations:const SchemaDeclarations in D, field:UInt64, schema:UInt64, used:UInt64, revision:UInt64,
    receipt:SchemaFieldReceipt in R) -> void
    where {const owner N, const owner B, const owner E, const owner I, const owner D, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    receipt.site <- field;
    receipt.storage <- UnprovedAggregate;
    receipt.dependency <- no_node();
    if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
        inspect_binding(nodes, revision, field, formal.binding, binding) != TypedBinding) return;
    val at <- binding.target_type;
    receipt.site <- at;
    val kind <- names[at].kind;
    val target <- names[at].declaration;
    val reference <- formal.mode == ReferenceFormal || formal.mode == PointerFormal;
    if ((!reference && formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) || binding.owner_name != no_node())
        return;
    val storage <- UnprovedAggregate;
    if (native_scalar(kind)) { (storage <- CLayoutBitsRecord):void; };
    if (kind == builtin_string() && !reference && declarations[schema].referent)
        { (storage <- NonBitsAggregate):void; };
    if (kind == enum_type()) { (storage <- CoDBitsAggregate):void; };
    if (kind == ordinary_selection())
        { (storage <- imported_storage(interfaces, interface_used, selected, target)):void; };
    if ((kind == record_type() || kind == sum_type()) && target < used && declarations[target].referent) {
        val target_kind <- declarations[target].kind;
        if ((kind == sum_type() && target_kind == (SumSchema:SchemaKind)) ||
            (kind == record_type() && (target_kind == (ProductSchema:SchemaKind) || target_kind == (NativeSchema:SchemaKind)))) {
            if (!reference) { receipt.dependency <- target; return; };
            (storage <- NonBitsAggregate):void;
        }
    };
    if (storage != UnprovedAggregate && reference) { (storage <- NonBitsAggregate):void; };
    receipt.storage <- storage;
    return
}

func collect_fields(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:UInt64,
    declarations:const SchemaDeclarations in D, steps:SchemaSteps in T, schema:UInt64,
    first_field:UInt64, tail:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, const owner E, const owner I, const owner D, owner T} {
    ref receipt = make SchemaFieldReceipt {
        site <- no_node(); next <- no_node(); next_valid <- false; storage <- UnprovedAggregate; dependency <- no_node();
    };
    val field <- first_field;
    for (unused in 0u64 .. used) {
        if (field == no_node()) return;
        collect_field_input(nodes, names, selected, interfaces, interface_used,
            declarations, field, schema, used, revision, receipt);
        receipt.next <- no_node();
        receipt.next_valid <- next_field(nodes, work, revision, field, tail, receipt.next);
        steps[field] <- make FieldInput {
            site <- receipt.site; next <- receipt.next; next_valid <- receipt.next_valid;
            storage <- receipt.storage; dependency <- receipt.dependency;
        };
        if (!receipt.next_valid) return;
        field <- receipt.next;
    };
    return
}

func collect_schema_steps(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:UInt64,
    declarations:const SchemaDeclarations in D, steps:SchemaSteps in T, schema:UInt64, used:UInt64, revision:UInt64) -> void
    where {const owner N, const owner B, const owner W, const owner E, const owner I, const owner D, owner T} {
    val kind <- declarations[schema].kind;
    val entries <- declarations[schema].entries;
    ref first = make UInt64 { no_node() };
    ref arm = make UInt64 { no_node() };
    ref sites = make SumArmSites { name <- no_node(); previous <- no_node(); fields <- no_node() };
    if (kind == (SumSchema:SchemaKind)) {
        if (!first_sequence_entry(nodes, revision, schema, entries, SumSequence, arm) || arm == no_node() ||
            !inspect_sum_arm(nodes, revision, schema, arm, sites) ||
            !first_sequence_entry(nodes, revision, arm, sites.fields, FormalSequence, first)) {
            steps[schema] <- make InvalidSchemaStart {};
            return;
        }
    } else {
        if (!first_sequence_entry(nodes, revision, schema, entries, FormalSequence, first)) {
            steps[schema] <- make InvalidSchemaStart {};
            return;
        };
        (sites.fields <- entries):void;
    };
    steps[schema] <- make SchemaStart {
        arm <- arm; field <- first; native <- kind == (NativeSchema:SchemaKind);
        storage <- if (kind == (SumSchema:SchemaKind)) { CoDBitsAggregate } else { CLayoutBitsRecord };
    };
    val next <- no_node();
    for (unused in 0u64 .. used) {
        collect_fields(nodes, names, work, selected, interfaces, interface_used,
            declarations, steps, schema, first, sites.fields, used, revision);
        if (arm == no_node()) return;
        next <- work[arm].next;
        if (arm > entries || (next == no_node()) != (arm == entries)) return;
        if (next == no_node()) {
            steps[arm] <- make ArmSuccessor { arm <- no_node(); field <- no_node() };
            return;
        };
        if (next <= arm || next > entries || !inspect_sum_arm(nodes, revision, schema, next, sites) ||
            sites.previous != arm ||
            !first_sequence_entry(nodes, revision, next, sites.fields, FormalSequence, first)) return;
        steps[arm] <- make ArmSuccessor { arm <- next; field <- first };
        arm <- next;
    };
    return
}

func begin_schema(steps:const SchemaSteps in T, cursors:SchemaCursors in C, schema:UInt64, parent:UInt64)
    -> bool where {const owner T, owner C} {
    return case steps[schema] of {
        SchemaStart { val arm <-; val field <-; val storage <-; val native <-; } -> {
            cursors[schema] <- make SchemaCursor {
                progress <- (Active:SchemaProgress); parent <- parent; arm <- arm; field <- field; storage <- storage; native <- native;
            };
            true
        };
        _ -> false
    }
}

func advance_schema_field(steps:const SchemaSteps in T, cursors:SchemaCursors in C, facts:const AggregateFacts in F,
    schema:UInt64 in A, check:SchemaCheck in R) -> bool
    where {const owner T, owner C, const owner F, owner A, owner R} {
    val field <- cursors[schema].field;
    val resolved <- UnprovedAggregate;
    return case steps[field] of {
        FieldInput { val site <-; val next <-; val next_valid <-; val storage <-; val dependency <-; } -> {
            resolved <- storage;
            if (dependency != no_node()) {
                case cursors[dependency].progress of {
                    Active -> { return reject_schema(check, site, true); };
                    Complete -> { (resolved <- facts[dependency]):void; };
                    Unvisited -> {
                        if (!begin_schema(steps, cursors, dependency, schema)) return reject_schema(check, site, false);
                        schema <- dependency;
                        return true;
                    };
                }
            };
            if (resolved == UnprovedAggregate || (resolved != CLayoutBitsRecord && cursors[schema].native))
                return reject_schema(check, site, false);
            if (!next_valid) return reject_schema(check, field, false);
            cursors[schema].storage <- combined_storage(cursors[schema].storage, resolved);
            cursors[schema].field <- next;
            true
        };
        _ -> reject_schema(check, field, false)
    }
}

func advance_schema_arm(steps:const SchemaSteps in T, cursors:SchemaCursors in C, schema:UInt64) -> bool
    where {const owner T, owner C} {
    return case steps[cursors[schema].arm] of {
        ArmSuccessor { val arm <-; val field <-; } -> {
            cursors[schema].arm <- arm;
            cursors[schema].field <- field;
            true
        };
        _ -> false
    }
}

func complete_schema(steps:const SchemaSteps in T, cursors:SchemaCursors in C, facts:AggregateFacts in F,
    root:UInt64, used:UInt64, check:SchemaCheck in R) -> bool
    where {const owner T, owner C, owner F, owner R} {
    if (!begin_schema(steps, cursors, root, no_node())) return reject_schema(check, root, false);
    val schema <- root;
    for (step in 0u64 .. 3u64 * used + 1u64) {
        if (schema == no_node()) return true;
        if (cursors[schema].field == no_node()) {
            if (cursors[schema].arm != no_node() && !advance_schema_arm(steps, cursors, schema))
                return reject_schema(check, schema, false);
            if (cursors[schema].arm == no_node()) {
                facts[schema] <- cursors[schema].storage;
                cursors[schema].progress <- (Complete:SchemaProgress);
                (schema <- cursors[schema].parent):void;
            }
        } else {
            if (!advance_schema_field(steps, cursors, facts, schema, check)) return false;
        };
    };
    return reject_schema(check, root, false)
}

func complete_aggregate_schemas(steps:const SchemaSteps in T, facts:AggregateFacts in F, used:UInt64,
    check:SchemaCheck in R) -> bool where {const owner T, owner F, owner R} {
    ref cursors = make SchemaCursors(used, make SchemaCursor {
        progress <- (Unvisited:SchemaProgress); parent <- no_node(); arm <- no_node(); field <- no_node();
        storage <- UnprovedAggregate; native <- false;
    });
    for (root in 0u64 .. used) {
        if ((case steps[root] of { SchemaStart -> true; InvalidSchemaStart -> true; _ -> false }) &&
            cursors[root].progress != (Complete:SchemaProgress) &&
            !complete_schema(steps, cursors, facts, root, used, check)) return false;
    };
    return true
}

export func check_aggregate_schemas(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, interface_used:UInt64,
    facts:AggregateFacts in F, used:UInt64, revision:UInt64, check:SchemaCheck in R)
    -> bool where {const owner N, const owner B, const owner W, const owner E, const owner I, owner F, owner R} {
    if (used > intrinsic (len)(facts) || used > intrinsic (len)(nodes) || used > 6148914691236517204u64)
        return reject_schema(check, no_node(), false);
    ref steps = make SchemaSteps(used, make NoSchemaStep {});
    {
        ref declarations = make SchemaDeclarations(used, make SchemaDeclaration {
            kind <- (NoSchema:SchemaKind); referent <- false; entries <- no_node();
        });
        collect_schema_declarations(nodes, names, declarations, used, revision);
        for (schema in 0u64 .. used) {
            if (declarations[schema].kind != (NoSchema:SchemaKind)) {
                collect_schema_steps(nodes, names, work, selected, interfaces, interface_used, declarations,
                    steps, schema, used, revision)
            }
        }
    };
    return complete_aggregate_schemas(steps, facts, used, check)
}
