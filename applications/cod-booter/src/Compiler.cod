using "SourceStorage.cod" SourceBytes;
using "SourceStorage.cod" Token;
using "SourceStorage.cod" len;
using "Lexer.cod" scan_token;
using "Lexer.cod" end_of_source;
using "Lexer.cod" unsupported_byte;
using "ParserStorage.cod" Tokens;
using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" name_node;
using "ParserStorage.cod" call_node;
using "ParserStorage.cod" deferred_call_node;
using "ParserStorage.cod" no_node;
using "Frontend.cod" FrontendResult;
using "Frontend.cod" read_expression;
using "Lowering.cod" lower_expression;

data ExpressionScratchPlan {
    token_count:u64;
    node_capacity:u64;
    diagnostic:u8;
    diagnostic_first:u64;
    diagnostic_past:u64;
}

data NativeExpressionResult {
    frontend:FrontendResult;
    rejected_node:u64;
    rejected_at:u64;
    backend_status:u8;
}

func native_complete() -> u8 { return 0u8; }
func native_source_rejected() -> u8 { return 1u8; }
func native_form_unsupported() -> u8 { return 2u8; }
func native_open_failed() -> u8 { return 3u8; }
func native_lowering_failed() -> u8 { return 4u8; }
func native_finish_failed() -> u8 { return 5u8; }
func native_scratch_failed() -> u8 { return 6u8; }

func count_tokens(source:const SourceBytes in S, ref token:Token in T) -> u64
    where {const owner S, owner T} {
    val next <- 0u64;
    val bytes <- len(source);
    # Each non-EOF token advances by at least one byte.
    for (index in 0u64 .. bytes) {
        scan_token(source, next, token);
        if (token.kind == end_of_source() || token.kind >= unsupported_byte()) { return index; } else {};
        (next <- token.past):void;
    };
    return bytes;
}

# Plan buffers before acquiring scratch storage. Each node is introduced by
# one distinct non-EOF token. A call uses its closing parenthesis and its
# argument entries use the opening parenthesis and comma separators.
func plan_expression_scratch(source:const SourceBytes in S, ref scratch:ExpressionScratchPlan in R) -> bool
    where {const owner S, owner R} {
    scratch.token_count <- 0u64;
    scratch.node_capacity <- 0u64;
    scratch.diagnostic <- 0u8;
    scratch.diagnostic_first <- 0u64;
    scratch.diagnostic_past <- 0u64;
    ref token = make Token { kind <- end_of_source(); first <- 0u64; past <- 0u64; };
    val count <- count_tokens(source, token);
    if (token.kind >= unsupported_byte()) {
        scratch.diagnostic <- token.kind;
        scratch.diagnostic_first <- token.first;
        scratch.diagnostic_past <- token.past;
        return false;
    } else {};
    scratch.token_count <- count + 1u64;
    scratch.node_capacity <- count;
    return true;
}

func prepare_native_expression(source:const SourceBytes in S, ref tokens:Tokens in T,
                               ref nodes:ExprNodes in N, ref result:FrontendResult in R) -> u8
    where {const owner S, owner T, owner N, owner R} {
    if (!read_expression(source, tokens, nodes, result)) { return native_source_rejected(); } else {};
    # Source order identifies the enclosing unavailable form even though the
    # parser stores its children first.
    val supported <- true;
    for (at in 0u64 .. result.tree.used) {
        if ((nodes[at].kind == name_node() || nodes[at].kind == call_node() ||
             nodes[at].kind == deferred_call_node()) &&
            (supported || nodes[at].first < result.diagnostic_first)) {
            result.diagnostic_first <- nodes[at].first;
            result.diagnostic_past <- nodes[at].past;
            (supported <- false):void;
        } else {};
    };
    if (!supported) { return native_form_unsupported(); } else {};
    return native_complete();
}

# The caller keeps the source and scratch buffers live. A syntax error or
# unsupported expression leaves its span in result before any backend call.
proc compile_expression(here emit(ordinal:u64, kind:u8, number:u64, left:u64, right:u64,
                                 operation_at:u64) -> bool,
                        source:const SourceBytes in S, ref tokens:Tokens in T,
                        ref nodes:ExprNodes in N, ref result:FrontendResult in R) -> bool
    where {const owner S, owner T, owner N, owner R} {
    if (prepare_native_expression(source, tokens, nodes, result) != native_complete()) { return false; } else {};
    val rejected_node <- no_node();
    return lower_expression(emit, nodes, result.tree, rejected_node);
}

# The backend callbacks share one native session. Release also accepts a
# partially opened session. Finish returns zero on success and a backend
# diagnostic code on failure. Interpret the report after a normal completion.
proc compile_native_expression(here begin() -> bool,
                               here emit(ordinal:u64, kind:u8, number:u64, left:u64, right:u64,
                                         operation_at:u64) -> bool,
                               here finish() -> u8,
                               here release() -> void,
                               source:const SourceBytes in S, ref tokens:Tokens in T,
                               ref nodes:ExprNodes in N, ref result:NativeExpressionResult in R) -> u8
    where {const owner S, owner T, owner N, owner R} {
    result.rejected_node <- no_node();
    result.rejected_at <- no_node();
    result.backend_status <- 0u8;
    val preparation <- prepare_native_expression(source, tokens, nodes, result.frontend);
    if (preparation != native_complete()) { return preparation; } else {};
    defer { release(); };
    if (!begin()) { return native_open_failed(); } else {};
    if (!lower_expression(emit, nodes, result.frontend.tree, result.rejected_node)) {
        if (result.rejected_node != no_node()) {
            (result.rejected_at <- nodes[result.rejected_node].operation_at):void;
        } else {};
        return native_lowering_failed();
    } else {};
    result.backend_status <- finish();
    if (result.backend_status != 0u8) { return native_finish_failed(); } else {};
    return native_complete();
}

# The callbacks share one scratch allocation. Work keeps its buffer borrows
# within the call and supplies the pipeline status. Release accepts an empty
# allocation if acquisition fails.
proc compile_with_scratch(here work(token_count:u64, node_capacity:u64) -> u8,
                          here release() -> void,
                          source:const SourceBytes in S, ref plan:ExpressionScratchPlan in P) -> u8
    where {const owner S, owner P} {
    if (!plan_expression_scratch(source, plan)) { return native_source_rejected(); } else {};
    defer { release(); };
    return work(plan.token_count, plan.node_capacity);
}

export ExpressionScratchPlan;
export NativeExpressionResult;
export native_complete;
export native_source_rejected;
export native_form_unsupported;
export native_open_failed;
export native_lowering_failed;
export native_finish_failed;
export native_scratch_failed;
export plan_expression_scratch;
export compile_expression;
export compile_native_expression;
export compile_with_scratch;
