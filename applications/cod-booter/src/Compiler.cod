using "./SourceStorage.cod" SourceBytes;
using "./ModuleWorkspace.cod" { ExpressionScratchPlan, plan_expression_scratch };
using "./ParserStorage.cod" { Tokens, ExprNodes, no_node, syntax_first, syntax_past };
using "./Frontend.cod" { FrontendResult, read_expression };
using "./Lowering.cod" { lower_expression, ArithmeticOperands, arithmetic_operands };
using "./CompilerStatus.cod" CompilerStatus {
    Complete, Rejected, FormUnsupported, OpenFailed, LoweringFailed, FinishFailed, ScratchFailed
};

export from "./CompilerStatus.cod" CompilerStatus;
export from "./ModuleWorkspace.cod" ExpressionScratchPlan;
export from "./ModuleWorkspace.cod" plan_expression_scratch;

export data NativeExpressionResult {
    frontend:FrontendResult,
    rejected_node:UInt64,
    rejected_at:UInt64,
    backend_status:UInt8,
}

func prepare_native_expression(source:const SourceBytes in S, tokens:Tokens in T,
                               nodes:ExprNodes in N, result:FrontendResult in R) -> CompilerStatus
    where {const owner S, owner T, owner N, owner R} {
    if (!read_expression(source, tokens, nodes, result)) return Rejected;
    # Source order identifies the enclosing unavailable form even though the
    # parser stores its children first.
    val supported <- true;
    ref operation = make ArithmeticOperands {
        opcode <- 0u8; immediate <- 0u64; left_slot <- 0u64; right_slot <- 0u64; source_at <- 0u64;
    };
    for (at in 0u64 .. result.tree.used) {
        if (!arithmetic_operands(nodes, result.tree.revision, result.tree.used, at, operation) &&
            (supported || syntax_first(nodes, result.tree.used, at) < result.diagnostic_first)) {
            result.diagnostic_first <- syntax_first(nodes, result.tree.used, at);
            result.diagnostic_past <- syntax_past(nodes, result.tree.used, at);
            (supported <- false):void;
        } else {};
    };
    if (!supported) return FormUnsupported;
    return Complete;
}

# The caller keeps the source and scratch buffers live. A syntax error or
# unsupported expression leaves its span in result before any backend call.
export proc compile_expression(here emit(ordinal:UInt64, kind:UInt8, number:UInt64, left:UInt64, right:UInt64,
                                        operation_at:UInt64) -> bool,
                               source:const SourceBytes in S, tokens:Tokens in T,
                               nodes:ExprNodes in N, result:FrontendResult in R) -> bool
    where {const owner S, owner T, owner N, owner R} {
    if (prepare_native_expression(source, tokens, nodes, result) != Complete) return false;
    val rejected_node <- no_node();
    return lower_expression(emit, nodes, result.tree, rejected_node);
}

# The backend callbacks share one native session. Release also accepts a
# partially opened session. Finish returns zero on success and a backend
# diagnostic code on failure. Interpret the report after a normal completion.
export proc compile_native_expression(here begin() -> bool,
                                      here emit(ordinal:UInt64, kind:UInt8, number:UInt64, left:UInt64, right:UInt64,
                                                operation_at:UInt64) -> bool,
                                      here finish() -> UInt8,
                                      here release() -> void,
                                      source:const SourceBytes in S, tokens:Tokens in T,
                                      nodes:ExprNodes in N, result:NativeExpressionResult in R) -> CompilerStatus
    where {const owner S, owner T, owner N, owner R} {
    result.rejected_node <- no_node();
    result.rejected_at <- no_node();
    result.backend_status <- 0u8;
    val preparation <- prepare_native_expression(source, tokens, nodes, result.frontend);
    if (preparation != Complete) return preparation;
    defer { release(); };
    if (!begin()) return OpenFailed;
    if (!lower_expression(emit, nodes, result.frontend.tree, result.rejected_node)) {
        if (result.rejected_node != no_node()) {
            ref operation = make ArithmeticOperands {
                opcode <- 0u8; immediate <- 0u64; left_slot <- 0u64; right_slot <- 0u64; source_at <- 0u64;
            };
            if (arithmetic_operands(nodes, result.frontend.tree.revision, result.frontend.tree.used,
                                    result.rejected_node, operation)) {
                (result.rejected_at <- operation.source_at):void;
            };
        } else {};
        return LoweringFailed;
    } else {};
    result.backend_status <- finish();
    if (result.backend_status != 0u8) return FinishFailed;
    return Complete;
}

# The callbacks share one scratch allocation. Work keeps its buffer borrows
# within the call and supplies the pipeline status. Release accepts an empty
# allocation if acquisition fails.
export proc compile_with_scratch(here work(token_count:UInt64, node_capacity:UInt64) -> CompilerStatus,
                                 here release() -> void,
                                 source:const SourceBytes in S, plan:ExpressionScratchPlan in P) -> CompilerStatus
    where {const owner S, owner P} {
    if (!plan_expression_scratch(source, plan)) return ScratchFailed;
    defer { release(); };
    return work(plan.token_count, plan.syntax_capacity);
}
