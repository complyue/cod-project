using "std:exceptions" Exception;
using "./CompilerStatus.cod" CompilerStatus;
using "./SourceStorage.cod" SourceBytes;

export handle type PathOwner;
export handle type Path in PathOwner;
export handle type SourceRevision;
export data PathStorageException <: Exception { os_error:u64; }
export data PathNotReadyException <: Exception { status:u64; }
export data SourceOpenException <: Exception { os_error:u64; }

func "C" PathOwner() throws PathStorageException;
proc "C" Path() throws PathNotReadyException;
proc "C" SourceRevision(handle path:Path in A) throws SourceOpenException
    where {const owner A};

export proc "C" prepare_root(handle destination:PathOwner in D, handle input:Path in A)
    -> u64 where {owner D, const owner A};
export func "C" prepare_child(handle destination:PathOwner in D, handle parent:Path in P,
                             decoded:const SourceBytes in B, used:u64)
    -> u64 where {owner D, const owner P, const owner B};
func "C" path_ready(handle prepared:PathOwner in P) -> bool where {const owner P};
func "C" path_key_loan(here work(ref bytes:const SourceBytes in P) -> CompilerStatus,
                      handle prepared:PathOwner in P) -> CompilerStatus where {const owner P};

export proc path_key(here work(bytes:const SourceBytes in P) -> CompilerStatus,
                     handle prepared:PathOwner in P) -> CompilerStatus
    throws PathNotReadyException where {const owner P} {
    if (!path_ready(prepared)) {
        throw PathNotReadyException { status <- 1u64; };
    };
    return path_key_loan(prepared) (bytes) => { continue work(bytes); };
}
