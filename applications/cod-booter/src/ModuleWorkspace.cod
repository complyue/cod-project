using "./SourceStorage.cod" { SourceBytes, Token };
using "./SourceStorage.cod" DelimiterLink { OrdinaryToken };
using "./SourceAccess.cod" len;
using "./Lexer.cod" { scan_token, end_of_source };
using "./ParserStorage.cod" no_node;
using "./CompilerStatus.cod" CompilerStatus { Complete, ScratchFailed };

export data ExpressionScratchPlan {
    token_count:UInt64,
    node_capacity:UInt64,
    syntax_capacity:UInt64,
}

export data ModuleWorkspacePlan {
    source:ExpressionScratchPlan,
    commands:UInt64,
}

func count_tokens(source:const SourceBytes in S, token:Token in T) -> UInt64
    where {const owner S, owner T} {
    val next <- 0u64;
    val bytes <- len(source);
    # Each non-EOF token advances by at least one byte.
    for (index in 0u64 .. bytes) {
        scan_token(source, next, token);
        if (token.kind == end_of_source()) return index;
        next <- token.past;
    };
    return bytes;
}

# Plan buffers before acquiring scratch storage. Each node is introduced by
# one distinct non-EOF token. List entries use delimiter tokens, leaving the
# expression and control keywords available for their own nodes.
export func plan_expression_scratch(source:const SourceBytes in S, scratch:ExpressionScratchPlan in R) -> bool
    where {const owner S, owner R} {
    scratch.token_count <- 0u64;
    scratch.node_capacity <- 0u64;
    scratch.syntax_capacity <- 0u64;
    ref token = make Token { kind <- end_of_source(); first <- 0u64; past <- 0u64; delimiter <- make OrdinaryToken {}; };
    val count <- count_tokens(source, token);
    if (count > (no_node() - 1u64) / 3u64) return false;
    scratch.token_count <- count + 1u64;
    scratch.node_capacity <- count;
    scratch.syntax_capacity <- 3u64 * count;
    return true;
}

# A normalized grouped selection may need one extra node per item. Each
# such item accounts for a name and a delimiter, so half the token count
# bounds the additional nodes, including a group with no trailing comma.
export func plan_module_source(source:const SourceBytes in S, plan:ExpressionScratchPlan in P) -> bool
    where {const owner S, owner P} {
    if (!plan_expression_scratch(source, plan)) return false;
    val extra <- plan.token_count / 2u64;
    if (plan.token_count > no_node() - extra) return false;
    if (plan.syntax_capacity > no_node() - 1u64 - extra) return false;
    plan.node_capacity <- plan.token_count + extra;
    plan.syntax_capacity <- plan.syntax_capacity + 1u64 + extra;
    return true;
}

# Lowering emits each guard dispatch and callable prologue once and each
# deferred call's preparation and invocation once.
export func plan_module_workspace(source:const SourceBytes in S, workspace:ModuleWorkspacePlan in W) -> CompilerStatus
    where {const owner S, owner W} {
    workspace.commands <- 0u64;
    if (!plan_module_source(source, workspace.source)) return ScratchFailed;
    val commands_per_node <- 32u64;
    if (workspace.source.node_capacity > 18446744073709551615u64 / commands_per_node)
        return ScratchFailed;
    workspace.commands <- workspace.source.node_capacity * commands_per_node;
    return Complete;
}
