using "./ParserStorage.cod" {
    ResourceNature, ResourceNature { OrdinaryResource, VariableResource, ProcedureResource },
};
using "./SourceStorage.cod" SourceBytes;
using "./SourceAccess.cod" same_bytes;
using "./ParserStorage.cod" {
    ExprNodes, len as syntax_len, no_node, selected_resource_name,
    ModuleSelectionSites, inspect_module_selection, BulkSelectionSites, inspect_bulk_selection,
    first_module_item, syntax_first, syntax_past,
    NameSyntax, name_syntax, SequenceEntry, inspect_sequence_entry, inspect_member_selector, case_pattern,
};
using "./ParserStorage.cod" CasePatternSyntax { NamedCaseMember };
using "./ParserStorage.cod" NameSyntax { NotAName, SymbolicName };
using "./ParserStorage.cod" SequenceSyntax { MemberSequence };
using "./ParserStorage.cod" MemberSelectionSyntax { InvalidMemberSelector, AllSelectedMembers };
using "./ParserStorage.cod" SelectionSyntax { SelectionReady, InvalidSelection };
using "./ParserStorage.cod" ModuleSelectionMode {
    UseResource, ImportResource, ReexportResource, MixinResource, IdentityResource
};
using "./ParserInput.cod" ParseResult;
using "./ModuleExportStorage.cod" {
    ExceptionSchema { CheckedExceptionSchema, UncheckedExceptionSchema },
    ModuleExport, ModuleExports, ModuleInterfaces, DefaultExportRefs, find_interface,
    enum_type, sum_type, checked_sum_constructor, checked_aggregate_storage,
    AggregateStorage { CLayoutBitsRecord, CoDBitsAggregate, NonBitsAggregate },
};
using "./ModuleIndex.cod" { Visits, ModuleSelectionRanges, checked_module_selections };
using "./ParserStorage.cod" { SourceSpan, PublicView, PublicView { DefaultPublic } };

export data SelectionSpelling =
    SourceSpelling { span:SourceSpan; } |
    CatalogSpelling { span:SourceSpan; } |
    GraphSpelling { span:SourceSpan; };

export array StagedExportNames[u64]:SelectionSpelling;
export array StagedExportUses[u64]:u64;

export data CheckedSelection =
    UnpublishedSelection {} |
    SelectedResource {
        revision:u64;
        site:u64;
        mode:ModuleSelectionMode;
        nature:ResourceNature;
        members:u64;
        default_member_first:u64;
        default_member_past:u64;
        local:SelectionSpelling;
        published:SelectionSpelling;
        public_row:u64;
        export_kind:u8;
        checked:u8;
        publishing_module:u64;
        defining_module:u64;
        identity:u64;
        owner_module:u64;
        owner_identity:u64;
        shape:u8;
    };
export array CheckedSelections[u64]:CheckedSelection;
export enum SelectionComparison:u8 {
    DistinctSpelling;
    RepeatedSelection;
    ConflictingSelection;
    UnprovedSelection;
}

func bounded_selection_spelling(
    spelling:const SelectionSpelling in L, source_size:u64, catalog_size:u64, graph_used:u64)
    -> bool where {const owner L} {
    return case spelling of {
        SourceSpelling { val range <- span; } -> range.first < range.past && range.past <= source_size;
        CatalogSpelling { val range <- span; } -> range.first < range.past && range.past <= catalog_size;
        GraphSpelling { val range <- span; } -> range.first < range.past && range.past <= graph_used
    }
}

export func selected_spelling_matches(
    spelling:const SelectionSpelling in L, source:const SourceBytes in S,
    catalog:const SourceBytes in B, graph:const SourceBytes in G, graph_used:u64,
    name:const SourceBytes in M, first:u64, past:u64)
    -> bool where {const owner L, const owner S, const owner B, const owner G, const owner M} {
    if (first >= past || past > intrinsic (len)(name) || graph_used > intrinsic (len)(graph))
        return false;
    return case spelling of {
        (SourceSpelling { val range <- span; }) -> {
            range.first < range.past && range.past <= intrinsic (len)(source) &&
                same_bytes(source, range.first, range.past, name, first, past)
        };
        (CatalogSpelling { val range <- span; }) -> {
            range.first < range.past && range.past <= intrinsic (len)(catalog) &&
                same_bytes(catalog, range.first, range.past, name, first, past)
        };
        (GraphSpelling { val range <- span; }) -> {
            range.first < range.past && range.past <= graph_used &&
                same_bytes(graph, range.first, range.past, name, first, past)
        };
    }
}

export func selected_name_matches(
    selections:const CheckedSelections in F, used:u64, index:u64, revision:u64,
    source:const SourceBytes in S, catalog:const SourceBytes in B, graph:const SourceBytes in G,
    graph_used:u64, first:u64, past:u64)
    -> bool where {const owner F, const owner S, const owner B, const owner G} {
    if (index >= used || used > intrinsic (len)(selections)) return false;
    return case selections[index] of {
        (SelectedResource { val origin <- revision; val spelling <- local; val verb <- mode; }) -> {
            origin == revision && verb != ReexportResource &&
                selected_spelling_matches(spelling, source, catalog, graph, graph_used,
                                          source, first, past)
        };
        UnpublishedSelection -> false
    }
}

export func find_selected_name(
    selections:const CheckedSelections in F, used:u64, revision:u64,
    source:const SourceBytes in S, catalog:const SourceBytes in B, graph:const SourceBytes in G,
    graph_used:u64, first:u64, past:u64)
    -> u64 where {const owner F, const owner S, const owner B, const owner G} {
    if (used > intrinsic (len)(selections)) return no_node();
    for (index in 0u64 .. used) {
        if (selected_name_matches(selections, used, index, revision, source,
            catalog, graph, graph_used, first, past)) return index
    };
    return no_node()
}

export func same_selection_spelling(
    left:const SelectionSpelling in L, right:const SelectionSpelling in R,
    source:const SourceBytes in S, catalog:const SourceBytes in B,
    graph:const SourceBytes in G, graph_used:u64)
    -> bool where {const owner L, const owner R, const owner S, const owner B, const owner G} {
    return case left of {
        (SourceSpelling { val range <- span; }) -> {
            selected_spelling_matches(right, source, catalog, graph, graph_used,
                                      source, range.first, range.past)
        };
        (CatalogSpelling { val range <- span; }) -> {
            selected_spelling_matches(right, source, catalog, graph, graph_used,
                                      catalog, range.first, range.past)
        };
        (GraphSpelling { val range <- span; }) -> {
            range.past <= graph_used &&
                selected_spelling_matches(right, source, catalog, graph, graph_used,
                                          graph, range.first, range.past)
        };
    }
}

export func compare_selected_bindings(
    selections:const CheckedSelections in F, used:u64, revision:u64, before:u64, after:u64,
    source:const SourceBytes in S, catalog:const SourceBytes in B,
    graph:const SourceBytes in G, graph_used:u64)
    -> SelectionComparison where {const owner F, const owner S, const owner B, const owner G} {
    if (before >= used || after >= used || used > intrinsic (len)(selections) ||
        graph_used > intrinsic (len)(graph))
        return UnprovedSelection:SelectionComparison;
    return case selections[before] of {
        (SelectedResource {
            val old_revision <- revision; val old_name <- local; val old_kind <- export_kind;
            val old_mode <- mode; val old_context <- publishing_module;
            val old_origin <- defining_module; val old_identity <- identity;
        }) -> {
            case selections[after] of {
                (SelectedResource {
                    val new_revision <- revision; val new_name <- local; val new_kind <- export_kind;
                    val new_mode <- mode; val new_context <- publishing_module;
                    val new_origin <- defining_module; val new_identity <- identity;
                }) -> {
                    if (old_revision != revision || new_revision != revision ||
                        !bounded_selection_spelling(old_name, intrinsic (len)(source),
                            intrinsic (len)(catalog), graph_used) ||
                        !bounded_selection_spelling(new_name, intrinsic (len)(source),
                            intrinsic (len)(catalog), graph_used))
                        return UnprovedSelection:SelectionComparison;
                    if (old_mode == ReexportResource || new_mode == ReexportResource ||
                        !same_selection_spelling(old_name, new_name, source, catalog, graph, graph_used))
                        return DistinctSpelling:SelectionComparison;
                    if (old_kind != new_kind || old_origin != new_origin ||
                        old_identity != new_identity ||
                        (old_kind == callable_export() &&
                         (old_mode != new_mode || old_context != new_context)))
                        return ConflictingSelection:SelectionComparison;
                    RepeatedSelection:SelectionComparison
                };
                UnpublishedSelection -> UnprovedSelection:SelectionComparison
            }
        };
        UnpublishedSelection -> UnprovedSelection:SelectionComparison
    }
}

func validate_checked_selections(
    selections:const CheckedSelections in F, used:u64, tree:const ParseResult in T,
    source:const SourceBytes in S, catalog:const SourceBytes in B, graph:const SourceBytes in G,
    graph_used:u64, report:ExportResolutionResult in R)
    -> bool where {const owner F, const owner T, const owner S, const owner B, const owner G, owner R} {
    if (used > intrinsic (len)(selections) || graph_used > intrinsic (len)(graph)) return false;
    val source_size <- intrinsic (len)(source);
    val catalog_size <- intrinsic (len)(catalog);
    val comparison <- DistinctSpelling:SelectionComparison;
    for (after in 0u64 .. used) {
        report.node <- case selections[after] of {
            (SelectedResource { val revision <- revision; val site <- site;
                val local <- local; val published <- published; }) -> {
                if (revision == tree.revision &&
                    bounded_selection_spelling(local, source_size, catalog_size, graph_used) &&
                    bounded_selection_spelling(published, source_size, catalog_size, graph_used)) { (site) }
                else { no_node() }
            };
            UnpublishedSelection -> no_node()
        };
        if (report.node >= tree.used) {
            report.diagnostic <- invalid_export_tree();
            return false
        };
        for (before in 0u64 .. after) {
            comparison <- compare_selected_bindings(selections, used, tree.revision, before, after,
                source, catalog, graph, graph_used);
            if (comparison == (ConflictingSelection:SelectionComparison) ||
                comparison == (UnprovedSelection:SelectionComparison)) {
                report.diagnostic <- unproved_module_exports();
                return false
            }
        }
    };
    return true
}

export data SelectedExport {
    # Input from dependency discovery. Zero selects the builtin namespace.
    dependency_module:u64;
    checked_resource:u64;
    selection_site:u64;
    selection_public_row:u64;
    identity:u64;
    kind:u8;
    checked:u8;
    origin_module:u64;
    owner_module:u64;
    owner_identity:u64;
    shape:u8;
    enum_head:u64;
    enum_code:u64;
    sum_head:u64;
    next_sum_selection:u64;
    constructor_selection:u64;
    constructor_row:u64;
}
export array SelectedExports[u64]:SelectedExport;

export data ExportResolutionResult {
    diagnostic:u8;
    node:u64;
}

export func exception_type_export() -> u8 { return 1u8; }
export func symbol_export() -> u8 { return 2u8; }
export func builder_storage_export() -> u8 { return 11u8; }
export func lexical_result_export() -> u8 { return 14u8; }
export func text_size_export() -> u8 { return 15u8; }
export func text_byte_export() -> u8 { return 16u8; }

# The canonical catalog occupies the lower half, including builtin meanings
# carried by a re-export. The remaining meanings belong only to source rows.
func first_source_export_kind() -> u8 { return 128u8; }
func valid_builtin_catalog(exports:const ModuleExports in B) -> bool where {const owner B} {
    for (at in 0u64 .. intrinsic (len)(exports)) {
        if (exports[at].kind == 0u8 || exports[at].kind >= first_source_export_kind())
            return false
    };
    return true
}
export func sum_export() -> u8 { return first_source_export_kind(); }
export func native_handle_export() -> u8 { return 129u8; }
export func record_export() -> u8 { return 130u8; }
export func array_export() -> u8 { return 131u8; }
export func nominal_exception_export() -> u8 { return 132u8; }
export func callable_export() -> u8 { return 133u8; }
export func enum_export() -> u8 { return 134u8; }
export func enum_member_export() -> u8 { return 135u8; }
export func abstract_type_export() -> u8 { return 136u8; }
export func lexical_builder_export() -> u8 { return 137u8; }
export func scalar_type_export() -> u8 { return 138u8; }
export func ordinary_callable_shape() -> u8 { return 1u8; }
export func numeric_record_shape() -> u8 { return 2u8; }

export func aggregate_export_shape(storage:AggregateStorage, numeric:bool) -> u8 {
    if (storage == CLayoutBitsRecord) return if (numeric) { numeric_record_shape() } else { 1u8 };
    if (storage == NonBitsAggregate) return 3u8;
    if (storage == CoDBitsAggregate) return 4u8;
    return 0u8;
}

export func print_export_identity() -> u64 { return 0u64; }

func export_nature(exports:const ModuleExports in E, row:u64, nature:ResourceNature in R)
    -> bool where {const owner E, owner R} {
    if (row >= intrinsic (len)(exports) || exports[row].kind == 0u8) return false;
    if (exports[row].kind != symbol_export()) {
        nature <- OrdinaryResource;
        return true
    };
    if (exports[row].origin_module == 0u64 && exports[row].identity == print_export_identity()) {
        nature <- ProcedureResource;
        return true
    };
    val shape <- exports[row].shape;
    if (shape != 1u8 && (shape < 3u8 || shape > 6u8)) return false;
    nature <- VariableResource;
    return true
}

export func matches_export_nature(exports:const ModuleExports in E, row:u64,
                                  nature:ResourceNature) -> bool where {const owner E} {
    ref actual = make ResourceNature { OrdinaryResource };
    return export_nature(exports, row, actual) && actual == nature
}

export func exception_root_identity() -> u64 { return 0u64; }
export func error_root_identity() -> u64 { return 11u64; }
export func null_pointer_identity() -> u64 { return 4u64; }
export func out_of_memory_identity() -> u64 { return 1u64; }
export func missing_return_identity() -> u64 { return 5u64; }
export func index_out_of_bounds_identity() -> u64 { return 8u64; }
export func unexpected_case_identity() -> u64 { return 9u64; }
export func type_assertion_failed_identity() -> u64 { return 10u64; }
export func assertion_failed_identity() -> u64 { return 13u64; }

export func unproved_module_exports() -> u8 { return 1u8; }
export func missing_module_export() -> u8 { return 2u8; }
export func wrong_export_kind() -> u8 { return 3u8; }
export func export_storage_exhausted() -> u8 { return 4u8; }
export func invalid_export_tree() -> u8 { return 5u8; }
export func unproved_import_interpretation() -> u8 { return 12u8; }
func invalid_member_selection() -> u8 { return 13u8; }
export func missing_enum_member() -> u8 { return 14u8; }
func conflicting_enum_members() -> u8 { return 15u8; }
func missing_sum_constructor() -> u8 { return 17u8; }
func conflicting_sum_constructors() -> u8 { return 18u8; }

func selection_profile(mode:ModuleSelectionMode, kind:u8, shape:u8, members:u64,
                       declarations_only:bool) -> u8 {
    if (mode == MixinResource) return unproved_import_interpretation();
    if (mode == IdentityResource && kind != symbol_export()) return wrong_export_kind();
    if (mode == ImportResource && kind != scalar_type_export() && kind != enum_export() && kind != sum_export() &&
        kind != nominal_exception_export() &&
        !(declarations_only && kind == callable_export() && shape == ordinary_callable_shape()))
        return unproved_import_interpretation();
    if (members != no_node() && kind != enum_export() && kind != sum_export())
        return invalid_member_selection();
    return 0u8
}

func valid_graph_public_row(
    exports:const ModuleExports in G, first:u64, past:u64, row:u64, module:u64, spelling_used:u64)
    -> bool where {const owner G} {
    return row >= first && row < past && row < intrinsic (len)(exports) &&
        exports[row].publishing_module == module && exports[row].kind != 0u8 &&
        exports[row].name_first < exports[row].name_past && exports[row].name_past <= spelling_used
}

func selected_bulk_row(defaults:const DefaultExportRefs in G, view:PublicView, at:u64)
    -> u64 where {const owner G} {
    if (view == DefaultPublic) return defaults[at].public_row;
    return at
}

export func measure_bulk_selection(
    exports:const ModuleExports in G, defaults:const DefaultExportRefs in G,
    ranges:const ModuleSelectionRanges in R, view:PublicView, module:u64, spelling_used:u64,
    count:u64 in C) -> u8 where {const owner G, const owner R, owner C} {
    if (module == 0u64 || ranges.exports_first > ranges.exports_past ||
        ranges.exports_past > intrinsic (len)(exports) ||
        ranges.defaults_first > ranges.defaults_past ||
        ranges.defaults_past > intrinsic (len)(defaults)) return unproved_module_exports();
    if (view == DefaultPublic && ranges.defaults_first == ranges.defaults_past)
        return missing_module_export();
    val first <- if (view == DefaultPublic) { (ranges.defaults_first) } else { (ranges.exports_first) };
    val past <- if (view == DefaultPublic) { (ranges.defaults_past) } else { (ranges.exports_past) };
    if (past - first >= no_node() - count) return export_storage_exhausted();
    ref nature = make ResourceNature { OrdinaryResource };
    val row <- no_node();
    for (at in first .. past) {
        row <- selected_bulk_row(defaults, view, at);
        if (!valid_graph_public_row(exports, ranges.exports_first, ranges.exports_past,
                                    row, module, spelling_used)) return unproved_module_exports();
        if (!export_nature(exports, row, nature)) return wrong_export_kind();
        if (view == DefaultPublic && defaults[at].nature != nature) return wrong_export_kind()
    };
    count <- count + (past - first);
    return 0u8
}

func stage_selection(
    exports:const ModuleExports in G, row:u64, mode:ModuleSelectionMode, nature:ResourceNature,
    revision:u64, site:u64, members:u64, member_first:u64, member_past:u64,
    local:const SelectionSpelling in L,
    published:const SelectionSpelling in L, selected:CheckedSelections in F, at:u64)
    -> void where {const owner G, const owner L, owner F} {
    selected[at] <- make SelectedResource {
        revision <- revision; site <- site; mode <- mode; nature <- nature;
        members <- members; local <- local; published <- published;
        default_member_first <- member_first; default_member_past <- member_past;
        public_row <- if (exports[row].publishing_module == 0u64) { no_node() } else { row };
        export_kind <- exports[row].kind; checked <- exports[row].checked;
        publishing_module <- exports[row].publishing_module;
        defining_module <- exports[row].origin_module;
        identity <- exports[row].identity; owner_module <- exports[row].owner_module;
        owner_identity <- exports[row].owner_identity; shape <- exports[row].shape
    };
    return
}

func stage_graph_selection(
    exports:const ModuleExports in G, row:u64, mode:ModuleSelectionMode, nature:ResourceNature,
    revision:u64, site:u64, member_first:u64, member_past:u64, selected:CheckedSelections in F, at:u64)
    -> void where {const owner G, owner F} {
    ref spelling = make GraphSpelling { span <- make SourceSpan {
        first <- exports[row].name_first; past <- exports[row].name_past
    } };
    stage_selection(exports, row, mode, nature,
                    revision, site, no_node(), member_first, member_past, spelling, spelling,
                    selected, at);
    return
}

export func append_bulk_selections(
    exports:const ModuleExports in G, defaults:const DefaultExportRefs in G,
    ranges:const ModuleSelectionRanges in R, view:PublicView, module:u64, spelling_used:u64,
    mode:ModuleSelectionMode, revision:u64, site:u64, declarations_only:bool,
    selected:CheckedSelections in F, used:u64 in C)
    -> u8 where {const owner G, const owner R, owner F, owner C} {
    ref past = make u64 { used };
    val measured <- measure_bulk_selection(exports, defaults, ranges, view, module,
                                           spelling_used, past);
    if (measured != 0u8) return measured;
    if (past > intrinsic (len)(selected)) return export_storage_exhausted();
    val first <- if (view == DefaultPublic) { (ranges.defaults_first) } else { (ranges.exports_first) };
    val row <- no_node();
    val diagnostic <- 0u8;
    ref nature = make ResourceNature { OrdinaryResource };
    val next <- used;
    val member_first <- 0u64;
    val member_past <- 0u64;
    for (ordinal in first .. first + (past - used)) {
        row <- selected_bulk_row(defaults, view, ordinal);
        diagnostic <- selection_profile(mode, exports[row].kind, exports[row].shape,
                                        no_node(), declarations_only);
        if (diagnostic != 0u8) return diagnostic;
        if (!export_nature(exports, row, nature)) return wrong_export_kind();
        if (view == DefaultPublic) {
            member_first <- defaults[ordinal].members.first_ordinal;
            member_past <- defaults[ordinal].members.past_ordinal;
            if ((member_first != 0u64 || member_past != 0u64) &&
                (member_first >= member_past || exports[row].kind != enum_export() ||
                 defaults[ordinal].members.first_byte >= defaults[ordinal].members.past_byte))
                return invalid_member_selection()
        };
        stage_graph_selection(exports, row, mode, nature, revision, site, member_first, member_past, selected, next);
        (next <- next + 1u64):void
    };
    used <- next;
    return 0u8
}

func same_module_path(source:const SourceBytes in S, first:u64, past:u64,
                      spellings:const SourceBytes in B, module_first:u64, module_past:u64) -> bool
    where {const owner S, const owner B} {
    # The lexer has already validated the quotes and escapes. Decode as we
    # compare so the source can stay mapped and neither spelling is rebuilt.
    val position <- first + 1u64;
    val close_quote <- past - 1u64;
    for (at in module_first .. module_past) {
        if (position >= close_quote) return false;
        if (source[position] == 92u8) { (position <- position + 1u64):void; } else {}; # backslash
        if (source[position] != spellings[at]) return false;
        position <- position + 1u64;
    };
    return position == close_quote;
}

func builtin_path(source:const SourceBytes in S, first:u64, past:u64) -> bool where {const owner S} {
    # Quoted path escapes can only produce quote or backslash.
    return past >= first && past - first >= 6u64 && past <= intrinsic (len)(source) &&
        source[first + 1u64] == 115u8 && source[first + 2u64] == 116u8 &&
        source[first + 3u64] == 100u8 && source[first + 4u64] == 58u8;
}

export func module_selection_path(
    nodes:const ExprNodes in N, revision:u64, used:u64, at:u64,
    named:ModuleSelectionSites in M, bulk:BulkSelectionSites in M)
    -> u64 where {const owner N, owner M} {
    if (inspect_module_selection(nodes, revision, used, at, named) == SelectionReady)
        return named.path;
    if (inspect_bulk_selection(nodes, revision, used, at, bulk) == SelectionReady)
        return bulk.path;
    return no_node()
}

export func file_dependency_path(
    source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64, at:u64,
    named:ModuleSelectionSites in M, bulk:BulkSelectionSites in M)
    -> u64 where {const owner S, const owner N, owner M} {
    val path <- module_selection_path(nodes, revision, used, at, named, bulk);
    if (path == no_node() || builtin_path(source, syntax_first(nodes, used, path), syntax_past(nodes, used, path)))
        return no_node();
    return path
}

export func next_module_dependency(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                   used:u64, revision:u64, start:u64) -> u64
    where {const owner S, const owner N} {
    if (used > syntax_len(nodes) || start >= used) return no_node();
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    for (at in start .. used) {
        if (file_dependency_path(source, nodes, used, revision, at, selection, bulk) != no_node()) return at
    };
    return no_node();
}

export func prepare_module_dependencies(selected:SelectedExports in R, used:u64) -> bool where {owner R} {
    if (used > intrinsic (len)(selected)) return false;
    for (at in 0u64 .. used) { selected[at].dependency_module <- 0u64; };
    return true;
}

func clear_selection(selected:SelectedExports in R, at:u64) -> void
    where {owner R} {
    selected[at].checked_resource <- no_node();
    selected[at].selection_site <- no_node();
    selected[at].selection_public_row <- no_node();
    selected[at].identity <- 0u64;
    selected[at].kind <- 0u8;
    selected[at].checked <- 0u8;
    selected[at].origin_module <- 0u64;
    selected[at].owner_module <- 0u64;
    selected[at].owner_identity <- 0u64;
    selected[at].shape <- 0u8;
    selected[at].enum_head <- no_node();
    selected[at].enum_code <- 0u64;
    selected[at].sum_head <- no_node();
    selected[at].next_sum_selection <- no_node();
    selected[at].constructor_selection <- no_node();
    (selected[at].constructor_row <- no_node()):void;
}

func select_export(exports:const ModuleExports in E, row:u64, selected:SelectedExports in R, at:u64) -> void
    where {const owner E, owner R} {
    selected[at].checked_resource <- no_node();
    selected[at].selection_site <- no_node();
    selected[at].selection_public_row <- no_node();
    selected[at].identity <- exports[row].identity;
    selected[at].kind <- exports[row].kind;
    selected[at].checked <- exports[row].checked;
    selected[at].origin_module <- exports[row].origin_module;
    selected[at].owner_module <- exports[row].owner_module;
    selected[at].owner_identity <- exports[row].owner_identity;
    (selected[at].shape <- exports[row].shape):void;
}

func resolve_selection_row(
    source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64,
    syntax:const ModuleSelectionSites in M, spellings:const SourceBytes in B,
    exports:const ModuleExports in E, spelling_size:u64,
    export_first:u64, export_past:u64, dependency:u64,
    declarations_only:bool, row:u64 in R) -> u8
    where {const owner S, const owner N, const owner M, const owner B, const owner E, owner R} {
    val name_first <- syntax_first(nodes, used, syntax.resource) +
        if (syntax.symbolic) { 1u64 } else { 0u64 };
    val name_past <- syntax_past(nodes, used, syntax.resource);
    val path_first <- syntax_first(nodes, used, syntax.path);
    val path_past <- syntax_past(nodes, used, syntax.path);
    if (spelling_size > intrinsic (len)(spellings) || export_first > export_past ||
        export_past > intrinsic (len)(exports))
        return unproved_module_exports();
    val intrinsic_path <- builtin_path(source, path_first, path_past);
    if ((dependency == 0u64 && !intrinsic_path) || dependency == no_node() ||
        (dependency != 0u64 && intrinsic_path)) return unproved_module_exports();
    val diagnostic <- if (dependency == 0u64) { unproved_module_exports() } else { missing_module_export() };
    val profile <- 0u8;
    for (at in export_first .. export_past) {
        if (exports[at].kind != 0u8 && exports[at].publishing_module == dependency &&
            exports[at].name_first <= exports[at].name_past && exports[at].name_past <= spelling_size &&
            (dependency != 0u64 ||
             (exports[at].module_first <= exports[at].module_past && exports[at].module_past <= spelling_size &&
              same_module_path(source, path_first, path_past, spellings, exports[at].module_first, exports[at].module_past)))) {
            if (same_bytes(source, name_first, name_past, spellings, exports[at].name_first, exports[at].name_past)) {
                if (syntax.symbolic == (exports[at].kind == symbol_export())) {
                    if (syntax.nature != OrdinaryResource &&
                        !matches_export_nature(exports, at, syntax.nature)) return wrong_export_kind();
                    profile <- selection_profile(
                        syntax.mode, exports[at].kind, exports[at].shape, syntax.members,
                        declarations_only);
                    if (profile != 0u8) return profile;
                    row <- at;
                    return 0u8;
                } else {};
                (diagnostic <- wrong_export_kind()):void;
            } else {
                if (diagnostic == unproved_module_exports()) { (diagnostic <- missing_module_export()):void; } else {};
            };
        } else {};
    };
    return diagnostic;
}

func resolve_selection(
    source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, site:u64,
    syntax:const ModuleSelectionSites in M, spellings:const SourceBytes in B,
    exports:const ModuleExports in E, spelling_size:u64, export_count:u64,
    selected:SelectedExports in R, declarations_only:bool) -> u8
    where {const owner S, const owner N, const owner M, const owner B, const owner E, owner R} {
    ref row = make u64 { no_node() };
    val result <- resolve_selection_row(source, nodes, used, syntax, spellings, exports,
                                        spelling_size, 0u64, export_count,
                                        selected[site].dependency_module, declarations_only, row);
    if (result != 0u8) return result;
    select_export(exports, row, selected, site);
    return 0u8
}

export func append_named_selection(
    source:const SourceBytes in S, nodes:const ExprNodes in N, revision:u64, used:u64, site:u64,
    syntax:const ModuleSelectionSites in M, spellings:const SourceBytes in B,
    exports:const ModuleExports in E, spelling_size:u64,
    export_first:u64, export_past:u64, dependency:u64,
    declarations_only:bool, selected:CheckedSelections in F, next:u64 in C)
    -> u8 where {const owner S, const owner N, const owner M, const owner B, const owner E,
                 owner F, owner C} {
    if (next >= intrinsic (len)(selected)) return export_storage_exhausted();
    ref row = make u64 { no_node() };
    val result <- resolve_selection_row(source, nodes, used, syntax, spellings, exports,
                                        spelling_size, export_first, export_past,
                                        dependency, declarations_only, row);
    if (result != 0u8) return result;
    ref nature = make ResourceNature { OrdinaryResource };
    if (!export_nature(exports, row, nature)) return wrong_export_kind();
    if (syntax.local >= used) return invalid_export_tree();
    val local_first <- syntax_first(nodes, used, syntax.local) +
        if (syntax.symbolic) { 1u64 } else { 0u64 };
    val local_past <- syntax_past(nodes, used, syntax.local);
    if (local_first >= local_past || local_past > intrinsic (len)(source)) return invalid_export_tree();
    ref local = make SourceSpelling { span <- make SourceSpan {
        first <- local_first; past <- local_past
    } };
    # A qualified procedure selection introduces its published family.
    # Installation and extension have their own checks.
    if (dependency == 0u64) {
        ref catalog_name = make CatalogSpelling { span <- make SourceSpan {
            first <- exports[row].name_first; past <- exports[row].name_past
        } };
        stage_selection(exports, row, syntax.mode, nature, revision, site,
                        syntax.members, 0u64, 0u64, local, catalog_name, selected, next)
    } else {
        ref graph_name = make GraphSpelling { span <- make SourceSpan {
            first <- exports[row].name_first; past <- exports[row].name_past
        } };
        stage_selection(exports, row, syntax.mode, nature, revision, site,
                        syntax.members, 0u64, 0u64, local, graph_name, selected, next)
    };
    next <- next + 1u64;
    return 0u8
}

export func measure_module_selections(
    nodes:const ExprNodes in N, tree:const ParseResult in T, dependencies:const SelectedExports in D,
    visits:const Visits in G, visit_used:u64, exports:const ModuleExports in G, export_used:u64,
    defaults:const DefaultExportRefs in G, default_used:u64, spelling_used:u64,
    count:u64 in C, report:ExportResolutionResult in R)
    -> bool where {const owner N, const owner T, const owner D, const owner G, owner C, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_export_tree();
    if (tree.diagnostic != 0u8 || tree.used > syntax_len(nodes) ||
        tree.used > intrinsic (len)(dependencies) || tree.used == 0u64 ||
        export_used > intrinsic (len)(exports) || default_used > intrinsic (len)(defaults))
        return false;
    ref named = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource; nature <- OrdinaryResource
    };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    ref ranges = make ModuleSelectionRanges {
        exports_first <- 0u64; exports_past <- 0u64; defaults_first <- 0u64; defaults_past <- 0u64
    };
    ref measured = make u64 { 0u64 };
    val shape <- InvalidSelection;
    val module <- 0u64;
    for (at in 0u64 .. tree.used) {
        report.node <- at;
        shape <- inspect_module_selection(nodes, tree.revision, tree.used, at, named);
        if (shape == InvalidSelection) return false;
        if (shape == SelectionReady) {
            if (measured == no_node() - 1u64) {
                report.diagnostic <- export_storage_exhausted();
                return false
            };
            (measured <- measured + 1u64):void
        } else {
            shape <- inspect_bulk_selection(nodes, tree.revision, tree.used, at, bulk);
            if (shape == InvalidSelection) return false;
            if (shape == SelectionReady) {
                module <- dependencies[at].dependency_module;
                if (!checked_module_selections(visits, visit_used, module, export_used,
                                               default_used, ranges)) {
                    report.node <- bulk.path;
                    report.diagnostic <- unproved_module_exports();
                    return false
                };
                report.diagnostic <- measure_bulk_selection(
                    exports, defaults, ranges, bulk.view, module, spelling_used, measured);
                if (report.diagnostic != 0u8) return false;
                (report.diagnostic <- invalid_export_tree()):void
            }
        }
    };
    count <- measured;
    report.node <- no_node();
    report.diagnostic <- 0u8;
    return true
}

export func stage_module_selections(
    source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
    dependencies:const SelectedExports in D, catalog:const SourceBytes in B,
    builtins:const ModuleExports in B, visits:const Visits in G, visit_used:u64,
    exports:const ModuleExports in G, export_used:u64, defaults:const DefaultExportRefs in G,
    default_used:u64, spellings:const SourceBytes in G, spelling_used:u64,
    declarations_only:bool, selections:CheckedSelections in F, used:u64 in C,
    report:ExportResolutionResult in R)
    -> bool where {const owner S, const owner N, const owner T, const owner D, const owner B,
                   const owner G, owner F, owner C, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_export_tree();
    if (tree.diagnostic != 0u8 || tree.used > syntax_len(nodes) ||
        tree.used > intrinsic (len)(dependencies) || tree.used == 0u64 ||
        spelling_used > intrinsic (len)(spellings) ||
        export_used > intrinsic (len)(exports) || default_used > intrinsic (len)(defaults))
        return false;
    if (!valid_builtin_catalog(builtins)) {
        report.diagnostic <- unproved_module_exports();
        return false
    };
    ref named = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource; nature <- OrdinaryResource
    };
    ref bulk = make BulkSelectionSites { path <- no_node(); mode <- UseResource; view <- DefaultPublic };
    ref ranges = make ModuleSelectionRanges {
        exports_first <- 0u64; exports_past <- 0u64; defaults_first <- 0u64; defaults_past <- 0u64
    };
    ref next = make u64 { 0u64 };
    val module <- 0u64;
    val shape <- InvalidSelection;
    val result <- 0u8;
    for (at in 0u64 .. tree.used) {
        report.node <- at;
        shape <- inspect_module_selection(nodes, tree.revision, tree.used, at, named);
        if (shape == InvalidSelection) return false;
        module <- dependencies[at].dependency_module;
        if (shape == SelectionReady) {
            if (module == 0u64) {
                (result <- append_named_selection(source, nodes, tree.revision, tree.used, at,
                    named, catalog, builtins, intrinsic (len)(catalog), 0u64,
                    intrinsic (len)(builtins), module, declarations_only, selections, next)):void
            } else {
                if (!checked_module_selections(visits, visit_used, module, export_used,
                                               default_used, ranges)) {
                    report.node <- named.path;
                    report.diagnostic <- unproved_module_exports();
                    return false
                };
                (result <- append_named_selection(source, nodes, tree.revision, tree.used, at,
                    named, spellings, exports, spelling_used, ranges.exports_first,
                    ranges.exports_past, module, declarations_only, selections, next)):void
            }
        } else {
            shape <- inspect_bulk_selection(nodes, tree.revision, tree.used, at, bulk);
            if (shape == InvalidSelection) return false;
            if (shape == SelectionReady) {
                if (!checked_module_selections(visits, visit_used, module, export_used,
                                               default_used, ranges)) {
                    report.node <- bulk.path;
                    report.diagnostic <- unproved_module_exports();
                    return false
                };
                (result <- append_bulk_selections(exports, defaults, ranges, bulk.view, module,
                    spelling_used, bulk.mode, tree.revision, at, declarations_only,
                    selections, next)):void
            }
        };
        if (result != 0u8) {
            report.diagnostic <- result;
            return false
        }
    };
    if (!validate_checked_selections(selections, next, tree, source, catalog, spellings, spelling_used,
        report)) return false;
    used <- next;
    report.node <- no_node();
    report.diagnostic <- 0u8;
    return true
}

export func defining_symbol_row(exports:const ModuleExports in E, first:u64, past:u64,
    module:u64, identity:u64, spelling_used:u64) -> u64 where {const owner E} {
    if (first >= past || past > intrinsic (len)(exports) || module == no_node() ||
        identity == no_node()) return no_node();
    val selected <- no_node();
    for (at in first .. past) {
        if (exports[at].kind == symbol_export() && exports[at].publishing_module == module &&
            exports[at].origin_module == module && exports[at].identity == identity) {
            if (selected != no_node() || exports[at].name_first >= exports[at].name_past ||
                exports[at].name_past > spelling_used) return no_node();
            (selected <- at):void
        }
    };
    return selected
}

export func checked_lexical_selection_kind(selections:const CheckedSelections in F, used:u64,
    row:u64, revision:u64, syntax_used:u64) -> u8 where {const owner F} {
    if (row >= used || used > intrinsic (len)(selections)) return 0u8;
    return case selections[row] of {
        SelectedResource {
            val origin <- revision; val directive <- site; val kind <- export_kind; val verb <- mode;
            val identity <- identity; val defining <- defining_module;
        } -> {
            if (origin != revision || directive >= syntax_used || verb == ReexportResource ||
                identity == no_node() || defining == no_node()) { 0u8 }
            else { kind }
        };
        UnpublishedSelection -> 0u8
    }
}

export func project_checked_resource(selections:const CheckedSelections in F, used:u64,
    row:u64, revision:u64, syntax_used:u64, lexical_use:bool, output:SelectedExport in R) -> bool
    where {const owner F, owner R} {
    if (row >= used || used > intrinsic (len)(selections)) return false;
    return case selections[row] of {
        SelectedResource {
            val origin <- revision; val directive <- site; val kind <- export_kind; val verb <- mode;
            val identity <- identity; val defining <- defining_module; val publisher <- publishing_module;
            val checked <- checked; val owner_module <- owner_module; val owner_identity <- owner_identity;
            val shape <- shape; val public_row <- public_row;
        } -> {
            if (origin != revision || directive >= syntax_used || kind == 0u8 ||
                (lexical_use && verb == ReexportResource)) return false;
            output.dependency_module <- publisher;
            output.checked_resource <- row;
            output.selection_site <- directive;
            output.selection_public_row <- public_row;
            output.identity <- identity;
            output.kind <- kind;
            output.checked <- checked;
            output.origin_module <- defining;
            output.owner_module <- owner_module;
            output.owner_identity <- owner_identity;
            output.shape <- shape;
            return true
        };
        UnpublishedSelection -> false
    }
}

export func checked_selection_site(selections:const CheckedSelections in F, used:u64,
    row:u64, revision:u64) -> u64 where {const owner F} {
    if (row >= used || used > intrinsic (len)(selections)) return no_node();
    return case selections[row] of {
        SelectedResource { val origin <- revision; val directive <- site; } ->
            if (origin == revision) { directive } else { no_node() };
        UnpublishedSelection -> no_node()
    }
}

export func project_public_import(selections:const CheckedSelections in F, used:u64,
    row:u64, revision:u64, site:u64, graph_used:u64, facade:u64,
    output:ModuleExport in R) -> bool
    where {const owner F, owner R} {
    if (row >= used || used > intrinsic (len)(selections) || facade == 0u64) return false;
    return case selections[row] of {
        SelectedResource {
            val origin <- revision; val directive <- site; val verb <- mode; val local <- local;
            val kind <- export_kind; val checked <- checked; val publisher <- publishing_module;
            val definition <- defining_module; val identity <- identity;
            val owner_module <- owner_module; val owner_identity <- owner_identity; val shape <- shape;
        } -> {
            if (origin != revision || directive != site || verb != ImportResource ||
                publisher == 0u64 || publisher == facade || kind == 0u8) return false;
            case local of {
                GraphSpelling { val span <- span; } -> {
                    if (span.first >= span.past || span.past > graph_used) return false;
                    output.name_first <- span.first;
                    (output.name_past <- span.past):void
                };
                _ -> { return false; }
            };
            output.publishing_module <- facade;
            output.origin_module <- definition;
            output.identity <- identity;
            output.kind <- kind;
            output.checked <- checked;
            output.owner_module <- owner_module;
            output.owner_identity <- owner_identity;
            output.shape <- shape;
            output.module_first <- 0u64;
            output.module_past <- 0u64;
            return true
        };
        UnpublishedSelection -> false
    }
}

export func permits_module_family_extension(selections:const CheckedSelections in F, used:u64,
    row:u64, revision:u64) -> bool where {const owner F} {
    if (row >= used || used > intrinsic (len)(selections)) return false;
    return case selections[row] of {
        SelectedResource {
            val origin <- revision; val verb <- mode; val kind <- export_kind;
            val shape <- shape; val nature <- nature;
        } -> origin == revision && verb == ImportResource && nature == OrdinaryResource &&
            kind == callable_export() && shape == ordinary_callable_shape();
        UnpublishedSelection -> false
    }
}

# Written sites still supply member-list and publication readers.
export func project_written_selections(
    nodes:const ExprNodes in N, tree:const ParseResult in T, selections:const CheckedSelections in F,
    used:u64, sites:SelectedExports in D, report:ExportResolutionResult in R)
    -> bool where {const owner N, const owner T, const owner F, owner D, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_export_tree();
    if (tree.used > syntax_len(nodes) || tree.used > intrinsic (len)(sites) ||
        used > intrinsic (len)(selections)) return false;
    for (site in 0u64 .. tree.used) { clear_selection(sites, site) };
    ref named = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource; nature <- OrdinaryResource;
    };
    val selection <- InvalidSelection;
    for (index in 0u64 .. used) {
        case selections[index] of {
            (SelectedResource {
                val revision <- revision; val site <- site; val publisher <- publishing_module;
                val verb <- mode; val member_list <- members;
                val first <- default_member_first; val past <- default_member_past;
            }) -> {
                report.node <- site;
                if (revision != tree.revision || site >= tree.used) return false;
                selection <- inspect_module_selection(nodes, revision, tree.used, site, named);
                if (selection == InvalidSelection) return false;
                if (selection == SelectionReady) {
                    if (sites[site].kind != 0u8 || sites[site].dependency_module != publisher ||
                        named.mode != verb || named.members != member_list || first != 0u64 || past != 0u64 ||
                        !project_checked_resource(selections, used, index, revision, tree.used, false,
                            sites[site])) return false
                }
            };
            UnpublishedSelection -> { return false }
        }
    };
    report.node <- no_node();
    report.diagnostic <- 0u8;
    return true
}

# Consume a successful parse and the supplied dependency targets. The
# publication table carries a checked prefix for those module identities.
# On failure only the diagnostic is available.
export func resolve_module_exports(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                   builtin_spellings:const SourceBytes in B, builtins:const ModuleExports in E,
                                   graph_spellings:const SourceBytes in G, graph_exports:const ModuleExports in H,
                                   spelling_size:u64, export_count:u64,
                                   selected:SelectedExports in X, declarations_only:bool, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner B, const owner E,
           const owner G, const owner H, owner X, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_export_tree();
    if (spelling_size > intrinsic (len)(graph_spellings) || export_count > intrinsic (len)(graph_exports)) return false;
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64) return false;
    ref first = make u64 { no_node() };
    if (!first_module_item(nodes, tree.revision, tree.used, tree.root, first)) return false;
    if (intrinsic (len)(selected) < tree.used) {
        report.diagnostic <- export_storage_exhausted();
        return false;
    } else {};
    if (!valid_builtin_catalog(builtins)) {
        report.diagnostic <- unproved_module_exports();
        return false
    };
    ref syntax = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    val shape <- InvalidSelection;
    for (at in 0u64 .. tree.used) {
        clear_selection(selected, at);
        shape <- inspect_module_selection(nodes, tree.revision, tree.used, at, syntax);
        if (shape == InvalidSelection) { report.node <- at; report.diagnostic <- invalid_export_tree(); return false; };
        if (shape == SelectionReady) {
            if (selected[at].dependency_module == 0u64) {
                report.diagnostic <- resolve_selection(source, nodes, tree.used, at, syntax, builtin_spellings, builtins,
                    intrinsic (len)(builtin_spellings), intrinsic (len)(builtins), selected, declarations_only);
            } else {
                report.diagnostic <- resolve_selection(source, nodes, tree.used, at, syntax, graph_spellings, graph_exports,
                    spelling_size, export_count, selected, declarations_only);
            };
            if (report.diagnostic != 0u8) {
                report.node <- if (report.diagnostic == unproved_module_exports()) { (syntax.path) } else { (syntax.resource) };
                return false;
            };
        };
    };
    report.diagnostic <- 0u8;
    return true;
}

export func enum_spelling(source:const SourceBytes in S, first:u64, past:u64,
                           spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I,
                           head:u64) -> u64 where {const owner S, const owner B, const owner I} {
    for (row in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (same_bytes(source, first, past, spellings, interfaces[row].name_first, interfaces[row].name_past))
            return row;
    };
    return no_node();
}

func exposes_written_members(source:const SourceBytes in S, nodes:const ExprNodes in N, selector:u64,
    spellings:const SourceBytes in B, first:u64, past:u64, used:u64, revision:u64) -> bool
    where {const owner S, const owner N, const owner B} {
    ref item = make u64 { no_node() };
    val shape <- inspect_member_selector(nodes, revision, used, selector, item);
    if (shape == InvalidMemberSelector) return false;
    if (shape == AllSelectedMembers) return true;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. selector) {
        if (item == no_node() || inspect_sequence_entry(nodes, revision, used, item, entry) != MemberSequence) return false;
        if (same_bytes(source, syntax_first(nodes, used, entry.item), syntax_past(nodes, used, entry.item),
                        spellings, first, past)) return true;
        item <- entry.previous;
    };
    return false;
}

func exposes_spelling(source:const SourceBytes in S, nodes:const ExprNodes in N, site:u64,
                      spellings:const SourceBytes in B, first:u64, past:u64, used:u64, revision:u64) -> bool
    where {const owner S, const owner N, const owner B} {
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    return inspect_module_selection(nodes, revision, used, site, selection) == SelectionReady &&
        selection.members != no_node() &&
        exposes_written_members(source, nodes, selection.members, spellings, first, past, used, revision)
}

data EnumSelection {
    head:u64;
    selector:u64;
    first_ordinal:u64;
    past_ordinal:u64;
}
array EnumSelections[u64]:EnumSelection;

func exposes_enum_member(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
    spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I, member:u64,
    selection:const EnumSelection in E) -> bool
    where {const owner S, const owner N, const owner B, const owner I, const owner E} {
    if (selection.selector != no_node())
        return exposes_written_members(source, nodes, selection.selector, spellings,
            interfaces[member].name_first, interfaces[member].name_past, used, revision);
    val ordinal <- member - selection.head - 1u64;
    return ordinal >= selection.first_ordinal && ordinal < selection.past_ordinal
}

func first_enum_member(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
    names:const SourceBytes in P, first:u64, past:u64, spellings:const SourceBytes in B,
    interfaces:const ModuleInterfaces in I, selections:const EnumSelections in E, count:u64, head:u64 in O) -> u64
    where {const owner S, const owner N, const owner P, const owner B, const owner I, const owner E, owner O} {
    val member <- no_node();
    for (at in 0u64 .. count) {
        member <- enum_spelling(names, first, past, spellings, interfaces, selections[at].head);
        if (member != no_node() &&
            exposes_enum_member(source, nodes, used, revision, spellings, interfaces, member, selections[at])) {
            head <- selections[at].head;
            return member
        }
    };
    return no_node()
}

func absent_enum_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, tail:u64,
                           spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I, head:u64,
                           used:u64, revision:u64) -> u64 where {const owner S, const owner N, const owner B, const owner I} {
    val item <- tail;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. used) {
        if (item == no_node()) return no_node();
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != MemberSequence) return item;
        if (enum_spelling(source, syntax_first(nodes, used, entry.item), syntax_past(nodes, used, entry.item),
                          spellings, interfaces, head) == no_node()) return entry.item;
        item <- entry.previous;
    };
    return no_node();
}

func append_enum_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
    spellings:const SourceBytes in B, spelling_used:u64, interfaces:const ModuleInterfaces in I, interface_count:u64,
    defining_module:u64, identity:u64, site:u64, selector:u64, first:u64, past:u64,
    selections:EnumSelections in E, count:u64 in C, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner I, owner E, owner C, owner R} {
    if (selector == no_node() && first == 0u64 && past == 0u64) return true;
    report.node <- if (selector == no_node()) { (site) } else { (selector) };
    report.diagnostic <- invalid_member_selection();
    val head <- find_interface(interfaces, interface_count, defining_module, identity);
    if (head == no_node() || interfaces[head].interface_kind != enum_type() ||
        count >= intrinsic (len)(selections)) return false;
    val width <- interfaces[head].entry_count;
    if (width == 0u64 || width >= interface_count - head) return false;
    if ((selector == no_node() && (first >= past || past > width)) ||
        (selector != no_node() && (first != 0u64 || past != 0u64))) return false;
    for (row in head + 1u64 .. head + 1u64 + width) {
        if (interfaces[row].value_kind != enum_type() ||
            interfaces[row].name_first >= interfaces[row].name_past ||
            interfaces[row].name_past > spelling_used) return false
    };
    ref tail = make u64 { no_node() };
    if (selector != no_node()) {
        if (inspect_member_selector(nodes, revision, used, selector, tail) == InvalidMemberSelector) return false;
        val absent <- absent_enum_selection(source, nodes, tail, spellings, interfaces, head, used, revision);
        if (absent != no_node()) {
            report.node <- absent;
            report.diagnostic <- missing_enum_member();
            return false
        }
    };
    ref candidate = make EnumSelection {
        head <- head; selector <- selector; first_ordinal <- first; past_ordinal <- past
    };
    ref previous = make u64 { no_node() };
    val first_byte <- 0u64;
    val past_byte <- 0u64;
    for (row in head + 1u64 .. head + 1u64 + width) {
        if (exposes_enum_member(source, nodes, used, revision, spellings, interfaces, row, candidate)) {
            first_byte <- interfaces[row].name_first;
            past_byte <- interfaces[row].name_past;
            if (first_enum_member(source, nodes, used, revision, spellings, first_byte, past_byte,
                spellings, interfaces, selections, count, previous) != no_node() && previous != head) {
                report.diagnostic <- conflicting_enum_members();
                return false
            }
        }
    };
    selections[count] <- candidate;
    count <- count + 1u64;
    return true
}

export func bind_enum_member(interfaces:const ModuleInterfaces in I, head:u64, member:u64,
                             result:SelectedExport in R) -> void where {const owner I, owner R} {
    result.kind <- enum_member_export();
    result.origin_module <- interfaces[head].defining_module;
    result.identity <- interfaces[member].declaration;
    result.shape <- interfaces[head].element_kind;
    result.enum_head <- head;
    (result.enum_code <- interfaces[member].enum_code):void;
}

# Written selectors and published default ranges use the same member lookup and binding.
export func resolve_enum_selections(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
    spellings:const SourceBytes in B, spelling_used:u64, interfaces:const ModuleInterfaces in I, interface_count:u64,
    checked:const CheckedSelections in C, checked_used:u64, selected:SelectedExports in E,
    report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner I, const owner C, owner E, owner R} {
    report.diagnostic <- invalid_member_selection();
    report.node <- no_node();
    if (checked_used > intrinsic (len)(checked) || used > intrinsic (len)(nodes) ||
        used > intrinsic (len)(selected) || spelling_used > intrinsic (len)(spellings)) return false;
    if (checked_used == 0u64) {
        report.diagnostic <- 0u8;
        return true
    };
    ref selections = make EnumSelections(checked_used, make EnumSelection {
        head <- no_node(); selector <- no_node(); first_ordinal <- 0u64; past_ordinal <- 0u64
    });
    ref count = make u64 { 0u64 };
    for (at in 0u64 .. checked_used) {
        case checked[at] of {
            (SelectedResource {
                val origin <- revision; val site <- site; val verb <- mode; val kind <- export_kind;
                val selector <- members; val first <- default_member_first; val past <- default_member_past;
                val defining <- defining_module; val identity <- identity;
            }) -> {
                if (origin != revision || site >= used) return false;
                if (kind == enum_export() && verb != ReexportResource &&
                    !append_enum_selection(source, nodes, used, revision, spellings, spelling_used, interfaces,
                        interface_count, defining, identity, site, selector, first, past, selections, count, report))
                    return false
            };
            UnpublishedSelection -> { return false }
        }
    };
    if (count != 0u64) {
        ref head = make u64 { no_node() };
        val first <- 0u64;
        val past <- 0u64;
        val member <- no_node();
        val kind <- NotAName;
        for (at in 0u64 .. used) {
            kind <- name_syntax(nodes, used, at);
            if (kind != NotAName) {
                first <- syntax_first(nodes, used, at) + if (kind == SymbolicName) { 1u64 } else { 0u64 };
                past <- syntax_past(nodes, used, at);
                member <- first_enum_member(source, nodes, used, revision, source, first, past,
                                            spellings, interfaces, selections, count, head);
                if (member != no_node()) { bind_enum_member(interfaces, head, member, selected[at]); }
            }
        }
    };
    report.diagnostic <- 0u8;
    report.node <- no_node();
    return true
}

func constructor_spelling(names:const SourceBytes in N, first:u64, past:u64, spellings:const SourceBytes in B,
                          limit:u64, interfaces:const ModuleInterfaces in I, published:u64, head:u64)
    -> u64 where {const owner N, const owner B, const owner I} {
    if (first >= past || past > intrinsic (len)(names)) return no_node();
    val constructor <- no_node();
    for (entry in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        constructor <- checked_sum_constructor(interfaces, published, head, entry);
        if (constructor != no_node() && interfaces[constructor].name_first < interfaces[constructor].name_past &&
            interfaces[constructor].name_past <= limit &&
            same_bytes(names, first, past, spellings, interfaces[constructor].name_first, interfaces[constructor].name_past))
            return constructor;
    };
    return no_node();
}

func exposed_constructor(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
                         spellings:const SourceBytes in B, limit:u64, interfaces:const ModuleInterfaces in I, published:u64,
                         selected:const SelectedExports in E, site:u64,
                         names:const SourceBytes in Q, first:u64, past:u64) -> u64
    where {const owner S, const owner N, const owner B, const owner I, const owner E, const owner Q} {
    val constructor <- constructor_spelling(names, first, past, spellings, limit, interfaces, published, selected[site].sum_head);
    if (constructor == no_node()) return no_node();
    if (exposes_spelling(source, nodes, site, spellings,
                        interfaces[constructor].name_first, interfaces[constructor].name_past, used, revision))
        return constructor;
    return no_node();
}

func first_constructor_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
                                  spellings:const SourceBytes in B, limit:u64, interfaces:const ModuleInterfaces in I, published:u64,
                                  selected:const SelectedExports in E, last:u64,
                                  names:const SourceBytes in Q, first:u64, past:u64, constructor:u64 in C)
    -> u64 where {const owner S, const owner N, const owner B, const owner I, const owner E, const owner Q, owner C} {
    val site <- last;
    for (offset in 0u64 .. used) {
        if (site == no_node()) return no_node();
        constructor <- exposed_constructor(source, nodes, used, revision, spellings, limit, interfaces, published,
                                           selected, site, names, first, past);
        if (constructor != no_node()) return site;
        site <- selected[site].next_sum_selection;
    };
    return no_node();
}

func validate_sum_members(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
                          spellings:const SourceBytes in B, limit:u64, interfaces:const ModuleInterfaces in I, published:u64,
                          selected:const SelectedExports in E, site:u64, selector:u64, prior:u64,
                          report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner I, const owner E, owner R} {
    val head <- selected[site].sum_head;
    ref tail = make u64 { no_node() };
    if (selector != no_node() && inspect_member_selector(nodes, revision, used, selector, tail) == InvalidMemberSelector) {
        report.node <- selector;
        report.diagnostic <- invalid_member_selection();
        return false;
    };
    ref arm = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val item <- tail;
    for (offset in 0u64 .. used) {
        if (item != no_node()) {
            if (inspect_sequence_entry(nodes, revision, used, item, arm) != MemberSequence ||
                constructor_spelling(source, syntax_first(nodes, used, arm.item), syntax_past(nodes, used, arm.item),
                                     spellings, limit, interfaces, published, head) == no_node()) {
                report.node <- if (arm.item < used) { arm.item } else { selector };
                report.diagnostic <- missing_sum_constructor();
                return false;
            };
            (item <- arm.previous):void;
        };
    };
    val constructor <- no_node();
    val other <- no_node();
    val previous <- no_node();
    val first <- 0u64;
    val past <- 0u64;
    for (entry in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        constructor <- checked_sum_constructor(interfaces, published, head, entry);
        if (constructor != no_node()) {
            first <- interfaces[constructor].name_first;
            (past <- interfaces[constructor].name_past):void;
        };
        if (constructor == no_node() || first >= past || past > limit) {
            report.node <- selected_resource_name(nodes, revision, used, site);
            report.diagnostic <- invalid_member_selection();
            return false;
        };
        if (selector != no_node() && exposes_spelling(source, nodes, site, spellings, first, past, used, revision)) {
            previous <- prior;
            for (offset in 0u64 .. site) {
                if (previous != no_node()) {
                    other <- exposed_constructor(source, nodes, used, revision, spellings, limit, interfaces, published,
                                                 selected, previous, spellings, first, past);
                    if (other != no_node() && constructor != other) {
                        report.node <- selector;
                        report.diagnostic <- conflicting_sum_constructors();
                        return false;
                    };
                    (previous <- selected[previous].next_sum_selection):void;
                };
            };
        };
    };
    return true;
}

export func resolve_sum_selections(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, revision:u64,
                                   spellings:const SourceBytes in B, limit:u64, interfaces:const ModuleInterfaces in I, published:u64,
                                   selected:SelectedExports in E, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner I, owner E, owner R} {
    val last <- no_node();
    val head <- no_node();
    ref selection = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        symbolic <- false; mode <- UseResource;
        nature <- OrdinaryResource;
    };
    for (site in 0u64 .. used) {
        if (selected[site].kind == sum_export() &&
            inspect_module_selection(nodes, revision, used, site, selection) == SelectionReady) {
            head <- find_interface(interfaces, published, selected[site].origin_module, selected[site].identity);
            if (head == no_node() || interfaces[head].interface_kind != sum_type() ||
                interfaces[head].entry_count == 0u64 || limit > intrinsic (len)(spellings)) {
                report.node <- selected_resource_name(nodes, revision, used, site);
                report.diagnostic <- invalid_member_selection();
                return false;
            };
            selected[site].sum_head <- head;
            if (!validate_sum_members(source, nodes, used, revision, spellings, limit, interfaces, published,
                                      selected, site, selection.members, last, report)) return false;
            if (selection.members != no_node()) {
                selected[site].next_sum_selection <- last;
                (last <- site):void;
            };
        };
    };
    if (last == no_node()) return true;
    val site <- no_node();
    val first <- 0u64;
    val past <- 0u64;
    ref constructor = make u64 { no_node() };
    for (at in 0u64 .. used) {
        if ((name_syntax(nodes, used, at) != NotAName && name_syntax(nodes, used, at) != SymbolicName) ||
            case_pattern(nodes, used, at) == NamedCaseMember) {
            first <- syntax_first(nodes, used, at);
            past <- syntax_past(nodes, used, at);
            site <- first_constructor_selection(source, nodes, used, revision, spellings, limit, interfaces, published,
                                                selected, last, source, first, past, constructor);
            if (site != no_node()) {
                selected[at].constructor_selection <- site;
                (selected[at].constructor_row <- constructor):void;
            };
        };
    };
    return true;
}

export func verify_aggregate_selections(nodes:const ExprNodes in N, used:u64, revision:u64,
                                        interfaces:const ModuleInterfaces in I, published:u64,
                                        selected:const SelectedExports in E, record_interface_kind:u8,
                                        report:ExportResolutionResult in R)
    -> bool where {const owner N, const owner I, const owner E, owner R} {
    if (used > intrinsic (len)(selected)) return false;
    val kind <- 0u8;
    val expected <- 0u8;
    val storage <- CLayoutBitsRecord;
    val shape <- 0u8;
    val derived <- 0u8;
    val header <- no_node();
    for (site in 0u64 .. used) {
        kind <- selected[site].kind;
        if (kind == nominal_exception_export()) {
            header <- find_interface(interfaces, published, selected[site].origin_module,
                selected[site].identity);
            if (header == no_node() || interfaces[header].interface_kind != record_interface_kind ||
                (selected[site].checked == 0u8 && interfaces[header].exception_schema !=
                    UncheckedExceptionSchema) ||
                (selected[site].checked != 0u8 && interfaces[header].exception_schema !=
                    CheckedExceptionSchema)) {
                report.node <- selected_resource_name(nodes, revision, used, site);
                report.diagnostic <- unproved_module_exports();
                return false
            }
        };
        if (kind == record_export() || kind == sum_export()) {
            expected <- if (kind == record_export()) { record_interface_kind } else { sum_type() };
            storage <- checked_aggregate_storage(interfaces, published, selected[site].origin_module,
                                                  selected[site].identity, expected);
            shape <- selected[site].shape;
            derived <- aggregate_export_shape(storage, shape == numeric_record_shape());
            if (derived == 0u8 || shape != derived) {
                report.node <- selected_resource_name(nodes, revision, used, site);
                report.diagnostic <- unproved_module_exports();
                return false;
            };
        };
    };
    return true;
}

export ModuleExport;
export ModuleExports;
