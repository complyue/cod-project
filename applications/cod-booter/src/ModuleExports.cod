using "SourceStorage.cod" SourceBytes;
using "SourceAccess.cod" same_bytes;
using "ParserStorage.cod" {
    ExprNodes, len as syntax_len, no_node, module_node, module_selection, symbol_node, name_node,
    import_node, member_selector_node, selected_resource_name,
};
using "ExpressionParser.cod" ParseResult;
using "ModuleExportStorage.cod" { ModuleExport, ModuleExports, ModuleInterfaces, find_interface, enum_type };

export data SelectedExport {
    # Input from dependency discovery. Zero selects the builtin namespace.
    dependency_module:u64;
    identity:u64;
    kind:u8;
    checked:u8;
    origin_module:u64;
    owner_module:u64;
    owner_identity:u64;
    shape:u8;
    enum_head:u64;
    next_enum_selection:u64;
    enum_code:u64;
}
export array SelectedExports[u64]:SelectedExport;

export data ExportResolutionResult {
    diagnostic:u8;
    node:u64;
}

export func exception_type_export() -> u8 { return 1u8; }
export func symbol_export() -> u8 { return 2u8; }
export func native_handle_export() -> u8 { return 3u8; }
export func record_export() -> u8 { return 4u8; }
export func array_export() -> u8 { return 5u8; }
export func nominal_exception_export() -> u8 { return 6u8; }
export func callable_export() -> u8 { return 7u8; }
export func enum_export() -> u8 { return 8u8; }
export func enum_member_export() -> u8 { return 9u8; }
export func abstract_type_export() -> u8 { return 10u8; }
export func builder_storage_export() -> u8 { return 11u8; }
export func lexical_builder_export() -> u8 { return 13u8; }
export func print_export_identity() -> u64 { return 0u64; }
export func exception_root_identity() -> u64 { return 0u64; }
export func null_pointer_identity() -> u64 { return 4u64; }
export func missing_return_identity() -> u64 { return 5u64; }
export func unexpected_case_identity() -> u64 { return 9u64; }

export func unproved_module_exports() -> u8 { return 1u8; }
export func missing_module_export() -> u8 { return 2u8; }
export func wrong_export_kind() -> u8 { return 3u8; }
export func export_storage_exhausted() -> u8 { return 4u8; }
export func invalid_export_tree() -> u8 { return 5u8; }
func unproved_import_interpretation() -> u8 { return 12u8; }
func invalid_member_selection() -> u8 { return 13u8; }
func missing_enum_member() -> u8 { return 14u8; }
func conflicting_enum_members() -> u8 { return 15u8; }

func same_module_path(source:const SourceBytes in S, first:u64, past:u64,
                      spellings:const SourceBytes in B, module_first:u64, module_past:u64) -> bool
    where {const owner S, const owner B} {
    # The lexer has already validated the quotes and escapes. Decode as we
    # compare so the source can stay mapped and neither spelling is rebuilt.
    val position <- first + 1u64;
    val close_quote <- past - 1u64;
    for (at in module_first .. module_past) {
        if (position >= close_quote) return false;
        if (source[position] == 92u8) { (position <- position + 1u64):void; } else {}; # backslash
        if (source[position] != spellings[at]) return false;
        position <- position + 1u64;
    };
    return position == close_quote;
}

func builtin_path(source:const SourceBytes in S, first:u64, past:u64) -> bool where {const owner S} {
    # Quoted path escapes can only produce quote or backslash.
    return past >= first && past - first >= 6u64 && past <= intrinsic (len)(source) &&
        source[first + 1u64] == 115u8 && source[first + 2u64] == 116u8 &&
        source[first + 3u64] == 100u8 && source[first + 4u64] == 58u8;
}

export func next_module_dependency(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64, start:u64) -> u64
    where {const owner S, const owner N} {
    if (used > syntax_len(nodes) || start >= used) return no_node();
    val path <- no_node();
    for (at in start .. used) {
        if (module_selection(nodes[at].kind)) {
            path <- nodes[at].left;
            if (!builtin_path(source, nodes[path].first, nodes[path].past)) return at;
        } else {};
    };
    return no_node();
}

export func prepare_module_dependencies(selected:SelectedExports in R, used:u64) -> bool where {owner R} {
    if (used > intrinsic (len)(selected)) return false;
    for (at in 0u64 .. used) { selected[at].dependency_module <- 0u64; };
    return true;
}

func clear_selection(selected:SelectedExports in R, at:u64) -> void
    where {owner R} {
    selected[at].identity <- 0u64;
    selected[at].kind <- 0u8;
    selected[at].checked <- 0u8;
    selected[at].origin_module <- 0u64;
    selected[at].owner_module <- 0u64;
    selected[at].owner_identity <- 0u64;
    selected[at].shape <- 0u8;
    selected[at].enum_head <- no_node();
    selected[at].next_enum_selection <- no_node();
    (selected[at].enum_code <- 0u64):void;
}

func select_export(exports:const ModuleExports in E, row:u64, selected:SelectedExports in R, at:u64) -> void
    where {const owner E, owner R} {
    selected[at].identity <- exports[row].identity;
    selected[at].kind <- exports[row].kind;
    selected[at].checked <- exports[row].checked;
    selected[at].origin_module <- exports[row].origin_module;
    selected[at].owner_module <- exports[row].owner_module;
    selected[at].owner_identity <- exports[row].owner_identity;
    (selected[at].shape <- exports[row].shape):void;
}

func resolve_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, site:u64,
                       spellings:const SourceBytes in B, exports:const ModuleExports in E,
                       selected:SelectedExports in R) -> u8
    where {const owner S, const owner N, const owner B, const owner E, owner R} {
    val path <- nodes[site].left;
    val name <- selected_resource_name(nodes, site);
    val symbolic <- nodes[name].kind == symbol_node();
    val name_first <- nodes[name].first + if (symbolic) { 1u64 } else { 0u64 };
    val name_past <- nodes[name].past;
    val path_first <- nodes[path].first;
    val path_past <- nodes[path].past;
    val dependency <- selected[site].dependency_module;
    val intrinsic_path <- builtin_path(source, path_first, path_past);
    if ((dependency == 0u64 && !intrinsic_path) || dependency == no_node() ||
        (dependency != 0u64 && intrinsic_path)) return unproved_module_exports();
    val diagnostic <- if (dependency == 0u64) { unproved_module_exports() } else { missing_module_export() };
    for (at in 0u64 .. intrinsic (len)(exports)) {
        if (exports[at].kind != 0u8 && exports[at].publishing_module == dependency &&
            exports[at].name_first <= exports[at].name_past && exports[at].name_past <= intrinsic (len)(spellings) &&
            (dependency != 0u64 ||
             (exports[at].module_first <= exports[at].module_past && exports[at].module_past <= intrinsic (len)(spellings) &&
              same_module_path(source, path_first, path_past, spellings, exports[at].module_first, exports[at].module_past)))) {
            if (same_bytes(source, name_first, name_past, spellings, exports[at].name_first, exports[at].name_past)) {
                if (symbolic == (exports[at].kind == symbol_export())) {
                    if (nodes[site].kind == import_node() && exports[at].kind != enum_export())
                        return unproved_import_interpretation();
                    if (nodes[nodes[site].right].kind == member_selector_node() && exports[at].kind != enum_export())
                        return invalid_member_selection();
                    select_export(exports, at, selected, site);
                    return 0u8;
                } else {};
                (diagnostic <- wrong_export_kind()):void;
            } else {
                if (diagnostic == unproved_module_exports()) { (diagnostic <- missing_module_export()):void; } else {};
            };
        } else {};
    };
    return diagnostic;
}

# Consume a successful parse and the supplied dependency targets. The
# publication table carries a checked prefix for those module identities.
# On failure only the diagnostic is available.
export func resolve_module_exports(source:const SourceBytes in S, nodes:const ExprNodes in N, tree:const ParseResult in T,
                                   spellings:const SourceBytes in B, exports:const ModuleExports in E,
                                   selected:SelectedExports in X, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner T, const owner B, const owner E, owner X, owner R} {
    report.node <- no_node();
    report.diagnostic <- invalid_export_tree();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) return false;
    if (intrinsic (len)(selected) < tree.used) {
        report.diagnostic <- export_storage_exhausted();
        return false;
    } else {};
    for (at in 0u64 .. tree.used) {
        clear_selection(selected, at);
        if (module_selection(nodes[at].kind)) {
            report.diagnostic <- resolve_selection(source, nodes, at, spellings, exports, selected);
            if (report.diagnostic != 0u8) {
                report.node <- if (report.diagnostic == unproved_module_exports()) {
                    (nodes[at].left)
                } else {
                    selected_resource_name(nodes, at)
                };
                return false;
            } else {};
        } else {};
    };
    report.diagnostic <- 0u8;
    return true;
}

export func enum_spelling(source:const SourceBytes in S, first:u64, past:u64,
                           spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I,
                           head:u64) -> u64 where {const owner S, const owner B, const owner I} {
    for (row in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (same_bytes(source, first, past, spellings, interfaces[row].name_first, interfaces[row].name_past))
            return row;
    };
    return no_node();
}

func exposes_spelling(source:const SourceBytes in S, nodes:const ExprNodes in N, site:u64,
                      spellings:const SourceBytes in B, first:u64, past:u64) -> bool
    where {const owner S, const owner N, const owner B} {
    val selector <- nodes[site].right;
    val item <- nodes[selector].right;
    if (item == no_node()) return true;
    val name <- no_node();
    for (unused in 0u64 .. selector) {
        if (item == no_node()) return false;
        name <- nodes[item].right;
        if (same_bytes(source, nodes[name].first, nodes[name].past, spellings, first, past)) return true;
        item <- nodes[item].left;
    };
    return false;
}

func exposing_site(source:const SourceBytes in S, nodes:const ExprNodes in N, selected:const SelectedExports in E,
                   spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I, last:u64,
                   names:const SourceBytes in P, first:u64, past:u64) -> u64
    where {const owner S, const owner N, const owner E, const owner B, const owner I, const owner P} {
    val site <- last;
    val member <- no_node();
    for (unused in 0u64 .. intrinsic (len)(nodes)) {
        if (site == no_node()) return no_node();
        member <- enum_spelling(names, first, past, spellings, interfaces, selected[site].enum_head);
        if (member != no_node() &&
            exposes_spelling(source, nodes, site, spellings, interfaces[member].name_first, interfaces[member].name_past))
            return site;
        site <- selected[site].next_enum_selection;
    };
    return no_node();
}

func absent_enum_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, selector:u64,
                           spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I, head:u64) -> u64
    where {const owner S, const owner N, const owner B, const owner I} {
    val item <- nodes[selector].right;
    val name <- no_node();
    for (unused in 0u64 .. selector) {
        if (item == no_node()) return no_node();
        name <- nodes[item].right;
        if (enum_spelling(source, nodes[name].first, nodes[name].past, spellings, interfaces, head) == no_node()) return name;
        item <- nodes[item].left;
    };
    return no_node();
}

func validate_enum_selection(source:const SourceBytes in S, nodes:const ExprNodes in N, selected:const SelectedExports in E,
                             spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I,
                             site:u64, prior:u64, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner E, const owner B, const owner I, owner R} {
    val head <- selected[site].enum_head;
    val selector <- nodes[site].right;
    val absent <- absent_enum_selection(source, nodes, selector, spellings, interfaces, head);
    if (absent != no_node()) {
        report.node <- absent;
        report.diagnostic <- missing_enum_member();
        return false;
    } else {};
    val first <- 0u64;
    val past <- 0u64;
    val previous <- no_node();
    for (row in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        first <- interfaces[row].name_first;
        past <- interfaces[row].name_past;
        if (exposes_spelling(source, nodes, site, spellings, first, past)) {
            previous <- exposing_site(source, nodes, selected, spellings, interfaces, prior, spellings, first, past);
            if (previous != no_node() && selected[previous].enum_head != head) {
                report.node <- selector;
                report.diagnostic <- conflicting_enum_members();
                return false;
            } else {};
        } else {};
    };
    return true;
}

export func bind_enum_member(interfaces:const ModuleInterfaces in I, head:u64, member:u64,
                             result:SelectedExport in R) -> void where {const owner I, owner R} {
    result.kind <- enum_member_export();
    result.origin_module <- interfaces[head].defining_module;
    result.identity <- interfaces[member].declaration;
    result.shape <- interfaces[head].element_kind;
    result.enum_head <- head;
    (result.enum_code <- interfaces[member].enum_code):void;
}

# The graph lends complete checked domains. Only validated selectors contribute
# member spellings to ordinary lookup in this source revision.
export func resolve_enum_selections(source:const SourceBytes in S, nodes:const ExprNodes in N, used:u64,
                                    spellings:const SourceBytes in B, interfaces:const ModuleInterfaces in I,
                                    selected:SelectedExports in E, report:ExportResolutionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner I, owner E, owner R} {
    val last <- no_node();
    val head <- no_node();
    for (site in 0u64 .. used) {
        if (selected[site].kind == enum_export() && nodes[nodes[site].right].kind == member_selector_node()) {
            head <- find_interface(interfaces, selected[site].origin_module, selected[site].identity);
            if (head == no_node() || interfaces[head].interface_kind != enum_type()) {
                report.node <- selected_resource_name(nodes, site);
                report.diagnostic <- invalid_member_selection();
                return false;
            } else {};
            selected[site].enum_head <- head;
            if (!validate_enum_selection(source, nodes, selected, spellings, interfaces, site, last, report)) return false;
            selected[site].next_enum_selection <- last;
            last <- site;
        } else {};
    };
    if (last == no_node()) return true;
    val site <- no_node();
    val first <- 0u64;
    val member <- no_node();
    for (at in 0u64 .. used) {
        if (nodes[at].kind == name_node() || nodes[at].kind == symbol_node()) {
            first <- nodes[at].first + if (nodes[at].kind == symbol_node()) { 1u64 } else { 0u64 };
            site <- exposing_site(source, nodes, selected, spellings, interfaces, last, source, first, nodes[at].past);
            if (site != no_node()) {
                head <- selected[site].enum_head;
                member <- enum_spelling(source, first, nodes[at].past, spellings, interfaces, head);
                bind_enum_member(interfaces, head, member, selected[at]);
            } else {};
        } else {};
    };
    return true;
}

export ModuleExport;
export ModuleExports;
