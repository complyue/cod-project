using "./SourceStorage.cod" SourceBytes;
using "./SourceAccess.cod" same_bytes;
using "./ParserStorage.cod" {
    ExprNodes, no_node, syntax_first, syntax_past, ungrouped, name_syntax,
        NameSyntax { OrdinaryName },
    DeclarationSites, inspect_declaration, DeclarationSyntax { NominalRecord },
    FormalSites, inspect_formal, FormalSyntax { OrdinaryFormal }, FormalMode { ValueFormal,
        ExplicitValueFormal },
    BindingSites, inspect_binding, BindingSyntax { TypedBinding },
    first_sequence_entry, SequenceSyntax { FormalSequence },
    CatchSites, inspect_catch_binding, FieldSelectionSites, inspect_field_selection,
};
using "./NameResolution.cod" {
    NameBindings, NameWork, record_type, exception_binding, builtin_u64, builtin_u32, builtin_u8, builtin_bool
};
using "./ModuleExports.cod" SelectedExports;
using "./ModuleExportStorage.cod" {
    ModuleInterfaces, find_interface, AggregateStorage { CLayoutBitsRecord }
};
using "./AggregateSchemas.cod" AggregateFacts;
using "./ExceptionTypes.cod" { ExceptionType, resolve_exception_type, exception_schema };

export data PayloadField { first:u64; past:u64; kind:u8; readonly:bool; }
export array PayloadFields[u64]:PayloadField;

export data PayloadSchema { count:u64; local_first:u64; imported_header:u64; }
export data CaughtFieldUse =
    NoCaughtField {} |
    CaughtField { binding:u64; nominal:ExceptionType; ordinal:u64; kind:u8; readonly:bool; };
export array CaughtFieldUses[u64]:CaughtFieldUse;

export func unknown_exception_field() -> u8 { return 47u8 }

func set_field(fields:PayloadFields in F, index:u64, first:u64, past:u64, kind:u8,
    readonly:bool) -> void where {owner F} {
    fields[index] <- make PayloadField {
        first <- first; past <- past; kind <- kind; readonly <- readonly;
    };
    return;
}

func exception_bits_kind(binding:u8) -> u8 {
    return if (binding == builtin_u64() || binding == builtin_u32() || binding == builtin_u8() ||
        binding == builtin_bool()) { binding } else { 0u8 };
}

func local_field_count(work:const NameWork in W, first:u64, tail:u64, limit:u64) -> u64
    where {const owner W} {
    if (first == no_node()) return if (tail == no_node()) { 0u64 } else { no_node() };
    val field <- first;
    for (index in 0u64 .. limit) {
        if (field >= limit) return no_node();
        if (field == tail) return index + 1u64;
        field <- work[field].next;
    };
    return no_node();
}

func local_schema(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W,
                  record:u64, first:u64, used:u64, revision:u64, fields:PayloadFields in F)
    -> bool where {const owner N, const owner B, const owner W, owner F} {
    val at <- first;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <-
        ValueFormal; };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <-
            no_node(); readonly <- false;
    };
    val kind <- 0u8;
    for (index in 0u64 .. intrinsic (len)(fields)) {
        if (inspect_formal(nodes, revision, record, at, formal) != OrdinaryFormal ||
            (formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
            inspect_binding(nodes, revision, at, formal.binding, binding) != TypedBinding ||
            binding.owner_name != no_node()) return false;
        kind <- exception_bits_kind(names[binding.target_type].kind);
        if (kind == 0u8) return false;
        set_field(fields, index, syntax_first(nodes, used, binding.name), syntax_past(nodes, used,
            binding.name), kind, binding.readonly);
        (at <- work[at].next):void;
    };
    return at == no_node();
}

func imported_schema(interfaces:const ModuleInterfaces in I, head:u64, spelling_used:u64,
    fields:PayloadFields in F)
    -> bool where {const owner I, owner F} {
    val first <- head + 1u64;
    val kind <- 0u8;
    for (row in first .. first + intrinsic (len)(fields)) {
        if ((interfaces[row].field_mode != ValueFormal &&
            interfaces[row].field_mode != ExplicitValueFormal) ||
            interfaces[row].interface_kind != 0u8 || interfaces[row].target_readonly > 1u8 ||
                interfaces[row].name_first >= interfaces[row].name_past ||
            interfaces[row].name_past > spelling_used) return false;
        kind <- exception_bits_kind(interfaces[row].value_kind);
        if (kind == 0u8) return false;
        set_field(fields, row - first, interfaces[row].name_first, interfaces[row].name_past, kind,
            interfaces[row].target_readonly != 0u8);
    };
    return true;
}

export func select_payload_field(source:const SourceBytes in S, first:u64, past:u64,
    names:const SourceBytes in N,
                  fields:const PayloadFields in F, count:u64) -> u64
    where {const owner S, const owner N, const owner F} {
    for (index in 0u64 .. count) {
        if (same_bytes(source, first, past, names, fields[index].first,
            fields[index].past)) return index;
    };
    return no_node();
}

export func find_payload_schema(nodes:const ExprNodes in N, work:const NameWork in W,
                                aggregates:const AggregateFacts in F,
                                    interfaces:const ModuleInterfaces in I,
                                published:u64, type:const ExceptionType in T, module:u64, used:u64,
                                    revision:u64,
                                schema:PayloadSchema in R) -> bool
    where {const owner N, const owner W, const owner F, const owner I, const owner T, owner R} {
    if (type.defining_module == 0u64 || used > intrinsic (len)(work)) return false;
    if (type.defining_module == module) {
        val record <- type.declaration;
        ref declaration = make DeclarationSites {
            name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <-
                no_node();
            index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
        };
        if (record >= intrinsic (len)(aggregates) || aggregates[record] != CLayoutBitsRecord ||
            inspect_declaration(nodes, revision, used, record, declaration) != NominalRecord ||
            !first_sequence_entry(nodes, revision, record, declaration.entries, FormalSequence,
                schema.local_first))
            return false;
        schema.count <- local_field_count(work, schema.local_first, declaration.entries, record);
        schema.imported_header <- no_node();
        return schema.count != no_node()
    };
    val header <- find_interface(interfaces, published, type.defining_module, type.declaration);
    if (header == no_node() || interfaces[header].interface_kind != record_type() ||
        interfaces[header].aggregate_storage != CLayoutBitsRecord ||
        interfaces[header].exception_schema != exception_schema(type)) return false;
    schema.count <- interfaces[header].entry_count;
    schema.imported_header <- header;
    return true
}

export func read_payload_schema(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W,
                                interfaces:const ModuleInterfaces in I, spelling_used:u64,
                                    type:const ExceptionType in T,
                                used:u64, revision:u64, schema:const PayloadSchema in Q,
                                    fields:PayloadFields in F)
    -> bool where {const owner N, const owner B, const owner W, const owner I, const owner T,
        const owner Q, owner F} {
    if (intrinsic (len)(fields) != schema.count) return false;
    if (schema.imported_header == no_node())
        return local_schema(nodes, names, work, type.declaration, schema.local_first, used,
            revision, fields);
    return imported_schema(interfaces, schema.imported_header, spelling_used, fields)
}

func prepare_caught_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B,
                          work:const NameWork in W, selected:const SelectedExports in E,
                              aggregates:const AggregateFacts in A,
                          spellings:const SourceBytes in P, spelling_used:u64,
                              interfaces:const ModuleInterfaces in I, published:u64,
                          uses:CaughtFieldUses in F, at:u64, binding:u64, field:u64, module:u64,
                              used:u64, revision:u64)
    -> u8 where {const owner S, const owner N, const owner B, const owner W, const owner E,
        const owner A,
                 const owner P, const owner I, owner F} {
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    ref type = make ExceptionType { defining_module <- 0u64; declaration <- no_node(); checked <-
        false; };
    ref schema = make PayloadSchema { count <- 0u64; local_first <- no_node(); imported_header <-
        no_node(); };
    if (!inspect_catch_binding(nodes, revision, used, binding, caught) ||
        !resolve_exception_type(nodes, names, selected, caught.annotation, module, used, revision,
            type) ||
        !find_payload_schema(nodes, work, aggregates, interfaces, published, type, module, used,
            revision, schema))
        return unknown_exception_field();
    ref fields = make PayloadFields(schema.count, make PayloadField { first <- 0u64; past <- 0u64;
        kind <- 0u8; readonly <- false; });
    if (!read_payload_schema(nodes, names, work, interfaces, spelling_used, type, used, revision,
        schema, fields))
        return unknown_exception_field();
    val name_first <- syntax_first(nodes, used, field);
    val name_past <- syntax_past(nodes, used, field);
    val ordinal <- if (schema.imported_header == no_node()) {
        select_payload_field(source, name_first, name_past, source, fields, schema.count)
    } else { select_payload_field(source, name_first, name_past, spellings, fields, schema.count) };
    if (ordinal == no_node()) return unknown_exception_field();
    uses[at] <- make CaughtField {
        binding <- binding; nominal <- type; ordinal <- ordinal; kind <- fields[ordinal].kind;
        readonly <- caught.readonly || fields[ordinal].readonly;
    };
    return 0u8
}

func selected_catch(nodes:const ExprNodes in N, names:const NameBindings in B,
                     receiver:u64, used:u64, revision:u64) -> u64
    where {const owner N, const owner B} {
    val name <- ungrouped(nodes, revision, used, receiver);
    if (name_syntax(nodes, used, name) == OrdinaryName && names[name].kind == exception_binding())
        return names[name].declaration;
    return no_node()
}

export func first_caught_field(nodes:const ExprNodes in N, names:const NameBindings in B, used:u64,
    revision:u64) -> u64
    where {const owner N, const owner B} {
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    for (at in 0u64 .. used) {
        if (inspect_field_selection(nodes, revision, used, at, selection) &&
            selected_catch(nodes, names, selection.receiver, used, revision) != no_node()) return at
    };
    return no_node()
}

export func prepare_caught_fields(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B,
                                  work:const NameWork in W, selected:const SelectedExports in E,
                                      aggregates:const AggregateFacts in A,
                                  spellings:const SourceBytes in P, spelling_used:u64,
                                      interfaces:const ModuleInterfaces in I, published:u64,
                                  uses:CaughtFieldUses in F, failed:u64 in R, module:u64, used:u64,
                                      revision:u64)
    -> u8 where {const owner S, const owner N, const owner B, const owner W, const owner E,
        const owner A,
                 const owner P, const owner I, owner F, owner R} {
    if (used > intrinsic (len)(uses) || used > intrinsic (len)(names) ||
        spelling_used > intrinsic (len)(spellings))
        return unknown_exception_field();
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    val binding <- no_node();
    val diagnostic <- 0u8;
    for (at in 0u64 .. used) {
        if (inspect_field_selection(nodes, revision, used, at, selection)) {
            binding <- selected_catch(nodes, names, selection.receiver, used, revision);
            if (binding != no_node()) {
                diagnostic <- prepare_caught_field(source, nodes, names, work, selected, aggregates,
                    spellings, spelling_used,
                                                   interfaces, published, uses, at, binding,
                                                   selection.field, module, used, revision);
                if (diagnostic != 0u8) { failed <- at; return diagnostic }
            } else {};
        } else {};
    };
    return 0u8
}
