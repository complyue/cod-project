using "SourceStorage.cod" SourceBytes;
using "ParserStorage.cod" Tokens;
using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" no_node;
using "Frontend.cod" FrontendResult;
using "Frontend.cod" read_module;
using "ExpressionParser.cod" ParseResult;
using "ModuleExports.cod" ModuleExports;
using "ModuleExports.cod" SelectedExports;
using "ModuleExports.cod" ExportResolutionResult;
using "ModuleExports.cod" resolve_module_exports;
using "NameResolution.cod" NameBindings;
using "NameResolution.cod" NameWork;
using "NameResolution.cod" NameResolutionResult;
using "NameResolution.cod" unsupported_module_declaration;
using "NameResolution.cod" declaration_requires_native_output;
using "NameResolution.cod" first_item;
using "NameResolution.cod" resolve_module_names;
using "NativeDeclarations.cod" NativeDeclarationResult;
using "NativeDeclarations.cod" check_native_declarations;
using "OperandChecking.cod" OperandFacts;
using "OperandChecking.cod" CallOwners;
using "OperandChecking.cod" OperandCheckResult;
using "OperandChecking.cod" check_module_operands;
using "CompletionChecking.cod" CompletionSites;
using "CompletionChecking.cod" CompletionCheckResult;
using "CompletionChecking.cod" check_module_completion;

data ModuleBindingResult {
    frontend:FrontendResult;
    stage:u8;
    diagnostic:u8;
    related_first:u64;
}

func module_read_failed() -> u8 { return 1u8; }
func module_selection_failed() -> u8 { return 2u8; }
func module_binding_failed() -> u8 { return 3u8; }
func module_operands_failed() -> u8 { return 4u8; }
func module_completion_failed() -> u8 { return 5u8; }

func rejected_unsupported_declaration(result:const ModuleBindingResult in R) -> bool where {const owner R} {
    return result.stage == module_binding_failed() && result.diagnostic == unsupported_module_declaration();
}

func binding_diagnostic(nodes:const ExprNodes in N, ref result:ModuleBindingResult in R,
                        stage:u8, diagnostic:u8, at:u64) -> void where {const owner N, owner R} {
    result.stage <- stage;
    result.diagnostic <- diagnostic;
    result.frontend.diagnostic_first <- no_node();
    result.frontend.diagnostic_past <- no_node();
    if (at != no_node()) {
        result.frontend.diagnostic_first <- nodes[at].first;
        (result.frontend.diagnostic_past <- nodes[at].past):void;
    } else {};
}

func first_extended_declaration(nodes:const ExprNodes in N, work:const NameWork in W, tree:const ParseResult in T) -> u64
    where {const owner N, const owner W, const owner T} {
    val item <- first_item(nodes, nodes[tree.root].left);
    val form <- no_node();
    for (unused in 0u64 .. tree.used) {
        if (item == no_node()) { return no_node(); } else {};
        form <- nodes[item].right;
        if (declaration_requires_native_output(nodes[form].kind)) { return form; } else {};
        (item <- work[item].next):void;
    };
    return no_node();
}

# Keep the source revision and immutable catalog live. A successful read
# gives lexical declaration indices and the published objects they select.
func bind_module(source:const SourceBytes in S, ref tokens:Tokens in T, ref nodes:ExprNodes in N,
                 spellings:const SourceBytes in B, exports:const ModuleExports in E,
                 ref selected:SelectedExports in X, ref bindings:NameBindings in Y,
                 ref work:NameWork in W, ref result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W, owner R} {
    result.stage <- 0u8;
    result.diagnostic <- 0u8;
    result.related_first <- no_node();
    if (!read_module(source, tokens, nodes, result.frontend)) {
        result.stage <- module_read_failed();
        return false;
    } else {};
    ref publication = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!resolve_module_exports(source, nodes, result.frontend.tree, spellings, exports, selected, publication)) {
        binding_diagnostic(nodes, result, module_selection_failed(), publication.diagnostic, publication.node);
        return false;
    } else {};
    ref names = make NameResolutionResult { diagnostic <- 0u8; node <- no_node(); enclosing_defer <- no_node(); };
    if (!resolve_module_names(source, nodes, result.frontend.tree, bindings, work, names)) {
        binding_diagnostic(nodes, result, module_binding_failed(), names.diagnostic, names.node);
        if (names.enclosing_defer != no_node()) { result.related_first <- nodes[names.enclosing_defer].first; {}; } else {};
        return false;
    } else {};
    if (first_extended_declaration(nodes, work, result.frontend.tree) != no_node()) {
        ref declarations = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
        if (!check_native_declarations(nodes, bindings, work, selected, result.frontend.tree.used, declarations)) {
            binding_diagnostic(nodes, result, module_binding_failed(), declarations.diagnostic, declarations.node);
            return false;
        } else {};
    } else {};
    return true;
}

# A successful operand analysis supplies the facts for checking completion.
func analyze_module_operands(source:const SourceBytes in S, ref tokens:Tokens in T, ref nodes:ExprNodes in N,
                             spellings:const SourceBytes in B, exports:const ModuleExports in E,
                             ref selected:SelectedExports in X, ref bindings:NameBindings in Y,
                             ref work:NameWork in W, ref facts:OperandFacts in F,
                             ref owners:CallOwners in O, ref result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W,
           owner F, owner O, owner R} {
    if (!bind_module(source, tokens, nodes, spellings, exports, selected, bindings, work, result)) {
        return false;
    } else {};
    val declaration <- first_extended_declaration(nodes, work, result.frontend.tree);
    if (declaration != no_node()) {
        binding_diagnostic(nodes, result, module_binding_failed(), unsupported_module_declaration(), declaration);
        return false;
    } else {};
    ref operands = make OperandCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_module_operands(nodes, result.frontend.tree, bindings, work, selected, facts, owners, operands)) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic, operands.node);
        return false;
    } else {};
    return true;
}

func analyze_module_completion(source:const SourceBytes in S, ref tokens:Tokens in T, ref nodes:ExprNodes in N,
                               spellings:const SourceBytes in B, exports:const ModuleExports in E,
                               ref selected:SelectedExports in X, ref bindings:NameBindings in Y,
                               ref work:NameWork in W, ref facts:OperandFacts in F, ref owners:CallOwners in O,
                               ref sites:CompletionSites in C, ref result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W,
           owner F, owner O, owner C, owner R} {
    if (!analyze_module_operands(source, tokens, nodes, spellings, exports, selected, bindings, work, facts, owners, result)) {
        return false;
    } else {};
    ref completion = make CompletionCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_module_completion(nodes, result.frontend.tree, bindings, work, facts, sites, completion)) {
        binding_diagnostic(nodes, result, module_completion_failed(), completion.diagnostic, completion.node);
        return false;
    } else {};
    return true;
}

export ModuleBindingResult;
export bind_module;
export module_read_failed;
export module_selection_failed;
export module_binding_failed;
export module_operands_failed;
export analyze_module_operands;
export module_completion_failed;
export rejected_unsupported_declaration;
export analyze_module_completion;
