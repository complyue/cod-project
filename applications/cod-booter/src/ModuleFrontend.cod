export data ModuleBindingResult {
    frontend:FrontendResult;
    stage:u8;
    diagnostic:u8;
    related_first:u64;
}

export func module_read_failed() -> u8 { return 1u8; }
export func module_selection_failed() -> u8 { return 2u8; }
export func module_binding_failed() -> u8 { return 3u8; }
export func module_operands_failed() -> u8 { return 4u8; }
export func module_completion_failed() -> u8 { return 5u8; }
func unsupported_array_length() -> u8 { return 74u8; }
func unsupported_ordinary_here() -> u8 { return 76u8; }
func invalid_catch_annotation() -> u8 { return 77u8; }
func unsupported_lexical_callable() -> u8 { return 108u8; }
func unsupported_nominal_sum() -> u8 { return 114u8; }
func unsupported_named_region() -> u8 { return 116u8; }
func unsupported_const_local() -> u8 { return 117u8; }
func unsupported_constructor_case() -> u8 { return 120u8; }
func unsupported_reference_slot_formal() -> u8 { return 121u8; }
func unsupported_fixed_formal() -> u8 { return 122u8; }
func unsupported_procedure_symbol() -> u8 { return 123u8; }
func unsupported_scoped_procedure() -> u8 { return 124u8; }

export func rejected_unsupported_declaration(result:const ModuleBindingResult in R) -> bool where {const owner R} {
    if (result.stage == module_operands_failed())
        return result.diagnostic == unsupported_case_subject() || result.diagnostic == unsupported_case_pattern() ||
            result.diagnostic == unsupported_product_layout() || result.diagnostic == unsupported_text_operation() ||
            result.diagnostic == unsupported_transfer_signature() || result.diagnostic == unproved_transfer_owner() ||
            result.diagnostic == unsupported_imported_call();
    if (result.stage == module_completion_failed()) return result.diagnostic == unsupported_case_transfer();
    return result.stage == module_binding_failed() &&
        (result.diagnostic == unsupported_module_declaration() || result.diagnostic == unsupported_array_length() ||
         result.diagnostic == unsupported_lexical_callable() || result.diagnostic == unsupported_nominal_sum() ||
         result.diagnostic == unsupported_named_region() || result.diagnostic == unsupported_const_local() ||
         result.diagnostic == unsupported_owning_region_result() || result.diagnostic == unsupported_constructor_case() ||
         result.diagnostic == unsupported_reference_slot_formal() || result.diagnostic == unsupported_fixed_formal() ||
         result.diagnostic == unsupported_procedure_symbol() || result.diagnostic == unsupported_scoped_procedure() ||
         (result.diagnostic >= 28u8 && result.diagnostic <= 40u8));
}

export func binding_diagnostic(nodes:const ExprNodes in N, result:ModuleBindingResult in R,
                               stage:u8, diagnostic:u8, at:u64) -> void where {const owner N, owner R} {
    result.stage <- stage;
    result.diagnostic <- diagnostic;
    result.frontend.diagnostic_first <- no_node();
    result.frontend.diagnostic_past <- no_node();
    if (at != no_node()) {
        result.frontend.diagnostic_first <- syntax_first(nodes, result.frontend.tree.used, at);
        (result.frontend.diagnostic_past <- syntax_past(nodes, result.frontend.tree.used, at)):void;
    } else {};
}

func first_extended_declaration(nodes:const ExprNodes in N, work:const NameWork in W, tree:const ParseResult in T,
                               emit_object:bool) -> u64 where {const owner N, const owner W, const owner T} {
    ref item = make u64 { no_node() };
    if (!first_module_item(nodes, tree.revision, tree.used, tree.root, item)) return tree.root;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    for (unused in 0u64 .. tree.used) {
        if (item == no_node()) return no_node();
        if (inspect_sequence_entry(nodes, tree.revision, tree.used, item, entry) != ModuleSequence) return item;
        if (extended_declaration(nodes, tree.revision, tree.used, item, entry.item, emit_object)) return entry.item;
        item <- work[item].next;
    };
    return no_node();
}

func extended_declaration(nodes:const ExprNodes in N, revision:u64, used:u64, item:u64, form:u64,
                          emit_object:bool) -> bool where {const owner N} {
    ref declaration = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref selected = make ModuleSelectionSites {
        path <- no_node(); resource <- no_node(); local <- no_node(); members <- no_node();
        mode <- UseResource; symbolic <- false;
        nature <- OrdinaryResource;
    };
    val shape <- inspect_declaration(nodes, revision, used, form, declaration);
    if (shape == EnumTypeDeclaration) return false;
    val mode <- inspect_callable(nodes, revision, used, form, callable);
    val reexport <- inspect_module_selection(nodes, revision, used, form, selected) == SelectionReady &&
        selected.mode == ReexportResource;
    if (emit_object && (shape == NominalRecord || shape == LocalPublication || mode == ModuleCallable || reexport)) return false;
    return shape != OtherDeclaration || mode == CProvider || mode == CEntry || reexport || module_item_publication(nodes, used, item);
}

func uses_native_boundary(nodes:const ExprNodes in N, used:u64) -> bool where {const owner N} {
    for (at in 0u64 .. used) {
        if (native_boundary_form(nodes, at)) return true;
    };
    return false;
}

func native_boundary_form(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    return case nodes[at] of {
        (Vacant) -> { false };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (OwningHandleBinding) -> { true };
                (BorrowedHandleBinding) -> { true };
                (OwnHandleConstruction) -> { true };
                (BorrowHandleConstruction) -> { true };
                (HereInvocation) -> { true };
                (Formal { val mode <- mode; }) -> { mode == HandleFormal || mode == RetainedHandleFormal };
                (_) -> { false };
            }
        };
    };
}

func construction_query_supported(nodes:const ExprNodes in N, operand:u64) -> bool where {const owner N} {
    if (operand == no_node()) return true;
    return case nodes[operand] of {
        (Vacant) -> { false };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (NameReference) -> { true };
                (IntegerLiteral { val width <- width; }) -> { width == 64u64 };
                (BooleanLiteral) -> { true };
                (_) -> { false };
            }
        };
    };
}

# Declaration checking can resolve projection operands without emitting an address.
func unsupported_source_form(nodes:const ExprNodes in N, revision:u64, used:u64, at:u64, emit_object:bool) -> u8
    where {const owner N} {
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, revision, used, at, construction);
    if (shape == ExceptionConstructionSyntax) return 33u8;
    if (shape == InvalidConstruction) return unsupported_ordinary_construction();
    if (shape != OtherConstruction) {
        return if (shape == PositionalConstruction || construction_query_supported(nodes, construction.queried_operand)) {
            0u8
        } else { unsupported_ordinary_construction() };
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    if (emit_object && inspect_catch_binding(nodes, revision, used, at, caught) && !caught.readonly &&
        caught.annotation != no_node()) return 36u8;
    return case nodes[at] of {
        (Vacant) -> { unsupported_module_declaration() };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (BulkModuleSelection) -> { unsupported_module_declaration() };
                (DefaultPublicSet) -> { unsupported_module_declaration() };
                (ModuleSelection { val mode <- mode; val nature <- nature; }) -> {
                    if (mode == MixinResource || mode == IdentityResource ||
                        nature != OrdinaryResource) {
                        unsupported_module_declaration()
                    } else { 0u8 }
                };
                (Publication { val nature <- nature; }) -> {
                    if (nature != OrdinaryResource) { unsupported_module_declaration() }
                        else { 0u8 }
                };
                (ModuleItem { val defaulted <- defaulted; }) -> {
                    if (defaulted) { unsupported_module_declaration() } else { 0u8 }
                };
                (LocalBinding { val mode <- mode; val declaration_const <- declaration_const; }) -> {
                    if (declaration_const) return unsupported_const_local();
                    if (mode == ExceptionLocal) return 28u8;
                    0u8
                };
                (SumDefinition) -> { if (emit_object) { unsupported_nominal_sum() } else { 0u8 } };
                (ConstructorCasePattern) -> { unsupported_constructor_case() };
                (ProcedureSymbol) -> { unsupported_procedure_symbol() };
                (ScopedProcedureDefinition) -> { unsupported_scoped_procedure() };
                (RegionDefinition) -> { unsupported_named_region() };
                (OwningRegionBinding) -> { unsupported_named_region() };
                (RegionConstruction) -> { unsupported_named_region() };
                (OwningRegionResult) -> { unsupported_owning_region_result() };
                (Formal { val mode <- mode; val fixed <- binding_const; }) -> {
                    if (mode == ReferenceSlotFormal) return unsupported_reference_slot_formal();
                    if (fixed) return unsupported_fixed_formal();
                    if (mode == ExceptionFormal) { 29u8 } else { 0u8 }
                };
                (ExceptionResult) -> { 30u8 };
                (TypeConstraint) -> { if (emit_object) { unsupported_module_declaration() } else { 0u8 } };
                (IndexSelection) -> { if (emit_object) { 39u8 } else { 0u8 } };
                (ArrayLength) -> { if (emit_object) { unsupported_array_length() } else { 0u8 } };
                (DeferredClauses) -> { 40u8 };
                (LocalCallableSlot) -> { 41u8 };
                (CallableDefinition { val lexical <- lexical; }) -> {
                    if (emit_object && lexical) { unsupported_lexical_callable() } else { 0u8 }
                };
                (RaiseWithCause) -> { 42u8 };
                (NamedThrow) -> { 43u8 };
                (RethrowWithCause) -> { 44u8 };
                (NamedArgument) -> { 45u8 };
                (_) -> { 0u8 };
            }
        };
    };
}

# Find the first unsupported source form by byte position, including headers
# and enclosing constructs whose syntax is stored after their operands.
func check_source_profile(nodes:const ExprNodes in N, used:u64, emit_object:bool, result:ModuleBindingResult in R) -> bool
    where {const owner N, owner R} {
    if (used > intrinsic (len)(nodes)) return true;
    val first <- no_node();
    val cause <- 0u8;
    val next <- 0u8;
    for (at in 0u64 .. used) {
        next <- unsupported_source_form(nodes, result.frontend.tree.revision, used, at, emit_object);
        if (next != 0u8 && (first == no_node() || syntax_first(nodes, used, at) < syntax_first(nodes, used, first))) {
            cause <- next;
            (first <- at):void;
        } else {};
    };
    if (first != no_node()) {
        binding_diagnostic(nodes, result, module_binding_failed(), cause, first);
        return false;
    } else {};
    return true;
}

# Resolve resource selections in the retained syntax against its discovered dependencies.
export func select_parsed_module(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                builtin_spellings:const SourceBytes in B, builtins:const ModuleExports in E,
                                graph_spellings:const SourceBytes in G, graph_exports:const ModuleExports in H,
                                spelling_size:u64, export_count:u64,
                                selected:SelectedExports in X, emit_object:bool, result:ModuleBindingResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner G, const owner H, owner X, owner R} {
    result.stage <- 0u8;
    result.diagnostic <- 0u8;
    result.related_first <- no_node();
    if (!check_source_profile(nodes, result.frontend.tree.used, emit_object, result)) return false;
    ref publication = make ExportResolutionResult { diagnostic <- 0u8; node <- no_node(); };
    if (!resolve_module_exports(source, nodes, result.frontend.tree, builtin_spellings, builtins,
                                graph_spellings, graph_exports, spelling_size, export_count, selected, !emit_object, publication)) {
        binding_diagnostic(nodes, result, module_selection_failed(), publication.diagnostic, publication.node);
        return false;
    } else {};
    return true;
}

export func bind_selected_module(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                 selected:const SelectedExports in X, bindings:NameBindings in Y,
                                 work:NameWork in W, interfaces:const ModuleInterfaces in I, interface_used:u64,
                                 facts:AggregateFacts in F, emit_object:bool, result:ModuleBindingResult in R) -> bool
    where {const owner S, const owner N, const owner X, owner Y, owner W, const owner I, owner F, owner R} {
    ref names = make NameResolutionResult { diagnostic <- 0u8; node <- no_node(); enclosing_defer <- no_node(); };
    if (!resolve_module_names(source, nodes, result.frontend.tree, selected, bindings, work, !emit_object, names)) {
        binding_diagnostic(nodes, result, module_binding_failed(), names.diagnostic, names.node);
        if (names.enclosing_defer != no_node()) { result.related_first <- syntax_first(nodes, result.frontend.tree.used, names.enclosing_defer); {}; } else {};
        return false;
    } else {};
    val revision <- result.frontend.tree.revision;
    val used <- result.frontend.tree.used;
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    ref target = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    ref caught = make CatchSites { name <- no_node(); annotation <- no_node(); readonly <- false; };
    val marker <- no_node();
    val text <- false;
    val product <- false;
    val annotation <- no_node();
    val selection <- no_node();
    for (at in 0u64 .. result.frontend.tree.used) {
        if (inspect_signature(nodes, revision, used, at, signature) == BorrowedResultClause) {
            if (!inspect_type_annotation(nodes, revision, used, signature.annotation, target) || target.owner_name == no_node()) {
                binding_diagnostic(nodes, result, module_binding_failed(), 101u8, at);
                return false;
            };
            marker <- target.target_type;
            text <- text_type(bindings[marker].kind);
            product <- bindings[marker].kind == record_type();
            if ((!text && !product && (emit_object || bindings[at].declaration == no_node() ||
                 !is_lexical_builder(nodes, bindings, marker, revision, used))) ||
                (emit_object && bindings[at].declaration != no_node())) {
                binding_diagnostic(nodes, result, module_binding_failed(), 35u8, at);
                return false;
            } else {};
            if ((text && !signature.readonly) ||
                bindings[target.owner_name].kind != owner_binding()) {
                binding_diagnostic(nodes, result, module_binding_failed(), 101u8, at);
                return false;
            } else {};
        } else {};
        if (inspect_catch_binding(nodes, revision, used, at, caught) && caught.annotation != no_node()) {
            annotation <- caught.annotation;
            if (!declared_exception_type(nodes, bindings, selected, annotation, used, revision)) {
                binding_diagnostic(nodes, result, module_binding_failed(), invalid_catch_annotation(), annotation);
                return false;
            };
            if (emit_object && bindings[annotation].kind == ordinary_selection()) {
                selection <- bindings[annotation].declaration;
                if (selected[selection].kind == exception_type_export() && selected[selection].identity == error_root_identity()) {
                    binding_diagnostic(nodes, result, module_binding_failed(), unsupported_module_declaration(), annotation);
                    return false;
                };
            };
        };
    };
    if (!emit_object || first_extended_declaration(nodes, work, result.frontend.tree, false) != no_node() ||
        uses_native_boundary(nodes, result.frontend.tree.used)) {
        ref declarations = make NativeDeclarationResult { diagnostic <- 0u8; node <- no_node(); };
        if (!check_native_declarations(nodes, bindings, work, selected, interfaces, interface_used, facts,
                                        used, revision, emit_object, declarations)) {
            binding_diagnostic(nodes, result, module_binding_failed(), declarations.diagnostic, declarations.node);
            result.frontend.diagnostic_first <- native_declaration_first(nodes, result.frontend.tree.used, declarations);
            return false;
        } else {};
    } else {};
    return true;
}

# Read a standalone module with the builtin catalog.
export func bind_module(source:const SourceBytes in S, tokens:Tokens in T, nodes:ExprNodes in N,
                        spellings:const SourceBytes in B, exports:const ModuleExports in E,
                        selected:SelectedExports in X, bindings:NameBindings in Y,
                        work:NameWork in W, result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W, owner R} {
    result.diagnostic <- 0u8;
    result.related_first <- no_node();
    if (!read_module(source, tokens, nodes, result.frontend)) {
        result.stage <- module_read_failed();
        return false;
    } else {};
    if (!prepare_module_dependencies(selected, result.frontend.tree.used)) {
        binding_diagnostic(nodes, result, module_selection_failed(), export_storage_exhausted(), no_node());
        return false;
    } else {};
    if (!select_parsed_module(source, nodes, spellings, exports, spellings, exports, 0u64, 0u64, selected, true, result)) return false;
    ref interfaces = make ModuleInterfaces(0u64, make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- 0u64; name_first <- 0u64; name_past <- 0u64;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <- NoCallableKind;
        native_reception <- 0u8;
        native_passes_owner <- 0u8; sum_payload <- make NoSumInterface {};
        aggregate_storage <- UnprovedAggregate; field_mode <- ValueFormal;
    });
    ref facts = make AggregateFacts(result.frontend.tree.used, UnprovedAggregate);
    return bind_selected_module(source, nodes, selected, bindings, work, interfaces, 0u64, facts, true, result);
}

# A successful operand analysis supplies the facts for checking completion.
export func analyze_module_operands(source:const SourceBytes in S, tokens:Tokens in T, nodes:ExprNodes in N,
                                    spellings:const SourceBytes in B, exports:const ModuleExports in E,
                                    selected:SelectedExports in X, bindings:NameBindings in Y,
                                    work:NameWork in W, facts:OperandFacts in F,
                                    owners:CallOwners in O, result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W,
           owner F, owner O, owner R} {
    if (!bind_module(source, tokens, nodes, spellings, exports, selected, bindings, work, result))
        return false;
    return analyze_bound_operands(source, nodes, selected, bindings, work, facts, owners, result);
}

export func analyze_bound_operands(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                   selected:const SelectedExports in X, bindings:const NameBindings in Y,
                                   work:const NameWork in W, facts:OperandFacts in F,
                                   owners:CallOwners in O, result:ModuleBindingResult in R) -> bool
    where {const owner S, const owner N, const owner X, const owner Y, const owner W, owner F, owner O, owner R} {
    val declaration <- first_extended_declaration(nodes, work, result.frontend.tree, true);
    if (declaration != no_node()) {
        binding_diagnostic(nodes, result, module_binding_failed(), unsupported_module_declaration(), declaration);
        return false;
    } else {};
    for (at in 0u64 .. result.frontend.tree.used) {
        if (is_here_formal(nodes, result.frontend.tree.used, at)) {
            binding_diagnostic(nodes, result, module_binding_failed(), unsupported_ordinary_here(), at);
            return false;
        } else {};
    };
    ref operands = make OperandCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_module_operands(source, nodes, result.frontend.tree, bindings, work, selected, facts, owners, operands)) {
        binding_diagnostic(nodes, result, module_operands_failed(), operands.diagnostic, operands.node);
        return false;
    } else {};
    return true;
}

export func analyze_module_completion(source:const SourceBytes in S, tokens:Tokens in T, nodes:ExprNodes in N,
                                      spellings:const SourceBytes in B, exports:const ModuleExports in E,
                                      selected:SelectedExports in X, bindings:NameBindings in Y,
                                      work:NameWork in W, facts:OperandFacts in F, owners:CallOwners in O,
                                      sites:CompletionSites in C, result:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W,
           owner F, owner O, owner C, owner R} {
    if (!analyze_module_operands(source, tokens, nodes, spellings, exports, selected, bindings, work, facts, owners, result))
        return false;
    return analyze_bound_completion(nodes, bindings, work, facts, sites, result);
}

export func analyze_bound_completion(nodes:const ExprNodes in N, bindings:const NameBindings in Y,
                                     work:const NameWork in W, facts:const OperandFacts in F,
                                     sites:CompletionSites in C, result:ModuleBindingResult in R) -> bool
    where {const owner N, const owner Y, const owner W, const owner F, owner C, owner R} {
    ref completion = make CompletionCheckResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_module_completion(nodes, result.frontend.tree, bindings, work, facts, sites, completion)) {
        binding_diagnostic(nodes, result, module_completion_failed(), completion.diagnostic, completion.node);
        return false;
    } else {};
    return true;
}
