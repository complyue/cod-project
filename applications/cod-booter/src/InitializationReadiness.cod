using "./ParserStorage.cod" no_node;
using "./InitializationFlow.cod" {
    InitializationOperations, InitializationIndices, InitializationTags, initialization_obligation
};
using "./InitializationFlow.cod" InitializationAccess { ResetAccess, EstablishAccess, ReadBinding, PromiseWrite };
using "./InitializationControl.cod" InitializationStates;

export data InitializationResult {
    diagnostic:u8;
    node:u64;
}

func unproved_initialization() -> u8 { return 13u8; }
func unproved_local_binding() -> u8 { return 17u8; }
func incomplete_place_initialization() -> u8 { return 19u8; }

func add_predecessor(heads:InitializationIndices in I, links:InitializationIndices in I,
                     edge:u64, target:u64) -> void where {owner I} {
    if (target != no_node()) {
        links[edge] <- heads[target];
        (heads[target] <- edge):void
    };
}

# Each state owns two edge indices, so an incoming edge identifies its source
# without retaining another word per edge. Group obligations by tag once.
func index_readiness(operations:const InitializationOperations in O, states:const InitializationStates in S,
                     pred_heads:InitializationIndices in I, pred_links:InitializationIndices in I,
                     tag_heads:InitializationIndices in I, uses:InitializationIndices in I, states_used:u64) -> void
    where {const owner O, const owner S, owner I} {
    val at <- no_node();
    val tag <- 0u64;
    for (state in 0u64 .. states_used) {
        add_predecessor(pred_heads, pred_links, state * 2u64, states[state].first);
        add_predecessor(pred_heads, pred_links, state * 2u64 + 1u64, states[state].second);
        at <- states[state].operation;
        if (initialization_obligation(operations[at].access)) {
            tag <- operations[at].tag;
            uses[state] <- tag_heads[tag];
            (tag_heads[tag] <- state):void
        };
    };
}

func add_influence(marks:InitializationIndices in W, work:InitializationIndices in W, count:u64 in W,
                   tag:u64, state:u64) -> void where {owner W} {
    if (marks[state] != tag) {
        marks[state] <- tag;
        work[count] <- state;
        (count <- count + 1u64):void
    };
}

func seed_influence(uses:const InitializationIndices in I, first_use:u64, tag:u64,
                    marks:InitializationIndices in W, work:InitializationIndices in W, count:u64 in W) -> void
    where {const owner I, owner W} {
    val use <- first_use;
    for (unused in 0u64 .. intrinsic (len)(uses)) {
        if (use == no_node()) return;
        add_influence(marks, work, count, tag, use);
        (use <- uses[use]):void
    };
}

func visit_predecessors(operations:const InitializationOperations in O, states:const InitializationStates in S,
                        pred_links:const InitializationIndices in I, first_edge:u64, tag:u64,
                        marks:InitializationIndices in W, work:InitializationIndices in W, count:u64 in W) -> bool
    where {const owner O, const owner S, const owner I, owner W} {
    val origin <- false;
    val edge <- first_edge;
    val previous <- no_node();
    val from <- no_node();
    for (unused in 0u64 .. intrinsic (len)(pred_links)) {
        if (edge == no_node()) return origin;
        previous <- edge / 2u64;
        from <- states[previous].operation;
        if (operations[from].tag == tag && operations[from].access == ResetAccess) {
            (origin <- true):void
        } else {
            if (!(operations[from].tag == tag && operations[from].access == EstablishAccess)) {
                add_influence(marks, work, count, tag, previous)
            };
        };
        (edge <- pred_links[edge]):void
    };
    return origin
}

# Graph edges stay inside their activation. Grouping all uses of a tag in the
# same worklist thus gathers the independent slices without mixing activations.
func collect_influence(operations:const InitializationOperations in O, states:const InitializationStates in S,
                       roots:const InitializationIndices in S, pred_heads:const InitializationIndices in I,
                       pred_links:const InitializationIndices in I, uses:const InitializationIndices in I,
                       first_use:u64, tag:u64, marks:InitializationIndices in W, work:InitializationIndices in W,
                       origins:InitializationTags in W, count:u64 in W) -> void
    where {const owner O, const owner S, const owner I, owner W} {
    seed_influence(uses, first_use, tag, marks, work, count);
    val state <- no_node();
    val at <- no_node();
    val reset <- false;
    for (item in 0u64 .. intrinsic (len)(work)) {
        if (item == count) return;
        state <- work[item];
        at <- states[state].operation;
        reset <- visit_predecessors(operations, states, pred_links, pred_heads[state], tag, marks, work, count);
        (origins[item] <- reset || roots[operations[at].activation] == state):void
    };
}

func add_unready(marks:const InitializationIndices in I, unready:InitializationTags in W,
                 work:InitializationIndices in W, count:u64, tag:u64, state:u64) -> u64
    where {const owner I, owner W} {
    if (state == no_node() || marks[state] != tag || unready[state]) return count;
    unready[state] <- true;
    work[count] <- state;
    return count + 1u64
}

# Observe entry at each use and associate its result with the written operation.
# A failed use in one state does not mark a different use of the same tag.
func complete_unready(operations:const InitializationOperations in O, states:const InitializationStates in S,
                      marks:const InitializationIndices in I, influence:const InitializationIndices in I,
                      origins:const InitializationTags in I, influence_count:u64, tag:u64,
                      unready:InitializationTags in W, work:InitializationIndices in W,
                      rejected:InitializationTags in R) -> void
    where {const owner O, const owner S, const owner I, owner W, owner R} {
    val count <- 0u64;
    for (item in 0u64 .. influence_count) { (unready[influence[item]] <- false):void };
    for (item in 0u64 .. influence_count) {
        if (origins[item]) { (count <- add_unready(marks, unready, work, count, tag, influence[item])):void };
    };
    val state <- no_node();
    val at <- no_node();
    for (item in 0u64 .. intrinsic (len)(work)) {
        if (item == count) return;
        state <- work[item];
        at <- states[state].operation;
        if (operations[at].tag == tag && initialization_obligation(operations[at].access)) {
            (rejected[at] <- true):void
        };
        if (!(operations[at].tag == tag && operations[at].access == EstablishAccess)) {
            count <- add_unready(marks, unready, work, count, tag, states[state].first);
            (count <- add_unready(marks, unready, work, count, tag, states[state].second)):void;
        };
    };
}

export func complete_initialization_readiness(
    operations:const InitializationOperations in O, states:const InitializationStates in S,
    roots:const InitializationIndices in S, states_used:u64, tags:u64, rejected:InitializationTags in R) -> void
    where {const owner O, const owner S, owner R} {
    ref pred_heads = make InitializationIndices(states_used, no_node());
    ref pred_links = make InitializationIndices(states_used * 2u64, no_node());
    ref tag_heads = make InitializationIndices(tags, no_node());
    ref uses = make InitializationIndices(states_used, no_node());
    index_readiness(operations, states, pred_heads, pred_links, tag_heads, uses, states_used);

    ref marks = make InitializationIndices(states_used, 0u64);
    ref influence = make InitializationIndices(states_used, no_node());
    ref origins = make InitializationTags(states_used, false);
    ref work = make InitializationIndices(states_used, no_node());
    ref unready = make InitializationTags(states_used, false);
    ref influence_count = make u64 { 0u64 };
    val first_use <- no_node();
    for (tag in 1u64 .. tags) {
        first_use <- tag_heads[tag];
        if (first_use != no_node()) {
            influence_count <- 0u64;
            collect_influence(operations, states, roots, pred_heads, pred_links, uses, first_use, tag,
                              marks, influence, origins, influence_count);
            complete_unready(operations, states, marks, influence, origins, influence_count, tag,
                             unready, work, rejected);
        };
    };
}

# The diagnostic consumer only reads the completed operation results.
export func check_initialization(operations:const InitializationOperations in O,
                                 rejected:const InitializationTags in P, result:InitializationResult in R) -> bool
    where {const owner O, const owner P, owner R} {
    for (at in 0u64 .. intrinsic (len)(operations)) {
        if (rejected[at]) {
            result.node <- operations[at].site;
            result.diagnostic <- if (operations[at].access == PromiseWrite) { incomplete_place_initialization() }
                else { if (operations[at].access == ReadBinding) { unproved_local_binding() }
                       else { unproved_initialization() } };
            return false
        }
    };
    return true
}
