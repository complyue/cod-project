using "std:exceptions" Exception;
using "./NativeCommands.cod" { NativeCommands, NativeUnitRows, NativeLiteralRanges };
using "./SourceStorage.cod" SourceBytes;

export handle type LLVMSession;
export symbol @llvmSession :own handle LLVMSession;
export data LLVMOpenException <: Exception { status:UInt8, }

proc "C" LLVMSession() throws LLVMOpenException;
export proc "C" llvm_construct(handle session:LLVMSession in L, ref rows:const NativeCommands in W,
                               ref source:const SourceBytes in S, used:UInt64, functions:UInt64, labels:UInt64, slots:UInt64) -> UInt8
    where {owner L, const owner W, const owner S};
export proc "C" llvm_construct_units(handle session:LLVMSession in L,
                                     commands:const NativeCommands in G, units:const NativeUnitRows in G,
                                     literals:const NativeLiteralRanges in G, spellings:const SourceBytes in G,
                                     names:const SourceBytes in G, command_count:UInt64, unit_count:UInt64,
                                     literal_count:UInt64, spelling_size:UInt64, name_size:UInt64, functions:UInt64) -> UInt8
    where {owner L, const owner G};
export proc "C" llvm_verify(handle session:LLVMSession in L) -> UInt8 where {const owner L};
export proc "C" llvm_emit_object(handle session:LLVMSession in L, output:const CString in A) -> UInt8
    where {owner L, const owner A};
