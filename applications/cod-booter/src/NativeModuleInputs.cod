using "./CompilerStatus.cod" CompilerStatus;
using "./NativeSource.cod" { Path, PathOwner };
using "./SourceStorage.cod" SourceBytes;
using "std:exceptions" Exception;

export handle type PackageInputCapture;
export data PackageCaptureException <: Exception { os_error:u64; }

proc "C" PackageInputCapture(handle entry:Path in A) throws PackageCaptureException
    where {const owner A};

export func "C" package_capture_status(handle capture:PackageInputCapture in C) -> u64
    where {const owner C};

export proc "C" use_package_capture(
    here work(output:const SourceBytes in C, diagnostics:const SourceBytes in C) -> CompilerStatus,
    handle capture:PackageInputCapture in C) -> CompilerStatus where {const owner C};

export handle type BundledDirectory;
export data BundledDirectoryException <: Exception { os_error:u64; }

proc "C" BundledDirectory() throws BundledDirectoryException;

proc "C" use_bundled_directory(
    here work(path:const SourceBytes in B) -> CompilerStatus,
    handle directory:BundledDirectory in B) -> CompilerStatus where {const owner B};

export proc bundled_directory_use(
    here work(path:const SourceBytes in B) -> CompilerStatus,
    handle directory:BundledDirectory in B) -> CompilerStatus where {const owner B} {
    return use_bundled_directory(directory) (path) => { continue work(path) }
}

# The probe reports max u64 for an absent entry, zero for a directory entry,
# and an OS error otherwise. Canonicalization happens after selection.
export proc "C" probe_package_module(
    root:const SourceBytes in R, root_first:u64, root_past:u64,
    module:const SourceBytes in M, first:u64, past:u64)
    -> u64 where {const owner R, const owner M};

export proc "C" prepare_package_module(
    handle destination:PathOwner in D, root:const SourceBytes in R,
    root_first:u64, root_past:u64, module:const SourceBytes in M, first:u64, past:u64)
    -> u64 where {owner D, const owner R, const owner M};
