data LoweringState {
    syntax_revision:u64;
    syntax_used:u64;
    active_function:u64;
    active_scope:u64;
    exception_target:u64;
    return_target:u64;
    return_slot:u64;
    return_ready:u64;
    caught_failure:u64;
    live:bool;
    local_return:bool;
    scope_cleanup:u64;
    scope_scan_flag:u64;
    scope_scan_pending:bool;
    case_index:u64;
    case_join:u64;
    case_arm:u64;
    case_next:u64;
    case_present_flag:u64;
    case_read:bool;
    case_completed:bool;
    case_resumed:bool;
    finalizer:u64;
    break_landing:u64;
    break_value:u64;
    scan_landing:u64;
    pending_break:bool;
    pending_scan:bool;
}

export func native_unsupported() -> u8 { return 1u8; }
export func native_command_capacity() -> u8 { return 2u8; }
export func invalid_native_module() -> u8 { return 3u8; }
export func unproved_callable_completion() -> u8 { return 4u8; }

func command(code:NativeCommands in C, plan:NativePlan in P, opcode:u8,
             a:u64, b:u64, c:u64, d:u64) -> void where {owner C, owner P} {
    if (plan.diagnostic != 0u8) return;
    val at <- plan.used;
    if (at == intrinsic (len)(code)) {
        plan.diagnostic <- native_command_capacity();
        return;
    } else {};
    code[at].opcode <- opcode;
    code[at].a <- a;
    code[at].b <- b;
    code[at].c <- c;
    code[at].d <- d;
    plan.used <- at + 1u64;
    return;
}

func emit(code:NativeCommands in C, plan:NativePlan in P, opcode:u8, a:u64, b:u64) -> void
    where {owner C, owner P} {
    command(code, plan, opcode, a, b, 0u64, 0u64);
}

func storage_operation(code:NativeCommands in C, plan:NativePlan in P, opcode:u8, a:u64, b:u64,
                       reservation:u64, at:u64) -> void where {owner C, owner P} {
    val tag <- reservation_tag(reservation);
    command(code, plan, opcode, a, b, tag, if (tag == 0u64) { 0u64 } else { at });
}

func initialize_guarded_locals(names:const NameBindings in B, code:NativeCommands in C, plan:NativePlan in P,
                                scope:u64) -> void where {const owner B, owner C, owner P} {
    val declaration <- names[scope].guarded_local_link;
    for (unused in 0u64 .. intrinsic (len)(names)) {
        if (declaration == no_node()) return;
        storage_operation(code, plan, unbind_local(), 0u64, 0u64, declaration, declaration);
        declaration <- names[declaration].guarded_local_link;
    };
}

func new_block(plan:NativePlan in P) -> u64 where {owner P} {
    val label <- plan.labels;
    plan.labels <- label + 1u64;
    return label;
}

func new_slot(plan:NativePlan in P) -> u64 where {owner P} {
    val index <- plan.slots;
    plan.slots <- index + 1u64;
    return index;
}

func position(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
              label:u64) -> void where {owner C, owner P, owner R} {
    emit(code, plan, position_block(), label, plan.function_base + state.active_function);
    state.live <- true;
    return;
}

func finish_block(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                  destination:u64) -> void where {owner C, owner P, owner R} {
    emit(code, plan, jump(), destination, 0u64);
    state.live <- false;
    return;
}

func forward_return(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                    returned:u64, continuation:u64, prepared:u64, ready:u64) -> void where {owner C, owner P, owner R} {
    if (returned == continuation) return;
    position(code, plan, state, returned);
    if (prepared != no_node()) { emit(code, plan, copy_word(), state.return_slot, prepared); } else {};
    if (ready != no_node()) { emit(code, plan, word_constant(), ready, 1u64); } else {};
    finish_block(code, plan, state, continuation);
}

func source_failure(code:NativeCommands in C, plan:NativePlan in P, category:u64, at:u64) -> void
    where {owner C, owner P} {
    emit(code, plan, word_constant(), pending_category(), category);
    emit(code, plan, source_site(), pending_site(), at);
}

func invocation_failure(code:NativeCommands in C, plan:NativePlan in P) -> void where {owner C, owner P} {
    command(code, plan, copy_completion(), pending_category(), call_category(), 1u64, 0u64);
    emit(code, plan, copy_word(), pending_site(), call_site());
}

func save_failure(code:NativeCommands in C, plan:NativePlan in P) -> u64 where {owner C, owner P} {
    val category <- new_slot(plan);
    val site <- new_slot(plan);
    emit(code, plan, copy_completion(), category, pending_category());
    emit(code, plan, copy_word(), site, pending_site());
    return category;
}

func restore_failure(code:NativeCommands in C, plan:NativePlan in P, saved:u64) -> void
    where {owner C, owner P} {
    emit(code, plan, copy_completion(), pending_category(), saved);
    emit(code, plan, copy_word(), pending_site(), saved + 1u64);
}

# One dispatch block per guard keeps the same source-order handler walk for
# all its failure sites. Unmatched exceptions and fatal faults use the
# enclosing exception continuation, which includes any finalizer.
func lower_dispatch(nodes:const ExprNodes in N, links:const NameWork in L,
                    facts:const OperandFacts in F, code:NativeCommands in C,
                    plan:NativePlan in P, state:LoweringState in R, at:u64, first:u64) -> void
    where {const owner N, const owner L, const owner F, owner C, owner P, owner R} {
    position(code, plan, state, at);
    val ordinary <- new_block(plan);
    command(code, plan, branch_catchable(), pending_category(), ordinary, state.exception_target, 0u64);
    position(code, plan, state, ordinary);
    val clause <- first;
    ref selected = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref caught = make HandlerSites { binding <- no_node(); body <- no_node(); };
    val handler <- no_node();
    val category <- no_node();
    val next <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, clause, selected) != HandlerClause) {
            finish_block(code, plan, state, state.exception_target);
            return;
        } else {};
        handler <- selected.target;
        if (!inspect_handler(nodes, state.syntax_revision, state.syntax_used, handler, caught)) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        category <- facts[caught.binding].identity;
        if (category == no_node() || category == exception_root_identity()) {
            finish_block(code, plan, state, handler);
            return;
        } else {};
        next <- new_block(plan);
        command(code, plan, branch_equal(), pending_category(), category, handler, next);
        position(code, plan, state, next);
        clause <- links[clause].next;
    };
    finish_block(code, plan, state, state.exception_target);
}

func check_target_presence(sites:const CompletionSites in S, code:NativeCommands in C,
                           plan:NativePlan in P, state:LoweringState in R,
                           at:u64, failure_at:u64) -> void
    where {const owner S, owner C, owner P, owner R} {
    val presence <- sites[at].presence;
    if (presence == present_target()) return;
    if (presence == absent_target()) {
        source_failure(code, plan, null_pointer_identity(), failure_at);
        finish_block(code, plan, state, state.exception_target);
        return;
    } else {};
    val absent <- new_block(plan);
    val ready <- new_block(plan);
    command(code, plan, branch_equal(), slot(at), 0u64, absent, ready);
    position(code, plan, state, absent);
    source_failure(code, plan, null_pointer_identity(), failure_at);
    finish_block(code, plan, state, state.exception_target);
    position(code, plan, state, ready);
}

func require_target(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                    sites:const CompletionSites in S, code:NativeCommands in C,
                    plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner F, const owner S, owner C, owner P, owner R} {
    if (facts[at].needs_target != 0u8) {
        check_target_presence(sites, code, plan, state, at, syntax_first(nodes, state.syntax_used, at));
    } else {};
}

func lower_node(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    lower_expression(nodes, names, links, facts, sites, code, plan, state, at, false);
}

func lower_completed_bits(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                          facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                          plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    lower_node(nodes, names, links, facts, sites, code, plan, state, at);
    if (!state.live || facts[at].reception == independent_value()) return;
    require_target(nodes, facts, sites, code, plan, state, at);
    if (state.live) {
        storage_operation(code, plan, load_target(), slot(at), slot(at), facts[at].reservation, at);
    } else {};
}

func lower_bits(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref tail = make u64 { no_node() };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    ref cases = make CaseSites { subject <- no_node(); items <- no_node(); };
    ref guarded = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    val nested_result <- (!is_scope_block(nodes, at) && block_tail(nodes, state.syntax_revision, state.syntax_used, at, tail)) ||
        inspect_conditional(nodes, state.syntax_revision, state.syntax_used, at, branch) ||
        inspect_case(nodes, state.syntax_revision, state.syntax_used, at, cases) ||
        inspect_protected(nodes, state.syntax_revision, state.syntax_used, at, guarded);
    if (facts[at].reception != nullable_ptr() && nested_result) {
        lower_expression(nodes, names, links, facts, sites, code, plan, state, at, true);
    } else {
        lower_completed_bits(nodes, names, links, facts, sites, code, plan, state, at);
    };
}

# A local owner stores its chain head. A formal stores the address
# of that same head in the supplying activation.
func prepare_owner_address(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                           code:NativeCommands in C, plan:NativePlan in P,
                           owner_site:u64, destination:u64, revision:u64, used:u64) -> void
    where {const owner N, const owner F, owner C, owner P} {
    val chain <- facts[owner_site].owner_chain;
    if (chain == no_node()) { plan.diagnostic <- invalid_native_module(); return; };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    val operation <- if (inspect_signature(nodes, revision, used, owner_site, signature) == OwnerSignatureClause) {
        copy_word()
    } else { place_address() };
    emit(code, plan, operation, destination, slot(chain));
}

func prepare_arguments(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, first:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val argument <- first;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val actual <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (argument == no_node() || !state.live || plan.diagnostic != 0u8) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, argument, entry) != ArgumentSequence) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        actual <- entry.item;
        if (facts[argument].reception == independent_value()) {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, actual);
            if (state.live) { emit(code, plan, copy_word(), slot(argument), slot(actual)); } else {};
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, actual);
            if (state.live && checked_ref_argument(nodes, argument) && facts[actual].reception == nullable_ptr()) {
                check_target_presence(sites, code, plan, state, actual, syntax_first(nodes, state.syntax_used, argument));
            } else {};
            if (state.live) {
                storage_operation(code, plan, copy_word(), slot(argument), slot(actual), facts[actual].reservation, actual);
            } else {};
        };
        if (state.live && facts[argument].owner_chain != no_node()) {
            prepare_owner_address(nodes, facts, code, plan, facts[argument].owner, slot(facts[argument].owner_chain), state.syntax_revision, state.syntax_used);
        };
        argument <- links[argument].next;
    };
}

func invoke(nodes:const ExprNodes in N, links:const NameWork in L,
             facts:const OperandFacts in F, code:NativeCommands in C, plan:NativePlan in P, call:u64, first:u64, symbolic:bool) -> void
    where {const owner N, const owner L, const owner F, owner C, owner P} {
    if (symbolic) {
        emit(code, plan, print_word(), slot(first), 0u64);
        return;
    } else {};
    val argument <- first;
    val target <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (argument == no_node()) {
            target <- if (links[call].imported_function == no_node()) {
                plan.function_base + facts[call].call_definition
            } else { (links[call].imported_function) };
            command(code, plan, invoke_function(), target, slot(call),
                    call_category(), call_site());
            return;
        } else {};
        pass_prepared_operand(code, plan, slot(argument), facts[argument].owner_chain);
        argument <- links[argument].next;
    };
}

func pass_prepared_operand(code:NativeCommands in C, plan:NativePlan in P, word:u64, chain:u64) -> void
    where {owner C, owner P} {
    emit(code, plan, pass_argument(), word, 0u64);
    if (chain != no_node()) { emit(code, plan, pass_argument(), slot(chain), 0u64); };
}

func guard_word(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                word:u64, zero_fails:bool, category:u64, source_at:u64) -> void
    where {owner C, owner P, owner R} {
    val ready <- new_block(plan);
    val failed <- new_block(plan);
    command(code, plan, branch_equal(), word, 0u64,
            if (zero_fails) { failed } else { ready }, if (zero_fails) { ready } else { failed });
    position(code, plan, state, failed);
    source_failure(code, plan, category, source_at);
    finish_block(code, plan, state, state.exception_target);
    position(code, plan, state, ready);
}

func lower_text_intrinsic(nodes:const ExprNodes in N, links:const NameWork in L,
                          code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                          at:u64, text:u64, first:u64, intrinsic_kind:u8) -> void
    where {const owner N, const owner L, owner C, owner P, owner R} {
    if (intrinsic_kind != text_byte_export()) {
        emit(code, plan, text_size(), slot(at), slot(text));
        return;
    };
    val index <- links[text].next;
    val count <- new_slot(plan);
    val in_bounds <- new_slot(plan);
    emit(code, plan, text_size(), count, slot(text));
    command(code, plan, compare_words(), in_bounds, slot(index), count, less_words());
    guard_word(code, plan, state, in_bounds, true, index_out_of_bounds_identity(), first);
    command(code, plan, text_byte(), slot(at), slot(text), slot(index), 0u64);
}

func lower_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                plan:NativePlan in P, state:LoweringState in R, at:u64, arguments:u64, first:u64, symbolic:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref first_argument = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, arguments, ArgumentSequence, first_argument)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    prepare_arguments(nodes, names, links, facts, sites, code, plan, state, first_argument);
    if (!state.live) return;
    val intrinsic_kind <- facts[at].text_intrinsic;
    if (intrinsic_kind != 0u8) {
        lower_text_intrinsic(nodes, links, code, plan, state, at, first_argument, first, intrinsic_kind);
        return;
    };
    invoke(nodes, links, facts, code, plan, at, first_argument, symbolic);
    if (symbolic) return;
    propagate_invocation_failure(code, plan, state);
}

func propagate_invocation_failure(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R) -> void
    where {owner C, owner P, owner R} {
    val ready <- new_block(plan);
    val failed <- new_block(plan);
    command(code, plan, branch_equal(), call_category(), 0u64, ready, failed);
    position(code, plan, state, failed);
    invocation_failure(code, plan);
    finish_block(code, plan, state, state.exception_target);
    position(code, plan, state, ready);
}

func lower_transfer_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, at:u64, place:u64, input:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    lower_node(nodes, names, links, facts, sites, code, plan, state, input);
    if (!state.live || plan.diagnostic != 0u8) return;
    val place_chain <- facts[at].owner_chain;
    val input_chain <- facts[input].owner_chain;
    if (place_chain != no_node()) { prepare_owner_address(nodes, facts, code, plan, facts[at].owner, slot(place_chain), state.syntax_revision, state.syntax_used); };
    if (input_chain != no_node()) { prepare_owner_address(nodes, facts, code, plan, facts[input].owner, slot(input_chain), state.syntax_revision, state.syntax_used); };
    pass_prepared_operand(code, plan, place, place_chain);
    pass_prepared_operand(code, plan, slot(input), input_chain);
    command(code, plan, invoke_function(), plan.function_base + facts[at].call_definition, slot(at), call_category(), call_site());
    propagate_invocation_failure(code, plan, state);
}

func lower_assignment(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                      plan:NativePlan in P, state:LoweringState in R, at:u64,
                      place:u64, input:u64, rebind:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (!rebind && facts[at].call_definition == no_node()) {
        lower_node(nodes, names, links, facts, sites, code, plan, state, place);
        if (!state.live) return;
        require_target(nodes, facts, sites, code, plan, state, place);
        if (!state.live) return;
        lower_bits(nodes, names, links, facts, sites, code, plan, state, input);
        if (!state.live) return;
        storage_operation(code, plan, store_target(), slot(place), slot(input), facts[place].reservation, place);
        emit(code, plan, copy_word(), slot(at), slot(place));
        return;
    };
    if (facts[place].kind == product_kind()) {
        lower_node(nodes, names, links, facts, sites, code, plan, state, place);
    } else {
        lower_place_address(nodes, names, links, facts, sites, code, plan, state, place);
    };
    if (!state.live || plan.diagnostic != 0u8) return;
    if (facts[at].call_definition != no_node()) {
        lower_transfer_call(nodes, names, links, facts, sites, code, plan, state, at, slot(place), input);
        return;
    };
    lower_node(nodes, names, links, facts, sites, code, plan, state, input);
    if (!state.live || plan.diagnostic != 0u8) return;
    storage_operation(code, plan, store_target(), slot(place), slot(input), text_place_reservation(nodes, names, place, state.syntax_revision, state.syntax_used), place);
    emit(code, plan, copy_word(), slot(at), slot(input));
}

func native_arithmetic(operation:ArithmeticOperation) -> u8 {
    return case operation of {
        (Addition) -> { checked_add() };
        (Subtraction) -> { checked_subtract() };
        (Multiplication) -> { checked_multiply() };
        (Division) -> { checked_divide() };
        (Remainder) -> { checked_remainder() };
    };
}

func native_relation(relation:ComparisonRelation) -> u64 {
    return case relation of {
        (Equal) -> { equal_words() };
        (Unequal) -> { unequal_words() };
        (Less) -> { less_words() };
        (AtMost) -> { at_most_words() };
        (Greater) -> { greater_words() };
        (AtLeast) -> { at_least_words() };
    };
}

func lower_arithmetic(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                      output:u64, left:u64, right:u64, operation:ArithmeticOperation,
                      operator_at:u64)
    -> void where {owner C, owner P, owner R} {
    command(code, plan, native_arithmetic(operation), output, left, right, arithmetic_fault());
    val ready <- new_block(plan);
    val failed <- new_block(plan);
    command(code, plan, branch_equal(), arithmetic_fault(), 0u64, ready, failed);
    position(code, plan, state, failed);
    command(code, plan, copy_completion(), pending_category(), arithmetic_fault(), 1u64, 0u64);
    emit(code, plan, source_site(), pending_site(), operator_at);
    finish_block(code, plan, state, state.exception_target);
    position(code, plan, state, ready);
    return
}

func lower_augmented_transfer(
    nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
    facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
    plan:NativePlan in P, state:LoweringState in R, at:u64,
    transfer:const AugmentedTransferSites in U)
    -> void where {const owner N, const owner B, const owner L, const owner F, const owner S,
                   owner C, owner P, owner R, const owner U} {
    val destination <- transfer.destination;
    val input <- transfer.input;
    lower_node(nodes, names, links, facts, sites, code, plan, state, destination);
    if (!state.live || plan.diagnostic != 0u8) return;
    require_target(nodes, facts, sites, code, plan, state, destination);
    if (!state.live) return;
    val left <- new_slot(plan);
    val place <- slot(destination);
    val reserved <- facts[destination].reservation;
    storage_operation(code, plan, load_target(), left, place, reserved, destination);
    lower_bits(nodes, names, links, facts, sites, code, plan, state, input);
    if (!state.live || plan.diagnostic != 0u8) return;
    val output <- slot(at);
    lower_arithmetic(code, plan, state, output, left, slot(input),
                     transfer.operation, transfer.operator_at);
    storage_operation(code, plan, store_target(), place, output, reserved, destination);
    emit(code, plan, copy_word(), output, place);
    return
}

func lower_binary(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                  facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                  plan:NativePlan in P, state:LoweringState in R, at:u64, operands:const BinarySites in I, compare:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner I} {
    val left <- operands.left_operand;
    val right <- operands.right_operand;
    lower_bits(nodes, names, links, facts, sites, code, plan, state, left);
    if (!state.live) return;
    lower_bits(nodes, names, links, facts, sites, code, plan, state, right);
    if (!state.live) return;
    if (compare) {
        command(code, plan, compare_words(), slot(at), slot(left), slot(right), native_relation(operands.relation));
        return;
    } else {};
    lower_arithmetic(code, plan, state, slot(at), slot(left), slot(right),
                     operands.arithmetic, operands.operator_at);
    return
}

func lower_logical(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                   plan:NativePlan in P, state:LoweringState in R, at:u64, left:u64, right:u64, negate:bool, conjunction:bool, policy:RhsEvaluation) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    lower_bits(nodes, names, links, facts, sites, code, plan, state, left);
    if (!state.live || plan.diagnostic != 0u8) return;
    if (negate) {
        val zero <- new_slot(plan);
        emit(code, plan, word_constant(), zero, 0u64);
        command(code, plan, compare_words(), slot(at), slot(left), zero, equal_words());
        return;
    } else {};
    if (policy != ConditionalRhs) {
        if (policy == SkipsRhs) {
            emit(code, plan, copy_word(), slot(at), slot(left));
        } else {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, right);
            if (state.live) { emit(code, plan, copy_word(), slot(at), slot(right)); } else {};
        };
        return;
    } else {};
    val selected <- new_block(plan);
    val skipped <- new_block(plan);
    val joined <- new_block(plan);
    val on_false <- if (conjunction) { skipped } else { selected };
    val on_true <- if (conjunction) { selected } else { skipped };
    command(code, plan, branch_equal(), slot(left), 0u64, on_false, on_true);
    position(code, plan, state, selected);
    lower_bits(nodes, names, links, facts, sites, code, plan, state, right);
    if (state.live) {
        emit(code, plan, copy_word(), slot(at), slot(right));
        finish_block(code, plan, state, joined);
    } else {};
    position(code, plan, state, skipped);
    emit(code, plan, copy_word(), slot(at), slot(left));
    finish_block(code, plan, state, joined);
    position(code, plan, state, joined);
}

func lower_list(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                plan:NativePlan in P, state:LoweringState in R, container:u64, sequence:SequenceSyntax, destination:u64, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref item = make u64 { no_node() };
    ref tail = make u64 { no_node() };
    if (sequence == ModuleSequence) {
        if (!first_module_item(nodes, state.syntax_revision, state.syntax_used, container, item)) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
    } else {
        if (!block_tail(nodes, state.syntax_revision, state.syntax_used, container, tail) ||
            !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, BlockSequence, item)) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
    };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val expression <- no_node();
    val discarded_reservation <- false;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node() || !state.live || plan.diagnostic != 0u8) return;
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != sequence) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        expression <- entry.item;
        discarded_reservation <- reserves_storage(nodes, state.syntax_revision, state.syntax_used, expression) && (item != tail || destination == no_node());
        if (!discarded_reservation && scalar_kind(facts[item].kind) && facts[item].discarded_result == 0u8) {
            if (facts[item].arm_result != 0u8 && !(read_result && item == tail)) {
                lower_node(nodes, names, links, facts, sites, code, plan, state, expression);
            } else {
                lower_bits(nodes, names, links, facts, sites, code, plan, state, expression);
            };
            if (state.live && item == tail && destination != no_node()) {
                emit(code, plan, copy_word(), destination, slot(expression));
            } else {};
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, expression);
        };
        item <- links[item].next;
    };
}

func prepare_result_arm(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                        facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                        plan:NativePlan in P, state:LoweringState in R,
                        arm:u64, at:u64, destination:u64, read_result:bool) -> bool
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val used <- scalar_kind(facts[at].kind) && facts[at].discarded_result == 0u8;
    val has_result <- used && scalar_kind(facts[arm].kind);
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    ref cases = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (has_result && facts[at].reception == independent_value() &&
        (inspect_conditional(nodes, state.syntax_revision, state.syntax_used, at, branch) ||
         inspect_case(nodes, state.syntax_revision, state.syntax_used, at, cases))) {
        # An independent join reads a selected target after the arm completes.
        lower_completed_bits(nodes, names, links, facts, sites, code, plan, state, arm);
    } else {
        if (has_result && read_result) {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, arm);
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, arm);
        };
    };
    if (!state.live || plan.diagnostic != 0u8) return false;
    if (used) { emit(code, plan, copy_word(), destination, slot(arm)); } else {};
    return true;
}

func lower_result_arm(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                      plan:NativePlan in P, state:LoweringState in R,
                      arm:u64, at:u64, next:u64, read_result:bool) -> bool
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (!prepare_result_arm(nodes, names, links, facts, sites, code, plan, state, arm, at, slot(at), read_result))
        return false;
    finish_block(code, plan, state, next);
    return true;
}

func lower_conditional(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, at:u64, branch:const ConditionalSites in I, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner I} {
    val condition <- branch.test;
    lower_bits(nodes, names, links, facts, sites, code, plan, state, condition);
    if (!state.live || plan.diagnostic != 0u8) return;
    val yes <- new_block(plan);
    val no <- new_block(plan);
    val joined <- new_block(plan);
    command(code, plan, branch_equal(), slot(condition), 0u64, no, yes);
    position(code, plan, state, yes);
    val yes_continues <- lower_result_arm(nodes, names, links, facts, sites, code, plan, state,
                                         branch.consequent, at, joined, read_result);
    position(code, plan, state, no);
    val no_continues <- lower_result_arm(nodes, names, links, facts, sites, code, plan, state,
                                        branch.alternative, at, joined, read_result);
    if (yes_continues || no_continues) { position(code, plan, state, joined); } else {};
}

func lower_case_arm(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                     plan:NativePlan in P, state:LoweringState in R, arm:u64, subject:u64, syntax:const CaseArmSites in I) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner I} {
    val mode <- facts[arm].case_match;
    val pattern <- syntax.pattern;
    val loads_target <- facts[arm].case_discriminator != 0u8 && facts[subject].reception != independent_value();
    val test_presence <- loads_target && facts[arm].case_may_be_absent != 0u8;
    val next <- if (mode != misses_case_arm() || test_presence) { new_block(plan) } else { no_node() };
    val discriminator <- slot(subject);
    if (loads_target) {
        if (test_presence) {
            val present <- new_block(plan);
            command(code, plan, branch_on_flow_flag(), state.case_present_flag, 0u64, next, present);
            position(code, plan, state, present);
        } else {};
        # Read the current bits through the saved address only on a present path.
        discriminator <- slot(arm);
        storage_operation(code, plan, load_target(), discriminator, slot(subject), facts[subject].reservation, pattern);
    } else {};
    if (mode == misses_case_arm()) {
        if (test_presence) {
            finish_block(code, plan, state, next);
            position(code, plan, state, next);
        } else {};
        return;
    } else {};

    val resumes <- mode == tests_case_arm();
    if (resumes) {
        val matched <- new_block(plan);
        if (case_pattern(nodes, state.syntax_used, pattern) == NullCaseTarget) {
            command(code, plan, branch_on_flow_flag(), state.case_present_flag, 0u64, matched, next);
        } else {
            command(code, plan, branch_equal(), discriminator, facts[pattern].discriminator_code, matched, next);
        };
        position(code, plan, state, matched);
    } else {};
    val guard <- syntax.guard;
    if (guard != no_node()) {
        lower_bits(nodes, names, links, facts, sites, code, plan, state, guard);
        if (plan.diagnostic != 0u8) return;
        if (state.live) {
            val behavior <- facts[arm].case_guard;
            if (behavior == case_guard_tests()) {
                val body <- new_block(plan);
                command(code, plan, branch_equal(), slot(guard), 0u64, next, body);
                position(code, plan, state, body);
                (resumes <- true):void;
            } else {
                if (behavior == case_guard_declines()) {
                    finish_block(code, plan, state, next);
                    (resumes <- true):void;
                } else {
                    if (behavior != case_guard_passes()) {
                        plan.diagnostic <- unproved_callable_completion();
                        return;
                    } else {};
                };
            };
        } else {};
    } else {};
    state.case_arm <- arm;
    state.case_next <- next;
    state.case_resumed <- false;
    if (state.live && lower_result_arm(nodes, names, links, facts, sites, code, plan, state,
                                        syntax.body, state.case_index, state.case_join, state.case_read)) {
        (state.case_completed <- true):void;
    } else {};
    if (resumes || state.case_resumed) { position(code, plan, state, next); } else {};
}

func lower_case_items(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, choice:const CaseSites in I) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner I} {
    ref item = make u64 { no_node() };
    if (!first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, choice.items, BlockSequence, item)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
    val expression <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node() || !state.live || plan.diagnostic != 0u8) return;
        if (facts[item].case_item == unreachable_case_item()) {
            plan.diagnostic <- unproved_callable_completion();
            return;
        } else {};
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != BlockSequence) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        expression <- entry.item;
        if (inspect_case_arm(nodes, state.syntax_revision, state.syntax_used, expression, arm)) {
            lower_case_arm(nodes, names, links, facts, sites, code, plan, state, expression, choice.subject, arm);
        } else {
            if (scalar_kind(facts[item].kind) && !reserves_storage(nodes, state.syntax_revision, state.syntax_used, expression)) {
                lower_bits(nodes, names, links, facts, sites, code, plan, state, expression);
            } else { lower_node(nodes, names, links, facts, sites, code, plan, state, expression); };
        };
        item <- links[item].next;
    };
}

# Publish the saved address's presence once. Later flags name that same
# decision, including when initialization proof follows a fallthrough.
func lower_case_presence(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R, subject:u64) -> u64
    where {owner C, owner P, owner R} {
    val flag <- new_slot(plan);
    val absent <- new_block(plan);
    val present <- new_block(plan);
    val ready <- new_block(plan);
    command(code, plan, branch_equal(), slot(subject), 0u64, absent, present);
    position(code, plan, state, absent);
    emit(code, plan, write_flow_flag(), flag, 0u64);
    finish_block(code, plan, state, ready);
    position(code, plan, state, present);
    emit(code, plan, write_flow_flag(), flag, 1u64);
    finish_block(code, plan, state, ready);
    position(code, plan, state, ready);
    return flag;
}

func lower_case(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                 plan:NativePlan in P, state:LoweringState in R, at:u64, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref choice = make CaseSites { subject <- no_node(); items <- no_node(); };
    if (!inspect_case(nodes, state.syntax_revision, state.syntax_used, at, choice)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val subject <- choice.subject;
    lower_node(nodes, names, links, facts, sites, code, plan, state, subject);
    if (!state.live || plan.diagnostic != 0u8) return;
    val outer_index <- state.case_index;
    val outer_join <- state.case_join;
    val outer_arm <- state.case_arm;
    val outer_next <- state.case_next;
    val outer_presence <- state.case_present_flag;
    val outer_read <- state.case_read;
    val outer_completed <- state.case_completed;
    val outer_resumed <- state.case_resumed;
    val joined <- new_block(plan);
    state.case_index <- at;
    state.case_join <- joined;
    state.case_arm <- no_node();
    state.case_next <- no_node();
    state.case_present_flag <- if (selected_target_presence(facts, subject) == unknown_target()) {
        lower_case_presence(code, plan, state, subject)
    } else { no_node() };
    state.case_read <- read_result;
    state.case_completed <- false;
    state.case_resumed <- false;
    lower_case_items(nodes, names, links, facts, sites, code, plan, state, choice);
    if (plan.diagnostic != 0u8) return;
    val normal <- state.live;
    if (normal && facts[at].case_end == 0u8) {
        plan.diagnostic <- unproved_callable_completion();
        return;
    } else {};
    val joins <- state.case_completed;
    state.case_index <- outer_index;
    state.case_join <- outer_join;
    state.case_arm <- outer_arm;
    state.case_next <- outer_next;
    state.case_present_flag <- outer_presence;
    state.case_read <- outer_read;
    state.case_completed <- outer_completed;
    state.case_resumed <- outer_resumed;
    if (normal && joins) { finish_block(code, plan, state, joined); } else {};
    if (joins) { position(code, plan, state, joined); } else {};
}

func deliver_case_break(names:const NameBindings in B, code:NativeCommands in C, plan:NativePlan in P,
                        state:LoweringState in R, value:u64) -> void
    where {const owner B, owner C, owner P, owner R} {
    val target <- state.case_index;
    if (names[target].finalizer != state.finalizer) {
        if (value != no_node() && value != state.break_value) {
            emit(code, plan, copy_word(), state.break_value, value);
        } else {};
        state.pending_break <- true;
        finish_block(code, plan, state, state.break_landing);
        return;
    } else {};
    if (value != no_node() && value != slot(target)) { emit(code, plan, copy_word(), slot(target), value); } else {};
    state.case_completed <- true;
    finish_block(code, plan, state, state.case_join);
}

func deliver_case_scan(nodes:const ExprNodes in N, names:const NameBindings in B,
                       code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R) -> void
    where {const owner N, const owner B, owner C, owner P, owner R} {
    val arm <- state.case_arm;
    if (names[arm].finalizer != state.finalizer) {
        state.pending_scan <- true;
        finish_block(code, plan, state, state.scan_landing);
        return;
    } else {};
    ref selected = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    if (state.scope_scan_flag != no_node() &&
        inspect_case_arm(nodes, state.syntax_revision, state.syntax_used, arm, selected) && selected.body == state.active_scope) {
        state.scope_scan_pending <- true;
        emit(code, plan, write_flow_flag(), state.scope_scan_flag, 1u64);
        finish_block(code, plan, state, state.scope_cleanup);
        return;
    } else {};
    state.case_resumed <- true;
    finish_block(code, plan, state, state.case_next);
}

func lower_case_break(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val target <- names[at].declaration;
    if (target == no_node() || target != state.case_index) {
        plan.diagnostic <- native_unsupported();
        return;
    } else {};
    ref value = make u64 { no_node() };
    if (!completion_operand(nodes, state.syntax_revision, state.syntax_used, at, value)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val guarded <- names[target].finalizer != state.finalizer;
    val result <- if (guarded) { state.break_value } else { slot(target) };
    if (value != no_node() &&
        !prepare_result_arm(nodes, names, links, facts, sites, code, plan, state, value, target, result, state.case_read))
        return;
    val used <- value != no_node() && scalar_kind(facts[target].kind) && facts[target].discarded_result == 0u8;
    deliver_case_break(names, code, plan, state, if (used) { result } else { no_node() });
}

func lower_range(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                 plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref loop = make RangeSites { header <- no_node(); body <- no_node(); empty <- no_node(); };
    ref bounds = make RangeBounds { index_binding <- no_node(); lower <- no_node(); upper <- no_node(); separator <- 0u64; };
    if (!inspect_range_loop(nodes, state.syntax_revision, state.syntax_used, at, loop) ||
        !inspect_range_header(nodes, state.syntax_revision, state.syntax_used, loop.header, bounds)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val start <- bounds.lower;
    val limit <- bounds.upper;
    lower_bits(nodes, names, links, facts, sites, code, plan, state, start);
    if (!state.live || plan.diagnostic != 0u8) return;
    lower_bits(nodes, names, links, facts, sites, code, plan, state, limit);
    if (!state.live || plan.diagnostic != 0u8) return;

    val empty <- loop.empty;
    val shape <- classify_literal_range(nodes, state.syntax_revision, state.syntax_used, loop.header);
    if (shape == InvalidRange) { plan.diagnostic <- invalid_native_module(); return; };
    val literal <- shape == NonemptyLiteralRange;
    if (shape == EmptyLiteralRange) {
        if (empty != no_node()) { lower_node(nodes, names, links, facts, sites, code, plan, state, empty); } else {};
        return;
    } else {};

    val index <- slot(loop.header);
    val condition <- slot(at);
    val body <- new_block(plan);
    val done <- new_block(plan);
    val otherwise <- if (!literal && empty != no_node()) { new_block(plan) } else { done };
    val one <- new_slot(plan);
    emit(code, plan, word_constant(), one, 1u64);
    emit(code, plan, copy_word(), index, slot(start));
    if (literal) {
        finish_block(code, plan, state, body);
    } else {
        command(code, plan, compare_words(), condition, index, slot(limit), less_words());
        command(code, plan, branch_equal(), condition, 0u64, otherwise, body);
    };
    position(code, plan, state, body);
    lower_node(nodes, names, links, facts, sites, code, plan, state, loop.body);
    if (plan.diagnostic != 0u8) return;
    val body_continues <- state.live;
    if (body_continues) {
        # The entry test proves index < limit <= max(u64). The step cannot overflow.
        command(code, plan, checked_add(), index, index, one, arithmetic_fault());
        command(code, plan, compare_words(), condition, index, slot(limit), less_words());
        command(code, plan, branch_equal(), condition, 0u64, done, body);
        state.live <- false;
        {};
    } else {};

    val empty_continues <- !literal && empty == no_node();
    if (otherwise != done) {
        position(code, plan, state, otherwise);
        lower_node(nodes, names, links, facts, sites, code, plan, state, empty);
        if (plan.diagnostic != 0u8) return;
        empty_continues <- state.live;
        if (empty_continues) { finish_block(code, plan, state, done); } else {};
    } else {};
    if (body_continues || empty_continues) { position(code, plan, state, done); } else {};
}

func lower_handlers(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                    facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                    plan:NativePlan in P, state:LoweringState in R, at:u64, first:u64, next:u64, read_result:bool) -> bool
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val normal <- false;
    val clause <- first;
    ref selected = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    if (inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, clause, selected) != HandlerClause) return false;
    lower_dispatch(nodes, links, facts, code, plan, state, at, first);
    val enclosing_failure <- state.caught_failure;
    val handler <- no_node();
    ref caught = make HandlerSites { binding <- no_node(); body <- no_node(); };
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (plan.diagnostic != 0u8 ||
            inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, clause, selected) != HandlerClause) return normal;
        handler <- selected.target;
        if (!inspect_handler(nodes, state.syntax_revision, state.syntax_used, handler, caught)) {
            plan.diagnostic <- invalid_native_module();
            return false;
        };
        position(code, plan, state, handler);
        state.caught_failure <- if (sites[handler].retains_caught != 0u8) { save_failure(code, plan) } else { no_node() };
        emit(code, plan, word_constant(), pending_category(), 0u64);
        if (lower_result_arm(nodes, names, links, facts, sites, code, plan, state,
                             caught.body, at, next, read_result)) {
            (normal <- true):void;
        } else {};
        state.caught_failure <- enclosing_failure;
        clause <- links[clause].next;
    };
    return normal;
}

func enter_finalizer(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                     entry:u64, reason:u64, kind:u64, finalizer:u64) -> void
    where {owner C, owner P, owner R} {
    position(code, plan, state, entry);
    emit(code, plan, write_flow_flag(), reason, kind);
    finish_block(code, plan, state, finalizer);
}

func match_finalizer_exit(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                          reason:u64, kind:u64, destination:u64) -> void where {owner C, owner P, owner R} {
    val rest <- new_block(plan);
    command(code, plan, branch_on_flow_flag(), reason, kind, destination, rest);
    position(code, plan, state, rest);
}

func lower_try(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
               facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
               plan:NativePlan in P, state:LoweringState in R, at:u64, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    ref protected = make ProtectedSites { body <- no_node(); clauses <- no_node(); discarded <- false; };
    ref first = make u64 { no_node() };
    if (!inspect_protected(nodes, state.syntax_revision, state.syntax_used, at, protected) ||
        !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, protected.clauses, ClauseSequence, first)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val last <- protected.clauses;
    ref closing = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    ref opening = make GuardClauseSites { target <- no_node(); previous <- no_node(); };
    val has_finally <- inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, last, closing) == CleanupClause;
    val has_catches <- inspect_guard_clause(nodes, state.syntax_revision, state.syntax_used, first, opening) == HandlerClause;
    val outer_exception <- state.exception_target;
    val outer_return <- state.return_target;
    val outer_slot <- state.return_slot;
    val returned_earlier <- state.local_return;
    val outer_finalizer <- state.finalizer;
    val outer_break <- state.break_landing;
    val outer_value <- state.break_value;
    val outer_scan <- state.scan_landing;
    val earlier_break <- state.pending_break;
    val earlier_scan <- state.pending_scan;
    val join <- new_block(plan);
    val after_arm <- join;
    val on_failure <- outer_exception;
    val on_return <- no_node();
    val prepared <- no_node();
    val on_break <- no_node();
    val prepared_break <- no_node();
    val on_scan <- no_node();
    val reason <- no_node();
    if (has_finally) {
        after_arm <- new_block(plan);
        on_failure <- new_block(plan);
        on_return <- new_block(plan);
        reason <- new_slot(plan);
        if (sites[at].case_break != 0u8) {
            on_break <- new_block(plan);
            val target <- state.case_index;
            if (scalar_kind(facts[target].kind) && facts[target].discarded_result == 0u8) {
                (prepared_break <- new_slot(plan)):void;
            } else {};
        } else {};
        if (sites[at].case_scan != 0u8) { (on_scan <- new_block(plan)):void; } else {};
        state.finalizer <- at;
        state.break_landing <- on_break;
        state.break_value <- prepared_break;
        state.scan_landing <- on_scan;
        state.pending_break <- false;
        state.pending_scan <- false;
        state.return_target <- on_return;
        # The guard keeps prepared payloads private until finally preserves them.
        if (outer_slot != no_node()) {
            prepared <- new_slot(plan);
            (state.return_slot <- prepared):void;
        } else {};
        state.local_return <- false;
        emit(code, plan, write_flow_flag(), reason, 0u64);
    } else {};
    state.exception_target <- if (has_catches) { at } else { on_failure };
    val body <- lower_result_arm(nodes, names, links, facts, sites, code, plan, state, protected.body, at, after_arm, read_result);
    state.exception_target <- on_failure;
    val handled <- lower_handlers(nodes, names, links, facts, sites, code, plan, state, at, first, after_arm, read_result);
    state.exception_target <- outer_exception;
    state.return_target <- outer_return;
    state.return_slot <- outer_slot;
    val normal <- body || handled;
    if (has_finally) {
        val pending_return <- state.local_return;
        val pending_break <- state.pending_break;
        val pending_scan <- state.pending_scan;
        state.local_return <- returned_earlier;
        state.finalizer <- outer_finalizer;
        state.break_landing <- outer_break;
        state.break_value <- outer_value;
        state.scan_landing <- outer_scan;
        state.pending_break <- earlier_break;
        state.pending_scan <- earlier_scan;
        enter_finalizer(code, plan, state, on_failure, reason, 1u64, after_arm);
        enter_finalizer(code, plan, state, on_return, reason, 2u64, after_arm);
        if (pending_break) { enter_finalizer(code, plan, state, on_break, reason, 3u64, after_arm); } else {};
        if (pending_scan) { enter_finalizer(code, plan, state, on_scan, reason, 4u64, after_arm); } else {};
        position(code, plan, state, after_arm);
        val saved <- save_failure(code, plan);
        emit(code, plan, word_constant(), pending_category(), 0u64);
        lower_node(nodes, names, links, facts, sites, code, plan, state, closing.target);
        if (!state.live || plan.diagnostic != 0u8) return;
        restore_failure(code, plan, saved);

        val forward_to <- if (prepared != no_node()) { new_block(plan) } else { outer_return };
        val resume_break <- if (pending_break) { new_block(plan) } else { no_node() };
        val resume_scan <- if (pending_scan) { new_block(plan) } else { no_node() };
        match_finalizer_exit(code, plan, state, reason, 1u64, outer_exception);
        match_finalizer_exit(code, plan, state, reason, 2u64, forward_to);
        if (pending_break) { match_finalizer_exit(code, plan, state, reason, 3u64, resume_break); } else {};
        if (pending_scan) { match_finalizer_exit(code, plan, state, reason, 4u64, resume_scan); } else {};
        finish_block(code, plan, state, if (normal) { join } else { outer_exception });
        forward_return(code, plan, state, forward_to, outer_return, prepared, no_node());
        state.local_return <- state.local_return || pending_return;
        if (pending_break) {
            position(code, plan, state, resume_break);
            deliver_case_break(names, code, plan, state, prepared_break);
        } else {};
        if (pending_scan) {
            position(code, plan, state, resume_scan);
            deliver_case_scan(nodes, names, code, plan, state);
        } else {};
    } else {};
    if (normal) { position(code, plan, state, join); } else {};
}

func lower_binding(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                   plan:NativePlan in P, state:LoweringState in R, at:u64, binding:const LocalBindingSites in I) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner I} {
    val initializer <- binding.initializer;
    if (binding.mode == ValueLocal) {
        if (reserves_storage(nodes, state.syntax_revision, state.syntax_used, initializer)) {
            storage_operation(code, plan, place_address(), slot(initializer), slot(at), initializer, initializer);
            return;
        } else {};
        lower_bits(nodes, names, links, facts, sites, code, plan, state, initializer);
    } else {
        lower_node(nodes, names, links, facts, sites, code, plan, state, initializer);
    };
    if (!state.live) return;
    if (binding.mode == ValueLocal) {
        emit(code, plan, copy_word(), slot(at), slot(initializer));
        return;
    } else {};
    if (facts[initializer].reception == independent_value()) {
        emit(code, plan, place_address(), slot(at), slot(initializer));
        return;
    } else {};
    if (binding.mode == ReferenceLocal) {
        storage_operation(code, plan, copy_word(), slot(at), slot(initializer), facts[initializer].reservation, initializer);
    } else { emit(code, plan, copy_word(), slot(at), slot(initializer)); };
}

func lower_construction(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                        facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                        plan:NativePlan in P, state:LoweringState in R, at:u64, reservation:bool,
                        construction:const ConstructionSites in K) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R, const owner K} {
    if (facts[at].allocation_owner != no_node()) {
        ref argument = make SequenceEntry { previous <- no_node(); item <- no_node(); };
        if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, construction.contents, argument) !=
            ArgumentSequence || argument.previous != no_node()) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        val text_input <- argument.item;
        lower_node(nodes, names, links, facts, sites, code, plan, state, text_input);
        if (!state.live || plan.diagnostic != 0u8) return;
        val chain_address <- new_slot(plan);
        prepare_owner_address(nodes, facts, code, plan, facts[at].allocation_owner, chain_address, state.syntax_revision, state.syntax_used);
        command(code, plan, text_allocate(), slot(at), slot(text_input), chain_address, 0u64);
        guard_word(code, plan, state, slot(at), true, out_of_memory_identity(), syntax_first(nodes, state.syntax_used, at));
        return;
    };
    val body <- construction.contents;
    val words <- facts[at].product_words;
    if (words != 0u64) {
        emit(code, plan, allocate_words(), slot(at), words);
        ref tail = make u64 { no_node() };
        ref item = make u64 { no_node() };
        if (!block_tail(nodes, state.syntax_revision, state.syntax_used, body, tail) ||
            !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, tail, BlockSequence, item)) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        ref entry = make SequenceEntry { previous <- no_node(); item <- no_node(); };
        val assignment <- no_node();
        ref operands = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
        val input <- no_node();
        for (unused in 0u64 .. syntax_len(nodes)) {
            if (item == no_node() || !state.live || plan.diagnostic != 0u8) return;
            if (inspect_sequence_entry(nodes, state.syntax_revision, state.syntax_used, item, entry) != BlockSequence) {
                plan.diagnostic <- invalid_native_module();
                return;
            };
            assignment <- entry.item;
            if (inspect_assignment(nodes, state.syntax_revision, state.syntax_used, assignment, operands) != FieldTransfer) {
                plan.diagnostic <- invalid_native_module();
                return;
            };
            input <- operands.input;
            command(code, plan, offset_address(), slot(assignment), slot(at), facts[assignment].word_offset, 0u64);
            if (facts[assignment].call_definition != no_node()) {
                lower_transfer_call(nodes, names, links, facts, sites, code, plan, state, assignment, slot(assignment), input);
            } else {
                lower_bits(nodes, names, links, facts, sites, code, plan, state, input);
                if (!state.live) return;
                emit(code, plan, store_target(), slot(assignment), slot(input));
            };
            (item <- links[item].next):void;
        };
        return;
    };
    # The payload row supplies storage indexed separately from the result address.
    val storage <- slot(construction.initializer);
    if (reservation) {
        storage_operation(code, plan, place_address(), slot(at), storage, at, at);
        return;
    } else {};
    lower_bits(nodes, names, links, facts, sites, code, plan, state, body);
    if (!state.live) return;
    emit(code, plan, copy_word(), storage, slot(body));
    emit(code, plan, place_address(), slot(at), storage);
}

func lower_place_address(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                         plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (name_syntax(nodes, state.syntax_used, at) == OrdinaryName) {
        emit(code, plan, copy_word(), slot(at), slot(names[at].declaration));
        return;
    };
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (!inspect_field_selection(nodes, state.syntax_revision, state.syntax_used, at, selection)) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val receiver <- selection.receiver;
    lower_node(nodes, names, links, facts, sites, code, plan, state, receiver);
    if (state.live) {
        command(code, plan, offset_address(), slot(at), slot(receiver), facts[at].word_offset, 0u64);
    };
}

func text_place_reservation(nodes:const ExprNodes in N, names:const NameBindings in B, at:u64, revision:u64, used:u64) -> u64
    where {const owner N, const owner B} {
    val declaration <- names[at].declaration;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    if (name_syntax(nodes, used, at) == OrdinaryName &&
        inspect_formal(nodes, revision, used, declaration, formal) == OrdinaryFormal &&
        formal.mode == InitializingPlaceFormal) return declaration;
    return no_node();
}

func lower_return(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                  facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                  plan:NativePlan in P, state:LoweringState in R, at:u64, value:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (value != no_node()) {
        if (state.return_slot != no_node() && facts[names[at].scope].reception != borrowed_ref()) {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, value);
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, value);
        };
        if (!state.live) return;
        if (state.return_slot != no_node()) {
            emit(code, plan, copy_word(), state.return_slot, slot(value));
        };
    };
    state.local_return <- true;
    emit(code, plan, word_constant(), pending_category(), 0u64);
    finish_block(code, plan, state, state.return_target);
}

func lower_bound_name(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                       plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val declaration <- names[at].declaration;
    if (!scalar_kind(facts[at].kind) && facts[at].kind != product_kind() && !immutable_text_kind(facts[at].kind)) { plan.diagnostic <- native_unsupported(); return; };
    if (declaration != no_node() && names[declaration].guarded_local != 0u8) {
        storage_operation(code, plan, use_local(), 0u64, 0u64, declaration, at);
    } else {};
    if (facts[at].writable_text_place != 0u8) {
        lower_place_address(nodes, names, links, facts, sites, code, plan, state, at);
        if (facts[at].discarded_result == 0u8) {
            storage_operation(code, plan, load_target(), slot(at), slot(at), text_place_reservation(nodes, names, at, state.syntax_revision, state.syntax_used), at);
        };
        return;
    };
    val opcode <- if (facts[at].reception == local_place()) { place_address() } else { copy_word() };
    emit(code, plan, opcode, slot(at), slot(declaration));
    return;
}

func lower_group(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                 plan:NativePlan in P, state:LoweringState in R, at:u64, inside:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val used <- (scalar_kind(facts[at].kind) || immutable_text_kind(facts[at].kind)) &&
        facts[at].discarded_result == 0u8;
    val projects_reservation <- facts[inside].reservation != no_node();
    if ((used || projects_reservation) && facts[at].reception != nullable_ptr() &&
        !immutable_text_kind(facts[at].kind)) {
        lower_bits(nodes, names, links, facts, sites, code, plan, state, inside);
    } else {
        lower_node(nodes, names, links, facts, sites, code, plan, state, inside);
    };
    if (state.live && used) { emit(code, plan, copy_word(), slot(at), slot(inside)); };
}

func lower_block_expression(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                             facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                             plan:NativePlan in P, state:LoweringState in R, at:u64, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val destination <- if (scalar_kind(facts[at].kind) && facts[at].discarded_result == 0u8) { slot(at) } else { no_node() };
    lower_list(nodes, names, links, facts, sites, code, plan, state, at, BlockSequence, destination, read_result);
}

func lower_assertion(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                     facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                     plan:NativePlan in P, state:LoweringState in R, at:u64, operand:u64, colon:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (facts[at].enum_constant != 0u8) {
        emit(code, plan, word_constant(), slot(at), facts[at].discriminator_code);
        return;
    };
    lower_node(nodes, names, links, facts, sites, code, plan, state, operand);
    if (!state.live) return;
    if (facts[at].text_assertion != 0u8) {
        val contains <- new_slot(plan);
        emit(code, plan, text_contains_nul(), contains, slot(operand));
        guard_word(code, plan, state, contains, false, type_assertion_failed_identity(), colon);
    };
    emit(code, plan, copy_word(), slot(at), slot(operand));
}

func lower_case_fallthrough(nodes:const ExprNodes in N, names:const NameBindings in B, code:NativeCommands in C,
                            plan:NativePlan in P, state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, owner C, owner P, owner R} {
    if (names[at].declaration != state.case_arm || state.case_next == no_node()) {
        plan.diagnostic <- native_unsupported();
        return;
    };
    deliver_case_scan(nodes, names, code, plan, state);
}

func lower_caught_raise(code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R) -> void
    where {owner C, owner P, owner R} {
    if (state.caught_failure == no_node()) { plan.diagnostic <- native_unsupported(); return; };
    restore_failure(code, plan, state.caught_failure);
    finish_block(code, plan, state, state.exception_target);
}

func lower_expression(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                      plan:NativePlan in P, state:LoweringState in R, at:u64, read_result:bool) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (!state.live || plan.diagnostic != 0u8) return;
    if (at >= state.syntax_used) { plan.diagnostic <- invalid_native_module(); return; };
    plan.node <- at;
    case nodes[at] of {
        (Vacant) -> { plan.diagnostic <- invalid_native_module(); return; };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (Parenthesized { val expression <- expression; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, expression)) {
                        plan.diagnostic <- invalid_native_module();
                        return;
                    };
                    lower_group(nodes, names, links, facts, sites, code, plan, state, at, expression.index);
                    return;
                };
                (RangeLoop) -> {
                    lower_range(nodes, names, links, facts, sites, code, plan, state, at);
                    return;
                };
                (NameReference) -> {
                    lower_bound_name(nodes, names, links, facts, sites, code, plan, state, at);
                    return;
                };
                (ModuleSelection) -> { return; };
                DefaultPublicSet -> { return; };
                BulkModuleSelection -> { return; };
                (CallableDefinition) -> { return; };
                (EnumDefinition) -> { return; };
                (RecordDefinition) -> { return; };
                (Publication) -> { return; };
                (TextLiteral) -> {
                    command(code, plan, text_literal(), slot(at), syntax.span.first, syntax.span.past, 0u64);
                    return;
                };
                (NullLiteral) -> { emit(code, plan, word_constant(), slot(at), 0u64); return; };
                (BlockSyntax) -> {
                    lower_block_expression(nodes, names, links, facts, sites, code, plan, state, at, read_result);
                    return;
                };
                (ScopeSyntax) -> { lower_full_scope(nodes, names, links, facts, sites, code, plan, state, at); return; };
                (DiscardedExpression { val operand <- operand; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, operand)) {
                        plan.diagnostic <- invalid_native_module();
                        return;
                    };
                    lower_node(nodes, names, links, facts, sites, code, plan, state, operand.index);
                    return;
                };
                (CheckedTypeAssertion { val operand <- operand; val colon <- colon; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, at, operand)) {
                        plan.diagnostic <- invalid_native_module();
                        return;
                    };
                    lower_assertion(nodes, names, links, facts, sites, code, plan, state, at, operand.index, colon);
                    return;
                };
                (ProtectedBlock) -> { lower_try(nodes, names, links, facts, sites, code, plan, state, at, read_result); return; };
                (CaseExpression) -> { lower_case(nodes, names, links, facts, sites, code, plan, state, at, read_result); return; };
                (BreakValue) -> { lower_case_break(nodes, names, links, facts, sites, code, plan, state, at); return; };
                (BreakVoid) -> { lower_case_break(nodes, names, links, facts, sites, code, plan, state, at); return; };
                (CaseFallthrough) -> { lower_case_fallthrough(nodes, names, code, plan, state, at); return; };
                (CaseFailure) -> {
                    source_failure(code, plan, unexpected_case_identity(), syntax.span.first);
                    finish_block(code, plan, state, state.exception_target);
                    return;
                };
                (RaisePending) -> { lower_caught_raise(code, plan, state); return; };
                (RaiseValue) -> { lower_caught_raise(code, plan, state); return; };
                (BooleanLiteral { val truth <- truth; }) -> {
                    emit(code, plan, word_constant(), slot(at), if (truth) { 1u64 } else { 0u64 });
                    return;
                };
                (IntegerLiteral { val magnitude <- magnitude; }) -> {
                    emit(code, plan, word_constant(), slot(at), magnitude);
                    return;
                };
                (Call { val callee <- callee; val arguments <- argument_tail; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, callee) ||
                        !published_syntax_id(nodes, state.syntax_revision, state.syntax_used, arguments)) {
                        plan.diagnostic <- invalid_native_module(); return;
                    };
                    lower_call(nodes, names, links, facts, sites, code, plan, state, at, arguments.index, syntax.span.first, false);
                    return;
                };
                (EmptyCall { val callee <- callee; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, callee)) {
                        plan.diagnostic <- invalid_native_module(); return;
                    };
                    lower_call(nodes, names, links, facts, sites, code, plan, state, at, no_node(), syntax.span.first, false);
                    return;
                };
                (ReturnValue { val value <- value; }) -> {
                    if (!published_syntax_id(nodes, state.syntax_revision, state.syntax_used, value)) {
                        plan.diagnostic <- invalid_native_module(); return;
                    };
                    lower_return(nodes, names, links, facts, sites, code, plan, state, at, value.index);
                    return;
                };
                (ReturnVoid) -> {
                    lower_return(nodes, names, links, facts, sites, code, plan, state, at, no_node());
                    return;
                };
                () -> {};
            };
        };
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- 0u64; };
    val mode <- inspect_assignment(nodes, state.syntax_revision, state.syntax_used, at, assignment);
    if (mode == InvalidAssignment) { plan.diagnostic <- invalid_native_module(); return; };
    if (mode == AugmentedPlaceTransfer) {
        ref transfer = make AugmentedTransferSites {
            destination <- no_node(); input <- no_node(); operator_at <- 0u64; operation <- Addition
        };
        if (!inspect_augmented_transfer(nodes, state.syntax_revision, state.syntax_used,
                                        at, transfer)) {
            plan.diagnostic <- invalid_native_module();
            return
        };
        lower_augmented_transfer(nodes, names, links, facts, sites, code, plan, state,
                                 at, transfer);
        return
    };
    if (mode == PlaceTransfer || mode == PlaceRebind || mode == FieldTransfer) {
        lower_assignment(nodes, names, links, facts, sites, code, plan, state, at,
                         assignment.destination, assignment.input, mode == PlaceRebind);
        return;
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node();
    };
    val shape <- inspect_construction(nodes, state.syntax_revision, state.syntax_used, at, construction);
    if (shape == InvalidConstruction) { plan.diagnostic <- invalid_native_module(); return; };
    if (shape == StorageReservation || shape == PositionalConstruction || shape == BracedConstruction) {
        lower_construction(nodes, names, links, facts, sites, code, plan, state, at, shape == StorageReservation, construction);
        return;
    };
    ref logical = make LogicalSites {
        left_operand <- no_node(); right_operand <- no_node(); right_evaluation <- ConditionalRhs;
    };
    val operation <- inspect_logical(nodes, state.syntax_revision, state.syntax_used, at, logical);
    if (operation == InvalidLogical) { plan.diagnostic <- invalid_native_module(); return; };
    if (operation == LogicalNot || operation == LogicalAnd || operation == LogicalOr) {
        lower_logical(nodes, names, links, facts, sites, code, plan, state, at,
                      logical.left_operand, logical.right_operand, operation == LogicalNot,
                      operation == LogicalAnd, logical.right_evaluation);
        return;
    };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    if (inspect_invocation(nodes, state.syntax_revision, state.syntax_used, at, call) == EffectfulInvocation) {
        lower_call(nodes, names, links, facts, sites, code, plan, state, at, call.arguments,
                   syntax_first(nodes, state.syntax_used, at), true);
        return;
    };
    ref action = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    val defer_shape <- inspect_defer(nodes, state.syntax_revision, state.syntax_used, at, action);
    if (defer_shape == DeferCall) {
        val call_form <- inspect_invocation(nodes, state.syntax_revision, state.syntax_used, action.invocation, call);
        ref argument = make u64 { no_node() };
        if ((call_form != OrdinaryInvocation && call_form != EffectfulInvocation) ||
            !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, call.arguments, ArgumentSequence, argument)) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        prepare_arguments(nodes, names, links, facts, sites, code, plan, state, argument);
        if (state.live) { emit(code, plan, write_flow_flag(), slot(at), 1u64); };
        return;
    };
    if (defer_shape == DeferBody) {
        emit(code, plan, write_flow_flag(), slot(at), 1u64);
        return;
    };
    ref binding = make LocalBindingSites { binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false; };
    if (inspect_local_binding(nodes, state.syntax_revision, state.syntax_used, at, binding)) {
        if (binding.mode == ExceptionLocal) { plan.diagnostic <- native_unsupported(); return; };
        lower_binding(nodes, names, links, facts, sites, code, plan, state, at, binding);
        if (state.live && names[at].guarded_local != 0u8) {
            storage_operation(code, plan, bind_local(), 0u64, 0u64, at, at);
        };
        return;
    };
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node(); };
    if (inspect_field_selection(nodes, state.syntax_revision, state.syntax_used, at, selection)) {
        lower_place_address(nodes, names, links, facts, sites, code, plan, state, at);
        if (state.live && immutable_text_kind(facts[at].kind) && facts[at].discarded_result == 0u8) {
            emit(code, plan, load_target(), slot(at), slot(at));
        };
        return;
    };
    ref binary = make BinarySites {
        left_operand <- no_node(); right_operand <- no_node(); operator_at <- 0u64; arithmetic <- Addition; relation <- Equal;
    };
    val binary_form <- inspect_binary(nodes, state.syntax_revision, state.syntax_used, at, binary);
    if (binary_form == InvalidBinary) { plan.diagnostic <- invalid_native_module(); return; };
    if (binary_form == ArithmeticBinary || binary_form == ComparisonBinary) {
        lower_binary(nodes, names, links, facts, sites, code, plan, state, at, binary, binary_form == ComparisonBinary);
        return;
    };
    ref branch = make ConditionalSites { test <- no_node(); consequent <- no_node(); alternative <- no_node(); };
    if (inspect_conditional(nodes, state.syntax_revision, state.syntax_used, at, branch)) {
        lower_conditional(nodes, names, links, facts, sites, code, plan, state, at, branch, read_result);
        return;
    };
    plan.diagnostic <- native_unsupported();
    return;
}

func formal_owner_word(facts:const OperandFacts in F, formal:u64) -> u64 where {const owner F} {
    if (facts[formal].passes_owner == 0u8) return no_node();
    return facts[facts[formal].owner].owner_chain;
}

func callable_parameters(nodes:const ExprNodes in N, tree:const ParseResult in T, signature:u64,
                           first:u64 in R) -> bool where {const owner N, const owner T, owner R} {
    ref head = make u64 { no_node() };
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    return find_signature_clause(nodes, tree.revision, tree.used, signature, SignatureHead, head) &&
        inspect_signature(nodes, tree.revision, tree.used, head, sites) == SignatureHead &&
        first_sequence_entry(nodes, tree.revision, tree.used, sites.parameter_tail, FormalSequence, first);
}

func formal_count(links:const NameWork in L, facts:const OperandFacts in F, first:u64, used:u64) -> u64
    where {const owner L, const owner F} {
    val current <- first;
    val count <- 0u64;
    for (unused in 0u64 .. used) {
        if (current == no_node()) return count;
        count <- count + (if (formal_owner_word(facts, current) == no_node()) { 1u64 } else { 2u64 });
        current <- links[current].next;
    };
    return count;
}

func receive_formals(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                     code:NativeCommands in C, plan:NativePlan in P, state:const LoweringState in R, first:u64) -> void
    where {const owner N, const owner L, const owner F, owner C, owner P, const owner R} {
    val formal <- first;
    val index <- 0u64;
    val chain <- no_node();
    ref sites = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    for (unused in 0u64 .. state.syntax_used) {
        if (formal == no_node()) return;
        if (inspect_formal(nodes, state.syntax_revision, state.syntax_used, formal, sites) != OrdinaryFormal) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        emit(code, plan, receive_parameter(), slot(formal), index);
        if (sites.mode == InitializingPlaceFormal) {
            storage_operation(code, plan, unbind_local(), 0u64, 0u64, formal, formal);
        };
        index <-:+ 1u64;
        chain <- formal_owner_word(facts, formal);
        if (chain != no_node()) {
            emit(code, plan, receive_parameter(), slot(chain), index);
            (index <-:+ 1u64):void;
        };
        formal <- links[formal].next;
    };
}

func initialize_defer_flags(sites:const CompletionSites in S, code:NativeCommands in C, plan:NativePlan in P,
                            scope:u64, used:u64) -> void where {const owner S, owner C, owner P} {
    val action <- sites[scope].last_defer;
    for (unused in 0u64 .. used) {
        if (action == no_node()) return;
        emit(code, plan, write_flow_flag(), slot(action), 0u64);
        action <- sites[action].previous_defer;
    };
}

func lower_delayed_block(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                         facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                         plan:NativePlan in P, state:LoweringState in R, body:u64, next:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val exception_target <- state.exception_target;
    val return_target <- state.return_target;
    val caught_failure <- state.caught_failure;
    val saved <- save_failure(code, plan);
    emit(code, plan, word_constant(), pending_category(), 0u64);
    state.exception_target <- next;
    val ready <- if (state.active_scope == state.active_function) { state.return_ready } else { no_node() };
    val scan_flag <- state.scope_scan_flag;
    val returned <- if (ready != no_node() || scan_flag != no_node()) { new_block(plan) } else { next };
    state.return_target <- returned;
    state.caught_failure <- no_node();
    lower_node(nodes, names, links, facts, sites, code, plan, state, body);
    state.exception_target <- exception_target;
    state.return_target <- return_target;
    state.caught_failure <- caught_failure;
    if (state.live) {
        restore_failure(code, plan, saved);
        finish_block(code, plan, state, next);
    } else {};
    if (scan_flag != no_node()) {
        # This edge is reached only once a replacement return has been
        # prepared and delivered by its enclosing guards and finalizers.
        position(code, plan, state, returned);
        emit(code, plan, write_flow_flag(), scan_flag, 0u64);
        finish_block(code, plan, state, next);
    } else { forward_return(code, plan, state, returned, next, no_node(), ready); };
}

func drain_scope(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L, facts:const OperandFacts in F,
                 sites:const CompletionSites in S, code:NativeCommands in C,
                 plan:NativePlan in P, state:LoweringState in R, scope:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val action <- sites[scope].last_defer;
    val invoke_block <- no_node();
    val next <- no_node();
    val failed <- no_node();
    ref deferred = make DeferSites { operand <- no_node(); invocation <- no_node(); clauses <- no_node(); };
    ref call = make DirectCallSites { callee <- no_node(); arguments <- no_node(); };
    ref argument = make u64 { no_node() };
    val kind <- NotADefer;
    val invocation_mode <- OrdinaryInvocation;
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (action == no_node() || plan.diagnostic != 0u8) return;
        invoke_block <- new_block(plan);
        next <- new_block(plan);
        command(code, plan, branch_on_flow_flag(), slot(action), 0u64, next, invoke_block);
        position(code, plan, state, invoke_block);
        emit(code, plan, write_flow_flag(), slot(action), 0u64);
        kind <- inspect_defer(nodes, state.syntax_revision, state.syntax_used, action, deferred);
        if (kind == DeferBody) {
            lower_delayed_block(nodes, names, links, facts, sites, code, plan, state, deferred.operand, next);
        } else {
            invocation_mode <- inspect_invocation(nodes, state.syntax_revision, state.syntax_used, deferred.invocation, call);
            if (kind != DeferCall || (invocation_mode != OrdinaryInvocation && invocation_mode != EffectfulInvocation) ||
                !first_sequence_entry(nodes, state.syntax_revision, state.syntax_used, call.arguments, ArgumentSequence, argument)) {
                plan.diagnostic <- invalid_native_module();
                return;
            };
            invoke(nodes, links, facts, code, plan, deferred.invocation, argument, invocation_mode == EffectfulInvocation);
            if (invocation_mode == OrdinaryInvocation) {
                # In this admitted subset only a fatal numeric fault can escape
                # a deferred callee. Keep the pending outcome on normal return.
                failed <- new_block(plan);
                command(code, plan, branch_equal(), call_category(), 0u64, next, failed);
                position(code, plan, state, failed);
                invocation_failure(code, plan);
            } else {};
            finish_block(code, plan, state, next);
        };
        position(code, plan, state, next);
        action <- sites[action].previous_defer;
    };
}

func begin_text_owner(facts:const OperandFacts in F, code:NativeCommands in C, plan:NativePlan in P,
                      scope:u64) -> void where {const owner F, owner C, owner P} {
    val chain <- facts[scope].owner_chain;
    if (chain != no_node()) { emit(code, plan, word_constant(), slot(chain), 0u64); };
}

func release_text_owner(facts:const OperandFacts in F, code:NativeCommands in C, plan:NativePlan in P,
                        scope:u64) -> void where {const owner F, owner C, owner P} {
    val chain <- facts[scope].owner_chain;
    if (chain != no_node()) { emit(code, plan, text_release(), slot(chain), 0u64); };
}

# A full scope executes in the current native activation with its own
# result slot and drain. An escaping failure resumes the enclosing route
# only after the local drain has run.
func lower_full_scope(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S, code:NativeCommands in C,
                      plan:NativePlan in P, state:LoweringState in R, scope:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val outer_scope <- state.active_scope;
    val outer_exception <- state.exception_target;
    val outer_return_target <- state.return_target;
    val outer_return_slot <- state.return_slot;
    val outer_return <- state.local_return;
    val outer_cleanup <- state.scope_cleanup;
    val outer_scan_flag <- state.scope_scan_flag;
    val outer_scan_pending <- state.scope_scan_pending;
    val cleanup <- new_block(plan);
    val arm <- state.case_arm;
    ref selected_arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64; };
    val takes_scan <- inspect_case_arm(nodes, state.syntax_revision, state.syntax_used, arm, selected_arm) &&
        selected_arm.body == scope && facts[scope].case_resume != 0u8;
    val scan_flag <- if (takes_scan) { new_slot(plan) } else { no_node() };
    state.active_scope <- scope;
    state.scope_cleanup <- cleanup;
    state.scope_scan_flag <- scan_flag;
    state.scope_scan_pending <- false;
    if (takes_scan) { emit(code, plan, write_flow_flag(), scan_flag, 0u64); } else {};
    state.exception_target <- cleanup;
    state.return_target <- cleanup;
    val destination <- if (scalar_kind(facts[scope].kind)) { slot(scope) } else { no_node() };
    state.return_slot <- destination;
    state.local_return <- false;
    initialize_defer_flags(sites, code, plan, scope, syntax_len(nodes));
    initialize_guarded_locals(names, code, plan, scope);
    begin_text_owner(facts, code, plan, scope);
    lower_list(nodes, names, links, facts, sites, code, plan, state, scope, BlockSequence, destination, false);
    if (plan.diagnostic != 0u8) return;
    val normal <- state.live || state.local_return;
    val scan_pending <- state.scope_scan_pending && facts[arm].case_resume == case_resumes_after_cleanup();
    if (state.live) { finish_block(code, plan, state, cleanup); } else {};
    position(code, plan, state, cleanup);
    drain_scope(nodes, names, links, facts, sites, code, plan, state, scope);
    release_text_owner(facts, code, plan, scope);
    val resumes <- normal || state.local_return;
    state.active_scope <- outer_scope;
    state.exception_target <- outer_exception;
    state.return_target <- outer_return_target;
    state.return_slot <- outer_return_slot;
    state.local_return <- outer_return;
    state.scope_cleanup <- outer_cleanup;
    state.scope_scan_flag <- outer_scan_flag;
    state.scope_scan_pending <- outer_scan_pending;
    if (!resumes && !scan_pending) { finish_block(code, plan, state, outer_exception); return; } else {};
    val ready <- new_block(plan);
    command(code, plan, branch_equal(), pending_category(), 0u64, ready, outer_exception);
    position(code, plan, state, ready);
    if (scan_pending) {
        state.case_resumed <- true;
        if (!resumes) {
            finish_block(code, plan, state, state.case_next);
        } else {
            val completed <- new_block(plan);
            command(code, plan, branch_on_flow_flag(), scan_flag, 0u64, completed, state.case_next);
            position(code, plan, state, completed);
        };
    } else {};
}

func lower_activation(nodes:const ExprNodes in N, tree:const ParseResult in T, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S,
                      code:NativeCommands in C, plan:NativePlan in P, scope:u64) -> void
    where {const owner N, const owner T, const owner B, const owner L, const owner F, const owner S, owner C, owner P} {
    plan.node <- scope;
    val program <- scope == tree.root;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    ref first = make u64 { no_node() };
    if (!program && (inspect_callable(nodes, tree.revision, tree.used, scope, callable) != ModuleCallable ||
        !callable_parameters(nodes, tree, callable.signature, first))) {
        plan.diagnostic <- invalid_native_module();
        return;
    };
    val body <- callable.body;
    val can_complete <- program || can_continue(sites, body);
    val check_return <- !program && can_miss_return(nodes, facts, sites, scope, tree.revision, tree.used);
    val entry <- new_block(plan);
    val cleanup <- new_block(plan);
    val returned <- if (check_return) { new_block(plan) } else { cleanup };
    val return_ready <- if (check_return) { new_slot(plan) } else { no_node() };
    val return_slot <- if (scalar_kind(facts[scope].kind) || facts[scope].reception == borrowed_ref()) {
        returned_word()
    } else { no_node() };
    ref state = make LoweringState {
        syntax_revision <- tree.revision; syntax_used <- tree.used;
        active_function <- scope; active_scope <- scope; exception_target <- cleanup;
        return_target <- returned; return_slot <- return_slot; return_ready <- return_ready;
        caught_failure <- no_node(); live <- true; local_return <- false;
        scope_cleanup <- no_node(); scope_scan_flag <- no_node(); scope_scan_pending <- false;
        case_index <- no_node(); case_join <- no_node(); case_arm <- no_node(); case_next <- no_node();
        case_present_flag <- no_node();
        case_read <- false; case_completed <- false; case_resumed <- false;
        finalizer <- no_node(); break_landing <- no_node(); break_value <- no_node();
        scan_landing <- no_node(); pending_break <- false; pending_scan <- false;
    };
    emit(code, plan, begin_function(), plan.function_base + scope, entry);
    position(code, plan, state, entry);
    emit(code, plan, word_constant(), pending_category(), 0u64);
    emit(code, plan, word_constant(), pending_site(), 0u64);
    emit(code, plan, word_constant(), returned_word(), 0u64);
    if (check_return) { emit(code, plan, word_constant(), return_ready, 0u64); } else {};
    initialize_defer_flags(sites, code, plan, scope, syntax_len(nodes));
    initialize_guarded_locals(names, code, plan, scope);
    begin_text_owner(facts, code, plan, scope);
    if (program) {
        lower_list(nodes, names, links, facts, sites, code, plan, state, scope, ModuleSequence, no_node(), false);
    } else {
        receive_formals(nodes, links, facts, code, plan, state, first);
        lower_node(nodes, names, links, facts, sites, code, plan, state, body);
    };
    if (plan.diagnostic != 0u8) return;
    if (state.live) {
        if (!can_complete) {
            plan.diagnostic <- unproved_callable_completion();
            plan.node <- scope;
            return;
        } else {};
        if (has_value_tail(facts, body, callable.function_form)) { emit(code, plan, copy_word(), returned_word(), slot(body)); } else {};
        finish_block(code, plan, state, cleanup);
    } else {};
    forward_return(code, plan, state, returned, cleanup, no_node(), return_ready);
    position(code, plan, state, cleanup);
    drain_scope(nodes, names, links, facts, sites, code, plan, state, scope);
    release_text_owner(facts, code, plan, scope);
    if (check_return) {
        val normal <- new_block(plan);
        val missing <- new_block(plan);
        val done <- new_block(plan);
        command(code, plan, branch_equal(), pending_category(), 0u64, normal, done);
        position(code, plan, state, normal);
        command(code, plan, branch_equal(), return_ready, 0u64, missing, done);
        position(code, plan, state, missing);
        source_failure(code, plan, missing_return_identity(), syntax_first(nodes, tree.used, scope));
        finish_block(code, plan, state, done);
        position(code, plan, state, done);
    } else {};
    val finish <- if (program) { finish_program() } else { return_outcome() };
    if (!program) {
        check_initialized_formals(nodes, links, code, plan, state, first);
    };
    command(code, plan, finish, returned_word(), pending_category(), pending_site(), 0u64);
}

func check_initialized_formals(nodes:const ExprNodes in N, links:const NameWork in L,
                               code:NativeCommands in C, plan:NativePlan in P, state:LoweringState in R,
                               first:u64) -> void where {const owner N, const owner L, owner C, owner P, owner R} {
    val formal <- first;
    ref sites = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal; };
    val complete <- no_node();
    val normal <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (formal == no_node()) {
            if (complete != no_node()) {
                finish_block(code, plan, state, complete);
                position(code, plan, state, complete);
            };
            return;
        };
        if (inspect_formal(nodes, state.syntax_revision, state.syntax_used, formal, sites) != OrdinaryFormal) {
            plan.diagnostic <- invalid_native_module();
            return;
        };
        if (sites.mode == InitializingPlaceFormal) {
            if (complete == no_node()) {
                complete <- new_block(plan);
                normal <- new_block(plan);
                command(code, plan, branch_equal(), pending_category(), 0u64, normal, complete);
                position(code, plan, state, normal);
            };
            # A compile-time demand on the slot. No payload read is emitted.
            storage_operation(code, plan, require_initialized_place(), 0u64, 0u64, formal, formal);
        };
        formal <- links[formal].next;
    };
}

func module_command_supported(names:const NameBindings in B, sites:const CompletionSites in S, at:u64) -> bool
    where {const owner B, const owner S} {
    return sites[at].event == skipped_operand() || names[at].scope == no_node() ||
        names[at].kind != exception_binding() || sites[at].forwarded_operand != 0u8;
}

# Consume one successful checked revision. The caller may publish commands
# to LLVM only when this operation succeeds.
export func lower_native_module(nodes:const ExprNodes in N, tree:const ParseResult in T, names:const NameBindings in B,
                                links:const NameWork in L, facts:const OperandFacts in F, sites:const CompletionSites in S,
                                code:NativeCommands in C, plan:NativePlan in P, base:u64, entry:bool) -> bool
    where {const owner N, const owner T, const owner B, const owner L, const owner F, const owner S, owner C, owner P} {
    plan.used <- 0u64;
    plan.functions <- tree.used;
    plan.function_base <- base;
    plan.labels <- tree.used;
    plan.slots <- 0u64;
    plan.diagnostic <- invalid_native_module();
    plan.node <- no_node();
    ref first = make u64 { no_node() };
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) || tree.root != tree.used - 1u64 ||
        !first_module_item(nodes, tree.revision, tree.used, tree.root, first)) return false;
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false; };
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(facts) < tree.used || intrinsic (len)(sites) < tree.used) return false;
    plan.diagnostic <- 0u8;
    plan.slots <- slot(tree.used);
    for (at in 0u64 .. tree.used) {
        if (facts[at].owner_chain != no_node()) {
            (plan.slots <- slot(facts[at].owner_chain + 1u64)):void;
        };
        plan.node <- at;
        if (!module_command_supported(names, sites, at)) { plan.diagnostic <- native_unsupported(); return false; } else {};
        if (inspect_callable(nodes, tree.revision, tree.used, at, callable) == ModuleCallable) {
            if (!callable_parameters(nodes, tree, callable.signature, first)) {
                plan.diagnostic <- invalid_native_module();
                return false;
            };
            command(code, plan, declare_function(), base + at, formal_count(links, facts, first, tree.used), 0u64, 0u64);
            if (plan.diagnostic != 0u8) return false;
        } else {};
    };
    if (entry) { command(code, plan, declare_function(), base + tree.root, 0u64, 1u64, 0u64); };
    for (at in 0u64 .. tree.used) {
        if (inspect_callable(nodes, tree.revision, tree.used, at, callable) == ModuleCallable || (entry && at == tree.root)) {
            lower_activation(nodes, tree, names, links, facts, sites, code, plan, at);
            if (plan.diagnostic != 0u8) return false;
        } else {};
    };
    plan.node <- no_node();
    return true;
}
