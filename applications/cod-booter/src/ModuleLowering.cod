using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" len as syntax_len;
using "ParserStorage.cod" no_node;
using "ParserStorage.cod" module_node;
using "ParserStorage.cod" procedure_node;
using "ParserStorage.cod" using_node;
using "ParserStorage.cod" block_node;
using "ParserStorage.cod" full_scope_node;
using "ParserStorage.cod" catch_clause_node;
using "ParserStorage.cod" finally_clause_node;
using "ParserStorage.cod" try_node;
using "ParserStorage.cod" literal_node;
using "ParserStorage.cod" null_node;
using "ParserStorage.cod" name_node;
using "ParserStorage.cod" group_node;
using "ParserStorage.cod" val_binding_node;
using "ParserStorage.cod" ptr_binding_node;
using "ParserStorage.cod" add_node;
using "ParserStorage.cod" multiply_node;
using "ParserStorage.cod" transfer_node;
using "ParserStorage.cod" call_node;
using "ParserStorage.cod" behave_node;
using "ParserStorage.cod" deferred_call_node;
using "ParserStorage.cod" return_node;
using "ParserStorage.cod" throw_node;
using "ExpressionParser.cod" ParseResult;
using "NameResolution.cod" NameBindings;
using "NameResolution.cod" NameWork;
using "NameResolution.cod" first_item;
using "NameResolution.cod" procedure_head;
using "NameResolution.cod" exception_binding;
using "OperandChecking.cod" OperandFacts;
using "OperandChecking.cod" scalar_u64;
using "OperandChecking.cod" independent_value;
using "OperandChecking.cod" writable_place;
using "CompletionChecking.cod" CompletionSites;
using "CompletionChecking.cod" present_target;
using "CompletionChecking.cod" absent_target;
using "ModuleExports.cod" exception_root_identity;
using "ModuleExports.cod" null_pointer_identity;
using "NativeCommands.cod" NativeCommands;
using "NativeCommands.cod" NativePlan;
using "NativeCommands.cod" declare_function;
using "NativeCommands.cod" begin_function;
using "NativeCommands.cod" position_block;
using "NativeCommands.cod" jump;
using "NativeCommands.cod" branch_equal;
using "NativeCommands.cod" word_constant;
using "NativeCommands.cod" copy_word;
using "NativeCommands.cod" place_address;
using "NativeCommands.cod" load_target;
using "NativeCommands.cod" store_target;
using "NativeCommands.cod" checked_add;
using "NativeCommands.cod" checked_multiply;
using "NativeCommands.cod" receive_parameter;
using "NativeCommands.cod" pass_argument;
using "NativeCommands.cod" invoke_function;
using "NativeCommands.cod" print_word;
using "NativeCommands.cod" return_outcome;
using "NativeCommands.cod" finish_program;
using "NativeCommands.cod" returned_word;
using "NativeCommands.cod" pending_category;
using "NativeCommands.cod" pending_site;
using "NativeCommands.cod" call_category;
using "NativeCommands.cod" call_site;
using "NativeCommands.cod" overflow_flag;
using "NativeCommands.cod" slot;
using "NativeCommands.cod" addition_overflow;
using "NativeCommands.cod" multiplication_overflow;

data LoweringState {
    active_function:u64;
    cleanup:u64;
    live:bool;
}

func native_unsupported() -> u8 { return 1u8; }
func native_command_capacity() -> u8 { return 2u8; }
func invalid_native_module() -> u8 { return 3u8; }
func unproved_procedure_completion() -> u8 { return 4u8; }

func command(ref code:NativeCommands in C, ref plan:NativePlan in P, opcode:u8,
             a:u64, b:u64, c:u64, d:u64) -> void where {owner C, owner P} {
    if (plan.diagnostic != 0u8) { return; } else {};
    val at <- plan.used;
    if (at == intrinsic (len)(code)) {
        plan.diagnostic <- native_command_capacity();
        return;
    } else {};
    code[at].opcode <- opcode;
    code[at].a <- a;
    code[at].b <- b;
    code[at].c <- c;
    code[at].d <- d;
    plan.used <- at + 1u64;
    return;
}

func emit(ref code:NativeCommands in C, ref plan:NativePlan in P, opcode:u8, a:u64, b:u64) -> void
    where {owner C, owner P} {
    command(code, plan, opcode, a, b, 0u64, 0u64);
}

func new_block(ref plan:NativePlan in P) -> u64 where {owner P} {
    val label <- plan.labels;
    plan.labels <- label + 1u64;
    return label;
}

func position(ref code:NativeCommands in C, ref plan:NativePlan in P, ref state:LoweringState in R,
              label:u64) -> void where {owner C, owner P, owner R} {
    emit(code, plan, position_block(), label, state.active_function);
    state.live <- true;
    return;
}

func finish_block(ref code:NativeCommands in C, ref plan:NativePlan in P, ref state:LoweringState in R,
                  destination:u64) -> void where {owner C, owner P, owner R} {
    emit(code, plan, jump(), destination, 0u64);
    state.live <- false;
    return;
}

func source_failure(ref code:NativeCommands in C, ref plan:NativePlan in P, category:u64, at:u64) -> void
    where {owner C, owner P} {
    emit(code, plan, word_constant(), pending_category(), category);
    emit(code, plan, word_constant(), pending_site(), at);
}

func invocation_failure(ref code:NativeCommands in C, ref plan:NativePlan in P) -> void where {owner C, owner P} {
    emit(code, plan, copy_word(), pending_category(), call_category());
    emit(code, plan, copy_word(), pending_site(), call_site());
}

func route_exception(sites:const CompletionSites in S, ref code:NativeCommands in C,
                     ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner S, owner C, owner P, owner R} {
    val guard <- sites[at].guarded_by;
    if (guard == no_node()) { finish_block(code, plan, state, state.cleanup); } else {
        finish_block(code, plan, state, guard);
    };
}

# One dispatch block per guard keeps the same source-order handler walk for
# all its failure sites. The final edge goes to the outer guard or cleanup.
func lower_dispatch(nodes:const ExprNodes in N, links:const NameWork in L, facts:const OperandFacts in F,
                    sites:const CompletionSites in S, ref code:NativeCommands in C,
                    ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    position(code, plan, state, at);
    val non_add <- new_block(plan);
    val ordinary <- new_block(plan);
    command(code, plan, branch_equal(), pending_category(), addition_overflow(), state.cleanup, non_add);
    position(code, plan, state, non_add);
    command(code, plan, branch_equal(), pending_category(), multiplication_overflow(), state.cleanup, ordinary);
    position(code, plan, state, ordinary);
    val clause <- first_item(nodes, nodes[at].right);
    val handler <- no_node();
    val category <- no_node();
    val next <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (clause == no_node()) { route_exception(sites, code, plan, state, at); return; } else {};
        handler <- nodes[clause].right;
        category <- facts[nodes[handler].left].identity;
        if (category == no_node() || category == exception_root_identity()) {
            finish_block(code, plan, state, handler);
            return;
        } else {};
        next <- new_block(plan);
        command(code, plan, branch_equal(), pending_category(), category, handler, next);
        position(code, plan, state, next);
        (clause <- links[clause].next):void;
    };
    route_exception(sites, code, plan, state, at);
}

func require_target(nodes:const ExprNodes in N, facts:const OperandFacts in F,
                    sites:const CompletionSites in S, ref code:NativeCommands in C,
                    ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner F, const owner S, owner C, owner P, owner R} {
    val presence <- sites[at].presence;
    if (facts[at].needs_target == 0u8 || presence == present_target()) { return; } else {};
    if (presence == absent_target()) {
        source_failure(code, plan, null_pointer_identity(), nodes[at].first);
        route_exception(sites, code, plan, state, at);
        return;
    } else {};
    val absent <- new_block(plan);
    val ready <- new_block(plan);
    command(code, plan, branch_equal(), slot(at), 0u64, absent, ready);
    position(code, plan, state, absent);
    source_failure(code, plan, null_pointer_identity(), nodes[at].first);
    route_exception(sites, code, plan, state, at);
    position(code, plan, state, ready);
}

func lower_bits(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S,
                ref code:NativeCommands in C, ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    lower_node(nodes, names, links, facts, sites, code, plan, state, at);
    if (!state.live || facts[at].reception == independent_value()) { return; } else {};
    require_target(nodes, facts, sites, code, plan, state, at);
    if (state.live) { emit(code, plan, load_target(), slot(at), slot(at)); } else {};
}

func prepare_arguments(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                       facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                       ref plan:NativePlan in P, ref state:LoweringState in R, call:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val argument <- first_item(nodes, nodes[call].right);
    val actual <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (argument == no_node() || !state.live || plan.diagnostic != 0u8) { return; } else {};
        actual <- nodes[argument].right;
        if (facts[argument].reception == independent_value()) {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, actual);
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, actual);
        };
        if (state.live) { emit(code, plan, copy_word(), slot(argument), slot(actual)); } else {};
        (argument <- links[argument].next):void;
    };
}

func invoke(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
             ref code:NativeCommands in C, ref plan:NativePlan in P, call:u64) -> void
    where {const owner N, const owner B, const owner L, owner C, owner P} {
    if (nodes[call].kind == behave_node()) {
        emit(code, plan, print_word(), slot(nodes[call].right), 0u64);
        return;
    } else {};
    val argument <- first_item(nodes, nodes[call].right);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (argument == no_node()) {
            command(code, plan, invoke_function(), names[nodes[call].left].declaration, slot(call),
                    call_category(), call_site());
            return;
        } else {};
        emit(code, plan, pass_argument(), slot(argument), 0u64);
        (argument <- links[argument].next):void;
    };
}

func lower_call(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    prepare_arguments(nodes, names, links, facts, sites, code, plan, state, at);
    if (!state.live) { return; } else {};
    invoke(nodes, names, links, code, plan, at);
    if (nodes[at].kind == behave_node()) { return; } else {};
    val ready <- new_block(plan);
    val failed <- new_block(plan);
    command(code, plan, branch_equal(), call_category(), 0u64, ready, failed);
    position(code, plan, state, failed);
    invocation_failure(code, plan);
    route_exception(sites, code, plan, state, at);
    position(code, plan, state, ready);
}

func lower_binary(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                  facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                  ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val left <- nodes[at].left;
    val right <- nodes[at].right;
    val kind <- nodes[at].kind;
    if (kind == transfer_node()) {
        lower_node(nodes, names, links, facts, sites, code, plan, state, left);
        if (!state.live) { return; } else {};
        require_target(nodes, facts, sites, code, plan, state, left);
    } else {
        lower_bits(nodes, names, links, facts, sites, code, plan, state, left);
    };
    if (!state.live) { return; } else {};
    lower_bits(nodes, names, links, facts, sites, code, plan, state, right);
    if (!state.live) { return; } else {};
    if (kind == transfer_node()) {
        emit(code, plan, store_target(), slot(left), slot(right));
        emit(code, plan, copy_word(), slot(at), slot(left));
        return;
    } else {};
    val opcode <- if (kind == add_node()) { checked_add() } else { checked_multiply() };
    val failure <- if (kind == add_node()) { addition_overflow() } else { multiplication_overflow() };
    command(code, plan, opcode, slot(at), slot(left), slot(right), overflow_flag());
    val ready <- new_block(plan);
    val failed <- new_block(plan);
    command(code, plan, branch_equal(), overflow_flag(), 0u64, ready, failed);
    position(code, plan, state, failed);
    source_failure(code, plan, failure, nodes[at].operation_at);
    finish_block(code, plan, state, state.cleanup);
    position(code, plan, state, ready);
}

func lower_list(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                ref plan:NativePlan in P, ref state:LoweringState in R, tail:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val item <- first_item(nodes, tail);
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (item == no_node() || !state.live || plan.diagnostic != 0u8) { return; } else {};
        lower_node(nodes, names, links, facts, sites, code, plan, state, nodes[item].right);
        (item <- links[item].next):void;
    };
}

func lower_try(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
               facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
               ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val join <- new_block(plan);
    val normal <- false;
    lower_node(nodes, names, links, facts, sites, code, plan, state, nodes[at].left);
    if (state.live) {
        normal <- true;
        finish_block(code, plan, state, join);
    } else {};
    lower_dispatch(nodes, links, facts, sites, code, plan, state, at);
    val clause <- first_item(nodes, nodes[at].right);
    val handler <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (plan.diagnostic != 0u8) { return; } else {};
        if (clause == no_node()) {
            if (normal) { position(code, plan, state, join); } else {};
            return;
        } else {};
        handler <- nodes[clause].right;
        position(code, plan, state, handler);
        emit(code, plan, word_constant(), pending_category(), 0u64);
        lower_node(nodes, names, links, facts, sites, code, plan, state, nodes[handler].right);
        if (state.live) {
            normal <- true;
            finish_block(code, plan, state, join);
        } else {};
        (clause <- links[clause].next):void;
    };
}

func lower_binding(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                   facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                   ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val initializer <- nodes[at].right;
    if (nodes[at].kind == val_binding_node()) {
        lower_bits(nodes, names, links, facts, sites, code, plan, state, initializer);
    } else {
        lower_node(nodes, names, links, facts, sites, code, plan, state, initializer);
    };
    if (state.live) { emit(code, plan, copy_word(), slot(at), slot(initializer)); } else {};
}

func lower_return(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                  facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                  ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    val value <- nodes[at].left;
    if (value != no_node()) {
        lower_bits(nodes, names, links, facts, sites, code, plan, state, value);
        if (!state.live) { return; } else {};
        emit(code, plan, copy_word(), returned_word(), slot(value));
    } else {};
    emit(code, plan, word_constant(), pending_category(), 0u64);
    finish_block(code, plan, state, state.cleanup);
}

func lower_node(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                facts:const OperandFacts in F, sites:const CompletionSites in S, ref code:NativeCommands in C,
                ref plan:NativePlan in P, ref state:LoweringState in R, at:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P, owner R} {
    if (!state.live || plan.diagnostic != 0u8) { return; } else {};
    plan.node <- at;
    val kind <- nodes[at].kind;
    if (kind == using_node() || kind == procedure_node()) { return; } else {};
    if (kind == literal_node()) {
        emit(code, plan, word_constant(), slot(at), nodes[at].number);
        return;
    } else {};
    if (kind == null_node()) { emit(code, plan, word_constant(), slot(at), 0u64); return; } else {};
    if (kind == name_node()) {
        val declaration <- names[at].declaration;
        if (facts[at].kind != scalar_u64()) { plan.diagnostic <- native_unsupported(); return; } else {};
        val opcode <- if (facts[at].reception == writable_place()) { place_address() } else { copy_word() };
        emit(code, plan, opcode, slot(at), slot(declaration));
        return;
    } else {};
    if (kind == block_node()) {
        lower_list(nodes, names, links, facts, sites, code, plan, state, nodes[at].left);
        return;
    } else {};
    if (kind == group_node()) {
        val inside <- nodes[at].left;
        if (facts[at].kind == scalar_u64()) {
            lower_bits(nodes, names, links, facts, sites, code, plan, state, inside);
            if (state.live) { emit(code, plan, copy_word(), slot(at), slot(inside)); } else {};
        } else {
            lower_node(nodes, names, links, facts, sites, code, plan, state, inside);
        };
        return;
    } else {};
    if (kind == val_binding_node() || kind == ptr_binding_node()) {
        lower_binding(nodes, names, links, facts, sites, code, plan, state, at);
        return;
    } else {};
    if (kind == add_node() || kind == multiply_node() || kind == transfer_node()) {
        lower_binary(nodes, names, links, facts, sites, code, plan, state, at);
        return;
    } else {};
    if (kind == call_node() || kind == behave_node()) {
        lower_call(nodes, names, links, facts, sites, code, plan, state, at);
        return;
    } else {};
    if (kind == deferred_call_node()) {
        prepare_arguments(nodes, names, links, facts, sites, code, plan, state, nodes[at].right);
        if (state.live) { emit(code, plan, word_constant(), slot(at), 1u64); } else {};
        return;
    } else {};
    if (kind == try_node()) {
        lower_try(nodes, names, links, facts, sites, code, plan, state, at);
        return;
    } else {};
    if (kind == return_node()) { lower_return(nodes, names, links, facts, sites, code, plan, state, at); return; } else {};
    plan.diagnostic <- native_unsupported();
    return;
}

func formal_count(nodes:const ExprNodes in N, head:u64) -> u64 where {const owner N} {
    val current <- nodes[head].right;
    for (count in 0u64 .. syntax_len(nodes)) {
        if (current == no_node()) { return count; } else {};
        (current <- nodes[current].left):void;
    };
    return 0u64;
}

func receive_formals(nodes:const ExprNodes in N, links:const NameWork in L, ref code:NativeCommands in C,
                     ref plan:NativePlan in P, head:u64) -> void
    where {const owner N, const owner L, owner C, owner P} {
    val formal <- first_item(nodes, nodes[head].right);
    for (index in 0u64 .. syntax_len(nodes)) {
        if (formal == no_node()) { return; } else {};
        emit(code, plan, receive_parameter(), slot(formal), index);
        (formal <- links[formal].next):void;
    };
}

func initialize_defer_flags(sites:const CompletionSites in S, ref code:NativeCommands in C, ref plan:NativePlan in P,
                            scope:u64, used:u64) -> void where {const owner S, owner C, owner P} {
    val action <- sites[scope].last_defer;
    for (unused in 0u64 .. used) {
        if (action == no_node()) { return; } else {};
        emit(code, plan, word_constant(), slot(action), 0u64);
        (action <- sites[action].previous_defer):void;
    };
}

func drain_scope(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                 sites:const CompletionSites in S, ref code:NativeCommands in C,
                 ref plan:NativePlan in P, ref state:LoweringState in R, scope:u64) -> void
    where {const owner N, const owner B, const owner L, const owner S, owner C, owner P, owner R} {
    val action <- sites[scope].last_defer;
    val invoke_block <- no_node();
    val next <- no_node();
    val failed <- no_node();
    val invocation <- no_node();
    for (unused in 0u64 .. syntax_len(nodes)) {
        if (action == no_node() || plan.diagnostic != 0u8) { return; } else {};
        invoke_block <- new_block(plan);
        next <- new_block(plan);
        command(code, plan, branch_equal(), slot(action), 0u64, next, invoke_block);
        position(code, plan, state, invoke_block);
        emit(code, plan, word_constant(), slot(action), 0u64);
        invocation <- nodes[action].right;
        invoke(nodes, names, links, code, plan, invocation);
        if (nodes[invocation].kind == call_node()) {
            # In this admitted subset only a fatal numeric fault can escape
            # a deferred callee. Keep the pending outcome on normal return.
            failed <- new_block(plan);
            command(code, plan, branch_equal(), call_category(), 0u64, next, failed);
            position(code, plan, state, failed);
            invocation_failure(code, plan);
        } else {};
        finish_block(code, plan, state, next);
        position(code, plan, state, next);
        (action <- sites[action].previous_defer):void;
    };
}

func lower_activation(nodes:const ExprNodes in N, names:const NameBindings in B, links:const NameWork in L,
                      facts:const OperandFacts in F, sites:const CompletionSites in S,
                      ref code:NativeCommands in C, ref plan:NativePlan in P, scope:u64) -> void
    where {const owner N, const owner B, const owner L, const owner F, const owner S, owner C, owner P} {
    plan.node <- scope;
    val entry <- new_block(plan);
    ref state = make LoweringState {active_function <- scope; cleanup <- new_block(plan); live <- true;};
    emit(code, plan, begin_function(), scope, entry);
    position(code, plan, state, entry);
    emit(code, plan, word_constant(), pending_category(), 0u64);
    emit(code, plan, word_constant(), pending_site(), 0u64);
    emit(code, plan, word_constant(), returned_word(), 0u64);
    initialize_defer_flags(sites, code, plan, scope, syntax_len(nodes));
    val program <- nodes[scope].kind == module_node();
    if (program) {
        lower_list(nodes, names, links, facts, sites, code, plan, state, nodes[scope].left);
    } else {
        receive_formals(nodes, links, code, plan, procedure_head(nodes, scope));
        lower_node(nodes, names, links, facts, sites, code, plan, state, nodes[scope].right);
    };
    if (plan.diagnostic != 0u8) { return; } else {};
    if (state.live) {
        if (!program) {
            plan.diagnostic <- unproved_procedure_completion();
            plan.node <- scope;
            return;
        } else {};
        finish_block(code, plan, state, state.cleanup);
    } else {};
    position(code, plan, state, state.cleanup);
    drain_scope(nodes, names, links, sites, code, plan, state, scope);
    val finish <- if (program) { finish_program() } else { return_outcome() };
    command(code, plan, finish, returned_word(), pending_category(), pending_site(), 0u64);
}

func module_command_supported(nodes:const ExprNodes in N, names:const NameBindings in B, at:u64) -> bool
    where {const owner N, const owner B} {
    val kind <- nodes[at].kind;
    if (kind == full_scope_node() || kind == throw_node() || kind == finally_clause_node()) { return false; } else {};
    return names[at].scope == no_node() || names[at].kind != exception_binding();
}

# Consume one successful checked revision. The caller may publish commands
# to LLVM only when this operation succeeds.
func lower_native_module(nodes:const ExprNodes in N, tree:const ParseResult in T, names:const NameBindings in B,
                         links:const NameWork in L, facts:const OperandFacts in F, sites:const CompletionSites in S,
                         ref code:NativeCommands in C, ref plan:NativePlan in P) -> bool
    where {const owner N, const owner T, const owner B, const owner L, const owner F, const owner S, owner C, owner P} {
    plan.used <- 0u64;
    plan.labels <- tree.used;
    plan.slots <- 0u64;
    plan.diagnostic <- invalid_native_module();
    plan.node <- no_node();
    if (tree.diagnostic != 0u8 || tree.used == 0u64 || tree.used > syntax_len(nodes) ||
        tree.root != tree.used - 1u64 || nodes[tree.root].kind != module_node()) { return false; } else {};
    if (intrinsic (len)(names) < tree.used || intrinsic (len)(links) < tree.used ||
        intrinsic (len)(facts) < tree.used || intrinsic (len)(sites) < tree.used) { return false; } else {};
    plan.diagnostic <- 0u8;
    plan.slots <- slot(tree.used);
    for (at in 0u64 .. tree.used) {
        plan.node <- at;
        if (!module_command_supported(nodes, names, at)) { plan.diagnostic <- native_unsupported(); return false; } else {};
        if (nodes[at].kind == procedure_node()) {
            command(code, plan, declare_function(), at, formal_count(nodes, procedure_head(nodes, at)), 0u64, 0u64);
            if (plan.diagnostic != 0u8) { return false; } else {};
        } else {};
    };
    command(code, plan, declare_function(), tree.root, 0u64, 1u64, 0u64);
    for (at in 0u64 .. tree.used) {
        if (nodes[at].kind == procedure_node() || at == tree.root) {
            lower_activation(nodes, names, links, facts, sites, code, plan, at);
            if (plan.diagnostic != 0u8) { return false; } else {};
        } else {};
    };
    plan.node <- no_node();
    return true;
}

export lower_native_module;
export native_unsupported;
export native_command_capacity;
export invalid_native_module;
export unproved_procedure_completion;
