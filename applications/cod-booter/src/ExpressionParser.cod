func expected_operand() -> u8 { return 1u8; }
func expected_close() -> u8 { return 2u8; }
func expected_u64() -> u8 { return 3u8; }
func literal_too_large() -> u8 { return 4u8; }
export func unexpected_token() -> u8 { return 6u8; }
func expected_argument_separator() -> u8 { return 7u8; }
export func expected_deferred_call() -> u8 { return 8u8; }
func expected_block() -> u8 { return 10u8; }
func expected_block_close() -> u8 { return 11u8; }
func expected_block_separator() -> u8 { return 12u8; }
func expected_try_clause() -> u8 { return 13u8; }
func expected_catch_header() -> u8 { return 14u8; }
func expected_catch_name() -> u8 { return 15u8; }
func catch_all_must_be_last() -> u8 { return 17u8; }
func expected_symbol() -> u8 { return 18u8; }
func expected_binding_operator() -> u8 { return 21u8; }
func expected_condition_open() -> u8 { return 27u8; }
func expected_exception_initializer() -> u8 { return 32u8; }
func invalid_exception_placement() -> u8 { return 33u8; }
func duplicate_exception_placement() -> u8 { return 34u8; }
func expected_range_header() -> u8 { return 36u8; }
func expected_handle_constructor() -> u8 { return 37u8; }
func expected_handle_owner() -> u8 { return 38u8; }
func expected_here_receiver() -> u8 { return 39u8; }
func duplicate_here_body() -> u8 { return 40u8; }
func expected_index_close() -> u8 { return 42u8; }
func expected_array_length_query() -> u8 { return 43u8; }
func expected_case_of() -> u8 { return 46u8; }
func expected_case_arrow() -> u8 { return 47u8; }
func invalid_text_literal() -> u8 { return 113u8; }
func expected_region_capacity() -> u8 { return 115u8; }
func unsupported_case_pattern() -> u8 { return 48u8; }
func invalid_throwing_case_arm() -> u8 { return 49u8; }

func append_decimal_digit(number:u64 in N, byte:u8) -> bool where {owner N} {
    val digit:u64 <- byte - 48u8;
    if (number > (18446744073709551615u64 - digit) / 10u64) return false;
    number <- number * 10u64 + digit;
    return true;
}

export func integer_width(source:const SourceBytes in S, token:const Token in T) -> u64
    where {const owner S, const owner T} {
    val end <- token.past;
    val length <- end - token.first;
    if (length >= 3u64 && source[end - 2u64] == 117u8 && source[end - 1u64] == 56u8) return 8u64;
    if (length >= 4u64 && source[end - 3u64] == 117u8) {
        if (source[end - 2u64] == 54u8 && source[end - 1u64] == 52u8) return 64u64;
        if (source[end - 2u64] == 51u8 && source[end - 1u64] == 50u8) return 32u64;
    } else {};
    return 0u64;
}

export func parse_integer_magnitude(source:const SourceBytes in S, token:const Token in T,
                                   result:ParseResult in R, width:u64) -> u64 where {const owner S, const owner T, owner R} {
    val suffix <- if (width == 0u64) { 0u64 } else { if (width == 8u64) { 2u64 } else { 3u64 } };
    val end <- token.past - suffix;
    val number <- 0u64;
    for (at in token.first .. end) {
        if (!append_decimal_digit(number, source[at])) {
            result.diagnostic <- literal_too_large();
            return 0u64;
        } else {};
    };
    if ((width == 8u64 && number > 255u64) || (width == 32u64 && number > 4294967295u64)) {
        result.diagnostic <- literal_too_large();
        return 0u64;
    } else {};
    return number;
}

func parse_literal(source:const SourceBytes in S, token:const Token in T,
                   result:ParseResult in R, width:u64) -> u64 where {const owner S, const owner T, owner R} {
    if (width == 0u64) {
        result.diagnostic <- expected_u64();
        return 0u64;
    } else {};
    return parse_integer_magnitude(source, token, result, width);
}

func comparison(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (punct_pair_at(source, tokens, at, past, 61u8, 61u8)) return equal_words();
    if (punct_pair_at(source, tokens, at, past, 33u8, 61u8)) return unequal_words();
    if (punct_at(source, tokens, at, past) == 60u8) return less_words();
    if (punct_pair_at(source, tokens, at, past, 60u8, 61u8)) return at_most_words();
    if (punct_at(source, tokens, at, past) == 62u8) return greater_words();
    if (punct_pair_at(source, tokens, at, past, 62u8, 61u8)) return at_least_words();
    return no_node();
}

func outer_invocation(nodes:const ExprNodes in A, result:const ParseResult in R, root:u64) -> u64
    where {const owner A, const owner R} {
    val selected <- ungrouped(nodes, result.revision, result.used, root);
    return if (is_invocation(nodes, result.used, selected)) { selected } else { no_node() };
}

func parse_defer(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val keyword <- tokens[result.next].first;
    val operand_start <- result.next + 1u64;
    result.next <- operand_start;
    if (punct_at(source, tokens, operand_start, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        val body <- result.root;
        val last <- parse_guard_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        if (last != no_node()) {
            val first <- syntax_first(nodes, result.used, body);
            append_protected_block(nodes, result, first, body, last, true);
            if (result.diagnostic != 0u8) return;
        } else {};
        val action <- result.root;
        append_syntax_node(nodes, result, keyword, syntax_past(nodes, result.used, action), make DeferredBlock {
            body <- make NodeId { revision <- result.revision; index <- action; };
        });
        return;
    } else {};
    if (operand_start < past && (catch_word(source, tokens[operand_start]) || finally_word(source, tokens[operand_start]))) {
        val fallback <- parse_guard_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        append_syntax_node(nodes, result, keyword, syntax_past(nodes, result.used, fallback), make DeferredClauses {
            clause_tail <- make NodeId { revision <- result.revision; index <- fallback; };
        });
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    val invocation <- outer_invocation(nodes, result, operand);
    if (invocation == no_node()) {
        result.next <- operand_start;
        result.diagnostic <- expected_deferred_call();
        return;
    } else {};
    # Keep the operand's syntax and identify the one invocation that waits.
    append_syntax_node(nodes, result, keyword, syntax_past(nodes, result.used, operand), make DeferredInvocation {
        operand <- make NodeId { revision <- result.revision; index <- operand; };
        invocation <- make NodeId { revision <- result.revision; index <- invocation; };
    });
}

# Each block item links its preceding item and its own expression.
func starts_recoverable_block_item(source:const SourceBytes in S, token:const Token in T) -> bool
    where {const owner S, const owner T} {
    return return_word(source, token) || val_word(source, token) || ref_word(source, token) ||
        ptr_word(source, token) || const_word(source, token) || if_word(source, token) ||
        try_word(source, token) || throw_word(source, token) || defer_word(source, token) ||
        for_word(source, token) || effect_word(source, token)
}

func parse_block_item(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R,
                      past:u64, previous:u64, initializer:bool, case_arm:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    val first_new <- result.used;
    val supplied <- result.supplied_here;
    val in_case <- result.case_control;
    val label <- if (initializer) { initializer_label(source, tokens, start, past) } else { no_node() };
    if (case_arm) {
        parse_case_arm(source, tokens, nodes, result, past);
    } else {
        if (label == no_node()) {
            parse_expression_at(source, tokens, nodes, result, past, 1u8);
        } else {
            parse_initializer_assignment(source, tokens, nodes, result, past, label);
        };
    };
    if (result.diagnostic != 0u8) {
        result.supplied_here <- supplied;
        result.case_control <- in_case;
        if (!recover_syntax(source, tokens, nodes, result, start, past, BlockItemRole)) return false
    };
    val expression <- result.root;
    val first <- syntax_first(nodes, result.used, expression);
    val end <- syntax_past(nodes, result.used, expression);
    val separator <- result.next;
    if (separator < past) {
        val delimiter <- punct_at(source, tokens, separator, past);
        if (delimiter != 59u8 && delimiter != 125u8 &&
            !recover_block_separator(source, tokens, nodes, result, first_new, past, expected_block_separator(),
                                     starts_recoverable_block_item(source, tokens[separator]))) return false;
        if (punct_at(source, tokens, result.next, past) == 59u8) {
            end <- tokens[result.next].past;
            (result.next <- result.next + 1u64):void
        }
    };
    append_block_item(nodes, result, first, end, previous, expression);
    return result.diagnostic == 0u8;
}

func finish_block(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R,
                  past:u64, first:u64, last:u64, scoped:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val close <- result.next;
    if (scoped) {
        close <- close + 1u64;
        if (punct_at(source, tokens, close, past) != 125u8) { # '}'
            val end <- tokens[result.next].past;
            result.next <- close;
            if (recover_block_separator(source, tokens, nodes, result, result.used, past, expected_block_close(), true)) {
                append_block(nodes, result, first, end, last, scoped)
            };
            return
        } else {};
    } else {};
    append_block(nodes, result, first, tokens[close].past, last, scoped);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func parse_braced_items(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64, initializer:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 123u8) { # '{'
        result.diagnostic <- expected_block();
        return;
    } else {};
    val first <- tokens[open].first;
    val following <- open + 1u64;
    val scoped <- punct_at(source, tokens, following, past) == 123u8 &&
        tokens[following].first == tokens[open].past;
    if (scoped && initializer) { result.diagnostic <- expected_block(); return; } else {};
    result.next <- if (scoped) { following + 1u64 } else { following };
    val last <- no_node();
    for (unused in result.next .. past + 1u64) {
        if (punct_at(source, tokens, result.next, past) == 125u8) { # '}'
            finish_block(source, tokens, nodes, result, past, first, last, scoped);
            return;
        } else {};
        if (result.next >= past) {
            if (recover_block_separator(source, tokens, nodes, result, result.used, past, expected_block_close(), true)) {
                append_block(nodes, result, first, tokens[past].first, last, scoped)
            };
            return
        };
        if (!parse_block_item(source, tokens, nodes, result, past, last, initializer, false)) return;
        last <- result.root;
    };
    (result.diagnostic <- expected_block_close()):void;
}

export func parse_block(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_braced_items(source, tokens, nodes, result, past, false);
}

func parse_catch_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) {
        result.diagnostic <- expected_catch_header();
        return false;
    } else {};
    result.next <- open + 1u64;
    if (result.next < past && reserved_value_name(source, tokens[result.next])) {
        result.diagnostic <- expected_catch_name();
        return false;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_catch_name())) return false;
    val name <- result.root;
    val declared_type <- no_node();
    val readonly <- false;
    if (punct_at(source, tokens, result.next, past) == 58u8) {
        result.next <- result.next + 1u64;
        if (result.next < past && const_word(source, tokens[result.next])) {
            readonly <- true;
            (result.next <- result.next + 1u64):void;
        } else {};
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
        (declared_type <- result.root):void;
    } else {};
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) {
        result.diagnostic <- expected_catch_header();
        return false;
    } else {};
    result.next <- close + 1u64;
    val first <- tokens[open].first;
    ref annotation = make NoLink {};
    if (declared_type != no_node()) {
        annotation = make LinkTo { node <- make NodeId { revision <- result.revision; index <- declared_type; }; };
        {};
    };
    append_syntax_node(nodes, result, first, tokens[close].past, make CatchBinding {
        name <- make NodeId { revision <- result.revision; index <- name; };
        caught_type <- annotation;
        readonly <- readonly;
    });
    return result.diagnostic == 0u8 && declared_type == no_node();
}

# Clauses link in source order through the preceding clause. A catch stores
# its binding and body together so a later pass can check that binding's scope.
func parse_catch_clause(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R,
                        past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val root_catch <- parse_catch_binding(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return false;
    val binding <- result.root;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return false;
    val body <- result.root;
    val end <- syntax_past(nodes, result.used, body);
    append_syntax_node(nodes, result, first, end, make CatchHandler {
        binding <- make NodeId { revision <- result.revision; index <- binding; };
        body <- make NodeId { revision <- result.revision; index <- body; };
    });
    if (result.diagnostic != 0u8) return false;
    val handler <- result.root;
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    append_syntax_node(nodes, result, first, end, make CatchClause {
        previous <- preceding;
        handler <- make NodeId { revision <- result.revision; index <- handler; };
    });
    return root_catch;
}

func parse_catches(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- no_node();
    val catch_all <- false;
    for (unused in result.next .. past) {
        if (result.next >= past || !catch_word(source, tokens[result.next])) return last;
        if (catch_all) { result.diagnostic <- catch_all_must_be_last(); return no_node(); } else {};
        catch_all <- parse_catch_clause(source, tokens, nodes, result, past, last);
        if (result.diagnostic != 0u8) return no_node();
        last <- result.root;
    };
    return last;
}

func parse_guard_clauses(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- parse_catches(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return no_node();
    if (result.next < past && finally_word(source, tokens[result.next])) {
        val finally_first <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return no_node();
        val cleanup <- result.root;
        ref preceding = make NoLink {};
        if (last != no_node()) {
            preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- last; }; };
            {};
        };
        append_syntax_node(nodes, result, finally_first, syntax_past(nodes, result.used, cleanup), make FinallyClause {
            previous <- preceding;
            body <- make NodeId { revision <- result.revision; index <- cleanup; };
        });
        if (result.diagnostic != 0u8) return no_node();
        return result.root;
    } else {};
    return last;
}

func append_protected_block(nodes:ExprNodes in A, result:ParseResult in R,
                             first:u64, body:u64, clauses:u64, discarded:bool) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, clauses), make ProtectedBlock {
        body <- make NodeId { revision <- result.revision; index <- body; };
        clause_tail <- make NodeId { revision <- result.revision; index <- clauses; };
        discarded <- discarded;
    });
}

func parse_try(source:const SourceBytes in S, tokens:const Tokens in T,
               nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val begin <- result.next;
    val first <- tokens[begin].first;
    result.next <- begin + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val last <- parse_guard_clauses(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    if (last == no_node()) {
        result.next <- begin;
        result.diagnostic <- expected_try_clause();
        return;
    } else {};
    append_protected_block(nodes, result, first, body, last, false);
}

export func parse_symbol(tokens:const Tokens in T, nodes:ExprNodes in A,
                         result:ParseResult in R, past:u64) -> bool
    where {const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != symbol_name()) {
        result.diagnostic <- expected_symbol();
        return false;
    } else {};
    val first <- tokens[at].first;
    append_syntax_node(nodes, result, first, tokens[at].past, make SymbolReference {});
    if (result.diagnostic != 0u8) return false;
    result.next <- at + 1u64;
    return true;
}

func parse_behave(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_symbol(tokens, nodes, result, past)) return;
    val callee <- result.root;
    val end <- syntax_past(nodes, result.used, callee);
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) == 40u8) { # '('
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
            arguments <- parse_arguments(source, tokens, nodes, result, past, false, false);
            if (result.diagnostic != 0u8) return;
        } else {};
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void;
    } else {};
    ref operands = make NoLink {};
    if (arguments != no_node()) {
        operands = make LinkTo { node <- make NodeId { revision <- result.revision; index <- arguments; }; };
        {};
    };
    append_syntax_node(nodes, result, first, end, make SymbolicInvocation {
        callee <- make NodeId { revision <- result.revision; index <- callee; };
        arguments <- operands;
    });
}

func parse_completion(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R,
                      past:u64, kind:u8, guard_arm:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    val following <- punct_at(source, tokens, result.next, past);
    if (following == 59u8 || following == 125u8 ||
        (guard_arm && result.next < past && else_word(source, tokens[result.next]))) {
        if (kind == return_node()) {
            append_syntax_node(nodes, result, first, tokens[at].past, make ReturnVoid {});
        } else {
            if (kind == continue_node()) {
                append_syntax_node(nodes, result, first, tokens[at].past, make ContinueVoid {});
            } else {
                if (kind == break_node()) {
                    append_syntax_node(nodes, result, first, tokens[at].past, make BreakVoid {});
                } else {
                    append_syntax_node(nodes, result, first, tokens[at].past, make RaisePending {});
                };
            };
        };
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    if (kind == return_node()) {
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, operand), make ReturnValue {
            value <- make NodeId { revision <- result.revision; index <- operand; };
        });
        return;
    };
    if (kind == continue_node() || kind == break_node()) {
        val end <- syntax_past(nodes, result.used, operand);
        ref value = make NodeId { revision <- result.revision; index <- operand; };
        if (kind == continue_node()) {
            append_syntax_node(nodes, result, first, end, make ContinueValue { value <- value; });
        } else {
            append_syntax_node(nodes, result, first, end, make BreakValue { value <- value; });
        };
        return;
    };
    val cause <- no_node();
    if (result.next < past && from_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        (cause <- result.root):void;
    } else {};
    if (name_syntax(nodes, result.used, operand) == OrdinaryName &&
        punct_at(source, tokens, result.next, past) == 123u8) {
        val fields <- parse_initializer_fields(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        val fields_end <- tokens[result.next].past;
        result.next <- result.next + 1u64;
        append_named_throw(nodes, result, first, fields_end, operand, fields, cause);
        return;
    };
    if (cause != no_node()) {
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, cause), make RaiseWithCause {
            exception_value <- make NodeId { revision <- result.revision; index <- operand; };
            explicit_cause <- make NodeId { revision <- result.revision; index <- cause; };
        });
        return;
    } else {};
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, operand), make RaiseValue {
        exception_value <- make NodeId { revision <- result.revision; index <- operand; };
    });
}

func binding_has_owner(nodes:const ExprNodes in A, result:const ParseResult in R, at:u64) -> bool
    where {const owner A, const owner R} {
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    return inspect_binding(nodes, result.revision, result.used, at, binding) == TypedBinding &&
        binding.owner_name != no_node();
}

func append_local_binding(nodes:ExprNodes in A, result:ParseResult in R, first:u64,
                          binding:u64, initializer:u64, operator_at:u64, mode:LocalMode, declaration_const:bool) -> void
    where {owner A, owner R} {
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, initializer), make LocalBinding {
        binding <- make NodeId { revision <- result.revision; index <- binding; };
        initializer <- make NodeId { revision <- result.revision; index <- initializer; };
        operator_at <- operator_at; mode <- mode; declaration_const <- declaration_const;
    });
}

func parse_local_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R,
                         past:u64, mode:LocalMode, declaration_const:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + (if (declaration_const) { 2u64 } else { 1u64 });
    if (!parse_local_binding_name(source, tokens, nodes, result, past, mode == PointerLocal)) return;
    val binding <- result.root;
    val assignment <- result.next;
    val valid <- if (mode != ValueLocal) {
        punct_at(source, tokens, assignment, past) == 61u8 # '='
    } else {
        punct_pair_at(source, tokens, assignment, past, 60u8, 45u8) # '<-'
    };
    if (!valid) { result.diagnostic <- expected_binding_operator(); return; } else {};
    val first_operand <- assignment + 1u64;
    result.next <- first_operand;
    val supplied <- result.supplied_here;
    val in_case <- result.case_control;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) {
        result.supplied_here <- supplied;
        result.case_control <- in_case;
        if (!recover_syntax(source, tokens, nodes, result, first_operand, past, InitializerRole)) return
    };
    val initializer <- result.root;
    append_local_binding(nodes, result, first, binding, initializer, tokens[assignment].first, mode, declaration_const);
}

func parse_null(source:const SourceBytes in S, tokens:const Tokens in T,
                nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    if (result.next < past && in_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
        val owner_name <- result.root;
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, owner_name), make NullLiteral {
            owner_name <- make LinkTo { node <- make NodeId { revision <- result.revision; index <- owner_name; }; };
        });
        return;
    } else {};
    append_syntax_node(nodes, result, first, tokens[at].past, make NullLiteral { owner_name <- make NoLink {}; });
}

func parse_conditional(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_condition_open(); return; } else {};
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val condition <- result.root;
    if (punct_at(source, tokens, result.next, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    result.next <- result.next + 1u64;
    val single_return <- result.next < past && return_word(source, tokens[result.next]);
    if (single_return) {
        parse_completion(source, tokens, nodes, result, past, return_node(), true);
    } else {
        parse_block(source, tokens, nodes, result, past);
    };
    if (result.diagnostic != 0u8) return;
    val yes <- result.root;
    # Use the return terminator as the outer separator unless an else follows it.
    if (single_return && punct_at(source, tokens, result.next, past) == 59u8 &&
        result.next + 1u64 < past && else_word(source, tokens[result.next + 1u64])) {
        (result.next <- result.next + 1u64):void;
    } else {};
    if (result.next < past && else_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (result.next < past && if_word(source, tokens[result.next])) {
            parse_conditional(source, tokens, nodes, result, past);
        } else {
            parse_block(source, tokens, nodes, result, past);
        };
    } else {
        val end <- syntax_past(nodes, result.used, yes);
        append_block(nodes, result, end, end, no_node(), false);
    };
    if (result.diagnostic != 0u8) return;
    val no <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, no), make Conditional {
        condition <- make NodeId { revision <- result.revision; index <- condition; };
        consequent <- make NodeId { revision <- result.revision; index <- yes; };
        alternative <- make NodeId { revision <- result.revision; index <- no; };
    });
}

func parse_range(source:const SourceBytes in S, tokens:const Tokens in T,
                 nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- result.next + 1u64;
    if (result.next < past && reserved_lexical_binder(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val index <- result.root;
    if (result.next >= past || !in_word(source, tokens[result.next])) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val lower <- result.root;
    val separator <- result.next;
    if (!punct_pair_at(source, tokens, separator, past, 46u8, 46u8)) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- separator + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val upper <- result.root;
    if (punct_at(source, tokens, result.next, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, index), tokens[result.next].past, make RangeHeader {
        index_binding <- make NodeId { revision <- result.revision; index <- index; };
        lower <- make NodeId { revision <- result.revision; index <- lower; };
        upper <- make NodeId { revision <- result.revision; index <- upper; };
        separator <- tokens[separator].first;
    });
    if (result.diagnostic != 0u8) return;
    val header <- result.root;
    result.next <- result.next + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    ref empty = make NoLink {};
    if (result.next < past && else_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        empty = make LinkTo { node <- make NodeId { revision <- result.revision; index <- result.root; }; };
        {};
    } else {};
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, result.root), make RangeLoop {
        header <- make NodeId { revision <- result.revision; index <- header; };
        body <- make NodeId { revision <- result.revision; index <- body; };
        empty <- empty;
    });
}

func parse_exception_local(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R,
                           past:u64, width:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + width;
    if (!parse_binding_name(source, tokens, nodes, result, past, true, true, false)) return;
    val binding <- result.root;
    val assignment <- result.next;
    if (binding_has_owner(nodes, result, binding) ||
        !punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return;
    } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    append_local_binding(nodes, result, first, binding, initializer, tokens[assignment].first, ExceptionLocal, false);
}

export func callable_local_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (at >= past) return false;
    val mode <- if (const_word(source, tokens[at])) { at + 1u64 } else { at };
    if (mode + 2u64 >= past || tokens[mode + 1u64].kind != identifier() ||
        (!func_word(source, tokens[mode]) && !proc_word(source, tokens[mode]))) return false;
    val next <- punct_at(source, tokens, mode + 2u64, past);
    return next == 61u8 || next == 58u8; # '=' or ':'
}

func parse_callable_local(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val fixed <- const_word(source, tokens[result.next]);
    if (fixed) { (result.next <- result.next + 1u64):void; } else {};
    val function_mode <- func_word(source, tokens[result.next]);
    result.next <- result.next + 1u64;
    if (!parse_binding_name(source, tokens, nodes, result, past, false, false, false)) return;
    val binding <- result.root;
    val assignment <- result.next;
    if (punct_at(source, tokens, assignment, past) != 61u8) {
        result.diagnostic <- expected_binding_operator();
        return;
    } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, initializer), make LocalCallableSlot {
        binding <- make NodeId { revision <- result.revision; index <- binding; };
        initializer <- make NodeId { revision <- result.revision; index <- initializer; };
        function_form <- function_mode; fixed <- fixed; operator_at <- tokens[assignment].first;
    });
}

func handle_local_prefix(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (at + 1u64 < past && handle_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier())
        return 1u64;
    val qualifier <- if (const_word(source, tokens[at])) { at + 1u64 } else { at };
    if (qualifier + 1u64 < past && own_word(source, tokens[qualifier]) && handle_word(source, tokens[qualifier + 1u64]))
        return qualifier + 2u64 - at;
    return 0u64;
}

func parse_handle_local(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R,
                        past:u64, width:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val owning <- width != 1u64;
    result.next <- result.next + width;
    if (!parse_binding_name(source, tokens, nodes, result, past, true, false, false)) return;
    val binding <- result.root;
    if (owning && binding_has_owner(nodes, result, binding)) {
        result.diagnostic <- expected_handle_constructor();
        return;
    } else {};
    val assignment <- result.next;
    val valid <- if (owning) { punct_pair_at(source, tokens, assignment, past, 60u8, 45u8) }
                 else { punct_at(source, tokens, assignment, past) == 61u8 };
    if (!valid) { result.diagnostic <- expected_binding_operator(); return; } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    ref bound = make NodeId { revision <- result.revision; index <- binding; };
    ref supplied = make NodeId { revision <- result.revision; index <- initializer; };
    val end <- syntax_past(nodes, result.used, initializer);
    val operator_at <- tokens[assignment].first;
    if (owning) {
        append_syntax_node(nodes, result, first, end, make OwningHandleBinding {
            binding <- bound; initializer <- supplied; readonly <- width == 3u64; operator_at <- operator_at;
        });
    } else {
        append_syntax_node(nodes, result, first, end, make BorrowedHandleBinding {
            binding <- bound; initializer <- supplied; operator_at <- operator_at;
        });
    };
}

func parse_region_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 2u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val name <- result.root;
    if (punct_at(source, tokens, result.next, past) != 58u8) { result.diagnostic <- expected_type(); return; };
    result.next <- result.next + 1u64;
    val readonly <- result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val schema <- result.root;
    if (!punct_pair_at(source, tokens, result.next, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return;
    };
    val transfer_at <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val input <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, input), make OwningRegionBinding {
        name <- make NodeId { revision <- result.revision; index <- name; };
        schema <- make NodeId { revision <- result.revision; index <- schema; };
        input <- make NodeId { revision <- result.revision; index <- input; };
        readonly <- readonly;
        transfer_at <- transfer_at;
    });
}

func parse_array_length(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    val selected <- start + 2u64;
    val open <- start + 4u64;
    if (open >= past || punct_at(source, tokens, start + 1u64, past) != 40u8 ||
        !len_word(source, tokens[selected]) || punct_at(source, tokens, start + 3u64, past) != 41u8 ||
        punct_at(source, tokens, open, past) != 40u8) {
        result.diagnostic <- expected_array_length_query();
        return;
    } else {};
    result.next <- open + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    append_syntax_node(nodes, result, tokens[start].first, tokens[close].past, make ArrayLength {
        target <- make NodeId { revision <- result.revision; index <- operand; };
        intrinsic_at <- tokens[selected].first;
    });
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func starts_short_case_arm(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (first >= past || tokens[first].kind != identifier()) return false;
    val next <- first + 1u64;
    if (punct_at(source, tokens, next, past) == 124u8 ||
        punct_pair_at(source, tokens, next, past, 45u8, 62u8)) return true;
    if (punct_at(source, tokens, next, past) != 123u8) return false;
    val close <- closing_token(tokens, next, past);
    if (close == no_node()) return false;
    return punct_at(source, tokens, close + 1u64, past) == 124u8 ||
        punct_pair_at(source, tokens, close + 1u64, past, 45u8, 62u8)
}

# Grouped expressions and labelled arguments keep their usual grammar.
func starts_case_arm(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (starts_short_case_arm(source, tokens, first, past)) return true;
    if (punct_at(source, tokens, first, past) != 40u8) return false; # '('
    val close <- closing_token(tokens, first, past);
    if (close == no_node()) return false;
    val following <- close + 1u64;
    if (punct_at(source, tokens, following, past) == 124u8) return true; # '|'
    return punct_pair_at(source, tokens, following, past, 45u8, 62u8) &&
        (punct_at(source, tokens, following + 1u64, past) == 123u8 ||
         (following + 1u64 < past && throw_word(source, tokens[following + 1u64])))
}

func append_case_pattern(source:const SourceBytes in S, token:const Token in T,
                         nodes:ExprNodes in A, result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    if (true_word(source, token) || false_word(source, token)) {
        append_syntax_node(nodes, result, token.first, token.past, make BooleanCasePattern { truth <- true_word(source, token); });
        return;
    };
    if (null_word(source, token)) {
        append_syntax_node(nodes, result, token.first, token.past, make NullCasePattern {});
        return;
    };
    append_syntax_node(nodes, result, token.first, token.past, make MemberCasePattern {});
}

func parse_case_value_receiver(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                               result:ParseResult in R, past:u64, preceding:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past || !val_word(source, tokens[start])) {
        result.diagnostic <- unsupported_case_pattern();
        return false;
    };
    val first <- tokens[start].first;
    result.next <- start + 1u64;
    if (result.next < past && reserved_lexical_binder(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return false;
    };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    val destination <- result.root;
    val operator <- result.next;
    if (!punct_pair_at(source, tokens, operator, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return false;
    };
    result.next <- operator + 1u64;
    ref selected = make NoLink {};
    val last <- tokens[operator].past;
    val delimiter <- punct_at(source, tokens, result.next, past);
    if (delimiter != 59u8 && delimiter != 125u8) {
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        selected = make LinkTo { node <- make NodeId { revision <- result.revision; index <- result.root; }; };
        (last <- syntax_past(nodes, result.used, result.root)):void;
    };
    if (punct_at(source, tokens, result.next, past) != 59u8) {
        result.diagnostic <- expected_block_separator();
        return false;
    };
    result.next <- result.next + 1u64;
    ref previous = make NoLink {};
    if (preceding != no_node()) {
        previous = make LinkTo { node <- make NodeId { revision <- result.revision; index <- preceding; }; };
        {};
    };
    append_syntax_node(nodes, result, first, last, make CaseValueReceiver {
        previous <- previous;
        destination <- make NodeId { revision <- result.revision; index <- destination; };
        selected_field <- selected;
        transfer_at <- tokens[operator].first;
    });
    return result.diagnostic == 0u8;
}

func finish_constructor_case(tokens:const Tokens in T, nodes:ExprNodes in A, result:ParseResult in R,
                             first:u64, constructor:u64, receiver:u64) -> bool
    where {const owner T, owner A, owner R} {
    val end <- tokens[result.next].past;
    result.next <- result.next + 1u64;
    ref receivers = make NoLink {};
    if (receiver != no_node()) {
        receivers = make LinkTo { node <- make NodeId { revision <- result.revision; index <- receiver; }; };
        {};
    };
    append_syntax_node(nodes, result, first, end, make ConstructorCasePattern {
        constructor <- make NodeId { revision <- result.revision; index <- constructor; };
        receivers <- receivers;
    });
    return result.diagnostic == 0u8;
}

func parse_constructor_case(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                            result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past || reserved_module_name(source, tokens[start]) ||
        !parse_identifier(source, tokens, nodes, result, past, expected_name())) {
        if (result.diagnostic == 0u8) { (result.diagnostic <- expected_name()):void; };
        return false;
    };
    val constructor <- result.root;
    val first <- tokens[start].first;
    result.next <- result.next + 1u64;
    val receiver <- no_node();
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8)
            return finish_constructor_case(tokens, nodes, result, first, constructor, receiver);
        if (!parse_case_value_receiver(source, tokens, nodes, result, past, receiver)) return false;
        receiver <- result.root;
    };
    result.diagnostic <- expected_block_close();
    return false;
}

func parse_short_case_body(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at < past &&
        (return_word(source, tokens[at]) || break_word(source, tokens[at]) || continue_word(source, tokens[at]) ||
         rethrow_word(source, tokens[at]) || defer_word(source, tokens[at]) || fallthrough_word(source, tokens[at]))) {
        result.diagnostic <- expected_block();
        return
    };
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val expression <- result.root;
    val first <- syntax_first(nodes, result.used, expression);
    val end <- syntax_past(nodes, result.used, expression);
    append_block_item(nodes, result, first, end, no_node(), expression);
    if (result.diagnostic != 0u8) return;
    append_block(nodes, result, first, end, result.root, false)
}

func parse_case_arm(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                    result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val head <- result.next;
    val first <- tokens[head].first;
    val short <- starts_short_case_arm(source, tokens, head, past);
    val pattern <- no_node();
    val guard <- no_node();
    val at <- if (short) { head } else { head + 1u64 };
    result.next <- at;
    if (punct_at(source, tokens, at + 1u64, past) == 123u8) {
        if (!parse_constructor_case(source, tokens, nodes, result, past)) return;
        (pattern <- result.root):void;
    } else {
        if (short || punct_at(source, tokens, at, past) != 41u8) {
            if (at >= past || tokens[at].kind != identifier() ||
                (short && reserved_module_name(source, tokens[at])) ||
                (!short && punct_at(source, tokens, at + 1u64, past) != 41u8)) {
                result.diagnostic <- unsupported_case_pattern();
                return
            };
            if (tokens[at].past - tokens[at].first != 1u64 || source[tokens[at].first] != 95u8) {
                append_case_pattern(source, tokens[at], nodes, result);
                if (result.diagnostic != 0u8) return;
                (pattern <- result.root):void
            };
            (result.next <- at + 1u64):void
        }
    };
    if (!short) {
        if (punct_at(source, tokens, result.next, past) != 41u8) {
            result.diagnostic <- expected_close();
            return
        };
        (result.next <- result.next + 1u64):void
    };
    if (punct_at(source, tokens, result.next, past) == 124u8) {
        result.next <- result.next + 1u64;
        if (!punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
            parse_expression_at(source, tokens, nodes, result, past, 1u8);
            if (result.diagnostic != 0u8) return;
            (guard <- result.root):void
        }
    };
    val arrow <- result.next;
    if (!punct_pair_at(source, tokens, arrow, past, 45u8, 62u8)) {
        result.diagnostic <- expected_case_arrow();
        return;
    } else {};
    val body_at <- arrow + 1u64;
    result.next <- body_at;
    if (body_at < past && throw_word(source, tokens[body_at])) {
        if (pattern != no_node() || guard != no_node()) {
            result.diagnostic <- invalid_throwing_case_arm();
            return;
        } else {};
        append_syntax_node(nodes, result, tokens[body_at].first, tokens[body_at].past, make CaseFailure {});
        if (result.diagnostic != 0u8) return;
        (result.next <- body_at + 1u64):void;
    } else {
        if (!short || punct_at(source, tokens, body_at, past) == 123u8) {
            parse_block(source, tokens, nodes, result, past)
        } else {
            parse_short_case_body(source, tokens, nodes, result, past)
        }
    };
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    ref pattern_link = make NoLink {};
    if (pattern != no_node()) {
        pattern_link = make LinkTo { node <- make NodeId { revision <- result.revision; index <- pattern; }; };
        {};
    };
    ref guard_link = make NoLink {};
    if (guard != no_node()) {
        guard_link = make LinkTo { node <- make NodeId { revision <- result.revision; index <- guard; }; };
        {};
    };
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, body), make CaseArm {
        pattern <- pattern_link; guard <- guard_link;
        body <- make NodeId { revision <- result.revision; index <- body; };
        arrow <- tokens[arrow].first;
    });
}

func append_case_expression(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64, subject:u64, tail:u64)
    -> void where {owner A, owner R} {
    ref items = make NoLink {};
    if (tail != no_node()) {
        items = make LinkTo { node <- make NodeId { revision <- result.revision; index <- tail; }; };
        {};
    };
    append_syntax_node(nodes, result, first, past, make CaseExpression {
        subject <- make NodeId { revision <- result.revision; index <- subject; };
        items <- items;
    });
}

func parse_case_items(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                      result:ParseResult in R, past:u64, subject:u64, first:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 123u8) { result.diagnostic <- expected_block(); return; } else {};
    val last <- no_node();
    val close <- open;
    val arm <- false;
    result.next <- open + 1u64;
    for (unused in result.next .. past + 1u64) {
        close <- result.next;
        if (punct_at(source, tokens, close, past) == 125u8) {
            append_case_expression(nodes, result, first, tokens[close].past, subject, last);
            if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
            return;
        } else {};
        if (close >= past) { result.diagnostic <- expected_block_close(); return; } else {};
        arm <- starts_case_arm(source, tokens, close, past);
        if (!parse_block_item(source, tokens, nodes, result, past, last, false, arm)) return;
        last <- result.root;
    };
    (result.diagnostic <- expected_block_close()):void;
}

func parse_case(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val subject <- result.root;
    val at <- result.next;
    if (at >= past || !of_word(source, tokens[at])) { result.diagnostic <- expected_case_of(); return; } else {};
    val enclosing <- result.case_control;
    result.case_control <- true;
    result.next <- at + 1u64;
    parse_case_items(source, tokens, nodes, result, past, subject, first);
    (result.case_control <- enclosing):void;
}

func utf8_width(source:const SourceBytes in S, at:u64, past:u64) -> u64 where {const owner S} {
    val lead <- source[at];
    if (lead < 128u8) return 1u64;
    if (lead < 194u8 || lead > 244u8) return 0u64;
    val width <- if (lead <= 223u8) { 2u64 } else { if (lead <= 239u8) { 3u64 } else { 4u64 } };
    if (past - at < width) return 0u64;
    val second <- source[at + 1u64];
    if (second < 128u8 || second > 191u8 ||
        (lead == 224u8 && second < 160u8) || (lead == 237u8 && second > 159u8) ||
        (lead == 240u8 && second < 144u8) || (lead == 244u8 && second > 143u8)) return 0u64;
    for (tail in at + 2u64 .. at + width) {
        if (source[tail] < 128u8 || source[tail] > 191u8) return 0u64;
    };
    return width;
}

func hex_digit(byte:u8) -> u64 {
    val digit:u64 <- byte;
    if (byte >= 48u8 && byte <= 57u8) return digit - 48u64;
    if (byte >= 65u8 && byte <= 70u8) return digit - 55u64;
    if (byte >= 97u8 && byte <= 102u8) return digit - 87u64;
    return 16u64;
}

func unicode_escape(source:const SourceBytes in S, brace:u64, past:u64, contains_zero:bool in N) -> u64
    where {const owner S, owner N} {
    if (brace + 1u64 >= past || source[brace] != 123u8) return no_node();
    val codepoint <- 0u64;
    val digit <- 0u64;
    for (at in brace + 1u64 .. past) {
        if (source[at] == 125u8) {
            if (at == brace + 1u64 || (codepoint >= 55296u64 && codepoint <= 57343u64)) return no_node();
            if (codepoint == 0u64) { (contains_zero <- true):void; } else {};
            return at + 1u64;
        } else {};
        digit <- hex_digit(source[at]);
        if (digit == 16u64) return no_node();
        codepoint <- codepoint * 16u64 + digit;
        if (codepoint > 1114111u64) return no_node();
    };
    return no_node();
}

func append_text_literal(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                          contains_zero:bool) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, first, past, make TextLiteral { interior_zero <- contains_zero; });
}

func parse_text_literal(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                        result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val end <- tokens[result.next].past;
    val multiline <- tokens[result.next].kind == multiline_text();
    val delimiter <- if (multiline) { 3u64 } else { 1u64 };
    if (end < first || end - first < 2u64 * delimiter || end > intrinsic (len)(source)) {
        result.diagnostic <- invalid_text_literal();
        return
    };
    val at <- first + delimiter;
    val past <- end - delimiter;
    val byte <- 0u8;
    val width <- 0u64;
    val contains_zero <- false;
    for (unused in first .. end) {
        if (at == past) {
            append_text_literal(nodes, result, first, end, contains_zero);
            if (result.diagnostic == 0u8) { (result.next <- result.next + 1u64):void; } else {};
            return;
        } else {};
        byte <- source[at];
        if (!multiline && (byte == 13u8 || byte == 10u8)) {
            result.diagnostic <- invalid_text_literal();
            return
        };
        if (byte == 92u8) {
            at <- at + 1u64;
            if (at >= past) { result.diagnostic <- invalid_text_literal(); return; } else {};
            byte <- source[at];
            if (byte == 117u8) {
                at <- unicode_escape(source, at + 1u64, past, contains_zero);
                if (at == no_node()) { result.diagnostic <- invalid_text_literal(); return; } else {};
            } else {
                if (byte == 48u8) { (contains_zero <- true):void; } else {
                    if (byte != 34u8 && byte != 92u8 && byte != 110u8 && byte != 114u8 && byte != 116u8) {
                        result.diagnostic <- invalid_text_literal();
                        return;
                    } else {};
                };
                (at <- at + 1u64):void;
            };
        } else {
            if (byte == 0u8) { (contains_zero <- true):void; } else {};
            width <- utf8_width(source, at, past);
            if (width == 0u64) { result.diagnostic <- invalid_text_literal(); return; } else {};
            (at <- at + width):void;
        };
    };
}

func parse_callable_body(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val supplied_here <- result.supplied_here;
    val case_control <- result.case_control;
    result.supplied_here <- false;
    result.case_control <- false;
    parse_block(source, tokens, nodes, result, past);
    result.supplied_here <- supplied_here;
    result.case_control <- case_control;
    return;
}

func parse_scoped_procedure(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R, past:u64, first:u64, name:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_scoped_procedure_signature(source, tokens, nodes, result, past, name);
    if (result.diagnostic != 0u8) return;
    val header <- result.root;
    parse_callable_body(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, body), make ScopedProcedureDefinition {
        header <- make NodeId { revision <- result.revision; index <- header; };
        body <- make NodeId { revision <- result.revision; index <- body; };
    });
}

func parse_effect(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_symbol(tokens, nodes, result, past)) return;
    val name <- result.root;
    val assignment <- result.next;
    if (punct_at(source, tokens, assignment, past) == 40u8) {
        parse_scoped_procedure(source, tokens, nodes, result, past, first, name);
        return;
    };
    val bind <- punct_at(source, tokens, assignment, past) == 61u8;
    if (!bind && !punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return;
    } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    ref destination = make NodeId { revision <- result.revision; index <- name; };
    ref input = make NodeId { revision <- result.revision; index <- initializer; };
    val end <- syntax_past(nodes, result.used, initializer);
    val operator_at <- tokens[assignment].first;
    if (bind) {
        append_syntax_node(nodes, result, first, end, make BindSymbolEffect {
            name <- destination; input <- input; operator_at <- operator_at;
        });
    } else {
        append_syntax_node(nodes, result, first, end, make InstallSymbolEffect {
            name <- destination; acquisition <- input; operator_at <- operator_at;
        });
    };
}

export func parse_callable(source:const SourceBytes in S, tokens:const Tokens in T,
                    nodes:ExprNodes in A, result:ParseResult in R, past:u64, function_form:bool, lexical:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val native <- result.next < past && tokens[result.next].kind == quoted_text();
    if (native) {
        if (lexical || !c_linkage(source, tokens[result.next])) {
            result.diagnostic <- expected_c_linkage();
            return;
        } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    parse_callable_signature(source, tokens, nodes, result, past, native, !native && !lexical);
    if (result.diagnostic != 0u8) return;
    val header <- result.root;
    if (native && punct_at(source, tokens, result.next, past) == 59u8) {
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, header), make CProviderDeclaration {
            header <- make NodeId { revision <- result.revision; index <- header; };
            function_form <- function_form
        });
        return;
    } else {};
    parse_callable_body(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val end <- syntax_past(nodes, result.used, body);
    ref signature = make NodeId { revision <- result.revision; index <- header; };
    ref implementation = make NodeId { revision <- result.revision; index <- body; };
    if (native) {
        append_syntax_node(nodes, result, first, end, make CEntryDefinition {
            header <- signature;
            body <- implementation;
            function_form <- function_form
        })
    } else {
        append_syntax_node(nodes, result, first, end, make CallableDefinition {
            header <- signature; body <- implementation; function_form <- function_form; lexical <- lexical;
        });
    };
}

func parse_primary(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_operand(); return; } else {};
    val first <- tokens[at].first;
    if (tokens[at].kind == quoted_text() || tokens[at].kind == multiline_text()) {
        parse_text_literal(source, tokens, nodes, result);
        return
    };
    if (effect_word(source, tokens[at])) { parse_effect(source, tokens, nodes, result, past); return; } else {};
    if (if_word(source, tokens[at])) { parse_conditional(source, tokens, nodes, result, past); return; } else {};
    if (case_word(source, tokens[at])) { parse_case(source, tokens, nodes, result, past); return; } else {};
    if (for_word(source, tokens[at])) { parse_range(source, tokens, nodes, result, past); return; } else {};
    if (defer_word(source, tokens[at])) {
        parse_defer(source, tokens, nodes, result, past);
        return;
    } else {};
    if (try_word(source, tokens[at])) { parse_try(source, tokens, nodes, result, past); return; } else {};
    if (rethrow_word(source, tokens[at]) && at + 1u64 < past && from_word(source, tokens[at + 1u64])) {
        result.next <- at + 2u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        val cause <- result.root;
        append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, cause), make RethrowWithCause {
            explicit_cause <- make NodeId { revision <- result.revision; index <- cause; };
        });
        return;
    } else {};
    if (throw_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, throw_node(), false);
        return;
    } else {};
    if (return_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, return_node(), false);
        return;
    } else {};
    if (result.case_control && fallthrough_word(source, tokens[at]) &&
        (punct_at(source, tokens, at + 1u64, past) == 59u8 || punct_at(source, tokens, at + 1u64, past) == 125u8)) {
        append_syntax_node(nodes, result, first, tokens[at].past, make CaseFallthrough {});
        if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
        return;
    } else {};
    if ((result.supplied_here || result.case_control) && (continue_word(source, tokens[at]) || break_word(source, tokens[at]))) {
        val handoff_kind <- if (continue_word(source, tokens[at])) { continue_node() } else { break_node() };
        parse_completion(source, tokens, nodes, result, past, handoff_kind, false);
        return;
    } else {};
    val exception_width <- exception_binder_width(source, tokens, at, past);
    if (exception_width != 0u64) { parse_exception_local(source, tokens, nodes, result, past, exception_width); return; } else {};
    val handle_width <- handle_local_prefix(source, tokens, at, past);
    if (handle_width != 0u64) { parse_handle_local(source, tokens, nodes, result, past, handle_width); return; } else {};
    if (at + 1u64 < past && own_word(source, tokens[at]) && region_word(source, tokens[at + 1u64])) {
        parse_region_binding(source, tokens, nodes, result, past);
        return;
    };
    if (make_word(source, tokens[at])) { parse_construction(source, tokens, nodes, result, past); return; } else {};
    if (callable_local_head(source, tokens, at, past)) { parse_callable_local(source, tokens, nodes, result, past); return; } else {};
    if (at + 1u64 < past && tokens[at + 1u64].kind == identifier() &&
        (func_word(source, tokens[at]) || proc_word(source, tokens[at]))) {
        parse_callable(source, tokens, nodes, result, past, func_word(source, tokens[at]), true);
        return;
    };
    if (ref_word(source, tokens[at]) && at + 1u64 < past && tokens[at + 1u64].kind == identifier()) {
        parse_local_binding(source, tokens, nodes, result, past, ReferenceLocal, false);
        return;
    } else {};
    if (const_word(source, tokens[at]) && at + 1u64 < past && val_word(source, tokens[at + 1u64])) {
        parse_local_binding(source, tokens, nodes, result, past, ValueLocal, true);
        return;
    };
    if (val_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, ValueLocal, false); return; } else {};
    if (ptr_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, PointerLocal, false); return; } else {};
    if (null_word(source, tokens[at])) { parse_null(source, tokens, nodes, result, past); return; } else {};
    if (behave_word(source, tokens[at])) { parse_behave(source, tokens, nodes, result, past); return; } else {};
    if (intrinsic_word(source, tokens[at])) { parse_array_length(source, tokens, nodes, result, past); return; } else {};
    if (tokens[at].kind == symbol_name()) { (parse_symbol(tokens, nodes, result, past)):void; return; } else {};
    if (punct_at(source, tokens, at, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        return;
    } else {};
    if (punct_at(source, tokens, at, past) == 40u8) { # '('
        result.next <- at + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        val close <- result.next;
        if (punct_at(source, tokens, close, past) != 41u8) { # ')'
            result.diagnostic <- expected_close();
            return;
        } else {};
        val inner <- result.root;
        append_parenthesized(nodes, result, first, tokens[close].past, inner);
        if (result.diagnostic != 0u8) return;
        (result.next <- close + 1u64):void;
        return;
    } else {};
    val truth <- true_word(source, tokens[at]);
    if (truth || false_word(source, tokens[at])) {
        append_syntax_node(nodes, result, first, tokens[at].past, make BooleanLiteral { truth <- truth; });
        if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
        return;
    } else {};
    if (tokens[at].kind == integer_literal()) {
        val width <- integer_width(source, tokens[at]);
        val number <- parse_literal(source, tokens[at], result, width);
        if (result.diagnostic != 0u8) return;
        append_syntax_node(nodes, result, first, tokens[at].past, make IntegerLiteral {
            magnitude <- number;
            width <- width;
        });
    } else {
        if (tokens[at].kind != identifier() || reserved_value_name(source, tokens[at])) {
            result.diagnostic <- expected_operand();
            return;
        } else {};
        append_syntax_node(nodes, result, first, tokens[at].past, make NameReference {});
    };
    if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
}

func begins_checked_ref_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                                 at:u64, past:u64) -> bool where {const owner S, const owner T} {
    val operand <- at + 2u64;
    if (operand >= past || !not_word(source, tokens[at]) || !null_word(source, tokens[at + 1u64]) ||
        in_word(source, tokens[operand])) return false;
    val kind <- tokens[operand].kind;
    val punct <- punct_at(source, tokens, operand, past);
    return kind == identifier() || kind == integer_literal() || kind == symbol_name() ||
        punct == 40u8 || punct == 123u8 || punct == 33u8;
}

# Each argument entry links to the previous entry and its ordinary expression.
# The checked ref bit belongs to preparation at this call site.
func append_argument(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                     preceding:u64, operand:u64, checked:bool, selection_at:u64) -> void where {owner A, owner R} {
    ref previous = make NoLink {};
    if (preceding != no_node()) {
        previous = make LinkTo { node <- make NodeId { revision <- result.revision; index <- preceding; }; };
        {};
    };
    append_syntax_node(nodes, result, first, past, make ArgumentItem {
        previous <- previous;
        operand <- make NodeId { revision <- result.revision; index <- operand; };
        checked_ref <- checked;
        selection_at <- selection_at;
    });
}

func parse_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                    nodes:ExprNodes in A, result:ParseResult in R,
                    first:u64, previous:u64, past:u64, named:bool, field_labels:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val argument <- no_node();
    val start <- result.next;
    val operand_first <- tokens[start].first;
    val checked <- named && !field_labels && begins_checked_ref_argument(source, tokens, start, past);
    if (checked) { (result.next <- start + 2u64):void; } else {};
    if (!named || !punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return false;
        (argument <- result.root):void;
    } else {};
    if (named && punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
        val arrow <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!field_labels && result.next < past && reserved_value_name(source, tokens[result.next])) {
            result.diagnostic <- expected_name();
            return false;
        } else {};
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        val label <- result.root;
        val named_first <- if (argument == no_node()) { arrow } else { operand_first };
        ref operand = make NoLink {};
        if (argument != no_node()) {
            operand = make LinkTo { node <- make NodeId { revision <- result.revision; index <- argument; }; };
            {};
        };
        append_syntax_node(nodes, result, named_first, syntax_past(nodes, result.used, label), make NamedArgument {
            operand <- operand; label <- make NodeId { revision <- result.revision; index <- label; }; arrow <- arrow;
        });
        if (result.diagnostic != 0u8) return false;
        (argument <- result.root):void;
    } else {};
    append_argument(nodes, result, if (checked) { operand_first } else { first },
                    syntax_past(nodes, result.used, argument), previous, argument, checked, operand_first);
    return result.diagnostic == 0u8;
}

func parse_arguments(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R, past:u64, named:bool, field_labels:bool) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past) { result.diagnostic <- expected_operand(); return no_node(); } else {};
    val prefix <- no_node();
    val list_first <- tokens[start].first;
    val separator <- 0u8;
    for (unused in start .. past) {
        if (!parse_argument(source, tokens, nodes, result, list_first, prefix, past, named, field_labels)) return no_node();
        prefix <- result.root;
        separator <- punct_at(source, tokens, result.next, past);
        if (separator == 41u8) return prefix;
        if (separator != 44u8) {
            result.diagnostic <- expected_argument_separator();
            return no_node();
        } else {};
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_operand();
    return no_node();
}

func parse_initializer_field(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    val name <- result.root;
    val operator_at <- result.next;
    val rebind <- punct_at(source, tokens, operator_at, past) == 61u8;
    if (!rebind && !punct_pair_at(source, tokens, operator_at, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return false;
    } else {};
    result.next <- operator_at + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return false;
    val value <- result.root;
    ref operands = make AssignmentOperands {
        destination <- make NodeId { revision <- result.revision; index <- name; };
        input <- make NodeId { revision <- result.revision; index <- value; };
        operator_at <- tokens[operator_at].first;
    };
    val first <- syntax_first(nodes, result.used, name);
    val end <- syntax_past(nodes, result.used, value);
    if (rebind) {
        append_syntax_node(nodes, result, first, end, make InitializerRebind { operands <- operands; });
    } else {
        append_syntax_node(nodes, result, first, end, make InitializerTransfer { operands <- operands; });
    };
    if (result.diagnostic != 0u8) return false;
    val field <- result.root;
    append_argument(nodes, result, first, end, previous, field, false, first);
    return result.diagnostic == 0u8;
}

func parse_initializer_fields(source:const SourceBytes in S, tokens:const Tokens in T,
                              nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    val tail <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8) return tail;
        if (!parse_initializer_field(source, tokens, nodes, result, past, tail)) return no_node();
        tail <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 125u8) return tail;
        if (delimiter != 59u8) { result.diagnostic <- expected_block_separator(); return no_node(); } else {};
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_block_close();
    return no_node();
}

# A bare or parenthesized name followed by an assignment can select a product
# field or a scalar block's lexical destination. The checked type decides.
func initializer_label(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    val operator_at <- first;
    for (at in first .. past) {
        if (punct_at(source, tokens, at, past) != 40u8) {
            if (tokens[at].kind != identifier()) return no_node();
            operator_at <- at + 1u64;
            for (unused in first .. at) {
                if (punct_at(source, tokens, operator_at, past) != 41u8) return no_node();
                operator_at <- operator_at + 1u64;
            };
            if (punct_at(source, tokens, operator_at, past) == 61u8 ||
                punct_pair_at(source, tokens, operator_at, past, 60u8, 45u8)) return at;
            return no_node();
        } else {};
    };
    return no_node();
}

func append_parenthesized(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                           operand:u64) -> void where {owner A, owner R} {
    append_syntax_node(nodes, result, first, past, make Parenthesized {
        expression <- make NodeId { revision <- result.revision; index <- operand; };
    });
}

func parse_initializer_assignment(source:const SourceBytes in S, tokens:const Tokens in T,
                                  nodes:ExprNodes in A, result:ParseResult in R, past:u64, label:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val left <- label;
    val right <- label;
    val operand <- no_node();
    append_syntax_node(nodes, result, tokens[label].first, tokens[label].past, make NameReference {});
    if (result.diagnostic != 0u8) return;
    for (unused in first .. label) {
        left <- left - 1u64;
        right <- right + 1u64;
        operand <- result.root;
        append_parenthesized(nodes, result, tokens[left].first, tokens[right].past, operand);
        if (result.diagnostic != 0u8) return;
    };
    val destination <- result.root;
    val operator_at <- right + 1u64;
    val rebind <- punct_at(source, tokens, operator_at, past) == 61u8;
    result.next <- operator_at + 1u64;
    parse_expression_operand(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val input <- result.root;
    ref operands = make AssignmentOperands {
        destination <- make NodeId { revision <- result.revision; index <- destination; };
        input <- make NodeId { revision <- result.revision; index <- input; };
        operator_at <- tokens[operator_at].first;
    };
    val end <- syntax_past(nodes, result.used, input);
    if (rebind) {
        append_syntax_node(nodes, result, tokens[first].first, end, make InitializerRebind { operands <- operands; });
    } else {
        append_syntax_node(nodes, result, tokens[first].first, end, make InitializerTransfer { operands <- operands; });
    };
    if (result.diagnostic == 0u8) { parse_result_annotation(source, tokens, nodes, result, past); } else {};
}

func parse_exception_placement(source:const SourceBytes in S, tokens:const Tokens in T,
                               nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val site <- result.next;
    if (site >= past) return no_node();
    val by_capacity <- in_word(source, tokens[site]);
    if (!by_capacity && !from_word(source, tokens[site])) return no_node();
    result.next <- site + 1u64;
    if (by_capacity) {
        if (result.next >= past || !region_word(source, tokens[result.next]) ||
            punct_at(source, tokens, result.next + 1u64, past) != 40u8) {
            result.diagnostic <- invalid_exception_placement();
            return no_node();
        } else {};
        (result.next <- result.next + 2u64):void;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return no_node();
    val operand <- result.root;
    val end <- syntax_past(nodes, result.used, operand);
    if (by_capacity) {
        if (!punct_pair_at(source, tokens, result.next, past, 45u8, 62u8) ||
            result.next + 1u64 >= past || !capacity_word(source, tokens[result.next + 1u64]) ||
            punct_at(source, tokens, result.next + 2u64, past) != 41u8) {
            result.diagnostic <- invalid_exception_placement();
            return no_node();
        } else {};
        end <- tokens[result.next + 2u64].past;
        (result.next <- result.next + 3u64):void;
    } else {};
    ref selected = make NodeId { revision <- result.revision; index <- operand; };
    if (by_capacity) {
        append_syntax_node(nodes, result, tokens[site].first, end, make CapacityPlacement { capacity <- selected; });
    } else {
        append_syntax_node(nodes, result, tokens[site].first, end, make CausePlacement { cause <- selected; });
    };
    return result.root;
}

func parse_construction_type(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R,
                             past:u64, exception:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (exception || at >= past || !typeof_word(source, tokens[at]) || punct_at(source, tokens, at + 1u64, past) != 40u8)
        return parse_identifier(source, tokens, nodes, result, past, expected_type());
    result.next <- at + 2u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return false;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) { result.diagnostic <- expected_close(); return false; } else {};
    val operand <- result.root;
    val first <- tokens[at].first;
    append_syntax_node(nodes, result, first, tokens[close].past, make ConstructionTypeQuery {
        operand <- make NodeId { revision <- result.revision; index <- operand; };
    });
    if (result.diagnostic != 0u8) return false;
    result.next <- close + 1u64;
    return true;
}

func parse_make_handle(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R,
                       past:u64, first:u64, owning:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + if (owning) { 2u64 } else { 1u64 };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val marker <- result.root;
    if (punct_at(source, tokens, result.next, past) != 40u8) {
        result.diagnostic <- expected_handle_constructor();
        return;
    } else {};
    result.next <- result.next + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) {
        arguments <- parse_arguments(source, tokens, nodes, result, past, false, false);
        if (result.diagnostic != 0u8) return;
    } else {};
    val end <- tokens[result.next].past;
    result.next <- result.next + 1u64;
    val owner_name <- no_node();
    if (!owning) {
        if (result.next >= past || !in_word(source, tokens[result.next])) {
            result.diagnostic <- expected_handle_owner();
            return;
        } else {};
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
        owner_name <- result.root;
        (end <- syntax_past(nodes, result.used, owner_name)):void;
    } else {};
    ref argument_list = make NoLink {};
    if (arguments != no_node()) {
        argument_list = make LinkTo { node <- make NodeId { revision <- result.revision; index <- arguments; }; };
        {};
    };
    ref requested = make NodeId { revision <- result.revision; index <- marker; };
    if (owning) {
        append_syntax_node(nodes, result, first, end, make OwnHandleConstruction {
            marker <- requested; arguments <- argument_list;
        });
    } else {
        append_syntax_node(nodes, result, first, end, make BorrowHandleConstruction {
            marker <- requested; arguments <- argument_list;
            actual_owner <- make NodeId { revision <- result.revision; index <- owner_name; };
        });
    };
}

func append_named_throw(nodes:ExprNodes in A, result:ParseResult in R, first:u64, past:u64,
                         requested:u64, fields:u64, cause:u64) -> void where {owner A, owner R} {
    ref field_list = make NoLink {};
    ref cause_link = make NoLink {};
    if (fields != no_node()) {
        field_list = make LinkTo { node <- make NodeId { revision <- result.revision; index <- fields; }; };
        {};
    };
    if (cause != no_node()) {
        cause_link = make LinkTo { node <- make NodeId { revision <- result.revision; index <- cause; }; };
        {};
    };
    append_syntax_node(nodes, result, first, past, make NamedThrow {
        requested <- make NodeId { revision <- result.revision; index <- requested; };
        fields <- field_list;
        cause <- cause_link;
    });
}

func parse_region_construction(source:const SourceBytes in S, tokens:const Tokens in T,
                               nodes:ExprNodes in A, result:ParseResult in R, past:u64, first:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val schema <- result.root;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_region_capacity(); return; };
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val capacity <- result.root;
    val arrow <- result.next;
    if (!punct_pair_at(source, tokens, arrow, past, 45u8, 62u8) || arrow + 1u64 >= past ||
        !capacity_word(source, tokens[arrow + 1u64]) || punct_at(source, tokens, arrow + 2u64, past) != 41u8) {
        result.diagnostic <- expected_region_capacity();
        return;
    };
    val capacity_at <- tokens[arrow].first;
    result.next <- arrow + 3u64;
    parse_braced_items(source, tokens, nodes, result, past, true);
    if (result.diagnostic != 0u8) return;
    val initializers <- result.root;
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, initializers), make RegionConstruction {
        schema <- make NodeId { revision <- result.revision; index <- schema; };
        capacity <- make NodeId { revision <- result.revision; index <- capacity; };
        initializers <- make NodeId { revision <- result.revision; index <- initializers; };
        capacity_at <- capacity_at;
    });
}

func parse_construction(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val at <- result.next;
    if (at + 1u64 < past && region_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier()) {
        parse_region_construction(source, tokens, nodes, result, past, first);
        return;
    };
    val owning_handle <- at + 1u64 < past && own_word(source, tokens[at]) && handle_word(source, tokens[at + 1u64]);
    if (owning_handle || (at + 1u64 < past && handle_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        punct_at(source, tokens, at + 2u64, past) == 40u8)) {
        parse_make_handle(source, tokens, nodes, result, past, first, owning_handle);
        return;
    } else {};
    val exception <- at + 1u64 < past && exception_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        !in_word(source, tokens[at + 1u64]);
    if (exception) { (result.next <- result.next + 1u64):void; } else {};
    val type_token <- result.next;
    val query <- !exception && type_token < past && typeof_word(source, tokens[type_token]) &&
        punct_at(source, tokens, type_token + 1u64, past) == 40u8;
    if (!parse_construction_type(source, tokens, nodes, result, past, exception)) return;
    val declared_type <- result.root;
    val positional <- !query && punct_at(source, tokens, result.next, past) == 40u8;
    val arguments <- no_node();
    val placement <- no_node();
    if (positional) {
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 41u8) {
            arguments <- parse_arguments(source, tokens, nodes, result, past, true, true);
            if (result.diagnostic != 0u8) return;
        } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    if (exception) {
        placement <- parse_exception_placement(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        if (result.next < past && (in_word(source, tokens[result.next]) || from_word(source, tokens[result.next]))) {
            result.diagnostic <- duplicate_exception_placement();
            return;
        } else {};
    } else {
        if (result.next < past && in_word(source, tokens[result.next])) {
            result.next <- result.next + 1u64;
            if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
            (placement <- result.root):void;
        } else {};
    };
    val braced <- !positional && punct_at(source, tokens, result.next, past) == 123u8;
    if (braced) {
        if (exception) {
            arguments <- parse_initializer_fields(source, tokens, nodes, result, past);
            if (result.diagnostic != 0u8) return;
            (result.next <- result.next + 1u64):void;
        } else {
            parse_braced_items(source, tokens, nodes, result, past, true);
            (arguments <- result.root):void;
        };
        if (result.diagnostic != 0u8) return;
    } else {
        if (exception && !positional) { result.diagnostic <- expected_exception_initializer(); return; } else {};
    };
    val end <- tokens[result.next - 1u64].past;
    val initializer_at <- syntax_past(nodes, result.used, declared_type);
    ref owner_position = make NoLink {};
    ref argument_list = make NoLink {};
    if (placement != no_node()) {
        owner_position = make LinkTo { node <- make NodeId { revision <- result.revision; index <- placement; }; };
        {};
    };
    if (arguments != no_node()) {
        argument_list = make LinkTo { node <- make NodeId { revision <- result.revision; index <- arguments; }; };
        {};
    };
    if (positional) {
        append_syntax_node(nodes, result, initializer_at, end, make PositionalInitializer {
            placement <- owner_position; arguments <- argument_list;
        });
    } else {
        if (braced && exception) {
            append_syntax_node(nodes, result, initializer_at, end, make ExceptionFields {
                placement <- owner_position; fields <- argument_list;
            });
        } else {
            if (braced) {
                append_syntax_node(nodes, result, initializer_at, end, make BracedInitializer {
                    placement <- owner_position; body <- make NodeId { revision <- result.revision; index <- arguments; };
                });
            } else {
                append_syntax_node(nodes, result, initializer_at, end, make ReserveStorage { placement <- owner_position; });
            };
        };
    };
    if (result.diagnostic != 0u8) return;
    ref requested = make NodeId { revision <- result.revision; index <- declared_type; };
    ref initializer = make NodeId { revision <- result.revision; index <- result.root; };
    if (exception) {
        append_syntax_node(nodes, result, first, end, make ExceptionConstruction {
            requested <- requested; initializer <- initializer;
        });
    } else {
        append_syntax_node(nodes, result, first, end, make NamedConstruction {
            requested <- requested; initializer <- initializer;
        });
    };
}

func parse_call(source:const SourceBytes in S, tokens:const Tokens in T,
                nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) return false; # '('
    val callee <- result.root;
    result.next <- open + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
        arguments <- parse_arguments(source, tokens, nodes, result, past, true, false);
        if (result.diagnostic != 0u8) return false;
    } else {};
    val close <- result.next;
    val first <- syntax_first(nodes, result.used, callee);
    val opening <- tokens[open].first;
    if (arguments == no_node()) {
        append_syntax_node(nodes, result, first, tokens[close].past, make EmptyCall {
            callee <- make NodeId { revision <- result.revision; index <- callee; };
            opening <- opening;
        });
    } else {
        append_syntax_node(nodes, result, first, tokens[close].past, make Call {
            callee <- make NodeId { revision <- result.revision; index <- callee; };
            argument_tail <- make NodeId { revision <- result.revision; index <- arguments; };
            opening <- opening;
        });
    };
    if (result.diagnostic != 0u8) return false;
    result.next <- close + 1u64;
    return true;
}

func parse_field_access(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val base <- result.root;
    val operation_at <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val field <- result.root;
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, base), syntax_past(nodes, result.used, field),
                       make FieldSelection {
        target <- make NodeId { revision <- result.revision; index <- base; };
        field <- make NodeId { revision <- result.revision; index <- field; };
        dot_at <- operation_at;
    });
}

func parse_index_access(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val base <- result.root;
    val open <- result.next;
    result.next <- open + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val index <- result.root;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 93u8) { # ']'
        result.diagnostic <- expected_index_close();
        return;
    } else {};
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, base), tokens[close].past, make IndexSelection {
        target <- make NodeId { revision <- result.revision; index <- base; };
        index <- make NodeId { revision <- result.revision; index <- index; };
        opening <- tokens[open].first;
    });
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func here_header_close(source:const SourceBytes in S, tokens:const Tokens in T, opening:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (punct_at(source, tokens, opening, past) != 40u8) return no_node();
    val depth <- 1u64;
    val delimiter <- 0u8;
    for (at in opening + 1u64 .. past) {
        delimiter <- punct_at(source, tokens, at, past);
        if (delimiter == 40u8) { (depth <- depth + 1u64):void; } else {};
        if (delimiter == 41u8) {
            depth <- depth - 1u64;
            if (depth == 0u64)
                return if (punct_pair_at(source, tokens, at + 1u64, past, 61u8, 62u8)) { at } else { no_node() };
        } else {};
    };
    return no_node();
}

func parse_here_receiver(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, previous:u64, close:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val explicit_ref <- ref_word(source, tokens[result.next]);
    if (explicit_ref) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_binding_name(source, tokens, nodes, result, close, false, true, false)) return false;
    val binding <- result.root;
    ref preceding = make NoLink {};
    if (previous != no_node()) {
        preceding = make LinkTo { node <- make NodeId { revision <- result.revision; index <- previous; }; };
        {};
    };
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, binding), make HereReceiver {
        previous <- preceding;
        binding <- make NodeId { revision <- result.revision; index <- binding; };
        explicit_ref <- explicit_ref;
    });
    return result.diagnostic == 0u8;
}

func parse_here_receivers(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, close:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    val receivers <- no_node();
    for (unused in result.next .. close) {
        if (!parse_here_receiver(source, tokens, nodes, result, receivers, close)) return no_node();
        receivers <- result.root;
        if (result.next == close) return receivers;
        if (punct_at(source, tokens, result.next, close) != 44u8 || result.next + 1u64 == close) {
            result.diagnostic <- expected_here_receiver();
            return no_node();
        } else {};
        result.next <- result.next + 1u64;
    };
    return receivers;
}

func parse_here_body(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R, past:u64, close:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val call <- result.root;
    val first <- tokens[result.next].first;
    val receivers <- no_node();
    if (close != no_node()) {
        receivers <- parse_here_receivers(source, tokens, nodes, result, close);
        if (result.diagnostic != 0u8) return;
        (result.next <- close + 2u64):void;
    } else {};
    val enclosing <- result.supplied_here;
    result.supplied_here <- true;
    parse_block(source, tokens, nodes, result, past);
    result.supplied_here <- enclosing;
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val end <- syntax_past(nodes, result.used, body);
    ref parameters = make NoLink {};
    if (receivers != no_node()) {
        parameters = make LinkTo { node <- make NodeId { revision <- result.revision; index <- receivers; }; };
        {};
    };
    append_syntax_node(nodes, result, first, end, make HereSupply {
        receivers <- parameters;
        body <- make NodeId { revision <- result.revision; index <- body; };
    });
    if (result.diagnostic != 0u8) return;
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, call), end, make HereInvocation {
        call <- make NodeId { revision <- result.revision; index <- call; };
        supplied <- make NodeId { revision <- result.revision; index <- result.root; };
    });
}

enum HereSuffix:u8 { Unavailable; CanAttach; AlreadyAttached; }

func here_suffix(nodes:const ExprNodes in N, used:u64, at:u64) -> HereSuffix where {const owner N} {
    if (at >= used) return (Unavailable:HereSuffix);
    return case nodes[at] of {
        (Vacant) -> { (Unavailable:HereSuffix) };
        (Occupied { val syntax <- node; }) -> {
            case syntax.payload of {
                (Call) -> { (CanAttach:HereSuffix) };
                (EmptyCall) -> { (CanAttach:HereSuffix) };
                (SymbolicInvocation) -> { (CanAttach:HereSuffix) };
                (HereInvocation) -> { (AlreadyAttached:HereSuffix) };
                (_) -> { (Unavailable:HereSuffix) };
            }
        };
    };
}

func parse_postfix(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val here <- (Unavailable:HereSuffix);
    val close <- no_node();
    val suffix <- 0u8;
    for (unused in result.next .. past) {
        here <- here_suffix(nodes, result.used, result.root);
        suffix <- punct_at(source, tokens, result.next, past);
        if (here != (Unavailable:HereSuffix)) {
            (close <- here_header_close(source, tokens, result.next, past)):void;
        } else { (close <- no_node()):void; };
        if (close != no_node() || (here != (Unavailable:HereSuffix) && suffix == 123u8)) {
            if (here == (AlreadyAttached:HereSuffix)) { result.diagnostic <- duplicate_here_body(); return; } else {};
            parse_here_body(source, tokens, nodes, result, past, close);
            if (result.diagnostic != 0u8) return;
        } else {
            if (suffix == 46u8) {
                parse_field_access(source, tokens, nodes, result, past);
                if (result.diagnostic != 0u8) return;
            } else {
                if (suffix == 91u8) { # '['
                    parse_index_access(source, tokens, nodes, result, past);
                    if (result.diagnostic != 0u8) return;
                } else {
                    if (!parse_call(source, tokens, nodes, result, past)) return;
                };
            };
        };
    };
}

func prefix_end(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    for (at in first .. past) {
        if (punct_at(source, tokens, at, past) != 33u8 && !not_word(source, tokens[at])) return at;
    };
    return past;
}

func append_negation(nodes:ExprNodes in A, result:ParseResult in R, first:u64, operand:u64) -> void
    where {owner A, owner R} {
    append_syntax_node(nodes, result, first, syntax_past(nodes, result.used, operand), make Negation {
        operand <- make NodeId { revision <- result.revision; index <- operand; };
    });
}

func parse_prefix(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val primary <- prefix_end(source, tokens, first, past);
    result.next <- primary;
    parse_primary(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    parse_postfix(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val prefix <- primary;
    val operand <- no_node();
    for (unused in first .. primary) {
        prefix <- prefix - 1u64;
        operand <- result.root;
        append_negation(nodes, result, tokens[prefix].first, operand);
        if (result.diagnostic != 0u8) return;
    };
}

func parse_expression_operand(source:const SourceBytes in S, tokens:const Tokens in T,
                              nodes:ExprNodes in A, result:ParseResult in R,
                              past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_prefix(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    parse_binary(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) return;
    val assignment <- result.next;
    val rebind <- punct_at(source, tokens, assignment, past) == 61u8;
    if (!rebind && !punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) return; # '<-'
    val destination <- result.root;
    result.next <- assignment + 1u64;
    parse_expression_operand(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val source_node <- result.root;
    ref operands = make AssignmentOperands {
        destination <- make NodeId { revision <- result.revision; index <- destination; };
        input <- make NodeId { revision <- result.revision; index <- source_node; };
        operator_at <- tokens[assignment].first;
    };
    val first <- syntax_first(nodes, result.used, destination);
    val end <- syntax_past(nodes, result.used, source_node);
    if (rebind) {
        append_syntax_node(nodes, result, first, end, make Rebind { operands <- operands; });
    } else {
        append_syntax_node(nodes, result, first, end, make Transfer { operands <- operands; });
    };
}

func parse_expression_at(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R,
                         past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_operand(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) return;
    parse_result_annotation(source, tokens, nodes, result, past);
}

func parse_result_annotation(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val colon <- result.next;
    if (punct_at(source, tokens, colon, past) != 58u8) return; # ':'
    val annotation <- colon + 1u64;
    result.next <- annotation;
    if (annotation >= past || tokens[annotation].kind != identifier()) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    val operand <- result.root;
    if (void_word(source, tokens[annotation])) {
        append_syntax_node(nodes, result, syntax_first(nodes, result.used, operand), tokens[annotation].past,
                           make DiscardedExpression {
            operand <- make NodeId { revision <- result.revision; index <- operand; };
            colon <- tokens[colon].first;
        });
        if (result.diagnostic == 0u8) { (result.next <- annotation + 1u64):void; } else {};
        return;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val target <- result.root;
    append_syntax_node(nodes, result, syntax_first(nodes, result.used, operand), syntax_past(nodes, result.used, target),
                       make CheckedTypeAssertion {
        operand <- make NodeId { revision <- result.revision; index <- operand; };
        annotation <- make NodeId { revision <- result.revision; index <- target; };
        colon <- tokens[colon].first;
    });
}

func parse_binary(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R,
                  past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    # Every accepted operator advances next. An error leaves next at the
    # failing token so the caller can recover or report its source span.
    for (unused in result.next .. past) {
        if (!parse_infix(source, tokens, nodes, result, past, minimum)) return;
    };
}

export func parse_next_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

func arithmetic_operation(kind:u8) -> ArithmeticOperation {
    if (kind == subtract_node()) return Subtraction;
    if (kind == multiply_node()) return Multiplication;
    if (kind == divide_node()) return Division;
    if (kind == remainder_node()) return Remainder;
    return Addition;
}

func comparison_relation(predicate:u64) -> ComparisonRelation {
    if (predicate == unequal_words()) return Unequal;
    if (predicate == less_words()) return Less;
    if (predicate == at_most_words()) return AtMost;
    if (predicate == greater_words()) return Greater;
    if (predicate == at_least_words()) return AtLeast;
    return Equal;
}

func parse_infix(source:const SourceBytes in S, tokens:const Tokens in T,
                 nodes:ExprNodes in A, result:ParseResult in R,
                 past:u64, minimum:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) return false;
    val op <- punct_at(source, tokens, result.next, past);
    val predicate <- comparison(source, tokens, result.next, past);
    val kind <- compare_node();
    val binding <- 0u8;
    if (result.next < past && (or_word(source, tokens[result.next]) ||
        punct_pair_at(source, tokens, result.next, past, 124u8, 124u8))) {
        kind <- logical_or_node();
        (binding <- 1u8):void;
    } else {};
    if (result.next < past && (and_word(source, tokens[result.next]) ||
        punct_pair_at(source, tokens, result.next, past, 38u8, 38u8))) {
        kind <- logical_and_node();
        (binding <- 2u8):void;
    } else {};
    if (op == 42u8) { kind <- multiply_node(); (binding <- 6u8):void; } else {};
    if (op == 47u8) { kind <- divide_node(); (binding <- 6u8):void; } else {};
    if (op == 37u8) { kind <- remainder_node(); (binding <- 6u8):void; } else {};
    if (op == 43u8) { kind <- add_node(); (binding <- 5u8):void; } else {};
    if (punct_pair_at(source, tokens, result.next, past, 43u8, 43u8)) {
        kind <- concat_node();
        (binding <- 5u8):void;
    } else {};
    if (op == 45u8) { kind <- subtract_node(); (binding <- 5u8):void; } else {};
    if (predicate != no_node()) {
        binding <- if (predicate <= unequal_words()) { 3u8 } else { 4u8 };
        {};
    } else {};
    if (binding < minimum) return false;
    val operation_at <- tokens[result.next].first;
    val left <- result.root;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, binding + 1u8);
    if (result.diagnostic != 0u8) return false;
    val right <- result.root;
    val first <- syntax_first(nodes, result.used, left);
    val end <- syntax_past(nodes, result.used, right);
    if (kind == logical_and_node() || kind == logical_or_node()) {
        ref lhs = make NodeId { revision <- result.revision; index <- left; };
        ref rhs = make NodeId { revision <- result.revision; index <- right; };
        if (kind == logical_and_node()) {
            append_syntax_node(nodes, result, first, end, make Conjunction { left_operand <- lhs; right_operand <- rhs; });
        } else {
            append_syntax_node(nodes, result, first, end, make Disjunction { left_operand <- lhs; right_operand <- rhs; });
        };
        return result.diagnostic == 0u8;
    };
    ref operands = make BinaryOperands {
        left_operand <- make NodeId { revision <- result.revision; index <- left; };
        right_operand <- make NodeId { revision <- result.revision; index <- right; };
        operator_at <- operation_at;
    };
    if (kind == compare_node()) {
        append_syntax_node(nodes, result, first, end, make ComparisonExpression {
            operands <- operands; relation <- comparison_relation(predicate);
        });
    } else {
        if (kind == concat_node()) {
            append_syntax_node(nodes, result, first, end, make Concatenation { operands <- operands; });
        } else {
            append_syntax_node(nodes, result, first, end, make ArithmeticExpression {
                operands <- operands; operation <- arithmetic_operation(kind);
            });
        };
    };
    return result.diagnostic == 0u8;
}

# Tokens come from the indexed lexer over source. The caller supplies
# initialized node storage and receives a root index or a diagnostic at next.
export func parse_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, first:u64, past:u64,
                             result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(first, result);
    if (first > past || past >= len(tokens)) {
        result.diagnostic <- expected_operand();
        return
    };
    if (!seed_lexical_reports(tokens, nodes, result, first, past)) return;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8 && recover_syntax(source, tokens, nodes, result, first, past, ExpressionRole)) {
        (result.next <- past):void
    };
}

export Tokens;
export ExprNode;
export ExprNodes;
