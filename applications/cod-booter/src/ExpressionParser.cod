using "ParserStorage.cod" behave_node;
using "ParserStorage.cod" throw_node;
using "ParserStorage.cod" transfer_node;
using "ParserStorage.cod" typed_name_node;
using "ParserStorage.cod" readonly_declaration;
using "ParserStorage.cod" val_binding_node;
using "ParserStorage.cod" ptr_binding_node;
using "ParserStorage.cod" null_node;
using "ParserStorage.cod" return_node;
using "ParserStorage.cod" owned_type_node;
using "ParserStorage.cod" discarded_guard_result;
using "ParserStorage.cod" discard_node;
using "ParserStorage.cod" bool_node;
using "ParserStorage.cod" conditional_node;
using "ParserStorage.cod" logical_not_node;
using "ParserStorage.cod" logical_and_node;
using "ParserStorage.cod" logical_or_node;
using "ParserStorage.cod" compare_node;
using "ParserStorage.cod" equal_words;
using "ParserStorage.cod" unequal_words;
using "ParserStorage.cod" less_words;
using "ParserStorage.cod" at_most_words;
using "ParserStorage.cod" greater_words;
using "ParserStorage.cod" at_least_words;
using "ParserStorage.cod" no_node;
using "Lexer.cod" identifier;
using "Lexer.cod" integer_literal;
using "Lexer.cod" punctuation;
using "Lexer.cod" defer_word;
using "Lexer.cod" catch_word;
using "Lexer.cod" finally_word;
using "Lexer.cod" try_word;
using "Lexer.cod" const_word;
using "Lexer.cod" behave_word;
using "Lexer.cod" throw_word;
using "Lexer.cod" symbol_name;
using "Lexer.cod" in_word;
using "Lexer.cod" ptr_word;
using "Lexer.cod" val_word;
using "Lexer.cod" null_word;
using "Lexer.cod" return_word;
using "Lexer.cod" void_word;
using "Lexer.cod" if_word;
using "Lexer.cod" else_word;
using "Lexer.cod" true_word;
using "Lexer.cod" false_word;
using "Lexer.cod" not_word;

data ParseResult {
    next:u64;
    used:u64;
    root:u64;
    diagnostic:u8;
}

func expected_operand() -> u8 { return 1u8; }
func expected_close() -> u8 { return 2u8; }
func expected_u64() -> u8 { return 3u8; }
func literal_too_large() -> u8 { return 4u8; }
func node_storage_exhausted() -> u8 { return 5u8; }
func unexpected_token() -> u8 { return 6u8; }
func expected_argument_separator() -> u8 { return 7u8; }
func expected_deferred_call() -> u8 { return 8u8; }
func unsupported_deferred_form() -> u8 { return 9u8; }
func expected_block() -> u8 { return 10u8; }
func expected_block_close() -> u8 { return 11u8; }
func expected_block_separator() -> u8 { return 12u8; }
func expected_try_clause() -> u8 { return 13u8; }
func expected_catch_header() -> u8 { return 14u8; }
func expected_catch_name() -> u8 { return 15u8; }
func expected_catch_const() -> u8 { return 16u8; }
func catch_all_must_be_last() -> u8 { return 17u8; }
func expected_symbol() -> u8 { return 18u8; }
func expected_name() -> u8 { return 19u8; }
func expected_type() -> u8 { return 20u8; }
func expected_binding_operator() -> u8 { return 21u8; }
func unsupported_typed_expression() -> u8 { return 26u8; }
func expected_condition_open() -> u8 { return 27u8; }
func expected_else() -> u8 { return 28u8; }

func punct_at(source:const SourceBytes in S, tokens:const Tokens in T,
              at:u64, past:u64) -> u8 where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) { return 0u8; } else {};
    val first <- tokens[at].first;
    if (tokens[at].past - first != 1u64) { return 0u8; } else {};
    return source[first];
}

func punct_pair_at(source:const SourceBytes in S, tokens:const Tokens in T,
                   at:u64, past:u64, left:u8, right:u8) -> bool
    where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) { return false; } else {};
    val first <- tokens[at].first;
    return tokens[at].past - first == 2u64 && source[first] == left && source[first + 1u64] == right;
}

func append_decimal_digit(ref number:u64 in N, byte:u8) -> bool where {owner N} {
    val digit:u64 <- byte - 48u8;
    if (number > (18446744073709551615u64 - digit) / 10u64) { return false; } else {};
    number <- number * 10u64 + digit;
    return true;
}

func parse_literal(source:const SourceBytes in S, token:const Token in T,
                   ref result:ParseResult in R) -> u64 where {const owner S, const owner T, owner R} {
    val end <- token.past;
    if (end - token.first < 4u64 || source[end - 3u64] != 117u8 ||
        source[end - 2u64] != 54u8 || source[end - 1u64] != 52u8) {
        result.diagnostic <- expected_u64();
        return 0u64;
    } else {};
    val number <- 0u64;
    for (at in token.first .. end - 3u64) {
        if (!append_decimal_digit(number, source[at])) {
            result.diagnostic <- literal_too_large();
            return 0u64;
        } else {};
    };
    return number;
}

func append_node(ref nodes:ExprNodes in A, ref result:ParseResult in R,
                 kind:u8, first:u64, past:u64, number:u64, left:u64,
                 right:u64, operation_at:u64) -> void where {owner A, owner R} {
    val id <- result.used;
    if (id >= len(nodes)) {
        result.diagnostic <- node_storage_exhausted();
        return;
    } else {};
    nodes[id].kind <- kind;
    nodes[id].first <- first;
    nodes[id].past <- past;
    nodes[id].number <- number;
    nodes[id].left <- left;
    nodes[id].right <- right;
    nodes[id].operation_at <- operation_at;
    result.root <- id;
    result.used <- id + 1u64;
    return;
}

func comparison(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (punct_pair_at(source, tokens, at, past, 61u8, 61u8)) { return equal_words(); } else {};
    if (punct_pair_at(source, tokens, at, past, 33u8, 61u8)) { return unequal_words(); } else {};
    if (punct_at(source, tokens, at, past) == 60u8) { return less_words(); } else {};
    if (punct_pair_at(source, tokens, at, past, 60u8, 61u8)) { return at_most_words(); } else {};
    if (punct_at(source, tokens, at, past) == 62u8) { return greater_words(); } else {};
    if (punct_pair_at(source, tokens, at, past, 62u8, 61u8)) { return at_least_words(); } else {};
    return no_node();
}

func outer_invocation(nodes:const ExprNodes in A, root:u64) -> u64 where {const owner A} {
    val at <- root;
    for (unused in 0u64 .. root + 1u64) {
        if (nodes[at].kind == call_node() || nodes[at].kind == behave_node()) { return at; } else {};
        if (nodes[at].kind != group_node()) { return no_node(); } else {};
        (at <- nodes[at].left):void;
    };
    return no_node();
}

func parse_defer(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val keyword <- tokens[result.next].first;
    val operand_start <- result.next + 1u64;
    result.next <- operand_start;
    if (punct_at(source, tokens, operand_start, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return; } else {};
        val body <- result.root;
        val last <- parse_guard_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return; } else {};
        if (last != no_node()) {
            val first <- nodes[body].first;
            append_node(nodes, result, try_node(), first, nodes[last].past, discarded_guard_result(), body, last, first);
            if (result.diagnostic != 0u8) { return; } else {};
        } else {};
        val action <- result.root;
        append_node(nodes, result, deferred_block_node(), keyword, nodes[action].past,
                    0u64, action, no_node(), keyword);
        return;
    } else {};
    if (operand_start < past && (catch_word(source, tokens[operand_start]) || finally_word(source, tokens[operand_start]))) {
        result.diagnostic <- unsupported_deferred_form();
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return; } else {};
    val operand <- result.root;
    val invocation <- outer_invocation(nodes, operand);
    if (invocation == no_node()) {
        result.next <- operand_start;
        result.diagnostic <- expected_deferred_call();
        return;
    } else {};
    # Keep the operand's syntax and identify the one invocation that waits.
    append_node(nodes, result, deferred_call_node(), keyword, nodes[operand].past,
                0u64, operand, invocation, keyword);
}

# Each block item links its preceding item and its own expression.
func parse_block_item(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, ref result:ParseResult in R,
                      past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return false; } else {};
    val expression <- result.root;
    val first <- nodes[expression].first;
    val end <- nodes[expression].past;
    val separator <- result.next;
    if (separator >= past) { result.diagnostic <- expected_block_close(); return false; } else {};
    val delimiter <- punct_at(source, tokens, separator, past);
    if (delimiter == 59u8) { # ';'
        end <- tokens[separator].past;
        (result.next <- separator + 1u64):void;
    } else {};
    if (delimiter != 59u8 && delimiter != 125u8) { # ';' or '}'
        result.diagnostic <- expected_block_separator();
        return false;
    } else {};
    append_node(nodes, result, block_item_node(), first, end, 0u64, previous, expression, first);
    return result.diagnostic == 0u8;
}

func finish_block(source:const SourceBytes in S, tokens:const Tokens in T,
                  ref nodes:ExprNodes in A, ref result:ParseResult in R,
                  past:u64, first:u64, last:u64, scoped:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val close <- result.next;
    if (scoped) {
        close <- close + 1u64;
        if (punct_at(source, tokens, close, past) != 125u8) { # '}'
            result.next <- close;
            result.diagnostic <- expected_block_close();
            return;
        } else {};
    } else {};
    val kind <- if (scoped) { full_scope_node() } else { block_node() };
    append_node(nodes, result, kind, first, tokens[close].past, 0u64, last, no_node(), first);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func parse_block(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 123u8) { # '{'
        result.diagnostic <- expected_block();
        return;
    } else {};
    val first <- tokens[open].first;
    val following <- open + 1u64;
    val scoped <- punct_at(source, tokens, following, past) == 123u8 &&
        tokens[following].first == tokens[open].past;
    result.next <- if (scoped) { following + 1u64 } else { following };
    val last <- no_node();
    for (unused in result.next .. past + 1u64) {
        if (punct_at(source, tokens, result.next, past) == 125u8) { # '}'
            finish_block(source, tokens, nodes, result, past, first, last, scoped);
            return;
        } else {};
        if (result.next >= past) { result.diagnostic <- expected_block_close(); return; } else {};
        if (!parse_block_item(source, tokens, nodes, result, past, last)) { return; } else {};
        (last <- result.root):void;
    };
    (result.diagnostic <- expected_block_close()):void;
}

func parse_identifier(source:const SourceBytes in S, tokens:const Tokens in T, ref nodes:ExprNodes in A,
                      ref result:ParseResult in R, past:u64, missing:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != identifier() || not_word(source, tokens[at])) {
        result.diagnostic <- missing;
        return false;
    } else {};
    val first <- tokens[at].first;
    append_node(nodes, result, name_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    if (result.diagnostic != 0u8) { return false; } else {};
    result.next <- at + 1u64;
    return true;
}

func parse_catch_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) { # '('
        result.diagnostic <- expected_catch_header();
        return;
    } else {};
    result.next <- open + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_catch_name())) { return; } else {};
    val name <- result.root;
    val type_name <- no_node();
    if (punct_at(source, tokens, result.next, past) == 58u8) { # ':'
        result.next <- result.next + 1u64;
        if (result.next >= past || !const_word(source, tokens[result.next])) {
            result.diagnostic <- expected_catch_const();
            return;
        } else {};
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_catch_name())) { return; } else {};
        (type_name <- result.root):void;
    } else {};
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) { # ')'
        result.diagnostic <- expected_catch_header();
        return;
    } else {};
    val first <- tokens[open].first;
    append_node(nodes, result, catch_binding_node(), first, tokens[close].past, 0u64, name, type_name, first);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

# Clauses link in source order through the preceding clause. A catch stores
# its binding and body together so a later pass can check that binding's scope.
func parse_catch_clause(source:const SourceBytes in S, tokens:const Tokens in T,
                        ref nodes:ExprNodes in A, ref result:ParseResult in R,
                        past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    parse_catch_binding(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return false; } else {};
    val binding <- result.root;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return false; } else {};
    val body <- result.root;
    val end <- nodes[body].past;
    append_node(nodes, result, catch_handler_node(), first, end, 0u64, binding, body, first);
    if (result.diagnostic != 0u8) { return false; } else {};
    val handler <- result.root;
    append_node(nodes, result, catch_clause_node(), first, end, 0u64, previous, handler, first);
    return nodes[binding].right == no_node();
}

func parse_catches(source:const SourceBytes in S, tokens:const Tokens in T,
                   ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- no_node();
    val catch_all <- false;
    for (unused in result.next .. past) {
        if (result.next >= past || !catch_word(source, tokens[result.next])) { return last; } else {};
        if (catch_all) { result.diagnostic <- catch_all_must_be_last(); return no_node(); } else {};
        catch_all <- parse_catch_clause(source, tokens, nodes, result, past, last);
        if (result.diagnostic != 0u8) { return no_node(); } else {};
        (last <- result.root):void;
    };
    return last;
}

func parse_guard_clauses(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- parse_catches(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return no_node(); } else {};
    if (result.next < past && finally_word(source, tokens[result.next])) {
        val finally_first <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return no_node(); } else {};
        val cleanup <- result.root;
        append_node(nodes, result, finally_clause_node(), finally_first, nodes[cleanup].past,
                    0u64, last, cleanup, finally_first);
        if (result.diagnostic != 0u8) { return no_node(); } else {};
        return result.root;
    } else {};
    return last;
}

func parse_try(source:const SourceBytes in S, tokens:const Tokens in T,
               ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val begin <- result.next;
    val first <- tokens[begin].first;
    result.next <- begin + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    val body <- result.root;
    val last <- parse_guard_clauses(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    if (last == no_node()) {
        result.next <- begin;
        result.diagnostic <- expected_try_clause();
        return;
    } else {};
    append_node(nodes, result, try_node(), first, nodes[last].past, 0u64, body, last, first);
}

func parse_symbol(tokens:const Tokens in T, ref nodes:ExprNodes in A,
                  ref result:ParseResult in R, past:u64) -> bool
    where {const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != symbol_name()) {
        result.diagnostic <- expected_symbol();
        return false;
    } else {};
    val first <- tokens[at].first;
    append_node(nodes, result, symbol_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    if (result.diagnostic != 0u8) { return false; } else {};
    result.next <- at + 1u64;
    return true;
}

func parse_behave(source:const SourceBytes in S, tokens:const Tokens in T,
                  ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_symbol(tokens, nodes, result, past)) { return; } else {};
    val callee <- result.root;
    val end <- nodes[callee].past;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) == 40u8) { # '('
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
            arguments <- parse_arguments(source, tokens, nodes, result, past);
            if (result.diagnostic != 0u8) { return; } else {};
        } else {};
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void;
    } else {};
    append_node(nodes, result, behave_node(), first, end, 0u64, callee, arguments, first);
}

func parse_completion(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, ref result:ParseResult in R,
                      past:u64, kind:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    val following <- punct_at(source, tokens, result.next, past);
    if (following == 59u8 || following == 125u8) { # ';' or '}'
        append_node(nodes, result, kind, first, tokens[at].past, 0u64, no_node(), no_node(), first);
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return; } else {};
    val operand <- result.root;
    append_node(nodes, result, kind, first, nodes[operand].past, 0u64, operand, no_node(), first);
}

func parse_binding_name(source:const SourceBytes in S, tokens:const Tokens in T,
                        ref nodes:ExprNodes in A, ref result:ParseResult in R,
                        past:u64, require_type:bool, qualified:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) { return false; } else {};
    if (punct_at(source, tokens, result.next, past) != 58u8) { # ':'
        if (require_type) { result.diagnostic <- expected_type(); return false; } else {};
        return true;
    } else {};
    val name <- result.root;
    val colon <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val readonly <- qualified && result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) { return false; } else {};
    val annotation <- result.root;
    if (result.next < past && in_word(source, tokens[result.next])) {
        val anchor <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) { return false; } else {};
        val owner_name <- result.root;
        append_node(nodes, result, owned_type_node(), nodes[annotation].first, nodes[owner_name].past,
                    0u64, annotation, owner_name, anchor);
        if (result.diagnostic != 0u8) { return false; } else {};
        (annotation <- result.root):void;
    } else {};
    append_node(nodes, result, typed_name_node(), nodes[name].first, nodes[annotation].past,
                if (readonly) { readonly_declaration() } else { 0u64 }, name, annotation, colon);
    return result.diagnostic == 0u8;
}

func parse_local_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R,
                         past:u64, pointer:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_binding_name(source, tokens, nodes, result, past, pointer, false)) { return; } else {};
    val binding <- result.root;
    val assignment <- result.next;
    val valid <- if (pointer) {
        punct_at(source, tokens, assignment, past) == 61u8 # '='
    } else {
        punct_pair_at(source, tokens, assignment, past, 60u8, 45u8) # '<-'
    };
    if (!valid) { result.diagnostic <- expected_binding_operator(); return; } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return; } else {};
    val initializer <- result.root;
    val kind <- if (pointer) { ptr_binding_node() } else { val_binding_node() };
    append_node(nodes, result, kind, first, nodes[initializer].past, 0u64, binding, initializer, tokens[assignment].first);
}

func parse_null(source:const SourceBytes in S, tokens:const Tokens in T,
                ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    if (result.next < past && in_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) { return; } else {};
        val owner_name <- result.root;
        append_node(nodes, result, null_node(), first, nodes[owner_name].past, 0u64, owner_name, no_node(), first);
        return;
    } else {};
    append_node(nodes, result, null_node(), first, tokens[at].past, 0u64, no_node(), no_node(), first);
}

func parse_conditional(source:const SourceBytes in S, tokens:const Tokens in T,
                       ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_condition_open(); return; } else {};
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return; } else {};
    val condition <- result.root;
    if (punct_at(source, tokens, result.next, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    result.next <- result.next + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    val yes <- result.root;
    if (result.next >= past || !else_word(source, tokens[result.next])) { result.diagnostic <- expected_else(); return; } else {};
    result.next <- result.next + 1u64;
    if (result.next < past && if_word(source, tokens[result.next])) {
        parse_conditional(source, tokens, nodes, result, past);
    } else {
        parse_block(source, tokens, nodes, result, past);
    };
    if (result.diagnostic != 0u8) { return; } else {};
    val no <- result.root;
    append_node(nodes, result, conditional_node(), first, nodes[no].past, no, condition, yes, first);
}

func parse_primary(source:const SourceBytes in S, tokens:const Tokens in T,
                   ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_operand(); return; } else {};
    val first <- tokens[at].first;
    if (if_word(source, tokens[at])) { parse_conditional(source, tokens, nodes, result, past); return; } else {};
    if (defer_word(source, tokens[at])) {
        parse_defer(source, tokens, nodes, result, past);
        return;
    } else {};
    if (try_word(source, tokens[at])) { parse_try(source, tokens, nodes, result, past); return; } else {};
    if (throw_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, throw_node());
        return;
    } else {};
    if (return_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, return_node());
        return;
    } else {};
    if (val_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, false); return; } else {};
    if (ptr_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, true); return; } else {};
    if (null_word(source, tokens[at])) { parse_null(source, tokens, nodes, result, past); return; } else {};
    if (behave_word(source, tokens[at])) { parse_behave(source, tokens, nodes, result, past); return; } else {};
    if (tokens[at].kind == symbol_name()) { (parse_symbol(tokens, nodes, result, past)):void; return; } else {};
    if (punct_at(source, tokens, at, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        return;
    } else {};
    if (punct_at(source, tokens, at, past) == 40u8) { # '('
        result.next <- at + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) { return; } else {};
        val close <- result.next;
        if (punct_at(source, tokens, close, past) != 41u8) { # ')'
            result.diagnostic <- expected_close();
            return;
        } else {};
        val inner <- result.root;
        append_node(nodes, result, group_node(), first, tokens[close].past, 0u64, inner, 0u64, first);
        if (result.diagnostic != 0u8) { return; } else {};
        (result.next <- close + 1u64):void;
        return;
    } else {};
    val truth <- true_word(source, tokens[at]);
    if (truth || false_word(source, tokens[at])) {
        append_node(nodes, result, bool_node(), first, tokens[at].past, if (truth) { 1u64 } else { 0u64 },
                    0u64, 0u64, first);
        if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
        return;
    } else {};
    if (tokens[at].kind == integer_literal()) {
        val number <- parse_literal(source, tokens[at], result);
        if (result.diagnostic != 0u8) { return; } else {};
        append_node(nodes, result, literal_node(), first, tokens[at].past, number, 0u64, 0u64, first);
    } else {
        if (tokens[at].kind != identifier()) { result.diagnostic <- expected_operand(); return; } else {};
        append_node(nodes, result, name_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    };
    if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
}

# Each argument entry links to its preceding prefix on the left and its
# argument expression on the right. The call links to the final entry.
func parse_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                    ref nodes:ExprNodes in A, ref result:ParseResult in R,
                    first:u64, previous:u64, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return false; } else {};
    val argument <- result.root;
    append_node(nodes, result, argument_node(), first, nodes[argument].past,
                0u64, previous, argument, nodes[argument].first);
    return result.diagnostic == 0u8;
}

func parse_arguments(source:const SourceBytes in S, tokens:const Tokens in T,
                     ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past) { result.diagnostic <- expected_operand(); return no_node(); } else {};
    val prefix <- no_node();
    val list_first <- tokens[start].first;
    val separator <- 0u8;
    for (unused in start .. past) {
        if (!parse_argument(source, tokens, nodes, result, list_first, prefix, past)) { return no_node(); } else {};
        prefix <- result.root;
        separator <- punct_at(source, tokens, result.next, past);
        if (separator == 41u8) { return prefix; } else {}; # ')'
        if (separator != 44u8) { # ','
            result.diagnostic <- expected_argument_separator();
            return no_node();
        } else {};
        (result.next <- result.next + 1u64):void;
    };
    result.diagnostic <- expected_operand();
    return no_node();
}

func parse_call(source:const SourceBytes in S, tokens:const Tokens in T,
                ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) { return false; } else {}; # '('
    val callee <- result.root;
    result.next <- open + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
        arguments <- parse_arguments(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return false; } else {};
    } else {};
    val close <- result.next;
    append_node(nodes, result, call_node(), nodes[callee].first, tokens[close].past,
                0u64, callee, arguments, tokens[open].first);
    if (result.diagnostic != 0u8) { return false; } else {};
    result.next <- close + 1u64;
    return true;
}

func parse_calls(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    for (unused in result.next .. past) {
        if (!parse_call(source, tokens, nodes, result, past)) { return; } else {};
    };
}

func prefix_end(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    for (at in first .. past) {
        if (punct_at(source, tokens, at, past) != 33u8 && !not_word(source, tokens[at])) { return at; } else {};
    };
    return past;
}

func parse_prefix(source:const SourceBytes in S, tokens:const Tokens in T,
                  ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val primary <- prefix_end(source, tokens, first, past);
    result.next <- primary;
    parse_primary(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    parse_calls(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    val prefix <- primary;
    val operand <- no_node();
    for (unused in first .. primary) {
        prefix <- prefix - 1u64;
        operand <- result.root;
        append_node(nodes, result, logical_not_node(), tokens[prefix].first, nodes[operand].past,
                    0u64, operand, no_node(), tokens[prefix].first);
        if (result.diagnostic != 0u8) { return; } else {};
    };
}

func parse_expression_operand(source:const SourceBytes in S, tokens:const Tokens in T,
                              ref nodes:ExprNodes in A, ref result:ParseResult in R,
                              past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_prefix(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    parse_binary(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) { return; } else {};
    val assignment <- result.next;
    if (!punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) { return; } else {}; # '<-'
    val destination <- result.root;
    result.next <- assignment + 1u64;
    parse_expression_operand(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return; } else {};
    val source_node <- result.root;
    append_node(nodes, result, transfer_node(), nodes[destination].first, nodes[source_node].past,
                0u64, destination, source_node, tokens[assignment].first);
}

func parse_expression_at(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R,
                         past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_operand(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) { return; } else {};
    val colon <- result.next;
    if (punct_at(source, tokens, colon, past) != 58u8) { return; } else {}; # ':'
    val annotation <- colon + 1u64;
    result.next <- annotation;
    if (annotation >= past || tokens[annotation].kind != identifier()) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    if (!void_word(source, tokens[annotation])) {
        result.diagnostic <- unsupported_typed_expression();
        return;
    } else {};
    val operand <- result.root;
    append_node(nodes, result, discard_node(), nodes[operand].first, tokens[annotation].past,
                0u64, operand, no_node(), tokens[colon].first);
    if (result.diagnostic == 0u8) { (result.next <- annotation + 1u64):void; } else {};
}

func parse_binary(source:const SourceBytes in S, tokens:const Tokens in T,
                  ref nodes:ExprNodes in A, ref result:ParseResult in R,
                  past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    # Every accepted operator advances next. An error leaves next at the
    # failing token so the caller can recover or report its source span.
    for (unused in result.next .. past) {
        if (!parse_infix(source, tokens, nodes, result, past, minimum)) { return; } else {};
    };
}

func parse_next_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                           ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

func parse_infix(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R,
                 past:u64, minimum:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val op <- punct_at(source, tokens, result.next, past);
    val predicate <- comparison(source, tokens, result.next, past);
    val kind <- compare_node();
    val binding <- 0u8;
    if (punct_pair_at(source, tokens, result.next, past, 124u8, 124u8)) {
        kind <- logical_or_node();
        (binding <- 1u8):void;
    } else {};
    if (punct_pair_at(source, tokens, result.next, past, 38u8, 38u8)) {
        kind <- logical_and_node();
        (binding <- 2u8):void;
    } else {};
    if (op == 42u8) { kind <- multiply_node(); (binding <- 6u8):void; } else {};
    if (op == 47u8) { kind <- divide_node(); (binding <- 6u8):void; } else {};
    if (op == 37u8) { kind <- remainder_node(); (binding <- 6u8):void; } else {};
    if (op == 43u8) { kind <- add_node(); (binding <- 5u8):void; } else {};
    if (op == 45u8) { kind <- subtract_node(); (binding <- 5u8):void; } else {};
    if (predicate != no_node()) {
        binding <- if (predicate <= unequal_words()) { 3u8 } else { 4u8 };
        {};
    } else {};
    if (binding < minimum) { return false; } else {};
    val operation_at <- tokens[result.next].first;
    val left <- result.root;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, binding + 1u8);
    if (result.diagnostic != 0u8) { return false; } else {};
    val right <- result.root;
    val number <- if (kind == compare_node()) { predicate } else { 0u64 };
    append_node(nodes, result, kind, nodes[left].first, nodes[right].past, number, left, right, operation_at);
    return result.diagnostic == 0u8;
}

func reset_parse_result(first:u64, ref result:ParseResult in R) -> void where {owner R} {
    result.next <- first;
    result.used <- 0u64;
    result.root <- 0u64;
    result.diagnostic <- 0u8;
    return;
}

# Tokens come from the indexed lexer over source. The caller supplies
# initialized node storage and receives a root index or a diagnostic at next.
func parse_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, first:u64, past:u64,
                      ref result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(first, result);
    if (first > past || past > len(tokens)) {
        result.diagnostic <- expected_operand();
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

export Tokens;
export ExprNode;
export ExprNodes;
export ParseResult;
export parse_expression;
export reset_parse_result;
export unexpected_token;
export expected_deferred_call;
export unsupported_deferred_form;
export punct_at;
export punct_pair_at;
export append_node;
export parse_identifier;
export parse_symbol;
export parse_binding_name;
export parse_block;
export parse_next_expression;
export expected_name;
export expected_type;
