using "SourceStorage.cod" SourceBytes;
using "SourceStorage.cod" Token;
using "ParserStorage.cod" Tokens;
using "ParserStorage.cod" ExprNode;
using "ParserStorage.cod" ExprNodes;
using "ParserStorage.cod" len;
using "ParserStorage.cod" literal_node;
using "ParserStorage.cod" add_node;
using "ParserStorage.cod" multiply_node;
using "ParserStorage.cod" group_node;
using "ParserStorage.cod" name_node;
using "ParserStorage.cod" call_node;
using "ParserStorage.cod" argument_node;
using "ParserStorage.cod" no_node;
using "Lexer.cod" identifier;
using "Lexer.cod" integer_literal;
using "Lexer.cod" punctuation;

data ParseResult {
    next:u64;
    used:u64;
    root:u64;
    diagnostic:u8;
}

func expected_operand() -> u8 { return 1u8; }
func expected_close() -> u8 { return 2u8; }
func expected_u64() -> u8 { return 3u8; }
func literal_too_large() -> u8 { return 4u8; }
func node_storage_exhausted() -> u8 { return 5u8; }
func unexpected_token() -> u8 { return 6u8; }
func expected_argument_separator() -> u8 { return 7u8; }

func punct_at(source:const SourceBytes in S, tokens:const Tokens in T,
              at:u64, past:u64) -> u8 where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) { return 0u8; } else {};
    val first <- tokens[at].first;
    if (tokens[at].past - first != 1u64) { return 0u8; } else {};
    return source[first];
}

func append_decimal_digit(ref number:u64 in N, byte:u8) -> bool where {owner N} {
    val digit:u64 <- byte - 48u8;
    if (number > (18446744073709551615u64 - digit) / 10u64) { return false; } else {};
    number <- number * 10u64 + digit;
    return true;
}

func parse_literal(source:const SourceBytes in S, token:const Token in T,
                   ref result:ParseResult in R) -> u64 where {const owner S, const owner T, owner R} {
    val end <- token.past;
    if (end - token.first < 4u64 || source[end - 3u64] != 117u8 ||
        source[end - 2u64] != 54u8 || source[end - 1u64] != 52u8) {
        result.diagnostic <- expected_u64();
        return 0u64;
    } else {};
    val number <- 0u64;
    for (at in token.first .. end - 3u64) {
        if (!append_decimal_digit(number, source[at])) {
            result.diagnostic <- literal_too_large();
            return 0u64;
        } else {};
    };
    return number;
}

func append_node(ref nodes:ExprNodes in A, ref result:ParseResult in R,
                 kind:u8, first:u64, past:u64, number:u64, left:u64,
                 right:u64, operation_at:u64) -> void where {owner A, owner R} {
    val id <- result.used;
    if (id >= len(nodes)) {
        result.diagnostic <- node_storage_exhausted();
        return;
    } else {};
    nodes[id].kind <- kind;
    nodes[id].first <- first;
    nodes[id].past <- past;
    nodes[id].number <- number;
    nodes[id].left <- left;
    nodes[id].right <- right;
    nodes[id].operation_at <- operation_at;
    result.root <- id;
    result.used <- id + 1u64;
    return;
}

func precedence(op:u8) -> u8 {
    if (op == 43u8) { return 1u8; } else {}; # '+'
    if (op == 42u8) { return 2u8; } else {}; # '*'
    return 0u8;
}

func parse_primary(source:const SourceBytes in S, tokens:const Tokens in T,
                   ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_operand(); return; } else {};
    val first <- tokens[at].first;
    if (punct_at(source, tokens, at, past) == 40u8) { # '('
        result.next <- at + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) { return; } else {};
        val close <- result.next;
        if (punct_at(source, tokens, close, past) != 41u8) { # ')'
            result.diagnostic <- expected_close();
            return;
        } else {};
        val inner <- result.root;
        append_node(nodes, result, group_node(), first, tokens[close].past, 0u64, inner, 0u64, first);
        if (result.diagnostic != 0u8) { return; } else {};
        (result.next <- close + 1u64):void;
        return;
    } else {};
    if (tokens[at].kind == integer_literal()) {
        val number <- parse_literal(source, tokens[at], result);
        if (result.diagnostic != 0u8) { return; } else {};
        append_node(nodes, result, literal_node(), first, tokens[at].past, number, 0u64, 0u64, first);
    } else {
        if (tokens[at].kind != identifier()) { result.diagnostic <- expected_operand(); return; } else {};
        append_node(nodes, result, name_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    };
    if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
}

# Each argument entry links to its preceding prefix on the left and its
# argument expression on the right. The call links to the final entry.
func parse_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                    ref nodes:ExprNodes in A, ref result:ParseResult in R,
                    first:u64, previous:u64, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) { return false; } else {};
    val argument <- result.root;
    append_node(nodes, result, argument_node(), first, nodes[argument].past,
                0u64, previous, argument, nodes[argument].first);
    return result.diagnostic == 0u8;
}

func parse_arguments(source:const SourceBytes in S, tokens:const Tokens in T,
                     ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past) { result.diagnostic <- expected_operand(); return no_node(); } else {};
    val prefix <- no_node();
    val list_first <- tokens[start].first;
    val separator <- 0u8;
    for (unused in start .. past) {
        if (!parse_argument(source, tokens, nodes, result, list_first, prefix, past)) { return no_node(); } else {};
        prefix <- result.root;
        separator <- punct_at(source, tokens, result.next, past);
        if (separator == 41u8) { return prefix; } else {}; # ')'
        if (separator != 44u8) { # ','
            result.diagnostic <- expected_argument_separator();
            return no_node();
        } else {};
        (result.next <- result.next + 1u64):void;
    };
    result.diagnostic <- expected_operand();
    return no_node();
}

func parse_call(source:const SourceBytes in S, tokens:const Tokens in T,
                ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) { return false; } else {}; # '('
    val callee <- result.root;
    result.next <- open + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
        arguments <- parse_arguments(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) { return false; } else {};
    } else {};
    val close <- result.next;
    append_node(nodes, result, call_node(), nodes[callee].first, tokens[close].past,
                0u64, callee, arguments, tokens[open].first);
    if (result.diagnostic != 0u8) { return false; } else {};
    result.next <- close + 1u64;
    return true;
}

func parse_calls(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    for (unused in result.next .. past) {
        if (!parse_call(source, tokens, nodes, result, past)) { return; } else {};
    };
}

func parse_expression_at(source:const SourceBytes in S, tokens:const Tokens in T,
                         ref nodes:ExprNodes in A, ref result:ParseResult in R,
                         past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_primary(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};
    parse_calls(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) { return; } else {};

    # Every accepted operator advances next. An error leaves next at the
    # failing token so the caller can recover or report its source span.
    for (unused in result.next .. past) {
        if (!parse_infix(source, tokens, nodes, result, past, minimum)) { return; } else {};
    };
}

func parse_infix(source:const SourceBytes in S, tokens:const Tokens in T,
                 ref nodes:ExprNodes in A, ref result:ParseResult in R,
                 past:u64, minimum:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val binding <- precedence(punct_at(source, tokens, result.next, past));
    if (binding < minimum) { return false; } else {};
    val operation_at <- tokens[result.next].first;
    val left <- result.root;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, binding + 1u8);
    if (result.diagnostic != 0u8) { return false; } else {};
    val right <- result.root;
    val kind <- if (binding == 1u8) { add_node() } else { multiply_node() };
    append_node(nodes, result, kind, nodes[left].first, nodes[right].past, 0u64, left, right, operation_at);
    return result.diagnostic == 0u8;
}

func reset_parse_result(first:u64, ref result:ParseResult in R) -> void where {owner R} {
    result.next <- first;
    result.used <- 0u64;
    result.root <- 0u64;
    result.diagnostic <- 0u8;
    return;
}

# Tokens come from the indexed lexer over source. The caller supplies
# initialized node storage and receives a root index or a diagnostic at next.
func parse_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                      ref nodes:ExprNodes in A, first:u64, past:u64,
                      ref result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(first, result);
    if (first > past || past > len(tokens)) {
        result.diagnostic <- expected_operand();
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

export Tokens;
export ExprNode;
export ExprNodes;
export ParseResult;
export parse_expression;
export reset_parse_result;
export unexpected_token;
