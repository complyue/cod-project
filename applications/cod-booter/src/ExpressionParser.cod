using "ParserStorage.cod" {
    field_access_node, index_access_node, array_length_node, bodyless_defer_node,
    exception_local_node, ref_local_node, make_exception_node, make_named_node,
    construction_payload_node, construction_type_query_node, initializer_assignment_node,
    field_initializer_node, capacity_placement_node, cause_placement_node, named_argument_node,
    callable_local_node, throw_with_cause_node, throw_named_node, rethrow_from_node,
    owning_handle_local_node, borrowed_handle_local_node, make_own_handle_node,
    make_borrowed_handle_node, here_call_node, here_body_node, here_receiver_node, continue_node,
    break_node, narrow_integer_node, Tokens, ExprNode, ExprNodes, len, literal_node, add_node,
    multiply_node, subtract_node, divide_node, remainder_node, group_node, name_node, call_node,
    argument_node, deferred_call_node, deferred_block_node, block_node, full_scope_node,
    block_item_node, try_node, catch_clause_node, catch_handler_node, catch_binding_node,
    finally_clause_node, symbol_node, behave_node, throw_node, transfer_node, typed_name_node,
    readonly_declaration, val_binding_node, ptr_binding_node, null_node, return_node,
    owned_type_node, discarded_guard_result, discard_node, bool_node, conditional_node, range_node,
    range_header_node, logical_not_node, logical_and_node, logical_or_node, compare_node,
    equal_words, unequal_words, less_words, at_most_words, greater_words, at_least_words, no_node,
};
using "Lexer.cod" {
    exception_word, own_word, handle_word, ref_word, make_word, typeof_word, from_word,
    rethrow_word, reserved_value_name, intrinsic_word, len_word, reserved_lexical_binder, proc_word,
    func_word, region_word, capacity_word, identifier, integer_literal, punctuation, defer_word,
    catch_word, finally_word, try_word, const_word, behave_word, throw_word, symbol_name, in_word,
    ptr_word, val_word, null_word, return_word, void_word, if_word, for_word, continue_word,
    break_word, else_word, true_word, false_word, not_word,
};
using "SourceStorage.cod" { SourceBytes, Token };

export data ParseResult {
    next:u64;
    used:u64;
    root:u64;
    diagnostic:u8;
    supplied_here:bool;
}

func expected_operand() -> u8 { return 1u8; }
func expected_close() -> u8 { return 2u8; }
func expected_u64() -> u8 { return 3u8; }
func literal_too_large() -> u8 { return 4u8; }
func node_storage_exhausted() -> u8 { return 5u8; }
export func unexpected_token() -> u8 { return 6u8; }
func expected_argument_separator() -> u8 { return 7u8; }
export func expected_deferred_call() -> u8 { return 8u8; }
func expected_block() -> u8 { return 10u8; }
func expected_block_close() -> u8 { return 11u8; }
func expected_block_separator() -> u8 { return 12u8; }
func expected_try_clause() -> u8 { return 13u8; }
func expected_catch_header() -> u8 { return 14u8; }
func expected_catch_name() -> u8 { return 15u8; }
func catch_all_must_be_last() -> u8 { return 17u8; }
func expected_symbol() -> u8 { return 18u8; }
export func expected_name() -> u8 { return 19u8; }
export func expected_type() -> u8 { return 20u8; }
func expected_binding_operator() -> u8 { return 21u8; }
func unsupported_typed_expression() -> u8 { return 26u8; }
func expected_condition_open() -> u8 { return 27u8; }
func expected_exception_initializer() -> u8 { return 32u8; }
func invalid_exception_placement() -> u8 { return 33u8; }
func duplicate_exception_placement() -> u8 { return 34u8; }
func expected_range_header() -> u8 { return 36u8; }
func expected_handle_constructor() -> u8 { return 37u8; }
func expected_handle_owner() -> u8 { return 38u8; }
func expected_here_receiver() -> u8 { return 39u8; }
func duplicate_here_body() -> u8 { return 40u8; }
func expected_index_close() -> u8 { return 42u8; }
func expected_array_length_query() -> u8 { return 43u8; }

export func punct_at(source:const SourceBytes in S, tokens:const Tokens in T,
                     at:u64, past:u64) -> u8 where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) return 0u8;
    val first <- tokens[at].first;
    if (tokens[at].past - first != 1u64) return 0u8;
    return source[first];
}

export func punct_pair_at(source:const SourceBytes in S, tokens:const Tokens in T,
                          at:u64, past:u64, left:u8, right:u8) -> bool
    where {const owner S, const owner T} {
    if (at >= past || tokens[at].kind != punctuation()) return false;
    val first <- tokens[at].first;
    return tokens[at].past - first == 2u64 && source[first] == left && source[first + 1u64] == right;
}

func append_decimal_digit(number:u64 in N, byte:u8) -> bool where {owner N} {
    val digit:u64 <- byte - 48u8;
    if (number > (18446744073709551615u64 - digit) / 10u64) return false;
    number <- number * 10u64 + digit;
    return true;
}

func integer_width(source:const SourceBytes in S, token:const Token in T) -> u64
    where {const owner S, const owner T} {
    val end <- token.past;
    val length <- end - token.first;
    if (length >= 3u64 && source[end - 2u64] == 117u8 && source[end - 1u64] == 56u8) return 8u64;
    if (length >= 4u64 && source[end - 3u64] == 117u8) {
        if (source[end - 2u64] == 54u8 && source[end - 1u64] == 52u8) return 64u64;
        if (source[end - 2u64] == 51u8 && source[end - 1u64] == 50u8) return 32u64;
    } else {};
    return 0u64;
}

func parse_literal(source:const SourceBytes in S, token:const Token in T,
                   result:ParseResult in R, width:u64) -> u64 where {const owner S, const owner T, owner R} {
    if (width == 0u64) {
        result.diagnostic <- expected_u64();
        return 0u64;
    } else {};
    val suffix <- if (width == 8u64) { 2u64 } else { 3u64 };
    val end <- token.past - suffix;
    val number <- 0u64;
    for (at in token.first .. end) {
        if (!append_decimal_digit(number, source[at])) {
            result.diagnostic <- literal_too_large();
            return 0u64;
        } else {};
    };
    if ((width == 8u64 && number > 255u64) || (width == 32u64 && number > 4294967295u64)) {
        result.diagnostic <- literal_too_large();
        return 0u64;
    } else {};
    return number;
}

export func append_node(nodes:ExprNodes in A, result:ParseResult in R,
                        kind:u8, first:u64, past:u64, number:u64, left:u64,
                        right:u64, operation_at:u64) -> void where {owner A, owner R} {
    val id <- result.used;
    if (id >= len(nodes)) {
        result.diagnostic <- node_storage_exhausted();
        return;
    } else {};
    nodes[id].kind <- kind;
    nodes[id].first <- first;
    nodes[id].past <- past;
    nodes[id].number <- number;
    nodes[id].left <- left;
    nodes[id].right <- right;
    nodes[id].operation_at <- operation_at;
    result.root <- id;
    result.used <- id + 1u64;
    return;
}

func comparison(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (punct_pair_at(source, tokens, at, past, 61u8, 61u8)) return equal_words();
    if (punct_pair_at(source, tokens, at, past, 33u8, 61u8)) return unequal_words();
    if (punct_at(source, tokens, at, past) == 60u8) return less_words();
    if (punct_pair_at(source, tokens, at, past, 60u8, 61u8)) return at_most_words();
    if (punct_at(source, tokens, at, past) == 62u8) return greater_words();
    if (punct_pair_at(source, tokens, at, past, 62u8, 61u8)) return at_least_words();
    return no_node();
}

func outer_invocation(nodes:const ExprNodes in A, root:u64) -> u64 where {const owner A} {
    val at <- root;
    for (unused in 0u64 .. root + 1u64) {
        if (nodes[at].kind == call_node() || nodes[at].kind == behave_node()) return at;
        if (nodes[at].kind != group_node()) return no_node();
        at <- nodes[at].left;
    };
    return no_node();
}

func parse_defer(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val keyword <- tokens[result.next].first;
    val operand_start <- result.next + 1u64;
    result.next <- operand_start;
    if (punct_at(source, tokens, operand_start, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        val body <- result.root;
        val last <- parse_guard_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        if (last != no_node()) {
            val first <- nodes[body].first;
            append_node(nodes, result, try_node(), first, nodes[last].past, discarded_guard_result(), body, last, first);
            if (result.diagnostic != 0u8) return;
        } else {};
        val action <- result.root;
        append_node(nodes, result, deferred_block_node(), keyword, nodes[action].past,
                    0u64, action, no_node(), keyword);
        return;
    } else {};
    if (operand_start < past && (catch_word(source, tokens[operand_start]) || finally_word(source, tokens[operand_start]))) {
        val fallback <- parse_guard_clauses(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        append_node(nodes, result, bodyless_defer_node(), keyword, nodes[fallback].past, 0u64, no_node(), fallback, keyword);
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    val invocation <- outer_invocation(nodes, operand);
    if (invocation == no_node()) {
        result.next <- operand_start;
        result.diagnostic <- expected_deferred_call();
        return;
    } else {};
    # Keep the operand's syntax and identify the one invocation that waits.
    append_node(nodes, result, deferred_call_node(), keyword, nodes[operand].past,
                0u64, operand, invocation, keyword);
}

# Each block item links its preceding item and its own expression.
func parse_block_item(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R,
                      past:u64, previous:u64, initializer:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val label <- if (initializer) { initializer_label(source, tokens, result.next, past) } else { no_node() };
    if (label == no_node()) {
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
    } else {
        parse_initializer_assignment(source, tokens, nodes, result, past, label);
    };
    if (result.diagnostic != 0u8) return false;
    val expression <- result.root;
    val first <- nodes[expression].first;
    val end <- nodes[expression].past;
    val separator <- result.next;
    if (separator >= past) { result.diagnostic <- expected_block_close(); return false; } else {};
    val delimiter <- punct_at(source, tokens, separator, past);
    if (delimiter == 59u8) { # ';'
        end <- tokens[separator].past;
        (result.next <- separator + 1u64):void;
    } else {};
    if (delimiter != 59u8 && delimiter != 125u8) { # ';' or '}'
        result.diagnostic <- expected_block_separator();
        return false;
    } else {};
    append_node(nodes, result, block_item_node(), first, end, 0u64, previous, expression, first);
    return result.diagnostic == 0u8;
}

func finish_block(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R,
                  past:u64, first:u64, last:u64, scoped:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val close <- result.next;
    if (scoped) {
        close <- close + 1u64;
        if (punct_at(source, tokens, close, past) != 125u8) { # '}'
            result.next <- close;
            result.diagnostic <- expected_block_close();
            return;
        } else {};
    } else {};
    val kind <- if (scoped) { full_scope_node() } else { block_node() };
    append_node(nodes, result, kind, first, tokens[close].past, 0u64, last, no_node(), first);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func parse_braced_items(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64, initializer:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 123u8) { # '{'
        result.diagnostic <- expected_block();
        return;
    } else {};
    val first <- tokens[open].first;
    val following <- open + 1u64;
    val scoped <- punct_at(source, tokens, following, past) == 123u8 &&
        tokens[following].first == tokens[open].past;
    if (scoped && initializer) { result.diagnostic <- expected_block(); return; } else {};
    result.next <- if (scoped) { following + 1u64 } else { following };
    val last <- no_node();
    for (unused in result.next .. past + 1u64) {
        if (punct_at(source, tokens, result.next, past) == 125u8) { # '}'
            finish_block(source, tokens, nodes, result, past, first, last, scoped);
            return;
        } else {};
        if (result.next >= past) { result.diagnostic <- expected_block_close(); return; } else {};
        if (!parse_block_item(source, tokens, nodes, result, past, last, initializer)) return;
        last <- result.root;
    };
    (result.diagnostic <- expected_block_close()):void;
}

export func parse_block(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_braced_items(source, tokens, nodes, result, past, false);
}

export func parse_identifier(source:const SourceBytes in S, tokens:const Tokens in T, nodes:ExprNodes in A,
                             result:ParseResult in R, past:u64, missing:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != identifier() || not_word(source, tokens[at])) {
        result.diagnostic <- missing;
        return false;
    } else {};
    val first <- tokens[at].first;
    append_node(nodes, result, name_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    if (result.diagnostic != 0u8) return false;
    result.next <- at + 1u64;
    return true;
}

export func exception_binder_width(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (at + 1u64 >= past) return 0u64;
    if (own_word(source, tokens[at]) && exception_word(source, tokens[at + 1u64])) return 2u64;
    if (exception_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        punct_at(source, tokens, at + 2u64, past) == 58u8) return 1u64;
    return 0u64;
}

func parse_catch_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) {
        result.diagnostic <- expected_catch_header();
        return;
    } else {};
    result.next <- open + 1u64;
    if (result.next < past && reserved_value_name(source, tokens[result.next])) {
        result.diagnostic <- expected_catch_name();
        return;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_catch_name())) return;
    val name <- result.root;
    val declared_type <- no_node();
    val access <- 0u64;
    if (punct_at(source, tokens, result.next, past) == 58u8) {
        result.next <- result.next + 1u64;
        if (result.next < past && const_word(source, tokens[result.next])) {
            access <- readonly_declaration();
            (result.next <- result.next + 1u64):void;
        } else {};
        if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
        (declared_type <- result.root):void;
    } else {};
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) {
        result.diagnostic <- expected_catch_header();
        return;
    } else {};
    result.next <- close + 1u64;
    val first <- tokens[open].first;
    append_node(nodes, result, catch_binding_node(), first, tokens[close].past, access, name, declared_type, first);
}

# Clauses link in source order through the preceding clause. A catch stores
# its binding and body together so a later pass can check that binding's scope.
func parse_catch_clause(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R,
                        past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    parse_catch_binding(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return false;
    val binding <- result.root;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return false;
    val body <- result.root;
    val end <- nodes[body].past;
    append_node(nodes, result, catch_handler_node(), first, end, 0u64, binding, body, first);
    if (result.diagnostic != 0u8) return false;
    val handler <- result.root;
    append_node(nodes, result, catch_clause_node(), first, end, 0u64, previous, handler, first);
    return nodes[binding].right == no_node();
}

func parse_catches(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- no_node();
    val catch_all <- false;
    for (unused in result.next .. past) {
        if (result.next >= past || !catch_word(source, tokens[result.next])) return last;
        if (catch_all) { result.diagnostic <- catch_all_must_be_last(); return no_node(); } else {};
        catch_all <- parse_catch_clause(source, tokens, nodes, result, past, last);
        if (result.diagnostic != 0u8) return no_node();
        last <- result.root;
    };
    return last;
}

func parse_guard_clauses(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val last <- parse_catches(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return no_node();
    if (result.next < past && finally_word(source, tokens[result.next])) {
        val finally_first <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return no_node();
        val cleanup <- result.root;
        append_node(nodes, result, finally_clause_node(), finally_first, nodes[cleanup].past,
                    0u64, last, cleanup, finally_first);
        if (result.diagnostic != 0u8) return no_node();
        return result.root;
    } else {};
    return last;
}

func parse_try(source:const SourceBytes in S, tokens:const Tokens in T,
               nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val begin <- result.next;
    val first <- tokens[begin].first;
    result.next <- begin + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val last <- parse_guard_clauses(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    if (last == no_node()) {
        result.next <- begin;
        result.diagnostic <- expected_try_clause();
        return;
    } else {};
    append_node(nodes, result, try_node(), first, nodes[last].past, 0u64, body, last, first);
}

export func parse_symbol(tokens:const Tokens in T, nodes:ExprNodes in A,
                         result:ParseResult in R, past:u64) -> bool
    where {const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past || tokens[at].kind != symbol_name()) {
        result.diagnostic <- expected_symbol();
        return false;
    } else {};
    val first <- tokens[at].first;
    append_node(nodes, result, symbol_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    if (result.diagnostic != 0u8) return false;
    result.next <- at + 1u64;
    return true;
}

func parse_behave(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_symbol(tokens, nodes, result, past)) return;
    val callee <- result.root;
    val end <- nodes[callee].past;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) == 40u8) { # '('
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
            arguments <- parse_arguments(source, tokens, nodes, result, past, false, false);
            if (result.diagnostic != 0u8) return;
        } else {};
        end <- tokens[result.next].past;
        (result.next <- result.next + 1u64):void;
    } else {};
    append_node(nodes, result, behave_node(), first, end, 0u64, callee, arguments, first);
}

func parse_completion(source:const SourceBytes in S, tokens:const Tokens in T,
                      nodes:ExprNodes in A, result:ParseResult in R,
                      past:u64, kind:u8, guard_arm:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    val following <- punct_at(source, tokens, result.next, past);
    if (following == 59u8 || following == 125u8 ||
        (guard_arm && result.next < past && else_word(source, tokens[result.next]))) {
        append_node(nodes, result, kind, first, tokens[at].past, 0u64, no_node(), no_node(), first);
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    if (kind != throw_node()) {
        append_node(nodes, result, kind, first, nodes[operand].past, 0u64, operand, no_node(), first);
        return;
    } else {};
    val cause <- no_node();
    if (result.next < past && from_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        (cause <- result.root):void;
    } else {};
    if (nodes[operand].kind == name_node() && punct_at(source, tokens, result.next, past) == 123u8) {
        val fields <- parse_initializer_fields(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        val end <- tokens[result.next].past;
        result.next <- result.next + 1u64;
        append_node(nodes, result, construction_payload_node(), nodes[operand].past, end, 2u64,
                    fields, cause, nodes[operand].past);
        if (result.diagnostic != 0u8) return;
        val payload <- result.root;
        append_node(nodes, result, throw_named_node(), first, end, 0u64, operand, payload, first);
        return;
    } else {};
    if (cause != no_node()) {
        append_node(nodes, result, throw_with_cause_node(), first, nodes[cause].past, 0u64, operand, cause, first);
        return;
    } else {};
    append_node(nodes, result, kind, first, nodes[operand].past, 0u64, operand, no_node(), first);
}

export func parse_binding_name(source:const SourceBytes in S, tokens:const Tokens in T,
                               nodes:ExprNodes in A, result:ParseResult in R,
                               past:u64, require_type:bool, qualified:bool, field:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (!field && result.next < past && reserved_lexical_binder(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return false;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    if (punct_at(source, tokens, result.next, past) != 58u8) { # ':'
        if (require_type) { result.diagnostic <- expected_type(); return false; } else {};
        return true;
    } else {};
    val name <- result.root;
    val colon <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val readonly <- qualified && result.next < past && const_word(source, tokens[result.next]);
    if (readonly) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return false;
    val annotation <- result.root;
    if (result.next < past && in_word(source, tokens[result.next])) {
        val anchor <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        val owner_name <- result.root;
        append_node(nodes, result, owned_type_node(), nodes[annotation].first, nodes[owner_name].past,
                    0u64, annotation, owner_name, anchor);
        if (result.diagnostic != 0u8) return false;
        (annotation <- result.root):void;
    } else {};
    append_node(nodes, result, typed_name_node(), nodes[name].first, nodes[annotation].past,
                if (readonly) { readonly_declaration() } else { 0u64 }, name, annotation, colon);
    return result.diagnostic == 0u8;
}

func parse_local_binding(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R,
                         past:u64, kind:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_binding_name(source, tokens, nodes, result, past, kind == ptr_binding_node(), true, false)) return;
    val binding <- result.root;
    val assignment <- result.next;
    val valid <- if (kind != val_binding_node()) {
        punct_at(source, tokens, assignment, past) == 61u8 # '='
    } else {
        punct_pair_at(source, tokens, assignment, past, 60u8, 45u8) # '<-'
    };
    if (!valid) { result.diagnostic <- expected_binding_operator(); return; } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    append_node(nodes, result, kind, first, nodes[initializer].past, 0u64, binding, initializer, tokens[assignment].first);
}

func parse_null(source:const SourceBytes in S, tokens:const Tokens in T,
                nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    val first <- tokens[at].first;
    result.next <- at + 1u64;
    if (result.next < past && in_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
        val owner_name <- result.root;
        append_node(nodes, result, null_node(), first, nodes[owner_name].past, 0u64, owner_name, no_node(), first);
        return;
    } else {};
    append_node(nodes, result, null_node(), first, tokens[at].past, 0u64, no_node(), no_node(), first);
}

func parse_conditional(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_condition_open(); return; } else {};
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val condition <- result.root;
    if (punct_at(source, tokens, result.next, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    result.next <- result.next + 1u64;
    val single_return <- result.next < past && return_word(source, tokens[result.next]);
    if (single_return) {
        parse_completion(source, tokens, nodes, result, past, return_node(), true);
    } else {
        parse_block(source, tokens, nodes, result, past);
    };
    if (result.diagnostic != 0u8) return;
    val yes <- result.root;
    # Use the return terminator as the outer separator unless an else follows it.
    if (single_return && punct_at(source, tokens, result.next, past) == 59u8 &&
        result.next + 1u64 < past && else_word(source, tokens[result.next + 1u64])) {
        (result.next <- result.next + 1u64):void;
    } else {};
    if (result.next < past && else_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        if (result.next < past && if_word(source, tokens[result.next])) {
            parse_conditional(source, tokens, nodes, result, past);
        } else {
            parse_block(source, tokens, nodes, result, past);
        };
    } else {
        val end <- nodes[yes].past;
        append_node(nodes, result, block_node(), end, end, 0u64, no_node(), no_node(), end);
    };
    if (result.diagnostic != 0u8) return;
    val no <- result.root;
    append_node(nodes, result, conditional_node(), first, nodes[no].past, no, condition, yes, first);
}

func parse_range(source:const SourceBytes in S, tokens:const Tokens in T,
                 nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (punct_at(source, tokens, result.next, past) != 40u8) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- result.next + 1u64;
    if (result.next < past && reserved_lexical_binder(source, tokens[result.next])) {
        result.diagnostic <- expected_name();
        return;
    } else {};
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val index <- result.root;
    if (result.next >= past || !in_word(source, tokens[result.next])) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val lower <- result.root;
    val separator <- result.next;
    if (!punct_pair_at(source, tokens, separator, past, 46u8, 46u8)) { result.diagnostic <- expected_range_header(); return; } else {};
    result.next <- separator + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val upper <- result.root;
    if (punct_at(source, tokens, result.next, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    append_node(nodes, result, range_header_node(), nodes[index].first, tokens[result.next].past,
                index, lower, upper, tokens[separator].first);
    if (result.diagnostic != 0u8) return;
    val header <- result.root;
    result.next <- result.next + 1u64;
    parse_block(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val empty <- no_node();
    if (result.next < past && else_word(source, tokens[result.next])) {
        result.next <- result.next + 1u64;
        parse_block(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        (empty <- result.root):void;
    } else {};
    append_node(nodes, result, range_node(), first, nodes[result.root].past, empty, header, body, first);
}

func parse_exception_local(source:const SourceBytes in S, tokens:const Tokens in T,
                           nodes:ExprNodes in A, result:ParseResult in R,
                           past:u64, width:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + width;
    if (!parse_binding_name(source, tokens, nodes, result, past, true, true, false)) return;
    val binding <- result.root;
    val assignment <- result.next;
    if (nodes[nodes[binding].right].kind == owned_type_node() ||
        !punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return;
    } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    append_node(nodes, result, exception_local_node(), first, nodes[initializer].past, 0u64,
                binding, initializer, tokens[assignment].first);
}

export func callable_local_head(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> bool
    where {const owner S, const owner T} {
    if (at >= past) return false;
    val mode <- if (const_word(source, tokens[at])) { at + 1u64 } else { at };
    if (mode + 2u64 >= past || tokens[mode + 1u64].kind != identifier() ||
        (!func_word(source, tokens[mode]) && !proc_word(source, tokens[mode]))) return false;
    val next <- punct_at(source, tokens, mode + 2u64, past);
    return next == 61u8 || next == 58u8; # '=' or ':'
}

func parse_callable_local(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val fixed <- const_word(source, tokens[result.next]);
    if (fixed) { (result.next <- result.next + 1u64):void; } else {};
    val function_mode <- func_word(source, tokens[result.next]);
    result.next <- result.next + 1u64;
    if (!parse_binding_name(source, tokens, nodes, result, past, false, false, false)) return;
    val binding <- result.root;
    val assignment <- result.next;
    if (punct_at(source, tokens, assignment, past) != 61u8) {
        result.diagnostic <- expected_binding_operator();
        return;
    } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    val mode <- (if (function_mode) { 1u64 } else { 0u64 }) + (if (fixed) { 2u64 } else { 0u64 });
    append_node(nodes, result, callable_local_node(), first, nodes[initializer].past, mode,
                binding, initializer, tokens[assignment].first);
}

func handle_local_prefix(source:const SourceBytes in S, tokens:const Tokens in T, at:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (at + 1u64 < past && handle_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier())
        return 1u64;
    val qualifier <- if (const_word(source, tokens[at])) { at + 1u64 } else { at };
    if (qualifier + 1u64 < past && own_word(source, tokens[qualifier]) && handle_word(source, tokens[qualifier + 1u64]))
        return qualifier + 2u64 - at;
    return 0u64;
}

func parse_handle_local(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R,
                        past:u64, width:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val owning <- width != 1u64;
    result.next <- result.next + width;
    if (!parse_binding_name(source, tokens, nodes, result, past, true, false, false)) return;
    val binding <- result.root;
    if (owning && nodes[nodes[binding].right].kind == owned_type_node()) {
        result.diagnostic <- expected_handle_constructor();
        return;
    } else {};
    val assignment <- result.next;
    val valid <- if (owning) { punct_pair_at(source, tokens, assignment, past, 60u8, 45u8) }
                 else { punct_at(source, tokens, assignment, past) == 61u8 };
    if (!valid) { result.diagnostic <- expected_binding_operator(); return; } else {};
    result.next <- assignment + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val initializer <- result.root;
    val kind <- if (owning) { owning_handle_local_node() } else { borrowed_handle_local_node() };
    append_node(nodes, result, kind, first, nodes[initializer].past, if (width == 3u64) { 1u64 } else { 0u64 },
                binding, initializer, tokens[assignment].first);
}

func parse_array_length(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    val selected <- start + 2u64;
    val open <- start + 4u64;
    if (open >= past || punct_at(source, tokens, start + 1u64, past) != 40u8 ||
        !len_word(source, tokens[selected]) || punct_at(source, tokens, start + 3u64, past) != 41u8 ||
        punct_at(source, tokens, open, past) != 40u8) {
        result.diagnostic <- expected_array_length_query();
        return;
    } else {};
    result.next <- open + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val operand <- result.root;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) { result.diagnostic <- expected_close(); return; } else {};
    append_node(nodes, result, array_length_node(), tokens[start].first, tokens[close].past,
                0u64, operand, no_node(), tokens[selected].first);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func parse_primary(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (at >= past) { result.diagnostic <- expected_operand(); return; } else {};
    val first <- tokens[at].first;
    if (if_word(source, tokens[at])) { parse_conditional(source, tokens, nodes, result, past); return; } else {};
    if (for_word(source, tokens[at])) { parse_range(source, tokens, nodes, result, past); return; } else {};
    if (defer_word(source, tokens[at])) {
        parse_defer(source, tokens, nodes, result, past);
        return;
    } else {};
    if (try_word(source, tokens[at])) { parse_try(source, tokens, nodes, result, past); return; } else {};
    if (rethrow_word(source, tokens[at]) && at + 1u64 < past && from_word(source, tokens[at + 1u64])) {
        result.next <- at + 2u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        val cause <- result.root;
        append_node(nodes, result, rethrow_from_node(), first, nodes[cause].past, 0u64, cause, no_node(), first);
        return;
    } else {};
    if (throw_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, throw_node(), false);
        return;
    } else {};
    if (return_word(source, tokens[at])) {
        parse_completion(source, tokens, nodes, result, past, return_node(), false);
        return;
    } else {};
    if (result.supplied_here && (continue_word(source, tokens[at]) || break_word(source, tokens[at]))) {
        val handoff_kind <- if (continue_word(source, tokens[at])) { continue_node() } else { break_node() };
        parse_completion(source, tokens, nodes, result, past, handoff_kind, false);
        return;
    } else {};
    val exception_width <- exception_binder_width(source, tokens, at, past);
    if (exception_width != 0u64) { parse_exception_local(source, tokens, nodes, result, past, exception_width); return; } else {};
    val handle_width <- handle_local_prefix(source, tokens, at, past);
    if (handle_width != 0u64) { parse_handle_local(source, tokens, nodes, result, past, handle_width); return; } else {};
    if (make_word(source, tokens[at])) { parse_construction(source, tokens, nodes, result, past); return; } else {};
    if (callable_local_head(source, tokens, at, past)) { parse_callable_local(source, tokens, nodes, result, past); return; } else {};
    if (ref_word(source, tokens[at]) && at + 1u64 < past && tokens[at + 1u64].kind == identifier()) {
        parse_local_binding(source, tokens, nodes, result, past, ref_local_node());
        return;
    } else {};
    if (val_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, val_binding_node()); return; } else {};
    if (ptr_word(source, tokens[at])) { parse_local_binding(source, tokens, nodes, result, past, ptr_binding_node()); return; } else {};
    if (null_word(source, tokens[at])) { parse_null(source, tokens, nodes, result, past); return; } else {};
    if (behave_word(source, tokens[at])) { parse_behave(source, tokens, nodes, result, past); return; } else {};
    if (intrinsic_word(source, tokens[at])) { parse_array_length(source, tokens, nodes, result, past); return; } else {};
    if (tokens[at].kind == symbol_name()) { (parse_symbol(tokens, nodes, result, past)):void; return; } else {};
    if (punct_at(source, tokens, at, past) == 123u8) { # '{'
        parse_block(source, tokens, nodes, result, past);
        return;
    } else {};
    if (punct_at(source, tokens, at, past) == 40u8) { # '('
        result.next <- at + 1u64;
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return;
        val close <- result.next;
        if (punct_at(source, tokens, close, past) != 41u8) { # ')'
            result.diagnostic <- expected_close();
            return;
        } else {};
        val inner <- result.root;
        append_node(nodes, result, group_node(), first, tokens[close].past, 0u64, inner, 0u64, first);
        if (result.diagnostic != 0u8) return;
        (result.next <- close + 1u64):void;
        return;
    } else {};
    val truth <- true_word(source, tokens[at]);
    if (truth || false_word(source, tokens[at])) {
        append_node(nodes, result, bool_node(), first, tokens[at].past, if (truth) { 1u64 } else { 0u64 },
                    0u64, 0u64, first);
        if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
        return;
    } else {};
    if (tokens[at].kind == integer_literal()) {
        val width <- integer_width(source, tokens[at]);
        val number <- parse_literal(source, tokens[at], result, width);
        if (result.diagnostic != 0u8) return;
        val literal_kind <- if (width == 64u64) { literal_node() } else { narrow_integer_node() };
        append_node(nodes, result, literal_kind, first, tokens[at].past, number, width, no_node(), first);
    } else {
        if (tokens[at].kind != identifier() || reserved_value_name(source, tokens[at])) {
            result.diagnostic <- expected_operand();
            return;
        } else {};
        append_node(nodes, result, name_node(), first, tokens[at].past, 0u64, 0u64, 0u64, first);
    };
    if (result.diagnostic == 0u8) { (result.next <- at + 1u64):void; } else {};
}

func begins_checked_ref_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                                 at:u64, past:u64) -> bool where {const owner S, const owner T} {
    val operand <- at + 2u64;
    if (operand >= past || !not_word(source, tokens[at]) || !null_word(source, tokens[at + 1u64]) ||
        in_word(source, tokens[operand])) return false;
    val kind <- tokens[operand].kind;
    val punct <- punct_at(source, tokens, operand, past);
    return kind == identifier() || kind == integer_literal() || kind == symbol_name() ||
        punct == 40u8 || punct == 123u8 || punct == 33u8;
}

# Each argument entry links to the previous entry and its ordinary expression.
# The checked ref bit belongs to preparation at this call site.
func parse_argument(source:const SourceBytes in S, tokens:const Tokens in T,
                    nodes:ExprNodes in A, result:ParseResult in R,
                    first:u64, previous:u64, past:u64, named:bool, field_labels:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val argument <- no_node();
    val start <- result.next;
    val operand_first <- tokens[start].first;
    val checked <- named && !field_labels && begins_checked_ref_argument(source, tokens, start, past);
    if (checked) { (result.next <- start + 2u64):void; } else {};
    if (!named || !punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
        parse_expression_at(source, tokens, nodes, result, past, 1u8);
        if (result.diagnostic != 0u8) return false;
        (argument <- result.root):void;
    } else {};
    if (named && punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) {
        val arrow <- tokens[result.next].first;
        result.next <- result.next + 1u64;
        if (!field_labels && result.next < past && reserved_value_name(source, tokens[result.next])) {
            result.diagnostic <- expected_name();
            return false;
        } else {};
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
        val label <- result.root;
        val named_first <- if (argument == no_node()) { arrow } else { operand_first };
        append_node(nodes, result, named_argument_node(), named_first, nodes[label].past, 0u64, argument, label, arrow);
        if (result.diagnostic != 0u8) return false;
        (argument <- result.root):void;
    } else {};
    append_node(nodes, result, argument_node(), if (checked) { operand_first } else { first },
                nodes[argument].past, if (checked) { 1u64 } else { 0u64 }, previous, argument, operand_first);
    return result.diagnostic == 0u8;
}

func parse_arguments(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R, past:u64, named:bool, field_labels:bool) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val start <- result.next;
    if (start >= past) { result.diagnostic <- expected_operand(); return no_node(); } else {};
    val prefix <- no_node();
    val list_first <- tokens[start].first;
    val separator <- 0u8;
    for (unused in start .. past) {
        if (!parse_argument(source, tokens, nodes, result, list_first, prefix, past, named, field_labels)) return no_node();
        prefix <- result.root;
        separator <- punct_at(source, tokens, result.next, past);
        if (separator == 41u8) return prefix;
        if (separator != 44u8) {
            result.diagnostic <- expected_argument_separator();
            return no_node();
        } else {};
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_operand();
    return no_node();
}

func parse_initializer_field(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:u64, previous:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return false;
    val name <- result.root;
    val operator_at <- result.next;
    val rebind <- punct_at(source, tokens, operator_at, past) == 61u8;
    if (!rebind && !punct_pair_at(source, tokens, operator_at, past, 60u8, 45u8)) {
        result.diagnostic <- expected_binding_operator();
        return false;
    } else {};
    result.next <- operator_at + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return false;
    val value <- result.root;
    append_node(nodes, result, field_initializer_node(), nodes[name].first, nodes[value].past,
                if (rebind) { 1u64 } else { 0u64 }, name, value, tokens[operator_at].first);
    if (result.diagnostic != 0u8) return false;
    val field <- result.root;
    append_node(nodes, result, argument_node(), nodes[field].first, nodes[field].past, 0u64,
                previous, field, nodes[field].first);
    return result.diagnostic == 0u8;
}

func parse_initializer_fields(source:const SourceBytes in S, tokens:const Tokens in T,
                              nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    val tail <- no_node();
    val delimiter <- 0u8;
    for (unused in result.next .. past) {
        if (punct_at(source, tokens, result.next, past) == 125u8) return tail;
        if (!parse_initializer_field(source, tokens, nodes, result, past, tail)) return no_node();
        tail <- result.root;
        delimiter <- punct_at(source, tokens, result.next, past);
        if (delimiter == 125u8) return tail;
        if (delimiter != 59u8) { result.diagnostic <- expected_block_separator(); return no_node(); } else {};
        result.next <- result.next + 1u64;
    };
    result.diagnostic <- expected_block_close();
    return no_node();
}

# A bare or parenthesized name followed by an assignment can select a product
# field or a scalar block's lexical destination. The checked type decides.
func initializer_label(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    val operator_at <- first;
    for (at in first .. past) {
        if (punct_at(source, tokens, at, past) != 40u8) {
            if (tokens[at].kind != identifier()) return no_node();
            operator_at <- at + 1u64;
            for (unused in first .. at) {
                if (punct_at(source, tokens, operator_at, past) != 41u8) return no_node();
                operator_at <- operator_at + 1u64;
            };
            if (punct_at(source, tokens, operator_at, past) == 61u8 ||
                punct_pair_at(source, tokens, operator_at, past, 60u8, 45u8)) return at;
            return no_node();
        } else {};
    };
    return no_node();
}

func parse_initializer_assignment(source:const SourceBytes in S, tokens:const Tokens in T,
                                  nodes:ExprNodes in A, result:ParseResult in R, past:u64, label:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val left <- label;
    val right <- label;
    val operand <- no_node();
    append_node(nodes, result, name_node(), tokens[label].first, tokens[label].past, 0u64, no_node(), no_node(), tokens[label].first);
    if (result.diagnostic != 0u8) return;
    for (unused in first .. label) {
        left <- left - 1u64;
        right <- right + 1u64;
        operand <- result.root;
        append_node(nodes, result, group_node(), tokens[left].first, tokens[right].past, 0u64, operand, no_node(), tokens[left].first);
        if (result.diagnostic != 0u8) return;
    };
    val destination <- result.root;
    val operator_at <- right + 1u64;
    val rebind <- punct_at(source, tokens, operator_at, past) == 61u8;
    result.next <- operator_at + 1u64;
    parse_expression_operand(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val input <- result.root;
    append_node(nodes, result, initializer_assignment_node(), tokens[first].first, nodes[input].past,
                if (rebind) { 1u64 } else { 0u64 }, destination, input, tokens[operator_at].first);
    if (result.diagnostic == 0u8) { parse_result_annotation(source, tokens, nodes, result, past); } else {};
}

func parse_exception_placement(source:const SourceBytes in S, tokens:const Tokens in T,
                               nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    val site <- result.next;
    if (site >= past) return no_node();
    val by_capacity <- in_word(source, tokens[site]);
    if (!by_capacity && !from_word(source, tokens[site])) return no_node();
    result.next <- site + 1u64;
    if (by_capacity) {
        if (result.next >= past || !region_word(source, tokens[result.next]) ||
            punct_at(source, tokens, result.next + 1u64, past) != 40u8) {
            result.diagnostic <- invalid_exception_placement();
            return no_node();
        } else {};
        (result.next <- result.next + 2u64):void;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return no_node();
    val operand <- result.root;
    val end <- nodes[operand].past;
    if (by_capacity) {
        if (!punct_pair_at(source, tokens, result.next, past, 45u8, 62u8) ||
            result.next + 1u64 >= past || !capacity_word(source, tokens[result.next + 1u64]) ||
            punct_at(source, tokens, result.next + 2u64, past) != 41u8) {
            result.diagnostic <- invalid_exception_placement();
            return no_node();
        } else {};
        end <- tokens[result.next + 2u64].past;
        (result.next <- result.next + 3u64):void;
    } else {};
    val kind <- if (by_capacity) { capacity_placement_node() } else { cause_placement_node() };
    append_node(nodes, result, kind, tokens[site].first, end, 0u64, operand, no_node(), tokens[site].first);
    return result.root;
}

func parse_construction_type(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R,
                             past:u64, exception:bool) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val at <- result.next;
    if (exception || at >= past || !typeof_word(source, tokens[at]) || punct_at(source, tokens, at + 1u64, past) != 40u8)
        return parse_identifier(source, tokens, nodes, result, past, expected_type());
    result.next <- at + 2u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return false;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 41u8) { result.diagnostic <- expected_close(); return false; } else {};
    val operand <- result.root;
    val first <- tokens[at].first;
    append_node(nodes, result, construction_type_query_node(), first, tokens[close].past, 0u64, operand, no_node(), first);
    if (result.diagnostic != 0u8) return false;
    result.next <- close + 1u64;
    return true;
}

func parse_make_handle(source:const SourceBytes in S, tokens:const Tokens in T,
                       nodes:ExprNodes in A, result:ParseResult in R,
                       past:u64, first:u64, owning:bool) -> void
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + if (owning) { 2u64 } else { 1u64 };
    if (!parse_identifier(source, tokens, nodes, result, past, expected_type())) return;
    val marker <- result.root;
    if (punct_at(source, tokens, result.next, past) != 40u8) {
        result.diagnostic <- expected_handle_constructor();
        return;
    } else {};
    result.next <- result.next + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) {
        arguments <- parse_arguments(source, tokens, nodes, result, past, false, false);
        if (result.diagnostic != 0u8) return;
    } else {};
    val end <- tokens[result.next].past;
    result.next <- result.next + 1u64;
    val owner_name <- no_node();
    if (!owning) {
        if (result.next >= past || !in_word(source, tokens[result.next])) {
            result.diagnostic <- expected_handle_owner();
            return;
        } else {};
        result.next <- result.next + 1u64;
        if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
        owner_name <- result.root;
        (end <- nodes[owner_name].past):void;
    } else {};
    val kind <- if (owning) { make_own_handle_node() } else { make_borrowed_handle_node() };
    append_node(nodes, result, kind, first, end, owner_name, marker, arguments, first);
}

func parse_construction(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    val at <- result.next;
    val owning_handle <- at + 1u64 < past && own_word(source, tokens[at]) && handle_word(source, tokens[at + 1u64]);
    if (owning_handle || (at + 1u64 < past && handle_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        punct_at(source, tokens, at + 2u64, past) == 40u8)) {
        parse_make_handle(source, tokens, nodes, result, past, first, owning_handle);
        return;
    } else {};
    val exception <- at + 1u64 < past && exception_word(source, tokens[at]) && tokens[at + 1u64].kind == identifier() &&
        !in_word(source, tokens[at + 1u64]);
    if (exception) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_construction_type(source, tokens, nodes, result, past, exception)) return;
    val declared_type <- result.root;
    val positional <- nodes[declared_type].kind != construction_type_query_node() && punct_at(source, tokens, result.next, past) == 40u8;
    val arguments <- no_node();
    val placement <- no_node();
    if (positional) {
        result.next <- result.next + 1u64;
        if (punct_at(source, tokens, result.next, past) != 41u8) {
            arguments <- parse_arguments(source, tokens, nodes, result, past, true, true);
            if (result.diagnostic != 0u8) return;
        } else {};
        (result.next <- result.next + 1u64):void;
    } else {};
    if (exception) {
        placement <- parse_exception_placement(source, tokens, nodes, result, past);
        if (result.diagnostic != 0u8) return;
        if (result.next < past && (in_word(source, tokens[result.next]) || from_word(source, tokens[result.next]))) {
            result.diagnostic <- duplicate_exception_placement();
            return;
        } else {};
    } else {
        if (result.next < past && in_word(source, tokens[result.next])) {
            result.next <- result.next + 1u64;
            if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
            (placement <- result.root):void;
        } else {};
    };
    val braced <- !positional && punct_at(source, tokens, result.next, past) == 123u8;
    if (braced) {
        if (exception) {
            arguments <- parse_initializer_fields(source, tokens, nodes, result, past);
            if (result.diagnostic != 0u8) return;
            (result.next <- result.next + 1u64):void;
        } else {
            parse_braced_items(source, tokens, nodes, result, past, true);
            (arguments <- result.root):void;
        };
        if (result.diagnostic != 0u8) return;
    } else {
        if (exception && !positional) { result.diagnostic <- expected_exception_initializer(); return; } else {};
    };
    val end <- tokens[result.next - 1u64].past;
    val shape <- if (positional) { 1u64 } else { if (braced) { 2u64 } else { 0u64 } };
    append_node(nodes, result, construction_payload_node(), nodes[declared_type].past, end, shape,
                arguments, placement, nodes[declared_type].past);
    if (result.diagnostic != 0u8) return;
    val payload <- result.root;
    val kind <- if (exception) { make_exception_node() } else { make_named_node() };
    append_node(nodes, result, kind, first, end, 0u64, declared_type, payload, first);
}

func parse_call(source:const SourceBytes in S, tokens:const Tokens in T,
                nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val open <- result.next;
    if (punct_at(source, tokens, open, past) != 40u8) return false; # '('
    val callee <- result.root;
    result.next <- open + 1u64;
    val arguments <- no_node();
    if (punct_at(source, tokens, result.next, past) != 41u8) { # ')'
        arguments <- parse_arguments(source, tokens, nodes, result, past, true, false);
        if (result.diagnostic != 0u8) return false;
    } else {};
    val close <- result.next;
    append_node(nodes, result, call_node(), nodes[callee].first, tokens[close].past,
                0u64, callee, arguments, tokens[open].first);
    if (result.diagnostic != 0u8) return false;
    result.next <- close + 1u64;
    return true;
}

func parse_field_access(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val base <- result.root;
    val operation_at <- tokens[result.next].first;
    result.next <- result.next + 1u64;
    if (!parse_identifier(source, tokens, nodes, result, past, expected_name())) return;
    val field <- result.root;
    append_node(nodes, result, field_access_node(), nodes[base].first, nodes[field].past,
                0u64, base, field, operation_at);
}

func parse_index_access(source:const SourceBytes in S, tokens:const Tokens in T,
                        nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val base <- result.root;
    val open <- result.next;
    result.next <- open + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val index <- result.root;
    val close <- result.next;
    if (punct_at(source, tokens, close, past) != 93u8) { # ']'
        result.diagnostic <- expected_index_close();
        return;
    } else {};
    append_node(nodes, result, index_access_node(), nodes[base].first, tokens[close].past,
                0u64, base, index, tokens[open].first);
    if (result.diagnostic == 0u8) { (result.next <- close + 1u64):void; } else {};
}

func here_header_close(source:const SourceBytes in S, tokens:const Tokens in T, opening:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    if (punct_at(source, tokens, opening, past) != 40u8) return no_node();
    val depth <- 1u64;
    val delimiter <- 0u8;
    for (at in opening + 1u64 .. past) {
        delimiter <- punct_at(source, tokens, at, past);
        if (delimiter == 40u8) { (depth <- depth + 1u64):void; } else {};
        if (delimiter == 41u8) {
            depth <- depth - 1u64;
            if (depth == 0u64)
                return if (punct_pair_at(source, tokens, at + 1u64, past, 61u8, 62u8)) { at } else { no_node() };
        } else {};
    };
    return no_node();
}

func parse_here_receiver(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R, previous:u64, close:u64) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    val first <- tokens[result.next].first;
    val explicit_ref <- ref_word(source, tokens[result.next]);
    if (explicit_ref) { (result.next <- result.next + 1u64):void; } else {};
    if (!parse_binding_name(source, tokens, nodes, result, close, false, true, false)) return false;
    val binding <- result.root;
    append_node(nodes, result, here_receiver_node(), first, nodes[binding].past,
                if (explicit_ref) { 1u64 } else { 0u64 }, previous, binding, first);
    return result.diagnostic == 0u8;
}

func parse_here_receivers(source:const SourceBytes in S, tokens:const Tokens in T,
                          nodes:ExprNodes in A, result:ParseResult in R, close:u64) -> u64
    where {const owner S, const owner T, owner A, owner R} {
    result.next <- result.next + 1u64;
    val receivers <- no_node();
    for (unused in result.next .. close) {
        if (!parse_here_receiver(source, tokens, nodes, result, receivers, close)) return no_node();
        receivers <- result.root;
        if (result.next == close) return receivers;
        if (punct_at(source, tokens, result.next, close) != 44u8 || result.next + 1u64 == close) {
            result.diagnostic <- expected_here_receiver();
            return no_node();
        } else {};
        result.next <- result.next + 1u64;
    };
    return receivers;
}

func parse_here_body(source:const SourceBytes in S, tokens:const Tokens in T,
                     nodes:ExprNodes in A, result:ParseResult in R, past:u64, close:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val call <- result.root;
    val first <- tokens[result.next].first;
    val receivers <- no_node();
    if (close != no_node()) {
        receivers <- parse_here_receivers(source, tokens, nodes, result, close);
        if (result.diagnostic != 0u8) return;
        (result.next <- close + 2u64):void;
    } else {};
    val enclosing <- result.supplied_here;
    result.supplied_here <- true;
    parse_block(source, tokens, nodes, result, past);
    result.supplied_here <- enclosing;
    if (result.diagnostic != 0u8) return;
    val body <- result.root;
    val end <- nodes[body].past;
    append_node(nodes, result, here_body_node(), first, end, 0u64, receivers, body, first);
    if (result.diagnostic != 0u8) return;
    append_node(nodes, result, here_call_node(), nodes[call].first, end, 0u64, call, result.root, first);
}

func parse_postfix(source:const SourceBytes in S, tokens:const Tokens in T,
                   nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val kind <- 0u8;
    val close <- no_node();
    val suffix <- 0u8;
    for (unused in result.next .. past) {
        kind <- nodes[result.root].kind;
        suffix <- punct_at(source, tokens, result.next, past);
        if (kind == call_node() || kind == behave_node() || kind == here_call_node()) {
            (close <- here_header_close(source, tokens, result.next, past)):void;
        } else { (close <- no_node()):void; };
        if (close != no_node() || ((kind == call_node() || kind == behave_node() || kind == here_call_node()) &&
            suffix == 123u8)) {
            if (kind == here_call_node()) { result.diagnostic <- duplicate_here_body(); return; } else {};
            parse_here_body(source, tokens, nodes, result, past, close);
            if (result.diagnostic != 0u8) return;
        } else {
            if (suffix == 46u8) {
                parse_field_access(source, tokens, nodes, result, past);
                if (result.diagnostic != 0u8) return;
            } else {
                if (suffix == 91u8) { # '['
                    parse_index_access(source, tokens, nodes, result, past);
                    if (result.diagnostic != 0u8) return;
                } else {
                    if (!parse_call(source, tokens, nodes, result, past)) return;
                };
            };
        };
    };
}

func prefix_end(source:const SourceBytes in S, tokens:const Tokens in T, first:u64, past:u64) -> u64
    where {const owner S, const owner T} {
    for (at in first .. past) {
        if (punct_at(source, tokens, at, past) != 33u8 && !not_word(source, tokens[at])) return at;
    };
    return past;
}

func parse_prefix(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val first <- result.next;
    val primary <- prefix_end(source, tokens, first, past);
    result.next <- primary;
    parse_primary(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    parse_postfix(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    val prefix <- primary;
    val operand <- no_node();
    for (unused in first .. primary) {
        prefix <- prefix - 1u64;
        operand <- result.root;
        append_node(nodes, result, logical_not_node(), tokens[prefix].first, nodes[operand].past,
                    0u64, operand, no_node(), tokens[prefix].first);
        if (result.diagnostic != 0u8) return;
    };
}

func parse_expression_operand(source:const SourceBytes in S, tokens:const Tokens in T,
                              nodes:ExprNodes in A, result:ParseResult in R,
                              past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_prefix(source, tokens, nodes, result, past);
    if (result.diagnostic != 0u8) return;
    parse_binary(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) return;
    val assignment <- result.next;
    if (!punct_pair_at(source, tokens, assignment, past, 60u8, 45u8)) return; # '<-'
    val destination <- result.root;
    result.next <- assignment + 1u64;
    parse_expression_operand(source, tokens, nodes, result, past, 1u8);
    if (result.diagnostic != 0u8) return;
    val source_node <- result.root;
    append_node(nodes, result, transfer_node(), nodes[destination].first, nodes[source_node].past,
                0u64, destination, source_node, tokens[assignment].first);
}

func parse_expression_at(source:const SourceBytes in S, tokens:const Tokens in T,
                         nodes:ExprNodes in A, result:ParseResult in R,
                         past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_operand(source, tokens, nodes, result, past, minimum);
    if (result.diagnostic != 0u8 || minimum != 1u8) return;
    parse_result_annotation(source, tokens, nodes, result, past);
}

func parse_result_annotation(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    val colon <- result.next;
    if (punct_at(source, tokens, colon, past) != 58u8) return; # ':'
    val annotation <- colon + 1u64;
    result.next <- annotation;
    if (annotation >= past || tokens[annotation].kind != identifier()) {
        result.diagnostic <- expected_type();
        return;
    } else {};
    if (!void_word(source, tokens[annotation])) {
        result.diagnostic <- unsupported_typed_expression();
        return;
    } else {};
    val operand <- result.root;
    append_node(nodes, result, discard_node(), nodes[operand].first, tokens[annotation].past,
                0u64, operand, no_node(), tokens[colon].first);
    if (result.diagnostic == 0u8) { (result.next <- annotation + 1u64):void; } else {};
}

func parse_binary(source:const SourceBytes in S, tokens:const Tokens in T,
                  nodes:ExprNodes in A, result:ParseResult in R,
                  past:u64, minimum:u8) -> void
    where {const owner S, const owner T, owner A, owner R} {
    # Every accepted operator advances next. An error leaves next at the
    # failing token so the caller can recover or report its source span.
    for (unused in result.next .. past) {
        if (!parse_infix(source, tokens, nodes, result, past, minimum)) return;
    };
}

export func parse_next_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                                  nodes:ExprNodes in A, result:ParseResult in R, past:u64) -> void
    where {const owner S, const owner T, owner A, owner R} {
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

func parse_infix(source:const SourceBytes in S, tokens:const Tokens in T,
                 nodes:ExprNodes in A, result:ParseResult in R,
                 past:u64, minimum:u8) -> bool
    where {const owner S, const owner T, owner A, owner R} {
    if (punct_pair_at(source, tokens, result.next, past, 45u8, 62u8)) return false;
    val op <- punct_at(source, tokens, result.next, past);
    val predicate <- comparison(source, tokens, result.next, past);
    val kind <- compare_node();
    val binding <- 0u8;
    if (punct_pair_at(source, tokens, result.next, past, 124u8, 124u8)) {
        kind <- logical_or_node();
        (binding <- 1u8):void;
    } else {};
    if (punct_pair_at(source, tokens, result.next, past, 38u8, 38u8)) {
        kind <- logical_and_node();
        (binding <- 2u8):void;
    } else {};
    if (op == 42u8) { kind <- multiply_node(); (binding <- 6u8):void; } else {};
    if (op == 47u8) { kind <- divide_node(); (binding <- 6u8):void; } else {};
    if (op == 37u8) { kind <- remainder_node(); (binding <- 6u8):void; } else {};
    if (op == 43u8) { kind <- add_node(); (binding <- 5u8):void; } else {};
    if (op == 45u8) { kind <- subtract_node(); (binding <- 5u8):void; } else {};
    if (predicate != no_node()) {
        binding <- if (predicate <= unequal_words()) { 3u8 } else { 4u8 };
        {};
    } else {};
    if (binding < minimum) return false;
    val operation_at <- tokens[result.next].first;
    val left <- result.root;
    result.next <- result.next + 1u64;
    parse_expression_at(source, tokens, nodes, result, past, binding + 1u8);
    if (result.diagnostic != 0u8) return false;
    val right <- result.root;
    val number <- if (kind == compare_node()) { predicate } else { 0u64 };
    append_node(nodes, result, kind, nodes[left].first, nodes[right].past, number, left, right, operation_at);
    return result.diagnostic == 0u8;
}

export func reset_parse_result(first:u64, result:ParseResult in R) -> void where {owner R} {
    result.next <- first;
    result.used <- 0u64;
    result.root <- 0u64;
    result.diagnostic <- 0u8;
    result.supplied_here <- false;
    return;
}

# Tokens come from the indexed lexer over source. The caller supplies
# initialized node storage and receives a root index or a diagnostic at next.
export func parse_expression(source:const SourceBytes in S, tokens:const Tokens in T,
                             nodes:ExprNodes in A, first:u64, past:u64,
                             result:ParseResult in R) -> void
    where {const owner S, const owner T, owner A, owner R} {
    reset_parse_result(first, result);
    if (first > past || past > len(tokens)) {
        result.diagnostic <- expected_operand();
        return;
    } else {};
    parse_expression_at(source, tokens, nodes, result, past, 1u8);
}

export Tokens;
export ExprNode;
export ExprNodes;
