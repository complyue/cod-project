using "./SourceStorage.cod" SourceBytes;
using "./ParserStorage.cod" { Tokens, ExprNodes, no_node };
using "./ModuleExports.cod" { ModuleExports, SelectedExports };
using "./ModuleExportStorage.cod" {
    ModuleInterfaces, ModuleInterfaceRow, ByteArrayFailures,
    FamilyMembership { UnprovedMembership }, InterfaceCallableKind { NoCallableKind },
    AggregateStorage { UnprovedAggregate }, ExceptionSchema { OrdinarySchema },
    ByteFunctionCompletion { NoByteFunction }, SumInterfacePayload { NoSumInterface },
    CallableObjectView { NoCallableObjectView },
};
using "./ParserStorage.cod" FormalMode { ValueFormal };
using "./NameResolution.cod" { NameBindings, NameWork };
using "./OperandChecking.cod" { OperandFacts, CallOwners };
using "./CompletionChecking.cod" CompletionSites;
using "./ModuleFrontend.cod" {
    ModuleBindingResult, analyze_bound_operands, analyze_bound_completion, bind_module, binding_diagnostic,
    module_completion_failed,
};
using "./NativeCommands.cod" { NativeCommands, NativePlan };
using "./ModuleLowering.cod" lower_native_module;
using "./InitializationChecking.cod" check_native_initialization;
using "./InitializationReadiness.cod" InitializationResult;

# The mapped revision and all working buffers remain live through lowering.
# Only successful completion publishes commands for native construction.
export func compile_module_commands(source:const SourceBytes in S, tokens:Tokens in T, nodes:ExprNodes in N,
                                    spellings:const SourceBytes in B, exports:const ModuleExports in E,
                                    selected:SelectedExports in X, bindings:NameBindings in Y,
                                    work:NameWork in W, facts:OperandFacts in F, owners:CallOwners in O,
                                    sites:CompletionSites in K, commands:NativeCommands in C,
                                    plan:NativePlan in P, report:ModuleBindingResult in R) -> bool
    where {const owner S, owner T, owner N, const owner B, const owner E, owner X, owner Y, owner W,
           owner F, owner O, owner K, owner C, owner P, owner R} {
    if (!bind_module(source, tokens, nodes, spellings, exports, selected, bindings, work, report)) return false;
    ref interfaces = make ModuleInterfaces(0u64, make ModuleInterfaceRow {
        defining_module <- 0u64; declaration <- 0u64; entry_count <- 0u64; owner_count <- 0u64;
        interface_kind <- 0u8; result_kind <- 0u8; element_kind <- 0u8; value_kind <- 0u8;
        type_module <- 0u64; type_identity <- 0u64; owner_role <- no_node();
        target_readonly <- 0u8; owner_readonly <- 0u8; has_here <- 0u8; failure_checked <- 0u8;
        failure_module <- 0u64; failure_identity <- 0u64; name_first <- 0u64; name_past <- 0u64;
        enum_code <- 0u64; native_function <- no_node(); callable_kind <- NoCallableKind;
        native_reception <- 0u8;
        membership <- UnprovedMembership;
        native_passes_owner <- 0u8; sum_payload <- make NoSumInterface {};
        aggregate_storage <- UnprovedAggregate; exception_schema <- OrdinarySchema; field_mode <- ValueFormal;
        scalar_object_body <- false; byte_completion <- NoByteFunction; object_view <- make NoCallableObjectView {};
        array_slot_checked <- false; source_allocates <- false;
        array_slot_failures <- make ByteArrayFailures {
            bounds <- false; out_of_memory <- false; region_capacity <- false; invalid_capacity <- false
        }
    });
    return compile_bound_commands(source, nodes, selected, bindings, work, interfaces, 0u64, facts, owners, sites, commands,
                                  plan, report, 0u64, true);
}

export func compile_bound_commands(source:const SourceBytes in S, nodes:const ExprNodes in N,
                                   selected:const SelectedExports in X, bindings:const NameBindings in Y,
                                   work:const NameWork in W, interfaces:const ModuleInterfaces in I, interface_count:u64,
                                   facts:OperandFacts in F, owners:CallOwners in O,
                                   sites:CompletionSites in K, commands:NativeCommands in C,
                                   plan:NativePlan in P, report:ModuleBindingResult in R, base:u64, entry:bool) -> bool
    where {const owner S, const owner N, const owner X, const owner Y, const owner W,
           const owner I, owner F, owner O, owner K, owner C, owner P, owner R} {
    plan.used <- 0u64;
    plan.functions <- 0u64;
    plan.labels <- 0u64;
    plan.slots <- 0u64;
    plan.diagnostic <- 0u8;
    plan.node <- no_node();
    if (!analyze_bound_operands(source, nodes, selected, bindings, work, interfaces, interface_count, facts, owners, report) ||
        !analyze_bound_completion(nodes, bindings, work, facts, sites, report)) return false;
    if (!lower_native_module(nodes, report.frontend.tree, bindings, work, interfaces, facts, sites, commands, plan, base, entry)) return false;
    ref initialization = make InitializationResult { diagnostic <- 0u8; node <- no_node(); };
    if (!check_native_initialization(commands, plan, initialization)) {
        binding_diagnostic(nodes, report, module_completion_failed(), initialization.diagnostic, initialization.node);
        return false;
    } else {};
    return true;
}
