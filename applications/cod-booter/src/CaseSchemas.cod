export data ConstructorCaseFact =
    NoConstructorCase {} |
    IndexedCaseSubject {
        expression:UInt64; array_site:UInt64; index:UInt64; owner_site:UInt64; array_module:UInt64; array_type:UInt64; value_type:DeclaredType; count:UInt64;
    } |
    DirectCaseSubject { expression:UInt64; formal:UInt64; count:UInt64; } |
    ValueCaseSubject { expression:UInt64; value_type:DeclaredType; count:UInt64; } |
    FieldLoanCaseSubject { expression:UInt64; receiver:UInt64; count:UInt64; } |
    ReceiptCaseSubject { expression:UInt64; receipt:UInt64; arm:UInt64; count:UInt64; } |
    CaseSumFormal { definition:UInt64; owner_site:UInt64; readonly:bool; value_type:DeclaredType; } |
    InlineProductFormal { definition:UInt64; owner_site:UInt64; value_type:DeclaredType; readonly:bool; demand_on_use:bool; } |
    ArrayFieldRecordFormal {
        definition:UInt64; owner_site:UInt64; value_type:DeclaredType; readonly:bool;
        field:UInt64; array_module:UInt64; array_identity:UInt64; fixed:bool; target_readonly:bool;
    } |
    StoredArrayField {
        receiver:UInt64; record:DeclaredType; array_module:UInt64; array_identity:UInt64;
        fixed:bool; target_readonly:bool;
    } |
    IndexedOutputFormal { definition:UInt64; owner_site:UInt64; value_type:DeclaredType; } |
    IndexedFieldDestination {} |
    InlineProductField {
        receiver:UInt64; field:UInt64; ordinal:UInt64; record:DeclaredType; value_type:DeclaredType;
        readonly:bool; writable:bool;
    } |
    CaseConstructor { case_site:UInt64; defining_module:UInt64; declaration:UInt64; ordinal:UInt64; representative:UInt64; } |
    CaseFieldReceipt { case_site:UInt64; arm:UInt64; pattern:UInt64; field:UInt64; value_type:DeclaredType; } |
    CaseProductField { receiver:UInt64; field:UInt64; ordinal:UInt64; record:DeclaredType; value_type:DeclaredType; } |
    CaseSumReceipt { receipt:UInt64; arm:UInt64; value_type:DeclaredType; } |
    CaseSumProjection { receiver:UInt64; field:UInt64; receipt:UInt64; arm:UInt64; record:DeclaredType; value_type:DeclaredType; } |
    LocalSumConstruction { transfer:UInt64; sum:UInt64; arm:UInt64; fields:UInt64; } |
    SumValueResult { value_type:DeclaredType; } |
    IndexedAggregateLoan {
        consumer:UInt64; array:UInt64; index:UInt64; owner_site:UInt64; array_module:UInt64; array_type:UInt64;
        element:DeclaredType; index_binds_storage:bool; writable:bool;
    } |
    IndexedAggregateDestination {
        transfer:UInt64; array:UInt64; index:UInt64; owner_site:UInt64; array_module:UInt64; array_type:UInt64;
        element:DeclaredType; index_binds_storage:bool;
    } |
    LexicalSumReference { construction:UInt64; owner_site:UInt64; readonly:bool; } |
    LexicalProductReference { construction:UInt64; owner_site:UInt64; readonly:bool; } |
    LexicalBitsArray {
        owner_site:UInt64; array_module:UInt64; array_type:UInt64; element:DeclaredType; readonly:bool;
    } |
    LexicalSumRebind { destination:UInt64; construction:UInt64; owner_site:UInt64; } |
    FreshSumInvocation { definition:UInt64; } |
    ProductLoanInvocation { definition:UInt64; } |
    ImportedFreshSumInvocation {} |
    FreshSumArgument { invocation:UInt64; formal:UInt64; construction:UInt64; lexical_owner:UInt64; } |
    BitsConstruction {
        transfer:UInt64; value_type:DeclaredType; schema:UInt64; field_count:UInt64;
        first_initializer:UInt64; last_initializer:UInt64;
    } |
    BitsFieldInitializer {
        construction:UInt64; ordinal:UInt64; operand:UInt64; value_type:DeclaredType;
        readonly:bool; repeated:bool; binds_storage:bool;
    };
export array ConstructorCaseFacts[UInt64]:ConstructorCaseFact;

enum LexicalArrayAccess:UInt8 { NoLexicalArray; ReadonlyLexicalArray; WritableLexicalArray; }

data IndexedCaseLoan {
    expression:UInt64;
    array:UInt64;
    index:UInt64;
    owner_site:UInt64;
    array_module:UInt64;
    array_type:UInt64;
}

func describe_case_array_element(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, array_declaration:UInt64, used:UInt64, revision:UInt64, expected_kind:UInt8,
    element:DeclaredType in T) -> bool where {const owner N, const owner B, const owner E, owner T} {
    ref array_shape = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    return inspect_declaration(nodes, revision, used, array_declaration, array_shape) == ArrayTypeDeclaration &&
        names[array_shape.index_type].kind == builtin_u64() &&
        describe_type(nodes, names, selected, array_shape.value_type, 0u64, revision, used, element) &&
        element.kind == expected_kind
}

func find_indexed_case_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    expression:UInt64, used:UInt64, revision:UInt64, loan:IndexedCaseLoan in L) -> bool
    where {const owner N, const owner B, owner L} {
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    if (!inspect_index_selection(nodes, revision, used, expression, indexed) ||
        names[indexed.target].kind != formal_binding()) return false;
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    if (inspect_formal(nodes, revision, used, names[indexed.target].declaration, formal) != OrdinaryFormal ||
        formal.mode != ReferenceFormal ||
        inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding ||
        binding.owner_name >= used || names[binding.owner_name].kind != owner_binding()) return false;
    val owner_site <- names[binding.owner_name].declaration;
    val marker <- binding.target_type;
    if (owner_site >= used || marker >= used ||
        owner_constraint_syntax(nodes, owner_site) == NotOwnerConstraint)
        return false;
    loan.expression <- expression;
    loan.array <- indexed.target;
    loan.index <- indexed.index;
    loan.owner_site <- owner_site;
    loan.array_type <- marker;
    return true
}

func describe_published_array_element(names:const NameBindings in B, selected:const SelectedExports in E,
    interfaces:const ModuleInterfaces in G, published:UInt64, marker:UInt64, expected_kind:UInt8, element:DeclaredType in T) -> bool
    where {const owner B, const owner E, const owner G, owner T} {
    val selection <- names[marker].declaration;
    if (names[marker].kind != ordinary_selection() || selection >= intrinsic (len)(selected) ||
        selected[selection].kind != array_export()) return false;
    val head <- find_interface(interfaces, published, selected[selection].origin_module, selected[selection].identity);
    if (head == no_node() || interfaces[head].interface_kind != array_type() ||
        interfaces[head].array_index_kind != builtin_u64() || interfaces[head].element_kind != expected_kind)
        return false;
    element.kind <- expected_kind;
    element.defining_module <- interfaces[head].type_module;
    element.identity <- interfaces[head].type_identity;
    return true
}

func describe_indexed_case_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in G, published:UInt64,
    expression:UInt64, used:UInt64, revision:UInt64, expected_kind:UInt8,
    loan:IndexedCaseLoan in L, element:DeclaredType in L) -> bool
    where {const owner N, const owner B, const owner E, const owner G, owner L} {
    ref candidate = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    if (!find_indexed_case_formal(nodes, names, expression, used, revision, candidate)) return false;
    val marker <- candidate.array_type;
    val described <- if (names[marker].kind == array_type()) {
        describe_case_array_element(nodes, names, selected, names[marker].declaration, used, revision,
            expected_kind, element)
    } else { describe_published_array_element(names, selected, interfaces, published, marker, expected_kind, element) };
    if (!described) return false;
    loan.expression <- candidate.expression;
    loan.array <- candidate.array;
    loan.index <- candidate.index;
    loan.owner_site <- candidate.owner_site;
    loan.array_module <- type_module(names, selected, marker, 0u64);
    loan.array_type <- type_identity(names, selected, marker);
    return true
}

func remember_indexed_aggregate_loan(nodes:const ExprNodes in N, facts:ConstructorCaseFacts in F,
    consumer:UInt64, loan:const IndexedCaseLoan in L, element:const DeclaredType in E, writable:bool) -> void
    where {const owner N, owner F, const owner L, const owner E} {
    if (loan.expression == no_node()) return;
    facts[loan.expression] <- make IndexedAggregateLoan {
        consumer <- consumer; array <- loan.array; index <- loan.index; owner_site <- loan.owner_site;
        array_module <- loan.array_module; array_type <- loan.array_type; element <- element;
        index_binds_storage <- binds_local_storage(nodes, loan.index); writable <- writable;
    };
    return
}

func case_bits_type(type:const DeclaredType in T, aggregate:const AggregateFacts in F,
    interfaces:const ModuleInterfaces in I, published:UInt64) -> bool
    where {const owner T, const owner F, const owner I} {
    val kind <- type.kind;
    if (kind != record_type() && kind != sum_type()) return false;
    val storage <- if (type.defining_module == 0u64) {
        if (type.identity >= intrinsic (len)(aggregate)) return false;
        (aggregate[type.identity])
    } else {
        checked_aggregate_storage(interfaces, published, type.defining_module, type.identity, kind)
    };
    return storage == (CoDBitsAggregate:AggregateStorage) || storage == (CLayoutBitsRecord:AggregateStorage)
}

# The caller has already selected a completed aggregate loan formal.
# The actual indexed place still comes from the caller's array and owner.
export func prepare_imported_indexed_loan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, published:UInt64,
    aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, argument:UInt64,
    used:UInt64, revision:UInt64, kind:UInt8, writable:bool) -> void
    where {const owner N, const owner B, const owner E, const owner I, const owner A, owner F} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence ||
        entry.item >= intrinsic (len)(facts)) return;
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    ref element = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if ((describe_indexed_case_loan(nodes, names, selected, interfaces, published, entry.item, used, revision,
         kind, loan, element) ||
         describe_lexical_bits_element(nodes, names, facts, entry.item, used, revision, kind, loan, element) !=
         (NoLexicalArray:LexicalArrayAccess)) && case_bits_type(element, aggregate, interfaces, published)) {
        remember_indexed_aggregate_loan(nodes, facts, argument, loan, element, writable)
    };
    return
}

func remember_sum_formal(facts:ConstructorCaseFacts in F, formal:UInt64, definition:UInt64,
    owner_site:UInt64, readonly:bool, type:const DeclaredType in T) -> void
    where {owner F, const owner T} {
    facts[formal] <- make CaseSumFormal {
        definition <- definition; owner_site <- owner_site; readonly <- readonly; value_type <- type
    };
    return
}

func remember_inline_product_formal(facts:ConstructorCaseFacts in F, formal:UInt64,
    definition:UInt64, owner_site:UInt64, readonly:bool, demand_on_use:bool, type:const DeclaredType in T) -> void
    where {owner F, const owner T} {
    facts[formal] <- make InlineProductFormal {
        definition <- definition; owner_site <- owner_site; value_type <- type; readonly <- readonly;
        demand_on_use <- demand_on_use
    };
    return
}

# This profile admits a product whose only field is a non-null named byte-array reference.
# The record owns the field slot; the array loan uses the record's substituted owner.
export func published_array_field_record(interfaces:const ModuleInterfaces in I, published:UInt64,
    module:UInt64, declaration:UInt64) -> bool where {const owner I} {
    val record <- find_interface(interfaces, published, module, declaration);
    if (record == no_node() || interfaces[record].interface_kind != record_type() ||
        interfaces[record].aggregate_storage != NonBitsAggregate || interfaces[record].entry_count != 1u64)
        return false;
    val field <- record + 1u64;
    if (interfaces[field].field_mode != ReferenceFormal || interfaces[field].value_kind != array_type() ||
        interfaces[field].target_readonly > 1u8) return false;
    val array <- find_interface(interfaces, published, interfaces[field].type_module, interfaces[field].type_identity);
    return array != no_node() && interfaces[array].interface_kind == array_type() &&
        interfaces[array].entry_count == 0u64 && interfaces[array].array_index_kind == builtin_u64() &&
        interfaces[array].element_kind == builtin_u8()
}

func remember_array_field_record_formal(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in I, published:UInt64,
    aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, formal:UInt64, definition:UInt64,
    owner_site:UInt64, readonly:bool, type:const DeclaredType in T, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner E, const owner I, const owner A, owner F, const owner T} {
    if (type.kind != record_type() || owner_constraint_syntax(nodes, owner_site) == NotOwnerConstraint) return false;
    if (type.defining_module != 0u64) {
        if (!published_array_field_record(interfaces, published, type.defining_module, type.identity)) return false;
        facts[formal] <- make ArrayFieldRecordFormal {
            definition <- definition; owner_site <- owner_site; value_type <- type; readonly <- readonly;
            field <- no_node(); array_module <- 0u64; array_identity <- no_node();
            fixed <- true; target_readonly <- true
        };
        return true
    };
    if (type.identity >= used || aggregate[type.identity] != NonBitsAggregate) return false;
    ref record = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    ref field = make UInt64 { no_node() };
    ref syntax = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    ref array = make ArraySlotType {
        owner_site <- no_node(); type_module <- 0u64; type_identity <- no_node(); element_module <- 0u64; element_identity <- no_node()
    };
    if (inspect_declaration(nodes, revision, used, type.identity, record) != NominalRecord ||
        !first_sequence_entry(nodes, revision, used, record.entries, FormalSequence, field) ||
        field != record.entries || inspect_formal(nodes, revision, used, field, syntax) != OrdinaryFormal ||
        syntax.mode != ReferenceFormal || inspect_binding(nodes, revision, used, syntax.binding, binding) != TypedBinding ||
        binding.owner_name != no_node() ||
        !describe_byte_array(nodes, names, selected, interfaces, published, binding.target_type, used, revision, array))
        return false;
    facts[formal] <- make ArrayFieldRecordFormal {
        definition <- definition; owner_site <- owner_site; value_type <- type; readonly <- readonly;
        field <- field; array_module <- array.type_module; array_identity <- array.type_identity;
        fixed <- formal_binding_is_fixed(nodes, revision, used, field); target_readonly <- binding.readonly
    };
    return true
}

func prepare_case_loan_formals(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in G, published:UInt64,
    aggregate:const AggregateFacts in A, work:NameWork in W, facts:ConstructorCaseFacts in F,
    writable_product:bool, definition:UInt64, signature:UInt64, used:UInt64, revision:UInt64,
    first:UInt64 in P) -> void
    where {const owner N, const owner B, const owner E, const owner G, const owner A, owner W, owner F, owner P} {
    ref head = make UInt64 { no_node() };
    ref sites = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node();
        parameter_tail <- no_node(); readonly <- false
    };
    ref formal = make UInt64 { no_node() };
    if (!find_signature_clause(nodes, revision, used, signature, SignatureHead, head) ||
        inspect_signature(nodes, revision, used, head, sites) != SignatureHead ||
        !first_sequence_entry(nodes, revision, used, sites.parameter_tail, FormalSequence, formal))
        return;
    ref parameter = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    val owner_site <- no_node();
    val required <- ReadonlyOwnerConstraint;
    val storage <- CLayoutBitsRecord;
    for (unused in 0u64 .. used) {
        if (formal >= used) return;
        if (inspect_formal(nodes, revision, used, formal, parameter) == OrdinaryFormal &&
            parameter.mode == ReferenceFormal &&
            inspect_binding(nodes, revision, used, parameter.binding, binding) == TypedBinding &&
            binding.name < used && binding.owner_name < used &&
            names[binding.name].kind == formal_binding() &&
            names[binding.name].declaration == formal && names[binding.owner_name].kind == owner_binding() &&
            describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, type)) {
            owner_site <- names[binding.owner_name].declaration;
            if (owner_site < used && remember_array_field_record_formal(nodes, names, selected, interfaces,
                published, aggregate, facts, formal, definition, owner_site, binding.readonly, type, used, revision)) {
                if (first == no_node()) { (first <- formal):void }
            } else {};
            if (owner_site < used && case_bits_type(type, aggregate, interfaces, published)) {
                if (type.kind == sum_type()) {
                    remember_sum_formal(facts, formal, definition, owner_site, binding.readonly, type);
                    (work[definition].sum_loan_formals <- true):void
                } else {
                    required <- if (binding.readonly) { ReadonlyOwnerConstraint } else { WritableOwnerConstraint };
                    if (type.kind == record_type() && owner_constraint_syntax(nodes, owner_site) == required) {
                        if (binding.readonly || writable_product) {
                            remember_inline_product_formal(facts, formal, definition, owner_site, binding.readonly,
                                writable_product, type)
                        } else {
                            storage <- if (type.defining_module == 0u64) { (aggregate[type.identity]) } else {
                                checked_aggregate_storage(interfaces, published,
                                    type.defining_module, type.identity, record_type())
                            };
                            if (storage == CoDBitsAggregate || type.defining_module != 0u64) {
                                remember_inline_product_formal(facts, formal, definition, owner_site, false, false, type);
                                if (storage == CLayoutBitsRecord && first == no_node()) { (first <- formal):void }
                            } else {
                                # Keep a local record signature available for a reached indexed destination.
                                facts[formal] <- make IndexedOutputFormal {
                                    definition <- definition; owner_site <- owner_site; value_type <- type
                                }
                            }
                        }
                    }
                }
            }
        };
        (formal <- work[formal].next):void
    }
}

func sum_case_extent(nodes:const ExprNodes in N, work:const NameWork in W,
    interfaces:const ModuleInterfaces in G, published:UInt64, sum:const DeclaredType in T,
    used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner W, const owner G, const owner T} {
    if (sum.defining_module != 0u64) {
        val head <- find_interface(interfaces, published, sum.defining_module, sum.identity);
        if (head == no_node() || interfaces[head].interface_kind != sum_type()) return 0u64;
        # The completed storage proof checked all of this header's constructor links.
        return (interfaces[head].entry_count)
    };
    ref shape = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false
    };
    ref arm = make UInt64 { no_node() };
    if (inspect_declaration(nodes, revision, used, sum.identity, shape) != NominalSum ||
        !first_sequence_entry(nodes, revision, used, shape.entries, SumSequence, arm)) return 0u64;
    ref sites = make SumArmSites { previous <- no_node(); name <- no_node(); fields <- no_node() };
    for (index in 0u64 .. used) {
        if (!inspect_sum_arm(nodes, revision, used, arm, sites)) return 0u64;
        if (arm == shape.entries) return index + 1u64;
        (arm <- work[arm].next):void
    };
    return 0u64
}

func published_case_constructor(selected:const SelectedExports in E,
    interfaces:const ModuleInterfaces in I, published:UInt64, sum:const DeclaredType in T,
    spelling:UInt64, count:UInt64 in C, ordinal:UInt64 in C) -> UInt64
    where {const owner E, const owner I, const owner T, owner C} {
    if (spelling >= intrinsic (len)(selected)) return no_node();
    val site <- selected[spelling].constructor_selection;
    if (site >= intrinsic (len)(selected)) return no_node();
    val head <- find_interface(interfaces, published, sum.defining_module, sum.identity);
    if (head == no_node() || selected[site].sum_head != head) return no_node();
    val chosen <- selected[spelling].constructor_row;
    if (chosen >= published) return no_node();
    for (entry in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (checked_sum_constructor(interfaces, published, head, entry) == chosen) {
            count <- interfaces[head].entry_count;
            ordinal <- entry - head - 1u64;
            return chosen
        }
    };
    return no_node()
}

func local_case_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    constructor:UInt64, selector:UInt64, used:UInt64, revision:UInt64, type:DeclaredType in T) -> UInt64
    where {const owner S, const owner N, const owner B, const owner E, const owner W, owner T} {
    ref arm = make SumArmSites { previous <- no_node(); name <- no_node(); fields <- no_node() };
    if (!inspect_sum_arm(nodes, revision, used, constructor, arm)) return no_node();
    val field <- find_named_field(source, nodes, work, arm.fields, selector, revision, used);
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
        (formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
        inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding ||
        !describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, type))
        return no_node();
    return field
}

func published_named_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, head:UInt64, selector:UInt64, used:UInt64)
    -> UInt64 where {const owner S, const owner N, const owner G} {
    if (published > intrinsic (len)(interfaces) || head >= published ||
        interfaces[head].entry_count >= published - head ||
        spelling_used > intrinsic (len)(spellings)) return no_node();
    val first <- syntax_first(nodes, used, selector);
    val past <- syntax_past(nodes, used, selector);
    if (first >= past || past > intrinsic (len)(source)) return no_node();
    for (field in head + 1u64 .. head + 1u64 + interfaces[head].entry_count) {
        if (interfaces[field].name_first >= interfaces[field].name_past ||
            interfaces[field].name_past > spelling_used) return no_node();
        if (same_bytes(source, first, past, spellings, interfaces[field].name_first, interfaces[field].name_past))
            return field
    };
    return no_node()
}

func read_published_sum_field(interfaces:const ModuleInterfaces in G, field:UInt64,
    type:DeclaredType in T, readonly:bool in R) -> bool where {const owner G, owner T, owner R} {
    return case interfaces[field].sum_payload of {
        ConstructorField {
            val kind <- field_kind; val module <- field_module; val identity <- field_identity;
            val mode <- mode; val fixed <- readonly;
        } -> {
            if (kind == 0u8 || (mode != ValueFormal && mode != ExplicitValueFormal)) return false;
            type.kind <- kind;
            type.defining_module <- module;
            type.identity <- identity;
            readonly <- fixed;
            true
        };
        _ -> false
    }
}

func published_case_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, constructor:UInt64, selector:UInt64, used:UInt64, type:DeclaredType in T)
    -> UInt64 where {const owner S, const owner N, const owner G, owner T} {
    val field <- published_named_field(source, nodes, spellings, spelling_used, interfaces, published,
        constructor, selector, used);
    if (field == no_node() || interfaces[constructor].interface_kind != constructor_type()) return no_node();
    ref readonly = make bool { false };
    return if (read_published_sum_field(interfaces, field, type, readonly)) { field } else { no_node() }
}

func case_problem(report:DeclaredExpressionResult in R, node:UInt64, diagnostic:UInt8)
    -> bool where {owner R} {
    report.node <- node;
    report.diagnostic <- diagnostic;
    return false
}

func unproved_sum_subject() -> UInt8 { return 139u8 }
func unselected_case_constructor() -> UInt8 { return 140u8 }
func unproved_case_field() -> UInt8 { return 141u8 }

func remember_case_subject(facts:ConstructorCaseFacts in F, at:UInt64,
    loan:const IndexedCaseLoan in R, type:const DeclaredType in R, count:UInt64)
    -> void where {owner F, const owner R} {
    facts[at] <- make IndexedCaseSubject {
        expression <- loan.expression; array_site <- loan.array; index <- loan.index;
        owner_site <- loan.owner_site; array_module <- loan.array_module; array_type <- loan.array_type;
        value_type <- type; count <- count
    };
    facts[loan.expression] <- make IndexedCaseSubject {
        expression <- loan.expression; array_site <- loan.array; index <- loan.index;
        owner_site <- loan.owner_site; array_module <- loan.array_module; array_type <- loan.array_type;
        value_type <- type; count <- count
    };
    return
}

func remember_case_constructor(facts:ConstructorCaseFacts in F, pattern:UInt64, choice:UInt64,
    first:UInt64, module:UInt64, definition:UInt64, ordinal:UInt64)
    -> void where {owner F} {
    val representative <- pattern;
    for (prior in first .. pattern) {
        case facts[prior] of {
            CaseConstructor {
                val case_site <- case_site; val origin <- defining_module;
                val identity <- declaration; val tag <- ordinal; val site <- representative;
            } -> {
                if (case_site == choice && origin == module && identity == definition && tag == ordinal) {
                    representative <- site;
                    break
                }
            };
            _ -> {}
        }
    };
    facts[pattern] <- make CaseConstructor {
        case_site <- choice; defining_module <- module; declaration <- definition; ordinal <- ordinal;
        representative <- representative
    };
    return
}

func remember_case_field(facts:ConstructorCaseFacts in F, receipt:UInt64, choice:UInt64, arm:UInt64, pattern:UInt64,
    field:UInt64, type:const DeclaredType in T)
    -> void where {owner F, const owner T} {
    facts[receipt] <- make CaseFieldReceipt {
        case_site <- choice; arm <- arm; pattern <- pattern; field <- field; value_type <- type
    };
    return
}

func prepare_case_fields(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    choice:UInt64, arm:UInt64, pattern:UInt64, tail:UInt64, module:UInt64, constructor:UInt64, used:UInt64, revision:UInt64,
    report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W,
           const owner G, const owner A, owner F, owner R} {
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, CaseReceiverSequence, item))
        return case_problem(report, pattern, 94u8);
    ref receive = make CaseReceiverSites {
        previous <- no_node(); destination <- no_node(); selected_field <- no_node(); transfer_at <- 0u64
    };
    ref received = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    val selector <- no_node();
    val field <- no_node();
    for (unused in 0u64 .. used) {
        if (item == no_node()) return true;
        if (!inspect_case_value_receiver(nodes, revision, used, item, receive) ||
            work[item].enclosing_case_arm != arm)
            return case_problem(report, item, 94u8);
        selector <- if (receive.selected_field == no_node()) { (receive.destination) }
                    else { (receive.selected_field) };
        field <- if (module == 0u64) {
            local_case_field(source, nodes, names, selected, work, constructor, selector,
                used, revision, received)
        } else {
            published_case_field(source, nodes, spellings, spelling_used, interfaces, published,
                constructor, selector, used, received)
        };
        if (field == no_node()) return case_problem(report, selector, unproved_case_field());
        if (!native_scalar(received.kind) && received.kind != enum_type() &&
            !case_bits_type(received, aggregate, interfaces, published))
            return case_problem(report, selector, 94u8);
        remember_case_field(facts, item, choice, arm, pattern, field, received);
        if (item == tail) return true;
        (item <- work[item].next):void
    };
    return case_problem(report, pattern, 94u8)
}

func prepare_case_arms(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    choice:UInt64, subject:UInt64, tail:UInt64, sum:const DeclaredType in T, used:UInt64, revision:UInt64, count:UInt64 in C,
    report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, const owner W,
           const owner G, const owner A, owner F, const owner T, owner C, owner R} {
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item))
        return case_problem(report, choice, 94u8);
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    ref pattern = make ConstructorCaseSites { constructor <- no_node(); receiver_tail <- no_node() };
    ref ordinal = make UInt64 { no_node() };
    ref extent = make UInt64 { 0u64 };
    val spelling <- no_node();
    val receipts <- no_node();
    val selected_constructor <- no_node();
    val definition <- no_node();
    val mode <- AnyCaseTarget;
    val module <- sum.defining_module;
    for (unused in 0u64 .. used) {
        if (item == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence)
            return case_problem(report, choice, 94u8);
        if (inspect_case_arm(nodes, revision, used, entry.item, arm)) {
            mode <- case_pattern(nodes, used, arm.pattern);
            if (mode != AnyCaseTarget) {
                spelling <- arm.pattern;
                receipts <- no_node();
                if (mode == ConstructorCaseTarget) {
                    if (!inspect_constructor_case(nodes, revision, used, arm.pattern, pattern))
                        return case_problem(report, arm.pattern, 94u8);
                    spelling <- pattern.constructor;
                    (receipts <- pattern.receiver_tail):void
                } else {
                    if (mode != NamedCaseMember) return case_problem(report, arm.pattern, 94u8);
                };
                selected_constructor <- if (module == 0u64) {
                    local_sum_constructor(nodes, names, work, sum.identity, spelling, used, revision,
                                           extent, ordinal)
                } else {
                    published_case_constructor(selected, interfaces, published, sum, spelling, extent,
                                               ordinal)
                };
                if (selected_constructor == no_node() || ordinal >= extent ||
                    (count != 0u64 && count != extent))
                    return case_problem(report, spelling, unselected_case_constructor());
                count <- extent;
                definition <- if (module == 0u64) { selected_constructor }
                              else { (interfaces[selected_constructor].declaration) };
                remember_case_constructor(facts, arm.pattern, choice, subject + 1u64,
                    module, definition, ordinal);
                if (!prepare_case_fields(source, nodes, names, selected, work, spellings, spelling_used,
                    interfaces, published, aggregate, facts, choice, entry.item, arm.pattern, receipts, module,
                    selected_constructor, used, revision, report)) return false
            }
        };
        (item <- work[item].next):void
    };
    return case_problem(report, choice, 94u8)
}

func prepare_direct_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, choice:const CaseSites in C, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, const owner C, owner R} {
    val subject <- choice.subject;
    if (name_syntax(nodes, used, subject) != OrdinaryName ||
        names[subject].kind != formal_binding()) return true;
    val formal <- names[subject].declaration;
    if (formal >= subject) return case_problem(report, subject, unproved_sum_subject());
    ref count = make UInt64 { 0u64 };
    return case facts[formal] of {
        CaseSumFormal { val readonly <- readonly; val sum <- value_type; } -> {
            if (!readonly) return true;
            count <- sum_case_extent(nodes, work, interfaces, published, sum, used, revision);
            if (count == 0u64) return case_problem(report, subject, unproved_sum_subject());
            if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
                interfaces, published, aggregate, facts, at, subject, choice.items, sum, used,
                revision, count, report)) return false;
            facts[at] <- make DirectCaseSubject { expression <- subject; formal <- formal; count <- count };
            work[at].case_schema_prepared <- true;
            true
        };
        _ -> true
    }
}

func has_case_head(nodes:const ExprNodes in N, work:const NameWork in W, tail:UInt64, used:UInt64,
    revision:UInt64, receptions_only:bool) -> bool where {const owner N, const owner W} {
    ref item = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, tail, BlockSequence, item)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    val mode <- AnyCaseTarget;
    for (unused in 0u64 .. used) {
        if (item == no_node() ||
            inspect_sequence_entry(nodes, revision, used, item, entry) != BlockSequence) return false;
        if (inspect_case_arm(nodes, revision, used, entry.item, arm)) {
            mode <- case_pattern(nodes, used, arm.pattern);
            if (mode == ConstructorCaseTarget || (!receptions_only && mode == NamedCaseMember)) return true
        };
        (item <- work[item].next):void
    };
    return false
}

func reaches_receipt_arm(nodes:const ExprNodes in N, work:const NameWork in W,
    at:UInt64, required:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner W} {
    val parent <- work[at].enclosing_case_arm;
    val child <- at;
    val container <- no_node();
    ref arm = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    for (unused in 0u64 .. used) {
        if (parent >= used || parent <= child ||
            !inspect_case_arm(nodes, revision, used, parent, arm)) return false;
        container <- if (child <= arm.guard && arm.guard != no_node()) { arm.guard } else { arm.body };
        if (child > container ||
            syntax_first(nodes, used, child) < syntax_first(nodes, used, container) ||
            syntax_past(nodes, used, child) > syntax_past(nodes, used, container)) return false;
        if (parent == required) return true;
        child <- parent;
        (parent <- work[parent].enclosing_case_arm):void
    };
    return false
}

func owning_case_contains_arm(nodes:const ExprNodes in N, work:const NameWork in W,
    outer:UInt64, arm:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner W} {
    if (arm >= outer || outer >= used) return false;
    ref shape = make CaseSites { subject <- no_node(); items <- no_node() };
    ref child = make UInt64 { no_node() };
    if (!inspect_case(nodes, revision, used, outer, shape) ||
        !first_sequence_entry(nodes, revision, used, shape.items, BlockSequence, child)) return false;
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    for (unused in 0u64 .. used) {
        if (child >= outer || inspect_sequence_entry(nodes, revision, used, child, entry) != BlockSequence)
            return false;
        if (entry.item == arm) return true;
        if (child == shape.items || work[child].next <= child) return false;
        (child <- work[child].next):void
    };
    return false
}

func enclosing_receipt_case(nodes:const ExprNodes in N, work:const NameWork in W,
    at:UInt64, arm:UInt64, used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner W} {
    if (arm >= used || !reaches_receipt_arm(nodes, work, at, arm, used, revision)) return no_node();
    val outer <- work[arm].arm_case;
    if (outer <= at || !owning_case_contains_arm(nodes, work, outer, arm, used, revision)) return no_node();
    return outer
}

func prepare_received_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, choice:const CaseSites in C, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, const owner C, owner R} {
    val subject <- choice.subject;
    if (name_syntax(nodes, used, subject) != OrdinaryName || names[subject].kind != local_binding()) return true;
    val receipt <- names[subject].declaration;
    if (receipt >= subject) return case_problem(report, subject, unproved_sum_subject());
    val arm <- work[receipt].enclosing_case_arm;
    if (arm == no_node()) return true;
    ref receiver = make CaseReceiverSites {
        previous <- no_node(); destination <- no_node(); selected_field <- no_node(); transfer_at <- 0u64
    };
    if (!inspect_case_value_receiver(nodes, revision, used, receipt, receiver))
        return case_problem(report, subject, unproved_sum_subject());
    val outer <- enclosing_receipt_case(nodes, work, at, arm, used, revision);
    if (outer == no_node()) return case_problem(report, subject, unproved_sum_subject());
    if (!prepare_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, outer, used, revision, report)) return false;

    ref origin = make CaseArmSites { pattern <- no_node(); guard <- no_node(); body <- no_node(); arrow <- 0u64 };
    if (!inspect_case_arm(nodes, revision, used, arm, origin))
        return case_problem(report, subject, unproved_sum_subject());
    ref count = make UInt64 { 0u64 };
    return case facts[receipt] of {
        CaseFieldReceipt {
            val producer <- case_site; val selected_arm <- arm; val pattern <- pattern; val sum <- value_type;
        } -> {
            if (producer != outer || selected_arm != arm || pattern != origin.pattern)
                return case_problem(report, subject, unproved_sum_subject());
            if (sum.kind != sum_type()) return true;
            if (!case_bits_type(sum, aggregate, interfaces, published))
                return case_problem(report, subject, unproved_sum_subject());
            count <- sum_case_extent(nodes, work, interfaces, published, sum, used, revision);
            if (count == 0u64) return case_problem(report, subject, unproved_sum_subject());
            if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
                interfaces, published, aggregate, facts, at, subject, choice.items, sum, used,
                revision, count, report)) return false;
            facts[subject] <- make CaseSumReceipt { receipt <- receipt; arm <- arm; value_type <- sum };
            facts[at] <- make ReceiptCaseSubject { expression <- subject; receipt <- receipt; arm <- arm; count <- count };
            work[at].case_schema_prepared <- true;
            true
        };
        _ -> case_problem(report, subject, unproved_sum_subject())
    }
}

func prepare_projected_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, choice:const CaseSites in C, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, const owner C, owner R} {
    val subject <- choice.subject;
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    if (!inspect_field_selection(nodes, revision, used, subject, projection) ||
        name_syntax(nodes, used, projection.receiver) != OrdinaryName ||
        names[projection.receiver].kind != local_binding()) return true;
    val receipt <- names[projection.receiver].declaration;
    if (receipt >= projection.receiver) return case_problem(report, subject, unproved_sum_subject());
    val arm <- work[receipt].enclosing_case_arm;
    if (arm == no_node()) return true;
    val outer <- enclosing_receipt_case(nodes, work, at, arm, used, revision);
    if (outer == no_node()) return case_problem(report, subject, unproved_sum_subject());
    if (!prepare_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, outer, used, revision, report)) return false;
    ref record = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    ref sum = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    case facts[receipt] of {
        CaseFieldReceipt {
            val producer <- case_site; val selected_arm <- arm; val value <- value_type;
        } -> {
            if (producer != outer || selected_arm != arm || value.kind != record_type())
                return case_problem(report, subject, unproved_sum_subject());
            record.kind <- value.kind;
            record.defining_module <- value.defining_module;
            record.identity <- value.identity;
            sum.kind <- value.kind;
            sum.defining_module <- value.defining_module;
            (sum.identity <- value.identity):void
        };
        _ -> { return case_problem(report, subject, unproved_sum_subject()) }
    };
    if (!case_bits_type(record, aggregate, interfaces, published) ||
        !describe_record_field(source, nodes, names, selected, work, spellings, spelling_used, interfaces,
            published, projection.field, used, revision, sum))
        return case_problem(report, projection.field, unproved_case_field());
    if (sum.kind != sum_type()) return true;
    if (!case_bits_type(sum, aggregate, interfaces, published))
        return case_problem(report, projection.field, unproved_case_field());
    ref count = make UInt64 { sum_case_extent(nodes, work, interfaces, published, sum, used, revision) };
    if (count == 0u64) return case_problem(report, subject, unproved_sum_subject());
    if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, subject, choice.items, sum, used,
        revision, count, report)) return false;
    facts[subject] <- make CaseSumProjection {
        receiver <- projection.receiver; field <- projection.field; receipt <- receipt; arm <- arm;
        record <- record; value_type <- sum
    };
    facts[at] <- make ReceiptCaseSubject {
        expression <- subject; receipt <- receipt; arm <- arm; count <- count
    };
    work[at].case_schema_prepared <- true;
    return true
}

func prepare_borrowed_field_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, choice:const CaseSites in C, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
        const owner G, const owner A, owner F, const owner C, owner R} {
    val subject <- choice.subject;
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    if (!inspect_field_selection(nodes, revision, used, subject, projection)) return true;
    val receiver <- projection.receiver;
    ref index = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    ref record = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val origin <- if (names[receiver].kind == formal_binding()) { names[receiver].declaration } else { receiver };
    if (origin >= subject ||
        (!describe_inline_product(facts, origin, record) &&
         !describe_indexed_case_loan(nodes, names, selected, interfaces, published, receiver, used, revision, record_type(), index, record)))
        return true;
    if (!case_bits_type(record, aggregate, interfaces, published))
        return case_problem(report, subject, unproved_sum_subject());
    ref sum = make DeclaredType { kind <- record.kind; defining_module <- record.defining_module; identity <- record.identity };
    ref ordinal = make UInt64 { no_node() };
    ref readonly = make bool { false };
    if (!describe_record_member(source, nodes, names, selected, work, spellings, spelling_used, interfaces,
        published, projection.field, used, revision, true, sum, ordinal, readonly) || ordinal == no_node())
        return case_problem(report, projection.field, unproved_case_field());
    if (sum.kind != sum_type()) return true;
    if (!case_bits_type(sum, aggregate, interfaces, published))
        return case_problem(report, projection.field, unproved_case_field());
    ref count = make UInt64 { sum_case_extent(nodes, work, interfaces, published, sum, used, revision) };
    if (count == 0u64) return case_problem(report, subject, unproved_sum_subject());
    if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, subject, choice.items, sum, used, revision, count, report))
        return false;
    remember_indexed_aggregate_loan(nodes, facts, subject, index, record, false);
    remember_inline_product_field(facts, subject, receiver, projection.field, ordinal, readonly, false, record, sum);
    facts[at] <- make FieldLoanCaseSubject { expression <- subject; receiver <- receiver; count <- count };
    work[at].case_schema_prepared <- true;
    return true
}

func prepare_value_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, choice:const CaseSites in C, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
        const owner G, const owner A, owner F, const owner C, owner R} {
    val subject <- choice.subject;
    ref invocation = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    if (direct_invocation(nodes, revision, used, subject, invocation) != DirectInvocationReady ||
        names[invocation.callee].kind != ordinary_selection()) return true;
    val site <- names[invocation.callee].declaration;
    if (site >= used || selected[site].kind != callable_export() ||
        selected[site].shape != ordinary_callable_shape() ||
        selected[site].dependency_module != selected[site].origin_module) return true;
    val header <- find_interface(interfaces, published, selected[site].origin_module, selected[site].identity);
    # This reads the published result schema. Argument and call completion
    # checks still have to produce that exact independent value.
    if (header >= published || interfaces[header].result_kind != sum_type() ||
        interfaces[header].array_read_completion == NoArrayRead) return true;
    ref type = make DeclaredType {
        kind <- sum_type(); defining_module <- interfaces[header].type_module; identity <- interfaces[header].type_identity
    };
    if (!case_bits_type(type, aggregate, interfaces, published))
        return case_problem(report, subject, unproved_sum_subject());
    ref count = make UInt64 { sum_case_extent(nodes, work, interfaces, published, type, used, revision) };
    if (count == 0u64) return case_problem(report, subject, unproved_sum_subject());
    if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, subject, choice.items, type, used, revision, count, report))
        return false;
    facts[at] <- make ValueCaseSubject { expression <- subject; value_type <- type; count <- count };
    work[at].case_schema_prepared <- true;
    return true
}

func prepare_sum_case(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, owner R} {
    if (work[at].case_schema_prepared) return true;
    ref choice = make CaseSites { subject <- no_node(); items <- no_node() };
    if (!inspect_case(nodes, revision, used, at, choice)) return true;
    if (!prepare_value_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice, used, revision, report)) return false;
    if (work[at].case_schema_prepared) return true;
    if (!prepare_borrowed_field_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice, used, revision, report)) return false;
    if (work[at].case_schema_prepared) return true;
    if (!prepare_direct_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice, used, revision, report)) return false;
    if (work[at].case_schema_prepared) return true;
    if (!prepare_received_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice, used, revision, report)) return false;
    if (work[at].case_schema_prepared) return true;
    if (!prepare_projected_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice, used, revision, report)) return false;
    if (work[at].case_schema_prepared) return true;
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node()
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    val described <- describe_lexical_bits_element(nodes, names, facts, choice.subject, used, revision,
        sum_type(), loan, type) != (NoLexicalArray:LexicalArrayAccess) ||
        describe_indexed_case_loan(nodes, names, selected, interfaces, published, choice.subject,
            used, revision, sum_type(), loan, type);
    if (!has_case_head(nodes, work, choice.items, used, revision, true) &&
        (!described || !has_case_head(nodes, work, choice.items, used, revision, false))) return true;
    if (!described || !case_bits_type(type, aggregate, interfaces, published))
        return case_problem(report, choice.subject, unproved_sum_subject());
    ref count = make UInt64 { 0u64 };
    if (!prepare_case_arms(source, nodes, names, selected, work, spellings, spelling_used,
        interfaces, published, aggregate, facts, at, choice.subject, choice.items, type,
        used, revision, count, report)) return false;
    if (count == 0u64) return case_problem(report, at, unproved_sum_subject());
    remember_case_subject(facts, at, loan, type, count);
    work[at].case_schema_prepared <- true;
    return true
}

func describe_received_product(facts:const ConstructorCaseFacts in F, site:UInt64,
    type:DeclaredType in T) -> bool where {const owner F, owner T} {
    return case facts[site] of {
        CaseFieldReceipt { val received <- value_type; } -> {
            type.kind <- received.kind;
            type.defining_module <- received.defining_module;
            type.identity <- received.identity;
            true
        };
        CaseProductField { val received <- value_type; } -> {
            type.kind <- received.kind;
            type.defining_module <- received.defining_module;
            type.identity <- received.identity;
            true
        };
        _ -> false
    }
}

func describe_inline_product(facts:const ConstructorCaseFacts in F, site:UInt64,
    type:DeclaredType in T) -> bool where {const owner F, owner T} {
    case facts[site] of {
        InlineProductFormal { val product <- value_type; } -> {
            type.kind <- product.kind;
            type.defining_module <- product.defining_module;
            type.identity <- product.identity;
            return true
        };
        LexicalProductReference { val construction <-; } -> {
            return case facts[construction] of {
                BitsConstruction { val product <- value_type; } -> {
                    type.kind <- product.kind;
                    type.defining_module <- product.defining_module;
                    type.identity <- product.identity;
                    true
                };
                _ -> false
            }
        };
        InlineProductField { val product <- value_type; } -> {
            if (product.kind != record_type()) return false;
            type.kind <- product.kind;
            type.defining_module <- product.defining_module;
            type.identity <- product.identity;
            return true
        };
        _ -> {}
    };
    return false
}

func remember_case_projection(facts:ConstructorCaseFacts in F, site:UInt64, receiver:UInt64,
    field:UInt64, ordinal:UInt64, record:const DeclaredType in T, type:const DeclaredType in T)
    -> void where {owner F, const owner T} {
    facts[site] <- make CaseProductField {
        receiver <- receiver; field <- field; ordinal <- ordinal;
        record <- record; value_type <- type
    };
    return
}

func remember_inline_product_field(facts:ConstructorCaseFacts in F, site:UInt64, receiver:UInt64,
    field:UInt64, ordinal:UInt64, readonly:bool, writable:bool,
    record:const DeclaredType in T, type:const DeclaredType in T)
    -> void where {owner F, const owner T} {
    facts[site] <- make InlineProductField {
        receiver <- receiver; field <- field; ordinal <- ordinal;
        record <- record; value_type <- type; readonly <- readonly; writable <- writable
    };
    return
}

func prepare_lexical_bits_array(nodes:const ExprNodes in N, names:const NameBindings in B,
    views:const SuppliedViews in V, facts:ConstructorCaseFacts in F, at:UInt64,
    local:const LocalBindingSites in L, used:UInt64, revision:UInt64) -> bool
    where {const owner N, const owner B, const owner V, owner F, const owner L} {
    val input <- local.initializer;
    if (input >= at || input >= intrinsic (len)(views)) return false;
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node();
        owner_name <- no_node(); readonly <- false
    };
    val sum <- false;
    return case views[input] of {
        PreparedArrayConstruction {
            val placement <-; val owner_site <-; val type_module <-; val type_identity <-;
            val kind <- element; val module <- element_module; val identity <- element_identity;
        } -> {
            sum <- kind == SumArrayElement;
            if ((kind != ProductArrayElement && !sum) ||
                (placement == no_node() && owner_site != names[at].scope) ||
                inspect_binding(nodes, revision, used, local.binding, binding) == InvalidBindingSyntax)
                return false;
            facts[at] <- make LexicalBitsArray {
                owner_site <- owner_site; array_module <- type_module; array_type <- type_identity;
                element <- make DeclaredType {
                    kind <- if (sum) { sum_type() } else { record_type() };
                    defining_module <- module; identity <- identity
                };
                readonly <- binding.readonly
            };
            true
        };
        _ -> false
    }
}

func describe_lexical_bits_element(nodes:const ExprNodes in N, names:const NameBindings in B,
    facts:const ConstructorCaseFacts in F, expression:UInt64, used:UInt64, revision:UInt64,
    expected_kind:UInt8, loan:IndexedCaseLoan in L, element:DeclaredType in L)
    -> LexicalArrayAccess where {const owner N, const owner B, const owner F, owner L} {
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    if (!inspect_index_selection(nodes, revision, used, expression, indexed) ||
        names[indexed.target].kind != local_binding()) return (NoLexicalArray:LexicalArrayAccess);
    val origin <- names[indexed.target].declaration;
    if (origin >= indexed.target) return (NoLexicalArray:LexicalArrayAccess);
    return case facts[origin] of {
        LexicalBitsArray { val owner_site <-; val array_module <-; val array_type <-; val schema <- element; val readonly <-; } -> {
            if (schema.kind != expected_kind) return (NoLexicalArray:LexicalArrayAccess);
            loan.expression <- expression;
            loan.array <- indexed.target;
            loan.index <- indexed.index;
            loan.owner_site <- owner_site;
            loan.array_module <- array_module;
            loan.array_type <- array_type;
            element.kind <- schema.kind;
            element.defining_module <- schema.defining_module;
            element.identity <- schema.identity;
            if (readonly) { (ReadonlyLexicalArray:LexicalArrayAccess) } else { (WritableLexicalArray:LexicalArrayAccess) }
        };
        _ -> (NoLexicalArray:LexicalArrayAccess)
    }
}

func prepare_received_fields(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    used:UInt64, revision:UInt64, first:UInt64 in P, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, owner P, owner R} {
    ref selection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    ref record = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- 0u64 };
    ref ordinal = make UInt64 { no_node() };
    ref readonly = make bool { false };
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    val origin <- no_node();
    val access <- (NoLexicalArray:LexicalArrayAccess);
    val described <- false;
    val writable <- false;
    for (site in 0u64 .. used) {
        if (inspect_field_selection(nodes, revision, used, site, selection) &&
            (case facts[site] of { CaseSumProjection -> false; InlineProductField -> false; _ -> true })) {
            origin <- if (names[selection.receiver].kind == local_binding() ||
                          names[selection.receiver].kind == formal_binding()) {
                (names[selection.receiver].declaration)
            } else { (selection.receiver) };
            if (origin < site) {
                case facts[origin] of {
                    ArrayFieldRecordFormal {
                        val field <-; val record <- value_type; val array_module <-; val array_identity <-;
                        val fixed <-; val target_readonly <-;
                    } -> {
                        ordinal <- no_node();
                        if (field != no_node() &&
                            locate_named_field(source, nodes, work, field, selection.field, revision, used, ordinal) == field &&
                            ordinal == 0u64) {
                            (facts[site] <- make StoredArrayField {
                                receiver <- selection.receiver; record <- record; array_module <- array_module;
                                array_identity <- array_identity; fixed <- fixed; target_readonly <- target_readonly
                            }):void
                        }
                    };
                    _ -> {}
                }
            };
            loan.expression <- no_node();
            access <- (NoLexicalArray:LexicalArrayAccess);
            described <- origin < site && describe_inline_product(facts, origin, type);
            if (origin < site && !described) {
                access <- describe_lexical_bits_element(nodes, names, facts, selection.receiver,
                    used, revision, record_type(), loan, type);
                (described <- (access != (NoLexicalArray:LexicalArrayAccess) ||
                    describe_indexed_case_loan(nodes, names, selected, interfaces, published, selection.receiver, used,
                        revision, record_type(), loan, type)) && case_bits_type(type, aggregate, interfaces, published)):void
            };
            if (described) {
                record.kind <- type.kind;
                record.defining_module <- type.defining_module;
                record.identity <- type.identity;
                ordinal <- no_node();
                if (describe_record_member(source, nodes, names, selected, work, spellings, spelling_used,
                    interfaces, published, selection.field, used, revision, true, type, ordinal, readonly) &&
                    ordinal != no_node() && (native_scalar(type.kind) || type.kind == enum_type() ||
                        (type.kind == record_type() && case_bits_type(type, aggregate, interfaces, published)))) {
                    writable <- case facts[site] of { IndexedFieldDestination -> true; _ -> false };
                    remember_indexed_aggregate_loan(nodes, facts, site, loan, record,
                        access == (WritableLexicalArray:LexicalArrayAccess) || writable);
                    remember_inline_product_field(facts, site, selection.receiver,
                        selection.field, ordinal, readonly, writable, record, type);
                    if (loan.expression != no_node() && (type.kind == enum_type() || type.kind == builtin_bool())) {
                        remember_type(work, site, type)
                    };
                    if (type.kind == record_type() && first == no_node()) { (first <- site):void }
                }
            } else {};
            if (origin < site && describe_received_product(facts, origin, type)) {
                if (type.kind != record_type()) return case_problem(report, selection.field, unproved_case_field());
                record.kind <- type.kind;
                record.defining_module <- type.defining_module;
                record.identity <- type.identity;
                ordinal <- no_node();
                if (!case_bits_type(record, aggregate, interfaces, published) ||
                    !describe_record_member(source, nodes, names, selected, work, spellings, spelling_used, interfaces,
                        published, selection.field, used, revision, true, type, ordinal, readonly) || ordinal == no_node())
                    return case_problem(report, selection.field, unproved_case_field());
                if (!native_scalar(type.kind) && type.kind != enum_type() &&
                    !case_bits_type(type, aggregate, interfaces, published))
                    return case_problem(report, selection.field, 94u8);
                remember_case_projection(facts, site, selection.receiver, selection.field, ordinal, record, type)
            }
        }
    };
    return true
}

func prepare_fresh_sum_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, facts:ConstructorCaseFacts in F, invocation:UInt64, argument:UInt64, formal:UInt64,
    input:UInt64, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner G, owner F, owner R} {
    val lexical_owner <- names[invocation].scope;
    if (input >= argument || argument >= invocation || lexical_owner >= used ||
        names[input].scope != lexical_owner || checked_ref_argument(nodes, argument))
        return case_problem(report, input, unsupported_bits_construction());
    return case facts[formal] of {
        CaseSumFormal { val owner_site <-; val readonly <-; val type <- value_type; } -> {
            if (!readonly || owner_constraint_syntax(nodes, owner_site) != ReadonlyOwnerConstraint)
                return case_problem(report, input, unsupported_bits_construction());
            if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published,
                facts, input, argument, type, used, revision, report)) return false;
            facts[argument] <- make FreshSumArgument {
                invocation <- invocation; formal <- formal; construction <- input; lexical_owner <- lexical_owner;
            };
            true
        };
        _ -> case_problem(report, input, unsupported_bits_construction())
    }
}

func prepared_readonly_product_actual(names:const NameBindings in B, facts:const ConstructorCaseFacts in F,
    input:UInt64) -> bool where {const owner B, const owner F} {
    val origin <- names[input].declaration;
    if (origin >= input) return false;
    if (names[input].kind == formal_binding()) {
        return case facts[origin] of { InlineProductFormal -> true; _ -> false }
    };
    return names[input].kind == local_binding() &&
        (case facts[origin] of { LexicalProductReference -> true; _ -> false })
}

func describe_indexed_product_argument(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in G, published:UInt64,
    facts:const ConstructorCaseFacts in F, input:UInt64, used:UInt64, revision:UInt64,
    loan:IndexedCaseLoan in L, record:DeclaredType in L) -> bool
    where {const owner N, const owner B, const owner E, const owner G, const owner F, owner L} {
    return describe_indexed_case_loan(nodes, names, selected, interfaces, published, input,
        used, revision, record_type(), loan, record) ||
        describe_lexical_bits_element(nodes, names, facts, input, used, revision, record_type(),
            loan, record) != (NoLexicalArray:LexicalArrayAccess)
}

func prepare_aggregate_loan_call(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W,
    interfaces:const ModuleInterfaces in G, published:UInt64, aggregate:const AggregateFacts in A,
    facts:ConstructorCaseFacts in F, call:UInt64, definition:UInt64, function_form:bool, first_argument:UInt64, first_formal:UInt64,
    first:UInt64 in P, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner G, const owner A,
        owner F, owner P, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    ref record = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val argument <- first_argument;
    val formal <- first_formal;
    val actual <- no_node();
    for (unused in 0u64 .. used) {
        if (argument >= used || formal >= used) return true;
        if (inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence) return true;
        if (!function_form) {
            if ((case facts[formal] of { InlineProductFormal { val readonly <-; } -> readonly; _ -> false }) &&
                prepared_readonly_product_actual(names, facts, entry.item)) {
                facts[call] <- make ProductLoanInvocation { definition <- definition };
                if (first == no_node()) { (first <- call):void };
                return true
            };
        } else {
            case facts[formal] of {
                IndexedOutputFormal { val bound <- definition; val owner_site <-; val expected <- value_type; } -> {
                    if (bound == definition &&
                        describe_indexed_product_argument(nodes, names, selected, interfaces, published, facts,
                            entry.item, used, revision, loan, record) && loan.array_module == 0u64 &&
                        record.identity == expected.identity && record.defining_module == expected.defining_module &&
                        case_bits_type(record, aggregate, interfaces, published)) {
                        remember_inline_product_formal(facts, formal, definition, owner_site, false, false, expected);
                        remember_indexed_aggregate_loan(nodes, facts, argument, loan, record, true);
                        if (first == no_node()) { (first <- call):void }
                    }
                };
                InlineProductFormal { val readonly <-; } -> {
                    # The selected array schema identifies the element. The
                    # operand check still validates its actual view and index.
                    if (describe_indexed_product_argument(nodes, names, selected, interfaces, published, facts,
                            entry.item, used, revision, loan, record) && (loan.array_module == 0u64 || readonly) &&
                        case_bits_type(record, aggregate, interfaces, published)) {
                        remember_indexed_aggregate_loan(nodes, facts, argument, loan, record, !readonly);
                        if (first == no_node()) { (first <- call):void }
                    }
                };
                _ -> {}
            };
            if ((case facts[entry.item] of {
                IndexedAggregateLoan { val consumer <-; } -> consumer == argument;
                _ -> false
            }) && (case facts[call] of { NoConstructorCase -> true; _ -> false })) {
                (facts[call] <- make ProductLoanInvocation { definition <- definition }):void
            };
            if (names[entry.item].kind == formal_binding()) {
                actual <- names[entry.item].declaration;
                if (actual < entry.item &&
                    (case facts[actual] of {
                        InlineProductFormal { val type <- value_type; } -> type.defining_module != 0u64;
                        _ -> false
                    }) &&
                    (case facts[formal] of { InlineProductFormal -> true; _ -> false }) &&
                    (case facts[call] of { NoConstructorCase -> true; _ -> false })) {
                    (facts[call] <- make ProductLoanInvocation { definition <- definition }):void
                }
            };
            if (work[entry.item].inline_sum_initializer) {
                if (!prepare_fresh_sum_argument(nodes, names, selected, work, interfaces, published, facts, call,
                    argument, formal, entry.item, used, revision, report)) return false;
                facts[call] <- make FreshSumInvocation { definition <- definition; };
                if (first == no_node()) { (first <- call):void }
            };
        };
        argument <- work[argument].next;
        formal <- work[formal].next
    };
    return true
}

# Preserve the established direct writer's demand when its writable
# actual is subsequently forwarded to a same-revision callable.
func mark_direct_writer_loan(names:const NameBindings in B, facts:ConstructorCaseFacts in F,
    call:UInt64, input:UInt64, nodes:const ExprNodes in N) -> void
    where {const owner B, owner F, const owner N} {
    if (names[input].kind != formal_binding()) return;
    val formal <- names[input].declaration;
    if (formal >= input) return;
    case facts[formal] of {
        InlineProductFormal {
            val owner_site <-; val type <- value_type; val definition <-; val readonly <-;
        } -> {
            if (!readonly && definition == enclosing_callable(nodes, names, names[call].scope)) {
                remember_inline_product_formal(facts, formal, definition, owner_site, false, true, type)
            }
        };
        _ -> {}
    };
}

func prepare_imported_aggregate_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W,
    interfaces:const ModuleInterfaces in G, published:UInt64,
    facts:ConstructorCaseFacts in F, call:UInt64, header:UInt64, first_argument:UInt64,
    first:UInt64 in P, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner G,
        owner F, owner P, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    val argument <- first_argument;
    val input <- no_node();
    val lexical_owner <- names[call].scope;
    ref expected = make DeclaredType {
        kind <- sum_type();
        defining_module <- interfaces[header + 5u64].type_module;
        identity <- interfaces[header + 5u64].type_identity;
    };
    for (position in 0u64 .. 5u64) {
        if (argument >= call ||
            inspect_sequence_entry(nodes, revision, used, argument, entry) != ArgumentSequence) return true;
        input <- entry.item;
        if (position == 1u64) {
            mark_direct_writer_loan(names, facts, call, input, nodes)
        };
        if (work[input].inline_sum_initializer) {
            if (position != 4u64 || input >= argument || lexical_owner >= used ||
                names[input].scope != lexical_owner || checked_ref_argument(nodes, argument))
                return case_problem(report, input, unsupported_bits_construction());
            if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
                input, argument, expected, used, revision, report)) return false;
            facts[call] <- make ImportedFreshSumInvocation {};
            if (first == no_node()) { (first <- call):void }
        };
        (argument <- work[argument].next):void
    };
    return true
}

func prepare_aggregate_loan_arguments(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W,
    interfaces:const ModuleInterfaces in G, published:UInt64, aggregate:const AggregateFacts in A,
    facts:ConstructorCaseFacts in F, first:UInt64 in P, used:UInt64, revision:UInt64,
    report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner G, const owner A, owner F, owner P, owner R} {
    ref invocation = make DirectCallSites { callee <- no_node(); arguments <- no_node() };
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    ref signature = make SignatureSites {
        previous <- no_node(); name <- no_node(); annotation <- no_node(); parameter_tail <- no_node(); readonly <- false;
    };
    ref header = make UInt64 { no_node() };
    ref argument = make UInt64 { no_node() };
    ref formal = make UInt64 { no_node() };
    val definition <- no_node();
    val imported_header <- no_node();
    for (call in 0u64 .. used) {
        if (direct_invocation(nodes, revision, used, call, invocation) == DirectInvocationReady &&
            invocation.arguments != no_node() && names[invocation.callee].kind == ordinary_selection()) {
            imported_header <- work[names[invocation.callee].declaration].selected_aggregate_writer;
            if (imported_header < published &&
                first_sequence_entry(nodes, revision, used, invocation.arguments, ArgumentSequence, argument) &&
                !prepare_imported_aggregate_arguments(nodes, names, selected, work, interfaces, published,
                    facts, call, imported_header, argument, first, used, revision, report)) return false
        };
        if (direct_invocation(nodes, revision, used, call, invocation) == DirectInvocationReady &&
            invocation.arguments != no_node() && names[invocation.callee].kind == callable_binding()) {
            definition <- names[invocation.callee].declaration;
            if (definition < used && work[definition].next_method == no_node() &&
                inspect_callable(nodes, revision, used, definition, callable) == ModuleCallable &&
                callable.body != no_node() &&
                find_signature_clause(nodes, revision, used, callable.signature, SignatureHead, header) &&
                inspect_signature(nodes, revision, used, header, signature) == SignatureHead &&
                first_sequence_entry(nodes, revision, used, signature.parameter_tail, FormalSequence, formal) &&
                first_sequence_entry(nodes, revision, used, invocation.arguments, ArgumentSequence, argument)) {
                if (!prepare_aggregate_loan_call(nodes, names, selected, work, interfaces, published, aggregate,
                    facts, call, definition, callable.function_form, argument, formal, first, used, revision, report)) return false
            }
        }
    };
    return true
}

func indexed_field_destination(nodes:const ExprNodes in N, at:UInt64, revision:UInt64,
    destination:UInt64, field:FieldSelectionSites in F, index:IndexSites in I) -> bool
    where {const owner N, owner F, owner I} {
    val projection <- destination;
    for (unused in 0u64 .. at) {
        if (!inspect_field_selection(nodes, revision, at, projection, field) || field.receiver >= projection)
            return false;
        if (inspect_index_selection(nodes, revision, at, field.receiver, index)) return true;
        (projection <- field.receiver):void
    };
    return false
}

func indexed_braced_transfer(nodes:const ExprNodes in N, at:UInt64, revision:UInt64,
    assignment:const AssignmentSites in A, construction:ConstructionSites in C) -> bool
    where {const owner N, const owner A, owner C} {
    ref index = make IndexSites { target <- no_node(); index <- no_node() };
    return inspect_index_selection(nodes, revision, at, assignment.destination, index) &&
        inspect_construction(nodes, revision, at, assignment.input, construction) == BracedConstruction &&
        construction.placement == no_node() && construction.queried_operand == no_node()
}

func prepare_local_sum_write(nodes:const ExprNodes in N, names:const NameBindings in B,
    work:const NameWork in W, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    transfer:UInt64, input:UInt64, requested:UInt64, used:UInt64, revision:UInt64,
    report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner W, const owner A, owner F, owner R} {
    val arm <- names[requested].declaration;
    if (arm >= used || names[transfer].kind != 0u8)
        return case_problem(report, input, unproved_sum_subject());
    val sum <- work[arm].declaring_sum;
    if (sum >= used || sum >= intrinsic (len)(aggregate) ||
        aggregate[sum] != (CoDBitsAggregate:AggregateStorage))
        return case_problem(report, input, unproved_sum_subject());
    ref count = make UInt64 { 0u64 };
    ref ordinal = make UInt64 { no_node() };
    ref sites = make SumArmSites { previous <- no_node(); name <- no_node(); fields <- no_node() };
    # Registration has already rejected any visible initializer definition for an arm.
    if (local_sum_constructor(nodes, names, work, sum, requested, used, revision, count, ordinal) != arm ||
        !inspect_sum_arm(nodes, revision, used, arm, sites))
        return case_problem(report, input, unselected_case_constructor());
    facts[input] <- make LocalSumConstruction { transfer <- transfer; sum <- sum; arm <- arm; fields <- sites.fields };
    return true
}

func unsupported_bits_construction() -> UInt8 { return 149u8 }
func wrong_construction_type() -> UInt8 { return 150u8 }
func unknown_inline_field() -> UInt8 { return 151u8 }

func read_inline_field_type(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, field:UInt64, used:UInt64, revision:UInt64,
    type:DeclaredType in R, readonly:bool in R) -> bool
    where {const owner N, const owner B, const owner E, owner R} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    if (inspect_formal(nodes, revision, used, field, formal) != OrdinaryFormal ||
        (formal.mode != ValueFormal && formal.mode != ExplicitValueFormal) ||
        inspect_binding(nodes, revision, used, formal.binding, binding) != TypedBinding ||
        binding.owner_name != no_node() ||
        !describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, type)) return false;
    readonly <- binding.readonly;
    return true
}

func has_inline_aggregate_field(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, record:UInt64, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner W} {
    ref syntax = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    ref field = make UInt64 { no_node() };
    if (inspect_declaration(nodes, revision, used, record, syntax) != NominalRecord ||
        !first_sequence_entry(nodes, revision, used, syntax.entries, FormalSequence, field)) return false;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    ref readonly = make bool { false };
    for (unused in 0u64 .. used) {
        if (field == no_node()) return false;
        if (read_inline_field_type(nodes, names, selected, field, used, revision, type, readonly) &&
            (type.kind == record_type() || type.kind == sum_type())) return true;
        field <- work[field].next
    };
    return false
}

# Keep the imported layout in its defining interface. Local fields use the
# checked sequence links, and neither representation needs copying into F.
func local_bits_field_count(nodes:const ExprNodes in N, work:const NameWork in W,
    fields:UInt64, used:UInt64, revision:UInt64) -> UInt64 where {const owner N, const owner W} {
    ref field = make UInt64 { no_node() };
    if (!first_sequence_entry(nodes, revision, used, fields, FormalSequence, field)) return no_node();
    if (field == no_node()) return 0u64;
    for (count in 0u64 .. used) {
        if (field == fields) return count + 1u64;
        if (work[field].next <= field || work[field].next > fields) return no_node();
        field <- work[field].next
    };
    return no_node()
}

func local_bits_schema(nodes:const ExprNodes in N, names:const NameBindings in B, work:const NameWork in W,
    expected:const DeclaredType in T, requested:UInt64, used:UInt64, revision:UInt64, fields:UInt64 in R)
    -> bool where {const owner N, const owner B, const owner W, const owner T, owner R} {
    val chosen <- names[requested].declaration;
    if (expected.kind == sum_type()) {
        ref count = make UInt64 { 0u64 };
        ref ordinal = make UInt64 { no_node() };
        ref alternative = make SumArmSites { previous <- no_node(); name <- no_node(); fields <- no_node() };
        if (chosen >= used || work[chosen].declaring_sum != expected.identity ||
            local_sum_constructor(nodes, names, work, expected.identity, requested,
                used, revision, count, ordinal) != chosen ||
            !inspect_sum_arm(nodes, revision, used, chosen, alternative)) return false;
        fields <- alternative.fields;
        return true
    };
    ref product = make DeclarationSites {
        name <- no_node(); parent_type <- no_node(); entries <- no_node(); value_type <- no_node();
        index_type <- no_node(); owner_name <- no_node(); readonly <- false; nullable <- false;
    };
    if (expected.kind != record_type() || names[requested].kind != record_type() || chosen != expected.identity)
        return false;
    val shape <- inspect_declaration(nodes, revision, used, chosen, product);
    if (shape != NominalRecord && shape != NativeRecord) return false;
    fields <- product.entries;
    return true
}

func published_bits_schema(names:const NameBindings in B, selected:const SelectedExports in E,
    interfaces:const ModuleInterfaces in G, published:UInt64, expected:const DeclaredType in T, requested:UInt64)
    -> UInt64 where {const owner B, const owner E, const owner G, const owner T} {
    if (expected.kind == sum_type()) {
        # The receiver's name binding has rejected visible constructor
        # initializers. Field count alone would not establish that.
        if (names[requested].kind != constructor_type() || names[requested].declaration != no_node()) return no_node();
        ref count = make UInt64 { 0u64 };
        ref ordinal = make UInt64 { no_node() };
        return published_case_constructor(selected, interfaces, published, expected, requested, count, ordinal)
    };
    if (expected.kind != record_type() || names[requested].kind != ordinary_selection()) return no_node();
    val declaration <- names[requested].declaration;
    if (declaration >= intrinsic (len)(selected) || selected[declaration].kind != record_export() ||
        selected[declaration].origin_module != expected.defining_module ||
        selected[declaration].identity != expected.identity) return no_node();
    val head <- find_interface(interfaces, published, expected.defining_module, expected.identity);
    return if (head != no_node() && interfaces[head].interface_kind == record_type()) { head } else { no_node() }
}

# The checked constructor selection supplies its own nominal identity. The
# receiving element or field can only check that selection.
func prepare_bits_construction(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, facts:ConstructorCaseFacts in F, at:UInt64, transfer:UInt64,
    expected:const DeclaredType in T, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner G, owner F,
        const owner T, owner R} {
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    if (at >= transfer || inspect_construction(nodes, revision, used, at, syntax) != BracedConstruction ||
        syntax.requested >= at || syntax.placement != no_node() || syntax.queried_operand != no_node())
        return case_problem(report, at, unsupported_bits_construction());
    ref schema = make UInt64 { no_node() };
    val count <- if (expected.defining_module == 0u64) {
        if (!local_bits_schema(nodes, names, work, expected, syntax.requested, used, revision, schema))
            return case_problem(report, syntax.requested, wrong_construction_type());
        local_bits_field_count(nodes, work, schema, used, revision)
    } else {
        schema <- published_bits_schema(names, selected, interfaces, published, expected, syntax.requested);
        if (schema == no_node()) return case_problem(report, syntax.requested, wrong_construction_type());
        (interfaces[schema].entry_count)
    };
    ref first = make UInt64 { no_node() };
    ref last = make UInt64 { no_node() };
    if (count == no_node() || !block_tail(nodes, revision, at, syntax.contents, last) ||
        !first_sequence_entry(nodes, revision, at, last, BlockSequence, first))
        return case_problem(report, at, unsupported_bits_construction());
    facts[at] <- make BitsConstruction {
        transfer <- transfer; value_type <- expected; schema <- schema; field_count <- count;
        first_initializer <- first; last_initializer <- last;
    };
    return true
}

func prepare_lexical_sum_reference(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, local:const LocalBindingSites in L, used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner G, const owner A,
        owner F, const owner L, owner R} {
    val input <- local.initializer;
    val lexical_owner <- names[at].scope;
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    if (input >= at || lexical_owner >= used || names[input].scope != lexical_owner ||
        inspect_construction(nodes, revision, at, input, syntax) != BracedConstruction)
        return case_problem(report, input, unsupported_bits_construction());
    if (names[syntax.requested].kind != constructor_type())
        return case_problem(report, syntax.requested, unselected_case_constructor());
    ref type = make DeclaredType {
        kind <- sum_type(); defining_module <- 0u64; identity <- no_node();
    };
    val arm <- names[syntax.requested].declaration;
    if (arm < used) {
        (type.identity <- work[arm].declaring_sum):void
    } else {
        val chosen <- selected[syntax.requested].constructor_selection;
        if (chosen >= used) return case_problem(report, syntax.requested, unselected_case_constructor());
        val head <- selected[chosen].sum_head;
        if (head >= published || interfaces[head].interface_kind != sum_type())
            return case_problem(report, syntax.requested, unselected_case_constructor());
        type.defining_module <- interfaces[head].defining_module;
        (type.identity <- interfaces[head].declaration):void
    };
    if (!case_bits_type(type, aggregate, interfaces, published))
        return case_problem(report, input, unsupported_bits_construction());
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val shape <- inspect_binding(nodes, revision, at, local.binding, binding);
    if ((shape != BareBinding && shape != TypedBinding) || binding.owner_name != no_node())
        return case_problem(report, local.binding, unsupported_bits_construction());
    if (shape == TypedBinding) {
        ref annotation = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node(); };
        if (!describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, annotation) ||
            annotation.kind != sum_type() || annotation.defining_module != type.defining_module ||
            annotation.identity != type.identity)
            return case_problem(report, binding.annotation, wrong_construction_type())
    };
    if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
        input, at, type, used, revision, report)) return false;
    facts[at] <- make LexicalSumReference { construction <- input; owner_site <- lexical_owner; readonly <- binding.readonly; };
    return true
}

# Describe the constructor in the view selected by its written name. The
# annotation can restrict that target but cannot select a different type.
func prepare_lexical_product_reference(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    at:UInt64, local:const LocalBindingSites in L,
    used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner G, const owner A,
        owner F, const owner L, owner R} {
    val input <- local.initializer;
    val lexical_owner <- names[at].scope;
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    if (input >= at || lexical_owner >= used || names[input].scope != lexical_owner ||
        inspect_construction(nodes, revision, used, input, syntax) != BracedConstruction ||
        syntax.placement != no_node() || syntax.queried_operand != no_node())
        return true;
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_type(nodes, names, selected, syntax.requested, 0u64, revision, used, type) ||
        type.kind != record_type())
        return true;
    if (type.defining_module == 0u64) {
        if (type.identity >= used || aggregate[type.identity] != CoDBitsAggregate) return true
    } else {
        val storage <- checked_aggregate_storage(interfaces, published, type.defining_module, type.identity, record_type());
        if (storage != CLayoutBitsRecord && storage != CoDBitsAggregate) return true
    };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false;
    };
    val shape <- inspect_binding(nodes, revision, at, local.binding, binding);
    if ((shape != BareBinding && shape != TypedBinding) || binding.owner_name != no_node()) return true;
    if (shape == TypedBinding) {
        ref annotation = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
        if (!describe_type(nodes, names, selected, binding.annotation, 0u64, revision, used, annotation) ||
            annotation.kind != type.kind || annotation.defining_module != type.defining_module ||
            annotation.identity != type.identity)
            return case_problem(report, binding.annotation, wrong_construction_type())
    };
    if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
        input, at, type, used, revision, report)) return false;
    facts[at] <- make LexicalProductReference { construction <- input; owner_site <- lexical_owner; readonly <- binding.readonly };
    return true
}

func prepare_lexical_sum_rebind(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, facts:ConstructorCaseFacts in F, at:UInt64, assignment:const AssignmentSites in A,
    used:UInt64, revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner G,
        owner F, const owner A, owner R} {
    val destination <- assignment.destination;
    val input <- assignment.input;
    if (destination >= at || input >= at || names[destination].kind != local_binding())
        return case_problem(report, at, unsupported_bits_construction());
    val slot <- names[destination].declaration;
    if (slot >= destination) return case_problem(report, destination, unsupported_bits_construction());
    return case facts[slot] of {
        LexicalSumReference { val initializer <- construction; val owner_site <-; } -> {
            if (owner_site != names[at].scope || owner_site != names[input].scope)
                return case_problem(report, input, unsupported_bits_construction());
            case facts[initializer] of {
                BitsConstruction { val type <- value_type; } -> {
                    if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
                        input, at, type, used, revision, report)) return false;
                    facts[at] <- make LexicalSumRebind { destination <- destination; construction <- input; owner_site <- owner_site; };
                    return true
                };
                _ -> { return case_problem(report, input, unsupported_bits_construction()) }
            }
        };
        _ -> case_problem(report, destination, unsupported_bits_construction())
    }
}

func prepare_indexed_bits_write(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, work:const NameWork in W, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, transfer:UInt64,
    assignment:const AssignmentSites in S, construction:const ConstructionSites in S, used:UInt64,
    revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner N, const owner B, const owner E, const owner W, const owner G,
        const owner A, owner F, const owner S, owner R} {
    val requested <- construction.requested;
    val chosen <- names[requested].declaration;
    val sum_initializer <- names[requested].kind == constructor_type();
    val imported_record <- names[requested].kind == ordinary_selection() && chosen < used &&
        selected[chosen].kind == record_export();
    val local_bits_product <- names[requested].kind == record_type() &&
        chosen < used && aggregate[chosen] == CoDBitsAggregate &&
        names[transfer].kind == 0u8 && names[assignment.destination].kind == 0u8;
    # A local product with only builtin scalars can use the ordinary path.
    if (!work[assignment.input].repeated_indexed_initializer && !sum_initializer &&
        !imported_record && !local_bits_product &&
        !has_inline_aggregate_field(nodes, names, selected, work, chosen, used, revision)) return true;
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node();
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    val expected_kind <- if (sum_initializer) { sum_type() } else { record_type() };
    if (names[transfer].kind != 0u8 || names[assignment.destination].kind != 0u8 ||
        !describe_indexed_case_loan(nodes, names, selected, interfaces, published, assignment.destination,
            used, revision, expected_kind, loan, type) ||
        (!sum_initializer && !imported_record && loan.array_module != 0u64) ||
        !case_bits_type(type, aggregate, interfaces, published))
        return case_problem(report, assignment.destination, wrong_construction_type());
    if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
        assignment.input, transfer, type, used, revision, report)) return false;
    remember_indexed_aggregate_destination(nodes, facts, assignment.destination, transfer, loan, type);
    return true
}

func remember_indexed_aggregate_destination(nodes:const ExprNodes in N, facts:ConstructorCaseFacts in F,
    destination:UInt64, transfer:UInt64, loan:const IndexedCaseLoan in L, type:const DeclaredType in T)
    -> void where {const owner N, owner F, const owner L, const owner T} {
    facts[destination] <- make IndexedAggregateDestination {
        transfer <- transfer; array <- loan.array; index <- loan.index; owner_site <- loan.owner_site;
        array_module <- loan.array_module; array_type <- loan.array_type; element <- type;
        index_binds_storage <- binds_local_storage(nodes, loan.index)
    };
    return
}

func prepare_indexed_local_product_copy(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, interfaces:const ModuleInterfaces in G, published:UInt64,
    aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F,
    transfer:UInt64, assignment:const AssignmentSites in S, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E, const owner G, const owner A, owner F, const owner S} {
    val source <- assignment.input;
    val destination <- assignment.destination;
    if (names[transfer].kind != 0u8 || names[destination].kind != 0u8 ||
        names[source].kind != local_binding()) return false;
    val declaration <- names[source].declaration;
    if (declaration >= source) return false;
    ref loan = make IndexedCaseLoan {
        expression <- no_node(); array <- no_node(); index <- no_node(); owner_site <- no_node();
        array_module <- 0u64; array_type <- no_node()
    };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    if (!describe_indexed_case_loan(nodes, names, selected, interfaces, published, destination,
        used, revision, record_type(), loan, type) || loan.array_module != 0u64 ||
        type.defining_module != 0u64 || type.identity >= used || aggregate[type.identity] != CLayoutBitsRecord)
        return false;
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false
    };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    if (!inspect_local_binding(nodes, revision, used, declaration, local) || local.mode != ReferenceLocal ||
        inspect_construction(nodes, revision, used, local.initializer, construction) != BracedConstruction ||
        construction.placement != no_node() || construction.queried_operand != no_node() ||
        names[construction.requested].kind != record_type() ||
        names[construction.requested].declaration != type.identity) return false;
    remember_indexed_aggregate_destination(nodes, facts, destination, transfer, loan, type);
    return true
}

func published_bits_field(source:const SourceBytes in S, nodes:const ExprNodes in N,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, schema:UInt64, schema_kind:UInt8, name:UInt64, used:UInt64,
    type:DeclaredType in T, readonly:bool in T) -> UInt64
    where {const owner S, const owner N, const owner G, owner T} {
    val field <- published_named_field(source, nodes, spellings, spelling_used, interfaces, published, schema, name, used);
    if (field == no_node()) return no_node();
    if (schema_kind == sum_type()) {
        if (!read_published_sum_field(interfaces, field, type, readonly)) return no_node();
    } else {
        val mode <- interfaces[field].field_mode;
        if (interfaces[field].value_kind == 0u8 || (mode != ValueFormal && mode != ExplicitValueFormal))
            return no_node();
        type.kind <- interfaces[field].value_kind;
        type.defining_module <- interfaces[field].type_module;
        type.identity <- interfaces[field].type_identity;
        (readonly <- interfaces[field].target_readonly != 0u8):void
    };
    return field - schema - 1u64
}

func repeated_bits_field(facts:const ConstructorCaseFacts in F, work:const NameWork in W,
    parent:UInt64, first:UInt64, current:UInt64, ordinal:UInt64) -> bool where {const owner F, const owner W} {
    val earlier <- first;
    for (unused in first .. current) {
        if (earlier >= current) return false;
        if (case facts[earlier] of {
            BitsFieldInitializer { val construction <-; val field <- ordinal; } -> construction == parent && field == ordinal;
            _ -> false
        }) return true;
        earlier <- work[earlier].next
    };
    return false
}

func prepare_bits_initializers(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:const NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, at:UInt64,
    fields:UInt64, schema_type:const DeclaredType in T, first:UInt64, last:UInt64, used:UInt64,
    revision:UInt64, report:DeclaredExpressionResult in R)
    -> bool where {const owner S, const owner N, const owner B, const owner E, const owner W,
        const owner G, const owner A, owner F, const owner T, owner R} {
    ref entry = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- no_node() };
    ref type = make DeclaredType { kind <- 0u8; defining_module <- 0u64; identity <- no_node() };
    ref readonly = make bool { false };
    ref ordinal = make UInt64 { no_node() };
    ref syntax = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    val item <- first;
    val name <- no_node();
    val field <- no_node();
    val repeated <- false;
    for (unused in 0u64 .. used) {
        if (item == no_node()) return true;
        if (inspect_sequence_entry(nodes, revision, at, item, entry) != BlockSequence ||
            inspect_assignment(nodes, revision, at, entry.item, assignment) != FieldTransfer ||
            names[assignment.destination].kind != record_initializer_label() || names[entry.item].kind != 0u8)
            return case_problem(report, entry.item, unsupported_bits_construction());
        name <- ungrouped(nodes, revision, used, assignment.destination);
        if (schema_type.defining_module == 0u64) {
            field <- locate_named_field(source, nodes, work, fields, name, revision, used, ordinal);
            if (field == no_node()) return case_problem(report, name, unknown_inline_field());
            if (!read_inline_field_type(nodes, names, selected, field, used, revision, type, readonly))
                return case_problem(report, name, unsupported_bits_construction());
        } else {
            ordinal <- published_bits_field(source, nodes, spellings, spelling_used, interfaces, published,
                fields, schema_type.kind, name, used, type, readonly);
            if (ordinal == no_node()) return case_problem(report, name, unknown_inline_field());
        };
        if (type.kind == record_type() || type.kind == sum_type()) {
            if (!case_bits_type(type, aggregate, interfaces, published))
                return case_problem(report, name, unsupported_bits_construction());
            if (inspect_construction(nodes, revision, at, assignment.input, syntax) == BracedConstruction &&
                !prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
                    assignment.input, entry.item, type, used, revision, report)) return false
        };
        repeated <- repeated_bits_field(facts, work, at, first, item, ordinal);
        facts[item] <- make BitsFieldInitializer {
            construction <- at; ordinal <- ordinal; operand <- assignment.input; value_type <- type; readonly <- readonly;
            repeated <- repeated; binds_storage <- binds_local_storage(nodes, assignment.input);
        };
        if (item == last) return true;
        if (work[item].next <= item || work[item].next > last) return case_problem(report, item, unsupported_bits_construction());
        item <- work[item].next
    };
    return case_problem(report, at, unsupported_bits_construction())
}

func fixed_indexed_field_initializer(nodes:const ExprNodes in N, local:const LocalBindingSites in L,
    at:UInt64, used:UInt64, revision:UInt64) -> bool where {const owner N, const owner L} {
    if (local.mode != ValueLocal || !local.declaration_const || local.initializer >= at) return false;
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    return inspect_field_selection(nodes, revision, used, local.initializer, field) &&
        inspect_index_selection(nodes, revision, used, field.receiver, indexed)
}

export func needs_constructor_case_plan(nodes:const ExprNodes in N, names:const NameBindings in B,
    selected:const SelectedExports in E, used:UInt64, revision:UInt64)
    -> bool where {const owner N, const owner B, const owner E} {
    ref formal = make FormalSites { binding <- no_node(); signature <- no_node(); mode <- ValueFormal };
    ref binding = make BindingSites {
        name <- no_node(); annotation <- no_node(); target_type <- no_node(); owner_name <- no_node(); readonly <- false
    };
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false;
    };
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    ref choice = make CaseSites { subject <- no_node(); items <- no_node() };
    ref projection = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    ref argument = make SequenceEntry { previous <- no_node(); item <- no_node() };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- no_node() };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    val type_at <- no_node();
    for (at in 0u64 .. used) {
        type_at <- explicit_value_result_type(nodes, revision, used, at);
        if (type_at < used && names[type_at].kind == sum_type()) return true;
        if (inspect_formal(nodes, revision, used, at, formal) == OrdinaryFormal && formal.mode == ReferenceFormal &&
            inspect_binding(nodes, revision, used, formal.binding, binding) == TypedBinding &&
            binding.owner_name < used && binding.target_type < used &&
            (!binding.readonly || !is_function(nodes, names[at].scope)) &&
            (names[binding.target_type].kind == record_type() ||
                (names[binding.target_type].kind == ordinary_selection() &&
                 selected[names[binding.target_type].declaration].kind == record_export()))) return true;
        if (inspect_local_binding(nodes, revision, used, at, local) &&
            ((local.mode == ReferenceLocal &&
              inspect_construction(nodes, revision, used, local.initializer, construction) == BracedConstruction &&
              construction.placement == no_node() && construction.queried_operand == no_node()) ||
             fixed_indexed_field_initializer(nodes, local, at, used, revision))) return true;
        if ((inspect_assignment(nodes, revision, used, at, assignment) == PlaceTransfer &&
            ((names[at].kind == 0u8 &&
              indexed_field_destination(nodes, at, revision, assignment.destination, projection, indexed)) ||
             indexed_braced_transfer(nodes, at, revision, assignment, construction))) ||
            case_pattern(nodes, used, at) == ConstructorCaseTarget ||
            (inspect_case(nodes, revision, used, at, choice) &&
             (name_syntax(nodes, used, choice.subject) == OrdinaryName ||
              inspect_index_selection(nodes, revision, used, choice.subject, indexed) ||
              inspect_field_selection(nodes, revision, used, choice.subject, projection)))) return true;
        if (inspect_sequence_entry(nodes, revision, used, at, argument) == ArgumentSequence &&
            (inspect_index_selection(nodes, revision, used, argument.item, indexed) ||
             inspect_field_selection(nodes, revision, used, argument.item, projection) ||
             (inspect_construction(nodes, revision, used, argument.item, construction) == BracedConstruction &&
              construction.placement == no_node() && construction.queried_operand == no_node()))) return true
    };
    return false
}

func prepare_sum_value_result(nodes:const ExprNodes in N, names:const NameBindings in B, selected:const SelectedExports in E,
    work:const NameWork in W, interfaces:const ModuleInterfaces in G, published:UInt64,
    aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, callable:const CallableSites in C,
    definition:UInt64, used:UInt64, revision:UInt64, first:UInt64 in P, report:DeclaredExpressionResult in R) -> bool
    where {const owner N, const owner B, const owner E, const owner W, const owner G,
        const owner A, owner F, const owner C, owner P, owner R} {
    val annotation <- local_sum_value_type(nodes, names, callable.signature, revision, used);
    if (annotation == no_node()) return true;
    ref type = make DeclaredType { kind <- sum_type(); defining_module <- 0u64; identity <- no_node(); };
    if (callable.function_form || names[definition].declaration != definition || work[definition].next_method != no_node() ||
        !describe_type(nodes, names, selected, annotation, 0u64, revision, used, type) ||
        type.kind != sum_type() || !case_bits_type(type, aggregate, interfaces, published))
        return case_problem(report, annotation, unsupported_bits_construction());
    facts[definition] <- make SumValueResult { value_type <- type };
    if (first == no_node()) { (first <- definition):void };
    return true
}

export func prepare_constructor_cases(source:const SourceBytes in S, nodes:const ExprNodes in N,
    names:const NameBindings in B, selected:const SelectedExports in E, work:NameWork in W,
    spellings:const SourceBytes in G, spelling_used:UInt64, interfaces:const ModuleInterfaces in G,
    published:UInt64, aggregate:const AggregateFacts in A, facts:ConstructorCaseFacts in F, views:const SuppliedViews in V,
    used:UInt64, revision:UInt64, first:UInt64 in P, report:DeclaredExpressionResult in R) -> bool
    where {const owner S, const owner N, const owner B, const owner E, owner W,
           const owner G, const owner A, owner F, const owner V, owner P, owner R} {
    if (intrinsic (len)(facts) == 0u64) return true;
    if (used > intrinsic (len)(facts)) return case_problem(report, no_node(), unproved_sum_subject());
    ref callable = make CallableSites { signature <- no_node(); body <- no_node(); function_form <- false };
    val mode <- ModuleCallable;
    for (at in 0u64 .. used) {
        mode <- inspect_callable(nodes, revision, used, at, callable);
        if (mode == ModuleCallable &&
            !prepare_sum_value_result(nodes, names, selected, work, interfaces, published, aggregate, facts,
                callable, at, used, revision, first, report)) return false;
        if (mode == ModuleCallable || mode == LexicalCallable) {
            prepare_case_loan_formals(nodes, names, selected, interfaces, published, aggregate, work,
                facts, prepared_writable_product_formal(views, at),
                at, callable.signature, used, revision, first);
            if (work[at].sum_loan_formals && first == no_node()) { (first <- at):void }
        }
    };
    ref local = make LocalBindingSites {
        binding <- no_node(); initializer <- no_node(); mode <- ValueLocal; declaration_const <- false;
    };
    ref assignment = make AssignmentSites { destination <- no_node(); input <- no_node(); operator_at <- no_node() };
    ref construction = make ConstructionSites {
        requested <- no_node(); queried_operand <- no_node(); placement <- no_node();
        initializer <- no_node(); contents <- no_node()
    };
    ref field = make FieldSelectionSites { receiver <- no_node(); field <- no_node() };
    ref indexed = make IndexSites { target <- no_node(); index <- no_node() };
    val transfer <- PlaceTransfer;
    ref element = make DeclaredType { kind <- record_type(); defining_module <- 0u64; identity <- no_node() };
    val sum <- false;
    ref returned = make UInt64 { no_node() };
    val scope <- no_node();
    for (at in 0u64 .. used) {
        if (completion_syntax(nodes, at) == ReturnCompletion &&
            completion_operand(nodes, revision, used, at, returned) && returned < at) {
            scope <- names[at].scope;
            if (scope < used) {
                case facts[scope] of {
                    SumValueResult { val type <- value_type; } -> {
                        if (inspect_construction(nodes, revision, at, returned, construction) == BracedConstruction &&
                            !prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
                                returned, at, type, used, revision, report)) return false
                    };
                    _ -> {}
                }
            }
        };
        case views[at] of {
            PreparedArrayConstruction {
                val fill <-; val kind <- element; val module <- element_module; val identity <- element_identity;
            } -> {
                sum <- kind == SumArrayElement && module != 0u64;
                if (kind == ProductArrayElement || sum) {
                    element.kind <- if (sum) { sum_type() } else { record_type() };
                    element.defining_module <- module;
                    element.identity <- identity;
                    if (!prepare_bits_construction(nodes, names, selected, work, interfaces, published, facts,
                        fill, at, element, used, revision, report)) return false;
                    if (first == no_node()) { (first <- at):void }
                }
            };
            _ -> {}
        };
        if (!prepare_sum_case(source, nodes, names, selected, work, spellings, spelling_used,
            interfaces, published, aggregate, facts, at, used, revision, report)) return false;
        if (work[at].case_schema_prepared && first == no_node()) { (first <- at):void };
        if (inspect_local_binding(nodes, revision, used, at, local) && local.initializer < at) {
            if (local.mode == ReferenceLocal) {
                if (work[local.initializer].inline_sum_initializer) {
                    if (!prepare_lexical_sum_reference(nodes, names, selected, work, interfaces, published,
                        aggregate, facts, at, local, used, revision, report)) return false;
                    if (first == no_node()) { (first <- at):void }
                } else {
                    if (!prepare_lexical_bits_array(nodes, names, views, facts, at, local, used, revision) &&
                        !prepare_lexical_product_reference(nodes, names, selected, work, interfaces, published,
                        aggregate, facts, at, local, used, revision, report)) return false;
                    if (first == no_node() &&
                        (case facts[at] of { LexicalProductReference -> true; _ -> false })) { (first <- at):void }
                }
            } else {
                if (first == no_node() &&
                    fixed_indexed_field_initializer(nodes, local, at, used, revision)) { (first <- at):void }
            }
        };
        transfer <- inspect_assignment(nodes, revision, used, at, assignment);
        if (transfer == PlaceTransfer && names[at].kind == 0u8 &&
            indexed_field_destination(nodes, at, revision, assignment.destination, field, indexed)) {
            facts[assignment.destination] <- make IndexedFieldDestination {};
            if (first == no_node()) { (first <- at):void }
        };
        if (transfer == PlaceTransfer &&
            prepare_indexed_local_product_copy(nodes, names, selected, interfaces, published, aggregate,
                facts, at, assignment, used, revision)) {
            if (first == no_node()) { (first <- at):void }
        };
        if (transfer == PlaceTransfer && indexed_braced_transfer(nodes, at, revision, assignment, construction)) {
            if (names[construction.requested].kind == constructor_type() &&
                names[construction.requested].declaration != no_node() &&
                !work[assignment.input].repeated_indexed_initializer) {
                if (!prepare_local_sum_write(nodes, names, work, aggregate, facts, at, assignment.input,
                    construction.requested, used, revision, report)) return false;
                if (first == no_node()) { (first <- at):void }
            } else {
                if (names[construction.requested].kind == record_type() ||
                    names[construction.requested].kind == constructor_type() ||
                    names[construction.requested].kind == ordinary_selection()) {
                    if (!prepare_indexed_bits_write(nodes, names, selected, work, interfaces, published,
                        aggregate, facts, at, assignment, construction, used, revision, report)) return false;
                    if (first == no_node() &&
                        (case facts[assignment.input] of { BitsConstruction -> true; _ -> false })) {
                        (first <- at):void
                    }
                }
            }
        }
    };
    if (!prepare_aggregate_loan_arguments(nodes, names, selected, work, interfaces, published,
        aggregate, facts, first, used, revision, report)) return false;
    val site <- no_node();
    val receiver <- no_node();
    for (offset in 0u64 .. used) {
        site <- used - 1u64 - offset;
        # Carry a builtin indexed write through its enclosing inline projections.
        if ((case facts[site] of { IndexedFieldDestination -> true; _ -> false }) &&
            inspect_field_selection(nodes, revision, used, site, field)) {
            receiver <- field.receiver;
            if (receiver < site && inspect_field_selection(nodes, revision, used, receiver, field)) {
                (facts[receiver] <- make IndexedFieldDestination {}):void
            }
        };
        if (inspect_assignment(nodes, revision, used, site, assignment) == PlaceRebind &&
            assignment.input < site && work[assignment.input].inline_sum_initializer &&
            !prepare_lexical_sum_rebind(nodes, names, selected, work, interfaces, published, facts,
                site, assignment, used, revision, report)) return false;
        case facts[site] of {
            BitsConstruction {
                val fields <- schema; val type <- value_type; val begin <- first_initializer; val end <- last_initializer;
            } -> {
                if (!prepare_bits_initializers(source, nodes, names, selected, work, spellings, spelling_used,
                    interfaces, published, aggregate, facts, site, fields, type, begin, end, used, revision, report)) return false
            };
            _ -> {
                if (work[site].inline_sum_initializer) return case_problem(report, site, unsupported_bits_construction())
            }
        }
    };
    return prepare_received_fields(source, nodes, names, selected, work,
        spellings, spelling_used, interfaces, published, aggregate, facts, used, revision, first, report)
}
