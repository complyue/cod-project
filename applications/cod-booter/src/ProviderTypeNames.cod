using "string.cod" emit;
using "./SourceStorage.cod" SourceBytes;
using "./ModuleIndex.cod" { Visits, CanonicalKeyRange, checked_module_key };
using "./ModuleExportStorage.cod" { ModuleInterfaces, enum_type, find_interface };
using "./NameResolution.cod" { c_handle_type, c_constructor };
using "./ProviderNames.cod" { emit_provider_identifier, emit_provider_enum_name };
using "./ProviderViews.cod" emit_provider_scalar_type;
using "./ParserStorage.cod" no_node;

export data ProviderPrefixes {
    modules:UInt64,
    keys:UInt64,
    spellings:UInt64,
    interfaces:UInt64,
}

export proc emit_provider_interface_name(spellings:const SourceBytes in G, spelling_used:UInt64,
                                         rows:const ModuleInterfaces in G, head:UInt64)
    -> bool where {const owner G} {
    if (spelling_used > intrinsic (len)(spellings) || head >= intrinsic (len)(rows) ||
        rows[head].name_past > spelling_used) return false;
    return emit_provider_identifier(spellings, rows[head].name_first, rows[head].name_past);
}

export func find_provider_handle(rows:const ModuleInterfaces in G, used:UInt64, module:UInt64, identity:UInt64)
    -> UInt64 where {const owner G} {
    val head <- find_interface(rows, used, module, identity);
    if (head == no_node()) return head;
    if (rows[head].interface_kind != c_handle_type() && rows[head].interface_kind != c_constructor()) return no_node();
    return head;
}

export func first_prior_handle_with_role(rows:const ModuleInterfaces in G, first:UInt64, input:UInt64)
    -> UInt64 where {const owner G} {
    for (prior in first .. input) {
        if (rows[prior].value_kind == c_handle_type() && rows[prior].owner_role == rows[input].owner_role) return prior;
    };
    return no_node();
}

export proc emit_provider_handle_type(spellings:const SourceBytes in G, spelling_used:UInt64,
                                      rows:const ModuleInterfaces in G, head:UInt64) -> bool where {const owner G} {
    emit("cod_native_");
    if (!emit_provider_interface_name(spellings, spelling_used, rows, head)) return false;
    emit("_borrow");
    return true;
}

export proc emit_checked_provider_enum_name(visits:const Visits in G, keys:const SourceBytes in G,
                                            spellings:const SourceBytes in G, rows:const ModuleInterfaces in G,
                                            prefix:const ProviderPrefixes in R, head:UInt64)
    -> bool where {const owner G, const owner R} {
    if (prefix.interfaces > intrinsic (len)(rows) || head >= prefix.interfaces ||
        rows[head].interface_kind != enum_type() || rows[head].entry_count >= prefix.interfaces - head ||
        prefix.spellings > intrinsic (len)(spellings) || rows[head].name_past > prefix.spellings ||
        prefix.keys > intrinsic (len)(keys)) return false;
    ref entry = make CanonicalKeyRange { first <- 0u64; past <- 0u64; };
    ref origin = make CanonicalKeyRange { first <- 0u64; past <- 0u64; };
    if (!checked_module_key(visits, prefix.modules, prefix.keys, 1u64, entry) ||
        !checked_module_key(visits, prefix.modules, prefix.keys, rows[head].defining_module, origin))
        return false;
    return emit_provider_enum_name(keys, entry.first, entry.past, origin.first, origin.past,
                                   spellings, rows[head].name_first, rows[head].name_past);
}

export proc emit_provider_bits_type(visits:const Visits in G, keys:const SourceBytes in G,
                                    spellings:const SourceBytes in G, rows:const ModuleInterfaces in G,
                                    prefix:const ProviderPrefixes in R, kind:UInt8, module:UInt64, identity:UInt64)
    -> bool where {const owner G, const owner R} {
    if (kind != enum_type()) return emit_provider_scalar_type(kind);
    val head <- find_interface(rows, prefix.interfaces, module, identity);
    if (head == no_node()) return false;
    return emit_checked_provider_enum_name(visits, keys, spellings, rows, prefix, head);
}
