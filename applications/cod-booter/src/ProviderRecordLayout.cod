using "./ParserStorage.cod" no_node;

export data ABIRecordLayout {
    size:UInt64;
    alignment:UInt64;
}

func aligned_offset(value:UInt64, alignment:UInt64) -> UInt64 {
    if (alignment == 0u64 || value == no_node()) return no_node();
    val used <- value % alignment;
    val padding <- if (used == 0u64) { 0u64 } else { alignment - used };
    if (padding >= no_node() - value) return no_node();
    return value + padding;
}

export func append_layout_field(layout:ABIRecordLayout in L, width:UInt64, alignment:UInt64) -> UInt64
    where {owner L} {
    val offset <- aligned_offset(layout.size, alignment);
    if (offset == no_node() || width >= no_node() - offset) return no_node();
    layout.size <- offset + width;
    if (alignment > layout.alignment) { (layout.alignment <- alignment):void; };
    return offset;
}

export func finish_layout(layout:const ABIRecordLayout in L) -> UInt64 where {const owner L} {
    return aligned_offset(layout.size, layout.alignment);
}
