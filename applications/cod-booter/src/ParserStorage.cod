func ptr_parameter_node() -> u8 { return 34u8; }
func val_parameter_node() -> u8 { return 35u8; }
func owned_type_node() -> u8 { return 36u8; }
func result_clause_node() -> u8 { return 37u8; }
func throws_clause_node() -> u8 { return 38u8; }
