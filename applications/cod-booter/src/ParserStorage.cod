using "SourceStorage.cod" Token;

array Tokens[u64]:Token;

data ExprNode {
    kind:u8;
    first:u64;
    past:u64;
    number:u64;
    left:u64;
    right:u64;
    operation_at:u64;
}
array ExprNodes[u64]:ExprNode;

func literal_node() -> u8 { return 1u8; }
func add_node() -> u8 { return 2u8; }
func multiply_node() -> u8 { return 3u8; }
func group_node() -> u8 { return 4u8; }
func name_node() -> u8 { return 5u8; }
func call_node() -> u8 { return 6u8; }
func argument_node() -> u8 { return 7u8; }
func deferred_call_node() -> u8 { return 8u8; }
func block_node() -> u8 { return 9u8; }
func full_scope_node() -> u8 { return 10u8; }
func block_item_node() -> u8 { return 11u8; }
func try_node() -> u8 { return 12u8; }
func catch_clause_node() -> u8 { return 13u8; }
func catch_handler_node() -> u8 { return 14u8; }
func catch_binding_node() -> u8 { return 15u8; }
func finally_clause_node() -> u8 { return 16u8; }
func symbol_node() -> u8 { return 17u8; }
func behave_node() -> u8 { return 18u8; }
func throw_node() -> u8 { return 19u8; }

func no_node() -> u64 { return 18446744073709551615u64; }

func len(tokens:const Tokens in T) -> u64 where {const owner T} {
    return intrinsic (len)(tokens);
}

func len(nodes:const ExprNodes in N) -> u64 where {const owner N} {
    return intrinsic (len)(nodes);
}

export Tokens;
export ExprNode;
export ExprNodes;
export len;
export literal_node;
export add_node;
export multiply_node;
export group_node;
export name_node;
export call_node;
export argument_node;
export deferred_call_node;
export block_node;
export full_scope_node;
export block_item_node;
export try_node;
export catch_clause_node;
export catch_handler_node;
export catch_binding_node;
export finally_clause_node;
export symbol_node;
export behave_node;
export throw_node;
export no_node;
