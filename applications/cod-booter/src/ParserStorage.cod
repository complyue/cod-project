using "SourceStorage.cod" Token;

export array Tokens[u64]:Token;

export data ExprNode {
    kind:u8;
    first:u64;
    past:u64;
    number:u64;
    left:u64;
    right:u64;
    operation_at:u64;
}
export array ExprNodes[u64]:ExprNode;

export func literal_node() -> u8 { return 1u8; }
export func add_node() -> u8 { return 2u8; }
export func multiply_node() -> u8 { return 3u8; }
export func group_node() -> u8 { return 4u8; }
export func name_node() -> u8 { return 5u8; }
export func call_node() -> u8 { return 6u8; }
export func argument_node() -> u8 { return 7u8; }
export func checked_ref_argument(nodes:const ExprNodes in N, argument:u64) -> bool where {const owner N} {
    return nodes[argument].kind == argument_node() && nodes[argument].number != 0u64;
}
export func deferred_call_node() -> u8 { return 8u8; }
export func block_node() -> u8 { return 9u8; }
export func full_scope_node() -> u8 { return 10u8; }
export func block_item_node() -> u8 { return 11u8; }
export func try_node() -> u8 { return 12u8; }
export func catch_clause_node() -> u8 { return 13u8; }
export func catch_handler_node() -> u8 { return 14u8; }
export func catch_binding_node() -> u8 { return 15u8; }
export func finally_clause_node() -> u8 { return 16u8; }
export func symbol_node() -> u8 { return 17u8; }
export func behave_node() -> u8 { return 18u8; }
export func throw_node() -> u8 { return 19u8; }
export func transfer_node() -> u8 { return 20u8; }
export func typed_name_node() -> u8 { return 21u8; }
export func val_binding_node() -> u8 { return 22u8; }
export func ptr_binding_node() -> u8 { return 23u8; }
export func null_node() -> u8 { return 24u8; }
export func return_node() -> u8 { return 25u8; }
export func module_node() -> u8 { return 26u8; }
export func module_item_node() -> u8 { return 27u8; }
export func using_node() -> u8 { return 28u8; }
export func module_path_node() -> u8 { return 29u8; }
export func callable_node() -> u8 { return 30u8; }
export func callable_head_node() -> u8 { return 31u8; }
export func parameter_node() -> u8 { return 32u8; }
export func ref_parameter_node() -> u8 { return 33u8; }
export func ptr_parameter_node() -> u8 { return 34u8; }
export func val_parameter_node() -> u8 { return 35u8; }
export func owned_type_node() -> u8 { return 36u8; }
export func result_clause_node() -> u8 { return 37u8; }
export func throws_clause_node() -> u8 { return 38u8; }
export func owner_clause_node() -> u8 { return 39u8; }
export func deferred_block_node() -> u8 { return 40u8; }
export func discard_node() -> u8 { return 41u8; }
export func bool_node() -> u8 { return 42u8; }
export func compare_node() -> u8 { return 43u8; }
export func conditional_node() -> u8 { return 44u8; }
export func logical_not_node() -> u8 { return 45u8; }
export func logical_and_node() -> u8 { return 46u8; }
export func logical_or_node() -> u8 { return 47u8; }
export func subtract_node() -> u8 { return 48u8; }
export func divide_node() -> u8 { return 49u8; }
export func remainder_node() -> u8 { return 50u8; }
export func c_handle_type_node() -> u8 { return 51u8; }
export func c_procedure_node() -> u8 { return 52u8; }
export func handle_parameter_node() -> u8 { return 53u8; }
export func here_parameter_node() -> u8 { return 54u8; }
export func data_record_node() -> u8 { return 55u8; }
export func c_record_node() -> u8 { return 56u8; }
export func data_parent_node() -> u8 { return 57u8; }
export func export_node() -> u8 { return 58u8; }
export func array_declaration_node() -> u8 { return 59u8; }
export func array_shape_node() -> u8 { return 60u8; }

export func exception_local_node() -> u8 { return 61u8; }
export func exception_parameter_node() -> u8 { return 62u8; }
export func exception_result_node() -> u8 { return 63u8; }
export func ref_local_node() -> u8 { return 64u8; }
export func ref_result_node() -> u8 { return 65u8; }
export func make_exception_node() -> u8 { return 66u8; }
export func make_named_node() -> u8 { return 67u8; }
export func construction_payload_node() -> u8 { return 68u8; }
export func field_initializer_node() -> u8 { return 69u8; }
export func capacity_placement_node() -> u8 { return 70u8; }
export func cause_placement_node() -> u8 { return 71u8; }
export func named_argument_node() -> u8 { return 72u8; }

export func field_access_node() -> u8 { return 73u8; }
export func bodyless_defer_node() -> u8 { return 75u8; }

export func callable_local_node() -> u8 { return 76u8; }
export func throw_with_cause_node() -> u8 { return 77u8; }
export func throw_named_node() -> u8 { return 78u8; }
export func rethrow_from_node() -> u8 { return 79u8; }
export func construction_type_query_node() -> u8 { return 80u8; }
export func initializer_assignment_node() -> u8 { return 81u8; }
export func range_node() -> u8 { return 82u8; }
export func range_header_node() -> u8 { return 83u8; }
export func owning_handle_local_node() -> u8 { return 84u8; }
export func borrowed_handle_local_node() -> u8 { return 85u8; }
export func make_own_handle_node() -> u8 { return 86u8; }
export func make_borrowed_handle_node() -> u8 { return 87u8; }
export func here_call_node() -> u8 { return 88u8; }
export func here_body_node() -> u8 { return 89u8; }
export func here_receiver_node() -> u8 { return 90u8; }
export func continue_node() -> u8 { return 91u8; }
export func break_node() -> u8 { return 92u8; }
export func narrow_integer_node() -> u8 { return 93u8; }
export func index_access_node() -> u8 { return 94u8; }
export func array_length_node() -> u8 { return 95u8; }
export func export_from_node() -> u8 { return 96u8; }
export func enum_declaration_node() -> u8 { return 97u8; }
export func enum_member_node() -> u8 { return 98u8; }
export func enum_integer_node() -> u8 { return 99u8; }
export func import_node() -> u8 { return 100u8; }
export func member_selector_node() -> u8 { return 101u8; }
export func member_selection_item_node() -> u8 { return 102u8; }
export func type_assertion_node() -> u8 { return 103u8; }

# A case links the subject and a block-item list. An arm links an optional
# pattern, the body and an optional guard. A catch-all has no pattern node.
export func case_node() -> u8 { return 104u8; }
export func case_arm_node() -> u8 { return 105u8; }
export func case_fallthrough_node() -> u8 { return 106u8; }
export func case_failure_node() -> u8 { return 107u8; }
export func case_pattern_node() -> u8 { return 108u8; }
export func native_symbol_declaration_node() -> u8 { return 109u8; }
export func effect_node() -> u8 { return 110u8; }
export func text_literal_node() -> u8 { return 111u8; }
export func reference_symbol_declaration_node() -> u8 { return 112u8; }
export func abstract_type_node() -> u8 { return 113u8; }
export func bind_effect() -> u64 { return 1u64; }
export func case_member_pattern() -> u64 { return 0u64; }
export func case_false_pattern() -> u64 { return 1u64; }
export func case_true_pattern() -> u64 { return 2u64; }
export func case_null_pattern() -> u64 { return 3u64; }

export func local_module_selection(kind:u8) -> bool {
    return kind == using_node() || kind == import_node();
}
export func module_selection(kind:u8) -> bool {
    return local_module_selection(kind) || kind == export_from_node();
}

export func selected_resource_name(nodes:const ExprNodes in N, site:u64) -> u64 where {const owner N} {
    val selection <- nodes[site].right;
    if (nodes[selection].kind == member_selector_node()) return nodes[selection].left;
    return selection;
}

export func local_resource_name(nodes:const ExprNodes in N, site:u64) -> u64 where {const owner N} {
    if (nodes[site].number != 0u64) return nodes[site].number - 1u64;
    return selected_resource_name(nodes, site);
}

export func local_storage_binding(kind:u8) -> bool {
    return kind == val_binding_node() || kind == ref_local_node() || kind == ptr_binding_node();
}

export func handle_local(kind:u8) -> bool {
    return kind == owning_handle_local_node() || kind == borrowed_handle_local_node();
}

export func handle_construction(kind:u8) -> bool {
    return kind == make_own_handle_node() || kind == make_borrowed_handle_node();
}

export func literal_range(nodes:const ExprNodes in N, header:u64) -> bool where {const owner N} {
    return nodes[nodes[header].left].kind == literal_node() && nodes[nodes[header].right].kind == literal_node();
}

export func nonempty_literal_range(nodes:const ExprNodes in N, header:u64) -> bool where {const owner N} {
    return nodes[nodes[header].left].number < nodes[nodes[header].right].number;
}

export func integer_arithmetic(kind:u8) -> bool {
    return kind == add_node() || kind == subtract_node() || kind == multiply_node() ||
        kind == divide_node() || kind == remainder_node();
}

export func logical_binary(kind:u8) -> bool {
    return kind == logical_and_node() || kind == logical_or_node();
}

export func is_transfer(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    val kind <- nodes[at].kind;
    return kind == transfer_node() || (kind == initializer_assignment_node() && nodes[at].number == 0u64);
}

export func construction_body(nodes:const ExprNodes in N, at:u64) -> u64 where {const owner N} {
    val payload <- nodes[at].right;
    if (nodes[payload].number == 2u64) return nodes[payload].left;
    return no_node();
}

export func positional_construction(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    return nodes[nodes[at].right].number == 1u64;
}

export func reserves_storage(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    return nodes[at].kind == make_named_node() && nodes[nodes[at].right].number == 0u64;
}

export func skips_right(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    val left <- nodes[at].left;
    if (nodes[left].kind != bool_node()) return false;
    return (nodes[left].number == 0u64) == (nodes[at].kind == logical_and_node());
}

export func equal_words() -> u64 { return 0u64; }
export func unequal_words() -> u64 { return 1u64; }
export func less_words() -> u64 { return 2u64; }
export func at_most_words() -> u64 { return 3u64; }
export func greater_words() -> u64 { return 4u64; }
export func at_least_words() -> u64 { return 5u64; }

export func discarded_guard_result() -> u64 { return 1u64; }
export func procedure_definition() -> u64 { return 0u64; }
export func function_definition() -> u64 { return 1u64; }
export func readonly_declaration() -> u64 { return 1u64; }
export func retained_parent_parameter() -> u64 { return 1u64; }
export func no_node() -> u64 { return 18446744073709551615u64; }

export func ungrouped(nodes:const ExprNodes in N, at:u64) -> u64 where {const owner N} {
    val value <- at;
    for (unused in 0u64 .. at + 1u64) {
        if (nodes[value].kind != group_node()) return value;
        value <- nodes[value].left;
    };
    return value;
}

export func is_function(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    return at != no_node() && nodes[at].kind == callable_node() && nodes[at].number == function_definition();
}

export func len(tokens:const Tokens in T) -> u64 where {const owner T} {
    return intrinsic (len)(tokens);
}

func len(nodes:const ExprNodes in N) -> u64 where {const owner N} {
    return intrinsic (len)(nodes);
}
