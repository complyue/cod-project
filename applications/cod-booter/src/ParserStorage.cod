func throw_node() -> u8 { return 19u8; }
func transfer_node() -> u8 { return 20u8; }
func typed_name_node() -> u8 { return 21u8; }
func val_binding_node() -> u8 { return 22u8; }
func ptr_binding_node() -> u8 { return 23u8; }
func null_node() -> u8 { return 24u8; }
func return_node() -> u8 { return 25u8; }
