using "SourceStorage.cod" Token;

array Tokens[u64]:Token;

data ExprNode {
    kind:u8;
    first:u64;
    past:u64;
    number:u64;
    left:u64;
    right:u64;
    operation_at:u64;
}
array ExprNodes[u64]:ExprNode;

func literal_node() -> u8 { return 1u8; }
func add_node() -> u8 { return 2u8; }
func multiply_node() -> u8 { return 3u8; }
func group_node() -> u8 { return 4u8; }
func name_node() -> u8 { return 5u8; }
func call_node() -> u8 { return 6u8; }
func argument_node() -> u8 { return 7u8; }
func deferred_call_node() -> u8 { return 8u8; }
func block_node() -> u8 { return 9u8; }
func full_scope_node() -> u8 { return 10u8; }
func block_item_node() -> u8 { return 11u8; }
func try_node() -> u8 { return 12u8; }
func catch_clause_node() -> u8 { return 13u8; }
func catch_handler_node() -> u8 { return 14u8; }
func catch_binding_node() -> u8 { return 15u8; }
func finally_clause_node() -> u8 { return 16u8; }
func symbol_node() -> u8 { return 17u8; }
func behave_node() -> u8 { return 18u8; }
func throw_node() -> u8 { return 19u8; }
func transfer_node() -> u8 { return 20u8; }
func typed_name_node() -> u8 { return 21u8; }
func val_binding_node() -> u8 { return 22u8; }
func ptr_binding_node() -> u8 { return 23u8; }
func null_node() -> u8 { return 24u8; }
func return_node() -> u8 { return 25u8; }
func module_node() -> u8 { return 26u8; }
func module_item_node() -> u8 { return 27u8; }
func using_node() -> u8 { return 28u8; }
func module_path_node() -> u8 { return 29u8; }
func callable_node() -> u8 { return 30u8; }
func callable_head_node() -> u8 { return 31u8; }
func parameter_node() -> u8 { return 32u8; }
func ref_parameter_node() -> u8 { return 33u8; }
func ptr_parameter_node() -> u8 { return 34u8; }
func val_parameter_node() -> u8 { return 35u8; }
func owned_type_node() -> u8 { return 36u8; }
func result_clause_node() -> u8 { return 37u8; }
func throws_clause_node() -> u8 { return 38u8; }
func owner_clause_node() -> u8 { return 39u8; }
func deferred_block_node() -> u8 { return 40u8; }
func discard_node() -> u8 { return 41u8; }
func bool_node() -> u8 { return 42u8; }
func compare_node() -> u8 { return 43u8; }
func conditional_node() -> u8 { return 44u8; }
func logical_not_node() -> u8 { return 45u8; }
func logical_and_node() -> u8 { return 46u8; }
func logical_or_node() -> u8 { return 47u8; }
func subtract_node() -> u8 { return 48u8; }
func divide_node() -> u8 { return 49u8; }
func remainder_node() -> u8 { return 50u8; }
func c_handle_type_node() -> u8 { return 51u8; }
func c_procedure_node() -> u8 { return 52u8; }
func handle_parameter_node() -> u8 { return 53u8; }
func here_parameter_node() -> u8 { return 54u8; }
func data_record_node() -> u8 { return 55u8; }
func c_record_node() -> u8 { return 56u8; }
func data_parent_node() -> u8 { return 57u8; }
func export_node() -> u8 { return 58u8; }
func array_declaration_node() -> u8 { return 59u8; }
func array_shape_node() -> u8 { return 60u8; }

func exception_local_node() -> u8 { return 61u8; }
func exception_parameter_node() -> u8 { return 62u8; }
func exception_result_node() -> u8 { return 63u8; }
func ref_local_node() -> u8 { return 64u8; }
func ref_result_node() -> u8 { return 65u8; }
func make_exception_node() -> u8 { return 66u8; }
func make_named_node() -> u8 { return 67u8; }
func construction_payload_node() -> u8 { return 68u8; }
func field_initializer_node() -> u8 { return 69u8; }
func capacity_placement_node() -> u8 { return 70u8; }
func cause_placement_node() -> u8 { return 71u8; }
func named_argument_node() -> u8 { return 72u8; }

func field_access_node() -> u8 { return 73u8; }
func readonly_ref_parameter_node() -> u8 { return 74u8; }
func bodyless_defer_node() -> u8 { return 75u8; }

func integer_arithmetic(kind:u8) -> bool {
    return kind == add_node() || kind == subtract_node() || kind == multiply_node() ||
        kind == divide_node() || kind == remainder_node();
}

func logical_binary(kind:u8) -> bool {
    return kind == logical_and_node() || kind == logical_or_node();
}

func skips_right(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    val left <- nodes[at].left;
    if (nodes[left].kind != bool_node()) { return false; } else {};
    return (nodes[left].number == 0u64) == (nodes[at].kind == logical_and_node());
}

func equal_words() -> u64 { return 0u64; }
func unequal_words() -> u64 { return 1u64; }
func less_words() -> u64 { return 2u64; }
func at_most_words() -> u64 { return 3u64; }
func greater_words() -> u64 { return 4u64; }
func at_least_words() -> u64 { return 5u64; }

func discarded_guard_result() -> u64 { return 1u64; }
func procedure_definition() -> u64 { return 0u64; }
func function_definition() -> u64 { return 1u64; }
func readonly_declaration() -> u64 { return 1u64; }
func no_node() -> u64 { return 18446744073709551615u64; }

func is_function(nodes:const ExprNodes in N, at:u64) -> bool where {const owner N} {
    return at != no_node() && nodes[at].kind == callable_node() && nodes[at].number == function_definition();
}

func len(tokens:const Tokens in T) -> u64 where {const owner T} {
    return intrinsic (len)(tokens);
}

func len(nodes:const ExprNodes in N) -> u64 where {const owner N} {
    return intrinsic (len)(nodes);
}

