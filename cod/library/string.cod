using "std:text-storage" {
    Utf8BuilderStorage, append_utf8 as append_piece, result_in_scope,
    utf8_size, utf8_byte, utf8_slice,
};
using "std:exceptions" Error;

export type Utf8StreamOut;
export data Utf8WriteError <: Error { code:u64; }
export ref symbol @sout:Utf8StreamOut in O where {owner O};

export data StringBuilder <: Utf8StreamOut { storage:Utf8BuilderStorage; }

export func (++)(left:const String in A, right:const String in B) -> ref StringBuilder in D
    where {const owner A, const owner B, owner D} {
    return result_in_scope(make StringBuilder(left, right) in D);
}

func (++)(left:const StringBuilder in A, right:const String in B) -> ref StringBuilder in D
    where {const owner A, const owner B, owner D} {
    return result_in_scope(make StringBuilder(left, right) in D);
}

func (++)(left:const String in A, right:const StringBuilder in B) -> ref StringBuilder in D
    where {const owner A, const owner B, owner D} {
    return result_in_scope(make StringBuilder(left, right) in D);
}

func (++)(left:const StringBuilder in A, right:const StringBuilder in B) -> ref StringBuilder in D
    where {const owner A, const owner B, owner D} {
    return result_in_scope(make StringBuilder(left, right) in D);
}

export func append(target:StringBuilder in D, piece:const String in S) -> void
    where {owner D, const owner S} {
    append_piece(target, piece);
}

func append(target:StringBuilder in D, piece:const StringBuilder in S) -> void
    where {owner D, const owner S} {
    append_piece(target, piece);
}

export proc writeUtf8(out:StringBuilder in D, piece:const String in S) -> void
    where {owner D, const owner S} {
    append(out, piece);
    return;
}

proc writeUtf8(out:StringBuilder in D, piece:const StringBuilder in S) -> void
    where {owner D, const owner S} {
    append(out, piece);
    return;
}

export proc emit(piece:const String in S) -> void
    where {const owner S} {
    writeUtf8(@sout, piece);
    return;
}

proc emit(piece:const StringBuilder in S) -> void
    where {const owner S} {
    writeUtf8(@sout, piece);
    return;
}

export proc emitStr(value:const String in S) -> void
    where {const owner S} {
    emit(value);
    return;
}

proc emit_digit(digit:u64) -> void {
    emit(utf8_slice("0123456789ABCDEF", digit, digit + 1u64));
    return;
}

proc emitStr(number:u64) -> void {
    if (number >= 10u64) { emitStr(number / 10u64); };
    emit_digit(number % 10u64);
    return;
}

export proc emitRepr(number:u64) -> void {
    emitStr(number);
    return;
}

proc emit_escape(codepoint:u64) -> void {
    if (codepoint == 0u64) { emit("\\0"); return; };
    if (codepoint == 9u64) { emit("\\t"); return; };
    if (codepoint == 10u64) { emit("\\n"); return; };
    if (codepoint == 13u64) { emit("\\r"); return; };
    if (codepoint == 34u64) { emit("\\\""); return; };
    if (codepoint == 92u64) { emit("\\\\"); return; };
    emit("\\u{");
    if (codepoint >= 16u64) { emit_digit(codepoint / 16u64); };
    emit_digit(codepoint % 16u64);
    emit("}");
    return;
}

proc emit_text_span(value:const String in S, first:u64, past:u64) -> void
    where {const owner S} {
    if (first != past) { emit(utf8_slice(value, first, past)); };
    return;
}

proc emitRepr(value:const String in S) -> void
    where {const owner S} {
    emit("\"");
    val first <- 0u64;
    val byte <- 0u8;
    val codepoint <- 0u64;
    val width <- 1u64;
    val escaped <- false;
    val size <- utf8_size(value);
    for (at in 0u64 .. size) {
        if (at >= first) {
            byte <- utf8_byte(value, at);
            if (byte < 128u8 || byte >= 192u8) {
                # Flush at a scalar boundary and release each piece after its write.
                if (at - first >= 4096u64) {
                    emit_text_span(value, first, at);
                    (first <- at):void;
                };
                escaped <- byte < 32u8 || byte == 34u8 || byte == 92u8 || byte == 127u8;
                codepoint <- byte;
                width <- 1u64;
                # The two-byte form for U+0080 through U+009F begins with C2.
                if (byte == 194u8) {
                    byte <- utf8_byte(value, at + 1u64);
                    if (byte < 160u8) {
                        escaped <- true;
                        codepoint <- byte;
                        (width <- 2u64):void;
                    };
                };
                if (escaped) {
                    emit_text_span(value, first, at);
                    emit_escape(codepoint);
                    first <- at + width;
                };
            };
        };
    };
    emit_text_span(value, first, size);
    emit("\"");
    return;
}

export proc str(value:const T in V) -> ref const String in D
    where {T, const owner V, owner D} {
    ref scratch = make StringBuilder();
    {{
        effect @sout = scratch;
        emitStr(value);
    }};
    return result_in_scope(make String(scratch) in D);
}

proc str(number:u64) -> ref const String in D
    where {owner D} {
    ref scratch = make StringBuilder();
    {{
        effect @sout = scratch;
        emitStr(number);
    }};
    return result_in_scope(make String(scratch) in D);
}

export proc repr(value:const T in V) -> ref const String in D
    where {T, const owner V, owner D} {
    ref scratch = make StringBuilder();
    {{
        effect @sout = scratch;
        emitRepr(value);
    }};
    return result_in_scope(make String(scratch) in D);
}

proc repr(number:u64) -> ref const String in D
    where {owner D} {
    ref scratch = make StringBuilder();
    {{
        effect @sout = scratch;
        emitRepr(number);
    }};
    return result_in_scope(make String(scratch) in D);
}
