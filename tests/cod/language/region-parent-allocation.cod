using symbol "std:io" @print;
array Values[u32]:i64;
region symbol @arena;
symbol @values : Values;
symbol @first : Values;
symbol @create : proc() -> Values;
proc @grow(first:Values in O1) -> Values where {owner O1};
procedure @create() -> Values { alloc @arena Values(2u64, 19) }
procedure @grow(first:Values in O1) -> Values where {owner O1} {
  fold (i in 0 .. 4, previous = first) {{ alloc @arena Values(2u64, previous[0u32] + i) }}
}
effect @arena <- region(4096u64);
effect @values = behave @create();
behave @print(@values[1u32]);
effect @first = @values;
effect @values = behave @grow(@values);
behave @print(@values[1u32]);
behave @print(@first[1u32]);
behave @print({
  effect @arena <- region(512u64);
  effect @values = behave @grow(alloc @arena Values(2u64, 99));
  i64(@values[1u32])
});
behave @print(@values[1u32]);
