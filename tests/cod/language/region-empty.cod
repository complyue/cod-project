using symbol "std:io" @print;
using symbol "std:io" @assert;
array Flags[u8]::bool;
symbol @arena :: region;
symbol @empty :: ref<Flags>;
symbol @full :: ref<Flags>;
effect @arena <- region(4096u64);
effect @empty = alloc @arena Flags(0u64, false);
effect @full = alloc @arena Flags(256u64, false);
behave @print(len(@empty));
for (i in 0u8 .. 255u8) { store(@full, i, i % 2u8 == 0u8); };
store(ref_at(@full, 255u8), true);
for (i in 0u8 .. 255u8) { behave @assert(@full[i] == (i % 2u8 == 0u8)); };
behave @print(@full[255u8]);
behave @print(len(@full));
