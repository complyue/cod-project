using symbol "std:io" @print;
symbol from "procedure-vocabulary.cod" @bias;
symbol from "procedure-vocabulary.cod" @dispatch as @selected;
using "procedure-library.cod" read as local_read;
using symbol "procedure-library.cod" @automatic as @remote;
effect @bias <- 20;
effect @selected = local_read;
behave @print(local_read(1));
behave @print(perform @selected(1));
behave @print(behave @selected(1));
behave @print(perform @remote(1));
behave @print(behave @remote(1));
proc @fresh(x:i64) -> i64 { return @bias + x }
proc @selected(x:i64) -> i64 { return @bias * 2 + x }
effect @bias <- 30;
behave @print(perform @fresh(2));
behave @print(behave @fresh(2));
behave @print(perform @selected(2));
behave @print(behave @selected(2));
behave @print(@bias);

proc callback(x:i64) -> i64 { return x + 1 }
proc selected(x:i64) -> i64 { return @bias + x }
proc apply(callback:proc(i64)->i64, x:i64) -> i64 { return callback(x) }
behave @print(apply(selected, 3));
{ proc callback = selected; effect @bias <- 40; behave @print(callback(3)); };
