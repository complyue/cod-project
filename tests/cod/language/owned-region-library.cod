data Node { value::u64; next::ref<Node>; }
data Packet { sequence::u64; head::ref<Node>; }
function fresh(bytes::u64, value::u64)-> owned region ::Packet {
  make Packet(capacity = bytes) { sequence <- value; head <- null }
}
function forward(owned region packet::R)-> owned region ::R where R { packet }
function inspect(region packet::R)::R where R { root(packet) }
function dispose(owned region packet::Packet, unused::u64)::void {}
function fail_inside(owned region packet::Packet, bytes::u64)::void {
  setfield(root(packet), sequence, 99u64);
  owned region unfinished::Packet <- fresh(bytes, 0u64);
  {}
}

export Node;
export Packet;
export fresh;
export forward;
export inspect;
export dispose;
export fail_inside;

function edit_then_fail(region packet::Packet, bytes::u64)::void {
  setfield(root(packet), sequence, 55u64);
  owned region failed::Packet <- fresh(bytes, 0u64);
  {}
}
export edit_then_fail;
