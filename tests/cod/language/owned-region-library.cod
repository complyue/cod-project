data Node { value:u64; ptr next:Node; }
data Packet { sequence:u64; ptr head:Node; }
function fresh(bytes:u64, value:u64)-> own region :Packet {
  return make Packet(capacity = bytes) { sequence <- value; head = null }
}
function forward(own region packet:R)-> own region :R where R { return packet }
function inspect(region packet:R) -> R where R { return root(packet) }
function dispose(own region packet:Packet, unused:u64) -> void {}
function fail_inside(own region packet:Packet, bytes:u64) -> void {
  setfield(root(packet), sequence, 99u64);
  own region unfinished:Packet <- fresh(bytes, 0u64);
  {}
}

export Node;
export Packet;
export fresh;
export forward;
export inspect;
export dispose;
export fail_inside;

function edit_then_fail(region packet:Packet, bytes:u64) -> void {
  setfield(root(packet), sequence, 55u64);
  own region failed:Packet <- fresh(bytes, 0u64);
  {}
}
export edit_then_fail;
