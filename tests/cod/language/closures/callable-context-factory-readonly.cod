using symbol "std:io" @print;
data Item{value:u64;}
region State{value:u64;}
symbol @bias:u64;
proc maker(region r:const State)->(proc()->(proc()->const u64 with {region r}) with {region r}) {
  return proc()->(proc()->const u64 with {region r}) {
    return proc()->const u64 {r.value<-r.value+1u64;return r.value+@bias;};
  };
}
proc step(owned region work:State,
    factory:(proc()->(proc()->const u64 with {region work}) with {region work}),n:u64)->const u64 {
  if(n>0u64){{
    proc current=factory();
    owned region next<-make State(capacity=256u64){value<-current()+1u64};
    return step(next,maker(next),n-1u64);
  }}else{};
  return factory()();
}
proc run()->void {
  effect @bias<-2u64;
  owned region seed<-make State(capacity=256u64){value<-7u64};
  behave @print(step(seed,maker(seed),20u64));
  behave @print(@bias);
}
run();
