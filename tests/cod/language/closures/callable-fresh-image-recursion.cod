using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item{value:u64;}
symbol @bias:u64;
symbol @fail:u64;
symbol @leaf:proc(u64)->const u64;
symbol @step:proc(u64)->const u64;
proc walk(n:u64)->const u64 {
  if(n==0u64){return perform @leaf(0u64);}else{};
  if(n==3u64){if(@fail==1u64){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};}else{};
  {{effect @bias<-n;
    proc seed=if(n%2u64==0u64){proc(n:u64)->const u64{return @bias+n;}}
      else{proc(n:u64)->const u64{return @bias+100u64+n;}};
    effect @leaf=seed;
    proc next=proc(n:u64)->const u64{return walk(n);};
    effect @step=next;
    return perform @step(n-1u64)+perform @leaf(n);
  }}
}
proc run()->void {
  effect @bias<-99u64;
  effect @fail<-0u64;
  proc seed=proc(n:u64)->const u64{return @bias+n;};
  effect @leaf=seed;
  proc first=proc(n:u64)->const u64{return walk(n);};
  effect @step=first;
  behave @print(perform @step(20u64));
  behave @print(@bias);
  effect @bias<-500u64;
  behave @print(perform @leaf(0u64));
  behave @print(behave @leaf(0u64));
  effect @fail<-1u64;
  try {walk(20u64); {}}catch(e:const InvalidCapacity){behave @print(@bias);};
  defer {behave @print(@bias);};
  defer perform @step(4u64);
}
run();
