data Node {value:u64;}
region Arena {count:u64;}
function frozen(node:const Node in r)->const Node in r where {region r:Arena} {return node}
owned region arena:Arena <- make Arena(capacity=256u64){count <- 0u64};
ref node=alloc arena Node(1u64);
func selected=frozen;
ref result=selected(node);
result.value <- 4u64;
