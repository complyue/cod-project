using symbol "std:io" @print;
data Item{value:u64;}
region symbol @arena:Item;
symbol @reader:proc()->const u64;
proc walk(n:u64)->func()->proc()->const u64 {
  if(n!=0u64){
    {{effect @arena<-make Item(capacity=256u64){value<-n};return walk(n-1u64);}}
  }else{};
  proc inner=proc()->const u64 {return @arena.value;};
  return func [inner]()->proc()->const u64 {return inner;};
}
proc run()->void {
  effect @arena<-make Item(capacity=256u64){value<-99u64};
  func factory=walk(20u64);
  proc result=factory();
  effect @reader=result;
  behave @print(perform @reader());
}
run();
