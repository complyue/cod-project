using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Packet {value:u64;}
function fail_before(x:u64 in O)->void where {owner O}{
 owned region invalid:Packet <- make Packet(capacity=0u64){value <- 0u64};
 x <- 3u64;
 {}
}
func failing=fail_before;
ref value=make local u64;
try {failing(value);} catch(e:const InvalidCapacity){behave @print(value);};
