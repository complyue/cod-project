region State { ticks:u64; }
function writable(region state:State)->func()->const u64 with {region state} {
  return func()->const u64 { return state.ticks }
}
function readonly(const region state:State)->func()->const u64 with {region state} {
  return func()->const u64 { return state.ticks }
}
function select(region state:State, choose:bool)->func()->const u64 with {region state} {
  return if (choose) { writable(state) } else { readonly(state) }
}
owned region state:State <- make State(capacity = 128u64) { ticks <- 1u64 };
func selected = select(state, true);
(selected -> state).ticks <- 2u64;
