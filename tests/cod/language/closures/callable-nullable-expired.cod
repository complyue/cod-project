function release(owned region packet)->const u64 { return 0u64 }
function absent(ptr value:u64 in O,side:u64)->const bool where {owner O} { return isnull(value) }
region State { value:u64; }
owned region state:State <- make State(capacity=128u64) { value <- 3u64 };
ptr missing = state.value;
missing = null;
func callback = absent;
val invalid = callback(missing,release(state));
