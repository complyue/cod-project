region State {value:u64;}
proc readonly(region state:const State)->proc()->const u64 with {region state} {
 return proc()->const u64 {return state.value;};
}
proc walk(region state:State,callback:proc()->const u64 with {region state},n:u64)->const u64 {
 region projected=callback->state;
 projected.value<-9u64;
 if(n==0u64){return callback();}else{};
 return walk(state,readonly(state),n-1u64);
}
owned region state:State<-make State(capacity=256u64){value<-1u64};
proc first=proc()->const u64 {return state.value;};
walk(state,first,20u64);
