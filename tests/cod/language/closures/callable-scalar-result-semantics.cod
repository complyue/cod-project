using symbol "std:io" @print;

data Item {value:u64;}

proc borrow_region()->void {
 owned region r:Item<-make Item(capacity=256u64){value<-1u64};
 proc view=proc(v:u64 in o)->u64 where {region o:Item} {return v;};
 ref result=view(root(r).value); result <-2u64; behave @print(root(r).value);
}
borrow_region();

proc borrow_lexical()->void {
 val input<-1u64;
 proc view=proc(v:u64 in o)->u64 where {owner o} {return v;};
 ref result=view(input); result <-2u64; behave @print(input);
}
borrow_lexical();

proc independent()->void {
 val input<-1u64;
 proc view=proc(v:u64 in o)->const u64 where {owner o} {return v+1u64;};
 ref result=view(input); result <-3u64; behave @print(input); behave @print(result);
}
independent();

proc borrow_cleanup()->void {
 val input<-1u64;
 proc view=proc(v:u64 in o)->u64 where {owner o} {defer {v<-2u64;}; return v;};
 ref result=view(input); behave @print(result);
}
borrow_cleanup();

proc select_borrow(flag:bool)->void {
  val a<-1u64;
  val b<-2u64;
  proc first=proc(x:u64 in o,y:u64 in o)->u64 where {owner o} {return x;};
  proc second=proc(x:u64 in o,y:u64 in o)->u64 where {owner o} {return y;};
  proc selected=if(flag){first}else{second};
  ref result=selected(a,b);
  result<-3u64;
  behave @print(a);
  behave @print(b);
}
select_borrow(true);
select_borrow(false);

proc copy_cleanup()->void {
  val input<-1u64;
  proc view=proc(v:u64 in o)->const u64 where {owner o} {defer {v<-2u64;}; return v;};
  ref result=view(input);
  behave @print(input);
  behave @print(result);
}
copy_cleanup();
