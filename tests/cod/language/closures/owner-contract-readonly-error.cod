using "structural-api.cod" Counter;
function reader(region state:const Counter) -> (func()->const u64 with {region state}) {
  return func [state] () -> const u64 { return state.ticks }
}
function mutate(action:(func()->const u64 with {region r})) -> void where {region r:Counter} {
  r.ticks <- 1u64;
  {}
}
owned region state:Counter <- make Counter(capacity = 128u64) { ticks <- 3u64 };
mutate(reader(state));
