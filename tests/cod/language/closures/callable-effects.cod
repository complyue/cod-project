using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
symbol @action:proc(u64)->const u64;
proc first = proc(n:u64)->const u64 { n + 1u64 };
proc second = proc(n:u64)->const u64 { n + 10u64 };
proc current = first;
effect @action = current;
proc change = proc(fail:bool)->void throws NullPointerException {
  @action <- second;
  if (fail) { ptr absent:u64 = null; absent; {} } else {};
};
proc relay(fail:bool)->void throws NullPointerException { change(fail) }
behave @print(current(2u64));
try { relay(false); } catch (e:const NullPointerException) {};
behave @print(current(2u64));
current <- first;
try { relay(true); } catch (e:const NullPointerException) {
  behave @print(current(2u64));
};
for (i in 0u64 .. 3u64) {
  current <- first;
  try { relay(false); } catch (e:const NullPointerException) {};
  behave @print(behave @action(i));
};

# Recursive calls propagate the base case's write to the returning caller.
symbol @recur:proc(u64)->void;
proc descend = proc(n:u64)->void {
  if (n == 0u64) { @action <- second; {} }
  else { behave @recur(n - 1u64); {} }
};
effect @recur = descend;
current <- first;
descend(8u64);
behave @print(current(2u64));

# A definitely overwritten value must not demand its unavailable effect.
symbol @missing:u64;
proc discarded = proc(n:u64)->const u64 { @missing + n };
current <- discarded;
try { relay(false); } catch (e:const NullPointerException) {};
behave @print(current(2u64));

# A call can change which body that same loop site selects on the next lap.
proc advancing = proc(n:u64)->const u64 { @action <- second; n + 1u64 };
current <- advancing;
for (i in 0u64 .. 3u64) { behave @print(current(i)); };

# Function images use the same holder-flow boundary and indirect ABI.
symbol @function:func(u64)->const u64;
func initial = func(n:u64)->const u64 { n + 1u64 };
func updated = func(n:u64)->const u64 { n + 20u64 };
func target = initial;
effect @function = target;
proc update = proc()->void { @function <- updated; {} };
update();
behave @print(target(2u64));
