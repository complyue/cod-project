using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
symbol @bias:u64;
symbol @action:proc(u64)->const u64;
symbol @middle:proc(u64)->const u64;
symbol @last:proc(u64)->const u64;
symbol @checked:proc(u64)->const i64 throws NullPointerException;
symbol @failing:proc()->const i64 throws NullPointerException;
effect @bias <- 3u64;

proc additive() -> proc(u64)->const u64 {
  proc (n:u64) -> const u64 { @bias + n }
}
proc first = additive();
proc second = { effect @bias <- 7u64; additive() };
proc multiplied = { effect @bias <- 7u64; proc (n:u64)->const u64 { @bias * n } };
proc selected = first;
proc copied = selected;
for (i in 0u64 .. 3u64) {{
  effect @bias <- 11u64;
  effect @action = selected;
  behave @print(selected(2u64));
  behave @print(behave @action(2u64));
  behave @print(perform @action(2u64));
  if (i == 0u64) { selected <- second; {} }
  else { selected <- multiplied; {} };
}};
behave @print(@bias);
{ effect @action = copied; behave @print(perform @action(2u64)); };

# Context adapters must retain the parent frame of a nested dynamic call.
proc outer = proc(n:u64)->const u64 { behave @middle(n) };
proc middle = proc(n:u64)->const u64 { behave @last(n) };
proc last = proc(n:u64)->const u64 { @bias + n };
proc failing = proc()->const i64 throws NullPointerException {
  effect @bias <- 100u64;
  ptr absent:i64 = null;
  absent
};
{ effect @middle = middle; effect @last = last; behave @print(outer(2u64)); };
try {
  effect @failing = failing;
  perform @failing();
  {}
} catch (e:const NullPointerException) { behave @print(@bias); };
ptr optional:proc(u64)->const u64 = null;
try { optional(2u64); {} }
catch (e:const NullPointerException) { behave @print(99u64); };
optional = selected;
try { behave @print(optional(2u64)); }
catch (e:const NullPointerException) { behave @print(0u64); };

# A symbolic definition remains reusable when lexical variables copy its value.
{
  proc alternative = proc(x:u64)->const u64 { x + 10u64 };
  effect proc @source(x:u64)->const u64 { x + 1u64 };
  proc left = @source;
  proc right = @source;
  left <- alternative;
  behave @print(left(2u64));
  behave @print(right(3u64));
  behave @print(behave @source(4u64));
};

# Recursive adapters retain current TLS values in each frame, including joins.
{
  proc down = proc(n:u64)->const u64 {
    if (n == 0u64) { @bias }
    else { effect @bias <- @bias + 1u64; behave @action(n - 1u64) + 1u64 }
  };
  proc chosen = down;
  for (i in 0u64 .. 2u64) {{
    effect @action = chosen;
    behave @print(chosen(8u64));
    chosen <- copied;
  }};
  behave @print(@bias);
};
{
  proc even = proc(n:u64)->const u64 {
    if (n == 0u64) { @bias }
    else { effect @bias <- @bias + 1u64; behave @middle(n - 1u64) + 1u64 }
  };
  proc odd = proc(n:u64)->const u64 {
    if (n == 0u64) { @bias }
    else { effect @bias <- @bias + 2u64; behave @last(n - 1u64) + 2u64 }
  };
  effect @middle = odd;
  effect @last = even;
  behave @print(even(8u64));
  behave @print(@bias);
};
{
  proc recursive_failure = proc(depth:u64)->const i64 throws NullPointerException {
    if (depth == 0u64) { ptr absent:i64 = null; absent }
    else { effect @bias <- @bias + 1u64; behave @checked(depth - 1u64) }
  };
  effect @checked = recursive_failure;
  try { recursive_failure(8u64); {} }
  catch (e:const NullPointerException) { behave @print(@bias); };
};
{
  proc copying = proc(depth:u64)->const u64 {
    proc local_copy = @action;
    effect @action = local_copy;
    if (depth == 0u64) { 1u64 } else { behave @action(depth - 1u64) + 1u64 }
  };
  effect @action = copying;
  behave @print(copying(8u64));
  proc after = @action;
  behave @print(after(0u64));
};
{
  proc one = first;
  proc two = multiplied;
  ptr alias:proc(u64)->const u64 = one;
  effect @action = alias;
  alias = two;
  behave @print(behave @action(2u64));
  one <- multiplied;
  behave @print(behave @action(2u64));
};
