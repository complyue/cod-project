using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
symbol @action:proc(u64)->const u64;
proc replacement = proc(n:u64)->const u64 { n + 10u64 };
proc active = proc(n:u64)->const u64 {
  @action <- replacement;
  proc copy = replacement;
  copy(n) + 100u64
};
proc current = active;
effect @action = current;
behave @print(current(2u64));

# A descendant may replace its caller's holder while the caller still uses captures.
proc change = proc()->const u64 { @action <- replacement; 2u64 };
proc ancestor = proc(n:u64)->const u64 {
  change();
  proc copy = replacement;
  copy(n) + 200u64
};
current <- ancestor;
behave @print(current(2u64));

# Selection precedes arguments, including replacement hidden behind a native call.
proc steady = proc(n:u64)->const u64 {
  proc copy = replacement;
  copy(n) + 300u64
};
current <- steady;
behave @print(current(change()));

# An exceptional exit also releases the invocation's retained environment.
proc failing = proc()->void throws NullPointerException {
  @action <- replacement;
  proc copy = replacement;
  behave @print(copy(3u64));
  ptr absent:u64 = null;
  absent;
  {}
};
try { failing(); } catch (e:const NullPointerException) { behave @print(42); };

behave @print(fold (i in 0u64 .. 64u64, total = 0u64) {
  current <- active;
  total + current(i)
});
