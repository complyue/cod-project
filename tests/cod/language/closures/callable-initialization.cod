using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Packet {value:u64;}
function initialize(x:u64 in O)->void where {owner O}{x <- 7u64;{}}
function alternate(x:u64 in O)->void where {owner O}{x <- 9u64;{}}
func selected=initialize;
for(i in 0u64..2u64){{
 ref value=make local u64;
 selected(value);
 behave @print(value);
 selected <- alternate;
}};
function recursive(x:u64 in O,n:u64)->void where {owner O}{
 if(n==0u64){x <- 23u64;{}}else{recursive(x,n-1u64);}
}
func recurse=recursive;
ref deep=make local u64;
recurse(deep,32u64);
behave @print(deep);

# Successive recursive calls reuse the same target without expanding contexts.
function recursive_twice(x:u64 in O,n:u64)->void where {owner O}{
 if(n==0u64){x <- 31u64;{}}else{
  recursive_twice(x,n-1u64);
  recursive_twice(x,n-1u64);
 }
}
func composed=recursive_twice;
ref combined=make local u64;
composed(combined,6u64);
behave @print(combined);

# Both parameters denote the same allocation, independently of their names.
function through_alias(x:u64 in O,y:u64 in O)->const u64 where {owner O}{x <- 19u64;return y}
func aliased=through_alias;
ref cell=make local u64;
behave @print(aliased(cell,cell));

# Passing a target to another writer must not require a speculative payload read.
function partial(x:u64 in O,b:bool)->void where {owner O}{if(b){x <- 1u64;{}}else{}}
func maybe_write=partial;
ref later=make local u64;
maybe_write(later,false);
selected(later);
behave @print(later);

function fail_after(x:u64 in O)->void where {owner O}{
 x <- 13u64;
 owned region invalid:Packet <- make Packet(capacity=0u64){value <- 0u64};
 {}
}
func failing=fail_after;
ref rescued=make local u64;
try {failing(rescued);} catch(e:const InvalidCapacity){behave @print(rescued);};

symbol @seed:u64;
effect @seed <- 17u64;
proc @fill(x:u64 in O)->void where {owner O}{x <- @seed;{}}
effect @seed <- 29u64;
ref captured=make local u64;
perform @fill(captured);
behave @print(captured);
ref current=make local u64;
behave @fill(current);
behave @print(current);

function first_value(x:u64,y:u64)->const u64{return x}
function change(x:u64 in O)->const u64 where {owner O}{x <- 5u64;return 0u64}
ref snapshot=make local u64;
func writer=initialize;
writer(snapshot);
behave @print(first_value(snapshot,change(snapshot)));
behave @print(snapshot);
