data Node {value:u64;}
region Arena {count:u64;}
function wrong(a:Node in r,b:Node in s)->Node in r where {region r:Arena,region s:Arena} {b}
owned region arena:Arena <- make Arena(capacity=256u64){count <- 0u64};
owned region other:Arena <- make Arena(capacity=256u64){count <- 0u64};
ref a=alloc arena Node(1u64);
ref b=alloc other Node(2u64);
func selected=wrong;
ref result=selected(a,b);
