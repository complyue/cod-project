function add(a:u64 in O,b:const u64 in O)->const u64 where {owner O} { a <- a+b; return a }
region State { value:u64; }
owned region a:State <- make State(capacity=128u64) { value <- 1u64 };
owned region b:State <- make State(capacity=128u64) { value <- 2u64 };
func operation = add;
val rejected = operation(a.value,b.value);
