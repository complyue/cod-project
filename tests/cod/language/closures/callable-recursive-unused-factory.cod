using symbol "std:io" @print;
region State {value:u64;}
function reader(region r:State)->func()->const u64 with {region r} {
  val var value:u64 in r -> r.value;
  return func()->const u64 {return value+unavailable}
}
function maker(region r:State)->(func()->(func()->const u64 with {region r}) with {region r}) {
  return func()->(func()->const u64 with {region r}) {return reader(r)}
}
function step(owned region work:State,
    factory:(func()->(func()->const u64 with {region work}) with {region work}),n:u64)->const u64 {
  func current=factory();
  return if(n==0u64){0u64}else{
    owned region next<-make State(capacity=256u64){value<-1u64};
    step(next,maker(next),n-1u64)
  }
}
owned region seed<-make State(capacity=256u64){value<-7u64};
behave @print(step(seed,maker(seed),32u64));
