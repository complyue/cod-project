using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item{value:u64;}
region symbol @arena:Item;
symbol @left:Item in pool,@right:Item in pool where {region pool:Item};
symbol @bias:u64;
symbol @leaf:proc(u64)->const u64;
symbol @fail:u64;
proc walk(n:u64,callback:proc(u64)->const u64)->proc(u64)->const u64 {
  if(n==0u64){return callback;}else{};
  {{effect @bias<-n;
    proc next=if(n%2u64==0u64){proc(x:u64)->const u64 {
      touch @right;
      if(@fail==1u64){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};
      return callback(x)+@bias;
    }}else{proc(x:u64)->const u64 {
      touch @right;
      return callback(x)+@bias+100u64;
    }};
    return walk(n-1u64,next);
  }}
}
proc run()->void {
  effect @arena<-make Item(capacity=256u64){value<-7u64};
  effect @left=root(@arena),@right=root(@arena);
  effect @bias<-99u64;
  effect @fail<-0u64;
  proc first=proc(x:u64)->const u64{touch @right;return @left.value+@bias+x;};
  proc selected=walk(20u64,first);
  proc copy=selected;
  selected<-proc(x:u64)->const u64{return x;};
  effect @leaf=copy;
  effect @arena<-make Item(capacity=256u64){value<-7000u64};
  effect @left=root(@arena),@right=root(@arena);
  effect @bias<-700u64;
  behave @print(perform @leaf(1u64));
  behave @print(copy(1u64));
  behave @print(selected(1u64));
  behave @print(@bias);
  effect @fail<-1u64;
  proc failing=walk(4u64,first);
  try {failing(1u64);{}}catch(e:const InvalidCapacity){behave @print(777u64);};
  behave @print(@bias);
  behave @print(@left.value);
  effect @fail<-0u64;
  defer {behave @print(perform @leaf(1u64));};
  defer behave @print(copy(1u64));
}
run();
