using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
region State { value:u64; }
function reader(region state:State) -> func(u64)->const u64 with {region state} {
  val var value -> state.value;
  function add(x:T) -> const u64 where {T} { x + value };
  func (x:u64) -> const u64 { add(x) }
}
function alternate(region state:State) -> func(u64)->const u64 with {region state} {
  val var value -> state.value;
  func (x:u64) -> const u64 { x + 2u64 * value }
}
function sum_down(n:u64) -> const u64 {
  if (n == 0u64) { 0u64 } else { n + sum_down(n - 1u64) }
}
owned region state:State <- make State(capacity = 64u64) { value <- 10u64 };
func current = reader(state);
behave @print(current(3u8));
behave @print(current({ current <- alternate(state); 4u64 }));
behave @print(current(4u64));
func saved = current;
ptr selected = current;
behave @print(selected({ selected = saved; current <- reader(state); 5u64 }));
behave @print(current(5u64));
behave @print(saved(5u64));
behave @print(fold (i in 0u64 .. 3u64, total = 0u64) {{
  total + current({
    if (i % 2u64 == 0u64) { current <- alternate(state); {} }
    else { current <- reader(state); {} };
    i
  })
}});
func recursive = sum_down;
behave @print(recursive(10u64));

func pair = func (first:u64, second:u64) -> const u64 { first * 100u64 + second };
ref first = 2u64;
behave @print(pair(first, { first <- 9u64; first }));
func mixed = func (x:f64, y:f32) -> const f64 { x + f64(y) };
behave @print(mixed(1u8, 2.5f32));
func checked = func (x:i64) -> const i64 throws NullPointerException {
  ptr absent:i64 = null;
  if (x == 0) { absent } else { x }
};
try { checked(0); {} } catch (e:const NullPointerException) { behave @print(99u64); };
try { behave @print(checked(7)); } catch (e:const NullPointerException) { behave @print(0u64); };
func changing:func(i64)->const i64 throws NullPointerException = func (x:i64) -> const i64 { x };
try {
  for (i in 0u64 .. 2u64) {{
    behave @print(changing(0));
    changing <- checked;
  }};
} catch (e:const NullPointerException) { behave @print(98u64); };
