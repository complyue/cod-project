region State { ticks:u64; }
function step(region state:State, n:u64)->const u64 { return state.ticks + n }
function drop(owned region state:State)->const u64 { return 0u64 }
owned region state:State <- make State(capacity=128u64) { ticks <- 3u64 };
func cb = step;
val rejected = cb(state, drop(state));
