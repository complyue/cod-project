region State {value:u64;}
region Extended {prefix:u64; value:u64; extra:u64;}
function readonly()->const owned region:State {
  return make Extended(capacity=256u64) {prefix<-99u64; value<-1u64; extra<-11u64}
}
function forward()->owned region:State {return readonly()}
function writable()->owned region:State {
  return make Extended(capacity=256u64) {prefix<-99u64; value<-2u64; extra<-12u64}
}
func selected=writable;
for(i in 0u64..2u64) {{
  owned region result<-selected();
  root(result).extra<-3u64;
  selected<-forward;
}};
