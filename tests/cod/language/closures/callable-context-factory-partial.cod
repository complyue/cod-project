using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item{value:u64;}
region symbol @arena:Item;
symbol @left:Item in pool,@right:Item in pool where {region pool:Item};
symbol @bias:u64;
symbol @delta:u64;
symbol @fail:u64;
symbol @factory:proc(u64)->proc(u64)->const u64;
symbol @leaf:proc(u64)->const u64;
proc walk(n:u64,maker:proc(u64)->proc(u64)->const u64)->const u64 {
  if(n==0u64){{
    effect @arena<-make Item(capacity=256u64){value<-7000u64};
    effect @left=root(@arena),@right=root(@arena);
    effect @bias<-700u64;
    proc current=maker(11u64);
    effect @factory=maker;
    proc frozen=perform @factory(13u64);
    effect @leaf=current;
    ref first=perform @leaf(0u64);
    effect @leaf=frozen;
    return first*1000u64+perform @leaf(0u64);
  }}else{};
  {{effect @bias<-n;
    proc next=if(n%2u64==0u64){proc(k:u64)->proc(u64)->const u64 {
      if(@fail==1u64){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};
      effect @delta<-k;
      return proc(x:u64)->const u64{return @left.value+@bias+@delta+x;};
    }}else{proc(k:u64)->proc(u64)->const u64 {
      if(@fail==1u64){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};
      effect @delta<-k;
      return proc(x:u64)->const u64{return @left.value+@bias+@delta+x+100u64;};
    }};
    return walk(n-1u64,next);
  }}
}
proc run()->void {
  effect @arena<-make Item(capacity=256u64){value<-99u64};
  effect @left=root(@arena),@right=root(@arena);
  effect @bias<-99u64;
  effect @delta<-3u64;
  effect @fail<-0u64;
  proc maker=proc(k:u64)->proc(u64)->const u64 {
    effect @delta<-k;
    return proc(x:u64)->const u64{return @left.value+@bias+@delta+x;};
  };
  behave @print(walk(20u64,maker));
  behave @print(@bias);
  behave @print(@delta);
  effect @fail<-1u64;
  try {walk(20u64,maker);{}}catch(e:const InvalidCapacity){behave @print(777u64);};
  behave @print(@bias);
  behave @print(@delta);
  effect @fail<-0u64;
  defer {behave @print(@bias);};
  defer behave @print(walk(4u64,maker));
}
run();
