using symbol "std:io" @print;
using "std:exceptions" Exception;
data FailedSelection <: Exception { depth:u64; }
symbol @bias:u64;
func low() -> u64 { return 9u64; }
func high() -> u64 { return 13u64; }
effect @bias <- 3u64;
proc factory(n:u64) -> func()->u64 {
  effect @bias <- @bias + 1u64;
  if (n != 0u64) return factory(n - 1u64);
  if (@bias == 9u64) return low;
  return high;
}
func first = factory(5u64);
effect @bias <- 10u64;
func second = factory(2u64);
proc fail(n:u64) -> void throws FailedSelection {
  effect @bias <- @bias + 1u64;
  if (n == 0u64) { throw FailedSelection { depth <- n; }; };
  fail(n - 1u64);
  return;
}
try { fail(8u64); }
catch (e:const FailedSelection) { behave @print(@bias); };
behave @print(first());
behave @print(second());
behave @print(@bias);
