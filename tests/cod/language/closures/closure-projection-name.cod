region State { flag:bool; }
function reader(const region state:State) -> func()->const bool with {region state} {
  func [state] () -> const bool { state.flag }
}
owned region state:State <- make State(capacity = 128u64) { flag <- true };
func cb = reader(state);
function inspect(action:func()->const bool with {region local}) where {region local:State} -> const bool {
  (action -> state).flag
}
inspect(cb);
