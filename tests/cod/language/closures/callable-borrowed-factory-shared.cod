using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item{value:u64;}
region State{value:u64;calls:u64;stop:u64;}
function stage0(region state:State)->func()->const u64 with {region state} {
  state.calls<-state.calls+1u64;
  if(state.calls==state.stop){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};
  return func()->const u64{return state.value;};
}
function left1(region state:State)->func()->const u64 with {region state} {return stage0(state);}
function right1(region state:State)->func()->const u64 with {region state} {return stage0(state);}
function stage1(region state:State)->func()->const u64 with {region state} {
  func left=left1(state);func right=right1(state);
  return func()->const u64{return left()+right();};
}
function left2(region state:State)->func()->const u64 with {region state} {return stage1(state);}
function right2(region state:State)->func()->const u64 with {region state} {return stage1(state);}
function stage2(region state:State)->func()->const u64 with {region state} {
  func left=left2(state);func right=right2(state);
  return func()->const u64{return left()+right();};
}
function left3(region state:State)->func()->const u64 with {region state} {return stage2(state);}
function right3(region state:State)->func()->const u64 with {region state} {return stage2(state);}
function stage3(region state:State)->func()->const u64 with {region state} {
  func left=left3(state);func right=right3(state);
  return func()->const u64{return left()+right();};
}
function left4(region state:State)->func()->const u64 with {region state} {return stage3(state);}
function right4(region state:State)->func()->const u64 with {region state} {return stage3(state);}
function stage4(region state:State)->func()->const u64 with {region state} {
  func left=left4(state);func right=right4(state);
  return func()->const u64{return left()+right();};
}
function left5(region state:State)->func()->const u64 with {region state} {return stage4(state);}
function right5(region state:State)->func()->const u64 with {region state} {return stage4(state);}
function stage5(region state:State)->func()->const u64 with {region state} {
  func left=left5(state);func right=right5(state);
  return func()->const u64{return left()+right();};
}
function left6(region state:State)->func()->const u64 with {region state} {return stage5(state);}
function right6(region state:State)->func()->const u64 with {region state} {return stage5(state);}
function stage6(region state:State)->func()->const u64 with {region state} {
  func left=left6(state);func right=right6(state);
  return func()->const u64{return left()+right();};
}
function left7(region state:State)->func()->const u64 with {region state} {return stage6(state);}
function right7(region state:State)->func()->const u64 with {region state} {return stage6(state);}
function stage7(region state:State)->func()->const u64 with {region state} {
  func left=left7(state);func right=right7(state);
  return func()->const u64{return left()+right();};
}
function left8(region state:State)->func()->const u64 with {region state} {return stage7(state);}
function right8(region state:State)->func()->const u64 with {region state} {return stage7(state);}
function stage8(region state:State)->func()->const u64 with {region state} {
  func left=left8(state);func right=right8(state);
  return func()->const u64{return left()+right();};
}
proc run()->void {
  owned region state:State<-make State(capacity=256u64){value<-7u64;calls<-0u64;stop<-0u64};
  func selected=stage8(state);
  func copy=selected;
  selected<-stage0(state);
  behave @print(state.calls);
  behave @print(copy());
  region projected=copy->state;
  projected.value<-9u64;
  behave @print(copy());
  behave @print(selected());
  state.stop<-state.calls+3u64;
  try {{func rejected=stage8(state);}}catch(e:const InvalidCapacity){behave @print(777u64);};
  behave @print(state.calls);
  defer behave @print(copy());
}
run();
