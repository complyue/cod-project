region State {value:u64;}
region Padded {prefix:u64;value:u64;}
data Link {ref state:State;}
function first()->own region:State {return make Padded(capacity=256u64) {prefix<-99u64;value<-1u64}}
function second()->own region:State {return make Padded(capacity=256u64) {prefix<-99u64;value<-2u64}}
func selected=first;
for(i in 0u64..2u64) {{
  own region result<-selected();
  ref link=alloc result Link(root(result));
  selected<-second;
}};
