data Item {value:u64;}
proc borrowed(v:u64 in o)->u64 where {owner o} {return v;}
proc consume(v:u64 in r,region r:Item)->void {}
proc run()->void {owned region r:Item<-make Item(capacity=256u64){value<-1u64}; owned region q:Item<-make Item(capacity=256u64){value<-2u64}; consume(borrowed(root(r).value),q);}
run();
