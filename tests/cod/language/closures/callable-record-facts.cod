using symbol "std:io" @print;
using symbol "std:io" @assert;
using "record-vocabulary.cod" Node;
using "record-vocabulary.cod" Entity;
using "record-vocabulary.cod" Arena;
using "record-forward.cod" recursive;
function score(value:Entity in r)->const u64 where {region r:Arena} {return 77u64}
owned region arena:Arena <- make Arena(capacity=256u64){count <- 0u64};
ref item=alloc arena Node(5u64);
func selected=recursive;
for(i in 0u64..2u64){{
 ref result=selected(item,16u64);
 behave @print(score(result));
 behave @assert(arena.count == 177u64*(i+1u64));
 selected <- recursive;
}};
