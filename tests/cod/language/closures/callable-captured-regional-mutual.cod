using symbol "std:io" @print;
data Item{value:u64;}
region symbol @arena:Item;
symbol @step:proc(u64)->const u64;
proc first(n:u64)->const u64 {
  if(n==0u64){return @arena.value;}else{};
  {{effect @arena<-make Item(capacity=256u64){value<-n};
    proc next=proc(n:u64)->const u64{return second(n);};
    effect @step=next;
    return perform @step(n-1u64);
  }}
}
proc second(n:u64)->const u64 {
  if(n!=0u64){
    {{effect @arena<-make Item(capacity=256u64){value<-n};
      proc next=proc(n:u64)->const u64{return first(n);};
      effect @step=next;
      return perform @step(n-1u64);
    }}
  }else{};
  return @arena.value+1u64;
}
proc run()->void {
  effect @arena<-make Item(capacity=256u64){value<-99u64};
  for(i in 0u64..2u64) {{
    proc selected=if(i==0u64){proc(n:u64)->const u64{return first(n);}}
      else{proc(n:u64)->const u64{return second(n);}};
    effect @step=selected;
    behave @print(perform @step(20u64));
  }};
  behave @print(@arena.value);
}
run();
