using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
function add(a:u64 in O,b:const u64 in O)->const u64 where {owner O} { a <- a + b; a }
function twice(a:u64 in O,b:const u64 in O)->const u64 where {owner O} { a <- a + b + b; a }
ref a = 1u64;
ref b = 2u64;
func chosen = add;
for(i in 0u64 .. 2u64) { behave @print(chosen(a,b)); chosen <- twice; };
behave @print(chosen(a, { a <- 10u64; b }));
behave @print(a);
function increase(value:T in O, amount:T)->const T where {T, owner O} { value <- value + amount; value }
func generic = increase;
behave @print(generic(a,3u64));
ref f = 1.5f32;
behave @print(generic(f,2.0f32));
function repeat(value:u64 in O,n:u64)->const u64 where {owner O} {
 if(n == 0u64) { value } else { value <- value + 1u64; repeat(value,n-1u64) }
}
func recursion = repeat;
behave @print(recursion(a,5u64));
behave @print(a);
data Node { value:u64; ptr next:Node; }
region Arena { count:u64; ptr head:Node; }
owned region arena:Arena <- make Arena(capacity=1024u64) { count <- 0u64; head = null };
ref tail = alloc arena Node(5u64,null);
ref head = alloc arena Node(3u64,tail);
arena.head = head;
function tally(node:Node in r,n:u64)->const u64 throws NullPointerException where {region r:Arena} {
 r.count <- r.count + 1u64;
 if(n == 0u64) { node.value } else { node.value + tally(node.next,n-1u64) }
}
func total = tally;
try { behave @print(total(head,1u64)); behave @print(tally(head,1u64)); }
catch(e:const NullPointerException) { behave @print(999u64); };
behave @print(arena.count);
function edit(region r:Arena,node:Node in r)->const u64 { node.value <- node.value + 2u64; r.count <- r.count + 1u64; node.value }
func editor = edit;
behave @print(editor(arena,tail));
behave @print(tail.value);
symbol @bias:u64;
effect @bias <- 3u64;
proc @update(value:u64 in O)->const u64 where {owner O} { value <- value + @bias; value }
proc p = @update;
effect @update = p;
effect @bias <- 10u64;
behave @print(perform @update(a));
behave @print(behave @update(a));
behave @print(arena.count);

function copy_bits(dst:u64 in D,src:const u64 in S)->const u64 where {owner D,owner S} { dst <- src; dst }
func copy = copy_bits;
behave @print(copy(a,arena.count));
a <- 41u64;
behave @print(copy(arena.count,a));
array Values[u64]:f32;
function integrate(values:Values in r,gain:f32)->const f32 where {region r:Arena} {
 fold(i in 0u64 .. len(values),total=0.0f32) { values[i] <- values[i]+gain; total+values[i] }
}
ref values = alloc arena Values(4u64,1.0f32);
func integrate_view = integrate;
behave @print(integrate_view(values,0.5f32));
behave @print(integrate(values,0.25f32));

function sum_views(head:const u64 in O,rest:const u64 in O...)->const u64 where {owner O} {
 fold(i in 0u64 .. len(rest),total=head) { total+rest[i] }
}
func sum = sum_views;
behave @print(sum(a,b));
behave @print(sum(a));
