using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item{value:u64;}
symbol @bias:u64;
symbol @inner:proc(u64)->const u64;
symbol @leaf:proc(u64)->const u64;
proc walk(n:u64,callback:proc(u64)->const u64)->proc(u64)->const u64 {
  if(n==0u64){return callback;}else{};
  {{effect @bias<-n;
    proc next=if(n%2u64==0u64){proc(x:u64)->const u64 {
      effect @inner=callback;
      return perform @inner(x)+@bias;
    }}else{proc(x:u64)->const u64 {
      effect @inner=callback;
      return perform @inner(x)+@bias+100u64;
    }};
    return walk(n-1u64,next);
  }}
}
proc run()->void {
  effect @bias<-99u64;
  proc first=proc(x:u64)->const u64 {
    if(x==2u64){{owned region failed:Item<-make Item(capacity=0u64){value<-0u64};}}else{};
    return @bias+x;
  };
  proc selected=walk(20u64,first);
  proc copy=selected;
  selected<-proc(x:u64)->const u64{return x;};
  effect @leaf=copy;
  effect @bias<-700u64;
  behave @print(perform @leaf(1u64));
  behave @print(copy(1u64));
  behave @print(selected(1u64));
  behave @print(@bias);
  try {copy(2u64);{}}catch(e:const InvalidCapacity){behave @print(777u64);};
  behave @print(@bias);
  defer {behave @print(perform @leaf(1u64));};
  defer behave @print(copy(1u64));
}
run();
