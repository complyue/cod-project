using symbol "std:io" @print;
symbol @bias:i64;
region State { value:i64; }
region symbol @state:State;
effect @state <- make State(capacity = 128u64) { value <- 3 };
effect @bias <- 10;
proc @read() -> i64 { @state.value + @bias }
effect @bias <- 20;
behave @print(perform @read());
behave @print(behave @read());
@state.value <- 5;
behave @print(perform @read());
behave @print(behave @read());
