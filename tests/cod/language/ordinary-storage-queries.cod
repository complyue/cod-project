using symbol "std:io" @print;
using "./ordinary-storage-query-library.cod" len;

func used_bytes(value:u64) -> u64 { return value + 3u64; }
func capacity_bytes(value:u64) -> u64 { return used_bytes(value) * 2u64; }
func local_value(len:u64) -> u64 { return len + 1u64; }

behave @print(len(2u64));
behave @print(used_bytes(7u64));
behave @print(local_value(20u64));
behave @print(capacity_bytes(2u64) + 1u64);
