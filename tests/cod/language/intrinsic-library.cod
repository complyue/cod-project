symbol @bias : i64;
symbol @missing : i64;
proc @raw_store(target:f32 in O1, value:f32) -> const f32 where {owner O1};
unit Box;
data Cell { value:i64; }
unit Index;
array Scores[u32(Index)]:i64;
function twice(value:i64) -> i64 { return value * 2 }
function (len)(value:i64(Box)) -> u64 { return u64(scalar(value)) }
procedure (len)(value:i64) -> u64 { return u64(value + @bias) }
procedure (len)(value:bool) -> u64 { return u64(@missing) }
function (store)(value:i64(Box), amount:i64) -> i64(Box) { return Box(scalar(value) + amount) }
procedure (<-)(cell:Cell in O1, amount:i64) -> const Cell in O1 where {owner O1} {
  setfield(cell, value, amount + @bias);
  return cell
}
function ([]=)(value:i64(Box) in O, index:u32(Index), amount:i64) -> const i64(Box) in O where {owner O} {
  value <- Box(scalar(value) + i64(scalar(index)) + amount);
  return value
}
procedure ([]=)(values:Scores in O1, index:u32(Index), amount:i64) -> const i64 in O1 where {owner O1} {
  store(values, index, amount + @bias);
  return values[index]
}
procedure (store)(cell:Cell in O1, amount:i64) -> i64 where {owner O1} {
  return setfield(cell, value, twice(amount) + @bias)
}
function (+)(value:i64(Box), step:i64) -> i64(Box) { return Box(scalar(value) + step) }
procedure (+)(cell:Cell in O1, step:i64) -> i64 where {owner O1} {
  return setfield(cell, value, deref(cell).value + step + @bias)
}
procedure @raw_store(target:f32 in O1, value:f32) -> const f32 where {owner O1} { return store(target, value) }

export (+);
export (<-);
export ([]=);
export (len);
export (store);
export @bias;
export @missing;
export @raw_store;
export Box;
export Cell;
export Index;
export Scores;
export twice;
