symbol @bias :: i64;
symbol @missing :: i64;
symbol @raw_store :: proc(ref<f32>, f32) -> f32;
unit Box;
data Cell { value::i64; }
unit Index;
array Scores[u32(Index)]::i64;
function twice(value::i64)::i64 { value * 2 }
function (len)(value::i64(Box))::u64 { u64(scalar(value)) }
procedure (len)(value::i64)::u64 { u64(value + @bias) }
procedure (len)(value::bool)::u64 { u64(@missing) }
function (store)(value::i64(Box), amount::i64)::i64(Box) { Box(scalar(value) + amount) }
function (=)(value::i64(Box), amount::i64)::i64(Box) { Box(amount) }
procedure (=)(cell::ref<Cell>, amount::i64)::i64 {
  setfield(cell, value, amount + @bias)
}
function ([]=)(value::i64(Box), index::u32(Index), amount::i64)::i64(Box) {
  Box(scalar(value) + i64(scalar(index)) + amount)
}
procedure ([]=)(values::ref<Scores>, index::u32(Index), amount::i64)::i64 {
  store(values, index, amount + @bias)
}
procedure (store)(cell::ref<Cell>, amount::i64)::i64 {
  setfield(cell, value, twice(amount) + @bias)
}
function (+)(value::i64(Box), step::i64)::i64(Box) { Box(scalar(value) + step) }
procedure (+)(cell::ref<Cell>, step::i64)::i64 {
  setfield(cell, value, deref(cell).value + step + @bias)
}
procedure @raw_store(target::ref<f32>, value::f32)::f32 { store(target, value) }

export (+);
export (=);
export ([]=);
export (len);
export (store);
export @bias;
export @missing;
export @raw_store;
export Box;
export Cell;
export Index;
export Scores;
export twice;
