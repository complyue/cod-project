      "stderr": "/tmp/cod-first-owner-flow/branch-region.cod:8:24: regional value requires a live owning region in this caller scope\n/tmp/cod-first-owner-flow/branch-region.cod:7:30: note: the referenced region was acquired here\n"
    }
