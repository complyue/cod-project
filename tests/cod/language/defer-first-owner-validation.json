  "supplemental_probes": [
    {
      "name": "ordinary-loop",
      "mode": "--run",
      "source": "using symbol \"std:io\" @print;\nproc run(count:u64)->void {\n val target:u64 <-30u64;\n ptr p:u64=null;\n for(i in 0u64 .. count) {if(isnull(p)) {p=target;{};} else {behave @print(p);};};\n if(isnull(p)) {behave @print(0u64);} else {behave @print(p);};\n}\nrun(0u64);run(1u64);run(3u64);\n",
      "source_sha256": "0d45496793ea0ffc8e6c954a35b7aa6dba45ec530bc9a445657eda356b287ad3",
      "exit": 0,
      "stdout": "0\n30\n30\n30\n30\n",
      "stderr": ""
    },
    {
      "name": "retained-borrow",
      "mode": "--run",
      "source": "using symbol \"std:io\" @print;\nusing \"std:exceptions\" OutOfMemory;\ndata Item {value:u64;}\nproc run()->void {\n owned region original:Item <-make Item(capacity=256u64){value<-32u64};\n ref borrowed = root(original);\n ptr p:Item=null;\n defer {behave @print(p.value);} catch(e:const OutOfMemory){throw e;};\n defer {p=borrowed;};\n owned region moved:Item <-original;\n}\nrun();\n",
      "source_sha256": "17c447f86c85ba798b9a7f730bec49c85dd188b2e0c062cef52413d327874f78",
      "exit": 0,
      "stdout": "32\n",
      "stderr": ""
    },
    {
      "name": "conditional-consumed",
      "mode": "--check",
      "source": "data Item {value:u64;}\nproc run(yes:bool)->void {\n owned region original:Item <-make Item(capacity=256u64){value<-1u64};\n ptr p:Item=null;\n defer {p=root(original);};\n if(yes) {owned region moved:Item <-original;} else {};\n}\nrun(true);run(false);\n",
      "source_sha256": "c0122c6fac6c6ddc0531607ad2586f4dc42c8b65a0dd539dfdf516328b385964",
      "exit": 2,
      "stdout": "",
      "stderr": "/tmp/cod-first-owner-flow/conditional-consumed.cod:5:16: region owner has been consumed on a path reaching this use\n/tmp/cod-first-owner-flow/conditional-consumed.cod:3:36: note: the region was acquired here\n"
    },
    {
      "name": "branch-region",
      "mode": "--check",
      "source": "using symbol \"std:io\" @print;\nusing \"std:exceptions\" OutOfMemory;\ndata Item {value:u64;}\nproc run(yes:bool)->void {\n ptr p:Item=null;\n if(yes) {\n  owned region r:Item <-make Item(capacity=256u64){value<-24u64};\n  defer {behave @print(p.value);} catch(e:const OutOfMemory) {throw e;};\n  defer {p=root(r);};\n } else {};\n}\nrun(true);run(false);\n",
      "source_sha256": "b58c378405d4d039425918f6e2210740595312f046b0456ad430a7035fdc1341",
      "exit": 2,
