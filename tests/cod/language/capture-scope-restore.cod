using symbol "std:io" @print;
symbol @x : i64;
symbol @y : i64;
symbol @left : proc() -> i64;
symbol @right : proc() -> i64;
symbol @route : proc() -> i64;
symbol @nested : proc() -> i64;
symbol @branch : proc(bool) -> i64;
symbol @relay : proc() -> i64;
symbol @chained : proc() -> i64;
effect @x <- 10;
effect @y <- 20;
procedure @left() -> i64 { return @x }
procedure @right() -> i64 { return @y }
effect @route = @left;
procedure @nested() -> i64 {
  val middle <- {{
    effect @route = @right;
    val inner <- {{ effect @route = @left; behave @route() }};
    inner * 1000 + behave @route()
  }};
  return middle * 1000 + behave @route()
}
procedure @branch(flag:bool) -> i64 {
  val selected <- if (flag) {{
    effect @route = @right;
    behave @route()
  }} else {{
    effect @route = @left;
    behave @route()
  }};
  return selected * 1000 + behave @route()
}
procedure @chained() -> i64 {
  effect @relay = @left;
  effect @route = @relay;
  return behave @route()
}
effect @x <- 100;
effect @y <- 200;
behave @print(perform @nested());
behave @print(behave @nested());
behave @print(perform @branch(true));
behave @print(perform @branch(false));
behave @print(behave @branch(true));
behave @print(behave @route());
behave @print(perform @chained());
behave @print(behave @chained());
