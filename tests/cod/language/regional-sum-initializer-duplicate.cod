using symbol "std:io" @print;
data Node = Link { key:u64; ref next:Node; } | End {};
region Graph { count:u64; }

func Link(k:u64, not init ref peer:Node in O) where {owner O} {
    assert k != 0u64;
    key <- k;
    next = peer
}

own region graph:Graph <- make region Graph(4096u64 -> capacity) { count <- 0u64; };
ref a:Node, b:Node, saved:Node, {
    a = make Link in graph;
    b = make Link in graph;
    saved = a;
    init a(1u64, b);
    init saved(3u64, b)
}
