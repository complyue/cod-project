data Node { value:i64; }
data Choice { ptr next:Node; }
function (=)(lhs:Node in O, rhs:const Choice in O) -> Node in O where {owner O} {
  lhs = deref(rhs).next;
  lhs
}
function readonly(value:Choice in O) -> const Choice in O where {owner O} { value }
region symbol @arena;
effect @arena <- region(4096u64);
{ ptr node = alloc @arena Node(1);
  ptr choice = readonly(alloc @arena Choice(node));
  node = choice;
};
