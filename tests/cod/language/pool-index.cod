using units "pool-units.cod" {ClassId, ClassSetId, GlobalSetId, LocalSlot, GlobalSlot, SetCount, SlotCount, SlotsPerSet};
using "pool-layout.cod" Layout;
using "pool-layout.cod" sets;
using "pool-layout.cod" capacity;
using "pool-layout.cod" class_set_begin;
using "pool-layout.cod" class_slot_begin;
data SetLocation { class_id:u32(ClassId); local:u64(ClassSetId); }
function (u64)(count:u32(SlotsPerSet)) -> u64 { u64(scalar(count)) }
function (u64)(index:u32(LocalSlot)) -> u64 { u64(scalar(index)) }
function locate(layout:Layout in O1, index:u64(GlobalSetId), found:SetLocation in O3) -> SetLocation where {owner O1, owner O3} {
  setfield(found, class_id, ClassId(0u32));
  setfield(found, local, ClassSetId(0u64));
  for (j in 0u32 .. layout.classes) {{
    val first = scalar(class_set_begin(layout, ClassId(j)));
    if (scalar(index) >= first && scalar(index) < first + scalar(sets(layout, ClassId(j)))) {
      setfield(found, class_id, ClassId(j));
      setfield(found, local, ClassSetId(scalar(index) - first));
      {}
    } else {};
  }};
  deref(found)
}
function global_slot(layout:Layout in O1, j:u32(ClassId), set:u64(ClassSetId), slot:u32(LocalSlot)) -> u64(GlobalSlot) where {owner O1} {
  GlobalSlot(scalar(class_slot_begin(layout, j)) + scalar(set) * u64(capacity(j)) + u64(slot))
}

export (u64);
export ClassId;
export ClassSetId;
export GlobalSetId;
export GlobalSlot;
export Layout;
export LocalSlot;
export SetCount;
export SetLocation;
export SlotCount;
export SlotsPerSet;
export capacity;
export class_set_begin;
export class_slot_begin;
export global_slot;
export locate;
export sets;
