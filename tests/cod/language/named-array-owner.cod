using symbol "std:io" @print;
using "std:exceptions" { IndexOutOfBoundsError, OutOfMemoryError };

array Rows[u64]:u64;

proc observe(value:u64) -> u64 {
    behave @print(value);
    return value;
}

proc verify(witness:u64 in O) -> void where {owner O} {
    ref empty = make Rows(observe(0u64), observe(5u64));
    behave @print(intrinsic (len)(empty));
    ref rows = make Rows(2u64, 17u64) in O;
    ref original = rows;
    rows[observe(0u64)] <- {{
        ref replacement = make Rows(2u64, 29u64) in O;
        rows = replacement;
        return observe(7u64);
    }};
    behave @print(original[0u64]);
    behave @print(original[1u64]);
    behave @print(rows[0u64]);
    defer { behave @print(rows[0u64]); };
    try { (rows[observe(2u64)] <- observe(88u64)):void; }
    catch (failure:const IndexOutOfBoundsError) { behave @print(11u64); };
    try {{
        ref replacement = make Rows(18446744073709551615u64, observe(44u64)) in O;
        rows = replacement;
        return;
    }} catch (failure:const OutOfMemoryError) { behave @print(12u64); };
    return;
}

ref lexical_witness = make u64 { 0u64 };
verify(lexical_witness);
