using symbol "std:io" @print;
symbol @step : proc() -> i64;
symbol @cell : i64;
symbol @helper : proc() -> i64;
effect @cell <- 3;
procedure @helper -> i64 { @cell }
mixin "mapped-perform-model.cod" @update as @step with { @helper as @next; };
effect @cell <- 9;
behave @print(perform @step);
behave @print(behave @step);
