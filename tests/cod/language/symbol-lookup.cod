using symbol "std:io" @print;
symbol @gain:u64;
effect @gain <- 7u64;
proc read()->const u64 {return @gain;}
proc add(delta:u64)->const u64 {return delta + read();}
behave @print(add(3u64));
{{
  val observed:u64 <- @gain;
  behave @print(observed);
}};
behave @print(@gain);
{{
  proc saved()->const u64 {return @gain;};
  {{
    val local_gain:u64 <- 99u64;
    behave @print(saved());
    behave @print(local_gain);
  }};
}};
behave @print(@gain);
