using symbol "std:io" @print;

data Span { first:u64; past:u64; }
data NodeId { index:u64; }
data Payload =
      Literal { width:u8; magnitude:u64; }
    | Call { callee:NodeId; opening:u64; };
data Syntax { span:Span; payload:Payload; }
data Slot = Vacant {} | Occupied { node:Syntax; };
array Slots[u64]:Slot;

func append(slots:Slots in F, id:u64, payload:const Payload in P) -> void
    where {owner F, const owner P} {
    slots[id] <- make Occupied {
        node <- make Syntax {
            span <- make Span { first <- 11u64; past <- 13u64; };
            payload <- payload;
        };
    };
    return;
}

proc verify(witness:u64 in F) -> void where {owner F} {
    ref slots = make Slots(2u64, make Vacant {}) in F;
    append(slots, 0u64, make Literal { width <- 8u8; magnitude <- 42u64; });
    ref replacement = make Slots(4u64, make Vacant {}) in F;
    replacement[0u64] <- slots[0u64];
    slots = replacement;
    append(slots, 2u64, make Call {
        callee <- make NodeId { index <- 0u64; };
        opening <- 12u64;
    });

    case slots[0u64] of {
        (Vacant) -> { behave @print(0u64); };
        (Occupied { val node <- node; }) -> {
            behave @print(node.span.first);
            behave @print(node.span.past);
            case node.payload of {
                (Literal { val magnitude <- magnitude; }) -> { behave @print(magnitude); };
                (Call) -> { behave @print(0u64); };
            };
        };
    };
    case slots[1u64] of {
        (Vacant) -> { behave @print(1u64); };
        (Occupied) -> { behave @print(0u64); };
    };
    case slots[2u64] of {
        (Vacant) -> { behave @print(0u64); };
        (Occupied { val node <- node; }) -> {
            case node.payload of {
                (Literal) -> { behave @print(0u64); };
                (Call { val callee <- callee; val opening <- opening; }) -> {
                    behave @print(callee.index);
                    behave @print(opening);
                };
            };
        };
    };
    behave @print(case slots[2u64] of {
        (Occupied) | { slots[2u64] <- make Vacant {}; false } -> { 11u64 };
        (Vacant) -> { 29u64 };
        (Occupied) -> { 37u64 };
    });
    return;
}

ref lexical_witness = make u64 { 0u64 };
verify(lexical_witness);
