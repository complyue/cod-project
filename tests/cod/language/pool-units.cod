unit ClassId;
unit ClassSetId;
unit GlobalSetId;
unit LocalSlot;
unit GlobalSlot;
unit SetCount;
unit SlotCount;
unit SlotsPerSet;
conversion function capacity_count(x:u32(SlotsPerSet)) -> u64(SlotCount) { return SlotCount(u64(scalar(x))) }
function (*)(slots:u64(SlotCount*), sets:u64(SetCount)) -> u64(SlotCount) { return SlotCount(scalar(slots) * scalar(sets)) }

export (*);
export ClassId;
export ClassSetId;
export GlobalSetId;
export GlobalSlot;
export LocalSlot;
export SetCount;
export SlotCount;
export SlotsPerSet;
export capacity_count;
