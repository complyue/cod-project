symbol @print;
using "std:io" @print as @print;
symbol @assert;
using "std:io" @assert as @assert;
symbol @effect;
symbol @read;
symbol @increment;
function twice(x: i64) -> i64 { x * 2 }
global initial: i64 = twice(3);
effect @effect = 1;
procedure @read -> i64 { @effect }
procedure @increment -> i64 { effect @effect = @effect + 1; @effect }
effect @effect = 7;
behave @print(perform @read);
behave @print(behave @read);
behave @print(perform @increment);
behave @print(perform @increment);
behave @print(behave @increment);
behave @print(behave @increment);
behave @assert(@effect == 7);
behave @print(effect @effect = initial);
{ effect @effect = 9; behave @print(@effect); };
behave @print(@effect);
