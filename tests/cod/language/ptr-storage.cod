using symbol "std:io" @assert;
using "std:exceptions" InvalidCapacity;
data Pool { value::i64; }
region symbol @pool::Pool;
effect @pool <- make Pool(capacity = 4096u64) { value <- 20 };

function initialize(dst::i64 in O) -> void where {owner O} { dst <- 17; {} }
function forward(dst::i64 in O) -> void where {owner O} { initialize(dst) }
function local_copy(x::i64) -> const i64 { x <- 9; x }
function choose(a::i64 in O, b::i64 in O, second::bool) -> const i64 in O
  where {owner O} { if (second) { b } else { a } }
function digits(a::i64, b::i64) -> const i64 { a * 10 + b }
proc unused() -> i64 { behave @assert(false); 0 }

{
  ptr a = make local i64 { 1 }, b = make local i64, { b <- a + 2 };
  ptr alias = a;
  alias <- 5;
  behave @assert(a == 5);
  ptr copy <- a;
  copy <- 7;
  behave @assert(a == 5);
  behave @assert(local_copy(a) == 9);
  behave @assert(a == 5);

  ptr deferred = make local typeof(a), blank = make local typeof(deferred);
  ptr deferred_alias = deferred;
  forward(deferred_alias);
  blank <- deferred;
  behave @assert(blank == 17);
  ptr queried = make local typeof(unused()) { 4 };
  behave @assert(queried == 4);

  ptr result = a <- b;
  a <- 11;
  behave @assert(result == 11);
  ptr selected = choose(a, b, true);
  b <- 8;
  behave @assert(selected == 8);
  alias = b;
  alias <- 12;
  behave @assert(b == 12);
  a <- b <- copy;
  behave @assert(a == 7 && b == 7);

  ptr branch = make local i64, flag = true;
  if (flag) { branch <- 31; } else { branch <- 32; };
  behave @assert(branch == 31);
  if (flag) { alias = a; {} } else { alias = b; {} };
  alias <- 6;
  behave @assert(a == 6 && b == 7);
  for (i in 0 .. 3) { a <- a + 1; };
  behave @assert(a == 9);
  behave @assert(digits(a, { a <- 2; a }) == 92);

  ptr field = root(@pool).value;
  field <- a;
  behave @assert(root(@pool).value == 2);
  forward(field);
  behave @assert(field == 17);

  ptr recovered = make local i64;
  try {
    make Pool(capacity = 0u64) { value <- 1 };
    recovered <- 40;
  } catch (error::const InvalidCapacity) { recovered <- 41; };
  behave @assert(recovered == 41);
};
