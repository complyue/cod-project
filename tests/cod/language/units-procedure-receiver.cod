unit raw::f64;
unit normalized::f64;
conversion function normalize(x (raw))::normalized { normalized(scalar(x) / 50.0) }
function adjust(x::f64)::f64 { x + 100.0 }
symbol @receiver_distance;
symbol @receiver_read;
effect @receiver_distance = normalized(10.0);
import "units-procedure-source.cod" @read as @receiver_read with { @receiver_distance as @distance; };
