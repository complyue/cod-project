unit raw::f64;
unit normalized::f64;
conversion function normalize(x (raw))::normalized { normalized(scalar(x) / 50.0) }
function adjust(x::f64)::f64 { x + 100.0 }
symbol @receiver_distance :: normalized;
symbol @receiver_read :: proc(normalized) -> f64;
effect @receiver_distance <- normalized(10.0);
mixin "units-procedure-source.cod" @read as @receiver_read with { @receiver_distance as @distance; };

export @receiver_distance;
export @receiver_read;
export adjust;
export normalize;
export normalized;
export raw;
