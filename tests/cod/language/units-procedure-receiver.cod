unit raw;
unit normalized;
conversion function normalize(x:f64(raw)) -> f64(normalized) { return normalized(scalar(x) / 50.0) }
function adjust(x:f64) -> f64 { return x + 100.0 }
symbol @receiver_distance : f64(normalized);
symbol @receiver_read : proc(f64(normalized)) -> f64;
effect @receiver_distance <- normalized(10.0);
mixin "units-procedure-source.cod" @read as @receiver_read with { @receiver_distance as @distance; };

export @receiver_distance;
export @receiver_read;
export adjust;
export normalize;
export normalized;
export raw;
