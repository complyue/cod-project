using symbol "std:io" @print;
val symbol @amount:u64;
val symbol @audit:u64;
val symbol @local:u64;
symbol @report:proc(u64) -> u64;
proc audit_helper() -> void { touch @audit; }
proc @report(value:u64) -> u64 { return @amount + value; }
proc @report(value:bool) -> u64 {
    audit_helper();
    effect @local <- 41u64;
    touch @local;
    return 99u64;
}
effect @amount <- 6u64;
effect @audit <- 19u64;
effect proc @report;
effect @amount <- 10u64;
effect @audit <- 29u64;
behave @print(perform @report(7u64));
behave @print(behave @report(7u64));
behave @print(@audit);
