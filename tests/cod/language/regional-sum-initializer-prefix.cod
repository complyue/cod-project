using symbol "std:io" @print;
using "std:exceptions" { RegionCapacityExceededError, AssertionFailedError }

data Node = Link { key:u64; ref next:Node; } | End {};
region Graph { count:u64; }

proc mark(k:u64) -> u64 {
    behave @print(50u64 + k);
    return k;
}

proc Link(k:u64, not init ref peer:Node in O) where {owner O} {
    defer { behave @print(70u64 + k) };
    assert k != 0u64;
    key <- k;
    next = peer;
    behave @print(k)
}

proc attempt(capacity:u64, second:u64) -> void {
    try {{
        own region graph:Graph <- make region Graph(capacity -> capacity) { count <- 0u64; };
        ref a:Node, b:Node, {
            a = make Link in graph;
            behave @print(42u64);
            b = make Link in graph;
            init a(mark(1u64), b);
            init b(mark(second), a)
        }
        behave @print(a.next is b);
        behave @print(b.next is a)
    }} catch (error:const RegionCapacityExceededError) {
        behave @print(98u64)
    } catch (error:const AssertionFailedError) {
        behave @print(99u64)
    };
    return;
}

attempt(8u64, 2u64);
attempt(32u64, 2u64);
attempt(64u64, 0u64);
attempt(64u64, 2u64);
