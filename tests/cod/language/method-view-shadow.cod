using "method-view-library.cod" Sample;
function score(x:Sample in O1) -> i64 where {owner O1} { return 13 }
function (len)(x:bool) -> i64 { return 7 }
function run(region arena) -> i64 {
  ref sample = create(arena);
  return score(sample) + through(sample) + len(sample) + len(false)
}

export (len);
export Sample;
export run;
export score;
