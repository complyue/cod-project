using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
using "std:exceptions" NullPointerException;
function factorial(n:u64) -> const u64 {
  return if (n == 0u64) { 1u64 } else { n * factorial(n - 1u64) }
}
function even(n:u64) -> const bool {
  return if (n == 0u64) { true } else { odd(n - 1u64) }
}
function odd(n:u64) -> const bool {
  return if (n == 0u64) { false } else { even(n - 1u64) }
}
function seed() -> const u64 { return 7u64 }
global offset:u64 = seed();
function descend(n:u64) -> const u64 {
  return if (n == 0u64) { offset } else { descend(n - 1u64) + 1u64 }
}
behave @print(factorial(6u64));
behave @print(even(12u64));
behave @print(odd(12u64));
behave @print(descend(9u64));

symbol @bias:u64;
symbol @saved:proc()->const u64;
effect @bias <- 1u64;
proc accumulate(n:u64) -> const u64 {
  proc snapshot() -> const u64 { return @bias }
  ;
  return if (n == 0u64) { @bias } else {
    effect @bias <- @bias + 1u64;
    val child <- accumulate(n - 1u64);
    effect @saved = snapshot;
    child + perform @saved()
  }
}
behave @print(accumulate(3u64));
behave @print(@bias);

data Frame { depth:u64; }
function fail_at_bottom(depth:u64) -> const u64 {
  owned region frame:Frame <- make Frame(capacity = 128u64) { depth <- depth };
  return if (depth == 0u64) {
    owned region invalid:Frame <- make Frame(capacity = 0u64) { depth <- depth };
    0u64
  } else { fail_at_bottom(depth - 1u64) }
}
try { fail_at_bottom(4u64); {} }
catch (error:const InvalidCapacity) { behave @print(99u64); };
function null_at_bottom(depth:u64) -> const i64 throws NullPointerException {
  return if (depth == 0u64) {
    ptr absent:i64 = null in here;
    absent
  } else { null_at_bottom(depth - 1u64) }
}
try { null_at_bottom(4u64); {} }
catch (error:const NullPointerException) { behave @print(100u64); };
