using symbol "std:io" @print;
using "method-view-library.cod" Sample;
using "method-view-shadow.cod" Sample as SameSample;
using "method-view-library.cod" score;
using "method-view-first.cod" run as first;
using "method-view-second.cod" run as second;
using "method-view-shadow.cod" run as shadow;
symbol @arena::region;
effect @arena <- region(4096u64);
{
  behave @print(first(@arena));
  behave @print(second(@arena));
  behave @print(shadow(@arena));
  behave @print(through(create(@arena)));
  behave @print(pointer_value(alloc @arena Sample(19)));
};
