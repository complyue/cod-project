data CounterCell { ticks:u64; }
region State { choose_first:bool; }
function reader(ref counter:CounterCell in state) where {region state:State}
    -> func()->const u64 with {region state} {
  val var ticks:u64 in state -> counter.ticks;
  func () -> const u64 { ticks }
}
function select(ref a:CounterCell in state, ref b:CounterCell in state, flag:bool)
    where {region state:State} -> func()->const u64 with {region state} {
  if (flag) { reader(a) } else { reader(b) }
}
owned region state:State <- make State(capacity = 256u64) { choose_first <- true };
ref first = alloc state CounterCell(1u64);
ref second = alloc state CounterCell(2u64);
const ref chosen = select(first, second, state.choose_first);
chosen();
