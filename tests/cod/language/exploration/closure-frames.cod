using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
unit Cell;
array Frame[u32(Cell)]:f32;
region Buffers { ptr input:Frame; ptr output:Frame; }
function updater(region state:Buffers) -> func()->void throws NullPointerException {
  func [input = state.input, output = state.output] () -> void throws NullPointerException {
    for (i in Cell(0u32) .. Cell(u32(len(input)))) {
      output[i] <- input[i] + 1.0f32;
    };
    {}
  }
}
owned region state:Buffers <- make Buffers(capacity = 4096u64) { input = null; output = null };
state.input = alloc state Frame(4u64, 1.0f32);
state.output = alloc state Frame(4u64, 0.0f32);
const ref step = updater(state);
try {
  for (frame in 0 .. 3) {
    step();
    ptr previous = state.input;
    state.input = state.output;
    state.output = previous;
  };
  behave @print(state.input[Cell(0u32)]);
  behave @print(state.output[Cell(0u32)]);
} catch (e:const NullPointerException) { behave @print(-1); };
