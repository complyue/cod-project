using "structural-api.cod" Counter;
using "structural-api.cod" Cursor;
using "std:exceptions" NullPointerException;
function reader(region state:Counter) -> func[region state]()->const u64 {
  func [ticks = state.ticks] () -> const u64 { ticks }
}
proc current_reader(region state:Cursor) -> proc[region state]()->const i64 throws NullPointerException {
  proc [current = state.current] () -> const i64 throws NullPointerException { current.value }
}
function apply(action:func[region r]()->const u64) -> const u64 where {region r:Counter} { action() }
export reader;
export current_reader;
export apply;
function wrap(action:func[region r]()->const u64) -> func[region r]()->const u64 where {region r:Counter} {
  func [action = action] () -> const u64 { action() + 1u64 }
}
export wrap;
