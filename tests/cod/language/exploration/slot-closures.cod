using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
data Node { value:i64; }
data Link { ptr selected:Node; }
region State { ptr link:Link; val tick:u64; }
owned region state:State <- make State(capacity = 1024u64) { link = null; tick <- 3u64 };
ptr first = alloc state Node(5);
ptr second = alloc state Node(9);
ptr first_link = alloc state Link(first);
ptr second_link = alloc state Link(second);
state.link = first_link;
try {
  ptr var pinned_selection -> state.link.selected;
  const ref pinned = func [pinned_selection] () -> const i64 throws NullPointerException { pinned_selection.value };
  const ref following = func [state] () -> const i64 throws NullPointerException { state.link.selected.value };
  state.link = second_link;
  behave @print(pinned());
  behave @print(following());
  first_link.selected = second;
  behave @print(pinned());
  behave @print(following());
  ptr var selected -> first_link.selected;
  const ref replace = func [selected, state] () -> void throws NullPointerException {
    selected = state.link.selected;
    {}
  };
  first_link.selected = first;
  replace();
  behave @print(first_link.selected.value);
} catch (e:const NullPointerException) { behave @print(-1); };
data Increment { amount:u64; }
function adder(region state:State, increment:u64) -> (func()->const u64 with {region state}) {
  ref configuration = alloc state Increment(increment);
  val var tick -> state.tick;
  val var amount -> configuration.amount;
  func [tick, amount] () -> const u64 { tick + amount }
}
const ref add = adder(state, 4u64);
behave @print(add());
state.tick <- 5u64;
behave @print(add());
data Required { ref selected:Node; }
ptr required_left = alloc state Required(first);
ptr required_right = alloc state Required(second);
ref var left -> required_left.selected;
ref var right -> required_right.selected;
const ref copy_ref = func [left, right] () -> void { left = right; {} };
copy_ref();
behave @print(required_left.selected.value);
try {
  first_link.selected = first;
  ptr var chosen -> first_link.selected;
  const ref alias_test = func [chosen, state] () -> const i64 throws NullPointerException {
    ptr alias = chosen;
    alias = state.link.selected;
    chosen.value + alias.value
  };
  behave @print(alias_test());
  behave @print(first_link.selected.value);
} catch (e:const NullPointerException) { behave @print(-1); };
function (<=>)(left:Node in O, right:Node in O) -> void where {owner O} {
  intrinsic (<=>)(left, right)
}
const ref swap_slots = func [left, right] () -> void { left <=> right };
required_left.selected = first;
swap_slots();
behave @print(required_left.selected.value);
behave @print(required_right.selected.value);
const ref factory = func [state] () -> (func()->const u64 with {region state}) {
  val var tick -> state.tick;
  func [tick] () -> const u64 { tick }
};
const ref nested = factory();
state.tick <- 11u64;
behave @print(nested());
array Values[u32]:i64;
ref values = alloc state Values(2u64, 0);
ref selected <- 0u32;
val var item -> values[selected];
const ref element = func [item] () -> const i64 { item };
selected <- 1u32;
values[0u32] <- 17;
values[1u32] <- 23;
behave @print(element());
first_link.selected = null;
second_link.selected = second;
ptr var nullable_left -> first_link.selected;
ptr var nullable_right -> second_link.selected;
const ref swap_nullable = func [nullable_left, nullable_right] () -> void { intrinsic (<=>)(nullable_left, nullable_right) };
swap_nullable();
behave @print(isnull(first_link.selected));
behave @print(isnull(second_link.selected));
