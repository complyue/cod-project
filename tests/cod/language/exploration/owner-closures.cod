using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
using "structural-api.cod" Node;
using "structural-api.cod" Counter;
using "owner-closure-library.cod" reader;
using "owner-closure-library.cod" current_reader;
using "owner-closure-library.cod" apply;
region State { val ticks:u64; ptr current:Node; }
owned region state:State <- make State(capacity = 512u64) { ticks <- 3u64; current = null };
const ref read = reader(state);
behave @print(apply(read));
state.ticks <- 9u64;
behave @print(read());
proc exercise(region r:Counter) -> void {
  func named() -> const u64 { r.ticks }
  ;
  behave @print(named());
  const ref increment = func () -> const u64 { r.ticks <- r.ticks + 1u64; r.ticks };
  behave @print(apply(increment));
}
exercise(state);
try {
  const ref target = current_reader(state);
  try { behave @print(target()); } catch (e:const NullPointerException) { behave @print(0); };
  ptr first = alloc state Node(42);
  ptr second = alloc state Node(7);
  state.current = first;
  behave @print(target());
  state.current = second;
  behave @print(target());
} catch (e:const NullPointerException) { behave @print(-1); };
using "owner-closure-library.cod" wrap;
const ref wrapped = wrap(read);
behave @print(wrapped());
region symbol @resource:State;
effect @resource <- state;
behave @print(read());
