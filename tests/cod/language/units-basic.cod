using symbol "std:io" @print;
using units "units-library.cod" {m as metres, cm, mm};
function distance(x:f64(metres*)) -> f64 { return scalar(x) }
function exact(x:f64(metres)) -> f64 { return scalar(x) }
function (+)(x:f64(metres), offset:f64) -> f64(metres) { return metres(scalar(x) + offset) }
behave @print(distance(cm(250.0)));
behave @print(distance(mm(1250.0)));
behave @print(exact(metres(3.0) + 1.0));
behave @print(scalar(cm_to_m(cm(500.0))));
