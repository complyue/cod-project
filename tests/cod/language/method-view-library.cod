type Metric;
data Sample <: Metric { value:i64; }
function create(region arena) -> Sample { return deref(alloc arena Sample(3)) }
function score(x:Metric in O1) -> i64 where {owner O1} { return 1 }
function through(x:Metric in O1) -> i64 where {owner O1} { return private_bridge(x) + private_bridge(x) }
function pointer_value(x:Sample in O1) -> i64 where {owner O1} { return deref(x).value }
function unused(x:Unavailable in O1) -> i64 where {owner O1} { return missing_implementation(x) }
function (len)(x:Sample in O1) -> i64 where {owner O1} { return x.value }

export (len);
export Metric;
export Sample;
export create;
export pointer_value;
export score;
export through;
export unused;

symbol @bias:i64;
effect @bias <- 1;
proc scored(x:Metric in O1) -> i64 where {owner O1} { return private_bridge(x) + @bias }
export @bias;
export scored;

function private_bridge(x:Metric in O1) -> i64 where {owner O1} { return score(x) }
