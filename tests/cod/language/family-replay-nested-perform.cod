using symbol "std:io" @print;
using "std:exceptions" AssertionFailedError;
val symbol @amount:u64;
symbol @inner:proc(bool) -> u64;
symbol @outer:proc(bool) -> u64;
proc @inner(fail_now:bool) -> u64 {
    defer { behave @print(@amount + 100u64); };
    assert !fail_now;
    return @amount;
}
proc @outer(fail_now:bool) -> u64 { return perform @inner(fail_now); }
effect @amount <- 7u64;
effect proc @inner;
effect proc @outer;
effect @amount <- 9u64;
effect proc @inner;
effect @amount <- 11u64;
behave @print(perform @outer(false));
behave @print(behave @outer(false));
try { behave @print(perform @outer(true)); }
catch (failure:const AssertionFailedError) {
    behave @print(77u64);
    behave @print(@amount);
};
behave @print(perform @inner(false));
