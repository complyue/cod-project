using symbol "std:io" @assert;
data Cell { value:i64; }
region symbol @a;
function forward(region arena) -> region { region view = arena; return view }
function repeat(region arena, count:u32) -> region {
  return fold (i in 0u32 .. count, view = arena) {{ forward(view) }}
}
function create(region arena, value:i64) -> Cell {
  return deref(alloc arena Cell(value))
}
proc inspect(region arena) -> u64 { return capacity_bytes(forward(arena)) }
effect @a <- region(4096u64);
{
  region view = forward(@a);
  val capacity = inspect(view);
  ref cell = create(repeat(view, 3u32), 7);
  {
    effect @a <- region(8192u64);
    behave @assert(capacity_bytes(@a) > capacity);
    behave @assert(inspect(repeat(view, 0u32)) == capacity);
    setfield(cell, value, 9);
  };
  behave @assert(inspect(view) == capacity);
  behave @assert(cell.value == 9);
};
