using "std:exceptions" NullPointerException;
using symbol "std:io" @print;
using symbol "std:io" @assert;
data Pair { x::f32; count::i64; }
data Box { ptr pair::Pair; true::bool; }
data Envelope { ptr content::Box; ptr next::Envelope; }
function double(p::Pair in O1)::Pair where {owner O1} {
  setfield(p, x, deref(p).x * 2.0f32);
  setfield(p, count, deref(p).count * 2);
  deref(p)
}
function metric(b::Box in O1)::f32 throws NullPointerException where {owner O1} { if (b.true) { -deref(b.pair).x } else { 0.0f32 } }
function contents(e::Envelope in O1)::Box throws NullPointerException where {owner O1} { deref(e.content) }
function through(e::Envelope in O1)::i64 throws NullPointerException where {owner O1} { deref(contents(deref(e.next)).pair).count }
region symbol @arena;
effect @arena <- region(2048u64);
try {
  ref pair = alloc @arena Pair(1.25f32, 3);
  double(pair);
  ref b = alloc @arena Box(pair, true);
  behave @print(deref(deref(b).pair).x);
  behave @print(deref(deref(b).pair).count);
  behave @print(metric(deref(b)));
  behave @assert(deref(b).true);
  ref envelope = alloc @arena Envelope(b, null);
  setfield(envelope, next, envelope);
  ref saved = contents(deref(envelope));
  setfield(pair, count, 7);
  ref replacement = alloc @arena Box(alloc @arena Pair(4.0f32, 9), false);
  setfield(envelope, content, replacement);
  behave @print(deref(saved.pair).count);
  behave @print(through(deref(envelope)));
  behave @print(contents(deref(envelope)).true);
} catch (unexpected::const NullPointerException) { behave @assert(false); };
