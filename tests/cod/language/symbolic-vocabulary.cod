data ContextPool { tag:i64; }
data ContextNode { value:i64; }
region symbol @arena:ContextPool;
symbol @left:ContextNode in r, @right:ContextNode in r where {region r:ContextPool};
symbol @gain:i64, @selected:proc() -> i64;
export ContextPool;
export ContextNode;
export var @arena;
export var @left;
export var @right;
export var @gain;
export proc @selected;
