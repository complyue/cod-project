using symbol "std:io" @print;

data Contents { item:u64; return:u64; ptr next:u64; }

func updated(input:T, fallback:T) -> const T where T {
  val current <- fallback;
  ptr result = make T { current <- input; current };
  return result;
}

behave @print(updated(42u64, 0u64));
behave @print(updated(true, false));

{
  val item <- 11u64;
  func field_labels[]() -> const u64 {
    ptr entry = make Contents { (item) <- 2u64; return <- 6u64; next = null; };
    return entry.item + entry.return;
  };
  func query_type[]() -> const u64 {
    ptr result = make typeof(item) { 7u64 };
    return result;
  };
  behave @print(field_labels());
  behave @print(query_type());
  behave @print(item);
};
