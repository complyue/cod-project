using symbol "std:io" @print;
using "std:exceptions" Error;

data Rejected <: Error { code:u64; }
data Node = Link { key:u64; ref next:Node; } | End {};
region Graph { count:u64; }

proc Link(key_value:u64, not init ref peer:Node in O) where {owner O} {
    defer { behave @print(7u64) };
    throw Rejected { code <- key_value }
}

proc attempt(code:u64) -> void {
    try {{
        own region graph:Graph <- make region Graph(64u64 -> capacity) { count <- 0u64; };
        ref node:Node, {
            node = make Link in graph;
            init node(code, node)
        }
        behave @print(node.key)
    }} catch (error:const Rejected) {
        behave @print(error.code)
    };
    return
}

attempt(42u64);
