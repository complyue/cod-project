using symbol "std:io" @print;
symbol from "intrinsic-library.cod" @bias;
using "intrinsic-library.cod" Cell as C;
using "intrinsic-library.cod" (len);
using "intrinsic-library.cod" (store);
using "intrinsic-library.cod" (+);
using "intrinsic-library.cod" (=);
using units "intrinsic-library.cod" {Box as B, Index};
using "intrinsic-library.cod" Scores;
using "intrinsic-library.cod" ([]=);
function twice(value::i64)::i64 { value * 1000 }
function pure(value::B)::B { store(value, 4) }
global saved::B = store(B(5), 4);
array Values[u32]::i64;
symbol @arena :: region;
symbol @values :: ref<Values>;
symbol @cell :: ref<C>;
symbol @run :: proc(i64) -> i64;
symbol @len :: i64;
effect @len <- 99;
effect @arena <- region(4096u64);
effect @values <- alloc @arena Values(3u64, 0);
effect @cell <- alloc @arena C(2);
symbol @scores :: ref<Scores>;
effect @scores <- alloc @arena Scores(2u64, 0);
effect @bias <- 1;
procedure @run(value::i64)::i64 { store(@cell, value) + i64(len(value)) }
symbol @assign :: proc(i64) -> i64;
procedure @assign(value::i64)::i64 { (=)(@cell, value) }
symbol @indexed_assign :: proc(i64) -> i64;
procedure @indexed_assign(value::i64)::i64 { @scores[Index(0u32)] = value }
effect @bias <- 2;
behave @print(len(B(7)));
behave @print((len)(B(8)));
behave @print(len(@values));
behave @print(scalar(saved));
behave @print(scalar(pure(B(5))));
behave @print((@len));
behave @print(perform @run(3));
behave @print(deref(@cell).value);
behave @print(behave @run(3));
behave @print(deref(@cell).value);
behave @print(@cell + 1);
behave @print(scalar(B(5) + 1));

using symbol "intrinsic-library.cod" @raw_store;
array Rates[u32]::f32;
symbol @rates :: ref<Rates>;
effect @rates <- alloc @arena Rates(1u64, 0.0f32);
procedure (store)(target::ref<f32>, value::f32)::f32 {
  behave @raw_store(target, if (value < 0.0f32) { 0.0f32 } else { value })
}
behave @print(store(ref_at(@rates, 0u32), -2.0f32));
behave @print(store(ref_at(@rates, 0u32), 0.25f32));
behave @print(@rates[0u32]);

behave @print(scalar((=)(B(5), 4)));
behave @print(perform @assign(10));
behave @print(behave @assign(10));
behave @print(deref(@cell).value);
data FieldNames { type::i64; using::i64; }
symbol @using :: i64;
effect @using <- 7;
behave @print(deref(alloc @arena FieldNames(8, 9)).type + deref(alloc @arena FieldNames(8, 9)).using + @using);
function rewrite(value::B)::B { value[Index(1u32)] = 3 }
behave @print(scalar(rewrite(B(2))));
behave @print(perform @indexed_assign(10));
behave @print(behave @indexed_assign(10));
behave @print(([]=)(@scores, Index(1u32), 20));
behave @print(@scores[Index(1u32)]);
behave @print(({ behave @print(101); @scores })[{ behave @print(102); Index(0u32) }] = { behave @print(103); 30 });
behave @print(@scores[Index(0u32)]);
