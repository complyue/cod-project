using "callable-contract-api.cod" Metric;
import "callable-contract-api.cod" score;
import "callable-contract-api.cod" collect;
data Sample <: Metric { amount:i64 }
function score(x:Sample in O1) -> i64 where {owner O1} { return x.amount }
function collect(head:T, rest:T...) -> T where T {
  return fold (i in 0u64 .. len(rest), total = head) {{ total + rest[i] }}
}
function forwarded(head:T, rest:T...) -> T where T { return collect(head, rest...) }
function measure(x:T in O1) -> i64 where {T <: Metric, owner O1} { return score(x) }
export Sample;
export score;
export collect;
export forwarded;
export measure;
