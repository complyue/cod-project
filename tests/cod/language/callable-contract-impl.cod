using "callable-contract-api.cod" Metric;
import "callable-contract-api.cod" score;
import "callable-contract-api.cod" collect;
data Sample <: Metric { amount::i64 }
function score(x::Sample)::i64 { x.amount }
function collect(head::T, rest::T...)::T where T {
  fold (i in 0u64 .. len(rest), total = head) { total + rest[i] }
}
function forwarded(head::T, rest::T...)::T where T { collect(head, rest...) }
function measure(x::T)::i64 where T <: Metric { score(x) }
export Sample;
export score;
export collect;
export forwarded;
export measure;
