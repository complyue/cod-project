using symbol "std:io" @print;
data Item {value:u64;}
proc first(region a:Item,region b:Item)->Item {return root(a);}
proc second(region a:Item,region b:Item)->Item {return root(b);}
proc run(flag:bool)->void {
 owned region a:Item<-make Item(capacity=256u64){value<-1u64};
 owned region b:Item<-make Item(capacity=256u64){value<-2u64};
 proc selected=if(flag){first}else{second};
 defer {{ref value=selected(a,b); behave @print(value.value);}};
}
run(true);
