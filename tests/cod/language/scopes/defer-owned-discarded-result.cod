using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item {value:u64;}
region symbol @arena;
proc consume(owned region item:Item)->void {behave @print(root(item).value);}
proc consume_bad(owned region item:Item)->void {consume(item); effect @arena <-region(0u64);}
proc retain(owned region item:Item)->owned region :Item {return item;}
proc pair(owned region a:Item, owned region b:Item)->void {consume(a); consume(b);}
proc run()->void {
  owned region r:Item <-make Item(capacity=256u64){value<-1u64};
  ref view = root(r); defer {behave @print(view.value);}; defer retain(r);
}
run();
