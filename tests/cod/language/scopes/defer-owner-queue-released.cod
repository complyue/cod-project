using symbol "std:io" @print;
data Item {value:u64;}
proc drop(owned region r:Item)->void {}
proc show(value:u64 in O)->void where {owner O} {behave @print(value);}
proc run(yes:bool)->void {
 if(yes) {
  owned region r:Item <-make Item(capacity=256u64){value<-1u64};
  defer show(root(r).value);
  drop(r);
 } else {};
}
run(true);
