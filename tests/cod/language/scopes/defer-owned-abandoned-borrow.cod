using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item {value:u64;}
region symbol @arena;
proc bad()->void {effect @arena <-region(0u64);}
proc result()->owned region :Item {
  owned region r:Item <-make Item(capacity=256u64){value<-1u64};
  ref view = root(r);
  try {{
    defer bad();
    defer {return r;};
  }} catch(e:const InvalidCapacity) {behave @print(view.value);};
  return make Item(capacity=256u64){value<-2u64};
}
{{owned region r:Item <-result();}};
