using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
proc show(value:const u64 in O)->void where {owner O} {behave @print(value);}
proc set(value:u64 in O, next:u64)->void where {owner O} {value <- next;}
proc identity()->void {
  val first:u64 <- 1u64;
  val second:u64 <- 2u64;
  ptr selected = first;
  defer show(selected);
  selected = second;
  first <- 3u64;
  selected <- 4u64;
  defer show(selected);
}
identity();
proc initialized()->void {
  ptr target = make local u64;
  {{defer set(target, 5u64);}};
  behave @print(target);
  {{defer show(target); defer set(target, 6u64);}};
}
initialized();
proc through_value()->void {
  ptr target = make local u64;
  proc initialize = set;
  {{defer initialize(target, 7u64);}};
  proc observe = show;
  defer observe(target);
  target <- 8u64;
}
through_value();
proc optional(ptr value:const u64 in O)->void where {owner O} {
  if(isnull(value)) {behave @print(9u64);} else {behave @print(value);};
}
proc nullable()->void {
  val target:u64 <- 10u64;
  ptr selected = target;
  defer optional(selected);
  selected = null;
  defer optional(selected);
  selected = target;
  target <- 11u64;
}
nullable();
function one()->const u64 {return 12u64;}
function two()->const u64 {return 13u64;}
proc inspect(action:const func()->const u64 in O)->void where {owner O} {behave @print(action());}
proc holders()->void {
  func target = one;
  func other = one;
  ptr selected = target;
  proc observe = inspect;
  defer inspect(selected);
  defer observe(selected);
  selected = other;
  target <- two;
}
holders();
symbol @bias:u64;
effect @bias <- 1u64;
proc @update(value:u64 in O)->void where {owner O} {value <- value + @bias;}
proc modes()->void {
  effect @bias <- 1u64;
  val target:u64 <- 20u64;
  effect @update = @update;
  {{
    defer show(target);
    defer perform @update(target);
    defer behave @update(target);
    effect @bias <- 2u64;
  }};
}
effect @update = @update;
modes();
data Node {value:u64;}
region Arena {value:u64;}
array Values[u64]:u64;
proc inspect_region(node:Node in r, region r:Arena)->void {
  node.value <- node.value + r.value;
  behave @print(node.value);
}
proc array_read(values:Values in r)->void where {region r:Arena} {behave @print(values[0u64]);}
proc owner_read(region r:Arena)->void {behave @print(r.value);}
proc regions()->void {
  owned region r:Arena <- make Arena(capacity=1024u64){value <- 30u64};
  ref node = alloc r Node(1u64);
  ref values = alloc r Values(1u64,2u64);
  proc inspect_node = inspect_region;
  proc inspect_array = array_read;
  defer owner_read(r);
  defer inspect_region(node, r);
  defer inspect_node(node, r);
  defer inspect_array(values);
  values[0u64] <- 32u64;
  r.value <- 33u64;
}
regions();
for(i in 0u64 .. 2u64) {{regions();}};
proc repeated()->void {
  val target:u64 <- 40u64;
  {{
    for(i in 0u64 .. 3u64) {defer set(target, target + 1u64 + i);};
    defer show(target);
  }};
  behave @print(target);
}
repeated();
proc dereference(ptr value:const u64 in O)->void throws NullPointerException where {owner O} {
  behave @print(value);
}
proc checked()->void {
  val target:u64 <- 60u64;
  ptr selected = target;
  defer catch(error:const NullPointerException) {behave @print(61u64);};
  selected = null;
  defer dereference(selected);
  selected = target;
  defer show(target);
}
checked();
