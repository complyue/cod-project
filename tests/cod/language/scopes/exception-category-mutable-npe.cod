using symbol "std:io" @print;
using "std:exceptions" SystemException;
region symbol @arena;
proc run()->void {
  try {effect @arena <- region(0u64);} catch(first) {
    val saved:SystemException <- first;
    try {ptr absent:u64 = null; behave @print(absent);} catch(second) {saved <- second;};
    throw saved;
  }
}
run();
