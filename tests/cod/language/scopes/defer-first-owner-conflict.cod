using symbol "std:io" @print;
using "std:exceptions" NullPointerException;
using "std:exceptions" OutOfMemory;
data Item {value:u64;}
proc run()->void {owned region a:Item <-make Item(capacity=256u64){value<-1u64};owned region b:Item <-make Item(capacity=256u64){value<-2u64};ptr p:Item=null;defer {p=root(a);};defer {p=root(b);};}
run();
