using symbol "std:io" @print;
using "std:exceptions" OutOfMemory;
using "std:exceptions" InvalidCapacity;
data Item {value:u64;}
proc show(value:u64 in O)->void where {owner O} {behave @print(value);}
proc show_region(region item:Item)->void {behave @print(root(item).value);}

proc first_owner(yes:bool)->void {
  ptr p:Item = null;
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-1u64};
    defer {behave @print(p.value);} catch(e:const OutOfMemory) {throw e;};
    defer {p = root(r);};
  } else {};
}
first_owner(false); first_owner(true);

proc prepared(yes:bool)->void {
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-2u64};
    defer show(root(r).value);
  } else {};
}
prepared(false); prepared(true);

proc transfer(yes:bool)->void {
  if(yes) {
    owned region original:Item <-make Item(capacity=256u64){value<-3u64};
    defer show(root(original).value);
    owned region moved:Item <-original;
  } else {};
}
transfer(false); transfer(true);

proc nested(outer:bool, inner:bool, extra:bool)->void {
  if(outer) {
    owned region r:Item <-make Item(capacity=256u64){value<-4u64};
    if(inner) {defer show(root(r).value);} else {};
    if(extra) {defer behave @print(40u64);} else {};
  } else {};
}
nested(false,true,true); nested(true,false,true);
nested(true,true,false); nested(true,true,true);

proc repeated(yes:bool, count:u64)->void {
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-5u64};
    for(i in 0u64 .. count) {defer show(root(r).value);};
  } else {};
}
repeated(false,3u64); repeated(true,0u64); repeated(true,3u64);

proc separate(first:bool, second:bool)->void {
  if(first) {
    owned region a:Item <-make Item(capacity=256u64){value<-6u64};
    defer show(root(a).value);
  } else {};
  if(second) {
    owned region b:Item <-make Item(capacity=256u64){value<-7u64};
    defer show(root(b).value);
  } else {};
}
separate(false,false); separate(true,false); separate(false,true); separate(true,true);

proc result(yes:bool)->const u64 {
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-8u64};
    defer show(root(r).value);
    return 80u64;
  } else {};
  return 81u64;
}
behave @print(result(true)); behave @print(result(false));

proc failure(yes:bool)->void {
  defer catch(e:const InvalidCapacity) {behave @print(90u64);}
    finally {behave @print(91u64);};
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-9u64};
    defer show(root(r).value);
    owned region failed:Item <-make Item(capacity=0u64){value<-0u64};
  } else {};
}
failure(false); failure(true);

proc inner_cleanup(yes:bool)->void {
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-10u64};
    defer {{{defer show(root(r).value);}}};
  } else {};
}
inner_cleanup(false); inner_cleanup(true);

proc region_argument(yes:bool)->void {
  if(yes) {
    owned region original:Item <-make Item(capacity=256u64){value<-11u64};
    defer show_region(original);
    owned region moved:Item <-original;
  } else {};
}
region_argument(false); region_argument(true);

proc handler(yes:bool)->void {
  if(yes) {
    owned region r:Item <-make Item(capacity=256u64){value<-12u64};
    defer catch(e:const InvalidCapacity) {behave @print(root(r).value);};
    owned region failed:Item <-make Item(capacity=0u64){value<-0u64};
  } else {};
}
handler(false); handler(true);
