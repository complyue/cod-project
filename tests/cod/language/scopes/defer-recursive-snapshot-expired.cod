data Item{value:u64;}
region symbol @arena:Item;
symbol @reader:proc()->const u64;
proc first(n:u64)->proc()->const u64 {
  if(n==0u64){return proc()->const u64 {return @arena.value;};}else{};
  {{effect @arena<-make Item(capacity=256u64){value<-n};return second(n-1u64);}}
}
proc second(n:u64)->proc()->const u64 {
  if(n!=0u64){
    {{effect @arena<-make Item(capacity=256u64){value<-n};return first(n-1u64);}}
  }else{};
  return proc()->const u64 {return @arena.value;};
}
proc run()->void {
  effect @arena<-make Item(capacity=256u64){value<-99u64};
  for(i in 0u64..2u64) {{
    proc selected=if(i==0u64){first}else{second};
    proc result=selected(20u64);
    effect @reader=result;
    defer perform @reader();
  }};
}
run();
