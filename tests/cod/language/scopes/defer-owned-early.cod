using symbol "std:io" @print;
using "std:exceptions" InvalidCapacityError;
data Item {value:u64;}
region symbol @arena;
proc consume(own region item:Item)->void {behave @print(root(item).value);}
proc consume_bad(own region item:Item)->void {consume(item); effect @arena <-region(0u64);}
proc retain(own region item:Item)->own region :Item {return item;}
proc pair(own region a:Item, own region b:Item)->void {consume(a); consume(b);}
proc run()->void {
  own region r:Item <-make Item(capacity=256u64){value<-1u64};
  defer consume(r); consume(r);
}
run();
