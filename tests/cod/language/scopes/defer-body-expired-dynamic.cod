using symbol "std:io" @print;
data Item {value:u64;}
proc consume(owned region r:Item)->void {}
region symbol @arena:Item;
symbol @action:proc()->Item;
proc run()->void {
 proc selected=proc()->Item {return root(@arena);};
 {{effect @arena <-make Item(capacity=256u64){value<-1u64}; selected <-proc()->Item {return root(@arena);};}};
 effect @action=selected;
 defer perform @action();
} run();
