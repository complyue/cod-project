using symbol "std:io" @print;
using symbol "std:io" @assert;
using "std:exceptions" InvalidCapacity;
symbol @level:u64;
region symbol @arena;
effect @level <- 1u64;
proc choose(mode:u64) -> const u64 {
  try {
    if (mode == 0u64) { return 11u64; } else {};
    if (mode == 1u64) { effect @arena <- region(0u64); } else {};
    9u64
  } catch (error:const InvalidCapacity) {
    if (mode == 1u64) { return 22u64; } else {};
    8u64
  } finally { behave @print(90u64); };
  return 33u64;
}
proc replacement() -> const u64 {
  try {
    try { return 40u64; } finally { return 41u64; }
  } finally { behave @print(91u64); }
}
proc recover() -> const u64 {
  try { effect @arena <- region(0u64); } finally { return 42u64; }
}
proc looping() -> const u64 {
  for (i in 0u64 .. 3u64) {{
    effect @level <- i + 10u64;
    try { if (i == 1u64) { return @level; } else {}; }
    finally { behave @print(@level); }
  }};
  return 99u64;
}
func nested() -> const u64 {
  func inner = func() -> const u64 { return 6u64; };
  inner();
  return 7u64;
}
proc empty() -> void { return; behave @print(999u64); }
proc zero_iteration() -> const u64 {
  for (i in 0u64 .. 0u64) { return 1u64; }
  else { return 2u64; };
}
behave @print(choose(0u64));
behave @print(choose(1u64));
behave @print(choose(2u64));
behave @print(replacement());
behave @print(recover());
behave @print(looping());
behave @assert(@level == 1u64);
behave @print(nested());
empty();
behave @print(zero_iteration());
