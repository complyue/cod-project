using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
using "std:exceptions" OutOfMemory;
region symbol @arena;
proc bad()->void {effect @arena <- region(0u64);}
proc guarded(arm:bool)->void {
  ptr value = make local u64;
  defer {behave @print(value);}
    catch(error:const OutOfMemory) {behave @print(70u64);}
    finally {behave @print(71u64);};
  if(arm) {behave @print(9001u64);} else {};
  defer {value <- 1u64;};
}
guarded(false);
proc category_recovery()->void {
  ptr value = make local u64;
  defer {behave @print(value);}
    catch(error:const InvalidCapacity) {behave @print(value);}
    catch(error:const OutOfMemory) {}
    finally {behave @print(72u64);};
  defer {value <- 2u64; bad();};
}
category_recovery();
proc own_throw()->void {
  ptr value = make local u64;
  defer {value <- 3u64; bad();}
    catch(error:const InvalidCapacity) {behave @print(value);}
    finally {behave @print(73u64);};
}
own_throw();
proc fallback()->void {
  ptr value = make local u64;
  defer catch(error:const InvalidCapacity) {behave @print(value);}
    finally {behave @print(74u64);};
  defer {value <- 4u64; bad();};
}
fallback();
proc registered(yes:bool)->void {
  ptr value = make local u64;
  if(yes) {
    value <- 5u64;
    defer {behave @print(value);} catch(error) {behave @print(value);};
  } else {};
}
registered(true);
registered(false);
proc body_error()->void {
  ptr value = make local u64;
  defer {} catch(error:const InvalidCapacity) {behave @print(value);};
  value <- 6u64;
  bad();
}
body_error();
