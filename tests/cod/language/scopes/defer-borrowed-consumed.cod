using symbol "std:io" @print;
region Arena {value:u64;}
proc show(value:const u64 in O)->void where {owner O} {behave @print(value);}
proc consume(owned region r:Arena)->void {}
proc run()->void {
  owned region r:Arena <- make Arena(capacity=128u64){value <- 1u64};
  defer show(r.value);
  consume(r);
}
run();
