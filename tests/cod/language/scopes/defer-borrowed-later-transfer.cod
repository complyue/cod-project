region Arena {value:u64;}
func forward(owned region r:Arena)->owned region :Arena {return r;}
proc inspect(region r:Arena, ignored:u64)->void {}
proc run()->void {
  owned region r:Arena <- make Arena(capacity=128u64){value <- 1u64};
  defer inspect(r, {owned region moved <- forward(r); 0u64});
}
run();
