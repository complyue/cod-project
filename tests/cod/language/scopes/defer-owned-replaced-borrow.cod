using symbol "std:io" @print;
data Item {value:u64;}
proc result()->owned region :Item {
  owned region r:Item <-make Item(capacity=256u64){value<-1u64};
  ref view = root(r);
  defer {behave @print(view.value);};
  defer {return make Item(capacity=256u64){value<-2u64};};
  defer {return r;};
  return make Item(capacity=256u64){value<-3u64};
}
{{owned region r:Item <-result();}};
