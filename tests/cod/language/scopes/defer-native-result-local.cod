using symbol "std:io" @print;
data Item {value:u64;}
proc action()->Item {
 owned region r:Item <-make Item(capacity=256u64){value<-1u64};
 proc view=proc()->Item{return root(r);};
 return view();
}
proc run()->void {
 proc selected=action;
 defer {{ref got=selected(); behave @print(got.value);}};
}
run();
