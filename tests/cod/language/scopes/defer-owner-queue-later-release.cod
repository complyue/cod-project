using symbol "std:io" @print;
data Item {value:u64;}
proc show(value:u64 in O)->void where {owner O} {behave @print(value);}
proc drop(owned region item:Item)->void {}
proc run(acquire:bool, release:bool)->void {
  if(acquire) {
    owned region r:Item <-make Item(capacity=256u64){value<-1u64};
    defer show(root(r).value);
    if(release) {drop(r);} else {defer behave @print(0u64);};
  } else {};
}
run(true,true);
