using symbol "std:io" @print;
data Item {value:u64;}
proc inspect(v:Item in r,region r:Item)->void{}
proc run()->void {
 owned region a:Item<-make Item(capacity=256u64){value<-1u64};
 owned region b:Item<-make Item(capacity=256u64){value<-2u64};
 proc selected=proc()->Item{return root(a);};
 proc check=inspect;
 defer {check(selected(),b);};
}
run();
