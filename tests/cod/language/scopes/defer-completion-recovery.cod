using symbol "std:io" @print;
using "std:exceptions" InvalidCapacityError;
region symbol @arena;
proc bad()->void {effect @arena <- region(0u64);}
proc run()->void {
  ptr value = make local u64;
  {{
    defer {value <- 1u64;} catch(error:const InvalidCapacityError) {};
    bad();
  }};
  behave @print(value);
}
run();
