using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
using "std:exceptions" OutOfMemory;
data Packet {value:u64;}
region symbol @arena;
func owner(mode:u64) -> owned region :Packet {
  try {{
    owned region first <- make Packet(capacity=128u64){value<-10u64};
    return first;
  }} finally {
    if (mode == 1u64) {
      return make Packet(capacity=128u64){value<-20u64};
    } else {};
    if (mode == 2u64) {
      owned region failed <- make Packet(capacity=0u64){value<-0u64};
    } else {};
  }
}
func callable(mode:u64) -> func()->const u64 {
  try {{
    return func()->const u64 { return 30u64; };
  }} finally {
    if (mode == 1u64) {
      return func()->const u64 { return 40u64; };
    } else {};
    if (mode == 2u64) {
      owned region failed <- make Packet(capacity=0u64){value<-0u64};
    } else {};
  }
}
proc pending_failure() -> func()->const u64 {
  try {
    return func()->const u64 { return 50u64; };
  } finally {
    behave @print(6201u64);
    return func()->const u64 { return 60u64; };
  }
}
func accept(action:func()->const u64, value:u64) -> const u64 { return action() + value; }
func argument_return() -> const u64 {
  return accept(func()->const u64 { return 999u64; }, { return 71u64; });
}
func accept_owner(owned region packet:Packet, value:u64) -> const u64 { return packet.value + value; }
func owner_argument_return() -> const u64 {
  return accept_owner(make Packet(capacity=128u64){value<-999u64}, { return 72u64; });
}
for (i in 0u64 .. 3u64) {{
  try {
    owned region result <- owner(i);
    behave @print(result.value);
  } catch(e:const InvalidCapacity) { behave @print(70u64); };
  try {
    func action=callable(i);
    behave @print(action());
  } catch(e:const InvalidCapacity) { behave @print(80u64); };
}};
try { func result=pending_failure(); behave @print(result()); }
catch(e:const OutOfMemory) { behave @print(90u64); };
behave @print(argument_return());
behave @print(owner_argument_return());
