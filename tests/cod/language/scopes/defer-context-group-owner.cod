using symbol "std:io" @print;
symbol @reader:proc()->const u64;
proc show()->void {behave @print(perform @reader());}
data Item {value:u64;}
region symbol @arena:Item;
region symbol @other:Item;
symbol @left:Item in r, @right:Item in r where {region r:Item};
proc pair()->void {behave @print(@left.value + @right.value);}
proc run(flag:bool)->void {
 if(flag) {
  effect @arena <-make Item(capacity=256u64){value<-1u64};
  effect @other <-make Item(capacity=256u64){value<-2u64};
  effect @left=root(@arena), @right=root(@other);
  defer pair();
 } else {};
} run(true);
