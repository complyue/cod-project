using symbol "std:io" @print;
symbol @bias:u64;
symbol @saved:proc(u64)->void;
proc direct(x:u64) -> void { behave @print(x + @bias); return; }
proc prepare() -> u64 { behave @print(20u64); return 5u64; }
proc offset(x:u64) -> void { behave @print(x + 30u64); return; }
effect @bias <- 10u64;
effect @saved(x:u64) -> void { direct(x); return; };
proc run() -> void {
  defer direct(1u64);
  defer perform @saved(2u64);
  defer behave @saved(3u64);
  defer direct(4u64);
  defer offset(prepare());
  defer direct(6u64);
  effect @bias <- 40u64;
  defer behave @print(7u64);
  return;
}
run();
