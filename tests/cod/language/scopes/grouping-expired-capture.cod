using symbol "std:io" @print;
data Pool { tag:u64; }
region symbol @arena:Pool;
symbol @action:proc(bool)->const u64;
proc escaped = {{
  effect @arena <- make Pool(capacity=128u64) {tag<-1u64};
  proc (flag:bool)->const u64 {
    if (flag) { effect @arena <- make Pool(capacity=128u64) {tag<-2u64}; } else {};
    root(@arena).tag
  }
}};
effect @action = escaped;
behave @print(perform @action(false));
