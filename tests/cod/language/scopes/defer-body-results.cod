using symbol "std:io" @print;
using "std:exceptions" InvalidCapacity;
data Item {value:u64;}
region symbol @arena:Item;
region symbol @scratch;
symbol @reader:proc()->const u64;
proc dynamic_results()->void {
  effect @arena <-make Item(capacity=256u64){value<-7u64};
  proc current=proc()->const u64 {return 1u64;};
  effect @reader=current;
  effect proc @action()->Item {behave @print(perform @reader()); return root(@arena);};
  {{
    proc copy=@action;
    current <-proc()->const u64 {return 2u64;};
    perform @action();
    behave @action();
    proc nested=proc()->void {perform @action();};
    copy();
    defer perform @action();
    defer behave @action();
    defer nested();
    defer copy();
    current <-proc()->const u64 {return 3u64;};
  }};
}
proc lexical_results(flag:bool)->void {
  owned region r:Item <-make Item(capacity=256u64){value<-10u64};
  proc first=proc()->Item {behave @print(root(r).value); return root(r);};
  proc second=proc()->Item {behave @print(root(r).value + 1u64); return root(r);};
  proc choice=if(flag){first}else{second};
  proc copy=choice;
  defer choice();
  choice <-second;
  setfield(root(r),value,20u64);
  defer copy();
  defer second();
  proc outer=proc()->void {first();};
  defer outer();
  proc factory=proc()->proc()->Item with {region r} {return first;};
  proc returned=factory();
  defer returned();
  behave @print(copy().value);
}
proc failures()->void {
  owned region r:Item <-make Item(capacity=256u64){value<-30u64};
  proc action=proc()->Item {effect @scratch <-region(0u64); return root(r);};
  defer {behave @print(root(r).value);};
  defer catch(e:const InvalidCapacity) {behave @print(32u64);};
  defer action();
}
dynamic_results();
lexical_results(true);
lexical_results(false);
failures();
proc restored_context()->void {
  effect @arena <-make Item(capacity=256u64){value<-44u64};
  proc selected=proc()->Item {return root(@arena);};
  {{
    effect @arena <-make Item(capacity=256u64){value<-45u64};
    selected <-proc()->Item {behave @print(root(@arena).value); return root(@arena);};
  }};
  effect @action=selected;
  {{defer behave @action();}};
}
restored_context();
proc body_reader(region r:Item,flag:bool)->proc()->Item with {region r} {
  if(flag) {
    return proc()->Item {behave @print(46u64); return root(r);};
  } else {
    return proc()->Item {behave @print(47u64); return root(r);};
  };
}
proc body_factory(action:proc()->Item with {region r},region r:Item)->proc()->const u64 with {region r} {
  return proc()->const u64 {return action().value;};
}
proc body_descend(callback:proc()->const u64 with {region r},n:u64,region r:Item,flag:bool)->const u64 {
  if(n == 0u64) {return callback();} else {};
  proc next=body_factory(body_reader(r,flag),r);
  return body_descend(next,n-1u64,r,flag);
}
proc recursive_body_results(flag:bool)->void {
  owned region r:Item <-make Item(capacity=256u64){value<-46u64};
  proc callback=body_factory(body_reader(r,flag),r);
  behave @print(body_descend(callback,3u64,r,flag));
  defer body_descend(callback,200u64,r,flag);
}
recursive_body_results(true);
recursive_body_results(false);
