using symbol "std:io" @print;
unit Position;
function (+)(i::i64(Position), step::i64)::i64(Position) { Position(scalar(i) + step) }
function (-)(i::i64(Position))::i64(Position) { Position(-scalar(i)) }
function score(x::i64)::i64 { x * 2 }
function score(x::f32)::f32 { x * 3.0f32 }
function score(x::i64(Position))::i64 { scalar(x) }
behave @print(score(4));
behave @print(score(2.5f32));
behave @print(score(Position(10) + 5));
behave @print(score((+)(Position(10), 5)));
behave @print(score(-Position(7)));
global scalar_sum::i64 = (+)(2, 3);
behave @print(scalar_sum);
behave @print((!)(false));
