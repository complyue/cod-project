type Entity;
data First <: Entity { value::i64; }
data Second <: Entity { value::i64; }
function score(x::First in O1)::i64 where {owner O1} { 1 }
function score(x::Second in O1)::i64 where {owner O1} { 2 }
function first(arena::region)::First { deref(alloc arena First(10)) }
function second(arena::region)::Second { deref(alloc arena Second(20)) }
function relay(x::Entity in O1)::i64 where {owner O1} { score(x) }
export Entity;
export First;
export Second;
export score;
export first;
export second;
export relay;
