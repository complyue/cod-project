using "std:exceptions" NullPointerException;
# Stable typed slots; returning a slot changes membership, not object lifetime.
# A Slot is valid only for this pool and until its next release. Callers must
# return an acquired slot exactly once and stop using it after release.
using units "pool-interface.cod" {Slot};
using "pool-interface.cod" (==);
import "pool-interface.cod" read;
import "pool-interface.cod" cell;
import "pool-interface.cod" acquire;
import "pool-interface.cod" release;
array Payloads[u32(Slot)]::i64;
array Links[u32(Slot)]::u32(Slot);
data Pool { head::u32(Slot); ptr payloads::Payloads; ptr links::Links; }

function end_slot(pool::Pool in O1)::u32(Slot) throws NullPointerException where {owner O1} { Slot(u32(len(pool.payloads))) }
function empty(pool::Pool in O1)::bool throws NullPointerException where {owner O1} { pool.head == end_slot(pool) }
function read(pool::Pool in O1, slot::u32(Slot))::i64 throws NullPointerException where {owner O1} { deref(pool.payloads)[slot] }
function cell(pool::Pool in O1, slot::u32(Slot))::i64 throws NullPointerException where {owner O1} { ref_at(pool.payloads, slot) }

function initialize(pool::Pool in O1) -> void throws NullPointerException where {owner O1} {
  for (i in 0u32 .. scalar(end_slot(pool))) {
    store(pool.links, Slot(i), Slot(i + 1u32));
  };
  setfield(pool, head, Slot(0u32));
  {}
}

function create(region arena, capacity::u32) -> Pool throws NullPointerException {
  val payloads = alloc arena Payloads(u64(capacity), 0);
  val links = alloc arena Links(u64(capacity), Slot(0u32));
  val pool = deref(alloc arena Pool(Slot(0u32), payloads, links));
  initialize(pool);
  pool
}

function create(bytes::u64, capacity::u32) -> owned region ::Pool throws NullPointerException {
  owned region arena::Pool <- make Pool(capacity = bytes) {
    head <- Slot(0u32); payloads = null; links = null
  };
  ref pool = root(arena);
  setfield(pool, payloads, alloc arena Payloads(u64(capacity), 0));
  setfield(pool, links, alloc arena Links(u64(capacity), Slot(0u32)));
  initialize(pool);
  arena
}

# Exhaustion returns the capacity sentinel without modifying the pool.
function acquire(pool::Pool in O1, value::i64) -> const u32(Slot) throws NullPointerException where {owner O1} {
  val slot = pool.head;
  if (slot == end_slot(pool)) {
    slot
  } else {
    setfield(pool, head, deref(pool.links)[slot]);
    store(pool.payloads, slot, value);
    slot
  }
}

function release(pool::Pool in O1, slot::u32(Slot)) -> void throws NullPointerException where {owner O1} {
  store(pool.links, slot, pool.head);
  setfield(pool, head, slot);
  {}
}

export (==);
export Links;
export Payloads;
export Pool;
export Slot;
export acquire;
export cell;
export create;
export empty;
export end_slot;
export initialize;
export read;
export release;
