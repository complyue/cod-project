using symbol "std:io" @print;
using symbol "std:io" @assert;
using "method-view-library.cod" Sample;
using "method-view-library.cod" score as base;
using "method-view-first.cod" score as extended;
using "method-view-library.cod" score as combined;
using "method-view-first.cod" score as combined;
using "method-context-reexport.cod" frozen;
using "method-context-reexport.cod" adapted;
using "method-context-reexport.cod" renamed_score;
using "method-context-library.cod" score as related_score;
import "method-view-library.cod" score as local_union;
function local_union(x::bool)::i64 { 31 }
import "method-view-library.cod" score as saved_local;
using "method-view-second.cod" score as local_union;
function indirect(x::Sample in O1)::i64 where {owner O1} { base(x) }
using "method-view-library.cod" Metric;
symbol from "method-view-library.cod" @bias;
using "method-context-reexport.cod" frozen_proc;
using "method-context-reexport.cod" adapted_proc;
proc @frozen(x::Metric in O1)::i64 where {owner O1};
proc @adapted(x::Metric in O1)::i64 where {owner O1};
effect @frozen = frozen_proc;
effect @adapted = adapted_proc;
effect @bias <- 5;
region symbol @arena;
effect @arena <- region(4096u64);
{
  let x = create(@arena);
  behave @assert(renamed_score(x) == 7);
  behave @assert(renamed_score(true) == 23);
  behave @assert(related_score(true) == 23);
  behave @assert(saved_local(x) == 1);
  behave @assert(local_union(x) == 11);
  behave @assert(saved_local(true) == 31);
  behave @print(base(x));
  behave @print(extended(x));
  behave @print(indirect(x));
  behave @print(combined(x));
  behave @print(frozen(x));
  behave @print(adapted(x));
  behave @print(base(x));
  behave @print(frozen_proc(x));
  behave @print(adapted_proc(x));
  behave @print(perform @frozen(x));
  behave @print(behave @frozen(x));
  behave @print(perform @adapted(x));
  behave @print(behave @adapted(x));
};
