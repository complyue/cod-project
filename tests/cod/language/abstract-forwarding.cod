using symbol "std:io" @print;
using "abstract-data.cod" Sample;
using "abstract-library.cod" Weighted;
using "abstract-adapter.cod" make_weighted_reference;
using "abstract-second-adapter.cod" make_extended_reference;
using "abstract-alternate-factory.cod" make_alternate_reference;
using "abstract-data.cod" Bundle;
symbol @arena::region;
symbol @held::ref<Sample>;
effect @arena <- region(4096u64);
effect @held = make_weighted_reference(@arena, 7);
proc @inspect() -> i64 { rank(deref(@held)) }
{
  let reference = @held;
  let sample = view(reference);
  let bundle = alloc @arena Bundle(reference);
  behave @print(rank(sample));
  behave @print(rank_entity(sample));
  behave @print(nested_entity(upcast(sample)));
  behave @print(rank_entity(repeat(sample, 3u32)));
  behave @print(rank_entity(item(bundle)));
  behave @print(observe_maybe(reference, true));
  behave @print(same_type(sample, @arena));
  let continued = fold (i in 0u32 .. 3u32, current = reference) {
    make_extended_reference(@arena, i64(i))
  };
  behave @print(rank_entity(deref(continued)));
};
effect @held = make_alternate_reference(@arena);
behave @print(perform @inspect());
behave @print(behave @inspect());
behave @print(rank(deref(@held)));
