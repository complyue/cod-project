using symbol "std:io" @print;

func classify_bool(ptr subject:const bool in O) -> u64 where {const owner O} {
    return case subject of {
        (true) -> { 11u64 };
        (false) -> { 12u64 };
        (null) -> { 13u64 };
    };
}

enum Status:u64 { Start = 0; Done = 18446744073709551615; Finished = Done; }

func classify_status(ptr subject:const Status in O) -> u64 where {const owner O} {
    return case subject of {
        (Finished) -> { 21u64 };
        (Start) -> { 22u64 };
        (null) -> { 23u64 };
    };
}

proc replace_source(ptr source:bool in O, replacement:bool in O) -> u64 where {owner O} {
    return case source of {
        (null) -> {
            behave @print(31u64);
            source = replacement;
            fallthrough;
        };
        (true) -> { 32u64 };
        (false) -> { 33u64 };
        (null) -> { if (source) { 34u64 } else { 35u64 } };
    };
}

proc query_only(ptr subject:const bool in O) -> u64 where {const owner O} {
    return case subject of {
        (null) -> { 41u64 };
        () -> {{
            make typeof({{
                behave @print(99u64);
                case subject of {
                    (true) -> { 1u64 };
                    (false) -> { 2u64 };
                }
            }}) { 42u64 };
        }};
    };
}

val yes <- true;
val no <- false;
ptr missing_bool:bool = null in here;
behave @print(classify_bool(yes));
behave @print(classify_bool(no));
behave @print(classify_bool(missing_bool));

val done <- Done:Status;
val start <- Start:Status;
ptr missing_status:Status = null in here;
behave @print(classify_status(done));
behave @print(classify_status(start));
behave @print(classify_status(missing_status));

behave @print(replace_source(missing_bool, yes));

behave @print(query_only(missing_bool));
behave @print(query_only(yes));
