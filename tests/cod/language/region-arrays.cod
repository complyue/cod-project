using symbol "std:io" @print;
using symbol "std:io" @assert;
unit Neuron::u32;
array Rates[Neuron]::f32;
symbol @arena;
symbol @rates;
symbol @cell;
function total(a::Rates)::f32 {
  fold (i in Neuron(0u32) .. Neuron(u32(len(a))), sum = 0.0f32) { sum + a[i] }
}
function choose(a::Rates, i (Neuron))::ref<f32> { ref_at(a, i) }
function read(p::ref<f32>)::f32 { deref(p) }
effect @arena = region(4096u64);
behave @assert(true && { effect @arena = @arena; capacity_bytes(@arena) > 0u64 });
effect @rates = alloc @arena Rates(4u64, 0.5f32);
store(@rates, Neuron(1u32), 2.0f32);
behave @print(total(deref(@rates)));
effect @cell = choose(deref(@rates), Neuron(1u32));
behave @print(read(@cell));
{ store(@cell, 9.5f32); };
behave @print(read(@cell));
behave @print(total(deref(@rates)));
