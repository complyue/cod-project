using symbol "std:io" @print;
symbol from "region-factory-vocabulary.cod" @arena;
effect @arena <- region(4096u64);
using "region-factory-source.cod" Node as SourceNode;
using symbol "region-factory-source.cod" @make as @source_make;
using symbol "region-factory-source.cod" @read;
data Node { score::i64; next::ref<Node>; }
function adjust(x::i64)::i64 { x + 10 }
function score(node::Node)::i64 { node.score + 100 }
function score(node::SourceNode)::i64 { node.score + 200 }
symbol @make :: proc(i64) -> ref<Node>;
symbol @local :: ref<Node>;
symbol @source :: ref<SourceNode>;
mixin "region-factory-source.cod" @make as @make;
effect @local = perform @make(5);
effect @source = behave @source_make(5);
behave @print(score(deref(@local)));
behave @print(score(deref(@source)));
{
  let retained = perform @read();
  behave @print(deref(retained).score);
  setfield(retained, score, 9);
};
effect @arena <- region(4096u64);
symbol from "region-factory-source.cod" @initial;
effect @initial = alloc @arena SourceNode(11, null);
using symbol "region-factory-source.cod" @read as @again;
behave @print(deref(perform @again()).score);
behave @print(deref(behave @read()).score);
