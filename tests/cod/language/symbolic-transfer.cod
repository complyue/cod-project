using symbol "std:io" @assert;
data Pool { tag::i64; }
data Node { value::i64; }
region symbol @a::Pool, @b::Pool;
effect @a <- make Pool(capacity = 4096u64) { tag <- 100 };
effect @b <- make Pool(capacity = 4096u64) { tag <- 2 };
symbol @object::Node;
function (<-)(dst::Node in d, src::const Node in s) -> const Node in d
  where {region d::Pool, region s::Pool} {
  setfield(dst, value, src.value + root(d).tag - root(s).tag);
  dst
}
{
  let first = deref(alloc @a Node(1));
  let second = deref(alloc @b Node(9));
  effect @object = first;
  let result = @object <- second;
  behave @assert(result.value == 107);
  setfield(first, value, 108);
  behave @assert(result.value == 108);
  behave @assert(@object.value == 108);
  let explicit = (<-)(@object, second);
  behave @assert(explicit.value == 107);
};
