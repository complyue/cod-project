using symbol "std:io" @print;
using "std:text-storage" { utf8_size, utf8_byte };
using symbol "../../../cod/library/string.cod" @sout;
using "../../../cod/library/string.cod" { Utf8WriteError, StringBuilder };
import "../../../cod/library/string.cod" { emit, repr, emitRepr as render };
using "std:exceptions" Error as OutputError;

data Note { id:u64; }
data BrokenNote { code:u64; }

proc render(value:const Note in N) -> void where {const owner N} {
    emit("[");
    ref inner = repr(value.id);
    emit(inner);
    emit("]");
    return;
}

proc render(value:const BrokenNote in N) -> void where {const owner N} {
    emit("private");
    throw Utf8WriteError { code <- value.code; };
}

proc argument(value:const Note in N) -> ref const Note in N where {const owner N} {
    emit("arg:");
    return value;
}

proc verify_scope() -> u64 {
    ref writer = make StringBuilder();
    ref good = make Note { id <- 27u64; };
    ref bad = make BrokenNote { code <- 73u64; };
    effect @sout = writer;
    ref display = repr(argument(good));
    repr(good):void;
    emit(display);
    render(good);
    try { repr(bad):void; } catch (e:Utf8WriteError) {
        if (e.code != 73u64) return 1u64;
        emit(":caught");
    };
    try { repr(bad):void; } catch (e:OutputError) { emit(":root"); };
    ref finished = make String(writer);
    if (!same_text(finished, "arg:[27][27]:caught:root")) return 2u64;
    return 73u64;
}

func same_text(left:const String in L, right:const String in R) -> bool
    where {const owner L, const owner R} {
    val size <- utf8_size(left);
    if (size != utf8_size(right)) return false;
    for (at in 0u64 .. size) {
        if (utf8_byte(left, at) != utf8_byte(right, at)) return false;
    };
    return true;
}

behave @print(verify_scope());
