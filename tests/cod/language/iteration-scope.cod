using symbol "std:io" @print;
symbol @value : i64;
symbol @read : proc() -> i64;
region symbol @arena;
array Values[u32]:i64;
effect @value <- 9;
procedure @read() -> i64 { @value }
{{
  val i = 90;
  val values = 123;
  for (i in 0 .. 3) {{
    effect @value <- i;
    effect @arena <- region(128u64);
    ref values = alloc @arena Values(2u64, behave @read());
    behave @print(values[0u32]);
    values
  }};
  behave @print(i);
  behave @print(values);
  val flag = true;
  behave @print(true && {{ val flag = !flag; !!flag }});
  behave @print(flag);
}};
behave @print(@value);

function nested(in:i64) -> i64 {
  val value = {{ val in = in + 1; in }};
  val sum = 10;
  val total = fold (in in 0 .. 3, sum = sum) {{ sum + in }};
  val branch = if (in > 0) {{ val in = in + 2; in }} else {{ val in = in - 2; in }};
  value + total + branch + in + sum
}
behave @print(nested(5));
behave @print(nested(-5));
