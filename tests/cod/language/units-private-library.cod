unit m;
unit cm;
unit half;
function factor()::f64 { 100.0 }
conversion function to_half(x::f64(m))::f64(half) { half(scalar(x) * 2.0) }
conversion function half_to_cm(x::f64(half))::f64(cm) { cm(scalar(x) * factor() / 2.0) }
conversion function to_cm(x::f64(m))::f64(cm) { half_to_cm(to_half(x)) }

export cm;
export factor;
export half;
export half_to_cm;
export m;
export to_cm;
export to_half;
