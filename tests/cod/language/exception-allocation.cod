using symbol "std:io" @print;
using symbol "std:io" @assert;
using "std:exceptions" OutOfMemory;
using "std:exceptions" InvalidCapacity;
symbol arena :: region, original_capacity :: u64;
effect @arena <- region(4096u64);
effect @original_capacity <- capacity_bytes(@arena);
try {
  effect @arena <- region(256u64);
  try {
    effect @arena <- region(513u64);
    {}
  } finally { behave @print(10) }
} catch (error :: const OutOfMemory) {
  behave @assert(error.requested == 513u64);
  behave @assert(capacity_bytes(@arena) == @original_capacity);
  behave @print(20)
};
try {
  effect @arena <- region(0u64);
  {}
} catch (error :: const InvalidCapacity) {
  behave @assert(capacity_bytes(@arena) == @original_capacity);
  behave @print(30)
};
