using units "pool-units.cod" {ClassId, ClassSetId, GlobalSetId, LocalSlot, GlobalSlot, SetCount, SlotCount, SlotsPerSet};
using "pool-units.cod" (*);
data Layout { classes::u32; top_count::u64; }
function pow2(n::u32)::u64 { fold (i in 0u32 .. n, value = 1u64) { value * 2u64 } }
function capacity(j::u32(ClassId))::u32(SlotsPerSet) {
  let ordinal = scalar(j);
  let base = if (ordinal % 2u32 == 0u32) { 100u64 } else { 144u64 };
  SlotsPerSet(u32(base * pow2(ordinal / 2u32)))
}
function sets(layout::Layout, j::u32(ClassId))::u64(SetCount) {
  SetCount(layout.top_count * pow2(layout.classes - 1u32 - scalar(j)))
}
function class_set_begin(layout::Layout, j::u32(ClassId))::u64(GlobalSetId) {
  GlobalSetId(fold (i in 0u32 .. scalar(j), n = 0u64) { n + scalar(sets(layout, ClassId(i))) })
}
function class_slot_begin(layout::Layout, j::u32(ClassId))::u64(GlobalSlot) {
  GlobalSlot(fold (i in 0u32 .. scalar(j), n = 0u64) {
    n + scalar(capacity(ClassId(i)) * sets(layout, ClassId(i)))
  })
}

export (*);
export ClassId;
export ClassSetId;
export GlobalSetId;
export GlobalSlot;
export Layout;
export LocalSlot;
export SetCount;
export SlotCount;
export SlotsPerSet;
export capacity;
export class_set_begin;
export class_slot_begin;
export pow2;
export sets;
