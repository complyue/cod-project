using "std:exceptions" NullPointerException;
using symbol "std:io" @assert;
using symbol "std:io" @print;
using "std:exceptions" Exception;
using "std:exceptions" InvalidCapacityError;
using "std:exceptions" RegionCapacityExceededError;
data Packet { sequence:u64; }
data Saved { error:Exception; exact:InvalidCapacityError; }

function chain(primary:Exception, cause:Exception) -> Exception {
  return try { throw primary from cause } catch(result) { result }
}
function capacity_failure(fallback:Exception) -> Exception {
  return try {
    owned region packet:Packet <- make Packet(capacity=1u64){sequence<-0u64};
    fallback
  } catch(error) { error }
}
function selected(index:u64, errors:Exception...) -> Exception { return errors[index] }
proc check() -> void throws NullPointerException {
  try {
    owned region invalid:Packet <- make Packet(capacity=0u64){sequence<-0u64};
    {}
  } catch(seed) {
    val initial <- try {throw seed} catch(exact:const InvalidCapacityError) {exact};
    val secondary <- capacity_failure(seed);
    val first <- chain(secondary, initial);
    val second <- chain(initial, first);
    behave @assert(first.category == 2u64 && first.cause_count == 1u64);
    behave @assert(second.category == 3u64 && second.cause_count == 2u64);
    behave @assert(cause_at(second, 0u64).category == 2u64);
    behave @assert(cause_at(second, 1u64).category == 3u64);
    behave @assert(cause_at(second, 0u64).requested == 8u64);
    behave @assert(cause_at(second, 1u64).requested == 0u64);
    behave @assert(cause_at(second, 0u64).site == secondary.site);
    behave @assert(cause_at(second, 1u64).site == initial.site);
    val replaced <- chain(second, initial);
    behave @assert(replaced.cause_count == 1u64 && second.cause_count == 2u64);
    val self <- chain(first, first);
    behave @assert(self.cause_count == 2u64 && first.cause_count == 1u64);

    owned region saved:Saved <- make Saved(capacity=256u64){error<-second; exact<-initial};
    # Store an exact category in common storage, then reload and catch by its identity.
    setfield(root(saved), error, secondary);
    try {throw root(saved).error} catch(error:const RegionCapacityExceededError) {
      behave @assert(error.requested == 8u64)
    };
    ref record = alloc saved Saved(second, initial);
    setfield(root(saved), error, deref(record).error);
    val escaped <- {
      owned region temporary:Saved <- make Saved(capacity=72u64){error<-first; exact<-initial};
      root(temporary).error
    };
    behave @assert(escaped.cause_count == 1u64);
    try {throw escaped} catch(error:const RegionCapacityExceededError) {
      behave @assert(error.cause_count == 1u64)
    };
    for(i in 0u64 .. 2u64) {{
      val error <- selected(i, secondary, second);
      behave @assert(error.category == 2u64 + i);
      try {throw error}
      catch(capacity_error:const RegionCapacityExceededError) {behave @assert(i == 0u64)}
      catch(invalid_error:const InvalidCapacityError) {behave @assert(i == 1u64)}
    }};
    try {try {throw second} catch(error) {throw;}}
    catch(error:const InvalidCapacityError) {behave @assert(error.cause_count == 2u64)};
    try {try {throw second} finally {throw initial}}
    catch(error:const InvalidCapacityError) {behave @assert(error.cause_count == 0u64)};
    behave @print(1)
  }
}
try { check(); } catch (unexpected:const NullPointerException) { behave @assert(false); };
