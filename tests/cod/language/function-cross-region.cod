data Node { value::i64; ptr next::Node; }
region symbol first;
region symbol second;
symbol node :: Node;
function link(node::Node in O1, child::Node in O2) -> Node where {owner O1, owner O2} {
  setfield(node, next, child)
}
effect @first <- region(4096u64);
effect @second <- region(4096u64);
effect @node = alloc @first Node(1, null);
link(deref(@node), alloc @second Node(2, null));
