symbol @print;
using "std:io" @print as @print;
symbol from "vocabulary.cod" @x;
symbol from "vocabulary.cod" @p as @source_proc;
procedure @source_proc -> i64 { 900 }
symbol @local_proc;
effect @x = 8;
using "source.cod" @p as @local_proc;
behave @print(perform @source_proc);
behave @print(perform @local_proc);
behave @print(behave @local_proc);
