symbol from "frame-vocabulary.cod" @a0;
symbol from "frame-vocabulary.cod" @a1;
symbol from "frame-vocabulary.cod" @target;
symbol from "frame-vocabulary.cod" @update;
function gather(a0: i64, a1: i64, target: i64) -> i64 {
  if (target == 0) { a1 * 3 } else { a0 * 7 }
}
procedure @update -> i64 { gather(@a0, @a1, @target) }
