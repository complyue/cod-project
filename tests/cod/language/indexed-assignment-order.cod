using symbol "std:io" @print;
unit Request;
unit Index;
array Values[u32(Index)]::i64;
conversion function choose(value::u32(Request))::u32(Index) { Index(1u32 / scalar(value)) }
procedure ([]=)(values::ref<Values>, index::u32(Index*), value::i64)::i64 {
  store(values, index, value)
}
symbol @arena :: region;
symbol @values :: ref<Values>;
effect @arena <- region(4096u64);
effect @values <- alloc @arena Values(1u64, 0);
({ behave @print(11); @values })[{ behave @print(22); Request(0u32) }] = {
  behave @print(33);
  7
};
