using "pool-interface.cod" SlotStore;
using "pool-interface.cod" ReusableSlotStore;
using units "pool-interface.cod" {Slot};

function replace(pool::ReusableSlotStore, slot::u32(Slot), value::i64)::u32(Slot) {
  release(pool, slot);
  acquire(pool, value)
}
function peek(pool::SlotStore, slot::u32(Slot))::i64 { read(pool, slot) }
function locate(pool::ReusableSlotStore, slot::u32(Slot))::ref<i64> { cell(pool, slot) }

export replace;
export peek;
export locate;
