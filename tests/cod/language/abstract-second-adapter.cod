export import "abstract-adapter.cod" Sample;
using "abstract-library.cod" Separate;
using "abstract-library.cod" Alternate;
data Sample <: Separate;
data Sample <: Alternate;
function make_extended_reference(region arena, value::i64)::ref<Sample> { alloc arena Sample(value) }

export Alternate;
export Separate;
export make_extended_reference;
