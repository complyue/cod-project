using symbol "std:io" @print;
array Values[u32]::i64;
symbol @arena :: region;
symbol @values :: ref<Values>;
effect @arena <- region(128u64);
effect @values = alloc @arena Values(1u64, 0);
behave @print(99);
global result::i64 = store(@values, 0u32, 7);

behave @print(result);
behave @print(@values[0u32]);
