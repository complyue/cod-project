unit Slot;
function (==)(a::u32(Slot), b::u32(Slot))::bool { scalar(a) == scalar(b) }
type SlotStore;
type ReusableSlotStore <: SlotStore;

function read(pool::SlotStore, slot::u32(Slot))::i64;
function cell(pool::SlotStore, slot::u32(Slot))::ref<i64>;
function acquire(pool::ReusableSlotStore, value::i64)::u32(Slot);
function release(pool::ReusableSlotStore, slot::u32(Slot))::void;

export Slot;
export (==);
export ReusableSlotStore;
export SlotStore;
export read;
export cell;
export acquire;
export release;
