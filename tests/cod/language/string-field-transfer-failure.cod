using symbol "std:io" @print;
using "std:text-storage" { utf8_size, utf8_byte };
using "std:exceptions" Error;
data Entry { name:String; }
data Rejected <: Error { code:u64; }
proc (<-)(init val var out:String in D, text:const String in S) -> void
    where {owner D, const owner S} {
    if (utf8_size(text) == 0u64) { throw Rejected { code <- 1u64; }; };
    out = make String(text) in D;
    if (utf8_size(text) == 2u64) { throw Rejected { code <- 1u64; }; };
    return;
}
proc verify() -> u64 {
    ref entry = make Entry { name <- "first"; };
    try { entry.name <- ""; } catch (e:const Rejected) {};
    if (utf8_size(entry.name) != 5u64) return 1u64;
    try { entry.name <- "ok"; } catch (e:const Rejected) {};
    if (utf8_size(entry.name) != 2u64 || utf8_byte(entry.name, 0u64) != 111u8) return 2u64;
    return 73u64;
}
behave @print(verify());
