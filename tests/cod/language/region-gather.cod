using symbol "std:io" @print;
using symbol "std:io" @assert;
using units "pool-units.cod" {ClassId, ClassSetId};
using units "region-gather-types.cod" {Neuron};
using "region-gather-types.cod" Frame;
using "pool-layout.cod" Layout;
using "pool-layout.cod" class_set_begin;
using "pool-index.cod" SetLocation;
using "region-gather-kernel.cod" create_graph;
using "region-gather-step.cod" step;
global trace_values::bool = true;
global weighted::bool = true;
region symbol @arena;
function checksum(frame::Frame in O1)::f32 where {owner O1} {
  fold (n in Neuron(0u32) .. Neuron(u32(len(frame))), total = 0.0f32) { total + frame[n] }
}
proc emit_frame(frame::Frame in O1) -> void where {owner O1} {
  behave @print(checksum(frame));
  if (trace_values) {
    for (n in Neuron(0u32) .. Neuron(u32(len(frame)))) {
      behave @print(frame[n]);
    }
  } else {};
}
effect @arena <- region(32768u64);
{
  region arena = @arena;
  let layout = deref(alloc arena Layout(4u32, 1u64));
  let location = alloc arena SetLocation(ClassId(0u32), ClassSetId(0u64));
  let a = alloc arena Frame(scalar(class_set_begin(layout, ClassId(layout.classes))), 0.0f32);
  let b = alloc arena Frame(len(a), 0.0f32);
  let graph = create_graph(arena, layout, u32(len(a)), location, weighted);
  for (n in 0u32 .. u32(len(a))) {
    store(a, Neuron(n), f32(n + 1u32));
  };
  emit_frame(deref(a));
  for (frame in 0u32 .. 4u32) {
    if (frame % 2u32 == 0u32) {
      step(deref(a), b, graph, layout, location);
      emit_frame(deref(b));
    } else {
      step(deref(b), a, graph, layout, location);
      emit_frame(deref(a));
    };
  };
  behave @assert(used_bytes(@arena) < 12000u64);
};
