using symbol "std:io" @assert;
symbol a :: region, original :: u64;
effect @a <- region(4096u64);
effect @original <- capacity_bytes(@a);
proc @inspect() -> u64 { capacity_bytes(@a) }
{
  effect @a <- region(8192u64);
  behave @assert(perform @inspect() == @original);
  behave @assert(behave @inspect() > @original);
  behave @assert(capacity_bytes(@a) > @original);
};
behave @assert(capacity_bytes(@a) == @original);
behave @assert(perform @inspect() == @original);
