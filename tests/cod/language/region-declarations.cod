using symbol "std:io" @assert;
using symbol "std:io" @print;
data Arena { id:u64; }
data Cell { value:i64; }
region symbol @active:Arena;
symbol @factory:proc(u64) -> own region :Arena;
function create(bytes:u64) -> own region :Arena {
  return make Arena(capacity = bytes) { id <- 7u64 }
}
function forward(own region arena:R) -> own region :R where R { return arena }
function edit(region arena:Arena, cell:Cell in arena, value:i64) -> void {
  deref(cell).value <- value;
  {}
}
function inspect(region arena:const Arena) -> const u64 { return root(arena).id }
function origin(cell:Cell in r) -> region :Arena in r where {region r:Arena} { return r }
function echo(region arena:Arena) -> region :Arena in arena { return arena }
effect proc @factory(bytes:u64) -> own region :Arena { return create(bytes) };
{{
  own region arena:Arena <- behave @factory(512u64);
  region view:Arena = echo(arena);
  ptr cell = alloc view Cell(1);
  edit(arena, cell, 9);
  region inferred = origin(cell);
  behave @assert(deref(cell).value == 9 && inspect(inferred) == 7u64);
  own region moved:Arena <- forward(arena);
  effect @active <- moved;
  behave @assert(capacity_bytes(@active) == capacity_bytes(view));
}};
{{
  own region raw <- region(128u64);
  region view = raw;
  ptr cell = alloc view Cell(4);
  behave @assert(deref(cell).value == 4);
}};
behave @print(1);
