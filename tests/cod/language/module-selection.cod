using symbol "std:io" @print;
import "./import-mapping-provider.cod" proc @p as @imported;
symbol from "./vocabulary.cod" @x;

import "./product-library.cod" Position as Point;
using "./product-library.cod" Position as SamePoint;
import "./product-library.cod" read as measure;
function weight(p:SamePoint in O1) -> f32 where {owner O1} { return measure(p) }

effect @x <- 7;
effect proc @imported;
effect @x <- 8;
behave @print(perform @imported());
behave @print(behave @imported());

ref point = make Point { index <- 3; weight <- 1.25f32 };
behave @print(weight(point));
