using symbol "std:io" @print;
type Pair { x::i64; y::f64; }
symbol @pair :: Pair;
symbol @read :: proc() -> Pair;
effect @pair <- Pair(7, 1.5);
procedure @read()::Pair { @pair }
effect @pair <- Pair(9, 2.5);
behave @print((perform @read()).x);
behave @print((behave @read()).x);
behave @print(@pair.y);
