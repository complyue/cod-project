using symbol "std:io" @print;
using "std:exceptions" Exception;
data UploadInterrupted <: Exception { upload_id:u64 }

proc upload(code:u64) -> void throws UploadInterrupted {
    throw UploadInterrupted { upload_id <- code }
}
proc terminate(exception x:Exception) -> void throws UploadInterrupted {
    behave @print(11u64);
    upload(32u64)
}
try { upload(42u64); }
catch (first:UploadInterrupted) {
    try { terminate(first); }
    catch (second:UploadInterrupted) { terminate(first); }
};
