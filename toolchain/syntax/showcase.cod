# CoD syntax showcase
# Independent fragments for editor preview. Loose statements use a surrounding procedural scope.
# Owners, library names and external helpers are supplied by the fragment's context.

# 01 — Literals, operators and units

unit Position
val channels:u8 <- 4u8
val frame_size:u32 <- 256u32
val samples:u64 <- 96000u64
val offset:i64 <- -9
val gain:f32 <- 1.5f32
val tolerance:f64 <- 2.5e-3f64
val frames <- samples / frame_size
val remainder <- samples % frame_size
val paused <- false
val ready <- not paused and frames > 0u64
val pixel_offset <- i64(-2.75)
func (+)(i:i64(Position), step:i64) -> i64(Position) { Position(scalar(i) + step) }
val shifted <- (+)(Position(10), 5)

# 02 — Declarations, owners and storage

val count <- 3u64
const val limit:u64 <- 10u64
ref view = count
const ref fixed = count
ref readonly:const u64 = count
ptr selected:u64 = null in here
var slot -> selected
slot = view
if (selected is not null and selected is count) { selected <-:+ 1u64 }
ptr scratch = make typeof(count) in here

array Counts[u32]:u64
ref counts = make Counts(4u64, 0u64) in arena
ref cell = counts[0u32]
cell <- 9u64
val size <- len(counts)

region Stock { remaining:u64 }
own region inventory:Stock <- make region Stock(4096u64 -> capacity) { remaining <- 12u64 }
func handoff(own region stock:Stock) -> own region :Stock { return stock }

# 03 — Data alternatives, enums and cases

export enum Priority:u8 { Standard; Urgent; }
data Receipt = Accepted { id:u64; ptr prior:Receipt; } | Skipped {}
func Accepted(raw:u64) {
    id <- raw
    prior = null
}

ref receipt = make Accepted(42u64)
val accepted <- receipt isa Accepted

"""Returns the matching receipt ID for [Receipt](Receipt)."""
func checked_id(ptr r:const Receipt in O, limit:u64) -> u64 where {const owner O} {
    case r of {
        null -> 0u64;
        Accepted { val n <- id; } | n >= limit -> n;
        Accepted -> 0u64;
        Skipped -> 0u64
    }
}

# 04 — Storage parents, member receivers and super

type Identified;
data Base <: Identified { id:u64 }
data Item extends Base { detail:u64 }
data Tagged extends Item { id:u64 }

func Base(raw:u64) { id <- raw }
func Item(raw:u64, extra:u64) {
    super(raw)
    detail <- extra
}
func Tagged(raw:u64, extra:u64, tag:u64) {
    super(raw, extra)
    id <- tag
}

func const Base.@number() -> u64 { self.id }
proc Base.update(n:u64) { self.id <- n }
func (const Base in O).id_view() -> ref const u64 in O where {const owner O} {
    self.id
}

func const Base.score() -> u64 { self.id }
func const Item.score() -> u64 { super.score() + self.detail }
func const Tagged.score() -> u64 { super(Base).score() + self.id }

func mark(entry:const Base in O, priority:Priority) -> u64 where {const owner O} of {
    (item:const Item in O, Urgent) => item.detail;
    (_, Urgent) => 1u64;
    (_, _) => 0u64
}

ref item = make Tagged(7u64, 3u64, 9u64)
ref base:Base = item
base.update(11u64)
val number <- base.number
ref id_ref = base.id_view()
val score <- item.score()

data StorageException <: Exception { code:u64 }
data ShortWriteException extends StorageException { written:u64 }

# 05 — Call operators, callable values and here parameters

data Threshold { minimum:u64 }
func const Threshold.(())(value:u64) -> bool { value >= self.minimum }
func (const Threshold in O).(())() -> ref const u64 in O where {const owner O} {
    self.minimum
}

func const Threshold.(())(x:u64, y:u64) -> bool {
    x + y >= self.minimum
}

func test(here pred(x:u64) -> bool, n:u64) -> bool { pred(n) }
ref threshold = make Threshold { minimum <- 10u64 }
val direct <- threshold(12u64)
val supplied <- test(threshold, 12u64)
val deferred_read <- test(12u64) (x) => {{ return threshold(x) }}

proc enabled(n:u64) -> bool of {
    (0u64) => false;
    (value:u64) => {
        test(value) (x) => { x > 1u64 }
    }
}

func as_flag -> bool {
    (n:u64) => n != 0u64;
    (b:bool) => b
}

func increment = func(x:u64) -> u64 { x + 1u64 }
func apply(f:func(u64) -> u64, n:u64) -> u64 { f(n) }
val applied <- apply(increment, 3u64)

# 06 — Symbols and scoped installations

val symbol @level:u64
symbol @read:proc() -> u64
proc @read() -> u64 { return @level }

symbol @credit:proc(Priority) -> u64
proc @credit(priority:Priority) -> u64 of {
    (Standard) => 1u64;
    (Urgent) => 2u64
}
effect @credit -> u64 {
    (Urgent) => 1u64;
    (_) => 0u64
}

effect @level <- 1u64
effect proc @read;
{{
    effect @level <- 2u64
    effect proc @credit(priority:Priority) -> u64 of {
        (_) => 3u64
    }
    val current <- behave @read()
    val saved <- perform @read()
}}

func symbol @rating() -> u64
func baseline() -> u64 { 17u64 }
effect @rating <- baseline
val rating_value <- @rating()

symbol @gate:func(u64) -> bool in O where {owner O}
effect @gate <- threshold
val open <- @gate(12u64)

ref symbol @balance:u64 in S where {owner S}
effect @balance = count, @level <- 3u64
@balance <-:- 2u64

# 07 — Control, callbacks and cleanup

func fold(here step(acc:u64, item:u64) -> u64, first:u64, past:u64, seed:u64) -> u64 {
    val acc <- seed
    for (i in first .. past) { acc <- step(acc, i) }
    acc
}
val total <- fold(0u64, 4u64, 10u64) (acc, i) => { acc + i }

func last_or(first:i64, past:i64) -> i64 {
    val last <- -1i64
    for (i in first .. past) { last <- i } else { last <- -1i64 }
    last
}

func relay(here body() -> void) -> u64 { body(); 99u64 }
val early <- relay() { break 7u64 };
{{ work() }}

using "std:exceptions" NullPointerException
func required(ptr p:u64 in O) -> u64 throws NullPointerException where {const owner O} {
    not null p
}
proc observe(ptr p:u64 in O, wrap:bool) throws NullPointerException where {const owner O} {
    val reading <- 0u64
    defer record(reading)
    defer { if returning () { record(reading) } }
    try {
        reading <- required(p)
    } catch (e:const NullPointerException) {
        report(e.tip)
        if (wrap) { rethrow; }
        throw;
    } finally {
        finish()
    }
}

proc deferred_read(ptr p:u64 in O) where {const owner O} {
    defer catch (e:const NullPointerException) { report(e) }
    defer { required(p) : void }
}

# 08 — Generators and pipeline connectors

func samples() yields u64 -> bool {
    if (not yield(1u64)) return
    yield(2u64) : void
}
for val item <- samples() { continue item < 2u64 }
samples() (item) => { item < 2u64 }

proc pipeline(here src() yields u64) {
    here stages = floor |> units |> limit
    here selected = src !> stages
    here reporting = stages $> report
    selected $> report
    report <$ limit <| units <| floor <! src
}

# 09 — Text and token forms

ref builder = "Total: " ++ price
ref retained = make String(builder) in arena

